// Phase 12, Stage 3: Self-hosted Codegen
// This codegen generates C99 code from AST nodes

// C99 header generation
func generateHeader() {
    let header = ""
    header = header + "#include <stdio.h>\n"
    header = header + "#include <stdlib.h>\n"
    header = header + "#include <stdint.h>\n"
    header = header + "\n"
    return header
}

// Type mapping from Karkain to C99
func mapType(karkainType) {
    if (karkainType == "int") { return "int64_t" }
    if (karkainType == "float64") { return "double" }
    if (karkainType == "string") { return "char*" }
    if (karkainType == "bool") { return "int" }
    return "int64_t"
}

// Generate code for program node
func generateProgram(node) {
    let code = generateHeader()
    let statements = node[1]
    let i = 0
    while (i < len(statements)) {
        code = code + generateStatement(statements[i])
        i = i + 1
    }
    return code
}

// Generate code for statements
func generateStatement(node) {
    let nodeType = node[0]
    
    if (nodeType == "FuncDecl") {
        return generateFuncDecl(node)
    }
    
    if (nodeType == "VarDecl") {
        return generateVarDecl(node)
    }
    
    if (nodeType == "LetDecl") {
        return generateLetDecl(node)
    }
    
    if (nodeType == "Print") {
        return generatePrint(node)
    }
    
    if (nodeType == "Return") {
        return generateReturn(node)
    }
    
    return ""
}

// Generate function declaration
func generateFuncDecl(node) {
    let code = ""
    let name = node[1]
    let body = node[2]
    
    code = code + "int main() {\n"
    
    let i = 0
    while (i < len(body)) {
        code = code + generateStatement(body[i])
        i = i + 1
    }
    
    code = code + "    return 0;\n"
    code = code + "}\n\n"
    
    return code
}

// Generate variable declaration
func generateVarDecl(node) {
    let code = ""
    let varType = node[1]
    let name = node[2]
    let value = node[3]
    
    let cType = mapType(varType)
    let valueCode = generateExpression(value)
    
    code = code + "    " + cType + " " + name + " = " + valueCode + ";\n"
    
    return code
}

// Generate let declaration
func generateLetDecl(node) {
    let code = ""
    let name = node[1]
    let value = node[2]
    
    let valueCode = generateExpression(value)
    
    code = code + "    int64_t " + name + " = " + valueCode + ";\n"
    
    return code
}

// Generate expression code
func generateExpression(node) {
    let nodeType = node[0]
    
    if (nodeType == "IntLiteral") {
        return node[1]
    }
    
    if (nodeType == "FloatLiteral") {
        return node[1]
    }
    
    if (nodeType == "StringLiteral") {
        return node[1]
    }
    
    if (nodeType == "BoolLiteral") {
        if (node[1] == "true") { return "1" }
        return "0"
    }
    
    if (nodeType == "Ident") {
        return node[1]
    }
    
    if (nodeType == "BinaryOp") {
        let op = node[1]
        let left = generateExpression(node[2])
        let right = generateExpression(node[3])
        return "(" + left + " " + op + " " + right + ")"
    }
    
    return "0"
}

// Generate print statement
func generatePrint(node) {
    let code = ""
    let expr = node[1]
    let exprCode = generateExpression(expr)
    
    code = code + "    printf(\"%lld\\n\", " + exprCode + ");\n"
    
    return code
}

// Generate return statement
func generateReturn(node) {
    let code = ""
    let expr = node[1]
    let exprCode = generateExpression(expr)
    
    code = code + "    return " + exprCode + ";\n"
    
    return code
}

// Main codegen function
func generateCode(ast) {
    return generateProgram(ast)
}

// Function to write generated code to file (placeholder)
func writeCodeToFile(code, filename) {
    return 1
}
// Phase 12, Stage 2: Self-hosted Parser
// This parser uses the lexer to build AST nodes

// Parser state
func createParser(tokens) {
    let parser = []
    parser = appendArray(parser, tokens)
    parser = appendArray(parser, 0)
    return parser
}

func currentToken(parser) {
    let tokens = parser[0]
    let pos = parser[1]
    if (pos < len(tokens)) {
        return tokens[pos]
    }
    return []
}

func advance(parser) {
    let tokens = parser[0]
    let pos = parser[1]
    pos = pos + 1
    parser[1] = pos
    return parser
}

func peekToken(parser) {
    let tokens = parser[0]
    let pos = parser[1]
    let nextPos = pos + 1
    if (nextPos < len(tokens)) {
        return tokens[nextPos]
    }
    return []
}

func expectToken(parser, tokenType) {
    let token = currentToken(parser)
    if (len(token) > 0 && token[0] == tokenType) {
        advance(parser)
        return token
    }
    return []
}

// Parse functions
func parseProgram(parser) {
    let statements = []
    
    while (len(currentToken(parser)) > 0 && currentToken(parser)[0] != "EOF") {
        let stmt = parseStatement(parser)
        if (len(stmt) > 0) {
            statements = appendArray(statements, stmt)
        }
    }
    
    return createProgramNode(statements)
}

func parseStatement(parser) {
    let token = currentToken(parser)
    
    if (len(token) == 0) {
        return []
    }
    
    let tokenType = token[0]
    
    if (tokenType == "FUNC") {
        return parseFuncDecl(parser)
    }
    
    if (tokenType == "VAR") {
        return parseVarDecl(parser)
    }
    
    if (tokenType == "LET") {
        return parseLetDecl(parser)
    }
    
    if (tokenType == "PRINT") {
        return parsePrint(parser)
    }
    
    if (tokenType == "IF") {
        return parseIf(parser)
    }
    
    if (tokenType == "RETURN") {
        return parseReturn(parser)
    }
    
    if (tokenType == "MATRIX") {
        return parseMatrixDecl(parser)
    }
    
    advance(parser)
    return []
}

func parseFuncDecl(parser) {
    expectToken(parser, "FUNC")
    let nameToken = expectToken(parser, "IDENT")
    let name = nameToken[1]
    expectToken(parser, "LPAREN")
    expectToken(parser, "RPAREN")
    expectToken(parser, "LBRACE")
    
    let body = []
    while (len(currentToken(parser)) > 0 && currentToken(parser)[0] != "RBRACE") {
        let stmt = parseStatement(parser)
        if (len(stmt) > 0) {
            body = appendArray(body, stmt)
        }
    }
    
    expectToken(parser, "RBRACE")
    
    return createFuncDeclNode(name, body)
}

func parseVarDecl(parser) {
    expectToken(parser, "VAR")
    let nameToken = expectToken(parser, "IDENT")
    let name = nameToken[1]
    
    let varType = "int"
    let typeToken = currentToken(parser)
    if (len(typeToken) > 0 && typeToken[0] == "IDENT") {
        varType = typeToken[1]
        advance(parser)
    }
    
    expectToken(parser, "ASSIGN")
    let value = parseExpression(parser)
    
    return createVarDeclNode(varType, name, value)
}

func parseLetDecl(parser) {
    expectToken(parser, "LET")
    let nameToken = expectToken(parser, "IDENT")
    let name = nameToken[1]
    expectToken(parser, "ASSIGN")
    let value = parseExpression(parser)
    
    return createLetDeclNode(name, value)
}

func parseExpression(parser) {
    return parseBinaryOp(parser)
}

func parseBinaryOp(parser) {
    let left = parsePrimary(parser)
    
    let token = currentToken(parser)
    if (len(token) > 0) {
        let tokenType = token[0]
        
        if (tokenType == "PLUS" || tokenType == "MINUS" || tokenType == "STAR" || tokenType == "SLASH") {
            advance(parser)
            let op = token[1]
            let right = parsePrimary(parser)
            return createBinaryOpNode(op, left, right)
        }
    }
    
    return left
}

func parsePrimary(parser) {
    let token = currentToken(parser)
    
    if (len(token) == 0) {
        return []
    }
    
    let tokenType = token[0]
    
    if (tokenType == "INT") {
        advance(parser)
        return createIntLiteralNode(token[1])
    }
    
    if (tokenType == "FLOAT") {
        advance(parser)
        return createFloatLiteralNode(token[1])
    }
    
    if (tokenType == "STRING") {
        advance(parser)
        return createStringLiteralNode(token[1])
    }
    
    if (tokenType == "TRUE" || tokenType == "FALSE") {
        advance(parser)
        return createBoolLiteralNode(token[1])
    }
    
    if (tokenType == "IDENT") {
        advance(parser)
        return createIdentNode(token[1])
    }
    
    advance(parser)
    return []
}

func parsePrint(parser) {
    expectToken(parser, "PRINT")
    expectToken(parser, "LPAREN")
    let expr = parseExpression(parser)
    expectToken(parser, "RPAREN")
    
    return createPrintNode(expr)
}

func parseIf(parser) {
    expectToken(parser, "IF")
    expectToken(parser, "LPAREN")
    let condition = parseExpression(parser)
    expectToken(parser, "RPAREN")
    expectToken(parser, "LBRACE")
    
    let thenBranch = []
    while (len(currentToken(parser)) > 0 && currentToken(parser)[0] != "RBRACE") {
        let stmt = parseStatement(parser)
        if (len(stmt) > 0) {
            thenBranch = appendArray(thenBranch, stmt)
        }
    }
    expectToken(parser, "RBRACE")
    
    let elseBranch = []
    if (currentToken(parser)[0] == "ELSE") {
        expectToken(parser, "ELSE")
        expectToken(parser, "LBRACE")
        while (len(currentToken(parser)) > 0 && currentToken(parser)[0] != "RBRACE") {
            let stmt = parseStatement(parser)
            if (len(stmt) > 0) {
                elseBranch = appendArray(elseBranch, stmt)
            }
        }
        expectToken(parser, "RBRACE")
    }
    
    return createIfNode(condition, thenBranch, elseBranch)
}

func parseReturn(parser) {
    expectToken(parser, "RETURN")
    let expr = parseExpression(parser)
    return createReturnNode(expr)
}

func parseMatrixDecl(parser) {
    expectToken(parser, "MATRIX")
    expectToken(parser, "LBRACKET")
    let rowsToken = expectToken(parser, "INT")
    let rows = rowsToken[1]
    expectToken(parser, "COMMA")
    let colsToken = expectToken(parser, "INT")
    let cols = colsToken[1]
    expectToken(parser, "RBRACKET")
    let elemTypeToken = expectToken(parser, "IDENT")
    let elemType = elemTypeToken[1]
    
    return createMatrixDeclNode("", rows, cols, elemType)
}

// Main parse function
func parse(tokens) {
    let parser = createParser(tokens)
    return parseProgram(parser)
}
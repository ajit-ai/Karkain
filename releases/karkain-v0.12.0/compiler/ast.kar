// Phase 12, Stage 2: Self-hosted AST Node Definitions
// This file defines AST node structures for the Karkain parser

// AST Node Types
func createProgramNode(statements) {
    let node = []
    node = appendArray(node, "Program")
    node = appendArray(node, statements)
    return node
}

func createFuncDeclNode(name, body) {
    let node = []
    node = appendArray(node, "FuncDecl")
    node = appendArray(node, name)
    node = appendArray(node, body)
    return node
}

func createVarDeclNode(varType, name, value) {
    let node = []
    node = appendArray(node, "VarDecl")
    node = appendArray(node, varType)
    node = appendArray(node, name)
    node = appendArray(node, value)
    return node
}

func createLetDeclNode(name, value) {
    let node = []
    node = appendArray(node, "LetDecl")
    node = appendArray(node, name)
    node = appendArray(node, value)
    return node
}

func createIdentNode(name) {
    let node = []
    node = appendArray(node, "Ident")
    node = appendArray(node, name)
    return node
}

func createIntLiteralNode(value) {
    let node = []
    node = appendArray(node, "IntLiteral")
    node = appendArray(node, value)
    return node
}

func createFloatLiteralNode(value) {
    let node = []
    node = appendArray(node, "FloatLiteral")
    node = appendArray(node, value)
    return node
}

func createStringLiteralNode(value) {
    let node = []
    node = appendArray(node, "StringLiteral")
    node = appendArray(node, value)
    return node
}

func createBoolLiteralNode(value) {
    let node = []
    node = appendArray(node, "BoolLiteral")
    node = appendArray(node, value)
    return node
}

func createBinaryOpNode(op, left, right) {
    let node = []
    node = appendArray(node, "BinaryOp")
    node = appendArray(node, op)
    node = appendArray(node, left)
    node = appendArray(node, right)
    return node
}

func createCallNode(funcName, args) {
    let node = []
    node = appendArray(node, "Call")
    node = appendArray(node, funcName)
    node = appendArray(node, args)
    return node
}

func createPrintNode(expr) {
    let node = []
    node = appendArray(node, "Print")
    node = appendArray(node, expr)
    return node
}

func createIfNode(condition, thenBranch, elseBranch) {
    let node = []
    node = appendArray(node, "If")
    node = appendArray(node, condition)
    node = appendArray(node, thenBranch)
    node = appendArray(node, elseBranch)
    return node
}

func createReturnNode(expr) {
    let node = []
    node = appendArray(node, "Return")
    node = appendArray(node, expr)
    return node
}

func createMatrixDeclNode(name, rows, cols, elemType) {
    let node = []
    node = appendArray(node, "MatrixDecl")
    node = appendArray(node, name)
    node = appendArray(node, rows)
    node = appendArray(node, cols)
    node = appendArray(node, elemType)
    return node
}

func createMatrixIndexNode(matrix, row, col) {
    let node = []
    node = appendArray(node, "MatrixIndex")
    node = appendArray(node, matrix)
    node = appendArray(node, row)
    node = appendArray(node, col)
    return node
}

// Helper function to get node type
func getNodeType(node) {
    return node[0]
}

// Helper function to print AST for debugging
func printAST(node, indent) {
    let nodeType = getNodeType(node)
    print(indent + nodeType)
    
    if (nodeType == "Program") {
        let statements = node[1]
        let i = 0
        while (i < len(statements)) {
            printAST(statements[i], indent + "  ")
            i = i + 1
        }
    }
    
    if (nodeType == "FuncDecl") {
        print(indent + "  Name: " + node[1])
        print(indent + "  Body:")
        let body = node[2]
        let i = 0
        while (i < len(body)) {
            printAST(body[i], indent + "    ")
            i = i + 1
        }
    }
    
    if (nodeType == "VarDecl") {
        print(indent + "  Type: " + node[1])
        print(indent + "  Name: " + node[2])
        print(indent + "  Value:")
        printAST(node[3], indent + "    ")
    }
    
    if (nodeType == "LetDecl") {
        print(indent + "  Name: " + node[1])
        print(indent + "  Value:")
        printAST(node[2], indent + "    ")
    }
    
    if (nodeType == "Ident") {
        print(indent + "  Name: " + node[1])
    }
    
    if (nodeType == "IntLiteral") {
        print(indent + "  Value: " + node[1])
    }
    
    if (nodeType == "FloatLiteral") {
        print(indent + "  Value: " + node[1])
    }
    
    if (nodeType == "StringLiteral") {
        print(indent + "  Value: " + node[1])
    }
    
    if (nodeType == "BoolLiteral") {
        print(indent + "  Value: " + node[1])
    }
    
    if (nodeType == "BinaryOp") {
        print(indent + "  Operator: " + node[1])
        print(indent + "  Left:")
        printAST(node[2], indent + "    ")
        print(indent + "  Right:")
        printAST(node[3], indent + "    ")
    }
    
    if (nodeType == "Call") {
        print(indent + "  Function: " + node[1])
        print(indent + "  Arguments:")
        let args = node[2]
        let i = 0
        while (i < len(args)) {
            printAST(args[i], indent + "    ")
            i = i + 1
        }
    }
    
    if (nodeType == "Print") {
        print(indent + "  Expression:")
        printAST(node[1], indent + "    ")
    }
}
func p(label, v) {
	print(label + " " + str(v))
}

func main() {
	p("255&15", 255 & 15)
	p("0|0", 0 | 0)
	p("0|7", 0 | 7)
	p("7|0", 7 | 0)
	p("0^0", 0 ^ 0)
	p("5^3", 5 ^ 3)
	p("255^0", 255 ^ 0)
	p("0^255", 0 ^ 255)
	p("597&21", 597 & 21)
	p("1<<0", 1 << 0)
	p("1<<1", 1 << 1)
	p("1<<4", 1 << 4)
	p("1<<10", 1 << 10)
	p("1024>>3", 1024 >> 3)
	p("1>>1", 1 >> 1)
	p("1<<63", 1 << 63)
	p("1<<64", 1 << 64)
	p("1<<65", 1 << 65)
	p("1<<(-1)", 1 << (0 - 1))
	p("1024>>(-1)", 1024 >> (0 - 1))
	p("1024>>64", 1024 >> 64)
	p("1024>>63", 1024 >> 63)
	p("-8>>1", (0 - 8) >> 1)
	p("-1>>63", (0 - 1) >> 63)
	p("-1>>64", (0 - 1) >> 64)
	p("-1&255", (0 - 1) & 255)
	p("-1|0", (0 - 1) | 0)
	p("1<<3+1", 1 << 3 + 1)
	p("1<<(3+1)", 1 << (3 + 1))
	p("6&3+1", 6 & 3 + 1)
	p("6&(3+1)", 6 & (3 + 1))
	p("1|2^3&1", 1 | 2 ^ 3 & 1)
	p("(1|2)^(3&1)", (1 | 2) ^ (3 & 1))
	p("1|2==2", 1 | 2 == 2)
	p("1==2|2", 1 == 2 | 2)
	p("1<<2*2", 1 << 2 * 2)
	p("1<<2*3", 1 << 2 * 3)
	p("2*1<<3", 2 * 1 << 3)
	p("byte-roundtrip", (255 & 15) | ((7 ^ 5) << 4))
	p("imm64", 1234605616436508552 >> 8)
}
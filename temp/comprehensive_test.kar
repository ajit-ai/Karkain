// ===== KARKAIN COMPREHENSIVE TEST =====

// --- Test 1: Basic functions with parameters and return ---
func add(a, b) {
    return a + b
}

func multiply(a, b) {
    return a * b
}

func greet(name) {
    print("Hello from function!")
    print(name)
}

// --- Test 2: Variables (let/var) ---
func test_variables() {
    let x = 42
    let name = "Karkain"
    let pi = 3.14
    print(x)
    print(name)
    print(pi)
}

// --- Test 3: Arithmetic operators with precedence ---
func test_precedence() {
    // Should be 14, not 20
    let result = 2 + 3 * 4
    print(result)

    // Should be 14, not 14... wait: (2+3)*4 = 20, but 2+(3*4) = 14
    // Precedence: * before +
    let a = 10 - 2 * 3
    print(a) // should be 4

    let b = (10 - 2) * 3
    print(b) // should be 24... but we don't have parens in primary?
}

// --- Test 4: Comparison operators ---
func test_comparisons() {
    let big = 10 > 5
    let small = 3 < 7
    let equal = 5 == 5
    let noteq = 5 != 3
    let geq = 10 >= 10
    let leq = 3 <= 5
    print(big)
    print(small)
    print(equal)
    print(noteq)
    print(geq)
    print(leq)
}

// --- Test 5: String operations ---
func test_strings() {
    let first = "Hello"
    let second = " World"
    let combined = first + second
    print(combined)

    let len_result = len(combined)
    print(len_result)
}

// --- Test 6: While loops ---
func test_while() {
    let i = 0
    let sum = 0
    while (i < 5) {
        sum = sum + i
        i = i + 1
    }
    print(sum) // should be 0+1+2+3+4 = 10
}

// --- Test 7: If/else if/else ---
func test_if_else() {
    let score = 85
    if (score >= 90) {
        print("A")
    } else if (score >= 80) {
        print("B")
    } else if (score >= 70) {
        print("C")
    } else {
        print("F")
    }
}

// --- Test 8: Arrays ---
func test_arrays() {
    let arr = [10, 20, 30]
    let first = arr[0]
    let second = arr[1]
    let third = arr[2]
    print(first)
    print(second)
    print(third)
}

// --- Test 9: Maps ---
func test_maps() {
    let m = {"a": 1, "b": 2, "c": 3}
    let va = m["a"]
    let vb = m["b"]
    print(va)
    print(vb)
}

// --- Test 10: Built-in functions ---
func test_builtins() {
    let s = "  hello world  "
    let trimmed = trim(s)
    print(trimmed)

    let haystack = "hello world"
    let found = contains(haystack, "world")
    print(found)

    let parts = split("a,b,c", ",")
    print(parts)

    let sq = sqrt(16)
    print(sq)

    let ab = abs(-42)
    print(ab)

    let pw = pow(2, 10)
    print(pw)
}

// --- Test 11: C interop (basic - skip, requires top-level import) ---
func test_c_interop() {
    print("C interop - skipped (requires top-level import)")
}

// --- Test 12: Matrix ---
func test_matrix() {
    matrix[2,2] float64 m
    print("matrix declared")
}

// --- Test 13: Recursion ---
func factorial(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

func test_recursion() {
    let f5 = factorial(5)
    print(f5) // should be 120

    let f10 = factorial(10)
    print(f10) // should be 3628800
}

// --- Test 14: Nested loops ---
func test_nested_loops() {
    let i = 0
    let total = 0
    while (i < 3) {
        let j = 0
        while (j < 3) {
            total = total + 1
            j = j + 1
        }
        i = i + 1
    }
    print(total) // should be 9
}

// --- Test 15: Float arithmetic ---
func test_float_ops() {
    let a = 1.5
    let b = 2.5
    let sum = a + b
    let diff = b - a
    let prod = a * b
    print(sum) // 4
    print(diff) // 1
    print(prod) // 3.75
}

// --- MAIN ---
func main() {
    print("=== Test 1: Functions ===")
    let r = add(3, 7)
    print(r)
    let m = multiply(4, 5)
    print(m)
    greet("test")

    print("=== Test 2: Variables ===")
    test_variables()

    print("=== Test 3: Precedence ===")
    test_precedence()

    print("=== Test 4: Comparisons ===")
    test_comparisons()

    print("=== Test 5: Strings ===")
    test_strings()

    print("=== Test 6: While loops ===")
    test_while()

    print("=== Test 7: If/else ===")
    test_if_else()

    print("=== Test 8: Arrays ===")
    test_arrays()

    print("=== Test 9: Maps ===")
    test_maps()

    print("=== Test 10: Builtins ===")
    test_builtins()

    print("=== Test 11: C interop ===")
    test_c_interop()

    print("=== Test 12: Matrix ===")
    test_matrix()

    print("=== Test 13: Recursion ===")
    test_recursion()

    print("=== Test 14: Nested loops ===")
    test_nested_loops()

    print("=== Test 15: Float ops ===")
    test_float_ops()

    print("=== ALL TESTS COMPLETE ===")
}

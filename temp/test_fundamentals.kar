// Test 1: Function parameters and return
func add(a, b) {
    return a + b
}

func main() {
    // Test parameters
    let result = add(3, 7)
    print(result)

    // Test while loop
    let i = 0
    while (i < 5) {
        print(i)
        i = i + 1
    }

    // Test operator precedence: 2 + 3 * 4 should be 14, not 20
    let val = 2 + 3 * 4
    print(val)

    // Test string concatenation
    let hello = "Hello"
    let world = " World"
    let msg = hello + world
    print(msg)

    // Test != operator
    let check = 5 != 3
    print(check)

    // Test float64
    let pi = 3.14
    let doubled = pi + pi
    print(doubled)

    // Test else if
    let x = 10
    if (x > 20) {
        print("big")
    } else if (x > 5) {
        print("medium")
    } else {
        print("small")
    }
}

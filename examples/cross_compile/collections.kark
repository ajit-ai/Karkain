// collections.kark - cross-compilation target exercising arrays and strings
// (reference/pointer-sized data) so target data-layout stays honest across
// every Phase-111 target.

func sum(vals) {
    var total = 0
    let n = len(vals)
    let i = 0
    while (i < n) {
        total = total + vals[i]
        i = i + 1
    }
    return total
}

func main() {
    let nums = [3, 1, 4, 1, 5, 9, 2, 6]
    println(str(sum(nums)))
    let s = "cross-collections-" + str(len(nums))
    println(s)
    println(str(len(nums) * 10))
}
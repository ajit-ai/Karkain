// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 12 Scientific Computing
//
// 3x3 integer matrix multiplication: C = A * B. Integer arithmetic keeps
// output exact and byte-identical across engines.
//
// Run:  karkain run examples/12-scientific-computing/04_matrix_multiply.kark

func matmul(a, b) {
    let c = []
    let i = 0
    while (i < 3) {
        let row = []
        let j = 0
        while (j < 3) {
            let acc = 0
            let k = 0
            while (k < 3) {
                acc = acc + a[i * 3 + k] * b[k * 3 + j]
                k = k + 1
            }
            push(row, acc)
            j = j + 1
        }
        push(c, row)
        i = i + 1
    }
    return c
}

func main() {
    let a = [2, 0, 1, 1, 2, 0, 0, 1, 3]
    let b = [1, 0, 2, 0, 1, 1, 2, 1, 0]

    let c = matmul(a, b)
    print(c[0])
    print(c[1])
    print(c[2])
    print(c[0][0])
    print(c[2][2])
}
func classify(n) {
    if (n < 0) {
        return -1
    } else if (n == 0) {
        return 0
    } else if (n < 100) {
        return 1
    }
    return 2
}
func main() {
    let total = 0
    let i = 0
    while (i < 3) {
        let j = 0
        while (j < 4) {
            total = total + 1
            j = j + 1
        }
        i = i + 1
    }
    print(total)
    print(classify(-5))
    print(classify(0))
    print(classify(50))
    print(classify(500))
}
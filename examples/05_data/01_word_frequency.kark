// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 05 Data
//
// Text processing: tokenize a sentence with std.string, tally frequencies
// in a map, and report the top-level counts deterministically by key.
//
// Run:  karkain run examples/05_data/01_word_frequency.kark

import std.string
import std.collections

func main() {
    let text = "the fox and the hound and the fox"
    let words = str_split(text, " ")

    let counts = {}
    let i = 0
    while (i < len(words)) {
        let w = words[i]
        if (map_contains_key(counts, w)) {
            counts[w] = counts[w] + 1
        } else {
            counts[w] = 1
        }
        i = i + 1
    }

    print(counts["the"])
    print(counts["fox"])
    print(counts["and"])
    print(counts["hound"])
    print(len(words))
}
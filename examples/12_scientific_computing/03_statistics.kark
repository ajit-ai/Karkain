// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 12 Scientific Computing
//
// Sample statistics over a numeric array: mean, variance and standard
// deviation (population formulas). Floats are accumulated with plain
// arithmetic and print at 6 significant figures on both engines.
//
// Run:  karkain run examples/12_scientific_computing/03_statistics.kark

func mean(xs) {
    let total = 0.0
    let i = 0
    while (i < len(xs)) {
        total = total + xs[i]
        i = i + 1
    }
    return total / len(xs)
}

func variance(xs) {
    let m = mean(xs)
    let total = 0.0
    let i = 0
    while (i < len(xs)) {
        let d = xs[i] - m
        total = total + d * d
        i = i + 1
    }
    return total / len(xs)
}

func stddev(xs) {
    return sqrt_newton(variance(xs), 12)
}

func sqrt_newton(x, guesses) {
    let r = 1.0
    let i = 0
    while (i < guesses) {
        r = (r + x / r) / 2
        i = i + 1
    }
    return r
}

func main() {
    let data = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
    print(mean(data))
    print(variance(data))
    print(stddev(data))
}
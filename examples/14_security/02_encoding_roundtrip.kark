// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 14 Security
//
// Encoding round-trips for (safe, educational) data handling. Hex and
// Base64 follow RFC 4648; decode(encode(x)) == x.
//
// Run:  karkain run examples/14_security/02_encoding_roundtrip.kark

import std.encoding

func main() {
    let message = "verify me"
    let h = hex_encode(message)
    print(h)
    print(hex_decode(h))

    let b = base64_encode(message)
    print(b)
    print(base64_decode(b))
}
// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 14 Security
//
// Educational password-hash demonstration: salt + sha256 (hex string),
// and an explicit compare. This is a teaching example, NOT production-grade
// KDF material (no key stretching, no secure random source exists yet).
//
// Run:  karkain run examples/14_security/03_password_hash.kark

import std.crypto
import std.string

func hash_password(password, salt) {
    return sha256(salt + password)
}

func main() {
    let salt = "karkain-demo-salt"
    let stored = hash_password("hunter2", salt)
    print(stored)

    let attemptA = hash_password("hunter2", salt)
    let attemptB = hash_password("hunter3", salt)
    print(attemptA == stored)
    print(attemptB == stored)
    print(str_len(stored))
}
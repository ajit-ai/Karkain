// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 14 Security
//
// UTF-8 handling: encode a string with a non-ASCII character to bytes, hex
// the byte form, decode back, and validate. The std.encoding module is the
// source of truth for byte-level text work.
//
// Run:  karkain run examples/14_security/04_utf8_text.kark

import std.encoding
import std.string

func main() {
    let s = "café"
    print(utf8_valid(s))
    let bytes = utf8_encode(s)
    print(hex_encode(bytes))
    let round = utf8_decode(bytes)
    print(round == s)
    print(str_to_upper(s))
}
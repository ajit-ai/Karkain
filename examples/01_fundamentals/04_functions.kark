// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 01 Fundamentals
//
// Functions bundle reusable behavior. Parameters are passed by value.
// A function returns with `return value`. Recursion is supported.
//
// Run:  karkain run examples/01_fundamentals/04_functions.kark

func square(x) {
    return x * x
}

func sum(a, b) {
    return a + b
}

func describe(n) {
    if (n < 0) {
        return "negative"
    } else {
        return "non-negative"
    }
}

func factorial(n) {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

func main() {
    print(square(7))
    print(sum(3, 4))
    print(describe(-2))
    print(describe(5))
    print(factorial(5))
    print(factorial(0))
}
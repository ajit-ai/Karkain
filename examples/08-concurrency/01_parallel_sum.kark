// Status: Experimental
// Engine: go (kcc parity for concurrency is a documented post-107 boundary)
// Category: 08 Concurrency
//
// Work-grid style parallelism: spawn a task per lane, join each result, and
// accumulate. Deterministic because joins serialize the outcome. The
// Phase 107 runtime backs spawn/join with a work-stealing scheduler.
//
// Run:  karkain run examples/08-concurrency/01_parallel_sum.kark --engine go

func square(i) {
    return i * i
}

func main() {
    let tasks = []
    let n = 0
    while (n < 10) {
        push(tasks, spawn(square, n))
        n = n + 1
    }

    let total = 0
    let i = 0
    while (i < len(tasks)) {
        total = total + join(tasks[i])
        i = i + 1
    }
    print(total)
    wait_all()
}
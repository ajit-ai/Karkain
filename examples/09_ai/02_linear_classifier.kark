// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 09 AI
//
// A tiny linear classifier: learn weights w so that w1*x1 + w2*x2 + b has
// one sign for class A and the opposite for class B, by simple additive
// updates over the (synthetic) training pairs. Illustrates gradient-style
// weight updates with nothing but loops and arithmetic.
//
// Run:  karkain run examples/09_ai/02_linear_classifier.kark

func dot(w1, w2, x1, x2) {
    return w1 * x1 + w2 * x2
}

func predict(w1, w2, b, x1, x2) {
    if (dot(w1, w2, x1, x2) + b >= 0) {
        return 1
    }
    return -1
}

func main() {
    let w1 = 0
    let w2 = 0
    let b = 0
    let lr = 1

    // synthetic training pairs: (x1, x2, label)
    let xs1 = [1, 2, 3, 2, 1]
    let xs2 = [1, 1, 1, 3, 3]
    let ys = [1, 1, 1, -1, -1]

    let epoch = 0
    while (epoch < 100) {
        let i = 0
        let changed = 0
        while (i < len(xs1)) {
            let yhat = predict(w1, w2, b, xs1[i], xs2[i])
            if (yhat != ys[i]) {
                w1 = w1 + lr * ys[i] * xs1[i]
                w2 = w2 + lr * ys[i] * xs2[i]
                b = b + lr * ys[i]
                changed = 1
            }
            i = i + 1
        }
        if (changed == 0) {
            print(epoch)
            epoch = 100
        }
        epoch = epoch + 1
    }

    print(predict(w1, w2, b, 2, 1))
    print(predict(w1, w2, b, 1, 3))
    print(w1)
    print(w2)
}
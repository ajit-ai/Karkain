// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 01 Fundamentals
//
// `const` declares an immutable local binding. Reassigning a const is a
// compile-time error. Constants keep magic numbers out of the middle of code.
//
// Run:  karkain run examples/01-fundamentals/03_constants.kark

func main() {
    const int TAX_RATE = 8
    const int BASE_PRICE = 500

    int price = BASE_PRICE
    int tax = price * TAX_RATE / 100
    int total = price + tax
    print(total)
    print(TAX_RATE)
}
// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 01 Fundamentals
//
// Loops: `while` is the core loop. Conditions are parenthesized.
// The classic patterns: counting, accumulation, and bounded iteration.
//
// Run:  karkain run examples/01-fundamentals/06_loops.kark

func main() {
    let i = 0
    while (i < 5) {
        print(i)
        i = i + 1
    }

    let sum = 0
    let n = 1
    while (n <= 10) {
        sum = sum + n
        n = n + 1
    }
    print(sum)

    print(countdown(3))
}

func countdown(n) {
    let out = []
    while (n > 0) {
        push(out, n)
        n = n - 1
    }
    return out
}
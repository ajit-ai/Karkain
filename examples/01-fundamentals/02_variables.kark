// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 01 Fundamentals
//
// Variables are declared with an explicit type: `int name = 42`.
// Values are explicitly typed and live in a block-scoped frame.
// Reassignment uses =.
//
// Run:  karkain run examples/01-fundamentals/02_variables.kark

func main() {
    int answer = 42
    string greeting = "karkain"
    print(answer)
    print(greeting)

    int total = 0
    total = total + 100
    total = total + 20
    total = total + 3
    print(total)
}
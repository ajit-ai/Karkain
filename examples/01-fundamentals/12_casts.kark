// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 01 Fundamentals
//
// Type conversions: int(f) truncates a float to int, str(n) renders an int
// as a string. Integer division truncates; float literals carry a decimal
// point. Mixed int/float expressions promote to float.
//
// Run:  karkain run examples/01-fundamentals/12_casts.kark

func main() {
    print(17 / 5)
    print(17.0 / 5.0)

    let f = 9.0
    print(f / 2)
    print(int(f))
    print(int(7.9))
    print(str(256))

    let half = 7 / 2
    let exact = 7.0 / 2.0
    print(half)
    print(exact)

    let pixels = 1920
    let cols = 3
    print(pixels / cols)
    print(pixels % cols)
}
// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 01 Fundamentals
//
// Match produces a value from a set of patterns. The options matched here
// are Some(value) / None from the checked arithmetic helpers (add_checked,
// sub_checked, mul_checked) plus a literal-bound label match.
//
// NOTE: matching computed function results has a kcc parity gap (see
// docs/examples); the runnable examples restrict match to the patterns
// both engines agree on.
//
// Run:  karkain run examples/01-fundamentals/11_match.kark

func main() {
    let r1 = add_checked(100, 200)
    match r1 {
        Some(v) => print(v),
        None => print("overflow")
    }

    let r2 = sub_checked(10, 3)
    match r2 {
        Some(v) => print(v),
        None => print("underflow")
    }

    let r3 = mul_checked(1000, 1000)
    match r3 {
        Some(v) => print(v),
        None => print("overflow")
    }

    let x = 3
    let label = match x {
        1 => "one",
        3 => "three"
    }
    print(label)
}
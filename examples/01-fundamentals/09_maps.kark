// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 01 Fundamentals
//
// Maps store key -> value associations, indexed with map[key]. Enumeration
// helpers (map_keys, map_contains_key) live in std.collections. String
// arrays print with different bracket styles per engine, so enumerate
// element-by-element for byte-identical output.
//
// Run:  karkain run examples/01-fundamentals/09_maps.kark

import std.collections

func main() {
    let scores = { "ana": 92, "bob": 84 }
    print(scores["ana"])
    print(scores["bob"])

    scores["cam"] = 97
    print(scores["cam"])

    let counts = {}
    counts["k"] = 1
    counts["k"] = counts["k"] + 1
    print(counts["k"])

    print(map_contains_key(scores, "ana"))
    print(map_contains_key(scores, "zed"))

    let names = map_keys(scores)
    print(len(names))
    let i = 0
    while (i < len(names)) {
        print(names[i])
        i = i + 1
    }
}
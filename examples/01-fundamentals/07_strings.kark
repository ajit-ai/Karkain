// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 01 Fundamentals
//
// Strings are immutable sequences of characters. They support +
// concatenation, len(s), zero-based indexing (yielding a one-character
// string), slicing, and conversion to/from int with str().
//
// Run:  karkain run examples/01-fundamentals/07_strings.kark

func main() {
    let first = "kark"
    let second = "ain"
    let name = first + second
    print(name)
    print(len(name))
    print(name[0])
    print(name[5])
    print(name[0: 4])

    print("computed: " + str(21 * 2))
}
// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 10 Machine Learning
//
// Ordinary least squares (closed form) on synthetic data: y = 0.9x + 1.3.
// All arithmetic is plain Karkain floats — training is a real computation,
// ridden through the current language surface rather than a framework call.
//
// Run:  karkain run examples/10_machine_learning/01_linear_regression.kark

func main() {
    let xs = [1, 2, 3, 4, 5]
    let ys = [2, 3, 5, 4, 6]

    let n = len(xs)
    let sum_x = 0.0
    let sum_y = 0.0
    let sum_xy = 0.0
    let sum_xx = 0.0

    let i = 0
    while (i < n) {
        let x = xs[i] * 1.0
        let y = ys[i] * 1.0
        sum_x = sum_x + x
        sum_y = sum_y + y
        sum_xy = sum_xy + x * y
        sum_xx = sum_xx + x * x
        i = i + 1
    }

    let denom = n * sum_xx - sum_x * sum_x
    let slope = (n * sum_xy - sum_x * sum_y) / denom
    let intercept = (sum_y - slope * sum_x) / n

    print(slope)
    print(intercept)
    print(slope * 6 + intercept)
}
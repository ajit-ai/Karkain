// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 02 Algorithms
//
// Bubble sort: repeated adjacent swaps. Arrays are passed by value, so the
// function returns a new sorted copy.
//
// Run:  karkain run examples/02_algorithms/04_bubble_sort.kark

func bubble_sort(xs) {
    let n = len(xs)
    let swapped = 1
    while (swapped == 1) {
        swapped = 0
        let i = 1
        while (i < n) {
            if (xs[i - 1] > xs[i]) {
                let tmp = xs[i - 1]
                xs[i - 1] = xs[i]
                xs[i] = tmp
                swapped = 1
            }
            i = i + 1
        }
    }
    return xs
}

func main() {
    let data = [5, 2, 8, 1, 9, 3, 7]
    let sorted = bubble_sort(data)
    print(sorted)
    print(bubble_sort([1, 2, 3, 4]))
    print(bubble_sort([4, 3, 2, 1]))
}
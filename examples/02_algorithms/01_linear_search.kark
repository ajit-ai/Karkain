// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 02 Algorithms
//
// Linear search: scan an unsorted array for a value, return its index or -1.
//
// Run:  karkain run examples/02_algorithms/01_linear_search.kark

func linear_search(xs, target) {
    let i = 0
    while (i < len(xs)) {
        if (xs[i] == target) {
            return i
        }
        i = i + 1
    }
    return -1
}

func main() {
    let data = [42, 17, 99, 3, 7, 12]
    print(linear_search(data, 99))
    print(linear_search(data, 3))
    print(linear_search(data, 100))
}
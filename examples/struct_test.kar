type Person struct {
    name string
    age int
}

func main() {
    let p = Person{name: "Alice", age: 30}

    print("=== Phase 9: Struct Test ===")
    print("Initial values:")
    print(p.name)
    print(p.age)

    p.name = "Bob"
    p.age = 35

    print("Modified values:")
    print(p.name)
    print(p.age)
}

// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 13 Finance
//
// Compound interest on synthetic values, in integer pennies with a basis-point
// style annual percent. Year-by-year exponentiation by a loop.
//
// Run:  karkain run examples/13-finance/01_compound_interest.kark

func compound(start, years, percent) {
    let amount = start
    let year = 0
    while (year < years) {
        amount = amount + amount * percent / 100
        year = year + 1
    }
    return amount
}

func main() {
    // 1000 at 5% for 3 years
    print(compound(100000, 3, 5))
    // 2000 at 3% for 5 years
    print(compound(200000, 5, 3))
    // doubling check: 100 at 100% for 1 year
    print(compound(10000, 1, 100))
    print(compound(10000, 0, 5))
}
// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 13 Finance
//
// Net present value of a synthetic cash-flow stream at a discount rate.
// Each year's discount factor is applied iteratively (no pow needed).
//
// Run:  karkain run examples/13-finance/03_npv.kark

func npv(flows, yearly) {
    let present = 0.0
    let factor = 1.0
    let i = 0
    while (i < len(flows)) {
        factor = factor / (1 + yearly)
        present = present + flows[i] * factor
        i = i + 1
    }
    return present
}

func main() {
    // invest 10000 now, receive 5500 for 2 years at 10%
    print(npv([5500.0, 5500.0], 0.10) - 10000.0)
    // flat 1000 over 5 years at 8%
    print(npv([1000.0, 1000.0, 1000.0, 1000.0, 1000.0], 0.08))
}
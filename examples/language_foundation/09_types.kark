// 09_types.kark — typed variables, arithmetic, math builtins, casts.
// Run:  karkain run examples/language_foundation/09_types.kark

func main() {
    int a = 10
    int b = 4
    float64 f = 9.0
    print(a + b)
    print(a - b)
    print(a * b)
    print(a / b)
    print(a % b)
    print(f / 2)
    print(sqrt(16))
    print(abs(-3))
    print(pow(2, 10))
    print(int(f))
    print(str(a))
}
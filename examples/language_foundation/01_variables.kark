// 01_variables.kark — variables, literals, types, arithmetic.
// Run:  karkain run examples/language_foundation/01_variables.kark

func main() {
    string name = "Karkain"
    int age = 29
    float64 pi = 3.14159
    bool ok = true
    int count = 100

    age = age + 1
    print(name)
    print(age)
    print(pi)
    print(ok)
    print(count * 2)

    int a = 5
    float64 b = 2.5
    print(a)
    print(b)
}
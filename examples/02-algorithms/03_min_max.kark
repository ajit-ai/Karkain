// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 02 Algorithms
//
// Min/max over an array using a rolling comparison.
//
// Run:  karkain run examples/02-algorithms/03_min_max.kark

func array_min(xs) {
    let best = xs[0]
    let i = 1
    while (i < len(xs)) {
        if (xs[i] < best) {
            best = xs[i]
        }
        i = i + 1
    }
    return best
}

func array_max(xs) {
    let best = xs[0]
    let i = 1
    while (i < len(xs)) {
        if (xs[i] > best) {
            best = xs[i]
        }
        i = i + 1
    }
    return best
}

func main() {
    let data = [7, 3, 12, 1, 9, 5, 8]
    print(array_min(data))
    print(array_max(data))
    print(array_min([-4, -9, -1]))
    print(array_max([-4, -9, -1]))
}
// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 02 Algorithms
//
// Sieve of Eratosthenes: mark composites up to n, keep the primes.
//
// Run:  karkain run examples/02-algorithms/09_prime_sieve.kark

func sieve(n) {
    let composite = []
    push(composite, 0)
    push(composite, 0)
    let i = 2
    while (i <= n) {
        push(composite, 0)
        i = i + 1
    }

    let p = 2
    while (p * p <= n) {
        let m = p * p
        while (m <= n) {
            composite[m] = 1
            m = m + p
        }
        p = p + 1
    }

    let primes = []
    let j = 2
    while (j <= n) {
        if (composite[j] == 0) {
            push(primes, j)
        }
        j = j + 1
    }
    return primes
}

func main() {
    print(sieve(10))
    print(len(sieve(30)))
    print(sieve(30))
}
// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 02 Algorithms
//
// Iterative factorial: n! = 1 * 2 * ... * n.
//
// Run:  karkain run examples/02-algorithms/07_factorial.kark

func factorial(n) {
    let result = 1
    let i = 1
    while (i <= n) {
        result = result * i
        i = i + 1
    }
    return result
}

func main() {
    print(factorial(0))
    print(factorial(1))
    print(factorial(5))
    print(factorial(8))
    print(factorial(12))
}
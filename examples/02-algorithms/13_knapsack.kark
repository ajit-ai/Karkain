// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 02 Algorithms
//
// The 0/1 knapsack problem solved with dynamic programming over a 2D table:
// dp[i][c] is the best value using the first i items with capacity c. The
// table is built from arrays; answers are exact and deterministic.
//
// Run:  karkain run examples/02-algorithms/13_knapsack.kark

func knapsack(capacity, weights, values, count) {
    var dp = []
    let i = 0
    while (i <= count) {
        let row = []
        let c = 0
        while (c <= capacity) {
            push(row, 0)
            c = c + 1
        }
        push(dp, row)
        i = i + 1
    }

    i = 1
    while (i <= count) {
        let c = 1
        while (c <= capacity) {
            let without = dp[i - 1][c]
            if (weights[i - 1] > c) {
                dp[i][c] = without
            } else {
                let with = dp[i - 1][c - weights[i - 1]] + values[i - 1]
                if (with > without) {
                    dp[i][c] = with
                } else {
                    dp[i][c] = without
                }
            }
            c = c + 1
        }
        i = i + 1
    }

    return dp[count][capacity]
}

func main() {
    let weights = [2, 3, 4, 5]
    let values = [3, 4, 5, 6]

    print(knapsack(5, weights, values, 4))   // choose (2,3)+(3,4) = 7
    print(knapsack(7, weights, values, 4))   // best of (2,3)+(5,6) / (3,4)+(4,5)
}
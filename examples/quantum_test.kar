// Phase 14: Quantum Computing Test
// Test basic quantum operations

func main() {
    // Declare a 2-qubit quantum register
    qreg qr[2]
    
    // Apply Hadamard gate to qubit 0
    H qr[0]
    
    // Apply CNOT gate with control qubit 0 and target qubit 1
    CNOT qr[0], qr[1]
    
    // Measure qubit 0
    measure qr[0]
    
    // Measure qubit 1
    measure qr[1]
}

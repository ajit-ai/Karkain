func min(a, b) {
    if (a <= b) {
        return a
    }
    return b
}

func min3(a, b, c) {
    return min(min(a, b), c)
}

func levenshtein(a, b) {
    let m = len(a)
    let n = len(b)
    let dp = []
    let i = 0
    while (i <= m) {
        let row = []
        let j = 0
        while (j <= n) {
            push(row, 0)
            j = j + 1
        }
        push(dp, row)
        i = i + 1
    }
    i = 0
    while (i <= m) {
        dp[i][0] = i
        i = i + 1
    }
    let j = 0
    while (j <= n) {
        dp[0][j] = j
        j = j + 1
    }
    i = 1
    while (i <= m) {
        j = 1
        while (j <= n) {
            let cost = 0
            if (a[i - 1] != b[j - 1]) {
                cost = 1
            }
            let del = dp[i - 1][j] + 1
            let ins = dp[i][j - 1] + 1
            let sub = dp[i - 1][j - 1] + cost
            dp[i][j] = min3(del, ins, sub)
            j = j + 1
        }
        i = i + 1
    }
    return dp[m][n]
}

func main() {
    print("Levenshtein distance 'kitten' -> 'sitting':")
    print(levenshtein("kitten", "sitting"))
    print("Levenshtein distance 'sunday' -> 'saturday':")
    print(levenshtein("sunday", "saturday"))
}
func heapify(data, n, i) {
    let largest = i
    let l = 2 * i + 1
    let r = 2 * i + 2
    if (l < n && data[l] > data[largest]) {
        largest = l
    }
    if (r < n && data[r] > data[largest]) {
        largest = r
    }
    if (largest != i) {
        let t = data[i]
        data[i] = data[largest]
        data[largest] = t
        heapify(data, n, largest)
    }
}

func heap_sort(data) {
    let n = len(data)
    let i = n / 2 - 1
    while (i >= 0) {
        heapify(data, n, i)
        i = i - 1
    }
    let e = n - 1
    while (e > 0) {
        let t = data[0]
        data[0] = data[e]
        data[e] = t
        heapify(data, e, 0)
        e = e - 1
    }
}

func print_array(a) {
    let i = 0
    while (i < len(a)) {
        print(a[i])
        i = i + 1
    }
}

func main() {
    let data = [12, 11, 13, 5, 6, 7]
    heap_sort(data)
    print("HeapSort result:")
    print_array(data)
}
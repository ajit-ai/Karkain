func is_prime(n) {
    if (n < 2) {
        return 0
    }
    int d = 2
    while (d * d <= n) {
        if (n % d == 0) {
            return 0
        }
        d = d + 1
    }
    return 1
}

func main() {
    int limit = 30
    int[] primes = []
    int n = 2
    while (n <= limit) {
        if (is_prime(n)) {
            push(primes, n)
        }
        n = n + 1
    }
    print("Primes up to 30:")
    int i = 0
    while (i < len(primes)) {
        print(primes[i])
        i = i + 1
    }
}
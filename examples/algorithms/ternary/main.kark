func ternary_search(data, target) {
    int low = 0
    int high = len(data) - 1
    while (low <= high) {
        int third = (high - low) / 3
        int mid1 = low + third
        int mid2 = high - third
        int e1 = data[mid1]
        int e2 = data[mid2]
        if (e1 == target) {
            return mid1
        }
        if (e2 == target) {
            return mid2
        }
        if (target < e1) {
            high = mid1 - 1
        } else if (target > e2) {
            low = mid2 + 1
        } else {
            low = mid1 + 1
            high = mid2 - 1
        }
    }
    return -1
}

func main() {
    int[] data = [10, 20, 30, 40, 50, 60, 70, 80, 90]
    print("Ternary Search for 80:")
    print(ternary_search(data, 80))
    print("Ternary Search for 75 (not found):")
    print(ternary_search(data, 75))
}
func bellman_ford(edges, n, start, target) {
    let dist = []
    let i = 0
    while (i < n) {
        push(dist, 999999)
        i = i + 1
    }
    dist[start] = 0
    let iter = 0
    while (iter < n - 1) {
        let k = 0
        while (k < len(edges)) {
            let e = edges[k]
            let u = e[0]
            let v = e[1]
            let w = e[2]
            if (dist[u] != 999999 && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w
            }
            k = k + 1
        }
        iter = iter + 1
    }
    if (dist[target] == 999999) {
        return -1
    }
    return dist[target]
}

func main() {
    let edges = [[0, 1, 4], [0, 2, 2], [1, 2, 1], [1, 3, 5], [2, 3, 3]]
    print("Bellman-Ford shortest 0 -> 3:")
    print(bellman_ford(edges, 4, 0, 3))
}
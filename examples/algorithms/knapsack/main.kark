func max(a, b) {
    if (a >= b) {
        return a
    }
    return b
}

func knapsack(weights, values, capacity) {
    int n = len(weights)
    int[] dp = []
    int i = 0
    while (i <= n) {
        int[] row = []
        int j = 0
        while (j <= capacity) {
            push(row, 0)
            j = j + 1
        }
        push(dp, row)
        i = i + 1
    }
    i = 1
    while (i <= n) {
        int j = 0
        while (j <= capacity) {
            int without = dp[i - 1][j]
            if (weights[i - 1] <= j) {
                int withItem = dp[i - 1][j - weights[i - 1]] + values[i - 1]
                dp[i][j] = max(withItem, without)
            } else {
                dp[i][j] = without
            }
            j = j + 1
        }
        i = i + 1
    }
    return dp[n][capacity]
}

func main() {
    int[] weights = [1, 3, 4, 5]
    int[] values = [1, 4, 5, 7]
    int capacity = 7
    print("0/1 Knapsack max value:")
    print(knapsack(weights, values, capacity))
}
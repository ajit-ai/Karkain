func dfs_visit(graph, node, visited) {
    visited[node] = 1
    let k = 0
    while (k < len(graph[node])) {
        let next = graph[node][k]
        if (visited[next] == 0) {
            dfs_visit(graph, next, visited)
        }
        k = k + 1
    }
}

func dfs(graph, start, target) {
    let n = len(graph)
    let visited = []
    let i = 0
    while (i < n) {
        push(visited, 0)
        i = i + 1
    }
    dfs_visit(graph, start, visited)
    return visited[target]
}

func main() {
    let graph = [[1, 2], [0, 3, 4], [0, 5], [1], [1], [2]]
    print("DFS: start 0 visits 5?")
    print(dfs(graph, 0, 5))
    print("DFS: start 0 visits 3?")
    print(dfs(graph, 0, 3))
}
func merge(left, right) {
    int[] result = []
    int i = 0
    int j = 0
    while (i < len(left) && j < len(right)) {
        if (left[i] <= right[j]) {
            push(result, left[i])
            i = i + 1
        } else {
            push(result, right[j])
            j = j + 1
        }
    }
    while (i < len(left)) {
        push(result, left[i])
        i = i + 1
    }
    while (j < len(right)) {
        push(result, right[j])
        j = j + 1
    }
    return result
}

func merge_sort(data) {
    int n = len(data)
    if (n <= 1) {
        return data
    }
    int mid = n / 2
    int left = data[0:mid]
    int right = data[mid:n]
    string sl = merge_sort(left)
    string sr = merge_sort(right)
    return merge(sl, sr)
}

func print_array(a) {
    int i = 0
    while (i < len(a)) {
        print(a[i])
        i = i + 1
    }
}

func main() {
    int[] data = [38, 27, 43, 3, 9, 82, 10]
    string sorted = merge_sort(data)
    print("MergeSort result:")
    print_array(sorted)
}
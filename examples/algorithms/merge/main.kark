func merge(left, right) {
    let result = []
    let i = 0
    let j = 0
    while (i < len(left) && j < len(right)) {
        if (left[i] <= right[j]) {
            push(result, left[i])
            i = i + 1
        } else {
            push(result, right[j])
            j = j + 1
        }
    }
    while (i < len(left)) {
        push(result, left[i])
        i = i + 1
    }
    while (j < len(right)) {
        push(result, right[j])
        j = j + 1
    }
    return result
}

func merge_sort(data) {
    let n = len(data)
    if (n <= 1) {
        return data
    }
    let mid = n / 2
    let left = data[0:mid]
    let right = data[mid:n]
    let sl = merge_sort(left)
    let sr = merge_sort(right)
    return merge(sl, sr)
}

func print_array(a) {
    let i = 0
    while (i < len(a)) {
        print(a[i])
        i = i + 1
    }
}

func main() {
    let data = [38, 27, 43, 3, 9, 82, 10]
    let sorted = merge_sort(data)
    print("MergeSort result:")
    print_array(sorted)
}
func partition(data, low, high) {
    let pivot = data[high]
    let i = low - 1
    let j = low
    while (j < high) {
        if (data[j] < pivot) {
            i = i + 1
            let t = data[i]
            data[i] = data[j]
            data[j] = t
        }
        j = j + 1
    }
    let t = data[i + 1]
    data[i + 1] = data[high]
    data[high] = t
    return i + 1
}

func quick_sort(data, low, high) {
    if (low < high) {
        let pi = partition(data, low, high)
        quick_sort(data, low, pi - 1)
        quick_sort(data, pi + 1, high)
    }
}

func print_array(a) {
    let i = 0
    while (i < len(a)) {
        print(a[i])
        i = i + 1
    }
}

func main() {
    let data = [10, 7, 8, 9, 1, 5]
    quick_sort(data, 0, len(data) - 1)
    print("QuickSort result:")
    print_array(data)
}
func max_subarray(data) {
    let current_sum = data[0]
    let maximum_sum = data[0]
    let i = 1
    while (i < len(data)) {
        let candidate = current_sum + data[i]
        if (data[i] > candidate) {
            current_sum = data[i]
        } else {
            current_sum = candidate
        }
        if (current_sum > maximum_sum) {
            maximum_sum = current_sum
        }
        i = i + 1
    }
    return maximum_sum
}

func main() {
    let data = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
    print("Kadane's max subarray sum:")
    print(max_subarray(data))
}
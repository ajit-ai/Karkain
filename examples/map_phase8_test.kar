func main() {
    let m = {"name": "Karkain", "version": "8", "status": "active"}

    print("=== Phase 8: Map Builtins Test ===")

    print("Initial map:")
    print(m)

    print("len(m):")
    print(len(m))

    print("hasKey name:")
    print(hasKey(m, "name"))

    print("hasKey missing:")
    print(hasKey(m, "ghost"))

    delete(m, "status")

    print("After delete status, len:")
    print(len(m))

    print("hasKey status after delete:")
    print(hasKey(m, "status"))

    print("Map after delete:")
    print(m)
}

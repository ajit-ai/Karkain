// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 13 Finance
//
// Portfolio-weighted average return over synthetic assets: weight each
// asset's return by its allocation share, all in integer weights and
// integer return percent so output is exact.
//
// Run:  karkain run examples/13_finance/04_portfolio.kark

func weighted_return(weights, returns) {
    let total_weight = array_sum_int(weights)
    let acc = 0
    let i = 0
    while (i < len(weights)) {
        acc = acc + weights[i] * returns[i]
        i = i + 1
    }
    return acc / total_weight
}

func array_sum_int(xs) {
    let total = 0
    let i = 0
    while (i < len(xs)) {
        total = total + xs[i]
        i = i + 1
    }
    return total
}

func main() {
    // 40% at 8%, 30% at 5%, 30% at 2%
    print(weighted_return([40, 30, 30], [8, 5, 2]))
    // 50/50 at 10% and -4%
    print(weighted_return([50, 50], [10, -4]))
    // all-in on a single asset
    print(weighted_return([100], [7]))
}
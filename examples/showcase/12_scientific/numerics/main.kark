// Karkain Scientific Computing - numerical methods implemented on the plain
// runtime surface: Newton square root, trapezoidal integration, basic
// statistics, and a deterministic (LCG) Monte Carlo estimate of pi.
//
// Everything is deterministic and reproducible on every machine, because the
// pseudo-random stream is a textbook linear congruential generator rather
// than a non-deterministic runtime source.

func fsqrt(x) {
    if (x <= 0.0) {
        return 0.0
    }
    let guess = x / 2.0
    let i = 0
    while (i < 40) {
        guess = (guess + x / guess) / 2.0
        i = i + 1
    }
    return guess
}

// Trapezoidal approximation of the integral of x^2 from a to b.
func integrateSquare(a, b, n) {
    let h = (b - a) / (n * 1.0)
    let sum = 0.0
    let i = 0
    while (i < n) {
        let x0 = a + ((i * 1.0) * h)
        let x1 = a + (((i + 1) * 1.0) * h)
        sum = sum + ((((x0 * x0) + (x1 * x1)) / 2.0) * h)
        i = i + 1
    }
    return sum
}

func mean(arr) {
    let n = len(arr)
    let sum = 0.0
    let i = 0
    while (i < n) {
        sum = sum + (arr[i] * 1.0)
        i = i + 1
    }
    return sum / (n * 1.0)
}

func variance(arr) {
    let n = len(arr)
    let m = mean(arr)
    let acc = 0.0
    let i = 0
    while (i < n) {
        let d = (arr[i] * 1.0) - m
        acc = acc + (d * d)
        i = i + 1
    }
    return acc / (n * 1.0)
}

func stddev(arr) {
    return fsqrt(variance(arr))
}

// Classic LCG used by many standard libraries: reproducible everywhere.
func lcgNext(state) {
    return (state * 1103515245 + 12345) % 2147483648
}

func monteCarloPi(seed, total) {
    let inside = 0
    let s = seed
    let i = 0
    while (i < total) {
        s = lcgNext(s)
        let u = (s % 10000) / 10000.0
        s = lcgNext(s)
        let v = (s % 10000) / 10000.0
        if (((u * u) + (v * v)) <= 1.0) {
            inside = inside + 1
        }
        i = i + 1
    }
    return (4.0 * inside) / (total * 1.0)
}

func main() {
    print("sqrt_2=" + str(fsqrt(2.0)))        // ~1.41421
    print("sqrt_25=" + str(fsqrt(25.0)))      // 5
    print("integral_x2_0_1=" + str(integrateSquare(0.0, 1.0, 1000))) // ~0.333333

    let data = [1, 2, 3, 4, 5]
    print("mean=" + str(mean(data)))          // 3
    print("variance=" + str(variance(data)))  // 2
    print("stddev=" + str(stddev(data)))      // ~1.41421

    print("pi_estimate=" + str(monteCarloPi(1, 10000)))
}
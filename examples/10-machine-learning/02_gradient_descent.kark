// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 10 Machine Learning
//
// Gradient descent on a convex surface f(x) = (x-3)^2 + 7. Each step moves x
// against the local derivative; the iterates converge to the minimum x=3.
// Demonstrates the optimizer loop without a tensor library.
//
// Run:  karkain run examples/10-machine-learning/02_gradient_descent.kark

func loss(x) {
    let d = x - 3
    return d * d + 7
}

func derivative(x) {
    return 2 * (x - 3)
}

func main() {
    let x = -2.0
    let lr = 0.2
    let step = 0
    while (step < 80) {
        x = x - lr * derivative(x)
        step = step + 1
    }

    print(x)
    print(loss(x))
}
// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 15 Developer Tools
//
// A karkain test file. Discovered by `karkain test` through the *_test.kark
// name pattern; every `func test_*` runs and must pass.
//
//   karkain test examples/15-developer-tools/02_assertions_test.kark
//
// Language-level assertions: assert(cond), assert_eq(a, b), assert_ne(a, b).

func double(x) {
    return x * 2
}

func test_double_basic() {
    assert_eq(double(2), 4)
    assert_eq(double(0), 0)
}

func test_double_negative() {
    assert_eq(double(-3), -6)
}

func test_ordering() {
    assert(3 < 7)
    assert_ne(1 + 1, 3)
}
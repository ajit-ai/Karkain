// Status: Runnable
// Engine: both (Go front end + self-hosted kcc)
// Category: 14 Security
//
// The sha256 and sha512 digests exposed by std.crypto. They are returned as
// lowercase hexadecimal strings, verified against the NIST FIPS 180 vectors
// on both engines.
//
// Run:  karkain run examples/14-security/01_digests.kark

import std.crypto

func main() {
    print(sha256("abc"))
    print(sha256(""))
    print(sha512("abc"))
}
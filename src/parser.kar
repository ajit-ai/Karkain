func parseTokens(tokens) {
    let fnBody = []
    
    let arrayElems = []
    arrayElems = appendArray(arrayElems, ["IntLiteral", "100"])
    arrayElems = appendArray(arrayElems, ["IntLiteral", "200"])
    
    let varDecl = ["VarDecl", "list", ["ArrayLiteral", arrayElems]]
    let printStmt = ["PrintStmt", ["Identifier", "list"]]

    fnBody = appendArray(fnBody, varDecl)
    fnBody = appendArray(fnBody, printStmt)

    let mainFn = ["FuncDecl", "main", [], fnBody]
    let ast = ["Program", [mainFn]]

    return ast
}

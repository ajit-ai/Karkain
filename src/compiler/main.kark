// Phase 40: Self-hosted Karkain Compiler Driver
// Main entry point: reads source, tokenizes, parses, generates code
// Imports: ast.kark, lexer.kark, parser.kark, sema.kark, codegen.kark

func main() {
    let args = getArgs()
    let argc = len(args)

    if (argc < 2) {
        printUsage()
        return
    }

    let command = args[1]

    if (command == "--help" || command == "-h") {
        printUsage()
        return
    }

    if (command == "--version" || command == "-v") {
        print("Karkain Compiler v1.0.0 (Stable Build)")
        return
    }

    if (command == "check") {
        if (argc < 3) {
            print("Usage: karkain check <file.kark>")
            return
        }
        checkFile(args[2])
        return
    }

    if (command == "build") {
        if (argc < 3) {
            print("Usage: karkain build <file.kark> [--target c23|wgsl|opencl|openqasm|qir|kbc]")
            return
        }
        let target = "c23"
        if (argc >= 5 && args[3] == "--target") {
            target = args[4]
        }
        buildFile(args[2], target)
        return
    }

    if (command == "run") {
        if (argc < 3) {
            print("Usage: karkain run <file.kark>")
            return
        }
        runFile(args[2])
        return
    }

    if (command == "test") {
        if (argc < 3) {
            print("Usage: karkain test <path> [filter]")
            return
        }
        let filter = ""
        if (argc >= 4) { filter = args[3] }
        runTests(args[2], filter)
        return
    }

    if (command == "kir") {
        if (argc < 3) {
            print("Usage: karkain kir <file.kark>")
            return
        }
        kirFile(args[2])
        return
    }

    if (command == "verifykir") {
        if (argc < 3) {
            print("Usage: karkain verifykir <file.kark>")
            return
        }
        verifyFile(args[2])
        return
    }

    if (command == "lsp") {
        startLSP()
        return
    }

    print("Unknown command: " + command)
    printUsage()
}

func printUsage() {
    print("Karkain Compiler v1.0.0 (Stable Build)")
    print("")
    print("Usage: karkain <command> [options] <file>")
    print("")
    print("Commands:")
    print("  check    Parse, type-check and KIR-verify a .kark file")
    print("  kir      Emit KIR v1 text from a .kark file")
    print("  verifykir  Emit and structurally verify KIR v1 text from a .kark file")
    print("  build    Compile a .kark file to target code")
    print("  run      Compile and execute a .kark file")
    print("  test     Discover and run *_test.kark files")
    print("  lsp      Start LSP language server (stdio)")
    print("")
    print("Options:")
    print("  --target <target>   Output: c23, wgsl, opencl, openqasm, qir, kbc (default: c23)")
    print("  --help, -h          Show this help message")
    print("  --version, -v       Show version information")
}

func checkFile(path) {
    let source = assembleProject(path)
    if (source == "") { return }

    // Tokenize
    let tokens = tokenize(source)

    // Parse (pass source for zero-copy token literal access)
    let state = createParserState(tokens, source)
    let ast = parseWithState(state)

    // Check for errors
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    // Phase 99: run the two-pass type checker. Its error[K1XX] diagnostics are
    // the semantic gate for `karkain check` — when any are present the file is
    // NOT reported as `[ok]`, so the CLI maps the result to ExitCompile.
    let typeErrs = typeCheckProgram(ast)
    if (len(typeErrs) > 0) {
        let ei = 0
        while (ei < len(typeErrs)) {
            print(typeErrs[ei])
            ei = ei + 1
        }
        return
    }

    // Phase 121: the KIR structural invariant runs on the default check path.
    // The self-hosted emitter must round-trip its own v1 contract on every
    // accepted file; failures print error[K121] and skip the [ok] verdict so
    // the CLI maps it to ExitCompile. Success is silent.
    let kirLines = kirEmit(ast, path)
    let kirProbs = kirVerify(kirLines, path)
    if (len(kirProbs) > 0) {
        print("error[K121]: KIR structural verification failed for " + path)
        let pi = 0
        while (pi < len(kirProbs)) {
            print(kirProbs[pi])
            pi = pi + 1
        }
        return
    }

    print("[ok] " + path + " parsed successfully")
}

// Phase 120: KIR v1 text extraction. Mirrors checkFile's parse entry,
// but renders the parsed AST as deterministic KIR text instead of
// reporting a pass/fail verdict. Parse errors surface identically;
// success prints the KIR v1 text lines followed by a path-less
// confirmation line (so repeated runs are byte-identical).
func kirFile(path) {
    let source = assembleProject(path)
    if (source == "") { return }

    let tokens = tokenize(source)
    let state = createParserState(tokens, source)
    let ast = parseWithState(state)

    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    let lines = kirEmit(ast, path)
    let li = 0
    while (li < len(lines)) {
        print(lines[li])
        li = li + 1
    }
    print("[ok] kir text: " + str(len(lines)) + " lines")
}

// Phase 121: standalone KIR structural verification. Parses the file, emits
// KIR v1 text and checks it against the structural contract. Success prints
// the deterministic count markers; failures print error[K121] problem lines
// and no [ok] (so the CLI maps them to ExitCompile).
func verifyFile(path) {
    let source = assembleProject(path)
    if (source == "") { return }

    let tokens = tokenize(source)
    let state = createParserState(tokens, source)
    let ast = parseWithState(state)

    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    let lines = kirEmit(ast, path)
    let problems = kirVerify(lines, path)
    if (len(problems) > 0) {
        print("error[K121]: KIR structural verification failed for " + path)
        let pi = 0
        while (pi < len(problems)) {
            print(problems[pi])
            pi = pi + 1
        }
        return
    }
    print("[ok] kir text: " + str(len(lines)) + " lines")
    print("[ok] kir verify: " + str(len(lines)) + " lines ok")
}

func buildFile(path, target) {
    let source = assembleProject(path)
    if (source == "") { return }

    // Tokenize
    let tokens = tokenize(source)

    // Parse (pass source for zero-copy token literal access)
    let state = createParserState(tokens, source)
    let ast = parseWithState(state)

    // Check for errors
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    // Generate code
    let output = generate(ast, target, fileBaseName(path))

    // Output result
    let outPath = replaceExtension(path, "." + target)
    let f = createFile(outPath)
    writeToFile(f, output)
    closeFile(f)

    print("[ok] " + path + "  ->  " + outPath + " (" + target + ")")
}

func runFile(path) {
    let source = assembleProject(path)
    if (source == "") { return }

    // Tokenize
    let tokens = tokenize(source)

    // Parse (pass source for zero-copy token literal access)
    let state = createParserState(tokens, source)
    let ast = parseWithState(state)

    // Check for errors
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    // Generate C23 code
    let cCode = generate(ast, "c23", fileBaseName(path))

    // Write to temp file
    let tempPath = "karkain_temp.c"
    let f = createFile(tempPath)
    writeToFile(f, cCode)
    closeFile(f)

    // Compile with gcc (C2X like the Go reference backend: the embedded
    // concurrency runtime needs C11 atomics).
    let compileCmd = "gcc -std=c2x -o karkain_temp " + tempPath + " -D_POSIX_C_SOURCE=200809L -Wno-psabi -lm"
    print("Compiling: " + compileCmd)
    let cc = system(compileCmd)
    if (cc != 0) {
        removeFile(tempPath)
        return
    }

    // Run
    print("--- Output ---")
    let exe = "karkain_temp"
    if (openFile("karkain_temp.exe") != "") { exe = "karkain_temp.exe" }
    // Windows cmd does not accept a "./" prefix; bare names run from the
    // current working directory, whereas POSIX shells need "./" to execute
    // a file that is not on PATH.
    if (endsWith(exe, ".exe")) {
        system(exe)
    } else {
        system("./" + exe)
    }

    // Cleanup
    removeFile(tempPath)
    removeFile("karkain_temp")
    if (openFile("karkain_temp.exe") != "") { removeFile("karkain_temp.exe") }
}

// fileBaseName strips any leading directory components from a path (both "/"
// and "\" separators) returning just the file name, e.g. "prog.kark". Runtime
// error diagnostics embed this base name so every engine reports the same file.
func fileBaseName(path) {
    let i = len(path) - 1
    let slash = -1
    while (i >= 0) {
        let ch = substr(path, i, 1)
        if (ch == "/" || ch == "\\") {
            slash = i
            break
        }
        i = i - 1
    }
    if (slash == -1) { return path }
    return substr(path, slash + 1, len(path) - slash - 1)
}

func replaceExtension(path, newExt) {
    let lastDot = -1
    let i = len(path) - 1
    while (i >= 0) {
        let ch = substr(path, i, 1)
        if (ch == ".") {
            lastDot = i
            break
        }
        i = i - 1
    }
    if (lastDot == -1) {
        return path + newExt
    }
    return substr(path, 0, lastDot) + newExt
}

// Return the directory portion of a path (up to the last '/' or '\').
func dirName(path) {
    let i = len(path) - 1
    while (i >= 0) {
        let ch = substr(path, i, 1)
        if (ch == "/" || ch == "\\") {
            return substr(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

// Return the basename of a path (after the last '/' or '\').
func baseName(path) {
    let i = len(path) - 1
    while (i >= 0) {
        let ch = substr(path, i, 1)
        if (ch == "/" || ch == "\\") {
            return substr(path, i + 1, len(path) - i - 1)
        }
        i = i - 1
    }
    return path
}

func endsWith(s, suffix) {
    let sl = len(s)
    let ol = len(suffix)
    if (ol > sl) { return false }
    return substr(s, sl - ol, ol) == suffix
}

// ============================================================
// Phase 122: Karkain-owned project source assembly
//
// assembleProject builds the self-contained Karkain source a root file
// compiles: module imports (import math, import std.string) resolve to sibling
// files/directories and to the standard-library tree, the root's same-directory
// sibling modules join upstream with the root last, and module import
// declaration lines are stripped while C import blocks are preserved (keeping
// blank lines so assembled source line numbers match the originals). Every
// driver entry (check/build/run/kir/verifykir) compiles through this function,
// so kcc composes its own input on the real CLI path for flat projects; the Go
// CLI only mirrors the project into a sandbox first. Manifests, workspaces and
// package-manager dependencies keep the Go module-aware assembly.
// ============================================================

// sourceLines splits text into tokens that each carry their trailing newline
// (the final token has none), so concatenating the tokens reproduces the input
// byte-for-byte. Unlike the split builtin (which collapses empty runs), this
// preserves blank lines and therefore exact line numbering.
func sourceLines(text) {
    let out = []
    let pos = 0
    let n = len(text)
    while (pos < n) {
        let rest = substr(text, pos, n - pos)
        let nl = indexOf(rest, "\n")
        if (nl < 0) {
            out = appendArray(out, rest)
            pos = n
        } else {
            out = appendArray(out, substr(rest, 0, nl + 1))
            pos = pos + nl + 1
        }
    }
    return out
}

// stripLineEnd removes a trailing newline and carriage return from a line
// token so name detection is robust on LF and CRLF sources.
func stripLineEnd(line) {
    return trimSuffix(trimSuffix(line, "\n"), "\r")
}

// importNameOf extracts the module name from an import declaration line, or ""
// when the line is not exactly `import <name>` (surrounding whitespace and a
// trailing CR are allowed). C import blocks ("import \"C\"") return "".
func importNameOf(line) {
    let t = trim(stripLineEnd(line))
    if (len(t) < 7) { return "" }
    if (substr(t, 0, 7) != "import ") { return "" }
    let rest = trim(substr(t, 7, len(t) - 7))
    if (len(rest) == 0) { return "" }
    let c0 = substr(rest, 0, 1)
    if (c0 == "\"" || c0 == ".") { return "" }
    let name = ""
    let i = 0
    let stop = 0
    let alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_."
    while (i < len(rest) && stop == 0) {
        let c = substr(rest, i, 1)
        if (indexOf(alpha, c) >= 0) {
            name = name + c
            i = i + 1
        } else {
            stop = 1
        }
    }
    if (len(trim(substr(rest, i, len(rest) - i))) > 0) { return "" }
    return name
}

// isImportLine reports whether a line declares a module import (import math,
// import std.string) as opposed to a C import block.
func isImportLine(line) {
    if (importNameOf(line) == "") { return 0 }
    return 1
}

// arrHas reports whether array arr contains value x.
func arrHas(arr, x) {
    let i = 0
    while (i < len(arr)) {
        if (arr[i] == x) { return 1 }
        i = i + 1
    }
    return 0
}

// moduleImportNames returns the distinct module import names declared in a
// source text, in declaration order.
func moduleImportNames(source) {
    let lines = sourceLines(source)
    let names = []
    let i = 0
    while (i < len(lines)) {
        let name = importNameOf(lines[i])
        if (name != "") {
            if (arrHas(names, name) == 0) {
                names = appendArray(names, name)
            }
        }
        i = i + 1
    }
    return names
}

// stripModuleImports removes every module import declaration line, keeping the
// newline so the assembled text preserves the original line numbering exactly
// (mirrors the Go assembler's dotted-import line strip).
func stripModuleImports(text) {
    let lines = sourceLines(text)
    let out = ""
    let i = 0
    while (i < len(lines)) {
        let line = lines[i]
        if (isImportLine(line) == 1) {
            if (hasSuffix(line, "\n") == 1) { out = out + "\n" }
        } else {
            out = out + line
        }
        i = i + 1
    }
    return out
}

// collectKarkFiles returns the sorted .kark file names directly inside dir
// (empty for a missing/non-directory path), excluding exclude.
func collectKarkFiles(dir, exclude) {
    let entries = listFiles(dir)
    let out = []
    let i = 0
    while (i < len(entries)) {
        let name = entries[i]
        if (endsWith(name, ".kark") == true && name != exclude) {
            out = appendArray(out, name)
        }
        i = i + 1
    }
    return sortStrings(out)
}

// moduleDirSource concatenates every .kark file of a module directory in sorted
// order, falling back to a single-file module (<dirPath>.kark). Returns "" when
// the module is absent.
func moduleDirSource(dirPath) {
    let names = collectKarkFiles(dirPath, "")
    let content = ""
    let i = 0
    while (i < len(names)) {
        content = content + readFile(dirPath + "/" + names[i]) + "\n\n"
        i = i + 1
    }
    if (content == "") {
        let single = readFile(dirPath + ".kark")
        if (single != "") { content = single + "\n\n" }
    }
    return content
}

// findStdlibRoot locates the effective standard-library root for a project
// root directory: first the sandbox staging area (<rootDir>/lib), then the
// nearest ancestor holding a stdlib/ tree. A candidate must carry the
// canonical std.string module (so unrelated directories named `stdlib`, such
// as examples/stdlib, are never mistaken for the library).
func findStdlibRoot(rootDir) {
    let libRoot = rootDir + "/lib"
    if (moduleDirSource(libRoot + "/string") != "") { return libRoot }
    let probe = rootDir
    let up = 0
    while (up < 14) {
        let cand = probe + "/stdlib"
        if (moduleDirSource(cand + "/string") != "") { return cand }
        let parent = dirName(probe)
        if (parent == probe) { return "" }
        probe = parent
        up = up + 1
    }
    return ""
}

// resolveStdlibModule returns a std.X module's source from the effective
// standard-library root, or "" when no stdlib is found.
func resolveStdlibModule(sub, rootDir) {
    let root = findStdlibRoot(rootDir)
    if (root == "") { return "" }
    return moduleDirSource(root + "/" + sub)
}

// resolveUserModule returns a bare user module's source: a sibling file
// <name>.kark or a sibling directory <name>/ of .kark files, relative to dir.
func resolveUserModule(name, dir) {
    return moduleDirSource(dir + "/" + name)
}

// siblingContent joins the root's same-directory sibling .kark modules
// (excluding the target and any file declaring its own main), sorted.
func siblingContent(dir, target) {
    let names = collectKarkFiles(dir, target)
    let content = ""
    let i = 0
    while (i < len(names)) {
        let src = readFile(dir + "/" + names[i])
        if (contains(src, "func main(") == 0) {
            content = content + src + "\n\n"
        }
        i = i + 1
    }
    return content
}

// assembleProject returns the self-contained assembled source for a project
// root file, or "" (after printing error[K122] for an unresolvable module)
// when assembly cannot complete. check/build/run/kir/verifykir all compile
// through this function.
func assembleProject(path) {
    let rootSrc = readFile(path)
    if (rootSrc == "") { return "" }
    let dir = dirName(path)
    let base = baseName(path)
    let names = moduleImportNames(rootSrc)
    let content = ""
    if (len(names) == 0) {
        content = siblingContent(dir, base)
    } else {
        let i = 0
        while (i < len(names)) {
            let name = names[i]
            let m = ""
            if (hasPrefix(name, "std.") == 1) {
                m = resolveStdlibModule(trimPrefix(name, "std."), dir)
            } else {
                m = resolveUserModule(name, dir)
            }
            if (m == "") {
                print("error[K122]: module '" + name + "' not found (assembling " + path + ")")
                return ""
            }
            content = content + m
            i = i + 1
        }
    }
    content = content + rootSrc
    return stripModuleImports(content)
}

// ============================================================
// Test runner - discovers and runs *_test.kark files
//
// Phase 96: the self-hosted engine owns the test runner. Discovery
// mirrors the Go CLI contract (findTestFiles): a directory yields every
// *_test.kark file (sorted), a single path is used as-is. For each test
// file the runner parses it, collects the test_* functions, synthesizes a
// driver program (the file's source + a main that calls the selected test
// functions) and compiles and executes it through gcc. Exit code 0 means
// every assertion held; asserts exit(1), so a nonzero code flags failure.
// The output mirrors the Go runner's summary contract so the Go wrapper
// can parse `N passed; M failed; S skipped; T total`.
// ============================================================

func runTests(testPath, filter) {
    let files = collectTestFiles(testPath)
    if (len(files) == 0) {
        print("No test files found.")
        return
    }
    let total = 0
    let passed = 0
    let failed = 0
    let fi = 0
    while (fi < len(files)) {
        let file = files[fi]
        print("=== Running tests in " + file + " ===")
        let source = readFile(file)
        if (source == "") {
            print("  error reading " + file)
            fi = fi + 1
            continue
        }
        let tokens = tokenize(source)
        let state = createParserState(tokens, source)
        let ast = parseWithState(state)
        if (hasParserErrors(state)) {
            printParserErrors(state)
            fi = fi + 1
            continue
        }
        let tests = applyFilter(collectTestNames(ast), filter)
        let tn = len(tests)
        if (tn == 0) {
            fi = fi + 1
            continue
        }
        // Fast path: one driver calling every selected test. A clean exit
        // means all passed; a nonzero exit isolates the failing tests.
        let allDriver = source + "\nfunc main() {\n" + buildCallList(tests) + "}\n"
        let allCode = compileRunDriver(allDriver)
        if (allCode == 0) {
            let ti = 0
            while (ti < tn) {
                print("  PASS " + tests[ti])
                passed = passed + 1
                total = total + 1
                ti = ti + 1
            }
        } else {
            let ti = 0
            while (ti < tn) {
                let tname = tests[ti]
                let driver = source + "\nfunc main() {\n    " + tname + "()\n}\n"
                let code = compileRunDriver(driver)
                if (code == 0) {
                    print("  PASS " + tname)
                    passed = passed + 1
                } else {
                    print("  FAIL " + tname)
                    failed = failed + 1
                }
                total = total + 1
                ti = ti + 1
            }
        }
        fi = fi + 1
    }
    // Go-parity summary output (see printTestSummary + summaryLine).
    print("")
    print("=== Test Summary: " + str(total) + " tests, " + str(passed) + " passed, " + str(failed) + " failed, 0 skipped ===")
    print(str(passed) + " passed; " + str(failed) + " failed; 0 skipped; " + str(total) + " total")
}

// Discover *_test.kark files under a directory or accept a single file path
// directly (mirrors findTestFiles / TestCommandFiltered semantics).
func collectTestFiles(testPath) {
    let files = []
    let entries = listFiles(testPath)
    if (len(entries) > 0) {
        let n = len(entries)
        let i = 0
        while (i < n) {
            let name = entries[i]
            if (endsWith(name, "_test.kark")) {
                files = appendArray(files, testPath + "/" + name)
            }
            i = i + 1
        }
    } else {
        // No named entries: either a single test file or a directory whose
        // top-level listing is empty. Adopt the path as a single file when it
        // looks like a test file or reads back as source (a directory yields
        // "" on Windows fopen, and listFiles already returned nothing).
        let isTestFile = endsWith(testPath, "_test.kark")
        if (isTestFile) {
            files = appendArray(files, testPath)
        } else if (readFile(testPath) != "") {
            files = appendArray(files, testPath)
        }
    }
    return sortStrings(files)
}

// Collect every top-level test_* function name from a parsed program.
func collectTestNames(ast) {
    let names = []
    let stmts = programStatements(ast)
    let n = len(stmts)
    let i = 0
    while (i < n) {
        let stmt = stmts[i]
        if (getNodeType(stmt) == "FuncDecl") {
            let fname = funcName(stmt)
            let pl = len(fname)
            if (pl >= 5) {
                if (substr(fname, 0, 5) == "test_") {
                    names = appendArray(names, fname)
                }
            }
        }
        i = i + 1
    }
    return sortStrings(names)
}

// Substring filter over the test name, matching pkg/testing.Filter.
func applyFilter(names, filter) {
    if (len(filter) == 0) { return names }
    let out = []
    let i = 0
    while (i < len(names)) {
        if (contains(names[i], filter) == 1) {
            out = appendArray(out, names[i])
        }
        i = i + 1
    }
    return out
}

// Build the body of a synthesized main that invokes every listed test.
func buildCallList(names) {
    let s = ""
    let i = 0
    while (i < len(names)) {
        s = s + "    " + names[i] + "()\n"
        i = i + 1
    }
    return s
}

// Tokenize/parse/generate/compile/run one synthesized test driver. Returns the
// driver's exit code (0 = all assertions held); cleanup is always performed.
func compileRunDriver(driver) {
    let tokens = tokenize(driver)
    let state = createParserState(tokens, driver)
    let ast = parseWithState(state)
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return 1
    }
    let cCode = generate(ast, "c23", "karkain_test.c")
    let tempPath = "karkain_test.c"
    let f = createFile(tempPath)
    writeToFile(f, cCode)
    closeFile(f)
    let compileCmd = "gcc -std=c2x -x c -D_POSIX_C_SOURCE=200809L -Wno-psabi -o karkain_test " + tempPath + " -lgmp -lm"
    let cc = system(compileCmd)
    if (cc != 0) {
        // Phase 125A: the networking preamble emits Winsock references
        // behind #ifdef _WIN32. On Windows hosts the plain link fails, so
        // retry with the Winsock library before declaring failure. POSIX
        // hosts never take this branch (no WSA symbols to resolve).
        let cc2 = system(compileCmd + " -lws2_32")
        if (cc2 != 0) {
            removeFile(tempPath)
            return 1
        }
    }
    // gcc adds .exe on Windows; resolve the actual artifact name.
    let exe = "karkain_test"
    if (openFile("karkain_test.exe") != "") { exe = "karkain_test.exe" }
    // Windows cmd does not accept a "./" prefix; bare names run from the
    // current working directory, whereas POSIX shells need "./" to execute
    // a file that is not on PATH.
    let code = 0
    if (endsWith(exe, ".exe")) {
        code = system(exe)
    } else {
        code = system("./" + exe)
    }
    removeFile(tempPath)
    removeFile("karkain_test")
    removeFile("karkain_test.exe")
    return code
}

// Deterministic lexicographic insertion sort over an array of strings. The
// self-hosted runtime lacks a built-in sort, but string < / > comparisons are
// supported through binary_op, and index assignment through index_set.
func sortStrings(arr) {
    let n = len(arr)
    let i = 1
    while (i < n) {
        let key = arr[i]
        let j = i - 1
        while (j >= 0) {
            let gt = arr[j] > key
            if (gt == 0) { break }
            arr[j + 1] = arr[j]
            j = j - 1
        }
        arr[j + 1] = key
        i = i + 1
    }
    return arr
}


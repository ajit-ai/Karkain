// Phase 40: Self-hosted Karkain Compiler Driver
// Main entry point: reads source, tokenizes, parses, generates code
// Imports: ast.kark, lexer.kark, parser.kark, sema.kark, codegen.kark

func main() {
    string[] args = getArgs()
    int argc = len(args)

    if (argc < 2) {
        printUsage()
        return
    }

    string command = args[1]

    if (command == "--help" || command == "-h") {
        printUsage()
        return
    }

    if (command == "--version" || command == "-v") {
        print("Karkain Compiler v1.2.0 (Stable Build)")
        return
    }

    if (command == "check") {
        if (argc < 3) {
            print("Usage: karkain check <file.kark>")
            return
        }
        checkFile(args[2])
        return
    }

    if (command == "build") {
        if (argc < 3) {
            print("Usage: karkain build <file.kark> [--target c23|wgsl|opencl|openqasm|qir|kbc|native-x86_64-linux|native-x86_64-windows|native-x86_64-macos]")
            return
        }
        string target = "c23"
        if (argc >= 5 && args[3] == "--target") {
            target = args[4]
        }
        // Phase 151A-1: a C-free native target is a REQUEST the self-hosted
        // engine sees and answers for itself. Before this, `kcc build
        // --target native-...` was never consulted at all -- the Go driver
        // silently handed the request to the Go backend, which is the
        // dishonesty PHASE-151-BASELINE.md 1.1 measured. Now kcc parses the
        // program, decides, and states its provenance. It does NOT yet have a
        // machine-code backend, so the answer is a refusal naming the reason
        // (see PHASE-151A-BASELINE.md 4: real emission is 151A/B/C).
        if (isNativeTarget(target)) {
            buildNativeFile(args[2], target, natHasFlag(args, "--regalloc"), natOutputArg(args))
            return
        }
        buildFile(args[2], target)
        return
    }

    if (command == "run") {
        if (argc < 3) {
            print("Usage: karkain run <file.kark> [--target c23|native-x86_64-*]")
            return
        }
        string target = "c23"
        if (argc >= 5 && args[3] == "--target") { target = args[4] }
        if (isNativeTarget(target)) {
            runNativeFile(args[2], target, natHasFlag(args, "--regalloc"))
            return
        }
        runFile(args[2])
        return
    }

    if (command == "test") {
        if (argc < 3) {
            print("Usage: karkain test <path> [filter]")
            return
        }
        string filter = ""
        if (argc >= 4) { filter = args[3] }
        runTests(args[2], filter)
        return
    }

    if (command == "kir") {
        if (argc < 3) {
            print("Usage: karkain kir <file.kark>")
            return
        }
        kirFile(args[2])
        return
    }

    // v1.2.35 slice 2: a NON-EMITTING support probe. It runs the same
    // scan/plan as a native build but prints only a verdict, so the CLI can
    // decide a default target without producing an image or switching
    // engines silently.
    if (command == "native-check") {
        if (argc < 3) {
            print("Usage: karkain native-check <file.kark> [--target native-x86_64-*]")
            return
        }
        string ntarget = "native-x86_64-windows"
        if (argc >= 5 && args[3] == "--target") { ntarget = args[4] }
        nativeCheckFile(args[2], ntarget)
        return
    }

    // Phase 151B: exercise the self-hosted machine-code encoder and print
    // the bytes it produces as hex, one line per reference sequence. This
    // is the increment's measurement surface: the gate runs the same
    // sequences through the Go oracle (pkg/native Emitter) and compares,
    // so the encoder can be proven byte-identical before any value model
    // is layered on top of it.
    if (command == "native-encode") {
        Value names = ["imm64", "loop", "multi", "undef", "dup"]
        int i = 0
        while (i < 5) {
            print(names[i] + " " + natEncodeCorpus(i))
            i = i + 1
        }
        return
    }

	// Phase 151C: exercise the self-hosted ELF64 container writer and print
	// the image it produces as hex, one line per reference case. This is the
	// increment's measurement surface for the container, and it works exactly
	// like 151B's native-encode: the cases are compiled into kcc and the gate
	// compares them against pkg/native's Link.
	if (command == "native-elf") {
        Value enames = ["text", "arena", "rodata", "refuse"]
        int e = 0
        while (e < 4) {
            print(natELFCorpus(e))
            e = e + 1
        }
        return
    }

	// Phase 151C2: the self-hosted Mach-O PIE container writer. Same
	// measurement contract as native-encode and native-elf: the cases are
	// compiled into kcc and the gate compares the images against
	// pkg/native's LinkMachO.
	if (command == "native-macho") {
        Value mnames = ["single", "arena", "nosite", "adjacent", "refuse"]
        int m = 0
        while (m < 5) {
            print(natMachoCorpus(m))
            m = m + 1
        }
        return
    }

	// Phase 151C3: the self-hosted PE32+ container writer. Same measurement
	// contract as native-encode / native-elf / native-macho: the cases are
	// compiled into kcc and the gate compares the images against
	// pkg/native's LinkPE.
	if (command == "native-pe") {
        Value pnames = ["bare", "text", "arena", "refuse"]
        int p = 0
        while (p < 4) {
            print(natPECorpus(p))
            p = p + 1
        }
        return
    }

	// Phase 151A Step 9b: the FIRST whole-program PE composition -- _start,
	// karkain_main and print_int emitted into ONE state, with rodata resolved
	// against the real PE layout and IAT patches paired by recorded index.
	// Same measurement contract as native-pe: no input file, no Go fallback, and
	// a Go-side link producing the same bytes would prove nothing about kcc.
	if (command == "native-pe-prog") {
        int bp = 0
        while (bp < 4) {
            print(natPECorpusProg(bp))
            bp = bp + 1
        }
        return
    }

    // Phase 151A Step 9c: the whole-program driver, driven by a REAL FILE.
//
// This is the first native measurement command that takes an input file, and that
// is the point. Every other one is a corpus compiled into kcc, so it can prove
// that a SEQUENCE is byte-correct but never that a USER'S PROGRAM reaches the
// emitter. Here the source comes from disk, goes through the ordinary frontend
// (assemble -> tokenize -> parse -> type-check) and the driver lowers the AST.
//
// NO GO FALLBACK, same contract as the corpus commands, and the same no-fallback
// guard applies: a Go-side native compiler would satisfy every byte comparison
// below while proving nothing about kcc.
if (command == "native-ast") {
        if (argc < 3) {
            print("Usage: karkain native-ast <file.kark>")
            return
        }
        int src = assembleProject(args[2])
        if (src == "") {
            print("error[K002]: could not assemble " + args[2])
            return
        }
        Value ntok = tokenize(src)
        int pstate = createParserState(ntok, src)
        int ast9c = parseWithState(pstate)
        if (hasParserErrors(pstate)) {
            printParserErrors(pstate)
            return
        }
        int terrs = typeCheckProgram(ast9c)
        if (len(terrs) > 0) {
            int te = 0
            while (te < len(terrs)) {
                print(terrs[te])
                te = te + 1
            }
            return
        }
        int res9c = natNativeProgram(ast9c, natHasFlag(args, "--regalloc"))
        if (res9c[0] != "") {
            print(res9c[0])
            return
        }
        print(natToHex(res9c[1]))
        return
    }

    // Phase 151A: the `_start` entry stub and the Linux exit tail. Same
    // measurement contract as the four encoder/container commands above -- the
    // cases are compiled into kcc and the gate compares them against the real
    // pkg/native Emitter, which is the oracle. NO INPUT FILE, and no Go
    // fallback: a Go-side encoder producing the same bytes would pass the
    // comparison while proving nothing about kcc, which is the exact dishonesty
    // 151 was opened to remove.
    if (command == "native-value-start") {
        Value snames = ["start", "syscall", "tail"]
        int sn = 0
        while (sn < 3) {
            print(natStartCorpus(sn))
            sn = sn + 1
        }
        return
    }

    // Phase 151A Step 5: the Windows entry, the PEB bootstrap and the Win64 exit
    // tail. Same measurement contract as native-value-start -- the four shapes are
    // compiled into kcc and the gate compares them against the real pkg/native
    // Emitter, which is the oracle. NO INPUT FILE and no Go fallback: a Go-side
    // encoder producing the same bytes would pass the comparison while proving
    // nothing about kcc, which is the exact dishonesty 151 was opened to remove.
    if (command == "native-value-win") {
        int wn = 0
        while (wn < 7) {
            if (wn == 4) { print(natWinExe(0)) }
            if (wn == 5) { print(natWinExe(3)) }
            if (wn == 6) { print(natWinExeC()) }
            if (wn < 4) { print(natWinCorpus(wn)) }
            wn = wn + 1
        }
        return
    }

    // Phase 151A Step 7: int `print`. Same measurement contract as the arms
    // above -- the three shapes are compiled into kcc and the gate compares them
    // against the real pkg/native Emitter. NO INPUT FILE and no Go fallback.
    if (command == "native-value-print") {
        int pn = 0
        while (pn < 3) {
            print(natPrintCorpus(pn))
            pn = pn + 1
        }
        return
    }
    // Phase 151A Step 8a: the SSE2 scalar-double primitives. Structural only --
    // these are instruction encodings, not a program, so there is nothing here
    // to execute and no execution evidence is claimed.
    if (command == "native-value-float") {
        int fn8 = 0
        while (fn8 < 5) {
            print(natFloatCorpus(fn8))
            fn8 = fn8 + 1
        }
        return
    }
    // Phase 151A Step 8c: float STATEMENT lowering -- the first slice where an
    // expression lowering exists, so the Step 8a primitives and the Step 8b
    // helper become reachable from actual code. Thirteen arms covering the
    // literal store, the local reload, the four arithmetic ops, unary negation
    // and the six comparisons.
    //
    // The two IEEE-754 patterns are passed in rather than written here, so the
    // constants live in one place and this file gains no new magic numbers.
    if (command == "native-value-floatstmt") {
        int fc = 0
        while (fc < 13) {
            print(natFloatStmtCorpus(fc, 4609434218613702656, 4612248968380809216, 8))
            fc = fc + 1
        }
        return
    }
    // Phase 151A Step 8d: the call ABI, int first. Seven reference shapes --
    // calls with one, two and three register-budget arguments, a seven-argument
    // call that spills unit 6 into the extras area and materialises R10, and the
    // callee's homing for one, three and seven parameters.
    //
    // frame = 616 and extrasBase = 608 are the ORACLE's real layout numbers for
    // a one-local frame (locals 8 + binTemp 512 + argSpill 96), passed in so the
    // test states them and this file gains no magic numbers.
    if (command == "native-value-call") {
        int cc = 0
        while (cc < 7) {
            print(natCallCorpus(cc, 616, 608, 8))
            cc = cc + 1
        }
        return
    }
    // Phase 151A Step 8e: floats through the call ABI. Four shapes, and the
    // claim they exist to PROVE is that a float argument, parameter and return
    // emit the byte-for-byte identical path an int uses -- because
    // kindUnits(KindFloat) == 1, so a float parameter is one slot and a float
    // argument is the int staging with a different evaluator in front of it.
    //
    // Arm 1 stages the INT literal 42 through the float call shape on purpose:
    // the gate then compares it against Step 8d's one-argument int call, and the
    // two must be IDENTICAL. That is a stronger claim than "the float shape looks
    // right" -- it says the float path adds no ABI emission at all.
    if (command == "native-value-floatcall") {
        int fq = 0
        while (fq < 4) {
            print(natFloatCallCorpus(fq, 4609434218613702656, 42, 616, 608, 8))
            fq = fq + 1
        }
        return
    }
    // Phase 151A Step 8f: strings through the call ABI. Four shapes. A string
    // is the first TWO-UNIT kind, so this is where stageUnit's high-half rule is
    // exercised at all, and where an argument's units can begin at an ODD global
    // index (arm 1 passes an int first) and still line up -- because the
    // load-back indexes by (arg, k) rather than by global unit.
    if (command == "native-value-stringcall") {
        int st = 0
        while (st < 4) {
            print(natStringCallCorpus(st, 616, 8, 608))
            st = st + 1
        }
        return
    }
    // Phase 151A Step 9a: rodata resolution. Four reference strings with one
    // deliberate duplicate, so interning is observable, and two recorded sites
    // resolved with the PE base and rodata RVA.
    if (command == "native-value-rodata") {
        natRodataCorpus()
        return
    }

	// Phase 151A Step 1: the native value/frame foundation. Same
	// measurement contract as the four above -- the cases are compiled into
	// kcc and the gate compares against pkg/native, which is the oracle.
	// `native-value` prints the machine code of the two reference programs;
	// `native-value-layout` prints the frame arithmetic as text, so the gate
	// can pin the layout numbers themselves and not only the bytes they
	// produced.
	if (command == "native-value") {
        int v = 0
        while (v < 2) {
            print(natValueCorpus(v))
            v = v + 1
        }
        return
    }
    if (command == "native-value-layout") {
        int l = 0
        while (l < 5) {
            print(natValueLayoutCorpus(l))
            l = l + 1
        }
        return
    }
    if (command == "native-value-prims") {
        int p = 0
        while (p < 15) {
            print(natValuePrim(p))
            p = p + 1
        }
        return
    }
    if (command == "native-value-int") {
        print(natIntExprCorpus(0))
        print(natIntExprCorpus(1))
        print(natIntExprCorpus(2))
        print(natIntExprCorpus(3))
        print(natIntExprCorpus(4))
        print(natIntExprCorpus(5))
        print(natIntExprCorpus(6))
        return
    }
    if (command == "native-value-cmp") {
        int c = 0
        while (c < 6) {
            print(natIntIfCorpus(c))
            c = c + 1
        }
        return
    }
    if (command == "native-value-refuse") {
        int r = 0
        while (r < 6) {
            print(natIntRefusal(r))
            r = r + 1
        }
        return
    }
	// Phase 151A Step 3: control flow. `native-value-loop` renders the ten
	// loop reference programs; `native-value-loop-labels` reports the fresh()
	// label NAMES each one uses. Loops are the first surface whose byte
	// identity depends on LABEL NAMES rather than only on opcode bytes,
	// because a rel32 encodes just a displacement and a renumbered label can
	// produce a coincidentally equal stream -- so the names are reported as
	// their own surface and gated as data.
	if (command == "native-value-loop") {
        int q = 0
        while (q < 10) {
            print(natLoopCorpus(q))
            q = q + 1
        }
        return
    }
    if (command == "native-value-loop-labels") {
        int n = 0
        while (n < 10) {
            print(natLoopLabels(n))
            n = n + 1
        }
        return
    }


    if (command == "verifykir") {
        if (argc < 3) {
            print("Usage: karkain verifykir <file.kark>")
            return
        }
        verifyFile(args[2])
        return
    }

    if (command == "lsp") {
        startLSP()
        return
    }

    print("Unknown command: " + command)
    printUsage()
}

func printUsage() {
    print("Karkain Compiler v1.2.0 (Stable Build)")
    print("")
    print("Usage: karkain <command> [options] <file>")
    print("")
    print("Commands:")
    print("  check    Parse, type-check and KIR-verify a .kark file")
    print("  kir      Emit KIR v1 text from a .kark file")
    print("  verifykir  Emit and structurally verify KIR v1 text from a .kark file")
    print("  build    Compile a .kark file to target code")
    print("  run      Compile and execute a .kark file")
    print("  test     Discover and run *_test.kark files")
    print("  lsp      Start LSP language server (stdio)")
    print("")
    print("Options:")
    print("  --target <target>   Output: c23, wgsl, opencl, openqasm, qir, kbc (default: c23)")
    print("  --help, -h          Show this help message")
    print("  --version, -v       Show version information")
}

func checkFile(path) {
    string source = assembleProject(path)
    if (source == "") { return }

    // Tokenize
    Value tokens = tokenize(source)

    // Parse (pass source for zero-copy token literal access)
    int state = createParserState(tokens, source)
    int ast = parseWithState(state)

    // Check for errors
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    // Phase 99: run the two-pass type checker. Its error[K1XX] diagnostics are
    // the semantic gate for `karkain check` — when any are present the file is
    // NOT reported as `[ok]`, so the CLI maps the result to ExitCompile.
    int typeErrs = typeCheckProgram(ast)
    if (len(typeErrs) > 0) {
        int ei = 0
        while (ei < len(typeErrs)) {
            print(typeErrs[ei])
            ei = ei + 1
        }
        return
    }

    // Phase 121: the KIR structural invariant runs on the default check path.
    // The self-hosted emitter must round-trip its own v1 contract on every
    // accepted file; failures print error[K121] and skip the [ok] verdict so
    // the CLI maps it to ExitCompile. Success is silent.
    Value kirLines = kirEmit(ast, path)
    Value kirProbs = kirVerify(kirLines, path)
    if (len(kirProbs) > 0) {
        print("error[K121]: KIR structural verification failed for " + path)
        int pi = 0
        while (pi < len(kirProbs)) {
            print(kirProbs[pi])
            pi = pi + 1
        }
        return
    }

    print("[ok] " + path + " parsed successfully")
}

// Phase 120: KIR v1 text extraction. Mirrors checkFile's parse entry,
// but renders the parsed AST as deterministic KIR text instead of
// reporting a pass/fail verdict. Parse errors surface identically;
// success prints the KIR v1 text lines followed by a path-less
// confirmation line (so repeated runs are byte-identical).
func kirFile(path) {
    string source = assembleProject(path)
    if (source == "") { return }

    Value tokens = tokenize(source)
    int state = createParserState(tokens, source)
    int ast = parseWithState(state)

    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    Value lines = kirEmit(ast, path)
    int li = 0
    while (li < len(lines)) {
        print(lines[li])
        li = li + 1
    }
    print("[ok] kir text: " + str(len(lines)) + " lines")
}

// Phase 121: standalone KIR structural verification. Parses the file, emits
// KIR v1 text and checks it against the structural contract. Success prints
// the deterministic count markers; failures print error[K121] problem lines
// and no [ok] (so the CLI maps them to ExitCompile).
func verifyFile(path) {
    string source = assembleProject(path)
    if (source == "") { return }

    Value tokens = tokenize(source)
    int state = createParserState(tokens, source)
    int ast = parseWithState(state)

    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    Value lines = kirEmit(ast, path)
    Value problems = kirVerify(lines, path)
    if (len(problems) > 0) {
        print("error[K121]: KIR structural verification failed for " + path)
        int pi = 0
        while (pi < len(problems)) {
            print(problems[pi])
            pi = pi + 1
        }
        return
    }
    print("[ok] kir text: " + str(len(lines)) + " lines")
    print("[ok] kir verify: " + str(len(lines)) + " lines ok")
}

// isNativeTarget reports whether target names one of the C-free machine-code
// targets. Phase 151A-1: the self-hosted engine recognises these requests
// itself rather than letting the Go driver decide on its behalf.
func isNativeTarget(target) {
    if (target == "native-x86_64-linux") { return 1 }
    if (target == "native-x86_64-windows") { return 1 }
    if (target == "native-x86_64-macos") { return 1 }
    return 0
}

// nativeTargetOS maps a C-free target to the OS name the containers share.
// Single source of truth for the spelling used in the refusal.
func nativeTargetOS(target) {
    if (target == "native-x86_64-windows") { return "windows" }
    if (target == "native-x86_64-macos") { return "macos" }
    return "linux"
}

// natHasFlag reports whether the command line carries a flag.
//
// The flag is scanned across ALL the arguments rather than at a fixed
// position, so the caller does not have to know where the flag sits.
func natHasFlag(args, name) {
    int i = 0
    while (i < len(args)) {
        if (args[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

// buildNativeFile is kcc's own answer to a C-free native request.
//
// It performs the FULL self-hosted pipeline -- assemble, tokenize, parse, and
// the two-pass type check -- so that a refusal is reached only after kcc has
// actually read and understood the program, rather than being a string match
// in the driver. The provenance line it prints is the signal the 151 parity
// harness requires: it is emitted by the self-hosted engine, so it cannot be
// produced by the Go fallback.
//
// HONEST BOUNDARY: kcc has no machine-code codegen (no elf/pe/macho/x86 token
// exists in src/compiler). It therefore REFUSES, loudly, with the reason. It
// does not call the Go backend, because that is the silent fallback this
// increment exists to end. Real emission is increments 151A/B/C; see
// docs/audit/PHASE-151A-BASELINE.md.
// natOutputArg finds --output <path> in a build argument list. Empty means
// "print the hex only", which is the frozen 151D/A1/Phase-B contract the Go
// CLI still uses; A1 adds direct file output without breaking that path.
func natOutputArg(args) {
    int i = 3
    while (i + 1 < len(args)) {
        if (args[i] == "--output") { return args[i + 1] }
        i = i + 1
    }
    return ""
}

func buildNativeFile(path, target, useRegAlloc, outPath) {
    string source = assembleProject(path)
    if (source == "") { return }

    Value tokens = tokenize(source)
    int state = createParserState(tokens, source)
    int ast = parseWithState(state)

    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    // The type check runs before the refusal so the program is validated by
    // the self-hosted engine first: a program that does not type-check should
    // say so rather than be told it lacks a backend. typeCheckProgram returns
    // the diagnostic list (an array), so len() is the error count -- the same
    // shape `checkFile` uses at line 147.
    int typeErrs = typeCheckProgram(ast)
    if (len(typeErrs) > 0) {
        int ei = 0
        while (ei < len(typeErrs)) {
            print(typeErrs[ei])
            ei = ei + 1
        }
        return
    }

// Provenance, printed by the self-hosted engine. The parity harness
      // treats this exact line as proof the request was NOT handled by the Go
      // fallback, so it is load-bearing and must stay greppable.
      print("[kcc] native request " + target + " (os=" + nativeTargetOS(target) + "): " + fileBaseName(path))

      // Phase 151D + A1: kcc OWNS the Windows PE target AND the Linux ELF target
      // for a real program.
      //
      // The emitter is not new code. It is natNativeProgram, the same
      // whole-program driver that `karkain native-ast <file.kark>` drives and
      // that the 9c/9e/9f/9g/9h gates execute on Windows and structurally
      // check on Linux. What changed in 151D is that it is wired to the
      // user-facing `--target native-x86_64-windows` instead of living only
      // behind a measurement subcommand; what A1 adds is that the SAME driver
      // is wired to `--target native-x86_64-linux`, differing only in the OS
      // its entry stub and container are chosen for.
      //
      // NOT native-x86_64-macos. kcc has no Mach-O emitter for a user program:
      // native_macho.kark lowers the FIXED reference corpus that 151C2 compares
      // against the Go oracle, and it does not take a program. So that target
      // keeps refusing, and that refusal is the honest answer rather than a gap
      // to paper over: invoking this emitter for it would silently produce a PE
      // or an ELF under a macOS target NAME, which is a miscompile, not a
      // fallback.
      //
      // The provenance line above is load-bearing: the Go layer must see it
      // before it will write any bytes, so an image without provenance can
      // never be presented as a kcc build.
      if (isNativeTarget(target)) {
        // targetOS is the container/entry identity, and it is the ONLY
        // OS-dependent input to the whole driver: 0 Linux, 1 Windows, 2 macOS.
        // It is derived once here so each target name is compared in exactly
        // one place per file, rather than re-tested inside the driver where
        // three copies could drift.
        int nos = 0
        if (target == "native-x86_64-windows") { nos = 1 }
        if (target == "native-x86_64-macos") { nos = 2 }
        // The source basename goes in as a THIRD argument because the Phase-100 runtime
        // diagnostic names the file it failed in ("... at <file>:<line>"), and the
        // oracle passes its own sourceBase() -- the BASENAME, not the path the user
        // typed. A path would make the diagnostic differ from the Go engine's on the
        // same program, which is a divergence rather than extra detail. fileBaseName
        // already exists for exactly this and is defined above in this file.
        int nres = natNativeProgramOS(ast, nos, fileBaseName(path), useRegAlloc)
        if (nres[0] != "") {
          print(nres[0])
          return
        }
        print("[kcc] native image " + str(len(nres[1])) + " bytes")
        // A1: write the image ourselves. writeToFile would truncate at the
        // first NUL; writeBytes emits one raw byte per array element.
        if (outPath != "") {
            let wrote = writeBytes(outPath, nres[1])
            if (wrote == 0) { print("error[K145]: cannot write " + outPath); return }
            print("[ok] " + outPath)
        }
        print(natToHex(nres[1]))
        return
      }

      print("error[K116]: the self-hosted engine (kcc) cannot emit --target " + target + ".")
      print("  This is refused here, by kcc, rather than silently handed to the Go engine.")
      print("  The " + target + " C-free target is implemented by the Go backend alone.")
}

// runNativeFile is A1's native counterpart to runFile: the same whole-program
// driver buildNativeFile uses, emitting a C-free image, writing it with
// writeBytes, executing it and removing the temporary file. No gcc, no C23
// and no Go launcher are involved.
// nativeCheckFile answers "can this program be lowered natively?" using the
// SAME whole-program driver as a real build, without writing an image or
// printing hex. Only the verdict reaches the CLI.
func nativeCheckFile(path, target) {
    string source = assembleProject(path)
    if (source == "") { return }

    Value tokens = tokenize(source)
    int state = createParserState(tokens, source)
    int ast = parseWithState(state)
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }
    int typeErrs = typeCheckProgram(ast)
    if (len(typeErrs) > 0) {
        int ei = 0
        while (ei < len(typeErrs)) {
            print(typeErrs[ei])
            ei = ei + 1
        }
        return
    }

    int nos = 0
    if (target == "native-x86_64-windows") { nos = 1 }
    if (target == "native-x86_64-macos") { nos = 2 }
    int nres = natNativeProgramOS(ast, nos, fileBaseName(path), 0)
    if (nres[0] != "") {
        print(nres[0])
        return
    }
    print("[ok] native supported")
}

func runNativeFile(path, target, useRegAlloc) {
    string source = assembleProject(path)
    if (source == "") { return }

    Value tokens = tokenize(source)
    int state = createParserState(tokens, source)
    int ast = parseWithState(state)
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }
    int typeErrs = typeCheckProgram(ast)
    if (len(typeErrs) > 0) {
        int ei = 0
        while (ei < len(typeErrs)) {
            print(typeErrs[ei])
            ei = ei + 1
        }
        return
    }

    int nos = 0
    if (target == "native-x86_64-windows") { nos = 1 }
    if (target == "native-x86_64-macos") { nos = 2 }
    int nres = natNativeProgramOS(ast, nos, fileBaseName(path), useRegAlloc)
    if (nres[0] != "") {
        print(nres[0])
        return
    }

    string out = "karkain_native_temp"
    if (nos == 1) { out = out + ".exe" }
    let wrote = writeBytes(out, nres[1])
    if (wrote == 0) { print("error[K145]: cannot write " + out); return }

    string cmd = out
    if (nos != 1) { cmd = "./" + out }
    system(cmd)
    removeFile(out)
}

func buildFile(path, target) {
    string source = assembleProject(path)
    if (source == "") { return }

    // Tokenize
    Value tokens = tokenize(source)

    // Parse (pass source for zero-copy token literal access)
    int state = createParserState(tokens, source)
    int ast = parseWithState(state)

    // Check for errors
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    // Generate code
    let output = generate(ast, target, fileBaseName(path))

    // Output result
    string outPath = replaceExtension(path, "." + target)
    let f = createFile(outPath)
    writeToFile(f, output)
    closeFile(f)

    print("[ok] " + path + "  ->  " + outPath + " (" + target + ")")
}

func runFile(path) {
    string source = assembleProject(path)
    if (source == "") { return }

    // Tokenize
    Value tokens = tokenize(source)

    // Parse (pass source for zero-copy token literal access)
    int state = createParserState(tokens, source)
    int ast = parseWithState(state)

    // Check for errors
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return
    }

    // Generate C23 code
    let cCode = generate(ast, "c23", fileBaseName(path))

    // Write to temp file
    string tempPath = "karkain_temp.c"
    let f = createFile(tempPath)
    writeToFile(f, cCode)
    closeFile(f)

    // Compile with gcc (C2X like the Go reference backend: the embedded
    // concurrency runtime needs C11 atomics).
    //
    // Corrective (v1.2.x): the net runtime in the preamble references Winsock
    // unconditionally and MinGW ignores #pragma comment(lib,...). On Windows,
    // include -lws2_32 on the FIRST link so no failed-link diagnostics are
    // printed. kernel32.dll is present on every Windows host; the openFile
    // probe is the same existence idiom used elsewhere in this driver. POSIX
    // hosts keep the historical command byte-identical.
    string compileCmd = "gcc -std=c2x -o karkain_temp " + tempPath + " -D_POSIX_C_SOURCE=200809L -Wno-psabi -lm"
    if (openFile("C:/Windows/System32/kernel32.dll") != "") {
        compileCmd = compileCmd + " -lws2_32"
    }
    let cc = system(compileCmd)
    if (cc != 0) {
        // Fallback for unusual hosts the probe did not recognise: retry with
        // the Winsock library before declaring failure. POSIX never reaches
        // this branch on a valid program. Both attempts are deliberately
        // silent: `kcc run` prints ONLY the program's own output.
        string retryCmd = compileCmd + " -lws2_32"
        let cc2 = system(retryCmd)
        if (cc2 != 0) {
            removeFile(tempPath)
            return
        }
    }

    // Run — no banner and no separator: only program output reaches stdout.
    string exe = "karkain_temp"
    if (openFile("karkain_temp.exe") != "") { exe = "karkain_temp.exe" }
    // Windows cmd does not accept a "./" prefix; bare names run from the
    // current working directory, whereas POSIX shells need "./" to execute
    // a file that is not on PATH.
    if (endsWith(exe, ".exe")) {
        system(exe)
    } else {
        system("./" + exe)
    }

    // Cleanup
    removeFile(tempPath)
    removeFile("karkain_temp")
    if (openFile("karkain_temp.exe") != "") { removeFile("karkain_temp.exe") }
}

// fileBaseName strips any leading directory components from a path (both "/"
// and "\" separators) returning just the file name, e.g. "prog.kark". Runtime
// error diagnostics embed this base name so every engine reports the same file.
func fileBaseName(path) {
    int i = len(path) - 1
    int slash = -1
    while (i >= 0) {
        string ch = substr(path, i, 1)
        if (ch == "/" || ch == "\\") {
            slash = i
            break
        }
        i = i - 1
    }
    if (slash == -1) { return path }
    return substr(path, slash + 1, len(path) - slash - 1)
}

func replaceExtension(path, newExt) {
    int lastDot = -1
    int i = len(path) - 1
    while (i >= 0) {
        string ch = substr(path, i, 1)
        if (ch == ".") {
            lastDot = i
            break
        }
        i = i - 1
    }
    if (lastDot == -1) {
        return path + newExt
    }
    return substr(path, 0, lastDot) + newExt
}

// Return the directory portion of a path (up to the last '/' or '\').
func dirName(path) {
    int i = len(path) - 1
    while (i >= 0) {
        string ch = substr(path, i, 1)
        if (ch == "/" || ch == "\\") {
            return substr(path, 0, i)
        }
        i = i - 1
    }
    return "."
}

// Return the basename of a path (after the last '/' or '\').
func baseName(path) {
    int i = len(path) - 1
    while (i >= 0) {
        string ch = substr(path, i, 1)
        if (ch == "/" || ch == "\\") {
            return substr(path, i + 1, len(path) - i - 1)
        }
        i = i - 1
    }
    return path
}

func endsWith(s, suffix) {
    int sl = len(s)
    int ol = len(suffix)
    if (ol > sl) { return false }
    return substr(s, sl - ol, ol) == suffix
}

// ============================================================
// Phase 122: Karkain-owned project source assembly
//
// assembleProject builds the self-contained Karkain source a root file
// compiles: module imports (import math, import std.string) resolve to sibling
// files/directories and to the standard-library tree, the root's same-directory
// sibling modules join upstream with the root last, and module import
// declaration lines are stripped while C import blocks are preserved (keeping
// blank lines so assembled source line numbers match the originals). Every
// driver entry (check/build/run/kir/verifykir) compiles through this function,
// so kcc composes its own input on the real CLI path for flat projects; the Go
// CLI only mirrors the project into a sandbox first. Manifests, workspaces and
// package-manager dependencies keep the Go module-aware assembly.
// ============================================================

// sourceLines splits text into tokens that each carry their trailing newline
// (the final token has none), so concatenating the tokens reproduces the input
// byte-for-byte. Unlike the split builtin (which collapses empty runs), this
// preserves blank lines and therefore exact line numbering.
func sourceLines(text) {
    Value out = []
    int pos = 0
    int n = len(text)
    while (pos < n) {
        int start = pos
        while (pos < n && text[pos] != "\n") { pos = pos + 1 }
        int end = pos + 1
        if (end > n) { end = n }
        out = appendArray(out, substr(text, start, end - start))
        pos = end
    }
    return out
}

// stripLineEnd removes a trailing newline and carriage return from a line
// token so name detection is robust on LF and CRLF sources.
func stripLineEnd(line) {
    return trimSuffix(trimSuffix(line, "\n"), "\r")
}

// importNameOf extracts the module name from an import declaration line, or ""
// when the line is not exactly `import <name>` (surrounding whitespace and a
// trailing CR are allowed). C import blocks ("import \"C\"") return "".
func importNameOf(line) {
    string t = trim(stripLineEnd(line))
    if (len(t) < 7) { return "" }
    if (substr(t, 0, 7) != "import ") { return "" }
    string rest = trim(substr(t, 7, len(t) - 7))
    if (len(rest) == 0) { return "" }
    string c0 = substr(rest, 0, 1)
    if (c0 == "\"" || c0 == ".") { return "" }
    string name = ""
    int i = 0
    int stop = 0
    string alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_."
    while (i < len(rest) && stop == 0) {
        string c = substr(rest, i, 1)
        if (indexOf(alpha, c) >= 0) {
            name = name + c
            i = i + 1
        } else {
            stop = 1
        }
    }
    if (len(trim(substr(rest, i, len(rest) - i))) > 0) { return "" }
    return name
}

// isImportLine reports whether a line declares a module import (import math,
// import std.string) as opposed to a C import block.
func isImportLine(line) {
    if (importNameOf(line) == "") { return 0 }
    return 1
}

// arrHas reports whether array arr contains value x.
func arrHas(arr, x) {
    int i = 0
    while (i < len(arr)) {
        if (arr[i] == x) { return 1 }
        i = i + 1
    }
    return 0
}

// moduleImportNames returns the distinct module import names declared in a
// source text, in declaration order.
func moduleImportNames(source) {
    int lines = sourceLines(source)
    int[] names = []
    int i = 0
    while (i < len(lines)) {
        int name = importNameOf(lines[i])
        if (name != "") {
            if (arrHas(names, name) == 0) {
                names = appendArray(names, name)
            }
        }
        i = i + 1
    }
    return names
}

// stripModuleImports removes every module import declaration line, keeping the
// newline so the assembled text preserves the original line numbering exactly
// (mirrors the Go assembler's dotted-import line strip).
func stripModuleImports(text) {
    int lines = sourceLines(text)
    string out = ""
    int pos = 0
    int runStart = -1
    int i = 0
    while (i < len(lines)) {
        Value line = lines[i]
        int ll = len(line)
        if (isImportLine(line) == 1) {
            if (runStart >= 0) {
                out = out + substr(text, runStart, pos - runStart)
                runStart = -1
            }
            if (hasSuffix(line, "\n") == 1) { out = out + "\n" }
        } else {
            if (runStart < 0) { runStart = pos }
        }
        pos = pos + ll
        i = i + 1
    }
    if (runStart >= 0) { out = out + substr(text, runStart, pos - runStart) }
    return out
}

// collectKarkFiles returns the sorted .kark file names directly inside dir
// (empty for a missing/non-directory path), excluding exclude.
func collectKarkFiles(dir, exclude) {
    let entries = listFiles(dir)
    Value out = []
    int i = 0
    while (i < len(entries)) {
        Value name = entries[i]
        if (endsWith(name, ".kark") == true && name != exclude) {
            out = appendArray(out, name)
        }
        i = i + 1
    }
    return sortStrings(out)
}

// moduleDirSource concatenates every .kark file of a module directory in sorted
// order, falling back to a single-file module (<dirPath>.kark). Returns "" when
// the module is absent.
func moduleDirSource(dirPath) {
    int names = collectKarkFiles(dirPath, "")
    string content = ""
    int i = 0
    while (i < len(names)) {
        content = content + readFile(dirPath + "/" + names[i]) + "\n\n"
        i = i + 1
    }
    if (content == "") {
        string single = readFile(dirPath + ".kark")
        if (single != "") { content = single + "\n\n" }
    }
    return content
}

// findStdlibRoot locates the effective standard-library root for a project
// root directory: first the sandbox staging area (<rootDir>/lib), then the
// nearest ancestor holding a stdlib/ tree. A candidate must carry the
// canonical std.string module (so unrelated directories named `stdlib`, such
// as examples/stdlib, are never mistaken for the library).
func findStdlibRoot(rootDir) {
    string libRoot = rootDir + "/lib"
    if (moduleDirSource(libRoot + "/string") != "") { return libRoot }
    let probe = rootDir
    int up = 0
    while (up < 14) {
        string cand = probe + "/stdlib"
        if (moduleDirSource(cand + "/string") != "") { return cand }
        int parent = dirName(probe)
        if (parent == probe) { return "" }
        probe = parent
        up = up + 1
    }
    return ""
}

// resolveStdlibModule returns a std.X module's source from the effective
// standard-library root, or "" when no stdlib is found.
func resolveStdlibModule(sub, rootDir) {
    int root = findStdlibRoot(rootDir)
    if (root == "") { return "" }
    return moduleDirSource(root + "/" + sub)
}

// resolveUserModule returns a bare user module's source: a sibling file
// <name>.kark or a sibling directory <name>/ of .kark files, relative to dir.
func resolveUserModule(name, dir) {
    return moduleDirSource(dir + "/" + name)
}

// siblingContent joins the root's same-directory sibling .kark modules
// (excluding the target and any file declaring its own main), sorted.
func siblingContent(dir, target) {
    int names = collectKarkFiles(dir, target)
    string content = ""
    int i = 0
    while (i < len(names)) {
        string src = readFile(dir + "/" + names[i])
        if (contains(src, "func main(") == 0) {
            content = content + src + "\n\n"
        }
        i = i + 1
    }
    return content
}

// ============================================================
// Project manifest / dependency resolution (Phase 144)
//
// Mirrors Go pm.DependencySources + projectSourceFiles for the manifest
// shapes the CLI used to assemble itself: kcc reads karkain.toml /
// karkain.lock / karkain.workspace.json from the staged tree and computes
// the same dependency directories, so flat AND manifest projects assemble
// without Go. Unresolvable deps skip silently (Go parity); imported-but-
// missing modules still raise error[K122] below.
// ============================================================

// pmSplitFirst splits s on the first sep occurrence: flat [head, tail].
func pmSplitFirst(s, sep) {
    int i = indexOf(s, sep)
    if (i < 0) { return [s, ""] }
    return [substr(s, 0, i), substr(s, i + len(sep), len(s))]
}

// pmStripQuotes removes one matching outer quote pair ("" or '').
func pmStripQuotes(s) {
    string t = trim(s)
    if (len(t) >= 2) {
        string first = substr(t, 0, 1)
        let last = substr(t, len(t) - 1, 1)
        if ((first == "\"" && last == "\"") || (first == "'" && last == "'")) {
            return substr(t, 1, len(t) - 2)
        }
    }
    return t
}

// pmSplitTopLevel splits s on commas outside any {}[]() nesting (mirrors
// Go splitTopLevel; quoted commas split in both — parity by construction).
func pmSplitTopLevel(s) {
    Value out = []
    string cur = ""
    int depth = 0
    int i = 0
    while (i < len(s)) {
        string c = substr(s, i, 1)
        if (c == "{" || c == "[" || c == "(") { depth = depth + 1 }
        if (c == "}" || c == "]" || c == ")") { depth = depth - 1 }
        if (c == "," && depth == 0) {
            out = appendArray(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    out = appendArray(out, cur)
    return out
}

// pmParseDepValue parses one dependency value: inline table fields or a
// bare version string (registry default). Flat [version, source, url].
func pmParseDepValue(val) {
    let version = "*"
    let source = "registry"
    let url = ""
    string t = trim(val)
    if (len(t) >= 2 && substr(t, 0, 1) == "{" && substr(t, len(t) - 1, 1) == "}") {
        string inner = substr(t, 1, len(t) - 2)
        int pairs = pmSplitTopLevel(inner)
        int i = 0
        while (i < len(pairs)) {
            int kv = pmSplitFirst(pairs[i], "=")
            string k = trim(kv[0])
            int v = pmStripQuotes(kv[1])
            if (k == "version") { version = v }
            if (k == "source") { source = v }
            if (k == "url") { url = v }
            i = i + 1
        }
    } else {
        version = pmStripQuotes(t)
    }
    return [version, source, url]
}

// manifestDepRecords parses [dependencies] (never dev-dependencies) into
// flat records [name, version, source, url] * 4.
func manifestDepRecords(text) {
    Value out = []
    int lines = sourceLines(text)
    int inDeps = 0
    int i = 0
    while (i < len(lines)) {
        string line = trim(stripLineEnd(lines[i]))
        if (line == "" || substr(line, 0, 1) == "#") {
            i = i + 1
        } else {
            if (len(line) >= 2 && substr(line, 0, 1) == "[" && substr(line, len(line) - 1, 1) == "]") {
                if (line == "[dependencies]") { inDeps = 1 } else { inDeps = 0 }
                i = i + 1
            } else {
                if (inDeps == 1) {
                    int kv = pmSplitFirst(line, "=")
                    if (trim(kv[0]) != "" && trim(kv[1]) != "") {
                        string name = trim(kv[0])
                        int val = pmParseDepValue(kv[1])
                        out = appendArray(out, name)
                        out = appendArray(out, val[1])
                        out = appendArray(out, val[2])
                        out = appendArray(out, val[0])
                    }
                }
                i = i + 1
            }
        }
    }
    return out
}

// lockLookup finds the [[package]] block named name: flat [version, rev]
// (both "" when absent).
func lockLookup(text, name) {
    let version = ""
    string rev = ""
    int lines = sourceLines(text)
    int inBlock = 0
    int i = 0
    while (i < len(lines)) {
        string line = trim(stripLineEnd(lines[i]))
        if (line == "[[package]]") {
            inBlock = 0
        } else {
            if (len(line) >= 2 && substr(line, 0, 1) == "[") {
                inBlock = 0
            } else {
                if (inBlock == 0 && hasPrefix(line, "name")) {
                    int kv = pmSplitFirst(line, "=")
                    if (pmStripQuotes(kv[1]) == name) { inBlock = 1 }
                } else {
                    if (inBlock == 1 && hasPrefix(line, "version")) {
                        int kv = pmSplitFirst(line, "=")
                        version = pmStripQuotes(kv[1])
                    }
                    if (inBlock == 1 && hasPrefix(line, "rev")) {
                        int kv = pmSplitFirst(line, "=")
                        rev = pmStripQuotes(kv[1])
                    }
                }
            }
        }
        i = i + 1
    }
    return [version, rev]
}

// pmIsAbs reports an absolute path (POSIX leading slash or Windows drive).
func pmIsAbs(p) {
    if (len(p) == 0) { return 0 }
    if (substr(p, 0, 1) == "/") { return 1 }
    if (len(p) > 1 && substr(p, 1, 1) == ":") { return 1 }
    return 0
}

// sanitizeCacheComponent mirrors Go SanitizeCacheComponent exactly:
// [A-Za-z0-9-_.] kept, every other char becomes _.
func sanitizeCacheComponent(s) {
    string allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_."
    string out = ""
    int i = 0
    while (i < len(s)) {
        string c = substr(s, i, 1)
        if (indexOf(allowed, c) >= 0) {
            out = out + c
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    return out
}

// normalizeSourceURL mirrors Go normalizeSourceURL: trim + drop one
// trailing ".git".
func normalizeSourceURL(u) {
    string t = trim(u)
    if (endsWith(t, ".git") == 1) {
        return substr(t, 0, len(t) - 4)
    }
    return t
}

// depCacheName mirrors Go cacheDirName: registry name@version (bare),
// name@ver+source+normurl when a url is present, git name@rev-or-version,
// local/workspace just the name.
func depCacheName(name, version, rev, source, url) {
    if (source == "local" || source == "workspace") {
        return sanitizeCacheComponent(name)
    }
    if (source == "git") {
        string id = rev
        if (id == "") {
            id = version
            if (id == "") { id = "head" }
        }
        return sanitizeCacheComponent(name) + "@" + sanitizeCacheComponent(id)
    }
    if (url == "") {
        return sanitizeCacheComponent(name) + "@" + sanitizeCacheComponent(version)
    }
    string resolved = version
    if (source == "git" && rev != "") { resolved = rev }
    return sanitizeCacheComponent(name) + "@" + sanitizeCacheComponent(resolved) + "+" + sanitizeCacheComponent(source) + "+" + sanitizeCacheComponent(normalizeSourceURL(url))
}

// findProjectRoot walks up for karkain.toml (Go FindProjectRoot minus the
// go.mod fallback: assembly requires a real Karkain manifest on both
// engines, and the Go side rejects go.mod-only dirs identically).
// Presence is probed with openFile (regular files); directories are never
// probed for existence at all (see depSourceDir).
func findProjectRoot(dir) {
    string probe = dir
    int up = 0
    while (up < 14) {
        if (openFile(probe + "/karkain.toml") != "") { return probe }
        string parent = dirName(probe)
        if (parent == probe) { return "" }
        probe = parent
        up = up + 1
    }
    return ""
}

// findWorkspaceRoot walks up for karkain.workspace.json.
func findWorkspaceRoot(dir) {
    string probe = dir
    int up = 0
    while (up < 14) {
        if (openFile(probe + "/karkain.workspace.json") != "") { return probe }
        string parent = dirName(probe)
        if (parent == probe) { return "" }
        probe = parent
        up = up + 1
    }
    return ""
}

// depSourceDir mirrors Go DependencySources directory computation: workspace
// (ws-root-relative url, else project-relative, else deps/<name>), local
// (project-relative url, else deps/<name>), registry/git (project-relative
// .karkain/cache/<name>). It returns the COMPUTED dir unconditionally —
// never an existence verdict: joining a missing dir yields no files, which
// is observationally identical to Go's silent skip (and empty dirs
// contribute nothing on either engine). Unknown sources yield "".
func depSourceDir(projectDir, wsRoot, name, source, url, version, rev) {
    if (source == "workspace") {
        string base = url
        if (base == "") { base = "deps/" + name }
        if (pmIsAbs(base) == 0) {
            if (wsRoot != "") {
                return wsRoot + "/" + base
            }
            return projectDir + "/" + base
        }
        return base
    }
    if (source == "local" || source == "") {
        string base = url
        if (base == "") { base = "deps/" + name }
        if (pmIsAbs(base) == 0) { return projectDir + "/" + base }
        return base
    }
    if (source == "registry" || source == "git") {
        string ver = version
        if (source == "registry" && ver == "") { ver = rev }
        return projectDir + "/.karkain/cache/" + depCacheName(name, ver, rev, source, url)
    }
    return ""
}

// depDirPaths lists a dependency directory's .kark files (top + src/,
// mirroring Go addSortedKark x2) as staged paths. Content decisions
// (main-skip, dedup, root-exclusion) happen once in projectDepSources:
// Karkain arrays are values, so per-dir joins can not share a dedup set.
func depDirPaths(dir) {
    Value out = []
    int i = 0
    while (i < 2) {
        int d = dir
        if (i == 1) { d = dir + "/src" }
        int names = collectKarkFiles(d, "")
        int j = 0
        while (j < len(names)) {
            out = appendArray(out, d + "/" + names[j])
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// pmPathSeen reports membership in the joined-path set (dedup can not use
// a map: Karkain has none — dep counts are tiny).
func pmPathSeen(seen, p) {
    int i = 0
    while (i < len(seen)) {
        if (seen[i] == p) { return 1 }
        i = i + 1
    }
    return 0
}

// projectDepSources assembles manifest dependency sources upstream-first
// (sorted by dep name, mirroring Go): the full content or "" when the file
// lives outside a manifest project. Files declaring their own main are
// skipped (Go check/build/run parity), joined paths deduped, the root file
// itself excluded.
func projectDepSources(path) {
    string dir = dirName(path)
    string projectDir = findProjectRoot(dir)
    if (projectDir == "") { return "" }
    string manifest = readFile(projectDir + "/karkain.toml")
    if (manifest == "") { return "" }
    string lockText = readFile(projectDir + "/karkain.lock")
    string wsRoot = findWorkspaceRoot(dir)
    int recs = manifestDepRecords(manifest)
    int[] names = []
    int i = 0
    while (i < len(recs)) {
        names = appendArray(names, recs[i])
        i = i + 4
    }
    names = sortStrings(names)
    Value files = []
    i = 0
    while (i < len(names)) {
        int j = 0
        while (j < len(recs)) {
            if (recs[j] == names[i]) {
                Value ver = recs[j + 3]
                Value src = recs[j + 1]
                Value url = recs[j + 2]
                Value lk = lockLookup(lockText, names[i])
                if (src == "registry" && ver == "") { ver = lk[0] }
                string rv = ""
                if (src == "git") { rv = lk[1] }
                string d = depSourceDir(projectDir, wsRoot, names[i], src, url, ver, rv)
                if (d != "") {
                    Value ps = depDirPaths(d)
                    int k = 0
                    while (k < len(ps)) {
                        files = appendArray(files, ps[k])
                        k = k + 1
                    }
                }
            }
            j = j + 4
        }
        i = i + 1
    }
    int[] seen = []
    string content = ""
    i = 0
    while (i < len(files)) {
        Value p = files[i]
        if (p == path || pmPathSeen(seen, p) == 1) {
            i = i + 1
        } else {
            string src = readFile(p)
            if (contains(src, "func main(") == 0) {
                content = content + src + "\n\n"
                seen = appendArray(seen, p)
            }
            i = i + 1
        }
    }
    return content
}

// assembleProject returns the self-contained assembled source for a project
// root file, or "" (after printing error[K122] for an unresolvable module)
// when assembly cannot complete. check/build/run/kir/verifykir all compile
// through this function. Manifest dependency sources (Phase 144) come first
// (upstream, mirroring Go projectSourceFiles); the sibling/import content
// follows; the root file is always last.
func assembleProject(path) {
    string rootSrc = readFile(path)
    if (rootSrc == "") { return "" }
    int dir = dirName(path)
    int base = baseName(path)
    int names = moduleImportNames(rootSrc)
    int content = projectDepSources(path)
    if (len(names) == 0) {
        content = content + siblingContent(dir, base)
    } else {
        int allNames = names
        int processed = []
        int qi = 0
        while (qi < len(allNames)) {
            Value name = allNames[qi]
            if (arrHas(processed, name) == 1) {
                qi = qi + 1
                continue
            }
            processed = appendArray(processed, name)
            string m = ""
            if (hasPrefix(name, "std.") == 1) {
                m = resolveStdlibModule(trimPrefix(name, "std."), dir)
            } else {
                m = resolveUserModule(name, dir)
            }
            if (m == "") {
                print("error[K122]: module '" + name + "' not found (assembling " + path + ")")
                return ""
            }
            content = content + m
            int trans = moduleImportNames(m)
            int ti = 0
            while (ti < len(trans)) {
                Value tname = trans[ti]
                if (arrHas(allNames, tname) == 0) {
                    allNames = appendArray(allNames, tname)
                }
                ti = ti + 1
            }
            qi = qi + 1
        }
    }
    content = content + rootSrc
    return stripModuleImports(content)
}

// ============================================================
// Test runner - discovers and runs *_test.kark files
//
// Phase 96: the self-hosted engine owns the test runner. Discovery
// mirrors the Go CLI contract (findTestFiles): a directory yields every
// *_test.kark file (sorted), a single path is used as-is. For each test
// file the runner parses it, collects the test_* functions, synthesizes a
// driver program (the file's source + a main that calls the selected test
// functions) and compiles and executes it through gcc. Exit code 0 means
// every assertion held; asserts exit(1), so a nonzero code flags failure.
// The output mirrors the Go runner's summary contract so the Go wrapper
// can parse `N passed; M failed; S skipped; T total`.
// ============================================================

func runTests(testPath, filter) {
    int files = collectTestFiles(testPath)
    if (len(files) == 0) {
        print("No test files found.")
        return
    }
    int total = 0
    int passed = 0
    int failed = 0
    int fi = 0
    while (fi < len(files)) {
        Value file = files[fi]
        print("=== Running tests in " + file + " ===")
        string source = readFile(file)
        if (source == "") {
            print("  error reading " + file)
            fi = fi + 1
            continue
        }
        Value tokens = tokenize(source)
        int state = createParserState(tokens, source)
        int ast = parseWithState(state)
        if (hasParserErrors(state)) {
            printParserErrors(state)
            fi = fi + 1
            continue
        }
        int tests = applyFilter(collectTestNames(ast), filter)
        int tn = len(tests)
        if (tn == 0) {
            fi = fi + 1
            continue
        }
        // Fast path: one driver calling every selected test. A clean exit
        // means all passed; a nonzero exit isolates the failing tests.
        string allDriver = source + "\nfunc main() {\n" + buildCallList(tests) + "}\n"
        int allCode = compileRunDriver(allDriver)
        if (allCode == 0) {
            int ti = 0
            while (ti < tn) {
                print("  PASS " + tests[ti])
                passed = passed + 1
                total = total + 1
                ti = ti + 1
            }
        } else {
            int ti = 0
            while (ti < tn) {
                Value tname = tests[ti]
                string driver = source + "\nfunc main() {\n    " + tname + "()\n}\n"
                int code = compileRunDriver(driver)
                if (code == 0) {
                    print("  PASS " + tname)
                    passed = passed + 1
                } else {
                    print("  FAIL " + tname)
                    failed = failed + 1
                }
                total = total + 1
                ti = ti + 1
            }
        }
        fi = fi + 1
    }
    // Go-parity summary output (see printTestSummary + summaryLine).
    print("")
    print("=== Test Summary: " + str(total) + " tests, " + str(passed) + " passed, " + str(failed) + " failed, 0 skipped ===")
    print(str(passed) + " passed; " + str(failed) + " failed; 0 skipped; " + str(total) + " total")
}

// Discover *_test.kark files under a directory or accept a single file path
// directly (mirrors findTestFiles / TestCommandFiltered semantics).
func collectTestFiles(testPath) {
    Value files = []
    let entries = listFiles(testPath)
    if (len(entries) > 0) {
        int n = len(entries)
        int i = 0
        while (i < n) {
            Value name = entries[i]
            if (endsWith(name, "_test.kark")) {
                files = appendArray(files, testPath + "/" + name)
            }
            i = i + 1
        }
    } else {
        // No named entries: either a single test file or a directory whose
        // top-level listing is empty. Adopt the path as a single file when it
        // looks like a test file or reads back as source (a directory yields
        // "" on Windows fopen, and listFiles already returned nothing).
        bool isTestFile = endsWith(testPath, "_test.kark")
        if (isTestFile) {
            files = appendArray(files, testPath)
        } else if (readFile(testPath) != "") {
            files = appendArray(files, testPath)
        }
    }
    return sortStrings(files)
}

// Collect every top-level test_* function name from a parsed program.
func collectTestNames(ast) {
    int[] names = []
    int stmts = programStatements(ast)
    int n = len(stmts)
    int i = 0
    while (i < n) {
        Value stmt = stmts[i]
        if (getNodeType(stmt) == "FuncDecl") {
            string fname = funcName(stmt)
            int pl = len(fname)
            if (pl >= 5) {
                if (substr(fname, 0, 5) == "test_") {
                    names = appendArray(names, fname)
                }
            }
        }
        i = i + 1
    }
    return sortStrings(names)
}

// Substring filter over the test name, matching pkg/testing.Filter.
func applyFilter(names, filter) {
    if (len(filter) == 0) { return names }
    Value out = []
    int i = 0
    while (i < len(names)) {
        if (contains(names[i], filter) == 1) {
            out = appendArray(out, names[i])
        }
        i = i + 1
    }
    return out
}

// Build the body of a synthesized main that invokes every listed test.
func buildCallList(names) {
    string s = ""
    int i = 0
    while (i < len(names)) {
        s = s + "    " + names[i] + "()\n"
        i = i + 1
    }
    return s
}

// Tokenize/parse/generate/compile/run one synthesized test driver. Returns the
// driver's exit code (0 = all assertions held); cleanup is always performed.
func compileRunDriver(driver) {
    Value tokens = tokenize(driver)
    int state = createParserState(tokens, driver)
    int ast = parseWithState(state)
    if (hasParserErrors(state)) {
        printParserErrors(state)
        return 1
    }
    let cCode = generate(ast, "c23", "karkain_test.c")
    string tempPath = "karkain_test.c"
    let f = createFile(tempPath)
    writeToFile(f, cCode)
    closeFile(f)
    string compileCmd = "gcc -std=c2x -x c -D_POSIX_C_SOURCE=200809L -Wno-psabi -o karkain_test " + tempPath + " -lgmp -lm"
    let cc = system(compileCmd)
    if (cc != 0) {
        // Phase 125A: the networking preamble emits Winsock references
        // behind #ifdef _WIN32. On Windows hosts the plain link fails, so
        // retry with the Winsock library before declaring failure. POSIX
        // hosts never take this branch (no WSA symbols to resolve).
        let cc2 = system(compileCmd + " -lws2_32")
        if (cc2 != 0) {
            removeFile(tempPath)
            return 1
        }
    }
    // gcc adds .exe on Windows; resolve the actual artifact name.
    string exe = "karkain_test"
    if (openFile("karkain_test.exe") != "") { exe = "karkain_test.exe" }
    // Windows cmd does not accept a "./" prefix; bare names run from the
    // current working directory, whereas POSIX shells need "./" to execute
    // a file that is not on PATH.
    int code = 0
    if (endsWith(exe, ".exe")) {
        code = system(exe)
    } else {
        code = system("./" + exe)
    }
    removeFile(tempPath)
    removeFile("karkain_test")
    removeFile("karkain_test.exe")
    return code
}

// Deterministic lexicographic insertion sort over an array of strings. The
// self-hosted runtime lacks a built-in sort, but string < / > comparisons are
// supported through binary_op, and index assignment through index_set.
func sortStrings(arr) {
    int n = len(arr)
    int i = 1
    while (i < n) {
        Value key = arr[i]
        int j = i - 1
        while (j >= 0) {
            let gt = arr[j] > key
            if (gt == 0) { break }
            arr[j + 1] = arr[j]
            j = j - 1
        }
        arr[j + 1] = key
        i = i + 1
    }
    return arr
}


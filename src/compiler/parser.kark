// ============================================================
// Self-hosted Karkain Parser — Production version
// Rewritten from pkg/parser/parser.go (2088 lines Go) to pure Karkain
// Uses lexer.kark for tokenization and ast.kark for node types
// ============================================================

// ============================================================
// Parser state: [tokens, pos, errors, errorCols, line, source]
// source is kept for zero-copy token literal extraction.
// ============================================================

func createParserState(tokens, source) {
    let state = []
    state = appendArray(state, tokens)
    state = appendArray(state, 0)
    state = appendArray(state, [])   // errors
    state = appendArray(state, [])   // errorCols
    state = appendArray(state, 1)    // line
    state = appendArray(state, source)
    return state
}

func psTokens(state)    { return state[0] }
func psPos(state)       { return state[1] }
func psErrors(state)    { return state[2] }
func psErrorCols(state) { return state[3] }
func psLine(state)      { return state[4] }
func psSource(state)    { return state[5] }
func setPsPos(state, v)  { state[1] = v }

func hasParserErrors(state) { return len(psErrors(state)) > 0 }

func printParserErrors(state) {
    let errs = psErrors(state)
    let i = 0
    while (i < len(errs)) {
        print(errs[i])
        i = i + 1
    }
}

func psCurKind(state) {
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos >= len(tokens)) { return TK_EOF() }
    return tokenKind(tokens[pos])
}

func psPeekKind(state) {
    let pos = psPos(state) + 1
    let tokens = psTokens(state)
    if (pos >= len(tokens)) { return TK_EOF() }
    return tokenKind(tokens[pos])
}

func psCurToken(state) {
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos >= len(tokens)) { return [] }
    return tokens[pos]
}

func psPeekToken(state) {
    let pos = psPos(state) + 1
    let tokens = psTokens(state)
    if (pos >= len(tokens)) { return [] }
    return tokens[pos]
}

func psAdvance(state) {
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos < len(tokens)) {
        let tok = tokens[pos]
        setPsPos(state, pos + 1)
        if (tokenLine(tok) > 0) { state[4] = tokenLine(tok) }
        return tok
    }
    setPsPos(state, pos + 1)
    return []
}

func psAddError(state, msg) {
    let line = psLine(state)
    let errStr = "line " + str(line) + ": " + msg
    state[2] = appendArray(state[2], errStr)
    let col = 0
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos < len(tokens)) { col = tokenCol(tokens[pos]) + 1 }
    state[3] = appendArray(state[3], col)
}

func psExpect(state, kind) {
    let cur = psCurKind(state)
    if (cur != kind) {
        let tok = psCurToken(state)
        let literal = tokenLiteral(tok, psSource(state))
        psAddError(state, "expected " + tokenKindName(kind) + " but got " + tokenKindName(cur))
        return 0
    }
    psAdvance(state)
    return 1
}

func psCurLiteral(state) {
    let tok = psCurToken(state)
    return tokenLiteral(tok, psSource(state))
}

// ============================================================
// Operator precedence
// ============================================================

func kPrec(op) {
    if (op == "||") { return 0 }
    if (op == "&&") { return 1 }
    if (op == "==") { return 2 }
    if (op == "!=") { return 2 }
    if (op == "<")  { return 2 }
    if (op == ">")  { return 2 }
    if (op == "<=") { return 2 }
    if (op == ">=") { return 2 }
    if (op == "+")  { return 3 }
    if (op == "-")  { return 3 }
    if (op == "*")  { return 4 }
    if (op == "/")  { return 4 }
    if (op == "%")  { return 4 }
    return -1
}

func isOpToken(kind) {
    if (kind == TK_PLUS())   { return 1 }
    if (kind == TK_MINUS())  { return 1 }
    if (kind == TK_STAR())   { return 1 }
    if (kind == TK_SLASH())  { return 1 }
    if (kind == TK_PERCENT()){ return 1 }
    if (kind == TK_EQ())     { return 1 }
    if (kind == TK_NEQ())    { return 1 }
    if (kind == TK_LT())     { return 1 }
    if (kind == TK_GT())     { return 1 }
    if (kind == TK_LTE())    { return 1 }
    if (kind == TK_GTE())    { return 1 }
    if (kind == TK_AND())    { return 1 }
    if (kind == TK_OR())     { return 1 }
    return 0
}

func kindToOp(kind) {
    if (kind == TK_PLUS())   { return "+" }
    if (kind == TK_MINUS())  { return "-" }
    if (kind == TK_STAR())   { return "*" }
    if (kind == TK_SLASH())  { return "/" }
    if (kind == TK_PERCENT()){ return "%" }
    if (kind == TK_EQ())     { return "==" }
    if (kind == TK_NEQ())    { return "!=" }
    if (kind == TK_LT())     { return "<" }
    if (kind == TK_GT())     { return ">" }
    if (kind == TK_LTE())    { return "<=" }
    if (kind == TK_GTE())    { return ">=" }
    if (kind == TK_AND())    { return "&&" }
    if (kind == TK_OR())     { return "||" }
    return ""
}

// ============================================================
// Main parse function
// ============================================================

func parse(tokens, source) {
    let state = createParserState(tokens, source)
    let stmts = []
    let imports = []

    while (psCurKind(state) != TK_EOF()) {
        let kind = psCurKind(state)

        // import "C" { ... }
        if (kind == TK_IMPORT()) {
            if (psPeekKind(state) == TK_STRING_LIT()) {
                let content = psCurLiteral(state)
                if (content == "C") {
                    psAdvance(state) // import
                    psAdvance(state) // "C"
                    let cCode = parseCBlock(state)
                    imports = appendArray(imports, makeCImport(cCode, psLine(state)))
                    continue
                }
            }
            // module import
            if (psPeekKind(state) == TK_IDENT()) {
                psAdvance(state) // import
                let name = psCurLiteral(state)
                psAdvance(state) // name
                imports = appendArray(imports, makeImport(name, psLine(state)))
                continue
            }
            psAddError(state, "expected module name or \"C\" after 'import'")
            psAdvance(state)
            continue
        }

        // func name(params) { body }
        if (kind == TK_FUNC()) {
            let funcNode = parseFunc(state)
            if (funcNode != []) { stmts = appendArray(stmts, funcNode) }
            continue
        }

        // type Name struct { field type, ... }
        if (kind == TK_TYPE()) {
            let sd = parseStructDecl(state)
            if (sd != []) { stmts = appendArray(stmts, sd) }
            continue
        }

        // enum Name { Variant, Variant(payload), ... }
        if (kind == TK_ENUM()) {
            let ed = parseEnumDecl(state)
            if (ed != []) { stmts = appendArray(stmts, ed) }
            continue
        }

        // kernel name(params) { body }
        if (kind == TK_KERNEL()) {
            let k = parseKernel(state)
            if (k != []) { stmts = appendArray(stmts, k) }
            continue
        }

        // Statement-level constructs
        if (kind == TK_LET() || kind == TK_VAR()) {
            let vd = parseVarDecl(state)
            if (vd != []) { stmts = appendArray(stmts, vd) }
            continue
        }

        if (kind == TK_PRINT()) {
            let pr = parsePrint(state)
            if (pr != []) { stmts = appendArray(stmts, pr) }
            continue
        }

        if (kind == TK_RETURN()) {
            let ret = parseReturn(state)
            if (ret != []) { stmts = appendArray(stmts, ret) }
            continue
        }

        if (kind == TK_IF()) {
            let ifStmt = parseIf(state)
            if (ifStmt != []) { stmts = appendArray(stmts, ifStmt) }
            continue
        }

        if (kind == TK_WHILE()) {
            let wh = parseWhile(state)
            if (wh != []) { stmts = appendArray(stmts, wh) }
            continue
        }

        if (kind == TK_FOR()) {
            let fr = parseFor(state)
            if (fr != []) { stmts = appendArray(stmts, fr) }
            continue
        }

        if (kind == TK_BREAK()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeBreak(psLine(state)))
            continue
        }

        if (kind == TK_CONTINUE()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeContinue(psLine(state)))
            continue
        }

        // Expression statement
        let expr = parseExpr(state)
        if (expr != []) {
            stmts = appendArray(stmts, makeExprStmt(expr, psLine(state)))
            continue
        }

        // Unknown token — skip
        psAddError(state, "unexpected token at top level")
        psAdvance(state)
    }

    return makeProgram(stmts, imports)
}

// ============================================================
// Parse C import block: import "C" { ... }
// ============================================================

func parseCBlock(state) {
    // Current token should be '{'
    if (psCurKind(state) != TK_LBRACE()) {
        psAddError(state, "expected '{' for C import block")
        return ""
    }

    // We need the raw source to extract C code between braces.
    // The lexer already consumed the '{', so we scan tokens until matching '}'
    let depth = 1
    let start = psPos(state)
    psAdvance(state) // consume '{'

    while (psCurKind(state) != TK_EOF() && depth > 0) {
        if (psCurKind(state) == TK_LBRACE()) { depth = depth + 1 }
        if (psCurKind(state) == TK_RBRACE()) {
            depth = depth - 1
            if (depth == 0) { break }
        }
        psAdvance(state)
    }

    // For now, return empty string — C block extraction needs source-level access
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return ""
}

// ============================================================
// Parse function declaration
// ============================================================

func parseFunc(state) {
    let line = psLine(state)
    let startCol = 0
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos < len(tokens)) { startCol = tokenCol(tokens[pos]) }

    psAdvance(state) // consume 'func'

    let name = psCurLiteral(state)
    psAdvance(state) // consume name

    // Consume '('
    if (psCurKind(state) != TK_LPAREN()) {
        psAddError(state, "expected '(' after function name")
        return []
    }
    psAdvance(state)

    // Parse parameters
    let params = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT()) {
            params = appendArray(params, psCurLiteral(state))
            psAdvance(state)
            // Skip optional type annotation
            if (psCurKind(state) == TK_IDENT()) { psAdvance(state) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        } else {
            psAdvance(state)
        }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    // Skip optional return type
    if (psCurKind(state) == TK_IDENT()) { psAdvance(state) }

    // Consume '{'
    if (psCurKind(state) != TK_LBRACE()) {
        psAddError(state, "expected '{' for function body")
        return []
    }
    psAdvance(state)

    let body = parseBlock(state)

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeFuncDecl(name, params, body, line, startCol)
}

// ============================================================
// Parse block (statements until '}')
// ============================================================

func parseBlock(state) {
    let stmts = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        let before = psPos(state)
        let kind = psCurKind(state)

        if (kind == TK_LET() || kind == TK_VAR()) {
            let vd = parseVarDecl(state)
            if (vd != []) { stmts = appendArray(stmts, vd) }
        } else if (kind == TK_PRINT()) {
            let pr = parsePrint(state)
            if (pr != []) { stmts = appendArray(stmts, pr) }
        } else if (kind == TK_RETURN()) {
            let ret = parseReturn(state)
            if (ret != []) { stmts = appendArray(stmts, ret) }
        } else if (kind == TK_IF()) {
            let ifStmt = parseIf(state)
            if (ifStmt != []) { stmts = appendArray(stmts, ifStmt) }
        } else if (kind == TK_WHILE()) {
            let wh = parseWhile(state)
            if (wh != []) { stmts = appendArray(stmts, wh) }
        } else if (kind == TK_FOR()) {
            let fr = parseFor(state)
            if (fr != []) { stmts = appendArray(stmts, fr) }
        } else if (kind == TK_BREAK()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeBreak(psLine(state)))
        } else if (kind == TK_CONTINUE()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeContinue(psLine(state)))
        } else if (kind == TK_LBRACE()) {
            // Nested block
            psAdvance(state)
            let inner = parseBlock(state)
            if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
            stmts = appendArray(stmts, makeBlock(inner))
        } else {
            let expr = parseExpr(state)
            if (expr != []) {
                stmts = appendArray(stmts, makeExprStmt(expr, psLine(state)))
            } else {
                // Stall protection
                if (psPos(state) == before) { psAdvance(state) }
            }
        }
        // Stall protection
        if (psPos(state) == before && psCurKind(state) != TK_EOF()) {
            psAdvance(state)
        }
    }
    return stmts
}

// ============================================================
// Parse variable declaration: let name = value or let name: type = value
// ============================================================

func parseVarDecl(state) {
    let line = psLine(state)
    let isLet = 1
    if (psCurKind(state) == TK_VAR()) { isLet = 0 }
    psAdvance(state) // consume let/var

    let name = psCurLiteral(state)
    psAdvance(state) // consume name

    // Optional type annotation: name type or name: type
    let typeName = ""
    if (psCurKind(state) == TK_COLON()) {
        psAdvance(state) // consume ':'
        typeName = psCurLiteral(state)
        psAdvance(state) // consume type
    } else if (psCurKind(state) == TK_IDENT()) {
        typeName = psCurLiteral(state)
        psAdvance(state) // consume type
    }

    // Consume '='
    if (psCurKind(state) == TK_ASSIGN()) {
        psAdvance(state)
    }

    let value = parseExpr(state)
    if (isLet == 1) { return makeLetDecl(name, value, typeName, line) }
    return makeVarDecl(name, value, typeName, line)
}

// ============================================================
// Parse print statement
// ============================================================

func parsePrint(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'print'

    // Optional '('
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    let val = parseExpr(state)

    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    return makePrint(val, line)
}

// ============================================================
// Parse return statement
// ============================================================

func parseReturn(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'return'

    let val = parseExpr(state)
    return makeReturn(val, line)
}

// ============================================================
// Parse if statement
// ============================================================

func parseIf(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'if'

    let cond = parseExpr(state)

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    let cons = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    let alt = []
    if (psCurKind(state) == TK_ELSE()) {
        psAdvance(state) // consume 'else'
        if (psCurKind(state) == TK_IF()) {
            let elseIf = parseIf(state)
            alt = appendArray(alt, elseIf)
        } else {
            if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
            alt = parseBlock(state)
            if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        }
    }

    return makeIf(cond, cons, alt, line)
}

// ============================================================
// Parse while statement
// ============================================================

func parseWhile(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'while'

    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
    let cond = parseExpr(state)
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    let body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeWhile(cond, body, line)
}

// ============================================================
// Parse for statement (C-style and for-in)
// ============================================================

func parseFor(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'for'

    // for-in: for x in expr { ... }
    if (psCurKind(state) == TK_IDENT() && psPeekKind(state) == TK_IN()) {
        let varName = psCurLiteral(state)
        psAdvance(state) // var
        psAdvance(state) // in
        let iter = parseExpr(state)
        if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
        let body = parseBlock(state)
        if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        return makeForIn(varName, iter, body, line)
    }

    // C-style: for (init; cond; post) { ... }
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    let init = []
    if (psCurKind(state) != TK_SEMICOLON()) {
        init = parseExpr(state)
    }
    if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }

    let cond = parseExpr(state)
    if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }

    let post = []
    if (psCurKind(state) != TK_RPAREN()) {
        post = parseExpr(state)
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    let body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeFor(init, cond, post, body, line)
}

// ============================================================
// Parse struct declaration: type Name struct { field type, ... }
// ============================================================

func parseStructDecl(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'type'

    let name = psCurLiteral(state)
    psAdvance(state) // consume name

    if (psCurKind(state) == TK_STRUCT()) { psAdvance(state) }
    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }

    let fields = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        let fieldName = psCurLiteral(state)
        psAdvance(state)
        let fieldType = psCurLiteral(state)
        psAdvance(state)
        fields = appendArray(fields, fieldName + ":" + fieldType)
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeStructDecl(name, fields, line)
}

// ============================================================
// Parse enum declaration: enum Name { Variant, Variant(type), ... }
// ============================================================

func parseEnumDecl(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'enum'

    let name = psCurLiteral(state)
    psAdvance(state) // consume name

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }

    let variants = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        let variantName = psCurLiteral(state)
        psAdvance(state)
        let payload = ""
        if (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state)
            payload = psCurLiteral(state)
            psAdvance(state)
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        }
        variants = appendArray(variants, variantName + ":" + payload)
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeEnumDecl(name, variants, line)
}

// ============================================================
// Parse kernel declaration: kernel name(params) { body }
// ============================================================

func parseKernel(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'kernel'

    let name = psCurLiteral(state)
    psAdvance(state)

    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    let params = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT()) {
            params = appendArray(params, psCurLiteral(state))
            psAdvance(state)
            if (psCurKind(state) == TK_COLON()) { psAdvance(state) }
            if (psCurKind(state) == TK_IDENT()) { psAdvance(state) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        } else {
            psAdvance(state)
        }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    let body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeKernel(name, params, body, line)
}

// ============================================================
// Expression parsing — Pratt parser
// ============================================================

func parseExpr(state) {
    return parseBinary(state, [], 0)
}

func parseBinary(state, left, minPrec) {
    if (left == []) {
        left = parseUnary(state)
    }

    while (1) {
        // Postfix: index [expr]
        while (psCurKind(state) == TK_LBRACKET()) {
            psAdvance(state) // consume '['
            let idx = parseExpr(state)
            if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
            left = makeIndex(left, idx, psLine(state))
        }

        // Postfix: .field
        while (psCurKind(state) == TK_DOT()) {
            psAdvance(state) // consume '.'
            let field = psCurLiteral(state)
            psAdvance(state)
            left = makeDot(left, field, psLine(state))
        }

        // Postfix: ?
        if (psCurKind(state) == TK_QUESTION()) {
            psAdvance(state)
            left = makeUnary("?", left, psLine(state))
        }

        // Assignment: lhs = rhs (simple, index, or dot target)
        if (psCurKind(state) == TK_ASSIGN()) {
            psAdvance(state) // consume '='
            let rhs = parseExpr(state)
            left = makeBinary("=", left, rhs, psLine(state))
            break
        }

        // Binary operator
        let kind = psCurKind(state)
        if (!isOpToken(kind)) { break }

        let op = kindToOp(kind)
        let prec = kPrec(op)
        if (prec < minPrec) { break }

        psAdvance(state) // consume operator
        let right = parseBinary(state, [], prec + 1)
        left = makeBinary(op, left, right, psLine(state))
    }

    return left
}

func parseUnary(state) {
    if (psCurKind(state) == TK_MINUS()) {
        psAdvance(state)
        let operand = parseUnary(state)
        return makeUnary("-", operand, psLine(state))
    }
    if (psCurKind(state) == TK_NOT()) {
        psAdvance(state)
        let operand = parseUnary(state)
        return makeUnary("!", operand, psLine(state))
    }
    return parsePrimary(state)
}

// ============================================================
// Parse primary expressions
// ============================================================

func parsePrimary(state) {
    let kind = psCurKind(state)
    let line = psLine(state)

    // String literal
    if (kind == TK_STRING_LIT()) {
        let val = psCurLiteral(state)
        psAdvance(state)
        return makeStringLit(val, line)
    }

    // Integer literal
    if (kind == TK_INT_LIT()) {
        let val = psCurLiteral(state)
        psAdvance(state)
        return makeIntLit(val, line)
    }

    // Float literal
    if (kind == TK_FLOAT_LIT()) {
        let val = psCurLiteral(state)
        psAdvance(state)
        return makeFloatLit(val, line)
    }

    // Boolean literals
    if (kind == TK_TRUE()) {
        psAdvance(state)
        return makeBoolLit("true", line)
    }
    if (kind == TK_FALSE()) {
        psAdvance(state)
        return makeBoolLit("false", line)
    }

    // Parenthesized expression
    if (kind == TK_LPAREN()) {
        psAdvance(state)
        let expr = parseExpr(state)
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        return expr
    }

    // Array literal
    if (kind == TK_LBRACKET()) {
        return parseArrayLit(state)
    }

    // Identifier or function call or struct literal
    if (kind == TK_IDENT()) {
        return parseIdentOrCall(state)
    }

    return []
}

// ============================================================
// Parse identifier, function call, dot access, or struct literal
// ============================================================

func parseIdentOrCall(state) {
    let name = psCurLiteral(state)
    let line = psLine(state)
    let col = 0
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos < len(tokens)) { col = tokenCol(tokens[pos]) }

    psAdvance(state) // consume identifier

    // Function call: name(args)
    if (psCurKind(state) == TK_LPAREN()) {
        psAdvance(state) // consume '('
        let args = []
        while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
            let arg = parseExpr(state)
            if (arg != []) { args = appendArray(args, arg) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        }
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        return makeCall(name, args, line, col)
    }

    // Dot access: name.field or name.field(args)
    if (psCurKind(state) == TK_DOT()) {
        psAdvance(state) // consume '.'
        let field = psCurLiteral(state)
        psAdvance(state)

        // Method call: name.method(args)
        if (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state) // consume '('
            let args = []
            while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
                let arg = parseExpr(state)
                if (arg != []) { args = appendArray(args, arg) }
                if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
            }
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            return makeCall(name + "." + field, args, line, col)
        }

        return makeDot(makeIdent(name, line, col), field, line)
    }

    // Struct literal: TypeName { field: val, ... }
    if (psCurKind(state) == TK_LBRACE()) {
        psAdvance(state) // consume '{'
        let fields = []
        while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
            let fieldName = psCurLiteral(state)
            psAdvance(state)
            if (psCurKind(state) == TK_COLON()) { psAdvance(state) }
            let val = parseExpr(state)
            fields = appendArray(fields, makeBinary("=", makeIdent(fieldName, 0, 0), val, 0))
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        }
        if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        return makeStructLit(name, fields, line)
    }

    // Simple identifier
    return makeIdent(name, line, col)
}

// ============================================================
// Parse array literal: [expr, expr, ...]
// ============================================================

func parseArrayLit(state) {
    let line = psLine(state)
    psAdvance(state) // consume '['

    let elements = []
    if (psCurKind(state) != TK_RBRACKET()) {
        let elem = parseExpr(state)
        if (elem != []) { elements = appendArray(elements, elem) }
        while (psCurKind(state) == TK_COMMA()) {
            psAdvance(state)
            elem = parseExpr(state)
            if (elem != []) { elements = appendArray(elements, elem) }
        }
    }

    if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
    return makeArrayLit(elements, line)
}

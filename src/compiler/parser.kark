// ============================================================
// Self-hosted Karkain Parser Ã¢â‚¬â€ Production version
// Rewritten from pkg/parser/parser.go (2088 lines Go) to pure Karkain
// Uses lexer.kark for tokenization and ast.kark for node types
// ============================================================

// ============================================================
// Parser state: [tokens, pos, errors, errorCols, line, source]
// source is kept for zero-copy token literal extraction.
// ============================================================

func createParserState(tokens, source) {
    Value state = []
    state = appendArray(state, tokens)
    state = appendArray(state, 0)
    state = appendArray(state, [])   // errors
    state = appendArray(state, [])   // errorCols
    state = appendArray(state, 1)    // line
    state = appendArray(state, source)
    state = appendArray(state, 0)    // noStructAtBrace (Phase 81: unparenthesized if condition)
    state = appendArray(state, [])   // enumNames (Phase 123: enum variant patterns/construction)
    state = appendArray(state, 0)    // lambdaSeq (Phase 133: bare-lambda sequence numbers)
    return state
}

func psNextLambdaSeq(state) {
    state[8] = state[8] + 1
    return state[8]
}

func psNoStructAtBrace(state) { return state[6] }
func setPsNoStructAtBrace(state, v) { state[6] = v }

// ============================================================
// Phase 123: parser-level enum registry. Enum names are recorded at
// parseEnumDecl so that EnumName.Variant expressions and match arms lower to
// EnumVariantExpr / enum_variant patterns (mirroring the Go parser's
// p.enumNames map). Declarations precede use, matching the Go front end.
// ============================================================

func psEnumNames(state) { return state[7] }
func setPsEnumNames(state, v) { state[7] = v }
func psAddEnumName(state, name) {
    int names = psEnumNames(state)
    names = appendArray(names, name)
    setPsEnumNames(state, names)
}
func isEnumName(state, name) { return psListHas(psEnumNames(state), name) }

func psTokens(state)    { return state[0] }
func psPos(state)       { return state[1] }
func psErrors(state)    { return state[2] }
func psErrorCols(state) { return state[3] }
func psLine(state)      { return state[4] }
func psSource(state)    { return state[5] }
func setPsPos(state, v)  { state[1] = v }

// ============================================================
// Phase 121: free-variable capture analysis for lambdas (mirrors
// pkg/parser/captures.go). computeCaptures returns the ordered,
// deduplicated identifiers referenced in the body that are neither
// parameters nor locally declared inside it.
// ============================================================

func psListHas(list, item) {
    int i = 0
    while (i < len(list)) {
        if (list[i] == item) { return 1 }
        i = i + 1
    }
    return 0
}

// reads: [[seen], [order]]; capsAdd appends name if new.
func capsAdd(s, name) {
    if (name == "") { return s }
    if (psListHas(s[0], name) == 1) { return s }
    s[0] = appendArray(s[0], name)
    s[1] = appendArray(s[1], name)
    return s
}

func capRemove(s, name) {
    Value out = []
    int i = 0
    while (i < len(s[0])) {
        if (s[0][i] != name) { out = appendArray(out, s[0][i]) }
        i = i + 1
    }
    s[0] = out
    return s
}

func computeCaptures(params, body) {
    Value s = [[], []]
    int i = 0
    while (i < len(body)) {
        s = walkCapturesStmt(s, body[i])
        i = i + 1
    }
    int j = 0
    while (j < len(params)) {
        s = capRemove(s, params[j])
        j = j + 1
    }
    i = 0
    while (i < len(body)) {
        s = markLocalsStmt(s, body[i])
        i = i + 1
    }
    return s[0]
}

func walkCapturesStmt(s, node) {
    if (len(node) < 1) { return s }
    string nt = getNodeType(node)
    if (nt == "Ident") { return capsAdd(s, identName(node)) }
    if (nt == "ExprStmt") { return walkCapturesExpr(s, exprStmtExpr(node)) }
    if (nt == "Return") {
        int rv = returnExpr(node)
        if (len(rv) == 0) { return s }
        return walkCapturesExpr(s, rv)
    }
    if (nt == "Print") { return walkCapturesExpr(s, printExpr(node)) }
    if (nt == "Block") {
        Value inner = blockStmts(node)
        int i = 0
        while (i < len(inner)) {
            s = walkCapturesStmt(s, inner[i])
            i = i + 1
        }
        return s
    }
    if (nt == "If") {
        s = walkCapturesExpr(s, ifCondition(node))
        Value tb = ifThen(node)
        int i = 0
        while (i < len(tb)) {
            s = walkCapturesStmt(s, tb[i])
            i = i + 1
        }
        Value eb = ifElse(node)
        i = 0
        while (i < len(eb)) {
            s = walkCapturesStmt(s, eb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "While") {
        s = walkCapturesExpr(s, whileCondition(node))
        Value wb = whileBody(node)
        int i = 0
        while (i < len(wb)) {
            s = walkCapturesStmt(s, wb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "ForIn") {
        s = walkCapturesExpr(s, forInIter(node))
        s = capsAdd(s, forInVar(node))
        Value fb = forInBody(node)
        int i = 0
        while (i < len(fb)) {
            s = walkCapturesStmt(s, fb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "VarDecl" || nt == "LetDecl" || nt == "ConstDecl") {
        Value nm = varDeclName(node)
        if (nt == "LetDecl") { nm = letDeclName(node) }
        if (nt == "ConstDecl") { nm = constDeclName(node) }
        s = capsAdd(s, nm)
        s = capRemove(s, nm)
        Value val = varDeclValue(node)
        if (nt == "LetDecl") { val = letDeclValue(node) }
        if (nt == "ConstDecl") { val = constDeclValue(node) }
        if (getNodeType(val) == "FuncDecl") {
            Value cc = funcCaptures(val)
            int ci = 0
            while (ci < len(cc)) {
                s = capsAdd(s, cc[ci])
                ci = ci + 1
            }
            return s
        }
        return walkCapturesExpr(s, val)
    }
    if (nt == "FuncDecl") {
        // A let-bound lambda inside another closure: its own captures are
        // references from this body too.
        Value cp = funcCaptures(node)
        int i = 0
        while (i < len(cp)) {
            s = capsAdd(s, cp[i])
            i = i + 1
        }
        return s
    }
    if (nt == "Lambda") {
        Value lp = lambdaParams(node)
        Value lb = lambdaBody(node)
        Value lc = computeCaptures(lp, lb)
        int i = 0
        while (i < len(lc)) {
            s = capsAdd(s, lc[i])
            i = i + 1
        }
        return s
    }
    return walkCapturesExpr(s, node)
}

func walkCapturesExpr(s, node) {
    if (len(node) < 1) { return s }
    string nt = getNodeType(node)
    if (nt == "Ident") { return capsAdd(s, identName(node)) }
    if (nt == "BinaryExpr") {
        s = walkCapturesExpr(s, binaryLeft(node))
        return walkCapturesExpr(s, binaryRight(node))
    }
    if (nt == "UnaryExpr") {
        return walkCapturesExpr(s, unaryOperand(node))
    }
    if (nt == "Call") {
        s = capsAdd(s, callFunc(node))
        int args = callArgs(node)
        int i = 0
        while (i < len(args)) {
            s = walkCapturesExpr(s, args[i])
            i = i + 1
        }
        return s
    }
    // Phase 133: a computed callee may itself close over variables (a cell
    // held in an array or passed as a parameter); an identifier target is a
    // used name exactly like a static callee.
    if (nt == "IndirectCall") {
        int tgt = indirectTarget(node)
        if (getNodeType(tgt) == "Ident") { s = capsAdd(s, identName(tgt)) }
        s = walkCapturesExpr(s, tgt)
        int iargs = indirectArgs(node)
        int i = 0
        while (i < len(iargs)) {
            s = walkCapturesExpr(s, iargs[i])
            i = i + 1
        }
        return s
    }
    if (nt == "Index") {
        s = walkCapturesExpr(s, indexLeft(node))
        return walkCapturesExpr(s, indexExpr(node))
    }
    if (nt == "Slice") {
        s = walkCapturesExpr(s, sliceLeft(node))
        s = walkCapturesExpr(s, sliceStart(node))
        return walkCapturesExpr(s, sliceEnd(node))
    }
    if (nt == "Member") {
        s = walkCapturesExpr(s, memberObject(node))
        return capsAdd(s, memberField(node))
    }
    if (nt == "ArrayLiteral") {
        int elems = arrayElements(node)
        int i = 0
        while (i < len(elems)) {
            s = walkCapturesExpr(s, elems[i])
            i = i + 1
        }
        return s
    }
    if (nt == "MapLiteral") {
        int ks = mapKeys(node)
        int vs = mapValues(node)
        int i = 0
        while (i < len(ks)) {
            s = walkCapturesExpr(s, ks[i])
            s = walkCapturesExpr(s, vs[i])
            i = i + 1
        }
        return s
    }
    if (nt == "Lambda") {
        Value lp = lambdaParams(node)
        Value lb = lambdaBody(node)
        Value lc = computeCaptures(lp, lb)
        int i = 0
        while (i < len(lc)) {
            s = capsAdd(s, lc[i])
            i = i + 1
        }
        return s
    }
    return s
}

func markLocalsStmt(s, node) {
    if (len(node) < 1) { return s }
    string nt = getNodeType(node)
    if (nt == "VarDecl" || nt == "LetDecl" || nt == "ConstDecl") {
        Value nm = varDeclName(node)
        if (nt == "LetDecl") { nm = letDeclName(node) }
        if (nt == "ConstDecl") { nm = constDeclName(node) }
        return capRemove(s, nm)
    }
    if (nt == "Block") {
        Value inner = blockStmts(node)
        int i = 0
        while (i < len(inner)) {
            s = markLocalsStmt(s, inner[i])
            i = i + 1
        }
        return s
    }
    if (nt == "If") {
        Value tb = ifThen(node)
        int i = 0
        while (i < len(tb)) {
            s = markLocalsStmt(s, tb[i])
            i = i + 1
        }
        Value eb = ifElse(node)
        i = 0
        while (i < len(eb)) {
            s = markLocalsStmt(s, eb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "While") {
        Value wb = whileBody(node)
        int i = 0
        while (i < len(wb)) {
            s = markLocalsStmt(s, wb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "ForIn") {
        s = capRemove(s, forInVar(node))
        Value fb = forInBody(node)
        int i = 0
        while (i < len(fb)) {
            s = markLocalsStmt(s, fb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "FuncDecl") {
        Value fb = funcBody(node)
        int i = 0
        while (i < len(fb)) {
            s = markLocalsStmt(s, fb[i])
            i = i + 1
        }
        return s
    }
    return s
}

func hasParserErrors(state) { return len(psErrors(state)) > 0 }

func printParserErrors(state) {
    int errs = psErrors(state)
    int i = 0
    while (i < len(errs)) {
        print(errs[i])
        i = i + 1
    }
}

func psCurKind(state) {
    int pos = psPos(state)
    Value tokens = psTokens(state)
    if (pos >= len(tokens)) { return TK_EOF() }
    return tokenKind(tokens[pos])
}

func psPeekKind(state) {
    int pos = psPos(state) + 1
    Value tokens = psTokens(state)
    if (pos >= len(tokens)) { return TK_EOF() }
    return tokenKind(tokens[pos])
}

// psPeekKind2 returns the token two positions ahead (used to detect `T[]`).
func psPeekKind2(state) {
    int pos = psPos(state) + 2
    Value tokens = psTokens(state)
    if (pos >= len(tokens)) { return TK_EOF() }
    return tokenKind(tokens[pos])
}

func psCurToken(state) {
    int pos = psPos(state)
    Value tokens = psTokens(state)
    if (pos >= len(tokens)) { return [] }
    return tokens[pos]
}

func psPeekToken(state) {
    int pos = psPos(state) + 1
    Value tokens = psTokens(state)
    if (pos >= len(tokens)) { return [] }
    return tokens[pos]
}

func psAdvance(state) {
    int pos = psPos(state)
    Value tokens = psTokens(state)
    if (pos < len(tokens)) {
        Value tok = tokens[pos]
        setPsPos(state, pos + 1)
        if (tokenLine(tok) > 0) { state[4] = tokenLine(tok) }
        return tok
    }
    setPsPos(state, pos + 1)
    return []
}

// Phase 146: non-consuming lookahead deciding whether the token at the cursor
// opens generic type-argument syntax. True only for the exact shape
//   [ IDENT (',' IDENT)* ]  '('  |  '{'
// Scanning runs directly over the token array (no position mutation), so a
// negative result leaves ordinary postfix indexing (s[i], arr[0], m[i][j],
// arr[1:3] slices) untouched for parseBinary's index loop.
func psIsTypeArgName(kind) {
    if (kind == TK_IDENT()) { return 1 }
    if (kind == TK_INT()) { return 1 }
    if (kind == TK_STRING()) { return 1 }
    if (kind == TK_FLOAT64()) { return 1 }
    if (kind == TK_BOOL()) { return 1 }
    return 0
}

func psLooksLikeTypeArgs(state) {
    if (psCurKind(state) != TK_LBRACKET()) { return 0 }
    Value tokens = psTokens(state)
    int base = psPos(state)
    int n = len(tokens)
    int i = base + 1
    if (i >= n) { return 0 }
    if (psIsTypeArgName(tokenKind(tokens[i])) == 0) { return 0 }
    i = i + 1
    while (i < n) {
        int k = tokenKind(tokens[i])
        if (k == TK_COMMA()) {
            i = i + 1
            if (i >= n) { return 0 }
            if (psIsTypeArgName(tokenKind(tokens[i])) == 0) { return 0 }
            i = i + 1
        } else if (k == TK_RBRACKET()) {
            i = i + 1
            if (i >= n) { return 0 }
            int f = tokenKind(tokens[i])
            if (f == TK_LPAREN()) { return 1 }
            if (f == TK_LBRACE()) { return 1 }
            return 0
        } else {
            return 0
        }
    }
    return 0
}

// Phase 146 fix (CI TestPhase117_StdlibBothEngines): reports whether the
// cursor's [name(,name)*] shape is followed by '{' (the struct-literal
// follower). Go guards BOTH the bracket attempt and the brace attempt on
// !unparenthesizedIfCondition (pkg/parser/parser.go:1902,1909) Ã¢â‚¬â€ a trailing
// '{' in a bare if/while/for-in condition opens the body, so `lower[j] {`
// is index-then-body. kcc's struct-literal branch already honors
// psNoStructAtBrace, but the 146C type-args gate did not: it consumed `[j]`
// and the body brace was then refused as a literal, silently dropping the
// index (`str_to_upper` became a no-op, `str_starts_with` always false).
// '('-follow (generic calls) still consumes Ã¢â‚¬â€ mono instantiates those
// exactly as before. Mirrors the tail of psLooksLikeTypeArgs so the two
// scans can never disagree on the shape.
func psTypeArgsFollowIsBrace(state) {
    if (psCurKind(state) != TK_LBRACKET()) { return 0 }
    Value tokens = psTokens(state)
    int base = psPos(state)
    int n = len(tokens)
    int i = base + 1
    if (i >= n) { return 0 }
    if (psIsTypeArgName(tokenKind(tokens[i])) == 0) { return 0 }
    i = i + 1
    while (i < n) {
        int k = tokenKind(tokens[i])
        if (k == TK_COMMA()) {
            i = i + 1
            if (i >= n) { return 0 }
            if (psIsTypeArgName(tokenKind(tokens[i])) == 0) { return 0 }
            i = i + 1
        } else if (k == TK_RBRACKET()) {
            i = i + 1
            if (i >= n) { return 0 }
            if (tokenKind(tokens[i]) == TK_LBRACE()) { return 1 }
            return 0
        } else {
            return 0
        }
    }
    return 0
}

func psAddError(state, msg) {
    int line = psLine(state)
    string errStr = "line " + str(line) + ": " + msg
    state[2] = appendArray(state[2], errStr)
    int col = 0
    int pos = psPos(state)
    Value tokens = psTokens(state)
    if (pos < len(tokens)) { col = tokenCol(tokens[pos]) + 1 }
    state[3] = appendArray(state[3], col)
}

func psExpect(state, kind) {
    let cur = psCurKind(state)
    if (cur != kind) {
        Value tok = psCurToken(state)
        int literal = tokenLiteral(tok, psSource(state))
        psAddError(state, "expected " + tokenKindName(kind) + " but got " + tokenKindName(cur))
        return 0
    }
    psAdvance(state)
    return 1
}

func psCurLiteral(state) {
    Value tok = psCurToken(state)
    return tokenLiteral(tok, psSource(state))
}

// True when the current token is a primitive type keyword or a type name,
// so `func f(x int)` / `func f() int` / `let x int = ...` all parse.
func psIsTypeToken(state) {
    int k = psCurKind(state)
    if (k == TK_INT()) { return 1 }
    if (k == TK_FLOAT64()) { return 1 }
    if (k == TK_STRING()) { return 1 }
    if (k == TK_BOOL()) { return 1 }
    if (k == TK_BYTE() || k == TK_SHORT() || k == TK_LONG()) { return 1 }
    if (k == TK_FLOAT() || k == TK_DOUBLE() || k == TK_CHAR()) { return 1 }
    if (k == TK_VALUE()) { return 1 }
    if (k == TK_IDENT()) { return 1 }
    // Phase 133: `fn` is a keyword token, not an identifier Ã¢â‚¬â€ without this
    // branch a `g fn` / `let g fn` annotation (or `fn` return type) silently
    // misparses instead of skipping cleanly as a type.
    if (k == TK_FN()) { return 1 }
    return 0
}

// ============================================================
// Operator precedence
// ============================================================
//
// Increment 151P0: the bitwise and shift levels were added, matching the C
// table the Go front end uses in pkg/parser/parser.go. A HIGHER number
// binds TIGHTER. From loosest to tightest:
//
//	||  <  &&  <  |  <  ^  <  &  <  comparisons  <  shifts  <  + -  <  * / %
//
// The relative order of the pre-existing operators is unchanged, so
// nothing that parsed before groups differently now.

func kPrec(op) {
    if (op == "||") { return 0 }
    if (op == "&&") { return 1 }
    if (op == "|")  { return 2 }
    if (op == "^")  { return 3 }
    if (op == "&")  { return 4 }
    if (op == "==") { return 5 }
    if (op == "!=") { return 5 }
    if (op == "<")  { return 5 }
    if (op == ">")  { return 5 }
    if (op == "<=") { return 5 }
    if (op == ">=") { return 5 }
    if (op == "<<") { return 6 }
    if (op == ">>") { return 6 }
    if (op == "+")  { return 7 }
    if (op == "-")  { return 7 }
    if (op == "*")  { return 8 }
    if (op == "/")  { return 8 }
    if (op == "%")  { return 8 }
    return -1
}

func isOpToken(kind) {
    if (kind == TK_PLUS())   { return 1 }
    if (kind == TK_MINUS())  { return 1 }
    if (kind == TK_STAR())   { return 1 }
    if (kind == TK_SLASH())  { return 1 }
    if (kind == TK_PERCENT()){ return 1 }
    if (kind == TK_EQ())     { return 1 }
    if (kind == TK_NEQ())    { return 1 }
    if (kind == TK_LT())     { return 1 }
    if (kind == TK_GT())     { return 1 }
    if (kind == TK_LTE())    { return 1 }
    if (kind == TK_GTE())    { return 1 }
    if (kind == TK_AND())    { return 1 }
    if (kind == TK_OR())     { return 1 }
    if (kind == TK_AMP())    { return 1 }
    if (kind == TK_PIPE())   { return 1 }
    if (kind == TK_CARET())  { return 1 }
    if (kind == TK_SHL())    { return 1 }
    if (kind == TK_SHR())    { return 1 }
    return 0
}

func kindToOp(kind) {
    if (kind == TK_PLUS())   { return "+" }
    if (kind == TK_MINUS())  { return "-" }
    if (kind == TK_STAR())   { return "*" }
    if (kind == TK_SLASH())  { return "/" }
    if (kind == TK_PERCENT()){ return "%" }
    if (kind == TK_EQ())     { return "==" }
    if (kind == TK_NEQ())    { return "!=" }
    if (kind == TK_LT())     { return "<" }
    if (kind == TK_GT())     { return ">" }
    if (kind == TK_LTE())    { return "<=" }
    if (kind == TK_GTE())    { return ">=" }
    if (kind == TK_AND())    { return "&&" }
    if (kind == TK_OR())     { return "||" }
    // Increment 151P0: bitwise and shift operators. These are INFIX only.
    if (kind == TK_AMP())    { return "&" }
    if (kind == TK_PIPE())   { return "|" }
    if (kind == TK_CARET())  { return "^" }
    if (kind == TK_SHL())    { return "<<" }
    if (kind == TK_SHR())    { return ">>" }
    return ""
}

// ============================================================
// Main parse function
// ============================================================

func parse(tokens, source) {
    int state = createParserState(tokens, source)
    return parseWithState(state)
}

// parseWithState parses with a caller-owned state so diagnostics survive.
// (parse() above keeps its signature for compatibility, but its internal
// state Ã¢â‚¬â€ and therefore its errors Ã¢â‚¬â€ die with the call. Driver entries in
// main.kark must use parseWithState and then read hasParserErrors on the
// state they passed in; otherwise native parse errors never surface.)
func parseWithState(state) {
    Value stmts = []
    Value imports = []

    while (psCurKind(state) != TK_EOF()) {
        int kind = psCurKind(state)

        // import "C" { ... }
        if (kind == TK_IMPORT()) {
            if (psPeekKind(state) == TK_STRING_LIT()) {
                int content = psCurLiteral(state)
                if (content == "C") {
                    psAdvance(state) // import
                    psAdvance(state) // "C"
                    Value cCode = parseCBlock(state)
                    imports = appendArray(imports, makeCImport(cCode, psLine(state)))
                    continue
                }
            }
            // module import
            if (psPeekKind(state) == TK_IDENT()) {
                psAdvance(state) // import
                int name = psCurLiteral(state)
                psAdvance(state) // name
                imports = appendArray(imports, makeImport(name, psLine(state)))
                continue
            }
            psAddError(state, "expected module name or \"C\" after 'import'")
            psAdvance(state)
            continue
        }

        // public func/type/enum Ã¢â‚¬â€ Phase 103 export modifier.
        if (kind == TK_PUB()) {
            psAdvance(state)
            int pk = psCurKind(state)
            if (pk == TK_FUNC()) {
                Value funcNode = parseFunc(state, "")
                if (funcNode != []) { funcNode = setFuncPublic(funcNode) }
                if (funcNode != []) { stmts = appendArray(stmts, funcNode) }
                continue
            }
            if (pk == TK_TYPE()) {
                Value sd = parseStructDecl(state)
                if (sd != []) { sd = setStructPublic(sd, "1") }
                if (sd != []) { stmts = appendArray(stmts, sd) }
                continue
            }
            if (pk == TK_ENUM()) {
                Value ed = parseEnumDecl(state)
                if (ed != []) { ed = setEnumPublic(ed, "1") }
                if (ed != []) { stmts = appendArray(stmts, ed) }
                continue
            }
            psAddError(state, "unexpected token after 'public' modifier (expected func/type/enum)")
            continue
        }

        // const T name = value (type-first module constant)
        if (kind == TK_CONST()) {
            psAdvance(state)
            string tname = ""
            if (psIsTypeKind(psCurKind(state)) == 1) {
                tname = psTypeKindName(psCurKind(state))
            } else {
                tname = psCurLiteral(state)
            }
            psAdvance(state)
            Value cd = parseTypeFirstConstTail(state, tname, psLine(state))
            if (cd != []) { stmts = appendArray(stmts, cd) }
            if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }
            continue
        }

        // type-first function or module declaration: `int add(...)`, `int x = ...`
        if (psIsTypeKind(kind) == 1 || kind == TK_IDENT()) {
            string tname = ""
            if (psIsTypeKind(kind) == 1) { tname = psTypeKindName(kind) } else { tname = psCurLiteral(state) }
            int dline = psLine(state)
            psAdvance(state)
            while (psCurKind(state) == TK_LBRACKET() && psPeekKind(state) == TK_RBRACKET()) {
                tname = tname + "[]"
                psAdvance(state)
                psAdvance(state)
            }
            if (psCurKind(state) == TK_IDENT() && psPeekKind(state) == TK_LPAREN()) {
                Value tfFunc = parseTypeFirstFunc(state, tname, "")
                if (tfFunc != []) { stmts = appendArray(stmts, tfFunc) }
            } else {
                Value vd = parseTypeFirstTail(state, tname, dline)
                if (vd != []) { stmts = appendArray(stmts, vd) }
            }
            if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }
            continue
        }

        // func name(params) { body }
        if (kind == TK_FUNC()) {
            Value funcNode = parseFunc(state, "")
            if (funcNode != []) { stmts = appendArray(stmts, funcNode) }
            continue
        }

        // @target(ident) func name(params) { body } Ã¢â‚¬â€ Phase 98.
        // The attribute is consumed here so it is never treated as a call
        // expression; the target is attached to the FuncDecl node.
        if (kind == TK_AT()) {
            string tv = parseTargetAttr(state)
            if (tv != "") {
                if (psCurKind(state) != TK_FUNC()) {
                    psAddError(state, "@target(...) must be followed by 'func'")
                    continue
                }
                Value funcNode = parseFunc(state, tv)
                if (funcNode != []) { stmts = appendArray(stmts, funcNode) }
                continue
            }
            // Not a @target attribute Ã¢â‚¬â€ fall through to the expression path.
        }

        // type Name struct { field type, ... }
        if (kind == TK_TYPE()) {
            Value sd = parseStructDecl(state)
            if (sd != []) { stmts = appendArray(stmts, sd) }
            continue
        }

        // enum Name { Variant, Variant(payload), ... }
        if (kind == TK_ENUM()) {
            Value ed = parseEnumDecl(state)
            if (ed != []) { stmts = appendArray(stmts, ed) }
            continue
        }

        // kernel name(params) { body }
        if (kind == TK_KERNEL()) {
            Value k = parseKernel(state)
            if (k != []) { stmts = appendArray(stmts, k) }
            continue
        }

        // Statement-level constructs
        if (kind == TK_LET() || kind == TK_VAR() || kind == TK_CONST()) {
            Value vd = parseVarDecl(state)
            if (vd != []) { stmts = appendArray(stmts, vd) }
            continue
        }

        if (kind == TK_PRINT()) {
            Value pr = parsePrint(state)
            if (pr != []) { stmts = appendArray(stmts, pr) }
            continue
        }

        if (kind == TK_RETURN()) {
            Value ret = parseReturn(state)
            if (ret != []) { stmts = appendArray(stmts, ret) }
            continue
        }

        if (kind == TK_IF()) {
            Value ifStmt = parseIf(state)
            if (ifStmt != []) { stmts = appendArray(stmts, ifStmt) }
            continue
        }

        if (kind == TK_WHILE()) {
            Value wh = parseWhile(state)
            if (wh != []) { stmts = appendArray(stmts, wh) }
            continue
        }

        if (kind == TK_FOR()) {
            Value fr = parseFor(state)
            if (fr != []) { stmts = appendArray(stmts, fr) }
            continue
        }

        if (kind == TK_BREAK()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeBreak(psLine(state)))
            continue
        }

        if (kind == TK_CONTINUE()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeContinue(psLine(state)))
            continue
        }

        // Expression statement
        Value expr = parseExpr(state)
        if (expr != []) {
            stmts = appendArray(stmts, makeExprStmt(expr, psLine(state)))
            continue
        }

        // Unknown token Ã¢â‚¬â€ skip
        psAddError(state, "unexpected token at top level")
        psAdvance(state)
    }

    return makeProgram(stmts, imports)
}

// ============================================================
// Parse C import block: import "C" { ... }
// ============================================================

func parseCBlock(state) {
    // Current token should be '{'
    if (psCurKind(state) != TK_LBRACE()) {
        psAddError(state, "expected '{' for C import block")
        return ""
    }

    // We need the raw source to extract C code between braces.
    // The lexer already consumed the '{', so we scan tokens until matching '}'
    int depth = 1
    int start = psPos(state)
    psAdvance(state) // consume '{'

    while (psCurKind(state) != TK_EOF() && depth > 0) {
        if (psCurKind(state) == TK_LBRACE()) { depth = depth + 1 }
        if (psCurKind(state) == TK_RBRACE()) {
            depth = depth - 1
            if (depth == 0) { break }
        }
        psAdvance(state)
    }

    // For now, return empty string Ã¢â‚¬â€ C block extraction needs source-level access
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return ""
}

// ============================================================
// Parse function declaration
// ============================================================

func parseTargetAttr(state) {
    // Current token is '@'. Parse `@target(<name>)` and return the target
    // name, leaving the parser just before the following 'func' keyword.
    // Returns "" (having consumed the '@') when the syntax does not begin a
    // @target attribute.
    psAdvance(state) // consume '@'
    if (psCurKind(state) != TK_IDENT() || psCurLiteral(state) != "target") {
        return ""
    }
    psAdvance(state) // consume 'target'
    if (psCurKind(state) != TK_LPAREN()) { return "" }
    psAdvance(state) // consume '('
    string tname = ""
    if (psCurKind(state) == TK_IDENT()) {
        tname = psCurLiteral(state)
        psAdvance(state) // consume target name
    }
    if (psCurKind(state) == TK_RPAREN()) {
        psAdvance(state) // consume ')'
        return tname
    }
    return ""
}

// Phase 101 note: funcLine must be the line of the `func` token itself, not the
// last consumed token (psLine), so ancestor frames in runtime stack traces show
// the true definition line and stay in parity with the Go parser, which records
// the function's opening token line. This matters when blank lines separate
// declarations: the previous token's line can be off by the gap count.
func parseFunc(state, target) {
    Value cur = psCurToken(state)
    int line = 0
    if (len(cur) > 0) { line = tokenLine(cur) }
    int startCol = 0
    int pos = psPos(state)
    Value tokens = psTokens(state)
    if (pos < len(tokens)) { startCol = tokenCol(tokens[pos]) }

    psAdvance(state) // consume 'func'

    int name = psCurLiteral(state)
    psAdvance(state) // consume name

    // Phase 146: optional generic parameters [T, U]
    Value genericParams = []
    if (psCurKind(state) == TK_LBRACKET()) {
        genericParams = parseGenericParams(state)
    }

    // Consume '('
    if (psCurKind(state) != TK_LPAREN()) {
        psAddError(state, "expected '(' after function name")
        return []
    }
    psAdvance(state)

    // Parse parameters (both `a int` and `int a` forms).
    Value params = []
    Value ptypes = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT() && (psIsTypeKind(psPeekKind(state)) == 1 || psPeekKind(state) == TK_FN())) {
            // KCC-FIX: `name type` order where the type is a KEYWORD
            // (`n int`, `g fn`). psIsTypeToken() below also accepts TK_IDENT,
            // so it claimed this shape first: it read `n` as the TYPE, left
            // `int` unconsumed, and the loop then emitted a phantom parameter
            // for the keyword -- `func f(n int)` expected TWO arguments and
            // `func apply_twice(g fn, v int)` expected four. The Go reference
            // parser reads a name then an optional annotation, so this arm is
            // parity, not an extension. An `IDENT IDENT` pair (`Value x`,
            // `a Acct`) is deliberately NOT routed here: it is genuinely
            // ambiguous and the type-first arm below keeps its behaviour.
            string pname = psCurLiteral(state)
            psAdvance(state)
            string pty = psCurLiteral(state)
            psAdvance(state)
            params = appendArray(params, pname)
            ptypes = appendArray(ptypes, pty)
        } else if (psIsTypeToken(state)) {
            string pt = psCurLiteral(state)
            psAdvance(state)
            while (psCurKind(state) == TK_LBRACKET() && psPeekKind(state) == TK_RBRACKET()) {
                pt = pt + "[]"
                psAdvance(state)
                psAdvance(state)
            }
            if (psCurKind(state) == TK_IDENT()) {
                params = appendArray(params, psCurLiteral(state))
                ptypes = appendArray(ptypes, pt)
                psAdvance(state)
            } else {
                params = appendArray(params, pt)
                ptypes = appendArray(ptypes, "")
            }
        } else if (psCurKind(state) == TK_IDENT()) {
            string pname = psCurLiteral(state)
            psAdvance(state)
            string pt = ""
            if (psIsTypeToken(state)) { pt = psCurLiteral(state); psAdvance(state) }
            params = appendArray(params, pname)
            ptypes = appendArray(ptypes, pt)
        } else {
            psAdvance(state)
        }
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    // Skip optional return type
    if (psIsTypeToken(state)) { psAdvance(state) }

    // Consume '{'
    if (psCurKind(state) != TK_LBRACE()) {
        psAddError(state, "expected '{' for function body")
        return []
    }
    psAdvance(state)

    Value body = parseBlock(state)

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    Value funcDecl = makeFuncDecl(name, params, body, line, startCol)
    funcDecl = setFuncParamTypes(funcDecl, ptypes)
    if (len(genericParams) > 0) {
        // Store genericParams at index 6
        if (len(funcDecl) <= 6) { funcDecl = appendArray(funcDecl, []) }
        funcDecl[6] = genericParams
    }
    return setFuncTarget(funcDecl, target)
}

// ============================================================
// Parse block (statements until '}')
// ============================================================

func parseBlock(state) {
    Value stmts = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        int before = psPos(state)
        int kind = psCurKind(state)

        if (kind == TK_CONST() && psIsTypeKind(psPeekKind(state)) == 1) {
            int tname = psTypeKindName(psPeekKind(state))
            psAdvance(state) // consume 'const'
            psAdvance(state) // consume type keyword
            Value cd = parseTypeFirstConstTail(state, tname, psLine(state))
            if (cd != []) { stmts = appendArray(stmts, cd) }
        } else if (kind == TK_LET() || kind == TK_VAR() || kind == TK_CONST()) {
            Value vd = parseVarDecl(state)
            if (vd != []) { stmts = appendArray(stmts, vd) }
        } else if (kind == TK_FN() && psPeekKind(state) == TK_IDENT()) {
            // Type-first function-value declaration: `fn name = fn(...) { ... }`.
            // Mirrors the Go parser's TokenFn statement branch: `fn` followed by
            // an identifier is a type-first declaration, while `fn(` in
            // expression position stays a lambda.
            psAdvance(state) // consume 'fn'
            Value vd = parseTypeFirstDecl(state, "fn")
            if (vd != []) { stmts = appendArray(stmts, vd) }
        } else if (psIsTypeKind(kind) == 1) {
            psAdvance(state) // consume the type keyword
            Value vd = parseTypeFirstDecl(state, psTypeKindName(kind))
            if (vd != []) { stmts = appendArray(stmts, vd) }
        } else if (kind == TK_IDENT() && psCurLiteral(state) == "map" && psPeekKind(state) == TK_LBRACKET()) {
            psAdvance(state) // consume 'map'
            int tname = psParseMapTypeSpec(state)
            Value vd = parseTypeFirstDecl(state, tname)
            if (vd != []) { stmts = appendArray(stmts, vd) }
        } else if (kind == TK_IDENT() && psPeekKind(state) == TK_LBRACKET() && psPeekKind2(state) == TK_RBRACKET()) {
            // Identifier-typed array declaration: `T[] xs = [...]`.
            int tname = psCurLiteral(state)
            psAdvance(state)
            while (psCurKind(state) == TK_LBRACKET() && psPeekKind(state) == TK_RBRACKET()) {
                tname = tname + "[]"
                psAdvance(state)
                psAdvance(state)
            }
            Value vd = parseTypeFirstTail(state, tname, psLine(state))
            if (vd != []) { stmts = appendArray(stmts, vd) }
        } else if (kind == TK_IDENT() && psPeekKind(state) == TK_IDENT()) {
            int tname = psCurLiteral(state)
            psAdvance(state)
            Value vd = parseTypeFirstDecl(state, tname)
            if (vd != []) { stmts = appendArray(stmts, vd) }
        } else if (kind == TK_PRINT()) {
            Value pr = parsePrint(state)
            if (pr != []) { stmts = appendArray(stmts, pr) }
        } else if (kind == TK_RETURN()) {
            Value ret = parseReturn(state)
            if (ret != []) { stmts = appendArray(stmts, ret) }
        } else if (kind == TK_IF()) {
            Value ifStmt = parseIf(state)
            if (ifStmt != []) { stmts = appendArray(stmts, ifStmt) }
        } else if (kind == TK_WHILE()) {
            Value wh = parseWhile(state)
            if (wh != []) { stmts = appendArray(stmts, wh) }
        } else if (kind == TK_FOR()) {
            Value fr = parseFor(state)
            if (fr != []) { stmts = appendArray(stmts, fr) }
        } else if (kind == TK_BREAK()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeBreak(psLine(state)))
        } else if (kind == TK_CONTINUE()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeContinue(psLine(state)))
        } else if (kind == TK_LBRACE()) {
            // Nested block
            psAdvance(state)
            Value inner = parseBlock(state)
            if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
            stmts = appendArray(stmts, makeBlock(inner))
        } else {
            Value expr = parseExpr(state)
            if (expr != []) {
                stmts = appendArray(stmts, makeExprStmt(expr, psLine(state)))
            } else {
                // Stall protection
                if (psPos(state) == before) { psAdvance(state) }
            }
        }
        // Stall protection
        if (psPos(state) == before && psCurKind(state) != TK_EOF()) {
            psAdvance(state)
        }
    }
    return stmts
}

// ============================================================
// Parse variable declaration: let name = value or let name: type = value
// ============================================================

// Type-first declarations: `int x = 42`, `int[] xs = [1,2]`.
func psIsTypeKind(k) {
    if (k == TK_INT()) { return 1 }
    if (k == TK_BOOL()) { return 1 }
    if (k == TK_FLOAT64()) { return 1 }
    if (k == TK_STRING()) { return 1 }
    if (k == TK_BYTE()) { return 1 }
    if (k == TK_SHORT()) { return 1 }
    if (k == TK_LONG()) { return 1 }
    if (k == TK_FLOAT()) { return 1 }
    if (k == TK_DOUBLE()) { return 1 }
    if (k == TK_CHAR()) { return 1 }
    if (k == TK_VALUE()) { return 1 }
    return 0
}

func psTypeKindName(k) {
    if (k == TK_INT()) { return "int" }
    if (k == TK_BOOL()) { return "bool" }
    if (k == TK_FLOAT64()) { return "float64" }
    if (k == TK_STRING()) { return "string" }
    if (k == TK_BYTE()) { return "byte" }
    if (k == TK_SHORT()) { return "short" }
    if (k == TK_LONG()) { return "long" }
    if (k == TK_FLOAT()) { return "float" }
    if (k == TK_DOUBLE()) { return "double" }
    if (k == TK_CHAR()) { return "char" }
    if (k == TK_VALUE()) { return "Value" }
    return ""
}

// parseTypeFirstTail consumes the name and initializer after a type spec.
func parseTypeFirstTail(state, typeName, line) {
    string t = typeName
    while (psCurKind(state) == TK_LBRACKET() && psPeekKind(state) == TK_RBRACKET()) {
        t = t + "[]"
        psAdvance(state)
        psAdvance(state)
    }
    if (psCurKind(state) != TK_IDENT() && psCurKind(state) != TK_MATRIX()) {
        psAddError(state, "expected variable name after type '" + t + "'")
        return []
    }
    int name = psCurLiteral(state)
    psAdvance(state)
    if (psCurKind(state) != TK_ASSIGN()) {
        psAddError(state, "expected '=' after type-first declaration")
        return []
    }
    psAdvance(state)
    Value value = parseExpr(state)
    return makeVarDecl(name, value, t, line)
}

func parseTypeFirstFunc(state, retType, target) {
    Value cur = psCurToken(state)
    int line = 0
    if (len(cur) > 0) { line = tokenLine(cur) }
    Value tokens = psTokens(state)
    int startCol = 0
    if (psPos(state) < len(tokens)) { startCol = tokenCol(tokens[psPos(state)]) }
    if (psCurKind(state) != TK_IDENT()) {
        psAddError(state, "expected function name after return type")
        return []
    }
    int name = psCurLiteral(state)
    psAdvance(state)

    if (psCurKind(state) != TK_LPAREN()) {
        psAddError(state, "expected '(' after function name")
        return []
    }
    psAdvance(state)
    Value params = []
    Value ptypes = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psIsTypeToken(state)) {
            string pt = psCurLiteral(state)
            psAdvance(state)
            while (psCurKind(state) == TK_LBRACKET() && psPeekKind(state) == TK_RBRACKET()) {
                pt = pt + "[]"
                psAdvance(state)
                psAdvance(state)
            }
            if (psCurKind(state) == TK_IDENT()) {
                params = appendArray(params, psCurLiteral(state))
                ptypes = appendArray(ptypes, pt)
                psAdvance(state)
            } else {
                params = appendArray(params, pt)
                ptypes = appendArray(ptypes, "")
            }
        } else if (psCurKind(state) == TK_IDENT()) {
            string pname = psCurLiteral(state)
            psAdvance(state)
            string pt = ""
            if (psIsTypeToken(state)) { pt = psCurLiteral(state); psAdvance(state) }
            params = appendArray(params, pname)
            ptypes = appendArray(ptypes, pt)
        } else {
            psAdvance(state)
        }
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    if (psIsTypeToken(state)) { psAdvance(state) }
    if (psCurKind(state) != TK_LBRACE()) {
        psAddError(state, "expected '{' for function body")
        return []
    }
    psAdvance(state)
    Value body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    Value funcDecl = makeFuncDecl(name, params, body, line, startCol)
    funcDecl = setTfFuncReturnType(funcDecl, retType)
    funcDecl = setFuncParamTypes(funcDecl, ptypes)

    if (target != "") { funcDecl = setFuncTarget(funcDecl, target) }
    return funcDecl
}

func parseTypeFirstDecl(state, typeName) {
    int line = psLine(state)
    return parseTypeFirstTail(state, typeName, line)
}

// psParseMapTypeSpec consumes `map[K]V` after the `map` identifier.
func psParseMapTypeSpec(state) {
    string t = "map"
    if (psCurKind(state) != TK_LBRACKET()) { return t }
    psAdvance(state) // '['
    int key = psCurLiteral(state)
    psAdvance(state)
    if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
    int val = psCurLiteral(state)
    if (psCurKind(state) != TK_EOF()) { psAdvance(state) }
    return t + "[" + key + "]" + val
}

func parseTypeFirstConstTail(state, typeName, line) {
    string t = typeName
    while (psCurKind(state) == TK_LBRACKET() && psPeekKind(state) == TK_RBRACKET()) {
        t = t + "[]"
        psAdvance(state)
        psAdvance(state)
    }
    if (psCurKind(state) != TK_IDENT()) {
        psAddError(state, "expected constant name after type '" + t + "'")
        return []
    }
    int name = psCurLiteral(state)
    psAdvance(state)
    if (psCurKind(state) != TK_ASSIGN()) {
        psAddError(state, "expected '=' after typed constant")
        return []
    }
    psAdvance(state)
    Value value = parseExpr(state)
    return makeConstDecl(name, value, t, line)
}

func parseVarDecl(state) {
    int line = psLine(state)
    int isLet = 1
    if (psCurKind(state) == TK_VAR()) { isLet = 0 }
    int isConst = 0
    if (psCurKind(state) == TK_CONST()) { isConst = 1 }
    psAdvance(state) // consume let/var/const

    int name = psCurLiteral(state)
    psAdvance(state) // consume name

    // Optional type annotation: name type or name: type
    string typeName = ""
    if (psCurKind(state) == TK_COLON()) {
        psAdvance(state) // consume ':'
        typeName = psCurLiteral(state)
        psAdvance(state) // consume type
    } else if (psIsTypeToken(state)) {
        typeName = psCurLiteral(state)
        psAdvance(state) // consume type
    }
    // Explicit array annotation: `int[]`, `string[]`, ...
    while (psCurKind(state) == TK_LBRACKET() && psPeekKind(state) == TK_RBRACKET()) {
        typeName = typeName + "[]"
        psAdvance(state)
        psAdvance(state)
    }

    // Consume '='
    if (psCurKind(state) == TK_ASSIGN()) {
        psAdvance(state)
    }

    Value value = []
    int isFn = 0
    if (psCurKind(state) == TK_FN()) {
        // Phase 121: let x = fn(a, b) { ... } desugars to a named FuncDecl so
        // the closure is emitted as a top-level C function (mirrors the Go
        // parser). The binding's own name is never a capture Ã¢â‚¬â€ recursive calls
        // inside the body route to the top-level C symbol.
        isFn = 1
        Value lambda = parseLambda(state)
        Value caps = computeCaptures(lambdaParams(lambda), lambdaBody(lambda))
        caps = capRemove([caps, caps], name)[0]
        value = setFuncCaptures(makeFuncDecl(name, lambdaParams(lambda), lambdaBody(lambda), line, 0), caps)
    } else {
        value = parseExpr(state)
    }
    if (isConst == 1) { return makeConstDecl(name, value, typeName, line) }
    if (isLet == 1) { return makeLetDecl(name, value, typeName, line) }
    return makeVarDecl(name, value, typeName, line)
}

// ============================================================
// Phase 121: lambda expressions Ã¢â‚¬â€ fn(a, b) { return a + b }
// ============================================================

func parseLambda(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'fn'
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
    Value params = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT()) {
            params = appendArray(params, psCurLiteral(state))
            psAdvance(state)
            if (psIsTypeToken(state)) { psAdvance(state) }
        } else {
            psAdvance(state)
        }
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    // Phase 81 (lambda): an optional single return-type annotation may follow
    // the parameter list (e.g. `fn(a, b) int { ... }`). Consume it so the
    // brace that opens the body is properly aligned on both engines.
    if (psIsTypeToken(state)) { psAdvance(state) }
    Value body = []
    if (psCurKind(state) == TK_LBRACE()) {
        psAdvance(state)
        body = parseBlock(state)
        if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    }
    return makeLambda(params, body, line, psNextLambdaSeq(state))
}

// ============================================================
// Phase 121: alloc(T, n) builds a managed array of n zero slots;
// free(x) is a runtime-managed no-op. Mirrors the Go parser.
// ============================================================

func parseAlloc(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'alloc'
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
    int tname = psCurLiteral(state)
    psAdvance(state) // consume type name
    if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    Value count = parseExpr(state)
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    return makeAlloc(tname, count, line)
}

func parseFree(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'free'
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
    Value ptr = parseExpr(state)
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    return makeFree(ptr, line)
}

// Phase 137: spawn(fn, args...) Ã¢â‚¬â€ mirrors Go parseSpawn exactly
// (unconditional consumes; a non-identifier target is a recorded error
// with recovery past the offending token).
func parseSpawnExpr(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'spawn'
    psAdvance(state) // consume '('
    string fname = ""
    if (psCurKind(state) == TK_IDENT()) {
        fname = psCurLiteral(state)
        psAdvance(state) // consume function name
    } else {
        psAddError(state, "expected function name in spawn(...)")
        psAdvance(state) // recover past the offending token
    }
    Value args = []
    if (psCurKind(state) == TK_COMMA()) {
        psAdvance(state) // consume ','
        while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
            Value arg = parseExpr(state)
            if (arg != []) { args = appendArray(args, arg) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    return makeSpawn(fname, args, line)
}

// Phase 137: receive(ch) Ã¢â‚¬â€ mirrors Go parseReceiveChannel/ChRecvExpr
// (unconditional consumes).
func parseChRecv(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'receive'
    psAdvance(state) // consume '('
    Value ch = parseExpr(state)
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    return makeChRecv(ch, line)
}

// Phase 137: keyword-headed calls (channel(...), actor(...)) lower to
// plain call nodes with the keyword as callee, exactly like the Go front
// end. Arity and existence resolve at check time.
func parseKeywordCall(state, name) {
    int line = psLine(state)
    psAdvance(state) // consume keyword
    if (psCurKind(state) != TK_LPAREN()) {
        psAddError(state, "expected '(' after '" + name + "'")
        return []
    }
    psAdvance(state) // consume '('
    Value args = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        Value arg = parseExpr(state)
        if (arg != []) { args = appendArray(args, arg) }
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    return makeCall(name, args, line, 0)
}

// ============================================================
// Parse print statement
// ============================================================

func parsePrint(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'print'

    // Optional '('
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    Value val = parseExpr(state)

    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    return makePrint(val, line)
}

// ============================================================
// Parse return statement
// ============================================================

func parseReturn(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'return'

    Value val = parseExpr(state)
    return makeReturn(val, line)
}

// ============================================================
// Parse if statement
// ============================================================

func parseIf(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'if'

    // Phase 81: unparenthesized conditions Ã¢â‚¬â€ `if x < y { ... }`. An identifier
    // directly before the body opener must stay a plain operand rather than
    // being consumed as a `Type{...}` struct literal. The flag is cleared
    // inside '(' groups so parenthesized struct literals keep working.
    setPsNoStructAtBrace(state, 1)
    Value cond = parseExpr(state)
    setPsNoStructAtBrace(state, 0)

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    Value cons = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    Value alt = []
    if (psCurKind(state) == TK_ELSE()) {
        psAdvance(state) // consume 'else'
        if (psCurKind(state) == TK_IF()) {
            Value elseIf = parseIf(state)
            alt = appendArray(alt, elseIf)
        } else {
            if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
            alt = parseBlock(state)
            if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        }
    }

    return makeIf(cond, cons, alt, line)
}

// ============================================================
// Parse while statement
// ============================================================

func parseWhile(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'while'

    // Phase 117: mirror parseIf Ã¢â‚¬â€ the condition may be parenthesized or bare
    // (`while x < n { ... }`), and a soon-to-be body '{' must not be absorbed
    // as a struct/map literal continuation of the condition expression. The
    // flag is cleared inside '(' groups so parenthesized struct literals keep
    // working, exactly as in parseIf.
    setPsNoStructAtBrace(state, 1)
    Value cond = parseExpr(state)
    setPsNoStructAtBrace(state, 0)

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    Value body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeWhile(cond, body, line)
}

// ============================================================
// Parse for statement (C-style and for-in)
// ============================================================

func parseFor(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'for'

    // for-in: for x in expr { ... }
    if (psCurKind(state) == TK_IDENT() && psPeekKind(state) == TK_IN()) {
        int varName = psCurLiteral(state)
        psAdvance(state) // var
        psAdvance(state) // in
        // Keep the upcoming body '{' from being absorbed as a struct or map
        // literal continuation of the iterator expression.
        int saved = psNoStructAtBrace(state)
        setPsNoStructAtBrace(state, 1)
        Value iter = parseExpr(state)
        setPsNoStructAtBrace(state, saved)
        if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
        Value body = parseBlock(state)
        if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        return makeForIn(varName, iter, body, line)
    }

    // C-style: for (init; cond; post) { ... }
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    Value init = []
    if (psCurKind(state) != TK_SEMICOLON()) {
        if (psCurKind(state) == TK_LET() || psCurKind(state) == TK_VAR() || psCurKind(state) == TK_CONST()) {
            init = parseVarDecl(state)
        } else {
            init = parseExpr(state)
        }
    }
    if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }

    Value cond = parseExpr(state)
    if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }

    Value post = []
    if (psCurKind(state) != TK_RPAREN()) {
        post = parseExpr(state)
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    Value body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeFor(init, cond, post, body, line)
}

// ============================================================
// Phase 146: Parse generic parameters [T, U] with optional constraints T: Numeric
// ============================================================
func parseGenericParams(state) {
    Value params = []
    psAdvance(state) // consume '['
    while (psCurKind(state) != TK_RBRACKET() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT()) {
            int name = psCurLiteral(state)
            psAdvance(state)
            // Optional constraint: T: Numeric
            if (psCurKind(state) == TK_COLON()) {
                psAdvance(state) // consume ':'
                if (psCurKind(state) == TK_IDENT()) {
                    int constraint = psCurLiteral(state)
                    psAdvance(state)
                    name = name + ":" + constraint
                }
            }
            params = appendArray(params, name)
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        } else {
            psAdvance(state)
        }
    }
    if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
    return params
}

// ============================================================
// Parse struct declaration: type Name struct { field type, ... }
// ============================================================

func parseStructDecl(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'type'

    int name = psCurLiteral(state)
    psAdvance(state) // consume name

    // Phase 146: optional generic parameters [T, U]
    Value genericParams = []
    if (psCurKind(state) == TK_LBRACKET()) {
        genericParams = parseGenericParams(state)
    }

    if (psCurKind(state) == TK_STRUCT()) { psAdvance(state) }
    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }

    Value fields = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        int fieldName = psCurLiteral(state)
        psAdvance(state)
        int fieldType = psCurLiteral(state)
        psAdvance(state)
        fields = appendArray(fields, fieldName + ":" + fieldType)
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    Value st = makeStructDecl(name, fields, line)
    if (len(genericParams) > 0) {
        if (len(st) <= 4) { st = appendArray(st, []) }
        st[4] = genericParams
    }
    return st
}

// ============================================================
// Parse enum declaration: enum Name { Variant, Variant(type), ... }
// ============================================================

func parseEnumDecl(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'enum'

    int name = psCurLiteral(state)
    psAdvance(state) // consume name
    psAddEnumName(state, name) // Phase 123: enable EnumName.Variant syntax

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }

    Value variants = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        int variantName = psCurLiteral(state)
        psAdvance(state)
        string payload = ""
        if (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state)
            payload = psCurLiteral(state)
            psAdvance(state)
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        }
        variants = appendArray(variants, variantName + ":" + payload)
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeEnumDecl(name, variants, line)
}

// ============================================================
// Parse kernel declaration: kernel name(params) { body }
// ============================================================

func parseKernel(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'kernel'

    int name = psCurLiteral(state)
    psAdvance(state)

    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    Value params = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT()) {
            params = appendArray(params, psCurLiteral(state))
            psAdvance(state)
            if (psCurKind(state) == TK_COLON()) { psAdvance(state) }
            if (psIsTypeToken(state)) { psAdvance(state) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        } else {
            psAdvance(state)
        }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    Value body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeKernel(name, params, body, line)
}

// ============================================================
// Expression parsing Ã¢â‚¬â€ Pratt parser
// ============================================================

func parseExpr(state) {
    return parseBinary(state, [], 0)
}

func parseBinary(state, left, minPrec) {
    if (left == []) {
        left = parseUnary(state)
    }

    while (1) {
        // Postfix: index [expr] or slice [start:end]
        while (psCurKind(state) == TK_LBRACKET()) {
            psAdvance(state) // consume '['
            Value idx = parseExpr(state)
            if (psCurKind(state) == TK_COLON()) {
                psAdvance(state) // consume ':'
                Value end = []
                if (psCurKind(state) != TK_RBRACKET()) {
                    end = parseExpr(state)
                }
                if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
                left = makeSlice(left, idx, end, psLine(state))
            } else {
                if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
                left = makeIndex(left, idx, psLine(state))
            }
        }

        // Phase 133: postfix call `target(args)` where target is any
        // non-identifier expression (index results, parenthesized
        // expressions, ...). Identifier callees never reach here: the
        // ident/dot/keyword paths consume their own '(' and return a Call
        // early, so static dispatch is fully preserved. Only computed
        // callees lower to IndirectCall (runtime dispatch through a
        // TYPE_FUNC Value cell). Chains (`get_fn()(1)`) loop.
        while (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state) // consume '('
            int callLine = psLine(state)
            Value args = []
            while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
                Value arg = parseExpr(state)
                if (arg != []) { args = appendArray(args, arg) }
                if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
            }
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            left = makeIndirectCall(left, args, callLine)
        }

        // Postfix: .field
        while (psCurKind(state) == TK_DOT()) {
            psAdvance(state) // consume '.'
            int field = psCurLiteral(state)
            psAdvance(state)
            left = makeDot(left, field, psLine(state))
        }

        // Postfix: ?
        if (psCurKind(state) == TK_QUESTION()) {
            psAdvance(state)
            left = makeUnary("?", left, psLine(state))
        }

        // Assignment: lhs = rhs (simple, index, or dot target)
        if (psCurKind(state) == TK_ASSIGN()) {
            psAdvance(state) // consume '='
            Value rhs = parseExpr(state)
            left = makeBinary("=", left, rhs, psLine(state))
            break
        }

        // Binary operator
        int kind = psCurKind(state)
        if (!isOpToken(kind)) { break }

        int op = kindToOp(kind)
        int prec = kPrec(op)
        if (prec < minPrec) { break }

        psAdvance(state) // consume operator
        Value right = parseBinary(state, [], prec + 1)
        left = makeBinary(op, left, right, psLine(state))
    }

    return left
}

func parseUnary(state) {
    if (psCurKind(state) == TK_MINUS()) {
        psAdvance(state)
        Value operand = parseUnary(state)
        return makeUnary("-", operand, psLine(state))
    }
    if (psCurKind(state) == TK_NOT()) {
        psAdvance(state)
        Value operand = parseUnary(state)
        return makeUnary("!", operand, psLine(state))
    }
    return parsePrimary(state)
}

// ============================================================
// Parse primary expressions
// ============================================================

func parsePrimary(state) {
    int kind = psCurKind(state)
    int line = psLine(state)

    // Character literal -> integer code point.
    if (kind == TK_CHAR_LIT()) {
        int lit = psCurLiteral(state)
        int code = 0
        if (len(lit) > 1 && substr(lit, 0, 1) == "\\") {
            string e = substr(lit, 1, 1)
            if (e == "n") { code = 10 }
            if (e == "t") { code = 9 }
            if (e == "r") { code = 13 }
            if (e == "0") { code = 0 }
            if (e == "\\") { code = 92 }
            if (e == "'") { code = 39 }
            if (code == 0 && e != "0") { code = asciiVal(e) }
        } else if (len(lit) > 0) {
            code = asciiVal(substr(lit, 0, 1))
        }
        psAdvance(state)
        return makeIntLit(str(code), line)
    }

    // String literal
    if (kind == TK_STRING_LIT()) {
        int val = psCurLiteral(state)
        psAdvance(state)
        return makeStringLit(val, line)
    }

    // Integer literal
    if (kind == TK_INT_LIT()) {
        int val = psCurLiteral(state)
        psAdvance(state)
        return makeIntLit(val, line)
    }

    // Float literal
    if (kind == TK_FLOAT_LIT()) {
        int val = psCurLiteral(state)
        psAdvance(state)
        return makeFloatLit(val, line)
    }

    // Boolean literals
    if (kind == TK_TRUE()) {
        psAdvance(state)
        return makeBoolLit("true", line)
    }
    if (kind == TK_FALSE()) {
        psAdvance(state)
        return makeBoolLit("false", line)
    }

    // Parenthesized expression
    if (kind == TK_LPAREN()) {
        psAdvance(state)
        int saved = psNoStructAtBrace(state)
        setPsNoStructAtBrace(state, 0)
        Value expr = parseExpr(state)
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        setPsNoStructAtBrace(state, saved)
        return expr
    }

    // Array literal
    if (kind == TK_LBRACKET()) {
        return parseArrayLit(state)
    }

    // Map literal: { key: value, ... }
    if (kind == TK_LBRACE()) {
        return parseMapLit(state)
    }

    // Identifier or function call or struct literal (`matrix` is a keyword
    // token but is also a legal variable name in type-first declarations).
    if (kind == TK_IDENT() || kind == TK_MATRIX()) {
        return parseIdentOrCall(state)
    }

    // Phase 121: lambda expressions are full primary values.
    if (kind == TK_FN()) {
        return parseLambda(state)
    }

    // Phase 42 / LH-1: Result/Option constructors in EXPRESSION position.
    // These tokens were previously recognised only as match-arm patterns
    // (parseMatchExpr), so in expression position the token was consumed and
    // the constructor dropped, leaving only the parenthesised payload. The
    // payload is a full expression, so it is parsed with parseExpr -- not by
    // taking a bare literal token -- which is what keeps `Ok(n * 2)` working.
    if (kind == TK_OK()) {
        psAdvance(state)
        if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
        Value v = parseExpr(state)
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        return makeResultOk(v, line)
    }
    if (kind == TK_ERR()) {
        psAdvance(state)
        if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
        Value v = parseExpr(state)
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        return makeResultErr(v, line)
    }
    if (kind == TK_SOME()) {
        psAdvance(state)
        if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
        Value v = parseExpr(state)
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        return makeOptionSome(v, line)
    }
    if (kind == TK_NONE()) {
        psAdvance(state)
        return makeOptionNone(line)
    }

    // Phase 121: alloc(T, n) / free(x) in expression position.
    if (kind == TK_ALLOC()) {
        return parseAlloc(state)
    }
    if (kind == TK_FREE()) {
        return parseFree(state)
    }

    // Phase 137: spawn(fn, args...) in expression position (mirrors Go
    // parseSpawn: a function name followed by the argument list).
    if (kind == TK_SPAWN()) {
        return parseSpawnExpr(state)
    }

    // Phase 137: receive(ch) in expression position (mirrors Go ChRecvExpr).
    if (kind == TK_RECEIVE()) {
        return parseChRecv(state)
    }

    // Phase 137: channel(...) / actor(...) in expression position lower to
    // plain calls (mirrors the Go front end); the concurrency builtins
    // resolve them at check/codegen time.
    if (kind == TK_CHANNEL()) {
        return parseKeywordCall(state, "channel")
    }
    if (kind == TK_ACTOR()) {
        return parseKeywordCall(state, "actor")
    }

    // Phase 137: `send` is operator-only (`ch <- msg`, like the Go front
    // end which rejects the call form with K001). Reject loudly instead
    // of dropping the expression.
    if (kind == TK_SEND()) {
        psAddError(state, "unexpected token 'send' (send is an operator: channel <- message)")
        return []
    }

    // Match expression
    if (kind == TK_MATCH()) {
        return parseMatchExpr(state)
    }

    // Builtin cast call: int(x). The int type keyword is also a cast name;
    // the Go lexer emits an ident for it, so calls parse there and not here.
    if (kind == TK_INT()) {
        int tname = psCurLiteral(state)
        int tline = psLine(state)
        psAdvance(state)
        if (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state)
            Value targs = []
            while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
                Value targ = parseExpr(state)
                if (targ != []) { targs = appendArray(targs, targ) }
                if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
            }
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            return makeCall(tname, targs, tline, 0)
        }
        return []
    }

    return []
}

// ============================================================
// Parse identifier, function call, dot access, or struct literal
// ============================================================

func parseIdentOrCall(state) {
    int name = psCurLiteral(state)
    int line = psLine(state)
    int col = 0
    int pos = psPos(state)
    Value tokens = psTokens(state)
    if (pos < len(tokens)) { col = tokenCol(tokens[pos]) }

    psAdvance(state) // consume identifier

    // Phase 146: optional type arguments [T, U] for generic calls or struct
    // literals. Gate on the full shape [IDENT(,IDENT)*] followed by '(' or '{'
    // so ordinary postfix indexing (s[i], arr[0], m[i][j], slices) is never
    // consumed here Ã¢â‚¬â€ a pure lookahead over the token array, parsing only
    // proceeds via the shape check. Phase 146 fix: when psNoStructAtBrace is
    // set (bare if/while condition, for-in iterator) and the follower is '{',
    // the bracket is an index and the brace opens the body (Go parity:
    // pkg/parser/parser.go:1902) Ã¢â‚¬â€ leave '[' for parseBinary's postfix index
    // loop instead of consuming it as type args.
    Value typeArgs = []
    if (psCurKind(state) == TK_LBRACKET() && psLooksLikeTypeArgs(state) == 1) {
        if (psNoStructAtBrace(state) == 0 || psTypeArgsFollowIsBrace(state) == 0) {
            typeArgs = parseGenericTypeArgs(state)
        }
    }

    // Function call: name[typeArgs](args)
    if (psCurKind(state) == TK_LPAREN()) {
        psAdvance(state) // consume '('
        Value args = []
        while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
            Value arg = parseExpr(state)
            if (arg != []) { args = appendArray(args, arg) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        }
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        Value call = makeCall(name, args, line, col)
        if (len(typeArgs) > 0) { call[5] = typeArgs }
        return call
    }

    // Dot access: name.field, name.field(args), or EnumName.Variant[(payload)]
    if (psCurKind(state) == TK_DOT()) {
        psAdvance(state) // consume '.'
        int field = psCurLiteral(state)
        psAdvance(state)

        // Enum variant: EnumName.Variant or EnumName.Variant(payload).
        // Phase 123: mirrors pkg/parser/parser.go which produces
        // EnumVariantExpr gated on p.enumNames. Must precede the method-call
        // and member-access paths so enum construction never lowers to
        // map_get (member access on an int tag).
        if (isEnumName(state, name)) {
            Value payload = []
            if (psCurKind(state) == TK_LPAREN()) {
                psAdvance(state) // consume '('
                payload = parseExpr(state)
                if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            }
            return makeEnumVariantExpr(name, field, payload, line)
        }

        // Method call: name.method(args)
        if (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state) // consume '('
            Value args = []
            while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
                Value arg = parseExpr(state)
                if (arg != []) { args = appendArray(args, arg) }
                if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
            }
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            // Phase 103: emit the bare right-hand name so module-qualified
            // calls (math.twice(21)) and record-idiom receiver calls
            // (acc.deposit(10)) lower onto the flat user-function namespace.
            // C.* keeps its dotted name for raw C binds.
            let callName = field
            if (name == "C") { callName = "C." + field }
            Value call = makeCall(callName, args, line, col)
            if (len(typeArgs) > 0) { call[5] = typeArgs }
            return call
        }

        return makeDot(makeIdent(name, line, col), field, line)
    }

    // Struct literal: TypeName[typeArgs] { field: val, ... }
    if (psCurKind(state) == TK_LBRACE() && psNoStructAtBrace(state) == 0) {
        psAdvance(state) // consume '{'
        Value fields = []
        while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
            int fieldName = psCurLiteral(state)
            psAdvance(state)
            if (psCurKind(state) == TK_COLON()) { psAdvance(state) }
            Value val = parseExpr(state)
            fields = appendArray(fields, makeBinary("=", makeIdent(fieldName, 0, 0), val, 0))
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        }
        if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        Value lit = makeStructLit(name, fields, line)
        if (len(typeArgs) > 0) { lit[4] = typeArgs }
        return lit
    }

    // Simple identifier
    return makeIdent(name, line, col)
}

// Phase 146: parse generic type arguments [T, U] at expression position
func parseGenericTypeArgs(state) {
    Value args = []
    psAdvance(state) // consume '['
    while (psCurKind(state) != TK_RBRACKET() && psCurKind(state) != TK_EOF()) {
        if (psIsTypeArgName(psCurKind(state)) == 1) {
            args = appendArray(args, psCurLiteral(state))
            psAdvance(state)
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        } else {
            psAddError(state, "expected type argument in generic type argument list")
            psAdvance(state)
        }
    }
    if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
    return args
}

// ============================================================
// Parse array literal: [expr, expr, ...]
// ============================================================

func parseArrayLit(state) {
    int line = psLine(state)
    psAdvance(state) // consume '['

    Value elements = []
    if (psCurKind(state) != TK_RBRACKET()) {
        Value elem = parseExpr(state)
        if (elem != []) { elements = appendArray(elements, elem) }
        while (psCurKind(state) == TK_COMMA()) {
            psAdvance(state)
            elem = parseExpr(state)
            if (elem != []) { elements = appendArray(elements, elem) }
        }
    }

    if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
    return makeArrayLit(elements, line)
}

// ============================================================
// Parse map literal: { key: value, ... }
// ============================================================

func parseMapLit(state) {
    int line = psLine(state)
    psAdvance(state) // consume '{'

    Value keys = []
    Value values = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        Value k = parseExpr(state)
        if (psCurKind(state) == TK_COLON()) { psAdvance(state) }
        Value v = parseExpr(state)
        if (k != []) { keys = appendArray(keys, k) }
        if (v != []) { values = appendArray(values, v) }
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeMapLit(keys, values, line)
}

// ============================================================
// Parse match expression: match value { pattern => body, ... }
// Mirrors Go pkg/parser.parseMatchExpr (Phase 42).
// ============================================================

func parseMatchExpr(state) {
    int line = psLine(state)
    psAdvance(state) // consume 'match'

    // Parse the match value without going through parseIdentOrCall, so an
    // identifier is not mistaken for a struct literal at the arm opener '{'.
    Value value = []
    int vk = psCurKind(state)
    if (vk == TK_IDENT()) {
        value = makeIdent(psCurLiteral(state), psLine(state), 0)
        psAdvance(state)
    } else if (vk == TK_INT_LIT() || vk == TK_STRING_LIT() || vk == TK_FLOAT_LIT() || vk == TK_TRUE() || vk == TK_FALSE()) {
        value = parsePrimary(state)
    } else if (vk == TK_LPAREN()) {
        psAdvance(state)
        value = parseExpr(state)
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    } else {
        value = parseExpr(state)
    }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }

    Value arms = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        string pType = ""
        let pBinding = ""
        Value pValue = []
        int pkind = psCurKind(state)

        if (pkind == TK_SOME()) {
            pType = "Some"
            psAdvance(state)
            if (psCurKind(state) == TK_LPAREN()) {
                psAdvance(state)
                pBinding = psCurLiteral(state)
                psAdvance(state)
                if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            }
        } else if (pkind == TK_NONE()) {
            pType = "None"
            psAdvance(state)
        } else if (pkind == TK_OK()) {
            pType = "Ok"
            psAdvance(state)
            if (psCurKind(state) == TK_LPAREN()) {
                psAdvance(state)
                pBinding = psCurLiteral(state)
                psAdvance(state)
                if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            }
        } else if (pkind == TK_ERR()) {
            pType = "Err"
            psAdvance(state)
            if (psCurKind(state) == TK_LPAREN()) {
                psAdvance(state)
                pBinding = psCurLiteral(state)
                psAdvance(state)
                if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            }
        } else if (pkind == TK_INT_LIT() || pkind == TK_STRING_LIT() || pkind == TK_FLOAT_LIT() || pkind == TK_TRUE() || pkind == TK_FALSE()) {
            pType = "literal"
            pValue = parsePrimary(state)
        } else if (pkind == TK_IDENT()) {
            int nm = psCurLiteral(state)
            psAdvance(state) // consume identifier
            // Phase 123: Enum.Variant pattern Ã¢â‚¬â€ matches Go parseMatchExpr which
            // treats ANY dotted identifier arm as enum_variant (no enumNames
            // gate here; the tag lookup in codegen falls back to always-match
            // for unknown enums).
            if (psCurKind(state) == TK_DOT()) {
                psAdvance(state) // consume '.'
                int variant2 = psCurLiteral(state)
                psAdvance(state) // consume variant name
                pType = "enum_variant"
                pBinding = nm + "." + variant2
            } else if (nm == "_") {
                pType = "wildcard"
            } else {
                pType = "binding"
                pBinding = nm
            }
        } else {
            // Unknown pattern token: skip it so the loop cannot stall.
            psAdvance(state)
        }

        // Phase 123: mirror Go parseMatchExpr Ã¢â‚¬â€ after any pattern the next
        // token MUST be '=>' (payload destructuring `Enum.Variant(x)` is not
        // part of the language; Go rejects it with an error). On mismatch add
        // the same diagnostic and still advance so the loop cannot stall.
        if (psCurKind(state) == TK_FAT_ARROW()) {
            psAdvance(state)
        } else {
            psAddError(state, "expected '=>' in match arm, got '" + psCurLiteral(state) + "'")
            psAdvance(state)
        }

        // Body: block, print statement, or a bare expression.
        Value body = []
        int bk = psCurKind(state)
        if (bk == TK_LBRACE()) {
            psAdvance(state)
            Value inner = parseBlock(state)
            if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
            body = makeBlock(inner)
        } else if (bk == TK_PRINT()) {
            body = parsePrint(state)
        } else {
            Value bexpr = parseExpr(state)
            if (bexpr != []) { body = makeExprStmt(bexpr, psLine(state)) }
        }

        arms = appendArray(arms, makeMatchArm(pType, pBinding, pValue, body, psLine(state)))

        // Phase 123: comma is OPTIONAL between arms Ã¢â‚¬â€ mirror Go parseMatchExpr
        // which consumes an optional comma and then lets the loop parse the
        // next arm naturally. Previously this blindly advanced one token on a
        // non-comma (mis-parsing every arm after the first in comma-less
        // matches such as `Color.Red => 100` newline `Color.Green => 200`).
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeMatch(value, arms, line)
}


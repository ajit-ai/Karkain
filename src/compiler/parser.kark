// ============================================================
// Self-hosted Karkain Parser — Production version
// Rewritten from pkg/parser/parser.go (2088 lines Go) to pure Karkain
// Uses lexer.kark for tokenization and ast.kark for node types
// ============================================================

// ============================================================
// Parser state: [tokens, pos, errors, errorCols, line, source]
// source is kept for zero-copy token literal extraction.
// ============================================================

func createParserState(tokens, source) {
    let state = []
    state = appendArray(state, tokens)
    state = appendArray(state, 0)
    state = appendArray(state, [])   // errors
    state = appendArray(state, [])   // errorCols
    state = appendArray(state, 1)    // line
    state = appendArray(state, source)
    state = appendArray(state, 0)    // noStructAtBrace (Phase 81: unparenthesized if condition)
    state = appendArray(state, [])   // enumNames (Phase 123: enum variant patterns/construction)
    return state
}

func psNoStructAtBrace(state) { return state[6] }
func setPsNoStructAtBrace(state, v) { state[6] = v }

// ============================================================
// Phase 123: parser-level enum registry. Enum names are recorded at
// parseEnumDecl so that EnumName.Variant expressions and match arms lower to
// EnumVariantExpr / enum_variant patterns (mirroring the Go parser's
// p.enumNames map). Declarations precede use, matching the Go front end.
// ============================================================

func psEnumNames(state) { return state[7] }
func setPsEnumNames(state, v) { state[7] = v }
func psAddEnumName(state, name) {
    let names = psEnumNames(state)
    names = appendArray(names, name)
    setPsEnumNames(state, names)
}
func isEnumName(state, name) { return psListHas(psEnumNames(state), name) }

func psTokens(state)    { return state[0] }
func psPos(state)       { return state[1] }
func psErrors(state)    { return state[2] }
func psErrorCols(state) { return state[3] }
func psLine(state)      { return state[4] }
func psSource(state)    { return state[5] }
func setPsPos(state, v)  { state[1] = v }

// ============================================================
// Phase 121: free-variable capture analysis for lambdas (mirrors
// pkg/parser/captures.go). computeCaptures returns the ordered,
// deduplicated identifiers referenced in the body that are neither
// parameters nor locally declared inside it.
// ============================================================

func psListHas(list, item) {
    let i = 0
    while (i < len(list)) {
        if (list[i] == item) { return 1 }
        i = i + 1
    }
    return 0
}

// reads: [[seen], [order]]; capsAdd appends name if new.
func capsAdd(s, name) {
    if (name == "") { return s }
    if (psListHas(s[0], name) == 1) { return s }
    s[0] = appendArray(s[0], name)
    s[1] = appendArray(s[1], name)
    return s
}

func capRemove(s, name) {
    let out = []
    let i = 0
    while (i < len(s[0])) {
        if (s[0][i] != name) { out = appendArray(out, s[0][i]) }
        i = i + 1
    }
    s[0] = out
    return s
}

func computeCaptures(params, body) {
    let s = [[], []]
    let i = 0
    while (i < len(body)) {
        s = walkCapturesStmt(s, body[i])
        i = i + 1
    }
    let j = 0
    while (j < len(params)) {
        s = capRemove(s, params[j])
        j = j + 1
    }
    i = 0
    while (i < len(body)) {
        s = markLocalsStmt(s, body[i])
        i = i + 1
    }
    return s[0]
}

func walkCapturesStmt(s, node) {
    if (len(node) < 1) { return s }
    let nt = getNodeType(node)
    if (nt == "Ident") { return capsAdd(s, identName(node)) }
    if (nt == "ExprStmt") { return walkCapturesExpr(s, exprStmtExpr(node)) }
    if (nt == "Return") {
        let rv = returnExpr(node)
        if (len(rv) == 0) { return s }
        return walkCapturesExpr(s, rv)
    }
    if (nt == "Print") { return walkCapturesExpr(s, printExpr(node)) }
    if (nt == "Block") {
        let inner = blockStmts(node)
        let i = 0
        while (i < len(inner)) {
            s = walkCapturesStmt(s, inner[i])
            i = i + 1
        }
        return s
    }
    if (nt == "If") {
        s = walkCapturesExpr(s, ifCondition(node))
        let tb = ifThen(node)
        let i = 0
        while (i < len(tb)) {
            s = walkCapturesStmt(s, tb[i])
            i = i + 1
        }
        let eb = ifElse(node)
        i = 0
        while (i < len(eb)) {
            s = walkCapturesStmt(s, eb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "While") {
        s = walkCapturesExpr(s, whileCondition(node))
        let wb = whileBody(node)
        let i = 0
        while (i < len(wb)) {
            s = walkCapturesStmt(s, wb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "ForIn") {
        s = walkCapturesExpr(s, forInIter(node))
        s = capsAdd(s, forInVar(node))
        let fb = forInBody(node)
        let i = 0
        while (i < len(fb)) {
            s = walkCapturesStmt(s, fb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "VarDecl" || nt == "LetDecl" || nt == "ConstDecl") {
        let nm = varDeclName(node)
        if (nt == "LetDecl") { nm = letDeclName(node) }
        if (nt == "ConstDecl") { nm = constDeclName(node) }
        s = capsAdd(s, nm)
        s = capRemove(s, nm)
        let val = varDeclValue(node)
        if (nt == "LetDecl") { val = letDeclValue(node) }
        if (nt == "ConstDecl") { val = constDeclValue(node) }
        if (getNodeType(val) == "FuncDecl") {
            let cc = funcCaptures(val)
            let ci = 0
            while (ci < len(cc)) {
                s = capsAdd(s, cc[ci])
                ci = ci + 1
            }
            return s
        }
        return walkCapturesExpr(s, val)
    }
    if (nt == "FuncDecl") {
        // A let-bound lambda inside another closure: its own captures are
        // references from this body too.
        let cp = funcCaptures(node)
        let i = 0
        while (i < len(cp)) {
            s = capsAdd(s, cp[i])
            i = i + 1
        }
        return s
    }
    if (nt == "Lambda") {
        let lp = lambdaParams(node)
        let lb = lambdaBody(node)
        let lc = computeCaptures(lp, lb)
        let i = 0
        while (i < len(lc)) {
            s = capsAdd(s, lc[i])
            i = i + 1
        }
        return s
    }
    return walkCapturesExpr(s, node)
}

func walkCapturesExpr(s, node) {
    if (len(node) < 1) { return s }
    let nt = getNodeType(node)
    if (nt == "Ident") { return capsAdd(s, identName(node)) }
    if (nt == "BinaryExpr") {
        s = walkCapturesExpr(s, binaryLeft(node))
        return walkCapturesExpr(s, binaryRight(node))
    }
    if (nt == "UnaryExpr") {
        return walkCapturesExpr(s, unaryOperand(node))
    }
    if (nt == "Call") {
        s = capsAdd(s, callFunc(node))
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            s = walkCapturesExpr(s, args[i])
            i = i + 1
        }
        return s
    }
    if (nt == "Index") {
        s = walkCapturesExpr(s, indexLeft(node))
        return walkCapturesExpr(s, indexExpr(node))
    }
    if (nt == "Slice") {
        s = walkCapturesExpr(s, sliceLeft(node))
        s = walkCapturesExpr(s, sliceStart(node))
        return walkCapturesExpr(s, sliceEnd(node))
    }
    if (nt == "Member") {
        s = walkCapturesExpr(s, memberObject(node))
        return capsAdd(s, memberField(node))
    }
    if (nt == "ArrayLiteral") {
        let elems = arrayElements(node)
        let i = 0
        while (i < len(elems)) {
            s = walkCapturesExpr(s, elems[i])
            i = i + 1
        }
        return s
    }
    if (nt == "MapLiteral") {
        let ks = mapKeys(node)
        let vs = mapValues(node)
        let i = 0
        while (i < len(ks)) {
            s = walkCapturesExpr(s, ks[i])
            s = walkCapturesExpr(s, vs[i])
            i = i + 1
        }
        return s
    }
    if (nt == "Lambda") {
        let lp = lambdaParams(node)
        let lb = lambdaBody(node)
        let lc = computeCaptures(lp, lb)
        let i = 0
        while (i < len(lc)) {
            s = capsAdd(s, lc[i])
            i = i + 1
        }
        return s
    }
    return s
}

func markLocalsStmt(s, node) {
    if (len(node) < 1) { return s }
    let nt = getNodeType(node)
    if (nt == "VarDecl" || nt == "LetDecl" || nt == "ConstDecl") {
        let nm = varDeclName(node)
        if (nt == "LetDecl") { nm = letDeclName(node) }
        if (nt == "ConstDecl") { nm = constDeclName(node) }
        return capRemove(s, nm)
    }
    if (nt == "Block") {
        let inner = blockStmts(node)
        let i = 0
        while (i < len(inner)) {
            s = markLocalsStmt(s, inner[i])
            i = i + 1
        }
        return s
    }
    if (nt == "If") {
        let tb = ifThen(node)
        let i = 0
        while (i < len(tb)) {
            s = markLocalsStmt(s, tb[i])
            i = i + 1
        }
        let eb = ifElse(node)
        i = 0
        while (i < len(eb)) {
            s = markLocalsStmt(s, eb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "While") {
        let wb = whileBody(node)
        let i = 0
        while (i < len(wb)) {
            s = markLocalsStmt(s, wb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "ForIn") {
        s = capRemove(s, forInVar(node))
        let fb = forInBody(node)
        let i = 0
        while (i < len(fb)) {
            s = markLocalsStmt(s, fb[i])
            i = i + 1
        }
        return s
    }
    if (nt == "FuncDecl") {
        let fb = funcBody(node)
        let i = 0
        while (i < len(fb)) {
            s = markLocalsStmt(s, fb[i])
            i = i + 1
        }
        return s
    }
    return s
}

func hasParserErrors(state) { return len(psErrors(state)) > 0 }

func printParserErrors(state) {
    let errs = psErrors(state)
    let i = 0
    while (i < len(errs)) {
        print(errs[i])
        i = i + 1
    }
}

func psCurKind(state) {
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos >= len(tokens)) { return TK_EOF() }
    return tokenKind(tokens[pos])
}

func psPeekKind(state) {
    let pos = psPos(state) + 1
    let tokens = psTokens(state)
    if (pos >= len(tokens)) { return TK_EOF() }
    return tokenKind(tokens[pos])
}

func psCurToken(state) {
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos >= len(tokens)) { return [] }
    return tokens[pos]
}

func psPeekToken(state) {
    let pos = psPos(state) + 1
    let tokens = psTokens(state)
    if (pos >= len(tokens)) { return [] }
    return tokens[pos]
}

func psAdvance(state) {
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos < len(tokens)) {
        let tok = tokens[pos]
        setPsPos(state, pos + 1)
        if (tokenLine(tok) > 0) { state[4] = tokenLine(tok) }
        return tok
    }
    setPsPos(state, pos + 1)
    return []
}

func psAddError(state, msg) {
    let line = psLine(state)
    let errStr = "line " + str(line) + ": " + msg
    state[2] = appendArray(state[2], errStr)
    let col = 0
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos < len(tokens)) { col = tokenCol(tokens[pos]) + 1 }
    state[3] = appendArray(state[3], col)
}

func psExpect(state, kind) {
    let cur = psCurKind(state)
    if (cur != kind) {
        let tok = psCurToken(state)
        let literal = tokenLiteral(tok, psSource(state))
        psAddError(state, "expected " + tokenKindName(kind) + " but got " + tokenKindName(cur))
        return 0
    }
    psAdvance(state)
    return 1
}

func psCurLiteral(state) {
    let tok = psCurToken(state)
    return tokenLiteral(tok, psSource(state))
}

// True when the current token is a primitive type keyword or a type name,
// so `func f(x int)` / `func f() int` / `let x int = ...` all parse.
func psIsTypeToken(state) {
    let k = psCurKind(state)
    if (k == TK_INT()) { return 1 }
    if (k == TK_FLOAT64()) { return 1 }
    if (k == TK_STRING()) { return 1 }
    if (k == TK_BOOL()) { return 1 }
    if (k == TK_IDENT()) { return 1 }
    return 0
}

// ============================================================
// Operator precedence
// ============================================================

func kPrec(op) {
    if (op == "||") { return 0 }
    if (op == "&&") { return 1 }
    if (op == "==") { return 2 }
    if (op == "!=") { return 2 }
    if (op == "<")  { return 2 }
    if (op == ">")  { return 2 }
    if (op == "<=") { return 2 }
    if (op == ">=") { return 2 }
    if (op == "+")  { return 3 }
    if (op == "-")  { return 3 }
    if (op == "*")  { return 4 }
    if (op == "/")  { return 4 }
    if (op == "%")  { return 4 }
    return -1
}

func isOpToken(kind) {
    if (kind == TK_PLUS())   { return 1 }
    if (kind == TK_MINUS())  { return 1 }
    if (kind == TK_STAR())   { return 1 }
    if (kind == TK_SLASH())  { return 1 }
    if (kind == TK_PERCENT()){ return 1 }
    if (kind == TK_EQ())     { return 1 }
    if (kind == TK_NEQ())    { return 1 }
    if (kind == TK_LT())     { return 1 }
    if (kind == TK_GT())     { return 1 }
    if (kind == TK_LTE())    { return 1 }
    if (kind == TK_GTE())    { return 1 }
    if (kind == TK_AND())    { return 1 }
    if (kind == TK_OR())     { return 1 }
    return 0
}

func kindToOp(kind) {
    if (kind == TK_PLUS())   { return "+" }
    if (kind == TK_MINUS())  { return "-" }
    if (kind == TK_STAR())   { return "*" }
    if (kind == TK_SLASH())  { return "/" }
    if (kind == TK_PERCENT()){ return "%" }
    if (kind == TK_EQ())     { return "==" }
    if (kind == TK_NEQ())    { return "!=" }
    if (kind == TK_LT())     { return "<" }
    if (kind == TK_GT())     { return ">" }
    if (kind == TK_LTE())    { return "<=" }
    if (kind == TK_GTE())    { return ">=" }
    if (kind == TK_AND())    { return "&&" }
    if (kind == TK_OR())     { return "||" }
    return ""
}

// ============================================================
// Main parse function
// ============================================================

func parse(tokens, source) {
    let state = createParserState(tokens, source)
    let stmts = []
    let imports = []

    while (psCurKind(state) != TK_EOF()) {
        let kind = psCurKind(state)

        // import "C" { ... }
        if (kind == TK_IMPORT()) {
            if (psPeekKind(state) == TK_STRING_LIT()) {
                let content = psCurLiteral(state)
                if (content == "C") {
                    psAdvance(state) // import
                    psAdvance(state) // "C"
                    let cCode = parseCBlock(state)
                    imports = appendArray(imports, makeCImport(cCode, psLine(state)))
                    continue
                }
            }
            // module import
            if (psPeekKind(state) == TK_IDENT()) {
                psAdvance(state) // import
                let name = psCurLiteral(state)
                psAdvance(state) // name
                imports = appendArray(imports, makeImport(name, psLine(state)))
                continue
            }
            psAddError(state, "expected module name or \"C\" after 'import'")
            psAdvance(state)
            continue
        }

        // public func/type/enum — Phase 103 export modifier.
        if (kind == TK_PUB()) {
            psAdvance(state)
            let pk = psCurKind(state)
            if (pk == TK_FUNC()) {
                let funcNode = parseFunc(state, "")
                if (funcNode != []) { funcNode = setFuncPublic(funcNode) }
                if (funcNode != []) { stmts = appendArray(stmts, funcNode) }
                continue
            }
            if (pk == TK_TYPE()) {
                let sd = parseStructDecl(state)
                if (sd != []) { sd = setStructPublic(sd, "1") }
                if (sd != []) { stmts = appendArray(stmts, sd) }
                continue
            }
            if (pk == TK_ENUM()) {
                let ed = parseEnumDecl(state)
                if (ed != []) { ed = setEnumPublic(ed, "1") }
                if (ed != []) { stmts = appendArray(stmts, ed) }
                continue
            }
            psAddError(state, "unexpected token after 'public' modifier (expected func/type/enum)")
            continue
        }

        // func name(params) { body }
        if (kind == TK_FUNC()) {
            let funcNode = parseFunc(state, "")
            if (funcNode != []) { stmts = appendArray(stmts, funcNode) }
            continue
        }

        // @target(ident) func name(params) { body } — Phase 98.
        // The attribute is consumed here so it is never treated as a call
        // expression; the target is attached to the FuncDecl node.
        if (kind == TK_AT()) {
            let tv = parseTargetAttr(state)
            if (tv != "") {
                if (psCurKind(state) != TK_FUNC()) {
                    psAddError(state, "@target(...) must be followed by 'func'")
                    continue
                }
                let funcNode = parseFunc(state, tv)
                if (funcNode != []) { stmts = appendArray(stmts, funcNode) }
                continue
            }
            // Not a @target attribute — fall through to the expression path.
        }

        // type Name struct { field type, ... }
        if (kind == TK_TYPE()) {
            let sd = parseStructDecl(state)
            if (sd != []) { stmts = appendArray(stmts, sd) }
            continue
        }

        // enum Name { Variant, Variant(payload), ... }
        if (kind == TK_ENUM()) {
            let ed = parseEnumDecl(state)
            if (ed != []) { stmts = appendArray(stmts, ed) }
            continue
        }

        // kernel name(params) { body }
        if (kind == TK_KERNEL()) {
            let k = parseKernel(state)
            if (k != []) { stmts = appendArray(stmts, k) }
            continue
        }

        // Statement-level constructs
        if (kind == TK_LET() || kind == TK_VAR() || kind == TK_CONST()) {
            let vd = parseVarDecl(state)
            if (vd != []) { stmts = appendArray(stmts, vd) }
            continue
        }

        if (kind == TK_PRINT()) {
            let pr = parsePrint(state)
            if (pr != []) { stmts = appendArray(stmts, pr) }
            continue
        }

        if (kind == TK_RETURN()) {
            let ret = parseReturn(state)
            if (ret != []) { stmts = appendArray(stmts, ret) }
            continue
        }

        if (kind == TK_IF()) {
            let ifStmt = parseIf(state)
            if (ifStmt != []) { stmts = appendArray(stmts, ifStmt) }
            continue
        }

        if (kind == TK_WHILE()) {
            let wh = parseWhile(state)
            if (wh != []) { stmts = appendArray(stmts, wh) }
            continue
        }

        if (kind == TK_FOR()) {
            let fr = parseFor(state)
            if (fr != []) { stmts = appendArray(stmts, fr) }
            continue
        }

        if (kind == TK_BREAK()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeBreak(psLine(state)))
            continue
        }

        if (kind == TK_CONTINUE()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeContinue(psLine(state)))
            continue
        }

        // Expression statement
        let expr = parseExpr(state)
        if (expr != []) {
            stmts = appendArray(stmts, makeExprStmt(expr, psLine(state)))
            continue
        }

        // Unknown token — skip
        psAddError(state, "unexpected token at top level")
        psAdvance(state)
    }

    return makeProgram(stmts, imports)
}

// ============================================================
// Parse C import block: import "C" { ... }
// ============================================================

func parseCBlock(state) {
    // Current token should be '{'
    if (psCurKind(state) != TK_LBRACE()) {
        psAddError(state, "expected '{' for C import block")
        return ""
    }

    // We need the raw source to extract C code between braces.
    // The lexer already consumed the '{', so we scan tokens until matching '}'
    let depth = 1
    let start = psPos(state)
    psAdvance(state) // consume '{'

    while (psCurKind(state) != TK_EOF() && depth > 0) {
        if (psCurKind(state) == TK_LBRACE()) { depth = depth + 1 }
        if (psCurKind(state) == TK_RBRACE()) {
            depth = depth - 1
            if (depth == 0) { break }
        }
        psAdvance(state)
    }

    // For now, return empty string — C block extraction needs source-level access
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return ""
}

// ============================================================
// Parse function declaration
// ============================================================

func parseTargetAttr(state) {
    // Current token is '@'. Parse `@target(<name>)` and return the target
    // name, leaving the parser just before the following 'func' keyword.
    // Returns "" (having consumed the '@') when the syntax does not begin a
    // @target attribute.
    psAdvance(state) // consume '@'
    if (psCurKind(state) != TK_IDENT() || psCurLiteral(state) != "target") {
        return ""
    }
    psAdvance(state) // consume 'target'
    if (psCurKind(state) != TK_LPAREN()) { return "" }
    psAdvance(state) // consume '('
    let tname = ""
    if (psCurKind(state) == TK_IDENT()) {
        tname = psCurLiteral(state)
        psAdvance(state) // consume target name
    }
    if (psCurKind(state) == TK_RPAREN()) {
        psAdvance(state) // consume ')'
        return tname
    }
    return ""
}

// Phase 101 note: funcLine must be the line of the `func` token itself, not the
// last consumed token (psLine), so ancestor frames in runtime stack traces show
// the true definition line and stay in parity with the Go parser, which records
// the function's opening token line. This matters when blank lines separate
// declarations: the previous token's line can be off by the gap count.
func parseFunc(state, target) {
    let cur = psCurToken(state)
    let line = 0
    if (len(cur) > 0) { line = tokenLine(cur) }
    let startCol = 0
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos < len(tokens)) { startCol = tokenCol(tokens[pos]) }

    psAdvance(state) // consume 'func'

    let name = psCurLiteral(state)
    psAdvance(state) // consume name

    // Consume '('
    if (psCurKind(state) != TK_LPAREN()) {
        psAddError(state, "expected '(' after function name")
        return []
    }
    psAdvance(state)

    // Parse parameters
    let params = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT()) {
            params = appendArray(params, psCurLiteral(state))
            psAdvance(state)
            // Skip optional type annotation
            if (psIsTypeToken(state)) { psAdvance(state) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        } else {
            psAdvance(state)
        }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    // Skip optional return type
    if (psIsTypeToken(state)) { psAdvance(state) }

    // Consume '{'
    if (psCurKind(state) != TK_LBRACE()) {
        psAddError(state, "expected '{' for function body")
        return []
    }
    psAdvance(state)

    let body = parseBlock(state)

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return setFuncTarget(makeFuncDecl(name, params, body, line, startCol), target)
}

// ============================================================
// Parse block (statements until '}')
// ============================================================

func parseBlock(state) {
    let stmts = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        let before = psPos(state)
        let kind = psCurKind(state)

        if (kind == TK_LET() || kind == TK_VAR() || kind == TK_CONST()) {
            let vd = parseVarDecl(state)
            if (vd != []) { stmts = appendArray(stmts, vd) }
        } else if (kind == TK_PRINT()) {
            let pr = parsePrint(state)
            if (pr != []) { stmts = appendArray(stmts, pr) }
        } else if (kind == TK_RETURN()) {
            let ret = parseReturn(state)
            if (ret != []) { stmts = appendArray(stmts, ret) }
        } else if (kind == TK_IF()) {
            let ifStmt = parseIf(state)
            if (ifStmt != []) { stmts = appendArray(stmts, ifStmt) }
        } else if (kind == TK_WHILE()) {
            let wh = parseWhile(state)
            if (wh != []) { stmts = appendArray(stmts, wh) }
        } else if (kind == TK_FOR()) {
            let fr = parseFor(state)
            if (fr != []) { stmts = appendArray(stmts, fr) }
        } else if (kind == TK_BREAK()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeBreak(psLine(state)))
        } else if (kind == TK_CONTINUE()) {
            psAdvance(state)
            stmts = appendArray(stmts, makeContinue(psLine(state)))
        } else if (kind == TK_LBRACE()) {
            // Nested block
            psAdvance(state)
            let inner = parseBlock(state)
            if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
            stmts = appendArray(stmts, makeBlock(inner))
        } else {
            let expr = parseExpr(state)
            if (expr != []) {
                stmts = appendArray(stmts, makeExprStmt(expr, psLine(state)))
            } else {
                // Stall protection
                if (psPos(state) == before) { psAdvance(state) }
            }
        }
        // Stall protection
        if (psPos(state) == before && psCurKind(state) != TK_EOF()) {
            psAdvance(state)
        }
    }
    return stmts
}

// ============================================================
// Parse variable declaration: let name = value or let name: type = value
// ============================================================

func parseVarDecl(state) {
    let line = psLine(state)
    let isLet = 1
    if (psCurKind(state) == TK_VAR()) { isLet = 0 }
    let isConst = 0
    if (psCurKind(state) == TK_CONST()) { isConst = 1 }
    psAdvance(state) // consume let/var/const

    let name = psCurLiteral(state)
    psAdvance(state) // consume name

    // Optional type annotation: name type or name: type
    let typeName = ""
    if (psCurKind(state) == TK_COLON()) {
        psAdvance(state) // consume ':'
        typeName = psCurLiteral(state)
        psAdvance(state) // consume type
    } else if (psIsTypeToken(state)) {
        typeName = psCurLiteral(state)
        psAdvance(state) // consume type
    }

    // Consume '='
    if (psCurKind(state) == TK_ASSIGN()) {
        psAdvance(state)
    }

    let value = []
    let isFn = 0
    if (psCurKind(state) == TK_FN()) {
        // Phase 121: let x = fn(a, b) { ... } desugars to a named FuncDecl so
        // the closure is emitted as a top-level C function (mirrors the Go
        // parser). The binding's own name is never a capture — recursive calls
        // inside the body route to the top-level C symbol.
        isFn = 1
        let lambda = parseLambda(state)
        let caps = computeCaptures(lambdaParams(lambda), lambdaBody(lambda))
        caps = capRemove([caps, caps], name)[0]
        value = setFuncCaptures(makeFuncDecl(name, lambdaParams(lambda), lambdaBody(lambda), line, 0), caps)
    } else {
        value = parseExpr(state)
    }
    if (isConst == 1) { return makeConstDecl(name, value, typeName, line) }
    if (isLet == 1) { return makeLetDecl(name, value, typeName, line) }
    return makeVarDecl(name, value, typeName, line)
}

// ============================================================
// Phase 121: lambda expressions — fn(a, b) { return a + b }
// ============================================================

func parseLambda(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'fn'
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
    let params = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT()) {
            params = appendArray(params, psCurLiteral(state))
            psAdvance(state)
            if (psIsTypeToken(state)) { psAdvance(state) }
        } else {
            psAdvance(state)
        }
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    // Phase 81 (lambda): an optional single return-type annotation may follow
    // the parameter list (e.g. `fn(a, b) int { ... }`). Consume it so the
    // brace that opens the body is properly aligned on both engines.
    if (psIsTypeToken(state)) { psAdvance(state) }
    let body = []
    if (psCurKind(state) == TK_LBRACE()) {
        psAdvance(state)
        body = parseBlock(state)
        if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    }
    return makeLambda(params, body, line)
}

// ============================================================
// Phase 121: alloc(T, n) builds a managed array of n zero slots;
// free(x) is a runtime-managed no-op. Mirrors the Go parser.
// ============================================================

func parseAlloc(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'alloc'
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
    let tname = psCurLiteral(state)
    psAdvance(state) // consume type name
    if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    let count = parseExpr(state)
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    return makeAlloc(tname, count, line)
}

func parseFree(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'free'
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }
    let ptr = parseExpr(state)
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    return makeFree(ptr, line)
}

// ============================================================
// Parse print statement
// ============================================================

func parsePrint(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'print'

    // Optional '('
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    let val = parseExpr(state)

    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    return makePrint(val, line)
}

// ============================================================
// Parse return statement
// ============================================================

func parseReturn(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'return'

    let val = parseExpr(state)
    return makeReturn(val, line)
}

// ============================================================
// Parse if statement
// ============================================================

func parseIf(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'if'

    // Phase 81: unparenthesized conditions — `if x < y { ... }`. An identifier
    // directly before the body opener must stay a plain operand rather than
    // being consumed as a `Type{...}` struct literal. The flag is cleared
    // inside '(' groups so parenthesized struct literals keep working.
    setPsNoStructAtBrace(state, 1)
    let cond = parseExpr(state)
    setPsNoStructAtBrace(state, 0)

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    let cons = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    let alt = []
    if (psCurKind(state) == TK_ELSE()) {
        psAdvance(state) // consume 'else'
        if (psCurKind(state) == TK_IF()) {
            let elseIf = parseIf(state)
            alt = appendArray(alt, elseIf)
        } else {
            if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
            alt = parseBlock(state)
            if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        }
    }

    return makeIf(cond, cons, alt, line)
}

// ============================================================
// Parse while statement
// ============================================================

func parseWhile(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'while'

    // Phase 117: mirror parseIf — the condition may be parenthesized or bare
    // (`while x < n { ... }`), and a soon-to-be body '{' must not be absorbed
    // as a struct/map literal continuation of the condition expression. The
    // flag is cleared inside '(' groups so parenthesized struct literals keep
    // working, exactly as in parseIf.
    setPsNoStructAtBrace(state, 1)
    let cond = parseExpr(state)
    setPsNoStructAtBrace(state, 0)

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    let body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeWhile(cond, body, line)
}

// ============================================================
// Parse for statement (C-style and for-in)
// ============================================================

func parseFor(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'for'

    // for-in: for x in expr { ... }
    if (psCurKind(state) == TK_IDENT() && psPeekKind(state) == TK_IN()) {
        let varName = psCurLiteral(state)
        psAdvance(state) // var
        psAdvance(state) // in
        // Keep the upcoming body '{' from being absorbed as a struct or map
        // literal continuation of the iterator expression.
        let saved = psNoStructAtBrace(state)
        setPsNoStructAtBrace(state, 1)
        let iter = parseExpr(state)
        setPsNoStructAtBrace(state, saved)
        if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
        let body = parseBlock(state)
        if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        return makeForIn(varName, iter, body, line)
    }

    // C-style: for (init; cond; post) { ... }
    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    let init = []
    if (psCurKind(state) != TK_SEMICOLON()) {
        if (psCurKind(state) == TK_LET() || psCurKind(state) == TK_VAR() || psCurKind(state) == TK_CONST()) {
            init = parseVarDecl(state)
        } else {
            init = parseExpr(state)
        }
    }
    if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }

    let cond = parseExpr(state)
    if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }

    let post = []
    if (psCurKind(state) != TK_RPAREN()) {
        post = parseExpr(state)
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    let body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeFor(init, cond, post, body, line)
}

// ============================================================
// Parse struct declaration: type Name struct { field type, ... }
// ============================================================

func parseStructDecl(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'type'

    let name = psCurLiteral(state)
    psAdvance(state) // consume name

    if (psCurKind(state) == TK_STRUCT()) { psAdvance(state) }
    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }

    let fields = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        let fieldName = psCurLiteral(state)
        psAdvance(state)
        let fieldType = psCurLiteral(state)
        psAdvance(state)
        fields = appendArray(fields, fieldName + ":" + fieldType)
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        if (psCurKind(state) == TK_SEMICOLON()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeStructDecl(name, fields, line)
}

// ============================================================
// Parse enum declaration: enum Name { Variant, Variant(type), ... }
// ============================================================

func parseEnumDecl(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'enum'

    let name = psCurLiteral(state)
    psAdvance(state) // consume name
    psAddEnumName(state, name) // Phase 123: enable EnumName.Variant syntax

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }

    let variants = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        let variantName = psCurLiteral(state)
        psAdvance(state)
        let payload = ""
        if (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state)
            payload = psCurLiteral(state)
            psAdvance(state)
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        }
        variants = appendArray(variants, variantName + ":" + payload)
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeEnumDecl(name, variants, line)
}

// ============================================================
// Parse kernel declaration: kernel name(params) { body }
// ============================================================

func parseKernel(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'kernel'

    let name = psCurLiteral(state)
    psAdvance(state)

    if (psCurKind(state) == TK_LPAREN()) { psAdvance(state) }

    let params = []
    while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
        if (psCurKind(state) == TK_IDENT()) {
            params = appendArray(params, psCurLiteral(state))
            psAdvance(state)
            if (psCurKind(state) == TK_COLON()) { psAdvance(state) }
            if (psIsTypeToken(state)) { psAdvance(state) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        } else {
            psAdvance(state)
        }
    }
    if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }
    let body = parseBlock(state)
    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }

    return makeKernel(name, params, body, line)
}

// ============================================================
// Expression parsing — Pratt parser
// ============================================================

func parseExpr(state) {
    return parseBinary(state, [], 0)
}

func parseBinary(state, left, minPrec) {
    if (left == []) {
        left = parseUnary(state)
    }

    while (1) {
        // Postfix: index [expr] or slice [start:end]
        while (psCurKind(state) == TK_LBRACKET()) {
            psAdvance(state) // consume '['
            let idx = parseExpr(state)
            if (psCurKind(state) == TK_COLON()) {
                psAdvance(state) // consume ':'
                let end = []
                if (psCurKind(state) != TK_RBRACKET()) {
                    end = parseExpr(state)
                }
                if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
                left = makeSlice(left, idx, end, psLine(state))
            } else {
                if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
                left = makeIndex(left, idx, psLine(state))
            }
        }

        // Postfix: .field
        while (psCurKind(state) == TK_DOT()) {
            psAdvance(state) // consume '.'
            let field = psCurLiteral(state)
            psAdvance(state)
            left = makeDot(left, field, psLine(state))
        }

        // Postfix: ?
        if (psCurKind(state) == TK_QUESTION()) {
            psAdvance(state)
            left = makeUnary("?", left, psLine(state))
        }

        // Assignment: lhs = rhs (simple, index, or dot target)
        if (psCurKind(state) == TK_ASSIGN()) {
            psAdvance(state) // consume '='
            let rhs = parseExpr(state)
            left = makeBinary("=", left, rhs, psLine(state))
            break
        }

        // Binary operator
        let kind = psCurKind(state)
        if (!isOpToken(kind)) { break }

        let op = kindToOp(kind)
        let prec = kPrec(op)
        if (prec < minPrec) { break }

        psAdvance(state) // consume operator
        let right = parseBinary(state, [], prec + 1)
        left = makeBinary(op, left, right, psLine(state))
    }

    return left
}

func parseUnary(state) {
    if (psCurKind(state) == TK_MINUS()) {
        psAdvance(state)
        let operand = parseUnary(state)
        return makeUnary("-", operand, psLine(state))
    }
    if (psCurKind(state) == TK_NOT()) {
        psAdvance(state)
        let operand = parseUnary(state)
        return makeUnary("!", operand, psLine(state))
    }
    return parsePrimary(state)
}

// ============================================================
// Parse primary expressions
// ============================================================

func parsePrimary(state) {
    let kind = psCurKind(state)
    let line = psLine(state)

    // String literal
    if (kind == TK_STRING_LIT()) {
        let val = psCurLiteral(state)
        psAdvance(state)
        return makeStringLit(val, line)
    }

    // Integer literal
    if (kind == TK_INT_LIT()) {
        let val = psCurLiteral(state)
        psAdvance(state)
        return makeIntLit(val, line)
    }

    // Float literal
    if (kind == TK_FLOAT_LIT()) {
        let val = psCurLiteral(state)
        psAdvance(state)
        return makeFloatLit(val, line)
    }

    // Boolean literals
    if (kind == TK_TRUE()) {
        psAdvance(state)
        return makeBoolLit("true", line)
    }
    if (kind == TK_FALSE()) {
        psAdvance(state)
        return makeBoolLit("false", line)
    }

    // Parenthesized expression
    if (kind == TK_LPAREN()) {
        psAdvance(state)
        let saved = psNoStructAtBrace(state)
        setPsNoStructAtBrace(state, 0)
        let expr = parseExpr(state)
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        setPsNoStructAtBrace(state, saved)
        return expr
    }

    // Array literal
    if (kind == TK_LBRACKET()) {
        return parseArrayLit(state)
    }

    // Map literal: { key: value, ... }
    if (kind == TK_LBRACE()) {
        return parseMapLit(state)
    }

    // Identifier or function call or struct literal
    if (kind == TK_IDENT()) {
        return parseIdentOrCall(state)
    }

    // Phase 121: lambda expressions are full primary values.
    if (kind == TK_FN()) {
        return parseLambda(state)
    }

    // Phase 121: alloc(T, n) / free(x) in expression position.
    if (kind == TK_ALLOC()) {
        return parseAlloc(state)
    }
    if (kind == TK_FREE()) {
        return parseFree(state)
    }

    // Match expression
    if (kind == TK_MATCH()) {
        return parseMatchExpr(state)
    }

    // Builtin cast call: int(x). The int type keyword is also a cast name;
    // the Go lexer emits an ident for it, so calls parse there and not here.
    if (kind == TK_INT()) {
        let tname = psCurLiteral(state)
        let tline = psLine(state)
        psAdvance(state)
        if (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state)
            let targs = []
            while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
                let targ = parseExpr(state)
                if (targ != []) { targs = appendArray(targs, targ) }
                if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
            }
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            return makeCall(tname, targs, tline, 0)
        }
        return []
    }

    return []
}

// ============================================================
// Parse identifier, function call, dot access, or struct literal
// ============================================================

func parseIdentOrCall(state) {
    let name = psCurLiteral(state)
    let line = psLine(state)
    let col = 0
    let pos = psPos(state)
    let tokens = psTokens(state)
    if (pos < len(tokens)) { col = tokenCol(tokens[pos]) }

    psAdvance(state) // consume identifier

    // Function call: name(args)
    if (psCurKind(state) == TK_LPAREN()) {
        psAdvance(state) // consume '('
        let args = []
        while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
            let arg = parseExpr(state)
            if (arg != []) { args = appendArray(args, arg) }
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        }
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
        return makeCall(name, args, line, col)
    }

    // Dot access: name.field, name.field(args), or EnumName.Variant[(payload)]
    if (psCurKind(state) == TK_DOT()) {
        psAdvance(state) // consume '.'
        let field = psCurLiteral(state)
        psAdvance(state)

        // Enum variant: EnumName.Variant or EnumName.Variant(payload).
        // Phase 123: mirrors pkg/parser/parser.go which produces
        // EnumVariantExpr gated on p.enumNames. Must precede the method-call
        // and member-access paths so enum construction never lowers to
        // map_get (member access on an int tag).
        if (isEnumName(state, name)) {
            let payload = []
            if (psCurKind(state) == TK_LPAREN()) {
                psAdvance(state) // consume '('
                payload = parseExpr(state)
                if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            }
            return makeEnumVariantExpr(name, field, payload, line)
        }

        // Method call: name.method(args)
        if (psCurKind(state) == TK_LPAREN()) {
            psAdvance(state) // consume '('
            let args = []
            while (psCurKind(state) != TK_RPAREN() && psCurKind(state) != TK_EOF()) {
                let arg = parseExpr(state)
                if (arg != []) { args = appendArray(args, arg) }
                if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
            }
            if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            // Phase 103: emit the bare right-hand name so module-qualified
            // calls (math.twice(21)) and record-idiom receiver calls
            // (acc.deposit(10)) lower onto the flat user-function namespace.
            // C.* keeps its dotted name for raw C binds.
            let callName = field
            if (name == "C") { callName = "C." + field }
            return makeCall(callName, args, line, col)
        }

        return makeDot(makeIdent(name, line, col), field, line)
    }

    // Struct literal: TypeName { field: val, ... }
    if (psCurKind(state) == TK_LBRACE() && psNoStructAtBrace(state) == 0) {
        psAdvance(state) // consume '{'
        let fields = []
        while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
            let fieldName = psCurLiteral(state)
            psAdvance(state)
            if (psCurKind(state) == TK_COLON()) { psAdvance(state) }
            let val = parseExpr(state)
            fields = appendArray(fields, makeBinary("=", makeIdent(fieldName, 0, 0), val, 0))
            if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
        }
        if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
        return makeStructLit(name, fields, line)
    }

    // Simple identifier
    return makeIdent(name, line, col)
}

// ============================================================
// Parse array literal: [expr, expr, ...]
// ============================================================

func parseArrayLit(state) {
    let line = psLine(state)
    psAdvance(state) // consume '['

    let elements = []
    if (psCurKind(state) != TK_RBRACKET()) {
        let elem = parseExpr(state)
        if (elem != []) { elements = appendArray(elements, elem) }
        while (psCurKind(state) == TK_COMMA()) {
            psAdvance(state)
            elem = parseExpr(state)
            if (elem != []) { elements = appendArray(elements, elem) }
        }
    }

    if (psCurKind(state) == TK_RBRACKET()) { psAdvance(state) }
    return makeArrayLit(elements, line)
}

// ============================================================
// Parse map literal: { key: value, ... }
// ============================================================

func parseMapLit(state) {
    let line = psLine(state)
    psAdvance(state) // consume '{'

    let keys = []
    let values = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        let k = parseExpr(state)
        if (psCurKind(state) == TK_COLON()) { psAdvance(state) }
        let v = parseExpr(state)
        if (k != []) { keys = appendArray(keys, k) }
        if (v != []) { values = appendArray(values, v) }
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeMapLit(keys, values, line)
}

// ============================================================
// Parse match expression: match value { pattern => body, ... }
// Mirrors Go pkg/parser.parseMatchExpr (Phase 42).
// ============================================================

func parseMatchExpr(state) {
    let line = psLine(state)
    psAdvance(state) // consume 'match'

    // Parse the match value without going through parseIdentOrCall, so an
    // identifier is not mistaken for a struct literal at the arm opener '{'.
    let value = []
    let vk = psCurKind(state)
    if (vk == TK_IDENT()) {
        value = makeIdent(psCurLiteral(state), psLine(state), 0)
        psAdvance(state)
    } else if (vk == TK_INT_LIT() || vk == TK_STRING_LIT() || vk == TK_FLOAT_LIT() || vk == TK_TRUE() || vk == TK_FALSE()) {
        value = parsePrimary(state)
    } else if (vk == TK_LPAREN()) {
        psAdvance(state)
        value = parseExpr(state)
        if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
    } else {
        value = parseExpr(state)
    }

    if (psCurKind(state) == TK_LBRACE()) { psAdvance(state) }

    let arms = []
    while (psCurKind(state) != TK_RBRACE() && psCurKind(state) != TK_EOF()) {
        let pType = ""
        let pBinding = ""
        let pValue = []
        let pkind = psCurKind(state)

        if (pkind == TK_SOME()) {
            pType = "Some"
            psAdvance(state)
            if (psCurKind(state) == TK_LPAREN()) {
                psAdvance(state)
                pBinding = psCurLiteral(state)
                psAdvance(state)
                if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            }
        } else if (pkind == TK_NONE()) {
            pType = "None"
            psAdvance(state)
        } else if (pkind == TK_OK()) {
            pType = "Ok"
            psAdvance(state)
            if (psCurKind(state) == TK_LPAREN()) {
                psAdvance(state)
                pBinding = psCurLiteral(state)
                psAdvance(state)
                if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            }
        } else if (pkind == TK_ERR()) {
            pType = "Err"
            psAdvance(state)
            if (psCurKind(state) == TK_LPAREN()) {
                psAdvance(state)
                pBinding = psCurLiteral(state)
                psAdvance(state)
                if (psCurKind(state) == TK_RPAREN()) { psAdvance(state) }
            }
        } else if (pkind == TK_INT_LIT() || pkind == TK_STRING_LIT() || pkind == TK_FLOAT_LIT() || pkind == TK_TRUE() || pkind == TK_FALSE()) {
            pType = "literal"
            pValue = parsePrimary(state)
        } else if (pkind == TK_IDENT()) {
            let nm = psCurLiteral(state)
            psAdvance(state) // consume identifier
            // Phase 123: Enum.Variant pattern — matches Go parseMatchExpr which
            // treats ANY dotted identifier arm as enum_variant (no enumNames
            // gate here; the tag lookup in codegen falls back to always-match
            // for unknown enums).
            if (psCurKind(state) == TK_DOT()) {
                psAdvance(state) // consume '.'
                let variant2 = psCurLiteral(state)
                psAdvance(state) // consume variant name
                pType = "enum_variant"
                pBinding = nm + "." + variant2
            } else if (nm == "_") {
                pType = "wildcard"
            } else {
                pType = "binding"
                pBinding = nm
            }
        } else {
            // Unknown pattern token: skip it so the loop cannot stall.
            psAdvance(state)
        }

        // Phase 123: mirror Go parseMatchExpr — after any pattern the next
        // token MUST be '=>' (payload destructuring `Enum.Variant(x)` is not
        // part of the language; Go rejects it with an error). On mismatch add
        // the same diagnostic and still advance so the loop cannot stall.
        if (psCurKind(state) == TK_FAT_ARROW()) {
            psAdvance(state)
        } else {
            psAddError(state, "expected '=>' in match arm, got '" + psCurLiteral(state) + "'")
            psAdvance(state)
        }

        // Body: block, print statement, or a bare expression.
        let body = []
        let bk = psCurKind(state)
        if (bk == TK_LBRACE()) {
            psAdvance(state)
            let inner = parseBlock(state)
            if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
            body = makeBlock(inner)
        } else if (bk == TK_PRINT()) {
            body = parsePrint(state)
        } else {
            let bexpr = parseExpr(state)
            if (bexpr != []) { body = makeExprStmt(bexpr, psLine(state)) }
        }

        arms = appendArray(arms, makeMatchArm(pType, pBinding, pValue, body, psLine(state)))

        // Phase 123: comma is OPTIONAL between arms — mirror Go parseMatchExpr
        // which consumes an optional comma and then lets the loop parse the
        // next arm naturally. Previously this blindly advanced one token on a
        // non-comma (mis-parsing every arm after the first in comma-less
        // matches such as `Color.Red => 100` newline `Color.Green => 200`).
        if (psCurKind(state) == TK_COMMA()) { psAdvance(state) }
    }

    if (psCurKind(state) == TK_RBRACE()) { psAdvance(state) }
    return makeMatch(value, arms, line)
}

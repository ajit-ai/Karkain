// ============================================================
// Karkain Standard Library
//
// Pure Karkain utilities layered on the language builtins that the
// runtime preamble already provides (len, str, int, substr, split,
// trim, readFile, writeFile, appendArray, ...).
//
// IMPORTANT design constraints:
//  - Do NOT define names that collide with codegen builtins; a user
//    `func len(...)` would shadow the builtin for the whole compile
//    unit (Phase 83 user-function-first dispatch) and break array
//    lengths, string reads, file I/O, etc.
//  - Do NOT use raw C interop (import "C" / C.k_*): the emitted C
//    passes Karkain Values while kernel.c expects plain C types, so
//    such calls cannot link. All runtime services used here exist as
//    Value-level builtins instead.
// ============================================================

func getArgs() {
    // Placeholder - command-line argument plumbing needs a runtime hook
    return ["karkain"]
}

// ============================================================
// STRING: prefix / suffix / search
// ============================================================

func hasPrefix(s, prefix) {
    let plen = len(prefix)
    if (plen == 0) { return 1 }
    if (len(s) < plen) { return 0 }
    return substr(s, 0, plen) == prefix
}

func hasSuffix(s, suffix) {
    let slen = len(suffix)
    if (slen == 0) { return 1 }
    let sLen = len(s)
    if (sLen < slen) { return 0 }
    return substr(s, sLen - slen, slen) == suffix
}

func indexOf(s, sub) {
    let subLen = len(sub)
    let sLen = len(s)
    if (subLen == 0) { return 0 }
    if (subLen > sLen) { return -1 }
    let i = 0
    while (i <= sLen - subLen) {
        if (substr(s, i, subLen) == sub) { return i }
        i = i + 1
    }
    return -1
}

// ============================================================
// STRING: trimming (builtin trim removes spaces)
// ============================================================

func trimPrefix(s, prefix) {
    let plen = len(prefix)
    if (plen == 0) { return s }
    if (len(s) < plen) { return s }
    if (substr(s, 0, plen) == prefix) {
        return substr(s, plen, len(s) - plen)
    }
    return s
}

func trimSuffix(s, suffix) {
    let slen = len(suffix)
    let sLen = len(s)
    if (slen == 0) { return s }
    if (sLen < slen) { return s }
    if (substr(s, sLen - slen, slen) == suffix) {
        return substr(s, 0, sLen - slen)
    }
    return s
}

// ============================================================
// STRING: assembly and transformation
// ============================================================

func join(parts, sep) {
    let count = len(parts)
    let result = ""
    let i = 0
    while (i < count) {
        if (i > 0) { result = result + sep }
        result = result + parts[i]
        i = i + 1
    }
    return result
}

func repeat(s, n) {
    let result = ""
    let i = 0
    while (i < n) {
        result = result + s
        i = i + 1
    }
    return result
}

func reverse(s) {
    let n = len(s)
    let result = ""
    let i = n - 1
    while (i >= 0) {
        result = result + substr(s, i, 1)
        i = i - 1
    }
    return result
}

func count(s, sub) {
    let subLen = len(sub)
    if (subLen == 0) { return 0 }
    let total = 0
    let pos = indexOf(s, sub)
    while (pos >= 0) {
        total = total + 1
        let rest = substr(s, pos + subLen, len(s) - pos - subLen)
        let npos = indexOf(rest, sub)
        if (npos < 0) { pos = -1 } else {
            pos = pos + subLen + npos
        }
    }
    return total
}

// ============================================================
// STRING: predicates
// ============================================================

func isBlank(s) {
    return len(trim(s)) == 0
}

func isNumeric(s) {
    let digits = "0123456789"
    let n = len(s)
    if (n == 0) { return 0 }
    let i = 0
    while (i < n) {
        let c = substr(s, i, 1)
        if (contains(digits, c) == 0) { return 0 }
        i = i + 1
    }
    return 1
}
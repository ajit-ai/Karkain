// ============================================================
// STRING: toLower
// ============================================================

func toLower(s) {
    return k_str_tolower(s)
}


// ============================================================
// STRING: toUpper
// ============================================================

func toUpper(s) {
    return k_str_toupper(s)
}


// ============================================================
// STRING: replace — Karkain logic
// ============================================================

func replace(s, old, repl, n) {
    return k_str_replace(s, old, repl, n)
}

func replaceAll(s, old, repl) {
    return k_str_replace(s, old, repl, -1)
}


// ============================================================
// STRING: repeat
// ============================================================

func repeat(s, count) {
    return k_str_repeat(s, count)
}


// ============================================================
// STRING: charAt
// ============================================================

func charAt(s, idx) {
    return k_char_at(s, idx)
}


// ============================================================
// STRING: equals
// ============================================================

func equals(a, b) {
    return k_streq(a, b)
}


// ============================================================
// STRING: isEmpty
// ============================================================

func isEmpty(s) {
    return k_strlen(s) == 0
}


// ============================================================
// STRING: reverse — Karkain logic
// ============================================================

func reverseStr(s) {
    let n = k_strlen(s)
    let result = ""
    let i = n - 1
    while (i >= 0) {
        result = k_strcat(result, k_char_at(s, i))
        i = i - 1
    }
    return result
}


// ============================================================
// STRING: substring (alias for k_substr)
// ============================================================

func substr(s, start, length) {
    return k_substr(s, start, length)
}


// ============================================================
// ARRAY: sort — bubble sort in Karkain
// ============================================================

func sort(arr) {
    let n = len(arr)
    let i = 0
    while (i < n - 1) {
        let j = 0
        while (j < n - 1 - i) {
            if (arr[j] > arr[j + 1]) {
                let temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
            j = j + 1
        }
        i = i + 1
    }
    return arr
}


// ============================================================
// ARRAY: reverse — Karkain logic
// ============================================================

func reverse(arr) {
    let n = len(arr)
    let i = 0
    let j = n - 1
    while (i < j) {
        let temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp
        i = i + 1
        j = j - 1
    }
    return arr
}


// ============================================================
// ARRAY: contains — linear search
// ============================================================

func arrayContains(arr, val) {
    let n = len(arr)
    let i = 0
    while (i < n) {
        if (equals(arr[i], val)) { return 1 }
        i = i + 1
    }
    return 0
}


// ============================================================
// ARRAY: indexOf — find index of element
// ============================================================

func arrayIndexOf(arr, val) {
    let n = len(arr)
    let i = 0
    while (i < n) {
        if (equals(arr[i], val)) { return i }
        i = i + 1
    }
    return -1
}


// ============================================================
// ARRAY: appendArray — compiler builtin.
// Calls named appendArray/push are lowered directly by codegen
// to karkain_appendArray (Go front end and self-hosted backend
// alike), so no Karkain-level definition is needed or wanted:
// a wrapper here could never link (there is no raw C append).
// ============================================================


// ============================================================
// MATH: all Karkain names for kernel math
// ============================================================

func abs(x)    { return k_math_abs(x) }
func floor(x)  { return k_math_floor(x) }
func ceil(x)   { return k_math_ceil(x) }
func round(x)  { return k_math_round(x) }
func sqrt(x)   { return k_math_sqrt(x) }
func pow(x, y) { return k_math_pow(x, y) }
func log(x)    { return k_math_log(x) }
func log10(x)  { return k_math_log10(x) }
func sin(x)    { return k_math_sin(x) }
func cos(x)    { return k_math_cos(x) }
func tan(x)    { return k_math_tan(x) }
func pi()      { return k_math_pi() }
func e()       { return k_math_e() }
func mod(x, y) { return k_math_mod(x, y) }


// ============================================================
// MATH: min/max/clamp — Karkain logic
// ============================================================

func min(a, b) { if (a < b) { return a } return b }
func max(a, b) { if (a > b) { return a } return b }

func clamp(val, lo, hi) {
    if (val < lo) { return lo }
    if (val > hi) { return hi }
    return val
}


// ============================================================
// CONVERSION
// ============================================================

func itoa(v) { return k_int_to_str(v) }
func atoi(s) { return k_str_to_int(s) }
func hex(v)  { return k_int_to_hex(v) }
func octal(v) { return k_int_to_octal(v) }
func binary(v) { return k_int_to_binary(v) }


// ============================================================
// FILE I/O — thin wrappers
// ============================================================

func readFile(path) {
    let content = k_file_read_all(path)
    if (content == "") { return "" }
    return content
}

func writeFile(path, content) {
    return k_file_write_path(path, content)
}

func fileExists(path) {
    return k_file_exists(path)
}

func removeFile(path) {
    return k_file_remove(path)
}

func mkdir(path) {
    return k_mkdir(path)
}

func rename(old, new_name) {
    return k_rename_file(old, new_name)
}


// ============================================================
// ENVIRONMENT
// ============================================================

func getenv(key) {
    return k_getenv_raw(key)
}

func setenv(key, val) {
    return k_setenv_raw(key, val)
}

func exit(code) {
    k_exit(code)
}

func getArgs() {
    let argc = k_get_argc()
    let args = []
    let i = 0
    while (i < argc) {
        args = appendArray(args, k_get_argv(i))
        i = i + 1
    }
    return args
}


// ============================================================
// ASSERTIONS — Karkain logic
// ============================================================

func assert(cond) {
    if (!cond) {
        k_print_raw("assertion failed")
        k_exit(1)
    }
}

func assertEq(a, b) {
    if (!equals(a, b)) {
        k_print_raw("assertion failed: values not equal")
        k_exit(1)
    }
}

func assertNe(a, b) {
    if (equals(a, b)) {
        k_print_raw("assertion failed: values are equal")
        k_exit(1)
    }
}

func panic(msg) {
    k_print_raw(msg)
    k_exit(1)
}


// ============================================================
// SYSTEM
// ============================================================

func system(cmd) {
    return 0
}

// ============================================================
// Karkain Standard Library — REAL implementations in Karkain
// Every function here is actual Karkain logic, not C wrappers
// Only uses kernel.c for: strlen, strcmp, substr, charAt, 
//   strcat, strcat3, malloc, free, file I/O, math, system
// ============================================================

import "C" {
    int k_strlen(const char* s);
    int k_strcmp_raw(const char* a, const char* b);
    char* k_substr(const char* s, int start, int length);
    char* k_char_at(const char* s, int idx);
    char* k_strcat(const char* a, const char* b);
    char* k_strcat3(const char* a, const char* b, const char* c);
    int k_streq(const char* a, const char* b);
    int k_str_index(const char* s, const char* sub);
    int k_str_rindex(const char* s, const char* sub);
    int k_str_hasprefix(const char* s, const char* prefix);
    int k_str_hassuffix(const char* s, const char* suffix);
    int k_str_count(const char* s, const char* sub);
    char* k_str_trim(const char* s);
    char* k_str_trimprefix(const char* s, const char* prefix);
    char* k_str_trimsuffix(const char* s, const char* suffix);
    char* k_str_tolower(const char* s);
    char* k_str_toupper(const char* s);
    char* k_str_replace(const char* s, const char* old, const char* repl, int n);
    char* k_str_repeat(const char* s, int n);
    char** k_str_split(const char* s, const char* sep, int* out_count);
    char* k_str_join(char** parts, int count, const char* sep);
    char* k_int_to_str(long long val);
    char* k_int_to_hex(long long val);
    char* k_int_to_octal(long long val);
    char* k_int_to_binary(long long val);
    long long k_str_to_int(const char* s);
    void k_print_raw(const char* s);
    void k_print_noraw(const char* s);
    void k_putchar(int c);
    void* k_file_open(const char* path, const char* mode);
    void k_file_close(void* handle);
    char* k_file_read_all(const char* path, int* out_len);
    char* k_file_readline(void* handle);
    int k_file_write(void* handle, const char* data, int len);
    int k_file_write_path(const char* path, const char* data);
    int k_file_exists(const char* path);
    int k_file_remove(const char* path);
    int k_mkdir(const char* path);
    int k_rename_file(const char* old, const char* new_name);
    char* k_getenv_raw(const char* key);
    int k_setenv_raw(const char* key, const char* val);
    void k_exit(int code);
    double k_math_abs(double x);
    double k_math_floor(double x);
    double k_math_ceil(double x);
    double k_math_round(double x);
    double k_math_sqrt(double x);
    double k_math_pow(double x, double y);
    double k_math_log(double x);
    double k_math_log10(double x);
    double k_math_sin(double x);
    double k_math_cos(double x);
    double k_math_tan(double x);
    double k_math_mod(double x, double y);
    double k_math_pi(void);
    double k_math_e(void);
    int k_get_argc(void);
    const char* k_get_argv(int idx);
    void* k_alloc(int size);
    void k_free(void* ptr);
}


// ============================================================
// CORE: len, str, int, print
// ============================================================

func len(v) {
    return k_strlen(v)
}

func str(v) {
    return k_int_to_str(v)
}

func int(v) {
    return k_str_to_int(v)
}

func print(v) {
    k_print_raw(v)
}

func println(v) {
    k_print_raw(v)
}


// ============================================================
// STRING: contains — Karkain logic, no C
// ============================================================

func contains(s, sub) {
    let subLen = k_strlen(sub)
    let sLen = k_strlen(s)
    if (subLen == 0) { return 1 }
    if (subLen > sLen) { return 0 }
    let i = 0
    while (i <= sLen - subLen) {
        let found = 1
        let j = 0
        while (j < subLen) {
            let sc = k_char_at(s, i + j)
            let subc = k_char_at(sub, j)
            if (k_strcmp_raw(sc, subc) != 0) {
                found = 0
                break
            }
            j = j + 1
        }
        if (found == 1) { return 1 }
        i = i + 1
    }
    return 0
}


// ============================================================
// STRING: hasPrefix
// ============================================================

func hasPrefix(s, prefix) {
    return k_str_hasprefix(s, prefix)
}


// ============================================================
// STRING: hasSuffix
// ============================================================

func hasSuffix(s, suffix) {
    return k_str_hassuffix(s, suffix)
}


// ============================================================
// STRING: indexOf — find first occurrence
// ============================================================

func indexOf(s, sub) {
    return k_str_index(s, sub)
}


// ============================================================
// STRING: lastIndexOf
// ============================================================

func lastIndexOf(s, sub) {
    return k_str_rindex(s, sub)
}


// ============================================================
// STRING: count occurrences
// ============================================================

func count(s, sub) {
    return k_str_count(s, sub)
}


// ============================================================
// STRING: split — uses kernel but returns Karkain array
// ============================================================

func split(s, sep) {
    let count = 0
    let parts = k_str_split(s, sep, &count)
    let result = []
    let i = 0
    while (i < count) {
        result = appendArray(result, parts[i])
        i = i + 1
    }
    return result
}


// ============================================================
// STRING: join — Karkain logic
// ============================================================

func join(elems, sep) {
    let n = len(elems)
    if (n == 0) { return "" }
    let result = ""
    let i = 0
    while (i < n) {
        if (i > 0) { result = k_strcat(result, sep) }
        result = k_strcat(result, elems[i])
        i = i + 1
    }
    return result
}


// ============================================================
// STRING: trim
// ============================================================

func trim(s) {
    return k_str_trim(s)
}


// ============================================================
// STRING: trimPrefix
// ============================================================

func trimPrefix(s, prefix) {

// ============================================================
// AST Accessor helpers
// ============================================================

func getNodeType(node) { return node[0] }

func funcName(node) { return node[1] }
func funcParams(node) { return node[2] }
func funcReturnType(node) { return node[3] }
func funcBody(node) { return node[4] }

func kernelName(node) { return node[1] }
func kernelParams(node) { return node[2] }
func kernelBody(node) { return node[3] }
func kernelWorkgroup(node) { return node[4] }

func varDeclType(node) { return node[1] }
func varDeclName(node) { return node[2] }
func varDeclValue(node) { return node[3] }

func letDeclName(node) { return node[1] }
func letDeclValue(node) { return node[2] }

func identName(node) { return node[1] }
func literalValue(node) { return node[1] }

func binaryOp(node) { return node[1] }
func binaryLeft(node) { return node[2] }
func binaryRight(node) { return node[3] }

func unaryOp(node) { return node[1] }
func unaryOperand(node) { return node[2] }

func callFunc(node) { return node[1] }
func callArgs(node) { return node[2] }

func printExpr(node) { return node[1] }

func ifCondition(node) { return node[1] }
func ifThen(node) { return node[2] }
func ifElse(node) { return node[3] }

func whileCondition(node) { return node[1] }
func whileBody(node) { return node[2] }

func forInit(node) { return node[1] }
func forCondition(node) { return node[2] }
func forPost(node) { return node[3] }
func forBody(node) { return node[4] }

func returnExpr(node) { return node[1] }
func exprStmtExpr(node) { return node[1] }

func programStatements(node) { return node[1] }

func structName(node) { return node[1] }
func structFields(node) { return node[2] }

func indexLeft(node) { return node[1] }
func indexExpr(node) { return node[2] }

func memberObject(node) { return node[1] }
func memberField(node) { return node[2] }

func arrayElements(node) { return node[1] }

func mapKeys(node) { return node[1] }
func mapValues(node) { return node[2] }

func globalIdDim(node) { return node[1] }

func spawnActor(node) { return node[1] }
func spawnArgs(node) { return node[2] }

func sendChannel(node) { return node[1] }
func sendMessage(node) { return node[2] }

func receiveChannel(node) { return node[1] }
func receiveVar(node) { return node[2] }

func matrixName(node) { return node[1] }
func matrixRows(node) { return node[2] }
func matrixCols(node) { return node[3] }
func matrixElemType(node) { return node[4] }

func matrixIndexMatrix(node) { return node[1] }
func matrixIndexRow(node) { return node[2] }
func matrixIndexCol(node) { return node[3] }

// ============================================================
// Visitor interface helpers (for tree walkers)
// ============================================================

func visitNode(node, visitor) {
    let nodeType = getNodeType(node)

    if (nodeType == "Program") { visitorVisitProgram(node, visitor) }
    if (nodeType == "FuncDecl") { visitorVisitFuncDecl(node, visitor) }
    if (nodeType == "KernelDecl") { visitorVisitKernelDecl(node, visitor) }
    if (nodeType == "VarDecl") { visitorVisitVarDecl(node, visitor) }
    if (nodeType == "LetDecl") { visitorVisitLetDecl(node, visitor) }
    if (nodeType == "BinaryExpr") { visitorVisitBinaryExpr(node, visitor) }
    if (nodeType == "UnaryExpr") { visitorVisitUnaryExpr(node, visitor) }
    if (nodeType == "Call") { visitorVisitCall(node, visitor) }
    if (nodeType == "Print") { visitorVisitPrint(node, visitor) }
    if (nodeType == "If") { visitorVisitIf(node, visitor) }
    if (nodeType == "While") { visitorVisitWhile(node, visitor) }
    if (nodeType == "For") { visitorVisitFor(node, visitor) }
    if (nodeType == "Return") { visitorVisitReturn(node, visitor) }
    if (nodeType == "StructDecl") { visitorVisitStructDecl(node, visitor) }
}

func visitorVisitProgram(node, visitor) {
    let stmts = programStatements(node)
    let i = 0
    while (i < len(stmts)) {
        visitNode(stmts[i], visitor)
        i = i + 1
    }
}

func visitorVisitFuncDecl(node, visitor) {
    let body = funcBody(node)
    let i = 0
    while (i < len(body)) {
        visitNode(body[i], visitor)
        i = i + 1
    }
}

func visitorVisitKernelDecl(node, visitor) {
    let body = kernelBody(node)
    let i = 0
    while (i < len(body)) {
        visitNode(body[i], visitor)
        i = i + 1
    }
}

func visitorVisitVarDecl(node, visitor) {
    visitNode(varDeclValue(node), visitor)
}

func visitorVisitLetDecl(node, visitor) {
    visitNode(letDeclValue(node), visitor)
}

func visitorVisitBinaryExpr(node, visitor) {
    visitNode(binaryLeft(node), visitor)
    visitNode(binaryRight(node), visitor)
}

func visitorVisitUnaryExpr(node, visitor) {
    visitNode(unaryOperand(node), visitor)
}

func visitorVisitCall(node, visitor) {
    let args = callArgs(node)
    let i = 0
    while (i < len(args)) {
        visitNode(args[i], visitor)
        i = i + 1
    }
}

func visitorVisitPrint(node, visitor) {
    visitNode(printExpr(node), visitor)
}

func visitorVisitIf(node, visitor) {
    visitNode(ifCondition(node), visitor)
    let thenB = ifThen(node)
    let i = 0
    while (i < len(thenB)) {
        visitNode(thenB[i], visitor)
        i = i + 1
    }
    let elseB = ifElse(node)
    i = 0
    while (i < len(elseB)) {
        visitNode(elseB[i], visitor)
        i = i + 1
    }
}

func visitorVisitWhile(node, visitor) {
    visitNode(whileCondition(node), visitor)
    let body = whileBody(node)
    let i = 0
    while (i < len(body)) {
        visitNode(body[i], visitor)
        i = i + 1
    }
}

func visitorVisitFor(node, visitor) {
    visitNode(forInit(node), visitor)
    visitNode(forCondition(node), visitor)
    visitNode(forPost(node), visitor)
    let body = forBody(node)
    let i = 0
    while (i < len(body)) {
        visitNode(body[i], visitor)
        i = i + 1
    }
}

func visitorVisitReturn(node, visitor) {
    visitNode(returnExpr(node), visitor)
}

func visitorVisitStructDecl(node, visitor) {
    // No children to visit
}

// ============================================================
// AST pretty printer for debugging
// ============================================================

func printAST(node, indent) {
    let nodeType = getNodeType(node)
    print(indent + nodeType)

    if (nodeType == "Program") {
        let stmts = programStatements(node)
        let i = 0
        while (i < len(stmts)) {
            printAST(stmts[i], indent + "  ")
            i = i + 1
        }
    }

    if (nodeType == "FuncDecl") {
        print(indent + "  Name: " + funcName(node))
        print(indent + "  Params: " + str(funcParams(node)))
        print(indent + "  ReturnType: " + funcReturnType(node))
        print(indent + "  Body:")
        let body = funcBody(node)
        let i = 0
        while (i < len(body)) {
            printAST(body[i], indent + "    ")
            i = i + 1
        }
    }

    if (nodeType == "KernelDecl") {
        print(indent + "  Name: " + kernelName(node))
        print(indent + "  Params: " + str(kernelParams(node)))
        print(indent + "  Body:")
        let body = kernelBody(node)
        let i = 0
        while (i < len(body)) {
            printAST(body[i], indent + "    ")
            i = i + 1
        }
    }

    if (nodeType == "VarDecl") {
        print(indent + "  Type: " + varDeclType(node))
        print(indent + "  Name: " + varDeclName(node))
        print(indent + "  Value:")
        printAST(varDeclValue(node), indent + "    ")
    }

    if (nodeType == "LetDecl") {
        print(indent + "  Name: " + letDeclName(node))
        print(indent + "  Value:")
        printAST(letDeclValue(node), indent + "    ")
    }

    if (nodeType == "Ident") {
        print(indent + "  Name: " + identName(node))
    }

    if (nodeType == "IntLiteral") {
        print(indent + "  Value: " + literalValue(node))
    }

    if (nodeType == "FloatLiteral") {
        print(indent + "  Value: " + literalValue(node))
    }

    if (nodeType == "StringLiteral") {
        print(indent + "  Value: " + literalValue(node))
    }

    if (nodeType == "BoolLiteral") {
        print(indent + "  Value: " + literalValue(node))
    }

    if (nodeType == "BinaryExpr") {
        print(indent + "  Operator: " + binaryOp(node))
        print(indent + "  Left:")
        printAST(binaryLeft(node), indent + "    ")
        print(indent + "  Right:")
        printAST(binaryRight(node), indent + "    ")
    }

    if (nodeType == "UnaryExpr") {
        print(indent + "  Operator: " + unaryOp(node))
        print(indent + "  Operand:")
        printAST(unaryOperand(node), indent + "    ")
    }

    if (nodeType == "Call") {
        print(indent + "  Function: " + callFunc(node))
        print(indent + "  Arguments:")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            printAST(args[i], indent + "    ")
            i = i + 1
        }
    }

    if (nodeType == "Print") {
        print(indent + "  Expression:")
        printAST(printExpr(node), indent + "    ")
    }

    if (nodeType == "If") {
        print(indent + "  Condition:")
        printAST(ifCondition(node), indent + "    ")
        print(indent + "  Then:")
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            printAST(thenB[i], indent + "    ")
            i = i + 1
        }
    }

    if (nodeType == "Return") {
        print(indent + "  Expression:")
        printAST(returnExpr(node), indent + "    ")
    }

    if (nodeType == "StructDecl") {
        print(indent + "  Name: " + structName(node))
    }

    if (nodeType == "While") {
        print(indent + "  Condition:")
        printAST(whileCondition(node), indent + "    ")
    }

    if (nodeType == "For") {
        print(indent + "  Body:")
        let body = forBody(node)
        let i = 0
        while (i < len(body)) {
            printAST(body[i], indent + "    ")
            i = i + 1
        }
    }
}

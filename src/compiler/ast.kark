// ============================================================
// Binary: [NODE_BINARY, op, left, right, line]
// ============================================================

func makeBinary(op, left, right, line) {
    let n = makeNode(NODE_BINARY())
    n = appendArray(n, op)
    n = appendArray(n, left)
    n = appendArray(n, right)
    n = appendArray(n, line)
    return n
}

func binaryOp(n)    { return n[1] }
func binaryLeft(n)  { return n[2] }
func binaryRight(n) { return n[3] }
func binaryLine(n)  { return n[4] }

// ============================================================
// Unary: [NODE_UNARY, op, operand, line]

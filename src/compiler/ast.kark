    let node = []
    node = appendArray(node, "KernelDecl")
    node = appendArray(node, name)
    node = appendArray(node, params)
    node = appendArray(node, body)
    node = appendArray(node, workgroup)
    node = appendArray(node, loc)
    return node
}


// ============================================================
// Token creation and access (Phase 40: Zero-allocation tokens)
// Tokens store source offsets instead of copying literal strings.
// The token text is derived on-demand via tokenLiteral(tok, source).
// ============================================================

func createToken(kind, start, len, loc) {
    let tok = []
    tok = appendArray(tok, kind)    // 0: token kind (integer)
    tok = appendArray(tok, start)   // 1: source start offset (u32)
    tok = appendArray(tok, len)     // 2: source text length (u32)
    tok = appendArray(tok, loc)     // 3: source location
    return tok
}

func tokenKind(tok) { return tok[0] }
func tokenStart(tok) { return tok[1] }
func tokenLen(tok) { return tok[2] }
func tokenLoc(tok) { return tok[3] }

// tokenLiteral returns the token's source text by slicing the source buffer.
// This is zero-allocation at token creation; the string is materialized on demand.
func tokenLiteral(tok, source) {
    let start = tokenStart(tok)
    let length = tokenLen(tok)
    return substr(source, start, length)
}

// ============================================================
// AST Node Types
// ============================================================

// --- Program ---
func createProgramNode(statements) {
    let node = []
    node = appendArray(node, "Program")
    node = appendArray(node, statements)
    return node
}

// --- FuncDecl ---
func createFuncDeclNode(name, params, returnType, body, loc) {
    let node = []
    node = appendArray(node, "FuncDecl")
    node = appendArray(node, name)
    node = appendArray(node, params)
    node = appendArray(node, returnType)
    node = appendArray(node, body)
    node = appendArray(node, loc)
    return node
}


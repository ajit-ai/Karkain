func makeUnary(op, operand, line) {
    let n = makeNode(NODE_UNARY())
    n = appendArray(n, op)
    n = appendArray(n, operand)
    n = appendArray(n, line)
    return n
}

func unaryOp(n)      { return n[1] }
func unaryOperand(n) { return n[2] }
func unaryLine(n)    { return n[3] }

// ============================================================
// Call: [NODE_CALL, funcName, args, line, col]
// ============================================================

func makeCall(funcName, args, line, col) {
    let n = makeNode(NODE_CALL())
    n = appendArray(n, funcName)
    n = appendArray(n, args)
    n = appendArray(n, line)
    n = appendArray(n, col)
    return n
}

func callFunc(n)  { return n[1] }
func callArgs(n)  { return n[2] }
func callLine(n)  { return n[3] }
func callCol(n)   { return n[4] }

// ============================================================
// Index: [NODE_INDEX, left, index, line]
// ============================================================

func makeIndex(left, index, line) {
    let n = makeNode(NODE_INDEX())
    n = appendArray(n, left)
    n = appendArray(n, index)
    n = appendArray(n, line)
    return n
}

func indexLeft(n)   { return n[1] }
func indexExpr(n)   { return n[2] }
func indexLine(n)   { return n[3] }

// ============================================================
// Dot: [NODE_DOT, left, right, line]
// ============================================================

func makeDot(left, right, line) {
    let n = makeNode(NODE_DOT())
    n = appendArray(n, left)
    n = appendArray(n, right)
    n = appendArray(n, line)
    return n
}

func dotLeft(n)   { return n[1] }
func dotRight(n)  { return n[2] }
func dotLine(n)   { return n[3] }

// Self-hosted aliases matching the Go codegen's MemberExpr/Return/Print
// accessor names, used by sema.kark and the emit* functions.
func memberObject(n) { return dotLeft(n) }
func memberField(n)  { return dotRight(n) }
func returnExpr(n)   { return retVal(n) }
func printExpr(n)    { return printVal(n) }

// Condition / return-type aliases used by emitC11/emitWGSL/emitOpenCL/...
func whileCondition(n) { return whileCond(n) }
func forCondition(n)   { return forCond(n) }
func funcReturnType(n) { return "Value" }


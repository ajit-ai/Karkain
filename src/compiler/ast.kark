// ============================================================
// Self-hosted Karkain Parser — Production version
// Rewritten from pkg/parser/parser.go (2088 lines Go) to pure Karkain
// ============================================================

// ============================================================
// AST Node types — every node is an array of values
// Node format: [nodeType, ...fields]
// ============================================================

// Node type constants
func NODE_PROGRAM()       { return 1 }
func NODE_FUNC_DECL()     { return 2 }
func NODE_VAR_DECL()      { return 3 }
func NODE_RETURN()        { return 4 }
func NODE_IF()            { return 5 }
func NODE_WHILE()         { return 6 }
func NODE_FOR()           { return 7 }
func NODE_FOR_IN()        { return 8 }
func NODE_PRINT()         { return 9 }
func NODE_BLOCK()         { return 10 }
func NODE_EXPR_STMT()     { return 11 }
func NODE_STRUCT_DECL()   { return 12 }
func NODE_ENUM_DECL()     { return 13 }
func NODE_IDENT()         { return 20 }
func NODE_INT_LIT()       { return 21 }
func NODE_FLOAT_LIT()     { return 22 }
func NODE_STRING_LIT()    { return 23 }
func NODE_BOOL_LIT()      { return 24 }
func NODE_BINARY()        { return 30 }
func NODE_UNARY()         { return 31 }
func NODE_CALL()          { return 32 }
func NODE_INDEX()         { return 33 }
func NODE_DOT()           { return 34 }
func NODE_ASSIGN()        { return 35 }
func NODE_ARRAY_LIT()     { return 36 }
func NODE_MAP_LIT()       { return 37 }
func NODE_LAMBDA()        { return 38 }
func NODE_IMPORT()        { return 40 }
func NODE_CIMPORT()       { return 41 }
func NODE_BREAK()         { return 42 }
func NODE_CONTINUE()      { return 43 }
func NODE_MATCH()         { return 44 }
func NODE_STRUCT_LIT()    { return 45 }
func NODE_SLICE()         { return 46 }
func NODE_BORROW()        { return 50 }
func NODE_MOVE()          { return 51 }
func NODE_RAW_ACCESS()    { return 52 }
func NODE_OPTION_SOME()   { return 53 }
func NODE_OPTION_NONE()   { return 54 }
func NODE_RESULT_OK()     { return 55 }
func NODE_RESULT_ERR()    { return 56 }
func NODE_PROPAGATE()     { return 57 }
func NODE_KERNEL()        { return 60 }
func NODE_GLOBAL_ID()     { return 61 }
func NODE_BARRIER()       { return 62 }
func NODE_ACTOR()         { return 63 }
func NODE_SPAWN()         { return 64 }
func NODE_SEND()          { return 65 }
func NODE_RECEIVE()       { return 66 }
func NODE_MATRIX_DECL()   { return 70 }
func NODE_MATRIX_INDEX()  { return 71 }
func NODE_QREG_DECL()     { return 72 }
func NODE_GATE_APPLY()    { return 73 }
func NODE_MEASURE()       { return 74 }
func NODE_MACRO()         { return 80 }
func NODE_QUOTE()         { return 81 }
func NODE_UNQUOTE()       { return 82 }
func NODE_COMPTIME()      { return 83 }
func NODE_DERIVE()        { return 84 }
func NODE_TAG()           { return 85 }
func NODE_ALLOC()         { return 86 }
func NODE_FREE()          { return 87 }
func NODE_ADDR_OF()       { return 88 }
func NODE_DEREF()         { return 89 }
func NODE_SIMD_BUILTIN()  { return 90 }
func NODE_ATOMIC_OP()     { return 91 }
func NODE_LINEAR_TYPE()   { return 92 }
func NODE_PACKED_STRUCT() { return 93 }

// ============================================================
// Node constructors — create AST nodes as arrays
// ============================================================

func makeNode(nodeType) {
    let n = []
    n = appendArray(n, nodeType)
    return n
}

func nodeType(n) { return n[0] }

// ============================================================
// Program node
// ============================================================

func makeProgram(stmts, imports) {
    let n = makeNode(NODE_PROGRAM())
    n = appendArray(n, stmts)
    n = appendArray(n, imports)
    return n
}

func progStatements(p) { return p[1] }
func progImports(p)    { return p[2] }

// ============================================================
// FuncDecl node: [NODE_FUNC_DECL, name, params, body, line, col]
// ============================================================

func makeFuncDecl(name, params, body, line, col) {
    let n = makeNode(NODE_FUNC_DECL())
    n = appendArray(n, name)
    n = appendArray(n, params)
    n = appendArray(n, body)
    n = appendArray(n, line)
    n = appendArray(n, col)
    return n
}

func funcName(n)      { return n[1] }
func funcParams(n)    { return n[2] }
func funcBody(n)      { return n[3] }
func funcLine(n)      { return n[4] }
func funcCol(n)       { return n[5] }

// ============================================================
// VarDecl node: [NODE_VAR_DECL, name, value, typeName, line]
// ============================================================

func makeVarDecl(name, value, typeName, line) {
    let n = makeNode(NODE_VAR_DECL())
    n = appendArray(n, name)
    n = appendArray(n, value)
    n = appendArray(n, typeName)
    n = appendArray(n, line)
    return n
}

func varDeclName(n)     { return n[1] }
func varDeclValue(n)    { return n[2] }
func varDeclType(n)     { return n[3] }
func varDeclLine(n)     { return n[4] }

// ============================================================
// Return node: [NODE_RETURN, value, line]
// ============================================================

func makeReturn(val, line) {
    let n = makeNode(NODE_RETURN())
    n = appendArray(n, val)
    n = appendArray(n, line)
    return n
}

func retVal(n)  { return n[1] }
func retLine(n) { return n[2] }

// ============================================================
// If node: [NODE_IF, condition, consequence, alternative, line]
// ============================================================

func makeIf(cond, cons, alt, line) {
    let n = makeNode(NODE_IF())
    n = appendArray(n, cond)
    n = appendArray(n, cons)
    n = appendArray(n, alt)
    n = appendArray(n, line)
    return n
}

func ifCond(n)  { return n[1] }
func ifCons(n)  { return n[2] }
func ifAlt(n)   { return n[3] }
func ifLine(n)  { return n[4] }

// ============================================================
// While node: [NODE_WHILE, condition, body, line]
// ============================================================

func makeWhile(cond, body, line) {
    let n = makeNode(NODE_WHILE())
    n = appendArray(n, cond)
    n = appendArray(n, body)
    n = appendArray(n, line)
    return n
}

func whileCond(n)  { return n[1] }
func whileBody(n)  { return n[2] }
func whileLine(n)  { return n[3] }

// ============================================================
// For node: [NODE_FOR, init, cond, post, body, line]
// ============================================================

func makeFor(init, cond, post, body, line) {
    let n = makeNode(NODE_FOR())
    n = appendArray(n, init)
    n = appendArray(n, cond)
    n = appendArray(n, post)
    n = appendArray(n, body)
    n = appendArray(n, line)
    return n
}

func forInit(n)   { return n[1] }
func forCond(n)   { return n[2] }
func forPost(n)   { return n[3] }
func forBody(n)   { return n[4] }
func forLine(n)   { return n[5] }

// ============================================================
// ForIn node: [NODE_FOR_IN, varName, iter, body, line]
// ============================================================

func makeForIn(varName, iter, body, line) {
    let n = makeNode(NODE_FOR_IN())
    n = appendArray(n, varName)
    n = appendArray(n, iter)
    n = appendArray(n, body)
    n = appendArray(n, line)
    return n
}

func forInVar(n)  { return n[1] }
func forInIter(n) { return n[2] }
func forInBody(n) { return n[3] }
func forInLine(n) { return n[4] }

// ============================================================
// Print node: [NODE_PRINT, value, line]
// ============================================================

func makePrint(val, line) {
    let n = makeNode(NODE_PRINT())
    n = appendArray(n, val)
    n = appendArray(n, line)
    return n
}

func printVal(n)  { return n[1] }
func printLine(n) { return n[2] }

// ============================================================
// Block node: [NODE_BLOCK, statements]

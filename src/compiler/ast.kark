// Phase 40: Self-hosted AST Node Definitions for Karkain Compiler
// Defines all AST node types, token kinds, and visitor interface structures
// Foundation module - all other compiler modules depend on it

// ============================================================
// Location tracking for source mapping
// ============================================================

func createLocation(line, col, offset) {
    let loc = []
    loc = appendArray(loc, line)
    loc = appendArray(loc, col)
    loc = appendArray(loc, offset)
    return loc
}

func locLine(loc) { return loc[0] }
func locCol(loc) { return loc[1] }
func locOffset(loc) { return loc[2] }


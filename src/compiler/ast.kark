// ============================================================
// String-tag dispatch + compatibility accessors.
// sema/codegen dispatch on string tags ("If", "Call", ...)
// while nodes carry integer tags; this bridge maps between them.
// ============================================================

func getNodeType(node) {
    let t = nodeType(node)
    if (t == NODE_PROGRAM()) { return "Program" }
    if (t == NODE_FUNC_DECL()) { return "FuncDecl" }
    if (t == NODE_VAR_DECL()) { return "VarDecl" }
    if (t == NODE_LET_DECL()) { return "LetDecl" }
    if (t == NODE_RETURN()) { return "Return" }
    if (t == NODE_IF()) { return "If" }
    if (t == NODE_WHILE()) { return "While" }
    if (t == NODE_FOR()) { return "For" }
    if (t == NODE_FOR_IN()) { return "ForIn" }
    if (t == NODE_PRINT()) { return "Print" }
    if (t == NODE_BLOCK()) { return "Block" }
    if (t == NODE_EXPR_STMT()) { return "ExprStmt" }
    if (t == NODE_STRUCT_DECL()) { return "StructDecl" }
    if (t == NODE_ENUM_DECL()) { return "EnumDecl" }
    if (t == NODE_IDENT()) { return "Ident" }
    if (t == NODE_INT_LIT()) { return "IntLiteral" }
    if (t == NODE_FLOAT_LIT()) { return "FloatLiteral" }
    if (t == NODE_STRING_LIT()) { return "StringLiteral" }
    if (t == NODE_BOOL_LIT()) { return "BoolLiteral" }
    if (t == NODE_BINARY()) { return "BinaryExpr" }
    if (t == NODE_UNARY()) { return "UnaryExpr" }
    if (t == NODE_CALL()) { return "Call" }
    if (t == NODE_INDEX()) { return "Index" }
    if (t == NODE_DOT()) { return "Member" }
    if (t == NODE_ASSIGN()) { return "Assign" }
    if (t == NODE_ARRAY_LIT()) { return "ArrayLiteral" }
    if (t == NODE_MAP_LIT()) { return "MapLiteral" }
    if (t == NODE_LAMBDA()) { return "Lambda" }
    if (t == NODE_IMPORT()) { return "Import" }
    if (t == NODE_CIMPORT()) { return "CImport" }
    if (t == NODE_BREAK()) { return "Break" }
    if (t == NODE_CONTINUE()) { return "Continue" }
    if (t == NODE_MATCH()) { return "Match" }
    if (t == NODE_STRUCT_LIT()) { return "StructLiteral" }
    if (t == NODE_SLICE()) { return "Slice" }
    if (t == NODE_BORROW()) { return "Borrow" }
    if (t == NODE_MOVE()) { return "Move" }
    if (t == NODE_RAW_ACCESS()) { return "RawAccess" }
    if (t == NODE_OPTION_SOME()) { return "OptionSome" }
    if (t == NODE_OPTION_NONE()) { return "OptionNone" }
    if (t == NODE_RESULT_OK()) { return "ResultOk" }
    if (t == NODE_RESULT_ERR()) { return "ResultErr" }
    if (t == NODE_PROPAGATE()) { return "Propagate" }
    if (t == NODE_KERNEL()) { return "KernelDecl" }
    if (t == NODE_GLOBAL_ID()) { return "GlobalId" }
    if (t == NODE_BARRIER()) { return "Barrier" }
    if (t == NODE_ACTOR()) { return "Actor" }
    if (t == NODE_SPAWN()) { return "Spawn" }
    if (t == NODE_SEND()) { return "Send" }
    if (t == NODE_RECEIVE()) { return "Receive" }
    if (t == NODE_MATRIX_DECL()) { return "MatrixDecl" }
    if (t == NODE_MATRIX_INDEX()) { return "MatrixIndex" }
    if (t == NODE_QREG_DECL()) { return "QregDecl" }
    if (t == NODE_GATE_APPLY()) { return "GateApply" }
    if (t == NODE_MEASURE()) { return "Measure" }
    if (t == NODE_MACRO()) { return "Macro" }
    if (t == NODE_QUOTE()) { return "Quote" }
    if (t == NODE_UNQUOTE()) { return "Unquote" }
    if (t == NODE_COMPTIME()) { return "Comptime" }
    if (t == NODE_DERIVE()) { return "Derive" }
    if (t == NODE_TAG()) { return "Tag" }
    if (t == NODE_ALLOC()) { return "Alloc" }
    if (t == NODE_FREE()) { return "Free" }
    if (t == NODE_ADDR_OF()) { return "AddrOf" }
    if (t == NODE_DEREF()) { return "Deref" }
    if (t == NODE_SIMD_BUILTIN()) { return "SimdBuiltin" }
    if (t == NODE_ATOMIC_OP()) { return "AtomicOp" }
    if (t == NODE_LINEAR_TYPE()) { return "LinearType" }
    if (t == NODE_PACKED_STRUCT()) { return "PackedStruct" }
    return "Unknown"
}

// Program
func programStatements(p) { return progStatements(p) }

// If
func ifThen(n)      { return ifCons(n) }
func ifElse(n)      { return ifAlt(n) }
func ifCondition(n) { return ifCond(n) }

// Literals (values are stored as source text)
func literalValue(n) {
    let t = nodeType(n)
    if (t == NODE_INT_LIT()) { return intLitVal(n) }
    if (t == NODE_FLOAT_LIT()) { return floatLitVal(n) }
    if (t == NODE_STRING_LIT()) { return stringLitVal(n) }
    if (t == NODE_BOOL_LIT()) { return boolLitVal(n) }
    return ""
}

// Array
func arrayElements(n) { return arrayLitElems(n) }

// StructDecl
func structName(n)   { return structDeclName(n) }
func structFields(n) { return structDeclFields(n) }

// ============================================================
// MapLiteral: [NODE_MAP_LIT, keys, values, line]
// ============================================================

func makeMapLit(keys, values, line) {
    let n = makeNode(NODE_MAP_LIT())
    n = appendArray(n, keys)
    n = appendArray(n, values)
    n = appendArray(n, line)
    return n
}

func mapKeys(n)    { return n[1] }
func mapValues(n)  { return n[2] }
func mapLitLine(n) { return n[3] }

// ============================================================
// LetDecl: [NODE_LET_DECL, name, value, typeName, line]
// Distinct from VarDecl so sema/codegen can enforce
// let-immutability separately from var.
// ============================================================

func NODE_LET_DECL() { return 39 }

func makeLetDecl(name, value, typeName, line) {
    let n = makeNode(NODE_LET_DECL())
    n = appendArray(n, name)
    n = appendArray(n, value)
    n = appendArray(n, typeName)
    n = appendArray(n, line)
    return n
}

func letDeclName(n)  { return n[1] }
func letDeclValue(n) { return n[2] }
func letDeclType(n)  { return n[3] }
func letDeclLine(n)  { return n[4] }

// ============================================================
// GlobalId: [NODE_GLOBAL_ID, dim, line]
// ============================================================

func makeGlobalId(dim, line) {
    let n = makeNode(NODE_GLOBAL_ID())
    n = appendArray(n, dim)
    n = appendArray(n, line)
    return n
}

func globalIdDim(n)  { return n[1] }
func globalIdLine(n) { return n[2] }

// ============================================================
// Kernel workgroup: the language has no workgroup annotation
// (neither does the Go front end), so kernels always lower
// with the default 64-lane workgroup unless slot 5 carries
// an explicit [x, y, z] array.
// ============================================================

func kernelWorkgroup(node) {
    if (len(node) > 5) { return node[5] }
    return ["64"]
}

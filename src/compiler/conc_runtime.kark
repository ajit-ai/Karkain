    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "int karkain_channel_close(karkain_channel_t* c) {")
    emitLine(state, "    karkain_mutex_lock(&c->lock);")
    emitLine(state, "    if (c->closed) {")
    emitLine(state, "        karkain_mutex_unlock(&c->lock);")
    emitLine(state, "        return 0;")
    emitLine(state, "    }")
    emitLine(state, "    c->closed = 1;")
    emitLine(state, "    karkain_cond_broadcast(&c->not_empty);")
    emitLine(state, "    karkain_cond_broadcast(&c->not_full);")
    emitLine(state, "    karkain_mutex_unlock(&c->lock);")
    emitLine(state, "    return 1;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "/* Free residual messages + locks but keep the struct (used for embedded")
    emitLine(state, " * actor mailboxes and by destroy). */")
    emitLine(state, "void karkain_channel_release(karkain_channel_t* c) {")
    emitLine(state, "    karkain_mutex_lock(&c->lock);")
    emitLine(state, "    karkain_conc_msg_t* m = c->head;")
    emitLine(state, "    while (m) {")
    emitLine(state, "        karkain_conc_msg_t* next = m->next;")
    emitLine(state, "        free(m->payload);")
    emitLine(state, "        free(m);")
    emitLine(state, "        m = next;")
    emitLine(state, "    }")
    emitLine(state, "    c->head = c->tail = NULL;")
    emitLine(state, "    c->size = 0;")
    emitLine(state, "    karkain_mutex_unlock(&c->lock);")
    emitLine(state, "    karkain_mutex_destroy(&c->lock);")
    emitLine(state, "    karkain_cond_destroy(&c->not_empty);")
    emitLine(state, "    karkain_cond_destroy(&c->not_full);")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "void karkain_channel_destroy(karkain_channel_t* c) {")
    emitLine(state, "    karkain_channel_release(c);")
    emitLine(state, "    free(c);")
    emitLine(state, "}")
    emitLine(state, "// ==== Phase 107 runtime source: karkain_actor.c ====")
    emitLine(state, "/* karkain_actor.c â€” Phase 107 actors.")
    emitLine(state, " *")
    emitLine(state, " * An actor owns an embedded mailbox channel and opaque boxed state. Sends")
    emitLine(state, " * place a message box into the mailbox and enqueue the actor onto a worker's")
    emitLine(state, " * runnable queue. A per-actor drain also holds a dedicated drain lock so the")
    emitLine(state, " * handler is invoked on exactly one worker at a time (single-runner")
    emitLine(state, " * guarantee); messages are therefore processed serially and are never")
    emitLine(state, " * silently dropped â€” a stopped actor drains its mailbox discarding remaining")
    emitLine(state, " * messages only after an explicit karkain_actor_stop.")
    emitLine(state, " *")
    emitLine(state, " * State contract (shared with the code generation layer):")
    emitLine(state, " *   udata  â€” void* pointing to a heap Karkain-value cell (box) owned by the")
    emitLine(state, " *            actor. karkain_actor_get_state returns the cell pointer;")
    emitLine(state, " *            karkain_actor_set_state swaps the cell out (freeing the old one).")
    emitLine(state, " *   Messages â€” void* boxes owned by the mailbox; the handler wrapper")
    emitLine(state, " *            (generated code) is responsible for releasing each box after")
    emitLine(state, " *            delivering it to the user handler.")
    emitLine(state, " */")
    emitLine(state, "")
    emitLine(state, "karkain_actor_t* karkain_actor_create(karkain_sched_t* s, karkain_actor_fn fn, void* state) {")
    emitLine(state, "    karkain_actor_t* a = (karkain_actor_t*)malloc(sizeof(karkain_actor_t));")
    emitLine(state, "    if (!a) return NULL;")
    emitLine(state, "    memset(a, 0, sizeof(*a));")
    emitLine(state, "    a->sched = s;")
    emitLine(state, "    a->handler = fn;")
    emitLine(state, "    a->udata = state;")
    emitLine(state, "    karkain_mutex_init(&a->state_lock);")
    emitLine(state, "    karkain_mutex_init(&a->dwq_lock);")
    emitLine(state, "    /* Embedded mailbox channel (not separately allocated/tracked). */")
    emitLine(state, "    a->mailbox.sched = s;")
    emitLine(state, "    a->mailbox.cap = -1; /* unbounded */")
    emitLine(state, "    karkain_mutex_init(&a->mailbox.lock);")
    emitLine(state, "    karkain_cond_init(&a->mailbox.not_empty);")
    emitLine(state, "    karkain_cond_init(&a->mailbox.not_full);")
    emitLine(state, "    karkain_mutex_lock(&s->lock);")
    emitLine(state, "    a->next = s->actors_head;")
    emitLine(state, "    s->actors_head = a;")
    emitLine(state, "    karkain_mutex_unlock(&s->lock);")
    emitLine(state, "    return a;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "int karkain_actor_send(karkain_actor_t* a, void* payload) {")
    emitLine(state, "    if (karkain_conc_atomic_load(&a->stopped)) {")
    emitLine(state, "        free(payload);")
    emitLine(state, "        return 0;")
    emitLine(state, "    }")
    emitLine(state, "    /* Count the message: the drain decrements when the dispatch completes. */")
    emitLine(state, "    karkain_conc_atomic_fetch_add(&a->sched->pending, 1);")
    emitLine(state, "    if (!karkain_channel_send(&a->mailbox, payload)) {")
    emitLine(state, "        /* Closed under our feet (channel released the payload): undo count. */")
    emitLine(state, "        karkain_conc_atomic_fetch_add(&a->sched->pending, -1);")
    emitLine(state, "        return 0;")
    emitLine(state, "    }")
    emitLine(state, "    karkain_sched_enqueue_actor(a);")
    emitLine(state, "    return 1;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "void* karkain_actor_get_state(karkain_actor_t* a) {")
    emitLine(state, "    void* out = NULL;")
    emitLine(state, "    karkain_mutex_lock(&a->state_lock);")
    emitLine(state, "    out = a->udata;")
    emitLine(state, "    karkain_mutex_unlock(&a->state_lock);")
    emitLine(state, "    return out;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "int karkain_actor_set_state(karkain_actor_t* a, void* state) {")
    emitLine(state, "    karkain_mutex_lock(&a->state_lock);")
    emitLine(state, "    void* old = a->udata;")
    emitLine(state, "    a->udata = state;")
    emitLine(state, "    free(old);")
    emitLine(state, "    karkain_mutex_unlock(&a->state_lock);")
    emitLine(state, "    return 1;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "int karkain_actor_stop(karkain_actor_t* a) {")
    emitLine(state, "    if (!karkain_conc_atomic_cas(&a->stopped, 0, 1)) return 0;")
    emitLine(state, "    /* Wake any drain blocked on a full wait: nothing new will be accepted. */")
    emitLine(state, "    karkain_channel_close(&a->mailbox);")
    emitLine(state, "    return 1;")
    emitLine(state, "}")
    emitLine(state, "// ==== Phase 107 runtime source: karkain_scheduler.c ====")
    emitLine(state, "/* karkain_scheduler.c â€” Phase 107 work-stealing scheduler + platform layer.")
    emitLine(state, " *")
    emitLine(state, " * Responsibilities:")
    emitLine(state, " *   - Platform threading abstraction (Win32 SRWLOCK/CONDITION_VARIABLE and")
    emitLine(state, " *     CreateThread; pthread equivalents elsewhere).")
    emitLine(state, " *   - N worker threads, one local LIFO runnable queue each.")
    emitLine(state, " *   - Work stealing: an idle worker first runs its own queue, then steals")
    emitLine(state, " *     from another worker's queue (and from the global queue used by")
    emitLine(state, " *     non-worker callers such as main). Idle workers sleep on a condition")
    emitLine(state, " *     variable â€” no busy spin.")
    emitLine(state, " *   - Task lifecycle: spawn -> runnable -> running -> completed; join()")
    emitLine(state, " *     observes completion and the wrapper-set status. Pending accounting")
    emitLine(state, " *     drives wait_all()/finish().")
    emitLine(state, " *   - Deterministic shutdown: finish() waits for pending==0, stops workers,")
    emitLine(state, " *     joins them and releases every runtime object.")
    emitLine(state, " */")
    emitLine(state, "")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "#else")
    emitLine(state, "#include <unistd.h>")
    emitLine(state, "#endif")
    emitLine(state, "#include <stdatomic.h>")
    emitLine(state, "")
    emitLine(state, "/* ---------------------------------------------------------------------")
    emitLine(state, " * Platform primitives")
    emitLine(state, " * ------------------------------------------------------------------- */")
    emitLine(state, "")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "")
    emitLine(state, "void karkain_mutex_init(karkain_mutex_t* m) { InitializeSRWLock(m); }")
    emitLine(state, "void karkain_mutex_lock(karkain_mutex_t* m) { AcquireSRWLockExclusive(m); }")
    emitLine(state, "void karkain_mutex_unlock(karkain_mutex_t* m) { ReleaseSRWLockExclusive(m); }")
    emitLine(state, "void karkain_mutex_destroy(karkain_mutex_t* m) { (void)m; }")
    emitLine(state, "")
    emitLine(state, "void karkain_cond_init(karkain_cond_t* c) { InitializeConditionVariable(c); }")
    emitLine(state, "void karkain_cond_signal(karkain_cond_t* c) { WakeConditionVariable(c); }")
    emitLine(state, "void karkain_cond_broadcast(karkain_cond_t* c) { WakeAllConditionVariable(c); }")
    emitLine(state, "void karkain_cond_wait(karkain_cond_t* c, karkain_mutex_t* m) {")
    emitLine(state, "    SleepConditionVariableSRW(c, m, INFINITE, 0);")
    emitLine(state, "}")
    emitLine(state, "void karkain_cond_timedwait(karkain_cond_t* c, karkain_mutex_t* m, long ms) {")
    emitLine(state, "    SleepConditionVariableSRW(c, m, (DWORD)ms, 0);")
    emitLine(state, "}")
    emitLine(state, "void karkain_cond_destroy(karkain_cond_t* c) { (void)c; }")
    emitLine(state, "")
    emitLine(state, "static DWORD WINAPI karkain_win_thread_proc(LPVOID arg) {")
    emitLine(state, "    void** pair = (void**)arg;")
    emitLine(state, "    karkain_thread_fn fn = (karkain_thread_fn)pair[0];")
    emitLine(state, "    void* ctx = pair[1];")
    emitLine(state, "    free(pair);")
    emitLine(state, "    fn(ctx);")
    emitLine(state, "    return 0;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "karkain_thread_t karkain_thread_create(karkain_thread_fn fn, void* arg) {")
    emitLine(state, "    void** pair = (void**)malloc(2 * sizeof(void*));")
    emitLine(state, "    pair[0] = (void*)fn;")
    emitLine(state, "    pair[1] = arg;")
    emitLine(state, "    return CreateThread(NULL, 0, karkain_win_thread_proc, pair, 0, NULL);")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "void karkain_thread_join(karkain_thread_t t) {")
    emitLine(state, "    WaitForSingleObject(t, INFINITE);")
    emitLine(state, "    CloseHandle(t);")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "void karkain_thread_yield(void) { SwitchToThread(); }")
    emitLine(state, "")
    emitLine(state, "#else /* POSIX */")
    emitLine(state, "")
    emitLine(state, "void karkain_mutex_init(pthread_mutex_t* m) { pthread_mutex_init(m, NULL); }")
    emitLine(state, "void karkain_mutex_lock(pthread_mutex_t* m) { pthread_mutex_lock(m); }")
    emitLine(state, "void karkain_mutex_unlock(pthread_mutex_t* m) { pthread_mutex_unlock(m); }")
    emitLine(state, "void karkain_mutex_destroy(pthread_mutex_t* m) { pthread_mutex_destroy(m); }")
    emitLine(state, "")
    emitLine(state, "void karkain_cond_init(pthread_cond_t* c) { pthread_cond_init(c, NULL); }")
    emitLine(state, "void karkain_cond_signal(pthread_cond_t* c) { pthread_cond_signal(c); }")
    emitLine(state, "void karkain_cond_broadcast(pthread_cond_t* c) { pthread_cond_broadcast(c); }")
    emitLine(state, "void karkain_cond_wait(pthread_cond_t* c, pthread_mutex_t* m) {")
    emitLine(state, "    pthread_cond_wait(c, m);")
    emitLine(state, "}")
    emitLine(state, "void karkain_cond_timedwait(pthread_cond_t* c, pthread_mutex_t* m, long ms) {")
    emitLine(state, "    struct timespec ts;")
    emitLine(state, "    clock_gettime(CLOCK_REALTIME, &ts);")
    emitLine(state, "    ts.tv_sec += ms / 1000;")
    emitLine(state, "    ts.tv_nsec += (ms % 1000) * 1000000L;")
    emitLine(state, "    if (ts.tv_nsec >= 1000000000L) {")
    emitLine(state, "        ts.tv_sec++;")
    emitLine(state, "        ts.tv_nsec -= 1000000000L;")
    emitLine(state, "    }")
    emitLine(state, "    pthread_cond_timedwait(c, m, &ts);")
    emitLine(state, "}")
    emitLine(state, "void karkain_cond_destroy(pthread_cond_t* c) { pthread_cond_destroy(c); }")
    emitLine(state, "")
    emitLine(state, "static void* karkain_pthread_proc(void* arg) {")
    emitLine(state, "    void** pair = (void**)arg;")
    emitLine(state, "    karkain_thread_fn fn = (karkain_thread_fn)pair[0];")
    emitLine(state, "    void* ctx = pair[1];")
    emitLine(state, "    free(pair);")
    emitLine(state, "    fn(ctx);")
    emitLine(state, "    return NULL;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "karkain_thread_t karkain_thread_create(karkain_thread_fn fn, void* arg) {")
    emitLine(state, "    void** pair = (void**)malloc(2 * sizeof(void*));")
    emitLine(state, "    pair[0] = (void*)fn;")
    emitLine(state, "    pair[1] = arg;")
    emitLine(state, "    pthread_t t;")
    emitLine(state, "    pthread_create(&t, NULL, karkain_pthread_proc, pair);")
    emitLine(state, "    return t;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "void karkain_thread_join(pthread_t t) { pthread_join(t, NULL); }")
    emitLine(state, "void karkain_thread_yield(void) { sched_yield(); }")
    emitLine(state, "")
    emitLine(state, "#endif")
    emitLine(state, "")
    emitLine(state, "/* ---------------------------------------------------------------------")
    emitLine(state, " * Scheduler state")
    emitLine(state, " * ------------------------------------------------------------------- */")
    emitLine(state, "")
    emitLine(state, "/* Thread-local current worker (NULL for non-worker threads such as main). */")
    emitLine(state, "static __thread karkain_worker_t* conc_self;")
    emitLine(state, "")
    emitLine(state, "karkain_worker_t* karkain_sched_current_worker(void) {")
    emitLine(state, "    return conc_self;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "static long karkain_conc_default_workers(void) {")
    emitLine(state, "    long n = 4;")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "    SYSTEM_INFO si;")
    emitLine(state, "    GetSystemInfo(&si);")
    emitLine(state, "    n = (long)si.dwNumberOfProcessors;")
    emitLine(state, "#else")
    emitLine(state, "    long c = sysconf(_SC_NPROCESSORS_ONLN);")
    emitLine(state, "    if (c > 0) n = c;")
    emitLine(state, "#endif")
    emitLine(state, "    if (n < 1) n = 1;")
    emitLine(state, "    if (n > 8) n = 8;")
    emitLine(state, "    const char* env = getenv(\"KARKAIN_WORKERS\");")
    emitLine(state, "    if (env && *env) {")
    emitLine(state, "        long v = atol(env);")
    emitLine(state, "        if (v >= 1 && v <= 64) n = v;")
    emitLine(state, "    }")
    emitLine(state, "    return n;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "static void karkain_sched_pending_dec(karkain_sched_t* s, long n) {")
    emitLine(state, "    long after = karkain_conc_atomic_fetch_add(&s->pending, -n) - n;")
    emitLine(state, "    if (after == 0) {")
    emitLine(state, "        karkain_mutex_lock(&s->lock);")
    emitLine(state, "        karkain_cond_broadcast(&s->drained);")
    emitLine(state, "        karkain_mutex_unlock(&s->lock);")
    emitLine(state, "    }")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "/* ---------------------------------------------------------------------")
    emitLine(state, " * Queue plumbing")
    emitLine(state, " * ------------------------------------------------------------------- */")
    emitLine(state, "")
    emitLine(state, "void karkain_sched_push_run(karkain_sched_t* s, karkain_run_t* r) {")
    emitLine(state, "    karkain_worker_t* self = conc_self;")
    emitLine(state, "    if (self) {")
    emitLine(state, "        karkain_mutex_lock(&self->lock);")
    emitLine(state, "        r->next = self->run_head;")
    emitLine(state, "        self->run_head = r;")
    emitLine(state, "        self->run_count++;")
    emitLine(state, "        karkain_mutex_unlock(&self->lock);")
    emitLine(state, "    } else {")
    emitLine(state, "        karkain_mutex_lock(&s->lock);")
    emitLine(state, "        r->next = s->global_head;")
    emitLine(state, "        s->global_head = r;")
    emitLine(state, "        s->global_count++;")
    emitLine(state, "        karkain_mutex_unlock(&s->lock);")
    emitLine(state, "    }")
    emitLine(state, "    /* No broadcast on the hot path: workers re-examine queues on a bounded")
    emitLine(state, "     * timed wait, so a sleeping idle worker notices new work within")
    emitLine(state, "     * KARKAIN_IDLE_WAIT_MS. This keeps per-message send throughput high. */")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "karkain_run_t* karkain_sched_pop_local(karkain_sched_t* s) {")
    emitLine(state, "    (void)s;")
    emitLine(state, "    karkain_worker_t* self = conc_self;")
    emitLine(state, "    if (!self) return NULL;")
    emitLine(state, "    karkain_mutex_lock(&self->lock);")
    emitLine(state, "    karkain_run_t* r = self->run_head;")
    emitLine(state, "    if (r) {")
    emitLine(state, "        self->run_head = r->next;")
    emitLine(state, "        self->run_count--;")
    emitLine(state, "    }")
    emitLine(state, "    karkain_mutex_unlock(&self->lock);")
    emitLine(state, "    return r;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "karkain_run_t* karkain_sched_steal(karkain_sched_t* s, long id) {")
    emitLine(state, "    /* Never steal from ourselves; visit every other worker in round-robin. */")
    emitLine(state, "    for (long v = 1; v < s->nworkers; v++) {")
    emitLine(state, "        long victim = (id + v) % s->nworkers;")
    emitLine(state, "        karkain_worker_t* w = &s->workers[victim];")
    emitLine(state, "        karkain_mutex_lock(&w->lock);")
    emitLine(state, "        karkain_run_t* r = w->run_head;")
    emitLine(state, "        if (r) {")
    emitLine(state, "            w->run_head = r->next;")
    emitLine(state, "            w->run_count--;")
    emitLine(state, "        }")
    emitLine(state, "        karkain_mutex_unlock(&w->lock);")
    emitLine(state, "        if (r) return r;")
    emitLine(state, "    }")
    emitLine(state, "    karkain_mutex_lock(&s->lock);")
    emitLine(state, "    karkain_run_t* g = s->global_head;")
    emitLine(state, "    if (g) {")
    emitLine(state, "        s->global_head = g->next;")
    emitLine(state, "        s->global_count--;")
    emitLine(state, "    }")
    emitLine(state, "    karkain_mutex_unlock(&s->lock);")
    emitLine(state, "    return g;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "void karkain_sched_enqueue_actor(karkain_actor_t* a) {")
    emitLine(state, "    if (karkain_conc_atomic_load(&a->stopped)) return;")
    emitLine(state, "    if (!karkain_conc_atomic_cas(&a->queued, 0, 1)) return;")
    emitLine(state, "    karkain_run_t* r = (karkain_run_t*)malloc(sizeof(karkain_run_t));")
    emitLine(state, "    r->is_actor = 1;")
    emitLine(state, "    r->task = NULL;")
    emitLine(state, "    r->actor = a;")
    emitLine(state, "    r->next = NULL;")
    emitLine(state, "    karkain_sched_push_run(a->sched, r);")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "void karkain_sched_drain_actor(karkain_sched_t* s, karkain_actor_t* a) {")
    emitLine(state, "    int delivered = 0;")
    emitLine(state, "    karkain_mutex_lock(&a->dwq_lock);")
    emitLine(state, "    for (;;) {")
    emitLine(state, "        void* m = karkain_channel_try_recv(&a->mailbox);")
    emitLine(state, "        if (!m) break;")
    emitLine(state, "        if (!karkain_conc_atomic_load(&a->stopped)) {")
    emitLine(state, "            a->handler(a, m, s);")
    emitLine(state, "        } else {")
    emitLine(state, "            free(m); /* stopped: discard the undelivered box */")
    emitLine(state, "        }")
    emitLine(state, "        delivered++;")
    emitLine(state, "    }")
    emitLine(state, "    karkain_conc_atomic_store(&a->queued, 0);")
    emitLine(state, "    karkain_mutex_unlock(&a->dwq_lock);")
    emitLine(state, "")
    emitLine(state, "    if (delivered > 0) karkain_sched_pending_dec(s, delivered);")
    emitLine(state, "")
    emitLine(state, "    /* A message may have arrived while we drained; re-queue under the flag. */")
    emitLine(state, "    karkain_mutex_lock(&a->mailbox.lock);")
    emitLine(state, "    int more = (a->mailbox.size > 0) && !karkain_conc_atomic_load(&a->stopped);")
    emitLine(state, "    karkain_mutex_unlock(&a->mailbox.lock);")
    emitLine(state, "    if (more) karkain_sched_enqueue_actor(a);")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "/* ---------------------------------------------------------------------")
    emitLine(state, " * Task lifecycle")
    emitLine(state, " * ------------------------------------------------------------------- */")
    emitLine(state, "")
    emitLine(state, "karkain_task_t* karkain_sched_spawn(karkain_sched_t* s, karkain_run_fn fn, void* ctx) {")
    emitLine(state, "    karkain_task_t* t = (karkain_task_t*)calloc(1, sizeof(karkain_task_t));")
    emitLine(state, "    if (!t) return NULL;")
    emitLine(state, "    t->fn = fn;")
    emitLine(state, "    t->ctx = ctx;")
    emitLine(state, "    karkain_mutex_init(&t->lock);")
    emitLine(state, "    karkain_cond_init(&t->cv);")
    emitLine(state, "")
    emitLine(state, "    karkain_mutex_lock(&s->lock);")
    emitLine(state, "    t->next = s->tasks_head;")
    emitLine(state, "    s->tasks_head = t;")
    emitLine(state, "    karkain_mutex_unlock(&s->lock);")
    emitLine(state, "")
    emitLine(state, "    karkain_conc_atomic_fetch_add(&s->pending, 1);")
    emitLine(state, "    karkain_run_t* r = (karkain_run_t*)malloc(sizeof(karkain_run_t));")
    emitLine(state, "    r->is_actor = 0;")
    emitLine(state, "    r->task = t;")
    emitLine(state, "    r->actor = NULL;")
    emitLine(state, "    r->next = NULL;")
    emitLine(state, "    karkain_sched_push_run(s, r);")
    emitLine(state, "    return t;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "int karkain_task_join(karkain_task_t* t) {")
    emitLine(state, "    if (!t) return -2;")
    emitLine(state, "    karkain_mutex_lock(&t->lock);")
    emitLine(state, "    while (!karkain_conc_atomic_load(&t->done)) {")
    emitLine(state, "        karkain_cond_wait(&t->cv, &t->lock);")
    emitLine(state, "    }")
    emitLine(state, "    long status = t->status;")
    emitLine(state, "    karkain_mutex_unlock(&t->lock);")
    emitLine(state, "    return (int)status;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "void karkain_wait_all(karkain_sched_t* s) {")
    emitLine(state, "    karkain_mutex_lock(&s->lock);")
    emitLine(state, "    while (karkain_conc_atomic_load(&s->pending) != 0) {")
    emitLine(state, "        karkain_cond_wait(&s->drained, &s->lock);")
    emitLine(state, "    }")
    emitLine(state, "    karkain_mutex_unlock(&s->lock);")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "static void karkain_run_task(karkain_sched_t* s, karkain_task_t* t) {")
    emitLine(state, "    t->fn(t, t->ctx, s);")
    emitLine(state, "    free(t->ctx); /* ctx is heap-owned by the runtime (codegen wrapper allocates) */")
    emitLine(state, "    t->ctx = NULL;")
    emitLine(state, "    karkain_conc_atomic_store(&t->done, 1);")
    emitLine(state, "    karkain_mutex_lock(&t->lock);")
    emitLine(state, "    karkain_cond_broadcast(&t->cv);")
    emitLine(state, "    karkain_mutex_unlock(&t->lock);")
    emitLine(state, "    karkain_sched_pending_dec(s, 1);")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "/* ---------------------------------------------------------------------")
    emitLine(state, " * Worker loop")
    emitLine(state, " * ------------------------------------------------------------------- */")
    emitLine(state, "")
    emitLine(state, "static void karkain_worker_loop(void* arg) {")
    emitLine(state, "    karkain_worker_t* w = (karkain_worker_t*)arg;")
    emitLine(state, "    karkain_sched_t* s = w->sched;")
    emitLine(state, "    conc_self = w;")
    emitLine(state, "")
    emitLine(state, "    for (;;) {")
    emitLine(state, "        if (karkain_conc_atomic_load(&s->stopping) &&")
    emitLine(state, "            karkain_conc_atomic_load(&s->pending) == 0) {")
    emitLine(state, "            break;")
    emitLine(state, "        }")
    emitLine(state, "        karkain_run_t* r = karkain_sched_pop_local(s);")
    emitLine(state, "        if (!r) r = karkain_sched_steal(s, w->id);")
    emitLine(state, "")
    emitLine(state, "        if (r) {")
    emitLine(state, "            if (r->is_actor) {")
    emitLine(state, "                karkain_sched_drain_actor(s, r->actor);")
    emitLine(state, "            } else {")
    emitLine(state, "                karkain_run_task(s, r->task);")
    emitLine(state, "            }")
    emitLine(state, "            free(r);")
    emitLine(state, "            continue;")
    emitLine(state, "        }")
    emitLine(state, "")
    emitLine(state, "        /* Nothing runnable anywhere: sleep on a bounded timed wait, then")
    emitLine(state, "         * re-scan (no busy spin). finish() broadcasts to wake quickly. */")
    emitLine(state, "        karkain_mutex_lock(&s->lock);")
    emitLine(state, "        while (!karkain_conc_atomic_load(&s->stopping) && s->global_count == 0) {")
    emitLine(state, "            karkain_cond_timedwait(&s->work_avail, &s->lock, 2);")
    emitLine(state, "        }")
    emitLine(state, "        karkain_mutex_unlock(&s->lock);")
    emitLine(state, "    }")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "/* ---------------------------------------------------------------------")
    emitLine(state, " * Bootstrap / shutdown")
    emitLine(state, " * ------------------------------------------------------------------- */")
    emitLine(state, "")
    emitLine(state, "static karkain_sched_t* g_sched;")
    emitLine(state, "/* One-time init guard: the very first caller creates the scheduler. */")
    emitLine(state, "static atomic_flag g_init_lock = ATOMIC_FLAG_INIT;")
    emitLine(state, "")
    emitLine(state, "karkain_sched_t* karkain_conc_init(void) {")
    emitLine(state, "    while (atomic_flag_test_and_set_explicit(&g_init_lock,")
    emitLine(state, "                                             memory_order_acquire)) {")
    emitLine(state, "        karkain_thread_yield();")
    emitLine(state, "    }")
    emitLine(state, "    karkain_sched_t* s = g_sched;")
    emitLine(state, "    if (!s) {")
    emitLine(state, "        s = (karkain_sched_t*)calloc(1, sizeof(karkain_sched_t));")
    emitLine(state, "        s->nworkers = karkain_conc_default_workers();")
    emitLine(state, "        karkain_mutex_init(&s->lock);")
    emitLine(state, "        karkain_cond_init(&s->work_avail);")
    emitLine(state, "        karkain_cond_init(&s->drained);")
    emitLine(state, "        s->workers = (karkain_worker_t*)calloc((size_t)s->nworkers,")
    emitLine(state, "                                               sizeof(karkain_worker_t));")
    emitLine(state, "        for (long i = 0; i < s->nworkers; i++) {")
    emitLine(state, "            s->workers[i].sched = s;")
    emitLine(state, "            s->workers[i].id = i;")
    emitLine(state, "            karkain_mutex_init(&s->workers[i].lock);")
    emitLine(state, "        }")
    emitLine(state, "        for (long i = 0; i < s->nworkers; i++) {")
    emitLine(state, "            s->workers[i].thread =")
    emitLine(state, "                karkain_thread_create(karkain_worker_loop, &s->workers[i]);")
    emitLine(state, "        }")
    emitLine(state, "        g_sched = s;")
    emitLine(state, "    }")
    emitLine(state, "    atomic_flag_clear_explicit(&g_init_lock, memory_order_release);")
    emitLine(state, "    return g_sched;")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "int karkain_conc_finish(void) {")
    emitLine(state, "    karkain_sched_t* s = g_sched;")
    emitLine(state, "    if (!s) return 0;")
    emitLine(state, "")
    emitLine(state, "    /* Wait for every outstanding task and actor message to complete. */")
    emitLine(state, "    karkain_wait_all(s);")
    emitLine(state, "")
    emitLine(state, "    karkain_conc_atomic_store(&s->stopping, 1);")
    emitLine(state, "    karkain_mutex_lock(&s->lock);")
    emitLine(state, "    karkain_cond_broadcast(&s->work_avail);")
    emitLine(state, "    karkain_mutex_unlock(&s->lock);")
    emitLine(state, "")
    emitLine(state, "    for (long i = 0; i < s->nworkers; i++) {")
    emitLine(state, "        karkain_thread_join(s->workers[i].thread);")
    emitLine(state, "    }")
    emitLine(state, "")
    emitLine(state, "    /* Release bookkeeping. The process is exiting, but we still clean up so")
    emitLine(state, "     * the runtime itself is leak-clean for sanitizer runs. */")
    emitLine(state, "    karkain_task_t* t = s->tasks_head;")
    emitLine(state, "    while (t) {")
    emitLine(state, "        karkain_task_t* next = t->next;")
    emitLine(state, "        karkain_mutex_destroy(&t->lock);")
    emitLine(state, "        karkain_cond_destroy(&t->cv);")
    emitLine(state, "        free(t->ctx);")
    emitLine(state, "        free(t);")
    emitLine(state, "        t = next;")
    emitLine(state, "    }")
    emitLine(state, "    karkain_actor_t* a = s->actors_head;")
    emitLine(state, "    while (a) {")
    emitLine(state, "        karkain_actor_t* next = a->next;")
    emitLine(state, "        free(a->udata);")
    emitLine(state, "        karkain_channel_release(&a->mailbox);")
    emitLine(state, "        karkain_mutex_destroy(&a->state_lock);")
    emitLine(state, "        karkain_mutex_destroy(&a->dwq_lock);")
    emitLine(state, "        free(a);")
    emitLine(state, "        a = next;")
    emitLine(state, "    }")
    emitLine(state, "    karkain_channel_t* c = s->channels_head;")
    emitLine(state, "    while (c) {")
    emitLine(state, "        karkain_channel_t* next = c->next;")
    emitLine(state, "        karkain_channel_destroy(c);")
    emitLine(state, "        c = next;")
    emitLine(state, "    }")
    emitLine(state, "")
    emitLine(state, "    for (long i = 0; i < s->nworkers; i++) {")
    emitLine(state, "        karkain_mutex_destroy(&s->workers[i].lock);")
    emitLine(state, "    }")
    emitLine(state, "    free(s->workers);")
    emitLine(state, "    karkain_mutex_destroy(&s->lock);")
    emitLine(state, "    karkain_cond_destroy(&s->work_avail);")
    emitLine(state, "    karkain_cond_destroy(&s->drained);")
    emitLine(state, "    free(s);")
    emitLine(state, "    g_sched = NULL;")
    emitLine(state, "    return 0;")
    emitLine(state, "}")
}

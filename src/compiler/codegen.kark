// Phase 40: Self-hosted Karkain Code Generator
// Generates C23, WGSL, OpenCL, OpenQASM 3.0, QIR, and .kbc bytecode target code
// Imports: ast.kark

// ============================================================
// Codegen state
// ============================================================

func createCodegenState(target) {
    let state = []
    state = appendArray(state, target)   // 0: target ("c23", "wgsl", "opencl", "spirv")
    state = appendArray(state, "")       // 1: output buffer
    state = appendArray(state, 0)        // 2: indent level
    state = appendArray(state, [])       // 3: errors
    state = appendArray(state, [])       // 4: includes
    state = appendArray(state, [])       // 5: globals
    state = appendArray(state, [])       // 6: functions
    state = appendArray(state, [])       // 7: kernels
    state = appendArray(state, "")       // 8: current function name
    return state
}

func codegenTarget(state) { return state[0] }
func codegenOutput(state) { return state[1] }
func codegenIndent(state) { return state[2] }
func codegenErrors(state) { return state[3] }
func codegenIncludes(state) { return state[4] }
func codegenGlobals(state) { return state[5] }
func codegenFunctions(state) { return state[6] }
func codegenKernels(state) { return state[7] }
func codegenCurrentFunc(state) { return state[8] }

func setCodegenOutput(state, output) { state[1] = output }
func setCodegenIndent(state, indent) { state[2] = indent }
func setCodegenCurrentFunc(state, name) { state[8] = name }

func emit(state, text) {
    state[1] = codegenOutput(state) + text
}

func emitLine(state, text) {
    let indentStr = ""
    let i = 0
    while (i < codegenIndent(state)) {
        indentStr = indentStr + "  "
        i = i + 1
    }
    state[1] = codegenOutput(state) + indentStr + text + "\n"
}

func emitNewline(state) {
    state[1] = codegenOutput(state) + "\n"
}

func addCodegenError(state, msg) {
    state[3] = appendArray(codegenErrors(state), msg)
}

// ============================================================
// C11 Code Generation
// ============================================================

func emitC11Preamble(state) {
    emitLine(state, "// Generated by Karkain Compiler v0.14.0")
    emitLine(state, "#include <stdio.h>")
    emitLine(state, "#include <stdlib.h>")
    emitLine(state, "#include <string.h>")
    emitLine(state, "#include <math.h>")
    emitLine(state, "#include <stdarg.h>")
    emitLine(state, "#include <dirent.h>")
    emitNewline(state)
    emitLine(state, "static int _karkain_gargc = 0;")
    emitLine(state, "static char** _karkain_gargv = 0;")
    emitNewline(state)
}

// Canonical Value runtime emitted by the self-hosted emitC11 backend. Mirrors
// the Value model used by the Go bootstrap backend so that generated programs
// are dynamic, self-contained, and compile with `gcc -std=c2x -lm -lgmp`.
func emitC11ValueRuntime(state) {
    emitLine(state, "typedef enum { TYPE_INT, TYPE_FLOAT64, TYPE_STRING, TYPE_ARRAY, TYPE_MAP, TYPE_BOOL } ValueType;")
    emitLine(state, "typedef struct Value {")
    emitLine(state, "    ValueType type;")
    emitLine(state, "    long long intVal;")
    emitLine(state, "    double floatVal;")
    emitLine(state, "    char* strVal;")
    emitLine(state, "    struct Value** items;")
    emitLine(state, "    int length;")
    emitLine(state, "    char** keys;")
    emitLine(state, "    struct Value** values;")
    emitLine(state, "    int mlen;")
    emitLine(state, "} Value;")
    emitNewline(state)
    emitLine(state, "static Value make_int(long long v) { Value r; r.type=TYPE_INT; r.intVal=v; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_float(double v) { Value r; r.type=TYPE_FLOAT64; r.floatVal=v; r.intVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_bool(long long v) { Value r; r.type=TYPE_BOOL; r.intVal=v; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_string(const char* s) { Value r; r.type=TYPE_STRING; r.intVal=0; r.floatVal=0; r.strVal=strdup(s?s:\"\"); r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_array(void) { Value r; r.type=TYPE_ARRAY; r.intVal=0; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_map(void) { Value r; r.type=TYPE_MAP; r.intVal=0; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value mk_nil(void) { Value r; r.type=TYPE_INT; r.intVal=0; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static void array_push(Value* a, Value e) { Value* c=(Value*)malloc(sizeof(Value)); *c=e; a->length++; a->items=(Value**)realloc(a->items,sizeof(Value*)*a->length); a->items[a->length-1]=c; }")
    emitLine(state, "static Value karkain_slice(Value v, Value s, Value e) { long long start=(s.type==TYPE_INT)?s.intVal:0; long long end=(e.type==TYPE_INT)?e.intVal:-1; if(v.type==TYPE_STRING){ long long n=(long long)strlen(v.strVal?v.strVal:\"\"); if(end<0) end+=n+1; if(start<0) start=0; if(end>n) end=n; if(start>=end||start>=n) return make_string(\"\"); long long len=end-start; char* buf=(char*)malloc((size_t)len+1); memcpy(buf,v.strVal+start,(size_t)len); buf[len]=0; Value r=make_string(buf); free(buf); return r; } if(v.type==TYPE_ARRAY){ long long n=(long long)v.length; if(end<0) end+=n+1; if(start<0) start=0; if(end>n) end=n; Value out=make_array(); if(start<end){ long long i; for(i=start;i<end;i++) array_push(&out,*v.items[i]); } return out; } return make_int(0); }")
    emitLine(state, "static Value map_get(Value m, Value k);")
    emitLine(state, "static Value array_get(Value a, Value i) { if(a.type==TYPE_MAP) return map_get(a,i); if(a.type==TYPE_STRING&&i.type==TYPE_INT){ int si=(int)i.intVal; int sl=strlen(a.strVal?a.strVal:\"\"); if(si<0||si>=sl) return make_int(0); char c[2]={a.strVal[si],0}; return make_string(c); } if(a.type!=TYPE_ARRAY) return make_int(0); int idx=(int)i.intVal; if(idx<0||idx>=a.length) return make_int(0); return *a.items[idx]; }")
    emitLine(state, "static void array_set(Value* a, Value i, Value v) { if(!a||a->type!=TYPE_ARRAY) return; int idx=(int)i.intVal; if(idx<0||idx>=a->length) return; *(a->items[idx])=v; }")
    emitLine(state, "static int is_truthy(Value v) { if(v.type==TYPE_BOOL||v.type==TYPE_INT) return v.intVal!=0; if(v.type==TYPE_FLOAT64) return v.floatVal!=0.0; if(v.type==TYPE_STRING) return v.strVal&&v.strVal[0]!=0; if(v.type==TYPE_ARRAY) return v.length>0; return 0; }")
    emitLine(state, "static Value karkain_len(Value v) { if(v.type==TYPE_ARRAY) return make_int(v.length); if(v.type==TYPE_MAP) return make_int(v.mlen); if(v.type==TYPE_STRING) return make_int(strlen(v.strVal?v.strVal:\"\")); return make_int(0); }")
    emitLine(state, "static Value map_get(Value m, Value k) { if(m.type!=TYPE_MAP) return make_int(0); const char* key=k.strVal?k.strVal:\"\"; int i; for(i=0;i<m.mlen;i++){ if(strcmp(m.keys[i],key)==0) return *m.values[i]; } return make_int(0); }")
    emitLine(state, "static void map_set(Value* m, Value k, Value v) { if(m->type!=TYPE_MAP) return; const char* key=k.strVal?k.strVal:\"\"; int i; for(i=0;i<m->mlen;i++){ if(strcmp(m->keys[i],key)==0){ *(m->values[i])=v; return; } } m->mlen++; m->keys=(char**)realloc(m->keys,sizeof(char*)*m->mlen); m->values=(Value**)realloc(m->values,sizeof(Value*)*m->mlen); m->keys[m->mlen-1]=strdup(key); Value* c=(Value*)malloc(sizeof(Value)); *c=v; m->values[m->mlen-1]=c; }")
    emitLine(state, "static void index_set(Value* container, Value idx, Value val) { if(!container) return; if(container->type==TYPE_MAP){ map_set(container, idx, val); return; } if(container->type==TYPE_ARRAY&&idx.type==TYPE_INT){ int i=(int)idx.intVal; if(i>=0&&i<container->length){ Value* c=(Value*)malloc(sizeof(Value)); *c=val; container->items[i]=c; return; } } }")
    emitNewline(state)
    emitLine(state, "static Value values_equal(Value a, Value b);")
    emitNewline(state)
    emitLine(state, "static Value binary_op(Value l, const char* op, Value r) {")
    emitLine(state, "    if(l.type==TYPE_STRING||r.type==TYPE_STRING) {")
    emitLine(state, "        if(strcmp(op,\"+\")==0) { const char* a=l.type==TYPE_STRING?(l.strVal?l.strVal:\"\"):\"\"; const char* b=r.type==TYPE_STRING?(r.strVal?r.strVal:\"\"):\"\"; int n=strlen(a)+strlen(b)+1; char* buf=(char*)malloc(n); buf[0]=0; strcat(buf,a); strcat(buf,b); Value res=make_string(buf); free(buf); return res; }")
    emitLine(state, "        const char* a=l.type==TYPE_STRING?(l.strVal?l.strVal:\"\"):\"\"; const char* b=r.type==TYPE_STRING?(r.strVal?r.strVal:\"\"):\"\"; int c=strcmp(a,b);")
    emitLine(state, "        if(strcmp(op,\"==\")==0) return make_int(c==0); if(strcmp(op,\"!=\")==0) return make_int(c!=0);")
    emitLine(state, "        if(strcmp(op,\"<\")==0) return make_int(c<0); if(strcmp(op,\">\")==0) return make_int(c>0);")
    emitLine(state, "        if(strcmp(op,\"<=\")==0) return make_int(c<=0); if(strcmp(op,\">=\")==0) return make_int(c>=0);")
    emitLine(state, "    }")
    emitLine(state, "    if(l.type==TYPE_FLOAT64||r.type==TYPE_FLOAT64) {")
    emitLine(state, "        double a=l.type==TYPE_FLOAT64?l.floatVal:(double)l.intVal; double b=r.type==TYPE_FLOAT64?r.floatVal:(double)r.intVal;")
    emitLine(state, "        if(strcmp(op,\"+\")==0) return make_float(a+b); if(strcmp(op,\"-\")==0) return make_float(a-b);")
    emitLine(state, "        if(strcmp(op,\"*\")==0) return make_float(a*b); if(strcmp(op,\"/\")==0) return make_float(b!=0?a/b:0); if(strcmp(op,\"%\")==0) return make_float(b!=0?fmod(a,b):0);")
    emitLine(state, "        if(strcmp(op,\"==\")==0) return make_int(a==b); if(strcmp(op,\"!=\")==0) return make_int(a!=b);")
    emitLine(state, "        if(strcmp(op,\"<\")==0) return make_int(a<b); if(strcmp(op,\">\")==0) return make_int(a>b);")
    emitLine(state, "        if(strcmp(op,\"<=\")==0) return make_int(a<=b); if(strcmp(op,\">=\")==0) return make_int(a>=b);")
    emitLine(state, "    }")
    emitLine(state, "    if(l.type==TYPE_INT||l.type==TYPE_BOOL||r.type==TYPE_INT||r.type==TYPE_BOOL) {")
    emitLine(state, "        long long a=l.intVal, b=r.intVal;")
    emitLine(state, "        if(strcmp(op,\"+\")==0) return make_int(a+b); if(strcmp(op,\"-\")==0) return make_int(a-b);")
    emitLine(state, "        if(strcmp(op,\"*\")==0) return make_int(a*b); if(strcmp(op,\"/\")==0) return make_int(b!=0?a/b:0);")
    emitLine(state, "        if(strcmp(op,\"%\")==0) return make_int(b!=0?a%b:0);")
    emitLine(state, "        if(strcmp(op,\"==\")==0) return make_int(a==b); if(strcmp(op,\"!=\")==0) return make_int(a!=b);")
    emitLine(state, "        if(strcmp(op,\"<\")==0) return make_int(a<b); if(strcmp(op,\">\")==0) return make_int(a>b);")
    emitLine(state, "        if(strcmp(op,\"<=\")==0) return make_int(a<=b); if(strcmp(op,\">=\")==0) return make_int(a>=b);")
    emitLine(state, "    }")
    emitLine(state, "    if(strcmp(op,\"==\")==0) return values_equal(l,r); if(strcmp(op,\"!=\")==0) return make_int(is_truthy(values_equal(l,r))==0);")
    emitLine(state, "    if(strcmp(op,\"&&\")==0) return make_int(is_truthy(l)&&is_truthy(r)); if(strcmp(op,\"||\")==0) return make_int(is_truthy(l)||is_truthy(r));")
    emitLine(state, "    return make_int(0);")
    emitLine(state, "}")
    emitLine(state, "static Value karkain_str(Value v) { char buf[64]; if(v.type==TYPE_INT){ snprintf(buf,64,\"%lld\",v.intVal); return make_string(buf); } if(v.type==TYPE_FLOAT64){ snprintf(buf,64,\"%g\",v.floatVal); return make_string(buf); } if(v.type==TYPE_BOOL){ return make_string(v.intVal?\"true\":\"false\"); } if(v.type==TYPE_STRING){ return make_string(v.strVal?v.strVal:\"\"); } return make_string(\"?\"); }")
    emitLine(state, "static void print_value(Value v) { if(v.type==TYPE_INT) printf(\"%lld\", v.intVal); else if(v.type==TYPE_FLOAT64) printf(\"%g\", v.floatVal); else if(v.type==TYPE_BOOL) printf(\"%s\", v.intVal?\"true\":\"false\"); else if(v.type==TYPE_STRING) printf(\"%s\", v.strVal?v.strVal:\"\"); else if(v.type==TYPE_ARRAY){ printf(\"[\"); int i; for(i=0;i<v.length;i++){ if(i) printf(\", \"); print_value(*v.items[i]); } printf(\"]\"); } else printf(\"?\"); }")
    emitLine(state, "static Value _karkain_array(int n, ...) { va_list ap; va_start(ap,n); Value a=make_array(); int i; for(i=0;i<n;i++){ Value e=va_arg(ap,Value); array_push(&a,e); } va_end(ap); return a; }")
    emitLine(state, "static Value _karkain_get_args(void) { Value _args=make_array(); int _i; for(_i=0;_i<_karkain_gargc;_i++){ array_push(&_args, make_string(_karkain_gargv[_i])); } return _args; }")
    emitLine(state, "static Value karkain_listFiles(Value dir) { Value arr=make_array(); const char* dname=dir.type==TYPE_STRING?(dir.strVal?dir.strVal:\"\"):\"\"; DIR* d=opendir(dname); if(!d) return arr; struct dirent* e; while((e=readdir(d))!=NULL){ if(e->d_name[0]=='.') continue; array_push(&arr, make_string(e->d_name)); } closedir(d); return arr; }")
    emitLine(state, "static Value values_equal(Value a, Value b) { if(a.type!=b.type) return make_int(0); if(a.type==TYPE_INT||a.type==TYPE_BOOL) return make_int(a.intVal==b.intVal); if(a.type==TYPE_FLOAT64){ double d=a.floatVal-b.floatVal; return make_int(d>-1e-9&&d<1e-9); } if(a.type==TYPE_STRING) return make_int(strcmp(a.strVal?a.strVal:\"\",b.strVal?b.strVal:\"\")==0); if(a.type==TYPE_ARRAY){ if(a.length!=b.length) return make_int(0); int i; for(i=0;i<a.length;i++){ if(is_truthy(values_equal(*a.items[i],*b.items[i]))==0) return make_int(0); } return make_int(1); } return make_int(0); }")
    emitLine(state, "static Value karkain_substr(Value str, Value start, Value length) { if(str.type!=TYPE_STRING||start.type!=TYPE_INT||length.type!=TYPE_INT) return make_string(\"\"); int s=(int)start.intVal; int l=(int)length.intVal; int slen=(int)strlen(str.strVal?str.strVal:\"\"); if(s<0) s=0; if(s>=slen) return make_string(\"\"); if(s+l>slen) l=slen-s; if(l<0) l=0; char* buf=(char*)malloc(l+1); memcpy(buf,str.strVal+s,(size_t)l); buf[l]=0; Value r=make_string(buf); free(buf); return r; }")
    emitLine(state, "static void karkain_assert_report(const char* kind, const char* expr, const char* loc) { fprintf(stderr, \"%s: %s\", kind, expr); if(loc!=NULL&&loc[0]!='\\0') fprintf(stderr, \"  [%s]\", loc); fprintf(stderr, \"\\n\"); fflush(stderr); }")
    emitLine(state, "static void karkain_assert(Value cond, const char* expr, const char* loc) { if(!is_truthy(cond)) { karkain_assert_report(\"assertion failed\", expr, loc); exit(1); } }")
    emitLine(state, "static void karkain_assert_eq(Value actual, Value expected, const char* expr, const char* loc) { if(!is_truthy(values_equal(actual, expected))) { karkain_assert_report(\"assertion failed: assert_eq\", expr, loc); Value _a=karkain_str(actual); Value _e=karkain_str(expected); fprintf(stderr, \"  expected: %s\\n  actual:   %s\\n\", _e.strVal?_e.strVal:\"\", _a.strVal?_a.strVal:\"\"); fflush(stderr); exit(1); } }")
    emitLine(state, "static void karkain_assert_ne(Value actual, Value expected, const char* expr, const char* loc) { if(is_truthy(values_equal(actual, expected))) { karkain_assert_report(\"assertion failed: assert_ne\", expr, loc); Value _a=karkain_str(actual); fprintf(stderr, \"  unexpectedly equal (actual): %s\\n\", _a.strVal?_a.strVal:\"\"); fflush(stderr); exit(1); } }")
    emitLine(state, "static Value karkain_int(Value v) { if(v.type==TYPE_INT) return make_int(v.intVal); if(v.type==TYPE_FLOAT64) return make_int((long long)v.floatVal); if(v.type==TYPE_STRING) return make_int(atoll(v.strVal?v.strVal:\"\")); if(v.type==TYPE_BOOL) return make_int(v.intVal); return make_int(0); }")
    emitLine(state, "static Value karkain_system(Value cmd) { if(cmd.type!=TYPE_STRING) return make_int(-1); int result=system(cmd.strVal?cmd.strVal:\"\"); return make_int(result); }")
    emitLine(state, "static Value karkain_removeFile(Value path) { if(path.type!=TYPE_STRING) return make_int(0); int result=remove(path.strVal?path.strVal:\"\"); return make_int(result==0?1:0); }")
    emitLine(state, "static Value removeFile(Value path) { return karkain_removeFile(path); }")
    emitLine(state, "static FILE* _karkain_files[256]; static int _karkain_file_count = 0;")
    emitLine(state, "static Value openFile(Value path) { if(path.type!=TYPE_STRING) return make_string(\"\"); FILE* f=fopen(path.strVal?path.strVal:\"\",\"rb\"); if(!f) return make_string(\"\"); fclose(f); return make_string(path.strVal); }")
    emitLine(state, "static Value readLine(Value handle) { if(handle.type!=TYPE_STRING||strlen(handle.strVal?handle.strVal:\"\")==0) return make_string(\"\"); int idx=-1; int i; for(i=0;i<_karkain_file_count;i++){ if(_karkain_files[i]!=NULL){ idx=i; break; } } if(idx==-1){ if(_karkain_file_count>=256) return make_string(\"\"); idx=_karkain_file_count; _karkain_files[idx]=fopen(handle.strVal?handle.strVal:\"\",\"rb\"); _karkain_file_count++; } else if(_karkain_files[idx]==NULL){ _karkain_files[idx]=fopen(handle.strVal?handle.strVal:\"\",\"rb\"); } if(!_karkain_files[idx]) return make_string(\"\"); char buf[4096]; if(fgets(buf,sizeof(buf),_karkain_files[idx])==NULL) return make_string(\"\"); int len=(int)strlen(buf); while(len>0&&(buf[len-1]=='\\n'||buf[len-1]=='\\r')) buf[--len]='\\0'; return make_string(buf); }")
    emitLine(state, "static Value readLineEOF(Value handle) { Value r=make_array(); if(handle.type!=TYPE_STRING||strlen(handle.strVal?handle.strVal:\"\")==0){ array_push(&r,make_string(\"\")); array_push(&r,make_bool(1)); return r; } int idx=-1; int i; for(i=0;i<_karkain_file_count;i++){ if(_karkain_files[i]!=NULL){ idx=i; break; } } if(idx==-1){ if(_karkain_file_count>=256){ array_push(&r,make_string(\"\")); array_push(&r,make_bool(1)); return r; } idx=_karkain_file_count; _karkain_files[idx]=fopen(handle.strVal?handle.strVal:\"\",\"rb\"); _karkain_file_count++; } else if(_karkain_files[idx]==NULL){ _karkain_files[idx]=fopen(handle.strVal?handle.strVal:\"\",\"rb\"); } if(!_karkain_files[idx]){ array_push(&r,make_string(\"\")); array_push(&r,make_bool(1)); return r; } char buf[4096]; if(fgets(buf,sizeof(buf),_karkain_files[idx])==NULL){ array_push(&r,make_string(\"\")); array_push(&r,make_bool(1)); return r; } int len=(int)strlen(buf); while(len>0&&(buf[len-1]=='\\n'||buf[len-1]=='\\r')) buf[--len]='\\0'; array_push(&r,make_string(buf)); array_push(&r,make_bool(0)); return r; }")
    emitLine(state, "static Value closeFile(Value handle) { (void)handle; int i; for(i=0;i<_karkain_file_count;i++){ if(_karkain_files[i]!=NULL){ fclose(_karkain_files[i]); _karkain_files[i]=NULL; break; } } return make_int(1); }")
    emitLine(state, "static Value createFile(Value path) { if(path.type!=TYPE_STRING) return make_string(\"\"); FILE* f=fopen(path.strVal?path.strVal:\"\",\"wb\"); if(f) fclose(f); return make_string(path.strVal); }")
    emitLine(state, "static Value writeToFile(Value handle, Value content) { if(handle.type!=TYPE_STRING||content.type!=TYPE_STRING) return make_int(0); FILE* f=fopen(handle.strVal?handle.strVal:\"\",\"wb\"); if(!f) return make_int(0); fputs(content.strVal?content.strVal:\"\",f); fclose(f); return make_int(1); }")
    emitLine(state, "static Value karkain_readFile(Value path) { if(path.type!=TYPE_STRING) return make_string(\"\"); FILE* f=fopen(path.strVal?path.strVal:\"\",\"rb\"); if(!f) return make_string(\"\"); fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET); char* buf=(char*)malloc(sz+1); if(sz>0) fread(buf,1,sz,f); fclose(f); buf[sz]='\\0'; Value res=make_string(buf); free(buf); return res; }")
    emitLine(state, "static Value karkain_writeFile(Value path, Value content) { if(path.type!=TYPE_STRING) return make_int(0); FILE* f=fopen(path.strVal?path.strVal:\"\",\"wb\"); if(!f) return make_int(0); const char* str=(content.type==TYPE_STRING)?(content.strVal?content.strVal:\"\"):\"\"; fputs(str,f); fclose(f); return make_int(1); }")
    emitLine(state, "static Value karkain_trim(Value str) { if(str.type!=TYPE_STRING) return make_string(\"\"); char* s=str.strVal?str.strVal:\"\"; char* start=s; char* end=s+strlen(s)-1; while(start<=end&&(*start==' '||*start=='\\t'||*start=='\\n'||*start=='\\r')) start++; while(end>=start&&(*end==' '||*end=='\\t'||*end=='\\n'||*end=='\\r')) end--; size_t len=(end>=start)?(end-start+1):0; char* buf=(char*)malloc(len+1); if(len>0) memcpy(buf,start,len); buf[len]='\\0'; Value res=make_string(buf); free(buf); return res; }")
    emitLine(state, "static Value karkain_contains(Value haystack, Value needle) { if(haystack.type!=TYPE_STRING||needle.type!=TYPE_STRING) return make_int(0); return make_int(strstr(haystack.strVal?haystack.strVal:\"\",needle.strVal?needle.strVal:\"\")!=NULL); }")
    emitLine(state, "static Value karkain_split(Value str, Value delim) { if(str.type!=TYPE_STRING||delim.type!=TYPE_STRING) return make_array(); Value arr=make_array(); char* s=strdup(str.strVal?str.strVal:\"\"); char* d=delim.strVal?delim.strVal:\"\"; char* token=strtok(s,d); while(token!=NULL){ array_push(&arr,make_string(token)); token=strtok(NULL,d); } free(s); return arr; }")
    emitLine(state, "static Value karkain_sqrt(Value v) { if(v.type!=TYPE_INT) return make_int(0); return make_int((long long)sqrt((double)v.intVal)); }")
    emitLine(state, "static Value karkain_abs(Value v) { if(v.type!=TYPE_INT) return make_int(0); return make_int(v.intVal>=0?v.intVal:-v.intVal); }")
    emitLine(state, "static Value karkain_pow(Value base, Value exp) { if(base.type!=TYPE_INT||exp.type!=TYPE_INT) return make_int(0); long long result=1; long long b=base.intVal; long long e=exp.intVal; while(e>0){ if(e&1) result*=b; b*=b; e>>=1; } return make_int(result); }")
    emitLine(state, "static Value karkain_hasKey(Value m, Value k) { if(m.type!=TYPE_MAP) return make_int(0); int i; for(i=0;i<m.mlen;i++){ const char* key=k.strVal?k.strVal:\"\"; if(strcmp(m.keys[i],key)==0) return make_int(1); } return make_int(0); }")
    emitLine(state, "static void karkain_delete(Value* m, Value k) { if(!m||m->type!=TYPE_MAP) return; const char* key=k.strVal?k.strVal:\"\"; int i; for(i=0;i<m->mlen;i++){ if(strcmp(m->keys[i],key)==0){ int j; for(j=i;j<m->mlen-1;j++){ m->keys[j]=m->keys[j+1]; m->values[j]=m->values[j+1]; } m->mlen--; return; } } }")
    emitLine(state, "static Value karkain_appendArray(Value* arr, Value elem) { if(!arr||arr->type!=TYPE_ARRAY) return make_int(0); array_push(arr, elem); return *arr; }")
    emitNewline(state)
}

// All Karkain values are represented dynamically as `Value` in the emitted C.
func emitC11Type(varType) {
    return "Value"
}

func emitC11Expr(state, node) {
    let nt = getNodeType(node)

    if (nt == "IntLiteral") { emit(state, "make_int(" + literalValue(node) + ")") }
    if (nt == "FloatLiteral") { emit(state, "make_float(" + literalValue(node) + ")") }
    if (nt == "StringLiteral") {
        emit(state, "make_string(\"" + literalValue(node) + "\")")
    }
    if (nt == "BoolLiteral") {
        if (literalValue(node) == "true") { emit(state, "make_bool(1)") }
        if (literalValue(node) == "false") { emit(state, "make_bool(0)") }
    }
    if (nt == "Ident") { emit(state, identName(node)) }

    if (nt == "BinaryExpr") {
        if (binaryOp(node) == "=") {
            let lhs = binaryLeft(node)
            let rv = binaryRight(node)
            if (getNodeType(lhs) == "Index") {
                let il = indexLeft(lhs)
                let ix = indexExpr(lhs)
                if (getNodeType(il) == "Ident") {
                    emit(state, "index_set(&" + identName(il) + ", ")
                    emitC11Expr(state, ix)
                    emit(state, ", ")
                    emitC11Expr(state, rv)
                    emit(state, ")")
                } else {
                    emit(state, "({ Value _iset_tgt = ")
                    emitC11Expr(state, il)
                    emit(state, "; index_set(&_iset_tgt, ")
                    emitC11Expr(state, ix)
                    emit(state, ", ")
                    emitC11Expr(state, rv)
                    emit(state, "); _iset_tgt; })")
                }
            } else if (getNodeType(lhs) == "Member") {
                let dl = dotLeft(lhs)
                let dn = dotRight(lhs)
                if (getNodeType(dl) == "Ident") {
                    emit(state, "map_set(&" + identName(dl) + ", make_string(\"" + dn + "\"), ")
                    emitC11Expr(state, rv)
                    emit(state, ")")
                } else {
                    emit(state, "({ Value _ms_tgt = ")
                    emitC11Expr(state, dl)
                    emit(state, "; map_set(&_ms_tgt, make_string(\"" + dn + "\"), ")
                    emitC11Expr(state, rv)
                    emit(state, "); _ms_tgt; })")
                }
            } else {
                emit(state, "(")
                emitC11Expr(state, lhs)
                emit(state, " = ")
                emitC11Expr(state, rv)
                emit(state, ")")
            }
        } else {
            emit(state, "binary_op(")
            emitC11Expr(state, binaryLeft(node))
            emit(state, ", \"" + binaryOp(node) + "\", ")
            emitC11Expr(state, binaryRight(node))
            emit(state, ")")
        }
    }

    if (nt == "UnaryExpr") {
        let op = unaryOp(node)
        if (op == "!") {
            emit(state, "make_bool(!is_truthy(")
            emitC11Expr(state, unaryOperand(node))
            emit(state, "))")
        }
        if (op == "-") {
            emit(state, "binary_op(make_int(0), \"-\", ")
            emitC11Expr(state, unaryOperand(node))
            emit(state, ")")
        }
    }

    if (nt == "Call") {
        let fname = callFunc(node)
        let args = callArgs(node)
        let argc = len(args)

        if (fname == "getArgs") {
            emit(state, "_karkain_get_args()")
        } else if (hasUserFunc(state, fname)) {
            emit(state, "karkain_user_" + fname + "(")
            let au = 0
            while (au < argc) {
                if (au > 0) { emit(state, ", ") }
                emitC11Expr(state, args[au])
                au = au + 1
            }
            emit(state, ")")
        } else if (fname == "len") {
            emit(state, "karkain_len(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "str") {
            emit(state, "karkain_str(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "int") {
            emit(state, "karkain_int(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "substr") {
            emit(state, "karkain_substr(")
            let a0 = 0
            while (a0 < argc) {
                if (a0 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a0])
                a0 = a0 + 1
            }
            emit(state, ")")
        } else if (fname == "system") {
            emit(state, "karkain_system(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "removeFile") {
            emit(state, "removeFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "readFile") {
            emit(state, "karkain_readFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "writeFile") {
            emit(state, "karkain_writeFile(")
            let a1 = 0
            while (a1 < argc) {
                if (a1 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a1])
                a1 = a1 + 1
            }
            emit(state, ")")
        } else if (fname == "trim") {
            emit(state, "karkain_trim(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "contains") {
            emit(state, "karkain_contains(")
            let a2 = 0
            while (a2 < argc) {
                if (a2 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a2])
                a2 = a2 + 1
            }
            emit(state, ")")
        } else if (fname == "split") {
            emit(state, "karkain_split(")
            let a3 = 0
            while (a3 < argc) {
                if (a3 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a3])
                a3 = a3 + 1
            }
            emit(state, ")")
        } else if (fname == "listFiles") {
            emit(state, "karkain_listFiles(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "openFile") {
            emit(state, "openFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "readLine") {
            emit(state, "readLine(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "readLineEOF") {
            emit(state, "readLineEOF(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "closeFile") {
            emit(state, "closeFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "createFile") {
            emit(state, "createFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "writeToFile") {
            emit(state, "writeToFile(")
            let a4 = 0
            while (a4 < argc) {
                if (a4 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a4])
                a4 = a4 + 1
            }
            emit(state, ")")
        } else if (fname == "hasKey") {
            emit(state, "karkain_hasKey(")
            let a5 = 0
            while (a5 < argc) {
                if (a5 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a5])
                a5 = a5 + 1
            }
            emit(state, ")")
        } else if (fname == "appendArray" || fname == "push") {
            if (argc > 0 && getNodeType(args[0]) == "Ident") {
                emit(state, "karkain_appendArray(&" + identName(args[0]) + ", ")
                if (argc > 1) { emitC11Expr(state, args[1]) }
                emit(state, ")")
            } else {
                emit(state, "({ Value _ap_arr = ")
                if (argc > 0) { emitC11Expr(state, args[0]) }
                emit(state, "; karkain_appendArray(&_ap_arr, ")
                if (argc > 1) { emitC11Expr(state, args[1]) }
                emit(state, "); _ap_arr; })")
            }
        } else if (fname == "delete") {
            emit(state, "karkain_delete(&")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ", ")
            if (argc > 1) { emitC11Expr(state, args[1]) }
            emit(state, ")")
        } else if (fname == "sqrt") {
            emit(state, "karkain_sqrt(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "abs") {
            emit(state, "karkain_abs(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "assert" || fname == "assert_eq" || fname == "assert_ne") {
            let albl = "assert(condition)"
            if (fname == "assert_eq") { albl = "assert_eq(actual, expected)" }
            if (fname == "assert_ne") { albl = "assert_ne(actual, expected)" }
            emit(state, "karkain_" + fname + "(")
            let ai = 0
            while (ai < argc) {
                if (ai > 0) { emit(state, ", ") }
                emitC11Expr(state, args[ai])
                ai = ai + 1
            }
            emit(state, ", \"" + albl + "\", \"\")")
        } else if (fname == "pow") {
            emit(state, "karkain_pow(")
            let a6 = 0
            while (a6 < argc) {
                if (a6 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a6])
                a6 = a6 + 1
            }
            emit(state, ")")
        } else {
            emit(state, fname + "(")
            let i = 0
            while (i < argc) {
                if (i > 0) { emit(state, ", ") }
                emitC11Expr(state, args[i])
                i = i + 1
            }
            emit(state, ")")
        }
    }

    if (nt == "GlobalId") {
        let dim = globalIdDim(node)
        emit(state, "get_global_id(")
        emitC11Expr(state, dim)
        emit(state, ")")
    }

    if (nt == "Member") {
        emit(state, "map_get(")
        emitC11Expr(state, memberObject(node))
        emit(state, ", make_string(\"" + memberField(node) + "\"))")
    }

    if (nt == "Index") {
        emit(state, "array_get(")
        emitC11Expr(state, indexLeft(node))
        emit(state, ", ")
        emitC11Expr(state, indexExpr(node))
        emit(state, ")")
    }

    if (nt == "Slice") {
        emit(state, "karkain_slice(")
        emitC11Expr(state, sliceLeft(node))
        emit(state, ", ")
        emitC11Expr(state, sliceStart(node))
        emit(state, ", ")
        emitC11Expr(state, sliceEnd(node))
        emit(state, ")")
    }

    if (nt == "ArrayLiteral") {
        let elems = arrayElements(node)
        emit(state, "_karkain_array(" + str(len(elems)))
        let i = 0
        while (i < len(elems)) {
            emit(state, ", ")
            emitC11Expr(state, elems[i])
            i = i + 1
        }
        emit(state, ")")
    }

    if (nt == "MapLiteral") {
        emit(state, "({ Value _m = make_map(); ")
        let ks = mapKeys(node)
        let vs = mapValues(node)
        let i = 0
        while (i < len(ks)) {
            emit(state, "map_set(&_m, ")
            emitC11Expr(state, ks[i])
            emit(state, ", ")
            emitC11Expr(state, vs[i])
            emit(state, "); ")
            i = i + 1
        }
        emit(state, "_m; })")
    }

    if (nt == "StructLiteral") {
        emit(state, "({ Value _s = make_map(); ")
        let fs = structLitFields(node)
        let i = 0
        while (i < len(fs)) {
            let f = fs[i]
            if (getNodeType(f) == "BinaryExpr") {
                let fl = binaryLeft(f)
                if (getNodeType(fl) == "Ident") {
                    emit(state, "map_set(&_s, make_string(\"" + identName(fl) + "\"), ")
                    emitC11Expr(state, binaryRight(f))
                    emit(state, "); ")
                }
            }
            i = i + 1
        }
        emit(state, "_s; })")
    }
}

func emitC11Stmt(state, node) {
    let nt = getNodeType(node)

    if (nt == "VarDecl") {
        emitLine(state, "Value " + varDeclName(node) + " = ")
        emitC11Expr(state, varDeclValue(node))
        emit(state, ";")
    }

    if (nt == "LetDecl") {
        emitLine(state, "Value " + letDeclName(node) + " = ")
        emitC11Expr(state, letDeclValue(node))
        emit(state, ";")
    }

    if (nt == "Return") {
        if (codegenCurrentFunc(state) == "main") {
            emitLine(state, "return 0;")
        } else {
            emit(state, "return ")
            let rv = returnExpr(node)
            if (len(rv) == 0) { emit(state, "mk_nil()") } else { emitC11Expr(state, rv) }
            emitLine(state, ";")
        }
    }

    if (nt == "Print") {
        emit(state, "print_value(")
        emitC11Expr(state, printExpr(node))
        emitLine(state, "); printf(\"\\n\");")
    }

    if (nt == "ExprStmt") {
        emit(state, "")
        emitC11Expr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }

    if (nt == "Break") {
        emitLine(state, "break;")
    }

    if (nt == "Continue") {
        emitLine(state, "continue;")
    }

    if (nt == "BinaryExpr") {
        emitC11Expr(state, node)
    }

    if (nt == "If") {
        emit(state, "if (is_truthy(")
        emitC11Expr(state, ifCondition(node))
        emit(state, ")) {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitC11Stmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        let elseB = ifElse(node)
        if (len(elseB) > 0) {
            emitLine(state, "} else {")
            state[2] = codegenIndent(state) + 1
            i = 0
            while (i < len(elseB)) {
                emitC11Stmt(state, elseB[i])
                i = i + 1
            }
            state[2] = codegenIndent(state) - 1
        }
        emitLine(state, "}")
    }

    if (nt == "While") {
        emit(state, "while (is_truthy(")
        emitC11Expr(state, whileCondition(node))
        emit(state, ")) {")
        state[2] = codegenIndent(state) + 1
        let body = whileBody(node)
        let i = 0
        while (i < len(body)) {
            emitC11Stmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "For") {
        emit(state, "for (")
        emitC11Stmt(state, forInit(node))
        emitC11Expr(state, forCondition(node))
        emit(state, "; ")
        emitC11Expr(state, forPost(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = forBody(node)
        let i = 0
        while (i < len(body)) {
            emitC11Stmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "Barrier") {
        emitLine(state, "__syncthreads();")
    }

    if (nt == "FuncDecl") {
        let fnName = funcName(node)
        let params = funcParams(node)
        state[8] = fnName
        if (fnName == "main") {
            emitLine(state, "int main(int _karkain_argc, char** _karkain_argv) {")
            state[2] = codegenIndent(state) + 1
            emitLine(state, "_karkain_gargc = _karkain_argc; _karkain_gargv = _karkain_argv;")
        } else {
            let rtype = emitC11Type(funcReturnType(node))
            emit(state, rtype + " " + emitC11FuncSymbol(fnName) + "(")
            let i = 0
            while (i < len(params)) {
                if (i > 0) { emit(state, ", ") }
                emit(state, "Value " + params[i])
                i = i + 1
            }
            emitLine(state, ") {")
            state[2] = codegenIndent(state) + 1
        }
        let body = funcBody(node)
        let i = 0
        while (i < len(body)) {
            emitC11Stmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
        state[8] = ""
    }

    if (nt == "KernelDecl") {
        emit(state, "__kernel void " + kernelName(node) + "(")
        let params = kernelParams(node)
        let i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, emitC11Type("") + " " + params[i])
            i = i + 1
        }
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = kernelBody(node)
        i = 0
        while (i < len(body)) {
            emitC11Stmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "StructDecl") {
        emitLine(state, "// struct " + structName(node) + " { ")
        emitNewline(state)
    }
}

// Deterministic C symbol for user-defined Karkain functions (Phase 83).
// User code lives under the karkain_user_* namespace so user functions can
// never collide with the karkain_* runtime helpers; `main`/`getArgs` keep their
// canonical names. Mirrors the Go backend's userFuncC exactly so the
// self-hosted compiler and the reference backend emit byte-identical output.
func emitC11FuncSymbol(fnName) {
    if (fnName == "main") {
        return fnName
    }
    if (fnName == "getArgs") {
        return fnName
    }
    return "karkain_user_" + fnName
}

// Phase 83: register a user function name for builtin shadowing. The registry
// is fully populated by the forward-declaration pass (which runs before any
// function body is emitted), so call emission can resolve user-vs-builtin.
func registerUserFunc(state, fnName) {
    if (fnName != "main") {
        if (fnName != "getArgs") {
            state[6] = appendArray(state[6], fnName)
        }
    }
}

func hasUserFunc(state, fname) {
    let funcs = codegenFunctions(state)
    let i = 0
    while (i < len(funcs)) {
        if (funcs[i] == fname) {
            return 1
        }
        i = i + 1
    }
    return 0
}

func generateC11(ast) {
    let state = createCodegenState("c11")
    emitC11Preamble(state)
    emitC11ValueRuntime(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        if (getNodeType(stmts[i]) == "FuncDecl") {
            emitC11ForwardDecl(state, stmts[i])
        }
        i = i + 1
    }
    emitNewline(state)

    i = 0
    while (i < len(stmts)) {
        emitC11Stmt(state, stmts[i])
        i = i + 1
    }

    return codegenOutput(state)
}

// Forward declaration so functions can call each other regardless of
// definition order (mirrors the Go backend's Phase 40 pass).
func emitC11ForwardDecl(state, node) {
    let fnName = funcName(node)
    registerUserFunc(state, fnName)
    if (fnName == "main") {
        emitLine(state, "int main(int _karkain_argc, char** _karkain_argv);")
        return
    }
    let rtype = emitC11Type(funcReturnType(node))
    emit(state, rtype + " " + emitC11FuncSymbol(fnName) + "(")
    let params = funcParams(node)
    let i = 0
    while (i < len(params)) {
        if (i > 0) { emit(state, ", ") }
        emit(state, "Value " + params[i])
        i = i + 1
    }
    emitLine(state, ");")
}

// ============================================================
// WGSL Code Generation (WebGPU)
// ============================================================

func emitWGSLEpreamble(state) {
    emitLine(state, "// Generated by Karkain Compiler v0.14.0 - WGSL")
    emitNewline(state)
}

func emitWGSLType(varType) {
    if (varType == "int") { return "i32" }
    if (varType == "float64") { return "f32" }
    if (varType == "float32") { return "f32" }
    if (varType == "bool") { return "bool" }
    if (varType == "string") { return "string" }
    return varType
}

func emitWGSLExpr(state, node) {
    let nt = getNodeType(node)

    if (nt == "IntLiteral") { emit(state, literalValue(node)) }
    if (nt == "FloatLiteral") { emit(state, literalValue(node)) }
    if (nt == "StringLiteral") { emit(state, "\"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") { emit(state, literalValue(node)) }
    if (nt == "Ident") { emit(state, identName(node)) }

    if (nt == "BinaryExpr") {
        emit(state, "(")
        emitWGSLExpr(state, binaryLeft(node))
        emit(state, " " + binaryOp(node) + " ")
        emitWGSLExpr(state, binaryRight(node))
        emit(state, ")")
    }

    if (nt == "Call") {
        emit(state, callFunc(node) + "(")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            if (i > 0) { emit(state, ", ") }
            emitWGSLExpr(state, args[i])
            i = i + 1
        }
        emit(state, ")")
    }

    if (nt == "GlobalId") {
        let dim = globalIdDim(node)
        emit(state, "global_id.")
        if (dim == "0" || dim == 0) { emit(state, "x") }
        if (dim == "1" || dim == 1) { emit(state, "y") }
        if (dim == "2" || dim == 2) { emit(state, "z") }
    }

    if (nt == "Member") {
        emitWGSLExpr(state, memberObject(node))
        emit(state, "." + memberField(node))
    }

    if (nt == "Index") {
        emitWGSLExpr(state, indexLeft(node))
        emit(state, "[")
        emitWGSLExpr(state, indexExpr(node))
        emit(state, "]")
    }

    if (nt == "ArrayLiteral") {
        emit(state, "array(")
        let elems = arrayElements(node)
        let i = 0
        while (i < len(elems)) {
            if (i > 0) { emit(state, ", ") }
            emitWGSLExpr(state, elems[i])
            i = i + 1
        }
        emit(state, ")")
    }
}

func emitWGSLStmt(state, node) {
    let nt = getNodeType(node)

    if (nt == "VarDecl") {
        let vtype = emitWGSLType(varDeclType(node))
        emit(state, "var " + varDeclName(node) + " : " + vtype + " = ")
        emitWGSLExpr(state, varDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "LetDecl") {
        emit(state, "let " + letDeclName(node) + " = ")
        emitWGSLExpr(state, letDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "Return") {
        emit(state, "return ")
        let rv0 = returnExpr(node)
        if (len(rv0) == 0) { emit(state, "mk_nil()") } else { emitWGSLExpr(state, rv0) }
        emitLine(state, ";")
    }

    if (nt == "Print") {
        emitLine(state, "// print() - not supported in WGSL")
    }

    if (nt == "ExprStmt") {
        emit(state, "")
        emitWGSLExpr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }

    if (nt == "If") {
        emit(state, "if (")
        emitWGSLExpr(state, ifCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitWGSLStmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "Barrier") {
        emitLine(state, "storageBarrier();")
    }

    if (nt == "KernelDecl") {
        emit(state, "@compute @workgroup_size(")
        let wg = kernelWorkgroup(node)
        let i = 0
        while (i < len(wg)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, wg[i])
            i = i + 1
        }
        emitLine(state, ")")
        emit(state, "fn " + kernelName(node) + "(")
        let params = kernelParams(node)
        i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, params[i] + ": " + emitWGSLType("int"))
            i = i + 1
        }
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = kernelBody(node)
        i = 0
        while (i < len(body)) {
            emitWGSLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "FuncDecl") {
        emit(state, "fn " + funcName(node) + "(")
        let params = funcParams(node)
        let i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, params[i] + ": " + emitWGSLType("int"))
            i = i + 1
        }
        emit(state, ") -> " + emitWGSLType(funcReturnType(node)))
        emitLine(state, " {")
        state[2] = codegenIndent(state) + 1
        let body = funcBody(node)
        i = 0
        while (i < len(body)) {
            emitWGSLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "StructDecl") {
        emitLine(state, "struct " + structName(node) + " {")
        state[2] = codegenIndent(state) + 1
        let fields = structFields(node)
        let i = 0
        while (i < len(fields)) {
            emitLine(state, fields[i][1] + ": " + emitWGSLType(fields[i][0]) + ",")
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "While") {
        emit(state, "loop {")
        state[2] = codegenIndent(state) + 1
        emit(state, "if (!")
        emitWGSLExpr(state, whileCondition(node))
        emitLine(state, ") { break; }")
        let body = whileBody(node)
        let i = 0
        while (i < len(body)) {
            emitWGSLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "For") {
        emitLine(state, "{")
        state[2] = codegenIndent(state) + 1
        emitWGSLStmt(state, forInit(node))
        emit(state, "loop {")
        state[2] = codegenIndent(state) + 1
        emit(state, "if (!")
        emitWGSLExpr(state, forCondition(node))
        emitLine(state, ") { break; }")
        let body = forBody(node)
        let i = 0
        while (i < len(body)) {
            emitWGSLStmt(state, body[i])
            i = i + 1
        }
        emit(state, "")
        emitWGSLExpr(state, forPost(node))
        emitLine(state, ";")
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }
}

func generateWGSL(ast) {
    let state = createCodegenState("wgsl")
    emitWGSLEpreamble(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        emitWGSLStmt(state, stmts[i])
        i = i + 1
    }

    return codegenOutput(state)
}

// ============================================================
// OpenCL Code Generation
// ============================================================

func emitOpenCLPreamble(state) {
    emitLine(state, "// Generated by Karkain Compiler v0.14.0 - OpenCL")
    emitLine(state, "#pragma OPENCL EXTENSION cl_khr_byte_addressable_store : enable")
    emitNewline(state)
}

func emitOpenCLType(varType) {
    if (varType == "int") { return "int" }
    if (varType == "float64") { return "double" }
    if (varType == "float32") { return "float" }
    if (varType == "bool") { return "int" }
    if (varType == "string") { return "char*" }
    return varType
}

func emitOpenCLExpr(state, node) {
    let nt = getNodeType(node)

    if (nt == "IntLiteral") { emit(state, literalValue(node)) }
    if (nt == "FloatLiteral") { emit(state, literalValue(node)) }
    if (nt == "StringLiteral") { emit(state, "\"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") {
        if (literalValue(node) == "true") { emit(state, "1") }
        if (literalValue(node) == "false") { emit(state, "0") }
    }
    if (nt == "Ident") { emit(state, identName(node)) }

    if (nt == "BinaryExpr") {
        emit(state, "(")
        emitOpenCLExpr(state, binaryLeft(node))
        emit(state, " " + binaryOp(node) + " ")
        emitOpenCLExpr(state, binaryRight(node))
        emit(state, ")")
    }

    if (nt == "Call") {
        emit(state, callFunc(node) + "(")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            if (i > 0) { emit(state, ", ") }
            emitOpenCLExpr(state, args[i])
            i = i + 1
        }
        emit(state, ")")
    }

    if (nt == "GlobalId") {
        let dim = globalIdDim(node)
        emit(state, "get_global_id(")
        emitOpenCLExpr(state, dim)
        emit(state, ")")
    }

    if (nt == "Member") {
        emitOpenCLExpr(state, memberObject(node))
        emit(state, "->" + memberField(node))
    }

    if (nt == "Index") {
        emitOpenCLExpr(state, indexLeft(node))
        emit(state, "[")
        emitOpenCLExpr(state, indexExpr(node))
        emit(state, "]")
    }
}

func emitOpenCLStmt(state, node) {
    let nt = getNodeType(node)

    if (nt == "VarDecl") {
        let vtype = emitOpenCLType(varDeclType(node))
        emit(state, vtype + " " + varDeclName(node) + " = ")
        emitOpenCLExpr(state, varDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "LetDecl") {
        emit(state, emitOpenCLType("int") + " " + letDeclName(node) + " = ")
        emitOpenCLExpr(state, letDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "Return") {
        emit(state, "return ")
        let rv1 = returnExpr(node)
        if (len(rv1) == 0) { emit(state, "mk_nil()") } else { emitOpenCLExpr(state, rv1) }
        emitLine(state, ";")
    }

    if (nt == "Print") {
        emit(state, "printf(\"%d\\n\", ")
        emitOpenCLExpr(state, printExpr(node))
        emitLine(state, ");")
    }

    if (nt == "ExprStmt") {
        emitOpenCLExpr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }

    if (nt == "If") {
        emit(state, "if (")
        emitOpenCLExpr(state, ifCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitOpenCLStmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        let elseB = ifElse(node)
        if (len(elseB) > 0) {
            emitLine(state, "} else {")
            state[2] = codegenIndent(state) + 1
            i = 0
            while (i < len(elseB)) {
                emitOpenCLStmt(state, elseB[i])
                i = i + 1
            }
            state[2] = codegenIndent(state) - 1
        }
        emitLine(state, "}")
    }

    if (nt == "Barrier") {
        emitLine(state, "barrier(CLK_GLOBAL_MEM_FENCE);")
    }

    if (nt == "KernelDecl") {
        emit(state, "__kernel void " + kernelName(node) + "(")
        let params = kernelParams(node)
        let i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, "__global " + emitOpenCLType("int") + "* " + params[i])
            i = i + 1
        }
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = kernelBody(node)
        i = 0
        while (i < len(body)) {
            emitOpenCLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "FuncDecl") {
        let rtype = emitOpenCLType(funcReturnType(node))
        emit(state, rtype + " " + funcName(node) + "(")
        let params = funcParams(node)
        let i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, emitOpenCLType("int") + " " + params[i])
            i = i + 1
        }
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = funcBody(node)
        i = 0
        while (i < len(body)) {
            emitOpenCLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "StructDecl") {
        emitLine(state, "typedef struct " + structName(node) + " {")
        state[2] = codegenIndent(state) + 1
        let fields = structFields(node)
        let i = 0
        while (i < len(fields)) {
            emitLine(state, emitOpenCLType(fields[i][0]) + " " + fields[i][1] + ";")
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "} " + structName(node) + ";")
        emitNewline(state)
    }

    if (nt == "While") {
        emit(state, "while (")
        emitOpenCLExpr(state, whileCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = whileBody(node)
        let i = 0
        while (i < len(body)) {
            emitOpenCLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "For") {
        emit(state, "for (")
        emitOpenCLStmt(state, forInit(node))
        emitOpenCLExpr(state, forCondition(node))
        emit(state, "; ")
        emitOpenCLExpr(state, forPost(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = forBody(node)
        let i = 0
        while (i < len(body)) {
            emitOpenCLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }
}

func generateOpenCL(ast) {
    let state = createCodegenState("opencl")
    emitOpenCLPreamble(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        emitOpenCLStmt(state, stmts[i])
        i = i + 1
    }

    return codegenOutput(state)
}

// ============================================================
// SPIR-V Placeholder (requires external tools)
// ============================================================

func generateSPIRV(ast) {
    return "// SPIR-V generation requires external spirv-tools\n// Use: karkain build --target spirv input.kark\n"
}

// ============================================================
// OpenQASM 3.0 Code Generation (Quantum)
// ============================================================

func emitOpenQASMExpr(state, node) {
    let nt = getNodeType(node)
    if (nt == "IntLiteral") { emit(state, literalValue(node)) }
    if (nt == "FloatLiteral") { emit(state, literalValue(node)) }
    if (nt == "StringLiteral") { emit(state, "\"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") {
        if (literalValue(node) == "true") { emit(state, "true") }
        if (literalValue(node) == "false") { emit(state, "false") }
    }
    if (nt == "Ident") { emit(state, identName(node)) }
    if (nt == "BinaryExpr") {
        emit(state, "(")
        emitOpenQASMExpr(state, binaryLeft(node))
        emit(state, " " + binaryOp(node) + " ")
        emitOpenQASMExpr(state, binaryRight(node))
        emit(state, ")")
    }
    if (nt == "Call") {
        emit(state, callFunc(node) + "(")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            if (i > 0) { emit(state, ", ") }
            emitOpenQASMExpr(state, args[i])
            i = i + 1
        }
        emit(state, ")")
    }
    if (nt == "Index") {
        emitOpenQASMExpr(state, indexLeft(node))
        emit(state, "[")
        emitOpenQASMExpr(state, indexExpr(node))
        emit(state, "]")
    }
    if (nt == "Member") {
        emitOpenQASMExpr(state, memberObject(node))
        emit(state, "." + memberField(node))
    }
}

func emitOpenQASMStmt(state, node) {
    let nt = getNodeType(node)
    if (nt == "ExprStmt") {
        emitOpenQASMExpr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }
    if (nt == "If") {
        emit(state, "if (")
        emitOpenQASMExpr(state, ifCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitOpenQASMStmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }
    if (nt == "Print") {
        emitLine(state, "// print() - not supported in OpenQASM")
    }
}

func generateOpenQASM(ast) {
    let state = createCodegenState("openqasm")
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 - OpenQASM 3.0")
    emitLine(state, "OPENQASM 3.0;")
    emitLine(state, "include \"stdgates.inc\";")
    emitNewline(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        let nt = getNodeType(stmts[i])
        if (nt == "KernelDecl") {
            emit(state, "gate " + kernelName(stmts[i]) + "(")
            let params = kernelParams(stmts[i])
            let j = 0
            while (j < len(params)) {
                if (j > 0) { emit(state, ", ") }
                emit(state, params[j])
                j = j + 1
            }
            emitLine(state, ") {")
            state[2] = codegenIndent(state) + 1
            let body = kernelBody(stmts[i])
            j = 0
            while (j < len(body)) {
                emitOpenQASMStmt(state, body[j])
                j = j + 1
            }
            state[2] = codegenIndent(state) - 1
            emitLine(state, "}")
            emitNewline(state)
        }
        i = i + 1
    }

    return codegenOutput(state)
}

// ============================================================
// QIR Code Generation (Quantum Intermediate Representation)
// ============================================================

func emitQIRExpr(state, node) {
    let nt = getNodeType(node)
    if (nt == "IntLiteral") { emit(state, literalValue(node)) }
    if (nt == "FloatLiteral") { emit(state, literalValue(node)) }
    if (nt == "StringLiteral") { emit(state, "\"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") {
        if (literalValue(node) == "true") { emit(state, "true") }
        if (literalValue(node) == "false") { emit(state, "false") }
    }
    if (nt == "Ident") { emit(state, identName(node)) }
    if (nt == "BinaryExpr") {
        emit(state, "(")
        emitQIRExpr(state, binaryLeft(node))
        emit(state, " " + binaryOp(node) + " ")
        emitQIRExpr(state, binaryRight(node))
        emit(state, ")")
    }
    if (nt == "Call") {
        emit(state, "@__quantum__qis__" + callFunc(node) + "__body(")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            if (i > 0) { emit(state, ", ") }
            emitQIRExpr(state, args[i])
            i = i + 1
        }
        emit(state, ")")
    }
    if (nt == "Member") {
        emitQIRExpr(state, memberObject(node))
        emit(state, "." + memberField(node))
    }
    if (nt == "Index") {
        emitQIRExpr(state, indexLeft(node))
        emit(state, "[")
        emitQIRExpr(state, indexExpr(node))
        emit(state, "]")
    }
}

func emitQIRStmt(state, node) {
    let nt = getNodeType(node)
    if (nt == "ExprStmt") {
        emitQIRExpr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }
    if (nt == "If") {
        emit(state, "if (")
        emitQIRExpr(state, ifCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitQIRStmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }
    if (nt == "Print") {
        emitLine(state, "// print() - not supported in QIR")
    }
}

func generateQIR(ast) {
    let state = createCodegenState("qir")
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 - QIR")
    emitLine(state, "define void @main() {")
    state[2] = codegenIndent(state) + 1

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        emitQIRStmt(state, stmts[i])
        i = i + 1
    }

    state[2] = codegenIndent(state) - 1
    emitLine(state, "}")
    return codegenOutput(state)
}

// ============================================================
// KBC Bytecode Emission (.kbc binary format)
// ============================================================

// KBC opcode constants
func KBC_OP_LOAD_INT() { return 1 }
func KBC_OP_LOAD_STR() { return 2 }
func KBC_OP_LOAD_BOOL() { return 3 }
func KBC_OP_ADD() { return 10 }
func KBC_OP_SUB() { return 11 }
func KBC_OP_MUL() { return 12 }
func KBC_OP_DIV() { return 13 }
func KBC_OP_EQ() { return 14 }
func KBC_OP_NEQ() { return 15 }
func KBC_OP_LT() { return 16 }
func KBC_OP_GT() { return 17 }
func KBC_OP_PRINT() { return 20 }
func KBC_OP_CALL() { return 30 }
func KBC_OP_RET() { return 31 }
func KBC_OP_JMP() { return 40 }
func KBC_OP_JMP_IF() { return 41 }
func KBC_OP_HALT() { return 99 }

func emitKBCPreamble(state) {
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 - KBC Bytecode")
    emitLine(state, "// Format: OP [operands...]")
    emitNewline(state)
}

func emitKBCExpr(state, node) {
    let nt = getNodeType(node)
    if (nt == "IntLiteral") { emitLine(state, "LOAD_INT " + literalValue(node)) }
    if (nt == "FloatLiteral") { emitLine(state, "LOAD_FLOAT " + literalValue(node)) }
    if (nt == "StringLiteral") { emitLine(state, "LOAD_STR \"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") { emitLine(state, "LOAD_BOOL " + literalValue(node)) }
    if (nt == "Ident") { emitLine(state, "LOAD_VAR " + identName(node)) }
    if (nt == "BinaryExpr") {
        emitKBCExpr(state, binaryLeft(node))
        emitKBCExpr(state, binaryRight(node))
        let op = binaryOp(node)
        if (op == "+") { emitLine(state, "ADD") }
        if (op == "-") { emitLine(state, "SUB") }
        if (op == "*") { emitLine(state, "MUL") }
        if (op == "/") { emitLine(state, "DIV") }
        if (op == "==") { emitLine(state, "EQ") }
        if (op == "!=") { emitLine(state, "NEQ") }
        if (op == "<") { emitLine(state, "LT") }
        if (op == ">") { emitLine(state, "GT") }
    }
    if (nt == "Call") {
        let args = callArgs(node)
        let i = len(args) - 1
        while (i >= 0) {
            emitKBCExpr(state, args[i])
            i = i - 1
        }
        emitLine(state, "CALL " + callFunc(node) + " " + str(len(args)))
    }
}

func emitKBCStmt(state, node) {
    let nt = getNodeType(node)
    if (nt == "LetDecl") {
        emitKBCExpr(state, letDeclValue(node))
        emitLine(state, "STORE_VAR " + letDeclName(node))
    }
    if (nt == "VarDecl") {
        emitKBCExpr(state, varDeclValue(node))
        emitLine(state, "STORE_VAR " + varDeclName(node))
    }
    if (nt == "Print") {
        emitKBCExpr(state, printExpr(node))
        emitLine(state, "PRINT")
    }
    if (nt == "Return") {
        let rv2 = returnExpr(node)
        if (len(rv2) > 0) { emitKBCExpr(state, rv2) }
        emitLine(state, "RET")
    }
    if (nt == "ExprStmt") {
        emitKBCExpr(state, exprStmtExpr(node))
    }
    if (nt == "If") {
        emitKBCExpr(state, ifCondition(node))
        emitLine(state, "JMP_IF L")
    }
    if (nt == "FuncDecl") {
        emitLine(state, "FUNC " + funcName(node))
        let body = funcBody(node)
        let i = 0
        while (i < len(body)) {
            emitKBCStmt(state, body[i])
            i = i + 1
        }
        emitLine(state, "RET")
    }
}

func generateKBC(ast) {
    let state = createCodegenState("kbc")
    emitKBCPreamble(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        emitKBCStmt(state, stmts[i])
        i = i + 1
    }

    emitLine(state, "HALT")
    return codegenOutput(state)
}

// ============================================================
// Forward Declaration Generation
// ============================================================

func generateForwardDecls(ast) {
    let result = ""
    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        let nt = getNodeType(stmts[i])
        if (nt == "FuncDecl") {
            result = result + "Value* " + funcName(stmts[i]) + "("
            let params = funcParams(stmts[i])
            let j = 0
            while (j < len(params)) {
                if (j > 0) { result = result + ", " }
                result = result + "Value* " + params[j]
                j = j + 1
            }
            result = result + ");\n"
        }
        i = i + 1
    }
    return result + "\n"
}

// ============================================================
// Main generation function
// ============================================================

func generate(ast, target) {
    if (target == "c23") { return generateC11(ast) }
    if (target == "c11") { return generateC11(ast) }
    if (target == "c99") { return generateC11(ast) } // legacy alias
    if (target == "wgsl") { return generateWGSL(ast) }
    if (target == "opencl") { return generateOpenCL(ast) }
    if (target == "openqasm") { return generateOpenQASM(ast) }
    if (target == "qir") { return generateQIR(ast) }
    if (target == "kbc") { return generateKBC(ast) }
    if (target == "spirv") { return generateSPIRV(ast) }
    return generateC11(ast)
}

// Phase 40: Self-hosted Karkain Code Generator
// Generates C23, WGSL, OpenCL, OpenQASM 3.0, QIR, and .kbc bytecode target code
// Imports: ast.kark

// ============================================================
// Codegen state
// ============================================================

func createCodegenState(target) {
    let state = []
    state = appendArray(state, target)   // 0: target ("c23", "wgsl", "opencl", "spirv")
    state = appendArray(state, "")       // 1: output buffer
    state = appendArray(state, 0)        // 2: indent level
    state = appendArray(state, [])       // 3: errors
    state = appendArray(state, [])       // 4: includes
    state = appendArray(state, [])       // 5: globals
    state = appendArray(state, [])       // 6: functions
    state = appendArray(state, [])       // 7: kernels
    state = appendArray(state, "")       // 8: current function name
    state = appendArray(state, "")       // 9: source file name (runtime error diagnostics)
    state = appendArray(state, [])       // 10: let-bound lambda names
    state = appendArray(state, [])       // 11: parallel capture lists
    state = appendArray(state, [])       // 12: parallel FuncDecl nodes
    state = appendArray(state, [])       // 13: currently-emitting closure caps
    state = appendArray(state, [])       // 14: emitted closure-env registry
    state = appendArray(state, [])       // 15: enum declaration nodes (Phase 123)
    return state
}

func codegenTarget(state) { return state[0] }
func codegenOutput(state) { return state[1] }
func codegenIndent(state) { return state[2] }
func codegenErrors(state) { return state[3] }
func codegenIncludes(state) { return state[4] }
func codegenGlobals(state) { return state[5] }
func codegenFunctions(state) { return state[6] }
func codegenKernels(state) { return state[7] }
func codegenCurrentFunc(state) { return state[8] }
func codegenSourceName(state) { return state[9] }

func setCodegenOutput(state, output) { state[1] = output }
func setCodegenIndent(state, indent) { state[2] = indent }
func setCodegenCurrentFunc(state, name) { state[8] = name }
func setCodegenSourceName(state, name) { state[9] = name }

// Phase 123: enum declaration registry + variant index lookup (mirrors Go
// g.enumDecls map + getEnumVariantIndex used by genEnumVariantExpr / match).
func codegenEnumDecls(state) { return state[15] }
func registerEnumDecl(state, decl) { state[15] = appendArray(codegenEnumDecls(state), decl) }

// getEnumVariantIndex returns the 1-based integer tag for EnumName.Variant
// from the registered enum declarations (matching genEnumDecl's make_int(i+1)).
func getEnumVariantIndex(state, enumName, variant) {
    let decls = codegenEnumDecls(state)
    let d = 0
    while (d < len(decls)) {
        if (enumDeclName(decls[d]) == enumName) {
            let vars = enumDeclVariants(decls[d])
            let v = 0
            while (v < len(vars)) {
                // raw entries are "Name:" (unit) or "Name:payload"
                let entry = vars[v]
                if (entry == variant) { return v + 1 }
                let prefix = variant + ":"
                if (len(entry) >= len(prefix) && substr(entry, 0, len(prefix)) == prefix) { return v + 1 }
                v = v + 1
            }
            return -1
        }
        d = d + 1
    }
    return -1
}

func emit(state, text) {
    state[1] = codegenOutput(state) + text
}

func emitLine(state, text) {
    let indentStr = ""
    let i = 0
    while (i < codegenIndent(state)) {
        indentStr = indentStr + "  "
        i = i + 1
    }
    state[1] = codegenOutput(state) + indentStr + text + "\n"
}

func emitNewline(state) {
    state[1] = codegenOutput(state) + "\n"
}

func addCodegenError(state, msg) {
    state[3] = appendArray(codegenErrors(state), msg)
}

// ============================================================
// C11 Code Generation
// ============================================================

func emitC11Preamble(state) {
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 (Stable Build)")
    emitLine(state, "#include <stdio.h>")
    emitLine(state, "#include <stdlib.h>")
    emitLine(state, "#include <string.h>")
    emitLine(state, "#include <math.h>")
    emitLine(state, "#include <stdarg.h>")
    emitLine(state, "#include <dirent.h>")
    emitNewline(state)
    emitLine(state, "static int _karkain_gargc = 0;")
    emitLine(state, "static char** _karkain_gargv = 0;")
    emitNewline(state)
}

// Canonical Value runtime emitted by the self-hosted emitC11 backend. Mirrors
// the Value model used by the Go bootstrap backend so that generated programs
// are dynamic, self-contained, and compile with `gcc -std=c2x -lm -lgmp`.
func emitC11ValueRuntime(state) {
    emitLine(state, "typedef enum { TYPE_INT, TYPE_FLOAT64, TYPE_STRING, TYPE_ARRAY, TYPE_MAP, TYPE_BOOL, TYPE_OPTION, TYPE_RESULT } ValueType;")
    emitLine(state, "typedef struct Value Value;")
    emitLine(state, "typedef struct { int tag; Value* inner; } OptionVal;")
    emitLine(state, "typedef struct { int tag; Value* okVal; Value* errVal; } ResultVal;")
    emitLine(state, "typedef struct Value {")
    emitLine(state, "    ValueType type;")
    emitLine(state, "    long long intVal;")
    emitLine(state, "    double floatVal;")
    emitLine(state, "    char* strVal;")
    emitLine(state, "    struct Value** items;")
    emitLine(state, "    int length;")
    emitLine(state, "    char** keys;")
    emitLine(state, "    struct Value** values;")
    emitLine(state, "    int mlen;")
    emitLine(state, "    OptionVal optVal;")
    emitLine(state, "    ResultVal resVal;")
    emitLine(state, "} Value;")
    emitNewline(state)
    emitLine(state, "static Value make_int(long long v) { Value r; r.type=TYPE_INT; r.intVal=v; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_float(double v) { Value r; r.type=TYPE_FLOAT64; r.floatVal=v; r.intVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_bool(long long v) { Value r; r.type=TYPE_BOOL; r.intVal=v; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_string(const char* s) { Value r; r.type=TYPE_STRING; r.intVal=0; r.floatVal=0; r.strVal=strdup(s?s:\"\"); r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_array(void) { Value r; r.type=TYPE_ARRAY; r.intVal=0; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value make_map(void) { Value r; r.type=TYPE_MAP; r.intVal=0; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static Value mk_nil(void) { Value r; r.type=TYPE_INT; r.intVal=0; r.floatVal=0; r.strVal=0; r.items=0; r.length=0; r.keys=0; r.values=0; r.mlen=0; return r; }")
    emitLine(state, "static void array_push(Value* a, Value e) { Value* c=(Value*)malloc(sizeof(Value)); *c=e; a->length++; a->items=(Value**)realloc(a->items,sizeof(Value*)*a->length); a->items[a->length-1]=c; }")
    emitLine(state, "static Value make_alloc_array(Value n) { long long count=(n.type==TYPE_INT)?n.intVal:0; if(count<0){ count=0; } Value v=make_array(); long long i; for(i=0;i<count;i++){ array_push(&v,make_int(0)); } return v; }")
    emitLine(state, "static Value karkain_slice(Value v, Value s, Value e) { long long start=(s.type==TYPE_INT)?s.intVal:0; long long end=(e.type==TYPE_INT)?e.intVal:-1; if(v.type==TYPE_STRING){ long long n=(long long)strlen(v.strVal?v.strVal:\"\"); if(end<0) end+=n+1; if(start<0) start=0; if(end>n) end=n; if(start>=end||start>=n) return make_string(\"\"); long long len=end-start; char* buf=(char*)malloc((size_t)len+1); memcpy(buf,v.strVal+start,(size_t)len); buf[len]=0; Value r=make_string(buf); free(buf); return r; } if(v.type==TYPE_ARRAY){ long long n=(long long)v.length; if(end<0) end+=n+1; if(start<0) start=0; if(end>n) end=n; Value out=make_array(); if(start<end){ long long i; for(i=start;i<end;i++) array_push(&out,*v.items[i]); } return out; } return make_int(0); }")
    emitLine(state, "static Value map_get(Value m, Value k);")
    emitLine(state, "static Value array_get(Value a, Value i) { if(a.type==TYPE_MAP) return map_get(a,i); if(a.type==TYPE_STRING&&i.type==TYPE_INT){ int si=(int)i.intVal; int sl=strlen(a.strVal?a.strVal:\"\"); if(si<0||si>=sl) return make_int(0); char c[2]={a.strVal[si],0}; return make_string(c); } if(a.type!=TYPE_ARRAY) return make_int(0); int idx=(int)i.intVal; if(idx<0||idx>=a.length) return make_int(0); return *a.items[idx]; }")
    emitLine(state, "static void array_set(Value* a, Value i, Value v) { if(!a||a->type!=TYPE_ARRAY) return; int idx=(int)i.intVal; if(idx<0||idx>=a->length) return; *(a->items[idx])=v; }")
    emitLine(state, "static int is_truthy(Value v) { if(v.type==TYPE_BOOL||v.type==TYPE_INT) return v.intVal!=0; if(v.type==TYPE_FLOAT64) return v.floatVal!=0.0; if(v.type==TYPE_STRING) return v.strVal&&v.strVal[0]!=0; if(v.type==TYPE_ARRAY) return v.length>0; return 0; }")
    emitLine(state, "static Value karkain_len(Value v) { if(v.type==TYPE_ARRAY) return make_int(v.length); if(v.type==TYPE_MAP) return make_int(v.mlen); if(v.type==TYPE_STRING) return make_int(strlen(v.strVal?v.strVal:\"\")); return make_int(0); }")
    emitLine(state, "static Value map_get(Value m, Value k) { if(m.type!=TYPE_MAP) return make_int(0); const char* key=k.strVal?k.strVal:\"\"; int i; for(i=0;i<m.mlen;i++){ if(strcmp(m.keys[i],key)==0) return *m.values[i]; } return make_int(0); }")
    emitLine(state, "static void map_set(Value* m, Value k, Value v) { if(m->type!=TYPE_MAP) return; const char* key=k.strVal?k.strVal:\"\"; int i; for(i=0;i<m->mlen;i++){ if(strcmp(m->keys[i],key)==0){ *(m->values[i])=v; return; } } m->mlen++; m->keys=(char**)realloc(m->keys,sizeof(char*)*m->mlen); m->values=(Value**)realloc(m->values,sizeof(Value*)*m->mlen); m->keys[m->mlen-1]=strdup(key); Value* c=(Value*)malloc(sizeof(Value)); *c=v; m->values[m->mlen-1]=c; }")
    emitLine(state, "static void index_set(Value* container, Value idx, Value val) { if(!container) return; if(container->type==TYPE_MAP){ map_set(container, idx, val); return; } if(container->type==TYPE_ARRAY&&idx.type==TYPE_INT){ int i=(int)idx.intVal; if(i>=0&&i<container->length){ Value* c=(Value*)malloc(sizeof(Value)); *c=val; container->items[i]=c; return; } } }")
    emitNewline(state)
    emitLine(state, "static Value values_equal(Value a, Value b);")
    emitNewline(state)
    emitLine(state, "static Value binary_op(Value l, const char* op, Value r) {")
    emitLine(state, "    if(l.type==TYPE_STRING||r.type==TYPE_STRING) {")
    emitLine(state, "        if(strcmp(op,\"+\")==0) { char abuf[64]; char bbuf[64]; const char* aa; const char* bb; if(l.type==TYPE_STRING){ aa=l.strVal?l.strVal:\"\"; } else if(l.type==TYPE_INT||l.type==TYPE_BOOL){ snprintf(abuf,64,\"%lld\",l.intVal); aa=abuf; } else if(l.type==TYPE_FLOAT64){ snprintf(abuf,64,\"%g\",l.floatVal); aa=abuf; } else { aa=\"?\"; } if(r.type==TYPE_STRING){ bb=r.strVal?r.strVal:\"\"; } else if(r.type==TYPE_INT||r.type==TYPE_BOOL){ snprintf(bbuf,64,\"%lld\",r.intVal); bb=bbuf; } else if(r.type==TYPE_FLOAT64){ snprintf(bbuf,64,\"%g\",r.floatVal); bb=bbuf; } else { bb=\"?\"; } int n=strlen(aa)+strlen(bb)+1; char* buf=(char*)malloc(n); buf[0]=0; strcat(buf,aa); strcat(buf,bb); Value res=make_string(buf); free(buf); return res; }")
    emitLine(state, "        const char* a=l.type==TYPE_STRING?(l.strVal?l.strVal:\"\"):\"\"; const char* b=r.type==TYPE_STRING?(r.strVal?r.strVal:\"\"):\"\"; int c=strcmp(a,b);")
    emitLine(state, "        if(strcmp(op,\"==\")==0) return make_int(c==0); if(strcmp(op,\"!=\")==0) return make_int(c!=0);")
    emitLine(state, "        if(strcmp(op,\"<\")==0) return make_int(c<0); if(strcmp(op,\">\")==0) return make_int(c>0);")
    emitLine(state, "        if(strcmp(op,\"<=\")==0) return make_int(c<=0); if(strcmp(op,\">=\")==0) return make_int(c>=0);")
    emitLine(state, "    }")
    emitLine(state, "    if(l.type==TYPE_FLOAT64||r.type==TYPE_FLOAT64) {")
    emitLine(state, "        double a=l.type==TYPE_FLOAT64?l.floatVal:(double)l.intVal; double b=r.type==TYPE_FLOAT64?r.floatVal:(double)r.intVal;")
    emitLine(state, "        if(strcmp(op,\"+\")==0) return make_float(a+b); if(strcmp(op,\"-\")==0) return make_float(a-b);")
    emitLine(state, "        if(strcmp(op,\"*\")==0) return make_float(a*b); if(strcmp(op,\"/\")==0) return make_float(b!=0?a/b:0); if(strcmp(op,\"%\")==0) return make_float(b!=0?fmod(a,b):0);")
    emitLine(state, "        if(strcmp(op,\"==\")==0) return make_int(a==b); if(strcmp(op,\"!=\")==0) return make_int(a!=b);")
    emitLine(state, "        if(strcmp(op,\"<\")==0) return make_int(a<b); if(strcmp(op,\">\")==0) return make_int(a>b);")
    emitLine(state, "        if(strcmp(op,\"<=\")==0) return make_int(a<=b); if(strcmp(op,\">=\")==0) return make_int(a>=b);")
    emitLine(state, "    }")
    emitLine(state, "    if(l.type==TYPE_INT||l.type==TYPE_BOOL||r.type==TYPE_INT||r.type==TYPE_BOOL) {")
    emitLine(state, "        long long a=l.intVal, b=r.intVal;")
    emitLine(state, "        if(strcmp(op,\"+\")==0) return make_int(a+b); if(strcmp(op,\"-\")==0) return make_int(a-b);")
    emitLine(state, "        if(strcmp(op,\"*\")==0) return make_int(a*b); if(strcmp(op,\"/\")==0) return make_int(b!=0?a/b:0);")
    emitLine(state, "        if(strcmp(op,\"%\")==0) return make_int(b!=0?a%b:0);")
    emitLine(state, "        if(strcmp(op,\"==\")==0) return make_int(a==b); if(strcmp(op,\"!=\")==0) return make_int(a!=b);")
    emitLine(state, "        if(strcmp(op,\"<\")==0) return make_int(a<b); if(strcmp(op,\">\")==0) return make_int(a>b);")
    emitLine(state, "        if(strcmp(op,\"<=\")==0) return make_int(a<=b); if(strcmp(op,\">=\")==0) return make_int(a>=b);")
    emitLine(state, "    }")
    emitLine(state, "    if(strcmp(op,\"==\")==0) return values_equal(l,r); if(strcmp(op,\"!=\")==0) return make_int(is_truthy(values_equal(l,r))==0);")
    emitLine(state, "    if(strcmp(op,\"&&\")==0) return make_int(is_truthy(l)&&is_truthy(r)); if(strcmp(op,\"||\")==0) return make_int(is_truthy(l)||is_truthy(r));")
    emitLine(state, "    return make_int(0);")
    emitLine(state, "}")
    emitLine(state, "void karkain_set_line(long long n);")
    emitLine(state, "void karkain_frame_enter(const char* func, const char* file);")
    emitLine(state, "void karkain_frame_leave(void);")
    emitLine(state, "#define KARKAIN_MAX_FRAMES 128")
    emitLine(state, "typedef struct { const char* func; const char* file; long long line; } karkain_frame;")
    emitLine(state, "static karkain_frame karkain_frames[KARKAIN_MAX_FRAMES];")
    emitLine(state, "static int karkain_frame_depth = 0;")
    emitLine(state, "static long long karkain_current_line = 0;")
    emitLine(state, "void karkain_set_line(long long n) { karkain_current_line = n; if (karkain_frame_depth > 0) karkain_frames[karkain_frame_depth - 1].line = n; }")
    emitLine(state, "void karkain_frame_enter(const char* func, const char* file) { if (karkain_frame_depth < KARKAIN_MAX_FRAMES) { karkain_frames[karkain_frame_depth].func = func; karkain_frames[karkain_frame_depth].file = file; karkain_frames[karkain_frame_depth].line = karkain_current_line; karkain_frame_depth++; } }")
    emitLine(state, "void karkain_frame_leave(void) { if (karkain_frame_depth > 0) karkain_frame_depth--; }")
    emitLine(state, "void karkain_runtime_error(const char* kind, const char* file, long long line) { karkain_set_line(line); if (file != NULL && file[0] != '\\0' && line > 0) { fprintf(stderr, \"runtime error: %s at %s:%lld\\n\", kind, file, line); } else if (file != NULL && file[0] != '\\0') { fprintf(stderr, \"runtime error: %s at %s\\n\", kind, file); } else if (line > 0) { fprintf(stderr, \"runtime error: %s at line %lld\\n\", kind, line); } else { fprintf(stderr, \"runtime error: %s\\n\", kind); } if (karkain_frame_depth > 0) { fprintf(stderr, \"  stack:\\n\"); int i; for (i = karkain_frame_depth - 1; i >= 0; i--) { fprintf(stderr, \"    %s (%s:%lld)\\n\", karkain_frames[i].func, karkain_frames[i].file, karkain_frames[i].line); } } fflush(stderr); exit(1); }")
    emitLine(state, "static Value karkain_checked_div(Value l, Value r, const char* file, long long line) { if(l.type==TYPE_FLOAT64||r.type==TYPE_FLOAT64){ double b=r.type==TYPE_FLOAT64?r.floatVal:(double)r.intVal; if(b==0.0) karkain_runtime_error(\"division by zero\", file, line); } else if((l.type==TYPE_INT||l.type==TYPE_BOOL)&&(r.type==TYPE_INT||r.type==TYPE_BOOL)){ if(r.intVal==0) karkain_runtime_error(\"integer division by zero\", file, line); } return binary_op(l, \"/\", r); }")
    emitLine(state, "static Value karkain_checked_mod(Value l, Value r, const char* file, long long line) { if(l.type==TYPE_FLOAT64||r.type==TYPE_FLOAT64){ double b=r.type==TYPE_FLOAT64?r.floatVal:(double)r.intVal; if(b==0.0) karkain_runtime_error(\"modulo by zero\", file, line); } else if((l.type==TYPE_INT||l.type==TYPE_BOOL)&&(r.type==TYPE_INT||r.type==TYPE_BOOL)){ if(r.intVal==0) karkain_runtime_error(\"integer modulo by zero\", file, line); } return binary_op(l, \"%\", r); }")
    emitLine(state, "static Value karkain_checked_get(Value a, Value i, const char* file, long long line) { if(a.type==TYPE_STRING&&i.type==TYPE_INT){ int si=(int)i.intVal; int sl=strlen(a.strVal?a.strVal:\"\"); if(si<0||si>=sl) karkain_runtime_error(\"string index out of range\", file, line); } if(a.type==TYPE_ARRAY&&i.type==TYPE_INT){ int idx=(int)i.intVal; if(idx<0||idx>=a.length) karkain_runtime_error(\"array index out of range\", file, line); } return array_get(a, i); }")
    emitLine(state, "static void karkain_checked_set(Value* a, Value i, Value v, const char* file, long long line) { if(!a) return; if(a->type==TYPE_ARRAY&&i.type==TYPE_INT){ int idx=(int)i.intVal; if(idx<0||idx>=a->length) karkain_runtime_error(\"array index out of range\", file, line); } index_set(a, i, v); }")
    emitLine(state, "static Value option_none(void) { Value v; v.type=TYPE_OPTION; v.optVal.tag=0; v.optVal.inner=0; return v; }")
    emitLine(state, "static Value option_some(Value inner) { Value v; v.type=TYPE_OPTION; v.optVal.tag=1; v.optVal.inner=(Value*)malloc(sizeof(Value)); *v.optVal.inner=inner; return v; }")
    emitLine(state, "static Value result_ok(Value val) { Value v; v.type=TYPE_RESULT; v.resVal.tag=0; v.resVal.okVal=(Value*)malloc(sizeof(Value)); *v.resVal.okVal=val; return v; }")
    emitLine(state, "static Value result_err(Value val) { Value v; v.type=TYPE_RESULT; v.resVal.tag=1; v.resVal.errVal=(Value*)malloc(sizeof(Value)); *v.resVal.errVal=val; return v; }")
    emitLine(state, "static Value karkain_checked_add(Value a, Value b) { if((a.type==TYPE_INT||a.type==TYPE_BOOL)&&(b.type==TYPE_INT||b.type==TYPE_BOOL)){ long long r; if(__builtin_add_overflow(a.intVal,b.intVal,&r)) return option_none(); return option_some(make_int(r)); } return option_some(binary_op(a, \"+\", b)); }")
    emitLine(state, "static Value karkain_checked_sub(Value a, Value b) { if((a.type==TYPE_INT||a.type==TYPE_BOOL)&&(b.type==TYPE_INT||b.type==TYPE_BOOL)){ long long r; if(__builtin_sub_overflow(a.intVal,b.intVal,&r)) return option_none(); return option_some(make_int(r)); } return option_some(binary_op(a, \"-\", b)); }")
    emitLine(state, "static Value karkain_checked_mul(Value a, Value b) { if((a.type==TYPE_INT||a.type==TYPE_BOOL)&&(b.type==TYPE_INT||b.type==TYPE_BOOL)){ long long r; if(__builtin_mul_overflow(a.intVal,b.intVal,&r)) return option_none(); return option_some(make_int(r)); } return option_some(binary_op(a, \"*\", b)); }")
    emitLine(state, "static Value karkain_str(Value v) { char buf[64]; if(v.type==TYPE_INT){ snprintf(buf,64,\"%lld\",v.intVal); return make_string(buf); } if(v.type==TYPE_FLOAT64){ snprintf(buf,64,\"%g\",v.floatVal); return make_string(buf); } if(v.type==TYPE_BOOL){ return make_string(v.intVal?\"true\":\"false\"); } if(v.type==TYPE_STRING){ return make_string(v.strVal?v.strVal:\"\"); } return make_string(\"?\"); }")
    emitLine(state, "static void print_value(Value v) { if(v.type==TYPE_INT) printf(\"%lld\", v.intVal); else if(v.type==TYPE_FLOAT64) printf(\"%g\", v.floatVal); else if(v.type==TYPE_BOOL) printf(\"%s\", v.intVal?\"true\":\"false\"); else if(v.type==TYPE_STRING) printf(\"%s\", v.strVal?v.strVal:\"\"); else if(v.type==TYPE_ARRAY){ printf(\"[\"); int i; for(i=0;i<v.length;i++){ if(i) printf(\", \"); print_value(*v.items[i]); } printf(\"]\"); } else if(v.type==TYPE_OPTION){ if(v.optVal.tag==0) printf(\"None\\n\"); else { printf(\"Some(\"); print_value(*v.optVal.inner); printf(\")\\n\"); } } else if(v.type==TYPE_RESULT){ if(v.resVal.tag==0){ printf(\"Ok(\"); print_value(*v.resVal.okVal); printf(\")\\n\"); } else if(v.resVal.tag==1){ printf(\"Err(\"); print_value(*v.resVal.errVal); printf(\")\\n\"); } } else printf(\"?\"); }")
    emitLine(state, "static Value _karkain_array(int n, ...) { va_list ap; va_start(ap,n); Value a=make_array(); int i; for(i=0;i<n;i++){ Value e=va_arg(ap,Value); array_push(&a,e); } va_end(ap); return a; }")
    emitLine(state, "static Value _karkain_get_args(void) { Value _args=make_array(); int _i; for(_i=0;_i<_karkain_gargc;_i++){ array_push(&_args, make_string(_karkain_gargv[_i])); } return _args; }")
    emitLine(state, "static Value karkain_listFiles(Value dir) { Value arr=make_array(); const char* dname=dir.type==TYPE_STRING?(dir.strVal?dir.strVal:\"\"):\"\"; DIR* d=opendir(dname); if(!d) return arr; struct dirent* e; while((e=readdir(d))!=NULL){ if(e->d_name[0]=='.') continue; array_push(&arr, make_string(e->d_name)); } closedir(d); return arr; }")
    emitLine(state, "static Value values_equal(Value a, Value b) { if(a.type!=b.type) return make_int(0); if(a.type==TYPE_INT||a.type==TYPE_BOOL) return make_int(a.intVal==b.intVal); if(a.type==TYPE_FLOAT64){ double d=a.floatVal-b.floatVal; return make_int(d>-1e-9&&d<1e-9); } if(a.type==TYPE_STRING) return make_int(strcmp(a.strVal?a.strVal:\"\",b.strVal?b.strVal:\"\")==0); if(a.type==TYPE_ARRAY){ if(a.length!=b.length) return make_int(0); int i; for(i=0;i<a.length;i++){ if(is_truthy(values_equal(*a.items[i],*b.items[i]))==0) return make_int(0); } return make_int(1); } return make_int(0); }")
    emitLine(state, "static Value karkain_substr(Value str, Value start, Value length) { if(str.type!=TYPE_STRING||start.type!=TYPE_INT||length.type!=TYPE_INT) return make_string(\"\"); int s=(int)start.intVal; int l=(int)length.intVal; int slen=(int)strlen(str.strVal?str.strVal:\"\"); if(s<0) s=0; if(s>=slen) return make_string(\"\"); if(s+l>slen) l=slen-s; if(l<0) l=0; char* buf=(char*)malloc(l+1); memcpy(buf,str.strVal+s,(size_t)l); buf[l]=0; Value r=make_string(buf); free(buf); return r; }")
    emitLine(state, "static void karkain_assert_report(const char* kind, const char* expr, const char* loc) { fprintf(stderr, \"%s: %s\", kind, expr); if(loc!=NULL&&loc[0]!='\\0') fprintf(stderr, \"  [%s]\", loc); fprintf(stderr, \"\\n\"); fflush(stderr); }")
    emitLine(state, "static void karkain_assert(Value cond, const char* expr, const char* loc) { if(!is_truthy(cond)) { karkain_assert_report(\"assertion failed\", expr, loc); exit(1); } }")
    emitLine(state, "static void karkain_assert_eq(Value actual, Value expected, const char* expr, const char* loc) { if(!is_truthy(values_equal(actual, expected))) { karkain_assert_report(\"assertion failed: assert_eq\", expr, loc); Value _a=karkain_str(actual); Value _e=karkain_str(expected); fprintf(stderr, \"  expected: %s\\n  actual:   %s\\n\", _e.strVal?_e.strVal:\"\", _a.strVal?_a.strVal:\"\"); fflush(stderr); exit(1); } }")
    emitLine(state, "static void karkain_assert_ne(Value actual, Value expected, const char* expr, const char* loc) { if(is_truthy(values_equal(actual, expected))) { karkain_assert_report(\"assertion failed: assert_ne\", expr, loc); Value _a=karkain_str(actual); fprintf(stderr, \"  unexpectedly equal (actual): %s\\n\", _a.strVal?_a.strVal:\"\"); fflush(stderr); exit(1); } }")
    emitLine(state, "static Value karkain_int(Value v) { if(v.type==TYPE_INT) return make_int(v.intVal); if(v.type==TYPE_FLOAT64) return make_int((long long)v.floatVal); if(v.type==TYPE_STRING) return make_int(atoll(v.strVal?v.strVal:\"\")); if(v.type==TYPE_BOOL) return make_int(v.intVal); return make_int(0); }")
    emitLine(state, "static Value karkain_float(Value v) { if(v.type==TYPE_FLOAT64) return make_float(v.floatVal); if(v.type==TYPE_INT) return make_float((double)v.intVal); if(v.type==TYPE_STRING) return make_float(atof(v.strVal?v.strVal:\"\")); return make_float(0.0); }")
    emitLine(state, "static Value karkain_system(Value cmd) { if(cmd.type!=TYPE_STRING) return make_int(-1); int result=system(cmd.strVal?cmd.strVal:\"\"); return make_int(result); }")
    emitLine(state, "static Value karkain_removeFile(Value path) { if(path.type!=TYPE_STRING) return make_int(0); int result=remove(path.strVal?path.strVal:\"\"); return make_int(result==0?1:0); }")
    emitLine(state, "static Value removeFile(Value path) { return karkain_removeFile(path); }")
    emitLine(state, "static FILE* _karkain_files[256]; static int _karkain_file_count = 0;")
    emitLine(state, "static Value openFile(Value path) { if(path.type!=TYPE_STRING) return make_string(\"\"); FILE* f=fopen(path.strVal?path.strVal:\"\",\"rb\"); if(!f) return make_string(\"\"); fclose(f); return make_string(path.strVal); }")
    emitLine(state, "static Value readLine(Value handle) { if(handle.type!=TYPE_STRING||strlen(handle.strVal?handle.strVal:\"\")==0) return make_string(\"\"); int idx=-1; int i; for(i=0;i<_karkain_file_count;i++){ if(_karkain_files[i]!=NULL){ idx=i; break; } } if(idx==-1){ if(_karkain_file_count>=256) return make_string(\"\"); idx=_karkain_file_count; _karkain_files[idx]=fopen(handle.strVal?handle.strVal:\"\",\"rb\"); _karkain_file_count++; } else if(_karkain_files[idx]==NULL){ _karkain_files[idx]=fopen(handle.strVal?handle.strVal:\"\",\"rb\"); } if(!_karkain_files[idx]) return make_string(\"\"); char buf[4096]; if(fgets(buf,sizeof(buf),_karkain_files[idx])==NULL){ fclose(_karkain_files[idx]); _karkain_files[idx]=NULL; return make_string(\"\"); } int len=(int)strlen(buf); while(len>0&&(buf[len-1]=='\\n'||buf[len-1]=='\\r')) buf[--len]='\\0'; return make_string(buf); }")
    emitLine(state, "static Value readLineEOF(Value handle) { Value r=make_array(); if(handle.type!=TYPE_STRING||strlen(handle.strVal?handle.strVal:\"\")==0){ array_push(&r,make_string(\"\")); array_push(&r,make_bool(1)); return r; } int idx=-1; int i; for(i=0;i<_karkain_file_count;i++){ if(_karkain_files[i]!=NULL){ idx=i; break; } } if(idx==-1){ if(_karkain_file_count>=256){ array_push(&r,make_string(\"\")); array_push(&r,make_bool(1)); return r; } idx=_karkain_file_count; _karkain_files[idx]=fopen(handle.strVal?handle.strVal:\"\",\"rb\"); _karkain_file_count++; } else if(_karkain_files[idx]==NULL){ _karkain_files[idx]=fopen(handle.strVal?handle.strVal:\"\",\"rb\"); } if(!_karkain_files[idx]){ array_push(&r,make_string(\"\")); array_push(&r,make_bool(1)); return r; } char buf[4096]; if(fgets(buf,sizeof(buf),_karkain_files[idx])==NULL){ fclose(_karkain_files[idx]); _karkain_files[idx]=NULL; array_push(&r,make_string(\"\")); array_push(&r,make_bool(1)); return r; } int len=(int)strlen(buf); while(len>0&&(buf[len-1]=='\\n'||buf[len-1]=='\\r')) buf[--len]='\\0'; array_push(&r,make_string(buf)); array_push(&r,make_bool(0)); return r; }")
    emitLine(state, "static Value closeFile(Value handle) { (void)handle; int i; for(i=0;i<_karkain_file_count;i++){ if(_karkain_files[i]!=NULL){ fclose(_karkain_files[i]); _karkain_files[i]=NULL; break; } } return make_int(1); }")
    emitLine(state, "static Value createFile(Value path) { if(path.type!=TYPE_STRING) return make_string(\"\"); FILE* f=fopen(path.strVal?path.strVal:\"\",\"wb\"); if(f) fclose(f); return make_string(path.strVal); }")
    emitLine(state, "static Value writeToFile(Value handle, Value content) { if(handle.type!=TYPE_STRING||content.type!=TYPE_STRING) return make_int(0); FILE* f=fopen(handle.strVal?handle.strVal:\"\",\"wb\"); if(!f) return make_int(0); fputs(content.strVal?content.strVal:\"\",f); fclose(f); return make_int(1); }")
    emitLine(state, "static Value karkain_readFile(Value path) { if(path.type!=TYPE_STRING) return make_string(\"\"); FILE* f=fopen(path.strVal?path.strVal:\"\",\"rb\"); if(!f) return make_string(\"\"); fseek(f,0,SEEK_END); long sz=ftell(f); fseek(f,0,SEEK_SET); char* buf=(char*)malloc(sz+1); if(sz>0) fread(buf,1,sz,f); fclose(f); buf[sz]='\\0'; Value res=make_string(buf); free(buf); return res; }")
    emitLine(state, "static Value karkain_writeFile(Value path, Value content) { if(path.type!=TYPE_STRING) return make_int(0); FILE* f=fopen(path.strVal?path.strVal:\"\",\"wb\"); if(!f) return make_int(0); const char* str=(content.type==TYPE_STRING)?(content.strVal?content.strVal:\"\"):\"\"; fputs(str,f); fclose(f); return make_int(1); }")
    emitLine(state, "static Value karkain_trim(Value str) { if(str.type!=TYPE_STRING) return make_string(\"\"); char* s=str.strVal?str.strVal:\"\"; char* start=s; char* end=s+strlen(s)-1; while(start<=end&&(*start==' '||*start=='\\t'||*start=='\\n'||*start=='\\r')) start++; while(end>=start&&(*end==' '||*end=='\\t'||*end=='\\n'||*end=='\\r')) end--; size_t len=(end>=start)?(end-start+1):0; char* buf=(char*)malloc(len+1); if(len>0) memcpy(buf,start,len); buf[len]='\\0'; Value res=make_string(buf); free(buf); return res; }")
    emitLine(state, "static Value karkain_contains(Value haystack, Value needle) { if(haystack.type!=TYPE_STRING||needle.type!=TYPE_STRING) return make_int(0); return make_int(strstr(haystack.strVal?haystack.strVal:\"\",needle.strVal?needle.strVal:\"\")!=NULL); }")
    emitLine(state, "static Value karkain_split(Value str, Value delim) { if(str.type!=TYPE_STRING||delim.type!=TYPE_STRING) return make_array(); Value arr=make_array(); char* s=strdup(str.strVal?str.strVal:\"\"); char* d=delim.strVal?delim.strVal:\"\"; char* token=strtok(s,d); while(token!=NULL){ array_push(&arr,make_string(token)); token=strtok(NULL,d); } free(s); return arr; }")
    emitLine(state, "static Value karkain_sqrt(Value v) { if(v.type!=TYPE_INT) return make_int(0); return make_int((long long)sqrt((double)v.intVal)); }")
    emitLine(state, "static Value karkain_abs(Value v) { if(v.type!=TYPE_INT) return make_int(0); return make_int(v.intVal>=0?v.intVal:-v.intVal); }")
    emitLine(state, "static Value karkain_pow(Value base, Value exp) { if(base.type!=TYPE_INT||exp.type!=TYPE_INT) return make_int(0); long long result=1; long long b=base.intVal; long long e=exp.intVal; while(e>0){ if(e&1) result*=b; b*=b; e>>=1; } return make_int(result); }")
    emitLine(state, "static Value karkain_hasKey(Value m, Value k) { if(m.type!=TYPE_MAP) return make_int(0); int i; for(i=0;i<m.mlen;i++){ const char* key=k.strVal?k.strVal:\"\"; if(strcmp(m.keys[i],key)==0) return make_int(1); } return make_int(0); }")
    emitLine(state, "static void karkain_delete(Value* m, Value k) { if(!m||m->type!=TYPE_MAP) return; const char* key=k.strVal?k.strVal:\"\"; int i; for(i=0;i<m->mlen;i++){ if(strcmp(m->keys[i],key)==0){ int j; for(j=i;j<m->mlen-1;j++){ m->keys[j]=m->keys[j+1]; m->values[j]=m->values[j+1]; } m->mlen--; return; } } }")
    emitLine(state, "static Value karkain_appendArray(Value* arr, Value elem) { if(!arr||arr->type!=TYPE_ARRAY) return make_int(0); array_push(arr, elem); return *arr; }")
    // Phase 125A: networking runtime (cross-platform TCP sockets). Mirrors the
    // Go-engine helpers in pkg/codegen/codegen.go so both engines produce
    // identical net builtin behavior. Failures return -1 (or "") and record a
    // deterministic last-error string readable through karkain_net_last_error.
    emitLine(state, "// Phase 125A: Networking runtime (cross-platform TCP sockets).")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "#include <winsock2.h>")
    emitLine(state, "#include <windows.h>")
    emitLine(state, "#include <ws2tcpip.h>")
    emitLine(state, "typedef SOCKET KarkainSock;")
    emitLine(state, "#define KARKAIN_INVALID_SOCKET INVALID_SOCKET")
    emitLine(state, "#else")
    emitLine(state, "#include <sys/socket.h>")
    emitLine(state, "#include <netinet/in.h>")
    emitLine(state, "#include <arpa/inet.h>")
    emitLine(state, "#include <netdb.h>")
    emitLine(state, "#include <errno.h>")
    emitLine(state, "#include <sys/time.h>")
    emitLine(state, "#include <unistd.h>")
    emitLine(state, "#define closesocket close")
    emitLine(state, "typedef int KarkainSock;")
    emitLine(state, "#define KARKAIN_INVALID_SOCKET (-1)")
    emitLine(state, "#endif")
    emitLine(state, "static int _karkain_net_started = 0;")
    emitLine(state, "static char _karkain_net_error[512] = \"\";")
    emitLine(state, "static void karkain_net_err(const char* msg) { snprintf(_karkain_net_error, sizeof(_karkain_net_error), \"%s\", msg ? msg : \"network failure\"); }")
    emitLine(state, "static void karkain_net_errno(const char* prefix) {")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "    snprintf(_karkain_net_error, sizeof(_karkain_net_error), \"%s: wsa error %d\", prefix ? prefix : \"network failure\", (int)WSAGetLastError());")
    emitLine(state, "#else")
    emitLine(state, "    snprintf(_karkain_net_error, sizeof(_karkain_net_error), \"%s: %s\", prefix ? prefix : \"network failure\", strerror(errno));")
    emitLine(state, "#endif")
    emitLine(state, "}")
    emitLine(state, "static void karkain_net_init(void) {")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "    if (!_karkain_net_started) { WSADATA wsa; if (WSAStartup(MAKEWORD(2, 2), &wsa) == 0) _karkain_net_started = 1; else karkain_net_errno(\"network init failed\"); }")
    emitLine(state, "#endif")
    emitLine(state, "}")
    emitLine(state, "static int karkain_net_resolve(const char* host, int port, struct sockaddr_storage* out, socklen_t* outlen) {")
    emitLine(state, "    char pbuf[16];")
    emitLine(state, "    struct addrinfo hints;")
    emitLine(state, "    struct addrinfo* res = NULL;")
    emitLine(state, "    memset(&hints, 0, sizeof(hints));")
    emitLine(state, "    hints.ai_family = AF_UNSPEC;")
    emitLine(state, "    hints.ai_socktype = SOCK_STREAM;")
    emitLine(state, "    snprintf(pbuf, sizeof(pbuf), \"%d\", port);")
    emitLine(state, "    int rc = getaddrinfo(host, pbuf, &hints, &res);")
    emitLine(state, "    if (rc != 0 || res == NULL) { karkain_net_err(\"invalid address\"); return -1; }")
    emitLine(state, "    memcpy(out, res->ai_addr, res->ai_addrlen);")
    emitLine(state, "    *outlen = (socklen_t)res->ai_addrlen;")
    emitLine(state, "    freeaddrinfo(res);")
    emitLine(state, "    return 0;")
    emitLine(state, "}")
    emitLine(state, "static Value karkain_net_connect(Value host, Value port) {")
    emitLine(state, "    karkain_net_init();")
    emitLine(state, "    _karkain_net_error[0] = '\\0';")
    emitLine(state, "    if (host.type != TYPE_STRING || port.type != TYPE_INT) { karkain_net_err(\"invalid address\"); return make_int(-1); }")
    emitLine(state, "    const char* h = host.strVal ? host.strVal : \"\";")
    emitLine(state, "    int p = (int)port.intVal;")
    emitLine(state, "    if (p < 0 || p > 65535) { karkain_net_err(\"invalid address\"); return make_int(-1); }")
    emitLine(state, "    struct sockaddr_storage addr;")
    emitLine(state, "    socklen_t addrlen = 0;")
    emitLine(state, "    if (karkain_net_resolve(h, p, &addr, &addrlen) != 0) { return make_int(-1); }")
    emitLine(state, "    KarkainSock fd = (KarkainSock)socket(addr.ss_family, SOCK_STREAM, 0);")
    emitLine(state, "    if (fd == KARKAIN_INVALID_SOCKET) { karkain_net_errno(\"connection failure\"); return make_int(-1); }")
    emitLine(state, "    if (connect(fd, (struct sockaddr*)&addr, addrlen) != 0) { karkain_net_errno(\"connection failure\"); closesocket(fd); return make_int(-1); }")
    emitLine(state, "    return make_int((long long)fd);")
    emitLine(state, "}")
    emitLine(state, "static Value karkain_net_listen(Value host, Value port) {")
    emitLine(state, "    karkain_net_init();")
    emitLine(state, "    _karkain_net_error[0] = '\\0';")
    emitLine(state, "    if (host.type != TYPE_STRING || port.type != TYPE_INT) { karkain_net_err(\"invalid address\"); return make_int(-1); }")
    emitLine(state, "    const char* h = host.strVal ? host.strVal : \"\";")
    emitLine(state, "    int p = (int)port.intVal;")
    emitLine(state, "    if (p < 0 || p > 65535) { karkain_net_err(\"invalid address\"); return make_int(-1); }")
    emitLine(state, "    struct sockaddr_storage addr;")
    emitLine(state, "    socklen_t addrlen = 0;")
    emitLine(state, "    if (karkain_net_resolve(h, p, &addr, &addrlen) != 0) { return make_int(-1); }")
    emitLine(state, "    KarkainSock fd = (KarkainSock)socket(addr.ss_family, SOCK_STREAM, 0);")
    emitLine(state, "    if (fd == KARKAIN_INVALID_SOCKET) { karkain_net_errno(\"connection failure\"); return make_int(-1); }")
    emitLine(state, "    int one = 1;")
    emitLine(state, "    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (const char*)&one, sizeof(one));")
    emitLine(state, "    if (bind(fd, (struct sockaddr*)&addr, addrlen) != 0) { karkain_net_errno(\"connection failure\"); closesocket(fd); return make_int(-1); }")
    emitLine(state, "    if (listen(fd, 16) != 0) { karkain_net_errno(\"connection failure\"); closesocket(fd); return make_int(-1); }")
    emitLine(state, "    return make_int((long long)fd);")
    emitLine(state, "}")
    emitLine(state, "static Value karkain_net_accept(Value sfd) {")
    emitLine(state, "    karkain_net_init();")
    emitLine(state, "    _karkain_net_error[0] = '\\0';")
    emitLine(state, "    if (sfd.type != TYPE_INT) { karkain_net_err(\"invalid listener\"); return make_int(-1); }")
    emitLine(state, "    KarkainSock fd = (KarkainSock)sfd.intVal;")
    emitLine(state, "    KarkainSock c = (KarkainSock)accept(fd, NULL, NULL);")
    emitLine(state, "    if (c == KARKAIN_INVALID_SOCKET) { karkain_net_errno(\"accept failure\"); return make_int(-1); }")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "    unsigned long tmo = 5000;")
    emitLine(state, "    setsockopt(c, SOL_SOCKET, SO_RCVTIMEO, (const char*)&tmo, sizeof(tmo));")
    emitLine(state, "#else")
    emitLine(state, "    struct timeval tv;")
    emitLine(state, "    tv.tv_sec = 5;")
    emitLine(state, "    tv.tv_usec = 0;")
    emitLine(state, "    setsockopt(c, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));")
    emitLine(state, "#endif")
    emitLine(state, "    return make_int((long long)c);")
    emitLine(state, "}")
    emitLine(state, "static Value karkain_net_read(Value fdv, Value maxv) {")
    emitLine(state, "    karkain_net_init();")
    emitLine(state, "    _karkain_net_error[0] = '\\0';")
    emitLine(state, "    if (fdv.type != TYPE_INT || maxv.type != TYPE_INT) { karkain_net_err(\"read failure: invalid argument\"); return make_string(\"\"); }")
    emitLine(state, "    KarkainSock fd = (KarkainSock)fdv.intVal;")
    emitLine(state, "    long long maxn = maxv.intVal;")
    emitLine(state, "    if (maxn < 0) { maxn = 0; }")
    emitLine(state, "    if (maxn > 65536) { maxn = 65536; }")
    emitLine(state, "    char* buf = (char*)malloc((size_t)maxn + 1);")
    emitLine(state, "    if (!buf) { karkain_net_err(\"read failure: out of memory\"); return make_string(\"\"); }")
    emitLine(state, "    int n = (int)recv(fd, buf, (size_t)maxn, 0);")
    emitLine(state, "    if (n < 0) {")
    emitLine(state, "        free(buf);")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "        if (WSAGetLastError() == WSAETIMEDOUT) { karkain_net_err(\"read failure: timeout\"); } else { karkain_net_errno(\"read failure\"); }")
    emitLine(state, "#else")
    emitLine(state, "        if (errno == EAGAIN || errno == EWOULDBLOCK || errno == ETIMEDOUT) { karkain_net_err(\"read failure: timeout\"); } else { karkain_net_errno(\"read failure\"); }")
    emitLine(state, "#endif")
    emitLine(state, "        return make_string(\"\");")
    emitLine(state, "    }")
    emitLine(state, "    if (n == 0) { free(buf); return make_string(\"\"); }")
    emitLine(state, "    buf[n] = '\\0';")
    emitLine(state, "    Value r = make_string(buf);")
    emitLine(state, "    free(buf);")
    emitLine(state, "    return r;")
    emitLine(state, "}")
    emitLine(state, "static Value karkain_net_write(Value fdv, Value data) {")
    emitLine(state, "    karkain_net_init();")
    emitLine(state, "    _karkain_net_error[0] = '\\0';")
    emitLine(state, "    if (fdv.type != TYPE_INT || data.type != TYPE_STRING) { karkain_net_err(\"write failure: invalid argument\"); return make_int(-1); }")
    emitLine(state, "    KarkainSock fd = (KarkainSock)fdv.intVal;")
    emitLine(state, "    const char* s = data.strVal ? data.strVal : \"\";")
    emitLine(state, "    size_t total = strlen(s);")
    emitLine(state, "    size_t sent = 0;")
    emitLine(state, "    while (sent < total) {")
    emitLine(state, "        size_t chunk = (total - sent) > (size_t)0x4000 ? (size_t)0x4000 : (total - sent);")
    emitLine(state, "        int n = (int)send(fd, s + sent, (int)chunk, 0);")
    emitLine(state, "        if (n <= 0) { karkain_net_errno(\"write failure\"); return make_int(-1); }")
    emitLine(state, "        sent = sent + (size_t)n;")
    emitLine(state, "    }")
    emitLine(state, "    return make_int((long long)sent);")
    emitLine(state, "}")
    emitLine(state, "static Value karkain_net_close(Value fdv) {")
    emitLine(state, "    karkain_net_init();")
    emitLine(state, "    _karkain_net_error[0] = '\\0';")
    emitLine(state, "    if (fdv.type != TYPE_INT) { karkain_net_err(\"connection closed: invalid fd\"); return make_int(-1); }")
    emitLine(state, "    KarkainSock fd = (KarkainSock)fdv.intVal;")
    emitLine(state, "    if (closesocket(fd) == 0) { return make_int(1); }")
    emitLine(state, "    karkain_net_errno(\"connection closed\");")
    emitLine(state, "    return make_int(-1);")
    emitLine(state, "}")
    emitLine(state, "static Value karkain_net_last_error(void) { return make_string(_karkain_net_error); }")
    // Phase 109: stdlib v2 runtime byte helpers (encoding / crypto / map iteration).
    emitLine(state, "static const char* P109_HEXD = \"0123456789abcdef\";")
    emitLine(state, "static Value karkain_mapKeys(Value m) { Value res=make_array(); if(m.type!=TYPE_MAP) return res; int i; for(i=0;i<m.mlen;i++){ if(m.keys[i]) array_push(&res, make_string(m.keys[i])); } return res; }")
    emitLine(state, "static Value karkain_hexEncode(Value s) { if(s.type!=TYPE_STRING) return make_string(\"\"); const char* in=s.strVal?s.strVal:\"\"; size_t n=strlen(in); char* out=(char*)malloc(2*n+1); size_t i; for(i=0;i<n;i++){ out[2*i]=P109_HEXD[((unsigned char)in[i])>>4]; out[2*i+1]=P109_HEXD[((unsigned char)in[i])&15]; } out[2*n]=0; Value r=make_string(out); free(out); return r; }")
    emitLine(state, "static Value karkain_hexDecode(Value s, const char* file, long long line) { if(s.type!=TYPE_STRING) karkain_runtime_error(\"invalid hex string\", file, line); const char* in=s.strVal?s.strVal:\"\"; size_t n=strlen(in); if(n%2!=0) karkain_runtime_error(\"invalid hex string (odd length)\", file, line); char* out=(char*)malloc(n/2+1); size_t i; for(i=0;i<n;i+=2){ int h=0,l=0; char c1=in[i],c2=in[i+1]; if(c1>='0'&&c1<='9') h=c1-'0'; else if(c1>='a'&&c1<='f') h=c1-'a'+10; else if(c1>='A'&&c1<='F') h=c1-'A'+10; else karkain_runtime_error(\"invalid hex string\", file, line); if(c2>='0'&&c2<='9') l=c2-'0'; else if(c2>='a'&&c2<='f') l=c2-'a'+10; else if(c2>='A'&&c2<='F') l=c2-'A'+10; else karkain_runtime_error(\"invalid hex string\", file, line); out[i/2]=(char)((h<<4)|l); } out[n/2]=0; Value r=make_string(out); free(out); return r; }")
    emitLine(state, "static Value karkain_base64Encode(Value s) { if(s.type!=TYPE_STRING) return make_string(\"\"); const char* in=s.strVal?s.strVal:\"\"; size_t n=strlen(in); static const char* BB=\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"; size_t outlen=((n+2)/3)*4; char* out=(char*)malloc(outlen+1); size_t i=0,j=0; for(i=0;i+2<n;i+=3){ unsigned v=(((unsigned char)in[i])<<16)|(((unsigned char)in[i+1])<<8)|((unsigned char)in[i+2]); out[j++]=BB[(v>>18)&63]; out[j++]=BB[(v>>12)&63]; out[j++]=BB[(v>>6)&63]; out[j++]=BB[v&63]; } if(i<n){ unsigned v=((unsigned char)in[i])<<16; out[j++]=BB[(v>>18)&63]; if(i+1<n){ v|=((unsigned char)in[i+1])<<8; out[j++]=BB[(v>>12)&63]; out[j++]=BB[(v>>6)&63]; out[j++]='='; } else { out[j++]=BB[(v>>12)&63]; out[j++]='='; out[j++]='='; } } out[j]=0; Value r=make_string(out); free(out); return r; }")
    emitLine(state, "static Value karkain_base64Decode(Value s, const char* file, long long line) { if(s.type!=TYPE_STRING) karkain_runtime_error(\"invalid base64 string\", file, line); const char* in=s.strVal?s.strVal:\"\"; size_t n=strlen(in); if(n%4!=0) karkain_runtime_error(\"invalid base64 string (length)\", file, line); char* out=(char*)malloc(n/4*3+1); size_t i=0,o=0; for(i=0;i<n;i+=4){ int vals[4]; int t; for(t=0;t<4;t++){ char c=in[i+t]; int val=-1; if(c>='A'&&c<='Z') val=c-'A'; else if(c>='a'&&c<='z') val=c-'a'+26; else if(c>='0'&&c<='9') val=c-'0'+52; else if(c=='+') val=62; else if(c=='/') val=63; else if(c=='=') val=0; else karkain_runtime_error(\"invalid base64 string\", file, line); vals[t]=val; } unsigned v=(vals[0]<<18)|(vals[1]<<12)|(vals[2]<<6)|vals[3]; out[o++]=(char)((v>>16)&0xFF); if(in[i+2]!='=') out[o++]=(char)((v>>8)&0xFF); if(in[i+3]!='=') out[o++]=(char)(v&0xFF); } out[o]=0; Value r=make_string(out); free(out); return r; }")
    emitLine(state, "static Value karkain_utf8Valid(Value s) { if(s.type!=TYPE_STRING) return make_int(0); const unsigned char* p=(const unsigned char*)(s.strVal?s.strVal:\"\"); size_t n=strlen((const char*)p); size_t i=0; while(i<n){ unsigned char c=p[i]; if(c<0x80){ i++; } else if((c>>5)==0x6){ if(i+1>=n) return make_int(0); unsigned char c2=p[i+1]; if((c2&0xC0)!=0x80) return make_int(0); unsigned u=((unsigned)(c&0x1F)<<6)|(c2&0x3F); if(u<0x80) return make_int(0); i+=2; } else if((c>>4)==0xE){ if(i+2>=n) return make_int(0); unsigned char c2=p[i+1],c3=p[i+2]; if((c2&0xC0)!=0x80||(c3&0xC0)!=0x80) return make_int(0); unsigned u=((unsigned)(c&0x0F)<<12)|((unsigned)(c2&0x3F)<<6)|(c3&0x3F); if(u<0x800||(u>=0xD800&&u<=0xDFFF)) return make_int(0); i+=3; } else if((c>>3)==0x1E){ if(i+3>=n) return make_int(0); unsigned char c2=p[i+1],c3=p[i+2],c4=p[i+3]; if((c2&0xC0)!=0x80||(c3&0xC0)!=0x80||(c4&0xC0)!=0x80) return make_int(0); unsigned u=((unsigned)(c&0x07)<<18)|((unsigned)(c2&0x3F)<<12)|((unsigned)(c3&0x3F)<<6)|(c4&0x3F); if(u<0x10000||u>0x10FFFF) return make_int(0); i+=4; } else { return make_int(0); } } return make_int(1); }")
    emitLine(state, "#define P109_ROTRIGHT(a, b) (((a) >> (b)) | ((a) << (32 - (b))))")
    emitLine(state, "#define P109_ROTRIGHT64(a, b) (((a) >> (b)) | ((a) << (64 - (b))))")
    emitLine(state, "#define P109_CH(x, y, z) (((x) & (y)) ^ (~(x) & (z)))")
    emitLine(state, "#define P109_MAJ(x, y, z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))")
    emitLine(state, "#define P109_SIG0(x) (P109_ROTRIGHT(x, 7) ^ P109_ROTRIGHT(x, 18) ^ ((x) >> 3))")
    emitLine(state, "#define P109_SIG1(x) (P109_ROTRIGHT(x, 17) ^ P109_ROTRIGHT(x, 19) ^ ((x) >> 10))")
    emitLine(state, "#define P109_EP0(x) (P109_ROTRIGHT(x, 2) ^ P109_ROTRIGHT(x, 13) ^ P109_ROTRIGHT(x, 22))")
    emitLine(state, "#define P109_EP1(x) (P109_ROTRIGHT(x, 6) ^ P109_ROTRIGHT(x, 11) ^ P109_ROTRIGHT(x, 25))")
    emitLine(state, "#define P109_SIG064(x) (P109_ROTRIGHT64(x, 1) ^ P109_ROTRIGHT64(x, 8) ^ ((x) >> 7))")
    emitLine(state, "#define P109_SIG164(x) (P109_ROTRIGHT64(x, 19) ^ P109_ROTRIGHT64(x, 61) ^ ((x) >> 6))")
    emitLine(state, "#define P109_EP064(x) (P109_ROTRIGHT64(x, 28) ^ P109_ROTRIGHT64(x, 34) ^ P109_ROTRIGHT64(x, 39))")
    emitLine(state, "#define P109_EP164(x) (P109_ROTRIGHT64(x, 14) ^ P109_ROTRIGHT64(x, 18) ^ P109_ROTRIGHT64(x, 41))")
    emitLine(state, "static const unsigned int P109_K256[64] = {")
    emitLine(state, "0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};")
    emitLine(state, "static Value karkain_sha256(Value s) { if(s.type!=TYPE_STRING) return make_string(\"\"); const unsigned char* msg=(const unsigned char*)(s.strVal?s.strVal:\"\"); unsigned long long len=(unsigned long long)strlen((const char*)msg); unsigned int h[8]={0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19}; size_t padlen=((len+9+63)/64)*64-(size_t)len; unsigned char* pad=(unsigned char*)malloc(padlen); unsigned long long bitlen=len*8; size_t pi; for(pi=0;pi<padlen;pi++) pad[pi]=0; pad[0]=0x80; for(pi=0;pi<8;pi++) pad[padlen-8+pi]=(unsigned char)((bitlen>>(56-8*pi))&0xFF); { size_t total=(size_t)len+padlen; size_t pos=0; while(pos<total){ unsigned char block[64]; size_t take; for(take=0;take<64;take++){ size_t src=pos+take; block[take]=(src<(size_t)len)?msg[src]:pad[src-(size_t)len]; } { unsigned int w[64]; int t; unsigned int a,b,c,d,e,f,g,hh,t1,t2; for(t=0;t<16;t++) w[t]=((unsigned int)block[4*t]<<24)|((unsigned int)block[4*t+1]<<16)|((unsigned int)block[4*t+2]<<8)|((unsigned int)block[4*t+3]); for(t=16;t<64;t++) w[t]=P109_SIG1(w[t-2])+w[t-7]+P109_SIG0(w[t-15])+w[t-16]; a=h[0]; b=h[1]; c=h[2]; d=h[3]; e=h[4]; f=h[5]; g=h[6]; hh=h[7]; for(t=0;t<64;t++){ t1=hh+P109_EP1(e)+P109_CH(e,f,g)+P109_K256[t]+w[t]; t2=P109_EP0(a)+P109_MAJ(a,b,c); hh=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2; } h[0]+=a; h[1]+=b; h[2]+=c; h[3]+=d; h[4]+=e; h[5]+=f; h[6]+=g; h[7]+=hh; } pos+=64; } } free(pad); char* out=(char*)malloc(65); int i2; for(i2=0;i2<8;i2++){ unsigned int w=h[i2]; int k; for(k=7;k>=0;k--) out[i2*8+(7-k)]=P109_HEXD[(w>>(4*k))&15]; } out[64]=0; Value r=make_string(out); free(out); return r; }")
    emitLine(state, "static const unsigned long long P109_K512[80] = {")
    emitLine(state, "0x428a2f98d728ae22ULL,0x7137449123ef65cdULL,0xb5c0fbcfec4d3b2fULL,0xe9b5dba58189dbbcULL,0x3956c25bf348b538ULL,0x59f111f1b605d019ULL,0x923f82a4af194f9bULL,0xab1c5ed5da6d8118ULL,0xd807aa98a3030242ULL,0x12835b0145706fbeULL,0x243185be4ee4b28cULL,0x550c7dc3d5ffb4e2ULL,0x72be5d74f27b896fULL,0x80deb1fe3b1696b1ULL,0x9bdc06a725c71235ULL,0xc19bf174cf692694ULL,0xe49b69c19ef14ad2ULL,0xefbe4786384f25e3ULL,0x0fc19dc68b8cd5b5ULL,0x240ca1cc77ac9c65ULL,0x2de92c6f592b0275ULL,0x4a7484aa6ea6e483ULL,0x5cb0a9dcbd41fbd4ULL,0x76f988da831153b5ULL,0x983e5152ee66dfabULL,0xa831c66d2db43210ULL,0xb00327c898fb213fULL,0xbf597fc7beef0ee4ULL,0xc6e00bf33da88fc2ULL,0xd5a79147930aa725ULL,0x06ca6351e003826fULL,0x142929670a0e6e70ULL,0x27b70a8546d22ffcULL,0x2e1b21385c26c926ULL,0x4d2c6dfc5ac42aedULL,0x53380d139d95b3dfULL,0x650a73548baf63deULL,0x766a0abb3c77b2a8ULL,0x81c2c92e47edaee6ULL,0x92722c851482353bULL,0xa2bfe8a14cf10364ULL,0xa81a664bbc423001ULL,0xc24b8b70d0f89791ULL,0xc76c51a30654be30ULL,0xd192e819d6ef5218ULL,0xd69906245565a910ULL,0xf40e35855771202aULL,0x106aa07032bbd1b8ULL,0x19a4c116b8d2d0c8ULL,0x1e376c085141ab53ULL,0x2748774cdf8eeb99ULL,0x34b0bcb5e19b48a8ULL,0x391c0cb3c5c95a63ULL,0x4ed8aa4ae3418acbULL,0x5b9cca4f7763e373ULL,0x682e6ff3d6b2b8a3ULL,0x748f82ee5defb2fcULL,0x78a5636f43172f60ULL,0x84c87814a1f0ab72ULL,0x8cc702081a6439ecULL,0x90befffa23631e28ULL,0xa4506cebde82bde9ULL,0xbef9a3f7b2c67915ULL,0xc67178f2e372532bULL,0xca273eceea26619cULL,0xd186b8c721c0c207ULL,0xeada7dd6cde0eb1eULL,0xf57d4f7fee6ed178ULL,0x06f067aa72176fbaULL,0x0a637dc5a2c898a6ULL,0x113f9804bef90daeULL,0x1b710b35131c471bULL,0x28db77f523047d84ULL,0x32caab7b40c72493ULL,0x3c9ebe0a15c9bebcULL,0x431d67c49c100d4cULL,0x4cc5d4becb3e42b6ULL,0x597f299cfc657e2aULL,0x5fcb6fab3ad6faecULL,0x6c44198c4a475817ULL};")
    emitLine(state, "static Value karkain_sha512(Value s) { if(s.type!=TYPE_STRING) return make_string(\"\"); const unsigned char* msg=(const unsigned char*)(s.strVal?s.strVal:\"\"); unsigned long long len=(unsigned long long)strlen((const char*)msg); unsigned long long h[8]={0x6a09e667f3bcc908ULL,0xbb67ae8584caa73bULL,0x3c6ef372fe94f82bULL,0xa54ff53a5f1d36f1ULL,0x510e527fade682d1ULL,0x9b05688c2b3e6c1fULL,0x1f83d9abfb41bd6bULL,0x5be0cd19137e2179ULL}; size_t padlen=((len+17+127)/128)*128-(size_t)len; unsigned char* pad=(unsigned char*)malloc(padlen); unsigned long long bitlen=len*8; size_t pi; for(pi=0;pi<padlen;pi++) pad[pi]=0; pad[0]=0x80; for(pi=0;pi<8;pi++) pad[padlen-8+pi]=(unsigned char)((bitlen>>(56-8*pi))&0xFF); { size_t total=(size_t)len+padlen; size_t pos=0; while(pos<total){ unsigned char block[128]; size_t take; for(take=0;take<128;take++){ size_t src=pos+take; block[take]=(src<(size_t)len)?msg[src]:pad[src-(size_t)len]; } { unsigned long long w[80]; int t; unsigned long long a,b,c,d,e,f,g,hh,t1,t2; for(t=0;t<16;t++) w[t]=((unsigned long long)block[8*t]<<56)|((unsigned long long)block[8*t+1]<<48)|((unsigned long long)block[8*t+2]<<40)|((unsigned long long)block[8*t+3]<<32)|((unsigned long long)block[8*t+4]<<24)|((unsigned long long)block[8*t+5]<<16)|((unsigned long long)block[8*t+6]<<8)|((unsigned long long)block[8*t+7]); for(t=16;t<80;t++) w[t]=P109_SIG164(w[t-2])+w[t-7]+P109_SIG064(w[t-15])+w[t-16]; a=h[0]; b=h[1]; c=h[2]; d=h[3]; e=h[4]; f=h[5]; g=h[6]; hh=h[7]; for(t=0;t<80;t++){ t1=hh+P109_EP164(e)+P109_CH(e,f,g)+P109_K512[t]+w[t]; t2=P109_EP064(a)+P109_MAJ(a,b,c); hh=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2; } h[0]+=a; h[1]+=b; h[2]+=c; h[3]+=d; h[4]+=e; h[5]+=f; h[6]+=g; h[7]+=hh; } pos+=128; } } free(pad); char* out=(char*)malloc(129); int i2; for(i2=0;i2<8;i2++){ unsigned long long w=h[i2]; int k; for(k=15;k>=0;k--) out[i2*16+(15-k)]=P109_HEXD[(w>>(4*k))&15]; } out[128]=0; Value r=make_string(out); free(out); return r; }")
    emitNewline(state)
}

// All Karkain values are represented dynamically as `Value` in the emitted C.
func emitC11Type(varType) {
    return "Value"
}

func emitC11Expr(state, node) {
    let nt = getNodeType(node)

    if (nt == "IntLiteral") { emit(state, "make_int(" + literalValue(node) + ")") }
    if (nt == "FloatLiteral") { emit(state, "make_float(" + literalValue(node) + ")") }
    if (nt == "StringLiteral") {
        emit(state, "make_string(\"" + literalValue(node) + "\")")
    }
    if (nt == "BoolLiteral") {
        if (literalValue(node) == "true") { emit(state, "make_bool(1)") }
        if (literalValue(node) == "false") { emit(state, "make_bool(0)") }
    }
    if (nt == "Ident") {
        let nm = identName(node)
        if (capInList(codegenCurrentCaps(state), nm) == 1) {
            emit(state, "(*_env->" + nm + ")")
        } else {
            emit(state, nm)
        }
    }

    if (nt == "BinaryExpr") {
        if (binaryOp(node) == "=") {
            let lhs = binaryLeft(node)
            let rv = binaryRight(node)
            if (getNodeType(lhs) == "Index") {
                let il = indexLeft(lhs)
                let ix = indexExpr(lhs)
                if (getNodeType(il) == "Ident") {
                    emit(state, "karkain_checked_set(&" + identName(il) + ", ")
                    emitC11Expr(state, ix)
                    emit(state, ", ")
                    emitC11Expr(state, rv)
                    emit(state, ", \"" + codegenSourceName(state) + "\", " + binaryLine(node) + ")")
                } else {
                    emit(state, "({ Value _iset_tgt = ")
                    emitC11Expr(state, il)
                    emit(state, "; karkain_checked_set(&_iset_tgt, ")
                    emitC11Expr(state, ix)
                    emit(state, ", ")
                    emitC11Expr(state, rv)
                    emit(state, ", \"" + codegenSourceName(state) + "\", " + binaryLine(node) + "); _iset_tgt; })")
                }
            } else if (getNodeType(lhs) == "Member") {
                let dl = dotLeft(lhs)
                let dn = dotRight(lhs)
                if (getNodeType(dl) == "Ident") {
                    emit(state, "map_set(&" + identName(dl) + ", make_string(\"" + dn + "\"), ")
                    emitC11Expr(state, rv)
                    emit(state, ")")
                } else {
                    emit(state, "({ Value _ms_tgt = ")
                    emitC11Expr(state, dl)
                    emit(state, "; map_set(&_ms_tgt, make_string(\"" + dn + "\"), ")
                    emitC11Expr(state, rv)
                    emit(state, "); _ms_tgt; })")
                }
            } else {
                emit(state, "(")
                emitC11Expr(state, lhs)
                emit(state, " = ")
                emitC11Expr(state, rv)
                emit(state, ")")
            }
        } else {
            let bop = binaryOp(node)
            if (bop == "/") {
                emit(state, "karkain_checked_div(")
                emitC11Expr(state, binaryLeft(node))
                emit(state, ", ")
                emitC11Expr(state, binaryRight(node))
                emit(state, ", \"" + codegenSourceName(state) + "\", " + binaryLine(node) + ")")
            } else if (bop == "%") {
                emit(state, "karkain_checked_mod(")
                emitC11Expr(state, binaryLeft(node))
                emit(state, ", ")
                emitC11Expr(state, binaryRight(node))
                emit(state, ", \"" + codegenSourceName(state) + "\", " + binaryLine(node) + ")")
            } else {
                emit(state, "binary_op(")
                emitC11Expr(state, binaryLeft(node))
                emit(state, ", \"" + bop + "\", ")
                emitC11Expr(state, binaryRight(node))
                emit(state, ")")
            }
        }
    }

    if (nt == "UnaryExpr") {
        let op = unaryOp(node)
        if (op == "!") {
            emit(state, "make_bool(!is_truthy(")
            emitC11Expr(state, unaryOperand(node))
            emit(state, "))")
        }
        if (op == "-") {
            emit(state, "binary_op(make_int(0), \"-\", ")
            emitC11Expr(state, unaryOperand(node))
            emit(state, ")")
        }
    }

    if (nt == "Call") {
        let fname = callFunc(node)
        let args = callArgs(node)
        let argc = len(args)

        if (fname == "getArgs") {
            emit(state, "_karkain_get_args()")
        } else if (codegenLocalFuncHas(state, fname)) {
            // Phase 121: let-bound lambda call — closures take the env holder
            // as their first argument; zero-capture lambdas call the bare
            // top-level symbol.
            let ccaps = codegenLocalFuncCapsFor(state, fname)
            let au = 0
            emit(state, "karkain_user_" + fname + "(")
            if (len(ccaps) > 0) {
                emit(state, "_genv_" + fname)
                let src = 0
                while (src < argc) {
                    emit(state, ", ")
                    emitC11Expr(state, args[src])
                    src = src + 1
                }
            } else {
                while (au < argc) {
                    if (au > 0) { emit(state, ", ") }
                    emitC11Expr(state, args[au])
                    au = au + 1
                }
            }
            emit(state, ")")
        } else if (hasUserFunc(state, fname)) {
            emit(state, "karkain_user_" + fname + "(")
            let au = 0
            while (au < argc) {
                if (au > 0) { emit(state, ", ") }
                emitC11Expr(state, args[au])
                au = au + 1
            }
            emit(state, ")")
        } else if (fname == "len") {
            emit(state, "karkain_len(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "str") {
            emit(state, "karkain_str(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "int") {
            emit(state, "karkain_int(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "float") {
            emit(state, "karkain_float(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "substr") {
            emit(state, "karkain_substr(")
            let a0 = 0
            while (a0 < argc) {
                if (a0 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a0])
                a0 = a0 + 1
            }
            emit(state, ")")
        } else if (fname == "system") {
            emit(state, "karkain_system(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "removeFile") {
            emit(state, "removeFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "readFile") {
            emit(state, "karkain_readFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "writeFile") {
            emit(state, "karkain_writeFile(")
            let a1 = 0
            while (a1 < argc) {
                if (a1 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a1])
                a1 = a1 + 1
            }
            emit(state, ")")
        } else if (fname == "trim") {
            emit(state, "karkain_trim(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "contains") {
            emit(state, "karkain_contains(")
            let a2 = 0
            while (a2 < argc) {
                if (a2 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a2])
                a2 = a2 + 1
            }
            emit(state, ")")
        } else if (fname == "split") {
            emit(state, "karkain_split(")
            let a3 = 0
            while (a3 < argc) {
                if (a3 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a3])
                a3 = a3 + 1
            }
            emit(state, ")")
        } else if (fname == "listFiles") {
            emit(state, "karkain_listFiles(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "openFile") {
            emit(state, "openFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "readLine") {
            emit(state, "readLine(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "readLineEOF") {
            emit(state, "readLineEOF(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "closeFile") {
            emit(state, "closeFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "createFile") {
            emit(state, "createFile(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "writeToFile") {
            emit(state, "writeToFile(")
            let a4 = 0
            while (a4 < argc) {
                if (a4 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a4])
                a4 = a4 + 1
            }
            emit(state, ")")
        } else if (fname == "hasKey") {
            emit(state, "karkain_hasKey(")
            let a5 = 0
            while (a5 < argc) {
                if (a5 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a5])
                a5 = a5 + 1
            }
            emit(state, ")")
        } else if (fname == "appendArray" || fname == "push") {
            if (argc > 0 && getNodeType(args[0]) == "Ident") {
                emit(state, "karkain_appendArray(&" + identName(args[0]) + ", ")
                if (argc > 1) { emitC11Expr(state, args[1]) }
                emit(state, ")")
            } else {
                emit(state, "({ Value _ap_arr = ")
                if (argc > 0) { emitC11Expr(state, args[0]) }
                emit(state, "; karkain_appendArray(&_ap_arr, ")
                if (argc > 1) { emitC11Expr(state, args[1]) }
                emit(state, "); _ap_arr; })")
            }
        } else if (fname == "delete") {
            emit(state, "karkain_delete(&")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ", ")
            if (argc > 1) { emitC11Expr(state, args[1]) }
            emit(state, ")")
        } else if (fname == "sqrt") {
            emit(state, "karkain_sqrt(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "abs") {
            emit(state, "karkain_abs(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "assert" || fname == "assert_eq" || fname == "assert_ne") {
            let albl = "assert(condition)"
            if (fname == "assert_eq") { albl = "assert_eq(actual, expected)" }
            if (fname == "assert_ne") { albl = "assert_ne(actual, expected)" }
            emit(state, "karkain_" + fname + "(")
            let ai = 0
            while (ai < argc) {
                if (ai > 0) { emit(state, ", ") }
                emitC11Expr(state, args[ai])
                ai = ai + 1
            }
            emit(state, ", \"" + albl + "\", \"\")")
        } else if (fname == "pow") {
            emit(state, "karkain_pow(")
            let a6 = 0
            while (a6 < argc) {
                if (a6 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a6])
                a6 = a6 + 1
            }
            emit(state, ")")
        } else if (fname == "add_checked") {
            emit(state, "karkain_checked_add(")
            let a7 = 0
            while (a7 < argc) {
                if (a7 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a7])
                a7 = a7 + 1
            }
            emit(state, ")")
        } else if (fname == "sub_checked") {
            emit(state, "karkain_checked_sub(")
            let a8 = 0
            while (a8 < argc) {
                if (a8 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a8])
                a8 = a8 + 1
            }
            emit(state, ")")
        } else if (fname == "mul_checked") {
            emit(state, "karkain_checked_mul(")
            let a9 = 0
            while (a9 < argc) {
                if (a9 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[a9])
                a9 = a9 + 1
            }
            emit(state, ")")
        } else if (fname == "hex_encode_bytes") {
            emit(state, "karkain_hexEncode(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "hex_decode_bytes") {
            emit(state, "karkain_hexDecode(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ", \"" + codegenSourceName(state) + "\", " + callLine(node) + ")")
        } else if (fname == "base64_encode_bytes") {
            emit(state, "karkain_base64Encode(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "base64_decode_bytes") {
            emit(state, "karkain_base64Decode(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ", \"" + codegenSourceName(state) + "\", " + callLine(node) + ")")
        } else if (fname == "utf8_valid_bytes") {
            emit(state, "karkain_utf8Valid(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "sha256_hex") {
            emit(state, "karkain_sha256(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "sha512_hex") {
            emit(state, "karkain_sha512(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "map_keys_of") {
            emit(state, "karkain_mapKeys(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "net_connect") {
            emit(state, "karkain_net_connect(")
            let bn0 = 0
            while (bn0 < argc) {
                if (bn0 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[bn0])
                bn0 = bn0 + 1
            }
            emit(state, ")")
        } else if (fname == "net_listen") {
            emit(state, "karkain_net_listen(")
            let bn1 = 0
            while (bn1 < argc) {
                if (bn1 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[bn1])
                bn1 = bn1 + 1
            }
            emit(state, ")")
        } else if (fname == "net_accept") {
            emit(state, "karkain_net_accept(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "net_read") {
            emit(state, "karkain_net_read(")
            let bn2 = 0
            while (bn2 < argc) {
                if (bn2 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[bn2])
                bn2 = bn2 + 1
            }
            emit(state, ")")
        } else if (fname == "net_write") {
            emit(state, "karkain_net_write(")
            let bn3 = 0
            while (bn3 < argc) {
                if (bn3 > 0) { emit(state, ", ") }
                emitC11Expr(state, args[bn3])
                bn3 = bn3 + 1
            }
            emit(state, ")")
        } else if (fname == "net_close") {
            emit(state, "karkain_net_close(")
            if (argc > 0) { emitC11Expr(state, args[0]) }
            emit(state, ")")
        } else if (fname == "net_last_error") {
            emit(state, "karkain_net_last_error()")
        } else {
            emit(state, fname + "(")
            let i = 0
            while (i < argc) {
                if (i > 0) { emit(state, ", ") }
                emitC11Expr(state, args[i])
                i = i + 1
            }
            emit(state, ")")
        }
    }

    if (nt == "Match") {
        emit(state, "({ Value _match_val = ")
        emitC11Expr(state, matchValue(node))
        emit(state, "; Value _match_result = _match_val; ")
        let arms = matchArms(node)
        let narm = len(arms)
        let ai = 0
        while (ai < narm) {
            let arm = arms[ai]
            if (ai > 0) { emit(state, " else ") }
            emit(state, "if (")
            let pt = armPatternType(arm)
            if (pt == "Some") { emit(state, "_match_val.type == TYPE_OPTION && _match_val.optVal.tag == 1") }
            else if (pt == "None") { emit(state, "_match_val.type == TYPE_OPTION && _match_val.optVal.tag == 0") }
            else if (pt == "Ok") { emit(state, "_match_val.type == TYPE_RESULT && _match_val.resVal.tag == 0") }
            else if (pt == "Err") { emit(state, "_match_val.type == TYPE_RESULT && _match_val.resVal.tag == 1") }
            else if (pt == "enum_variant") {
                // Phase 123: EnumName.Variant arm => compare the int tag.
                // Binding form is "Enum.Variant" (parser strcat'd the two).
                let bnd = armBinding(arm)
                let paylen = len(bnd)
                let col = -1
                let cx = 0
                while (cx < paylen) {
                    if (substr(bnd, cx, 1) == ".") { col = cx }
                    cx = cx + 1
                }
                let enm = bnd
                let varName = ""
                let idx = -1
                if (col >= 0) {
                    enm = substr(bnd, 0, col)
                    varName = substr(bnd, col + 1, paylen - col - 1)
                    idx = getEnumVariantIndex(state, enm, varName)
                }
                if (idx >= 0) {
                    emit(state, "is_truthy(binary_op(_match_val, \"==\", make_int(" + str(idx) + ")))")
                } else {
                    emit(state, "1")
                }
            }
            else if (pt == "literal") {
                emit(state, "is_truthy(binary_op(_match_val, \"==\", ")
                emitC11Expr(state, armPatternValue(arm))
                emit(state, "))")
            } else { emit(state, "1") }
            emit(state, ") { ")
            let binding = armBinding(arm)
            if (binding != "" && binding != "_") {
                if (pt == "Some") { emit(state, "Value " + binding + " = *_match_val.optVal.inner; ") }
                else if (pt == "Ok") { emit(state, "Value " + binding + " = *_match_val.resVal.okVal; ") }
                else if (pt == "Err") { emit(state, "Value " + binding + " = *_match_val.resVal.errVal; ") }
                else if (pt == "enum_variant") { /* Phase 123: no binding; the arm matches on tag only */ }
                else { emit(state, "Value " + binding + " = _match_val; ") }
            }
            emitMatchArmBody(state, armBody(arm))
            emit(state, " }")
            ai = ai + 1
        }
        emit(state, " _match_result; })")
    }

    if (nt == "GlobalId") {
        let dim = globalIdDim(node)
        emit(state, "get_global_id(")
        emitC11Expr(state, dim)
        emit(state, ")")
    }

    if (nt == "Member") {
        emit(state, "map_get(")
        emitC11Expr(state, memberObject(node))
        emit(state, ", make_string(\"" + memberField(node) + "\"))")
    }

    // Phase 123: EnumName.Variant or EnumName.Variant(payload) construction.
    // Mirrors Go genExpr for *parser.EnumVariantExpr: unit variants reference
    // the #define'd int-tag constant; payload variants call the generated
    // Enum_make_Variant(payload) constructor.
    if (nt == "EnumVariantExpr") {
        let en = enumVariantExprEnumName(node)
        let varName = enumVariantExprVariant(node)
        let val = enumVariantExprValue(node)
        if (val != []) {
            emit(state, en + "_make_" + varName + "(")
            emitC11Expr(state, val)
            emit(state, ")")
        } else {
            emit(state, en + "_" + varName)
        }
    }

    if (nt == "Index") {
        emit(state, "karkain_checked_get(")
        emitC11Expr(state, indexLeft(node))
        emit(state, ", ")
        emitC11Expr(state, indexExpr(node))
        emit(state, ", \"" + codegenSourceName(state) + "\", " + indexLine(node) + ")")
    }

    // Phase 121: alloc(T, n) builds a managed array of n zero slots; free(x)
    // is a runtime-managed no-op cast. Mirrors the Go backend exactly.
    if (nt == "Alloc") {
        emit(state, "make_alloc_array(")
        emitC11Expr(state, allocCount(node))
        emit(state, ")")
    }
    if (nt == "Free") {
        emit(state, "(void)(")
        emitC11Expr(state, freePtr(node))
        emit(state, ")")
    }

    if (nt == "Slice") {
        emit(state, "karkain_slice(")
        emitC11Expr(state, sliceLeft(node))
        emit(state, ", ")
        emitC11Expr(state, sliceStart(node))
        emit(state, ", ")
        emitC11Expr(state, sliceEnd(node))
        emit(state, ")")
    }

    if (nt == "ArrayLiteral") {
        let elems = arrayElements(node)
        emit(state, "_karkain_array(" + str(len(elems)))
        let i = 0
        while (i < len(elems)) {
            emit(state, ", ")
            emitC11Expr(state, elems[i])
            i = i + 1
        }
        emit(state, ")")
    }

    if (nt == "MapLiteral") {
        emit(state, "({ Value _m = make_map(); ")
        let ks = mapKeys(node)
        let vs = mapValues(node)
        let i = 0
        while (i < len(ks)) {
            emit(state, "map_set(&_m, ")
            emitC11Expr(state, ks[i])
            emit(state, ", ")
            emitC11Expr(state, vs[i])
            emit(state, "); ")
            i = i + 1
        }
        emit(state, "_m; })")
    }

    if (nt == "StructLiteral") {
        emit(state, "({ Value _s = make_map(); ")
        let fs = structLitFields(node)
        let i = 0
        while (i < len(fs)) {
            let f = fs[i]
            if (getNodeType(f) == "BinaryExpr") {
                let fl = binaryLeft(f)
                if (getNodeType(fl) == "Ident") {
                    emit(state, "map_set(&_s, make_string(\"" + identName(fl) + "\"), ")
                    emitC11Expr(state, binaryRight(f))
                    emit(state, "); ")
                }
            }
            i = i + 1
        }
        emit(state, "_s; })")
    }
}

func emitMatchArmBody(state, body) {
    let bt = getNodeType(body)
    if (bt == "Block") {
        let stmts = blockStmts(body)
        let i = 0
        let bn = len(stmts)
        while (i < bn) {
            emitC11Stmt(state, stmts[i])
            if (i == bn - 1 && getNodeType(stmts[i]) == "ExprStmt") {
                emit(state, "_match_result = ")
                emitC11Expr(state, exprStmtExpr(stmts[i]))
                emit(state, "; ")
            }
            i = i + 1
        }
    } else if (bt == "Print") {
        emit(state, "print_value(")
        emitC11Expr(state, printVal(body))
        emit(state, "); printf(\"\\n\"); ")
    } else if (bt == "ExprStmt") {
        emit(state, "_match_result = ")
        emitC11Expr(state, exprStmtExpr(body))
        emit(state, "; ")
    } else {
        emit(state, "_match_result = ")
        emitC11Expr(state, body)
        emit(state, "; ")
    }
}

func emitC11Stmt(state, node) {
    let nt = getNodeType(node)

    if (nt == "VarDecl") {
        if (getNodeType(varDeclValue(node)) == "FuncDecl") { emitClosureBinding(state, varDeclValue(node)); return }
        emitLine(state, "Value " + varDeclName(node) + " = ")
        emitC11Expr(state, varDeclValue(node))
        emit(state, ";")
    }

    if (nt == "LetDecl") {
        // Phase 121: let x = fn(...) — the definition was emitted top-level by
        // the closure pass; the binding site only initializes the capture env.
        if (getNodeType(letDeclValue(node)) == "FuncDecl") { emitClosureBinding(state, letDeclValue(node)); return }
        emitLine(state, "Value " + letDeclName(node) + " = ")
        emitC11Expr(state, letDeclValue(node))
        emit(state, ";")
    }

    if (nt == "ConstDecl") {
        if (getNodeType(constDeclValue(node)) == "FuncDecl") { emitClosureBinding(state, constDeclValue(node)); return }
        emitLine(state, "Value " + constDeclName(node) + " = ")
        emitC11Expr(state, constDeclValue(node))
        emit(state, ";")
    }

    if (nt == "Return") {
        if (codegenCurrentFunc(state) == "main") {
            emitLine(state, "karkain_frame_leave();")
            emitLine(state, "return 0;")
        } else {
            // Phase 101: evaluate the return value first so a raise inside the
            // expression still sees this frame on the stack, then pop and return.
            emit(state, "{ Value _karkain_fret = ")
            let rv = returnExpr(node)
            if (len(rv) == 0) { emit(state, "mk_nil()") } else { emitC11Expr(state, rv) }
            emitLine(state, "; karkain_frame_leave(); return _karkain_fret; }")
        }
    }

    if (nt == "Print") {
        emit(state, "print_value(")
        emitC11Expr(state, printExpr(node))
        emitLine(state, "); printf(\"\\n\");")
    }

    if (nt == "ExprStmt") {
        emit(state, "")
        emitC11Expr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }

    if (nt == "Break") {
        emitLine(state, "break;")
    }

    if (nt == "Continue") {
        emitLine(state, "continue;")
    }

    if (nt == "ForIn") {
        emit(state, "{ Value _iter = ")
        emitC11Expr(state, forInIter(node))
        emit(state, "; int _len = (_iter.type == TYPE_ARRAY) ? _iter.length : 0; ")
        emit(state, "for (int _i = 0; _i < _len; _i++) { ")
        emit(state, "Value " + forInVar(node) + " = *_iter.items[_i];")
        let fib = forInBody(node)
        let fi = 0
        while (fi < len(fib)) {
            emitC11Stmt(state, fib[fi])
            fi = fi + 1
        }
        emitLine(state, "} }")
    }

    if (nt == "BinaryExpr") {
        emitC11Expr(state, node)
    }

    if (nt == "If") {
        emit(state, "if (is_truthy(")
        emitC11Expr(state, ifCondition(node))
        emit(state, ")) {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitC11Stmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        let elseB = ifElse(node)
        if (len(elseB) > 0) {
            emitLine(state, "} else {")
            state[2] = codegenIndent(state) + 1
            i = 0
            while (i < len(elseB)) {
                emitC11Stmt(state, elseB[i])
                i = i + 1
            }
            state[2] = codegenIndent(state) - 1
        }
        emitLine(state, "}")
    }

    if (nt == "While") {
        emit(state, "while (is_truthy(")
        emitC11Expr(state, whileCondition(node))
        emit(state, ")) {")
        state[2] = codegenIndent(state) + 1
        let body = whileBody(node)
        let i = 0
        while (i < len(body)) {
            emitC11Stmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "For") {
        emit(state, "for (")
        let iNode = forInit(node)
        if (iNode != []) {
            emitC11Stmt(state, iNode)
        } else {
            emit(state, "; ")
        }
        emit(state, "is_truthy(")
        emitC11Expr(state, forCondition(node))
        emit(state, "); ")
        emitC11Expr(state, forPost(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = forBody(node)
        let i = 0
        while (i < len(body)) {
            emitC11Stmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "Barrier") {
        emitLine(state, "__syncthreads();")
    }

    if (nt == "FuncDecl") {
        let fnName = funcName(node)
        let params = funcParams(node)
        let trapTarget = funcTarget(node)
        state[8] = fnName
        if (trapTarget != "") {
            emitLine(state, "// @target(" + trapTarget + ")")
        }
        if (fnName == "main") {
            emitLine(state, "int main(int _karkain_argc, char** _karkain_argv) {")
            state[2] = codegenIndent(state) + 1
            emitLine(state, "_karkain_gargc = _karkain_argc; _karkain_gargv = _karkain_argv;")
        } else {
            let rtype = emitC11Type(funcReturnType(node))
            emit(state, rtype + " " + emitC11FuncSymbol(fnName) + "(")
            let i = 0
            while (i < len(params)) {
                if (i > 0) { emit(state, ", ") }
                emit(state, "Value " + params[i])
                i = i + 1
            }
            emitLine(state, ") {")
            state[2] = codegenIndent(state) + 1
        }
        emitLine(state, "karkain_frame_enter(\"" + fnName + "\", \"" + codegenSourceName(state) + "\");")
        emitLine(state, "karkain_set_line(" + funcLine(node) + ");")
        let body = funcBody(node)
        let i = 0
        while (i < len(body)) {
            emitC11Stmt(state, body[i])
            i = i + 1
        }
        emitLine(state, "karkain_frame_leave();")
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
        state[8] = ""
    }

    if (nt == "KernelDecl") {
        emit(state, "__kernel void " + kernelName(node) + "(")
        let params = kernelParams(node)
        let i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, emitC11Type("") + " " + params[i])
            i = i + 1
        }
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = kernelBody(node)
        i = 0
        while (i < len(body)) {
            emitC11Stmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "EnumDecl") {
        // Phase 123: enum declarations are emitted in the generateC11 pre-pass
        // (C int-tag constants / payload constructors); nothing to emit here.
        emitLine(state, "// enum " + enumDeclName(node) + " { ")
        emitNewline(state)
    }

    if (nt == "StructDecl") {
        emitLine(state, "// struct " + structName(node) + " { ")
        emitNewline(state)
    }
}

// Deterministic C symbol for user-defined Karkain functions (Phase 83).
// User code lives under the karkain_user_* namespace so user functions can
// never collide with the karkain_* runtime helpers; `main`/`getArgs` keep their
// canonical names. Mirrors the Go backend's userFuncC exactly so the
// self-hosted compiler and the reference backend emit byte-identical output.
func emitC11FuncSymbol(fnName) {
    if (fnName == "main") {
        return fnName
    }
    if (fnName == "getArgs") {
        return fnName
    }
    return "karkain_user_" + fnName
}

// Phase 83: register a user function name for builtin shadowing. The registry
// is fully populated by the forward-declaration pass (which runs before any
// function body is emitted), so call emission can resolve user-vs-builtin.
func registerUserFunc(state, fnName) {
    if (fnName != "main") {
        if (fnName != "getArgs") {
            state[6] = appendArray(state[6], fnName)
        }
    }
}

func hasUserFunc(state, fname) {
    let funcs = codegenFunctions(state)
    let i = 0
    while (i < len(funcs)) {
        if (funcs[i] == fname) {
            return 1
        }
        i = i + 1
    }
    return 0
}

// ============================================================
// Phase 121: let-bound lambda (closure) registry. State slots 10-13:
//   10: local-func names, 11: parallel capture lists, 12: parallel
//   FuncDecl nodes, 13: currently-emitting closure's capture list.
// ============================================================

func codegenLocalFuncs(state)    { return state[10] }
func codegenLocalFuncNodes(state) { return state[12] }
func codegenCurrentCaps(state)   { return state[13] }
func setCodegenCurrentCaps(state, caps) { state[13] = caps }

func codegenLocalFuncCapsFor(state, name) {
    let names = codegenLocalFuncs(state)
    let caps = state[11]
    let i = 0
    while (i < len(names)) {
        if (names[i] == name) { return caps[i] }
        i = i + 1
    }
    return []
}

func codegenLocalFuncHas(state, name) {
    let names = codegenLocalFuncs(state)
    let i = 0
    while (i < len(names)) {
        if (names[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

func registerLocalFunc(state, name, caps, node) {
    if (codegenLocalFuncHas(state, name) == 1) { return }
    state[10] = appendArray(codegenLocalFuncs(state), name)
    state[11] = appendArray(state[11], caps)
    state[12] = appendArray(codegenLocalFuncNodes(state), node)
}

func capInList(caps, name) {
    let i = 0
    while (i < len(caps)) {
        if (caps[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

// collectLocalFuncsC11 walks statements (recursively through blocks and
// function bodies) registering every let-bound lambda FuncDecl value.
func collectLocalFuncsC11(state, stmts) {
    let i = 0
    while (i < len(stmts)) {
        let nt = getNodeType(stmts[i])
        if (nt == "VarDecl" || nt == "LetDecl" || nt == "ConstDecl") {
            let val = varDeclValue(stmts[i])
            if (nt == "LetDecl") { val = letDeclValue(stmts[i]) }
            if (nt == "ConstDecl") { val = constDeclValue(stmts[i]) }
            if (getNodeType(val) == "FuncDecl") {
                registerLocalFunc(state, funcName(val), funcCaptures(val), val)
                collectLocalFuncsC11(state, funcBody(val))
            }
        } else if (nt == "FuncDecl") {
            collectLocalFuncsC11(state, funcBody(stmts[i]))
        } else if (nt == "Block") {
            collectLocalFuncsC11(state, blockStmts(stmts[i]))
        }
        i = i + 1
    }
}

func generateC11(ast, sourceName) {
    let state = createCodegenState("c11")
    setCodegenSourceName(state, sourceName)
    emitC11Preamble(state)
    emitC11ValueRuntime(state)

    // Phase 123: generate enum declarations (C int-tag constants / payload
    // constructors) before functions, mirroring the Go emitters
    // genEnumDecl / generator.enumDecls first pass.
    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        if (getNodeType(stmts[i]) == "EnumDecl") {
            registerEnumDecl(state, stmts[i])
            emitC11EnumDecl(state, stmts[i])
        }
        i = i + 1
    }
    emitNewline(state)
    i = 0
    while (i < len(stmts)) {
        if (getNodeType(stmts[i]) == "FuncDecl") {
            emitC11ForwardDecl(state, stmts[i])
            // Phase 121: register + declare let-bound lambdas so closures are
            // usable from any top-level function regardless of definition order.
            emitLocalFuncDecls(state, funcBody(stmts[i]))
        }
        i = i + 1
    }
    emitNewline(state)

    // Phase 121: emit every let-bound lambda as a top-level C function. Their
    // definitions must NOT nest inside the enclosing function's body.
    emitClosureDefs(state)

    i = 0
    while (i < len(stmts)) {
        emitC11Stmt(state, stmts[i])
        i = i + 1
    }

    return codegenOutput(state)
}

// Phase 123: emit a Karkain enum declaration as C int-tag constants and
// payload constructors, mirroring the Go emitter genEnumDecl (codegen.go).
// Unit variants become `#define Enum_Variant make_int(i+1)`; payload variants
// become `Value Enum_make_Variant(Value payload) { (void)payload; return
// make_int(i+1); }`. Variant raw entries are "Name:" (unit) or "Name:payload".
func emitC11EnumDecl(state, node) {
    let vars = enumDeclVariants(node)
    let en = enumDeclName(node)
    let v = 0
    while (v < len(vars)) {
        // split "Name" / "Name:payload" at the first ':'
        let entry = vars[v]
        let plen = len(entry)
        let colon = -1
        let ci = 0
        while (ci < plen) {
            if (substr(entry, ci, 1) == ":") { colon = ci }
            ci = ci + 1
        }
        let vname = entry
        let hasPayload = 0
        if (colon >= 0) {
            vname = substr(entry, 0, colon)
            let payloadTxt = substr(entry, colon + 1, plen - colon - 1)
            if (payloadTxt != "") { hasPayload = 1 }
        }
        let tag = str(v + 1)
        if (hasPayload == 1) {
            emitLine(state, "Value " + en + "_make_" + vname + "(Value payload) {")
            emitLine(state, "  (void)payload;")
            emitLine(state, "  return make_int(" + tag + ");")
            emitLine(state, "}")
        } else {
            emitLine(state, "#define " + en + "_" + vname + " make_int(" + tag + ")")
        }
        v = v + 1
    }
    emitNewline(state)
}

// Phase 121: for every let-bound lambda discovered in the given statements,
// emit the closure-env typedef + holder and the forward prototype exactly once.
func emitLocalFuncDecls(state, stmts) {
    collectLocalFuncsC11(state, stmts)
    let names = codegenLocalFuncs(state)
    let nodes = codegenLocalFuncNodes(state)
    let i = 0
    while (i < len(names)) {
        let nm = names[i]
        if (hasEmittedClosureEnv(state, nm) == 0) {
            markEmittedClosureEnv(state, nm)
            let caps = funcCaptures(nodes[i])
            if (len(caps) > 0) {
                emitLine(state, "typedef struct {")
                let c = 0
                while (c < len(caps)) {
                    emitLine(state, "  Value* " + caps[c] + ";")
                    c = c + 1
                }
                emitLine(state, "} ClosureEnv_" + nm + ";")
                emitLine(state, "static ClosureEnv_" + nm + "* _genv_" + nm + ";")
                emitNewline(state)
            }
            // Forward prototype (env param first when captures exist).
            let params = funcParams(nodes[i])
            emit(state, "Value " + emitC11FuncSymbol(nm) + "(")
            let pfirst = 1
            if (len(caps) > 0) {
                emit(state, "ClosureEnv_" + nm + "* _env")
                pfirst = 0
            }
            let p = 0
            while (p < len(params)) {
                if (pfirst == 0) { emit(state, ", ") }
                emit(state, "Value " + params[p])
                pfirst = 0
                p = p + 1
            }
            emitLine(state, ");")
        }
        i = i + 1
    }
}

// Phase 121: emit every registered let-bound lambda's top-level C body.
func emitClosureDefs(state) {
    let names = codegenLocalFuncs(state)
    let nodes = codegenLocalFuncNodes(state)
    let i = 0
    while (i < len(names)) {
        emitC11ClosureDef(state, nodes[i])
        i = i + 1
    }
}

func emitC11ClosureDef(state, node) {
    let fnName = funcName(node)
    let params = funcParams(node)
    let caps = funcCaptures(node)
    let savedCaps = codegenCurrentCaps(state)
    setCodegenCurrentCaps(state, caps)
    state[8] = fnName
    emit(state, "Value " + emitC11FuncSymbol(fnName) + "(")
    let pfirst = 1
    if (len(caps) > 0) {
        emit(state, "ClosureEnv_" + fnName + "* _env")
        pfirst = 0
    }
    let i = 0
    while (i < len(params)) {
        if (pfirst == 0) { emit(state, ", ") }
        emit(state, "Value " + params[i])
        pfirst = 0
        i = i + 1
    }
    emitLine(state, ") {")
    state[2] = codegenIndent(state) + 1
    emitLine(state, "karkain_frame_enter(\"" + fnName + "\", \"" + codegenSourceName(state) + "\");")
    emitLine(state, "karkain_set_line(" + funcLine(node) + ");")
    let body = funcBody(node)
    i = 0
    while (i < len(body)) {
        emitC11Stmt(state, body[i])
        i = i + 1
    }
    emitLine(state, "karkain_frame_leave();")
    state[2] = codegenIndent(state) - 1
    emitLine(state, "}")
    emitNewline(state)
    state[8] = ""
    setCodegenCurrentCaps(state, savedCaps)
}

// Phase 121: track which closure env typedefs have been emitted.
func hasEmittedClosureEnv(state, name) {
    let envs = state[14]
    let i = 0
    while (i < len(envs)) {
        if (envs[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

func markEmittedClosureEnv(state, name) {
    state[14] = appendArray(state[14], name)
}

// Phase 121: binding-site env instance init `{ static ClosureEnv_x _e; ...caps;
// _genv_x = &_e; }`. When the lambda captures nothing there is no env at all.
func emitClosureBinding(state, node) {
    let fnName = funcName(node)
    let caps = funcCaptures(node)
    if (len(caps) == 0) { return }
emitLine(state, "{ static ClosureEnv_" + fnName + " _e;")
    let i = 0
    while (i < len(caps)) {
        let c = caps[i]
        if (capInList(codegenCurrentCaps(state), c) == 1) {
            emitLine(state, "_e." + c + " = &(*_env->" + c + ");")
        } else {
            emitLine(state, "_e." + c + " = &" + c + ";")
        }
        i = i + 1
    }
    emitLine(state, "_genv_" + fnName + " = &_e;")
    emitLine(state, "}")
}

// Forward declaration so functions can call each other regardless of
// definition order (mirrors the Go backend's Phase 40 pass).
func emitC11ForwardDecl(state, node) {
    let fnName = funcName(node)
    registerUserFunc(state, fnName)
    if (fnName == "main") {
        emitLine(state, "int main(int _karkain_argc, char** _karkain_argv);")
        return
    }
    let rtype = emitC11Type(funcReturnType(node))
    emit(state, rtype + " " + emitC11FuncSymbol(fnName) + "(")
    let params = funcParams(node)
    let i = 0
    while (i < len(params)) {
        if (i > 0) { emit(state, ", ") }
        emit(state, "Value " + params[i])
        i = i + 1
    }
    emitLine(state, ");")
}

// ============================================================
// WGSL Code Generation (WebGPU)
// ============================================================

func emitWGSLEpreamble(state) {
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 (Stable Build) - WGSL")
    emitNewline(state)
}

func emitWGSLType(varType) {
    if (varType == "int") { return "i32" }
    if (varType == "float64") { return "f32" }
    if (varType == "float32") { return "f32" }
    if (varType == "bool") { return "bool" }
    if (varType == "string") { return "string" }
    return varType
}

func emitWGSLExpr(state, node) {
    let nt = getNodeType(node)

    if (nt == "IntLiteral") { emit(state, literalValue(node)) }
    if (nt == "FloatLiteral") { emit(state, literalValue(node)) }
    if (nt == "StringLiteral") { emit(state, "\"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") { emit(state, literalValue(node)) }
    if (nt == "Ident") { emit(state, identName(node)) }

    if (nt == "BinaryExpr") {
        emit(state, "(")
        emitWGSLExpr(state, binaryLeft(node))
        emit(state, " " + binaryOp(node) + " ")
        emitWGSLExpr(state, binaryRight(node))
        emit(state, ")")
    }

    if (nt == "Call") {
        emit(state, callFunc(node) + "(")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            if (i > 0) { emit(state, ", ") }
            emitWGSLExpr(state, args[i])
            i = i + 1
        }
        emit(state, ")")
    }

    if (nt == "GlobalId") {
        let dim = globalIdDim(node)
        emit(state, "global_id.")
        if (dim == "0" || dim == 0) { emit(state, "x") }
        if (dim == "1" || dim == 1) { emit(state, "y") }
        if (dim == "2" || dim == 2) { emit(state, "z") }
    }

    if (nt == "Member") {
        emitWGSLExpr(state, memberObject(node))
        emit(state, "." + memberField(node))
    }

    if (nt == "Index") {
        emitWGSLExpr(state, indexLeft(node))
        emit(state, "[")
        emitWGSLExpr(state, indexExpr(node))
        emit(state, "]")
    }

    if (nt == "ArrayLiteral") {
        emit(state, "array(")
        let elems = arrayElements(node)
        let i = 0
        while (i < len(elems)) {
            if (i > 0) { emit(state, ", ") }
            emitWGSLExpr(state, elems[i])
            i = i + 1
        }
        emit(state, ")")
    }
}

func emitWGSLStmt(state, node) {
    let nt = getNodeType(node)

    if (nt == "VarDecl") {
        let vtype = emitWGSLType(varDeclType(node))
        emit(state, "var " + varDeclName(node) + " : " + vtype + " = ")
        emitWGSLExpr(state, varDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "LetDecl") {
        emit(state, "let " + letDeclName(node) + " = ")
        emitWGSLExpr(state, letDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "ConstDecl") {
        emit(state, "let " + constDeclName(node) + " = ")
        emitWGSLExpr(state, constDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "Return") {
        emit(state, "return ")
        let rv0 = returnExpr(node)
        if (len(rv0) == 0) { emit(state, "mk_nil()") } else { emitWGSLExpr(state, rv0) }
        emitLine(state, ";")
    }

    if (nt == "Print") {
        emitLine(state, "// print() - not supported in WGSL")
    }

    if (nt == "ExprStmt") {
        emit(state, "")
        emitWGSLExpr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }

    if (nt == "If") {
        emit(state, "if (")
        emitWGSLExpr(state, ifCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitWGSLStmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "Barrier") {
        emitLine(state, "storageBarrier();")
    }

    if (nt == "KernelDecl") {
        emit(state, "@compute @workgroup_size(")
        let wg = kernelWorkgroup(node)
        let i = 0
        while (i < len(wg)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, wg[i])
            i = i + 1
        }
        emitLine(state, ")")
        emit(state, "fn " + kernelName(node) + "(")
        let params = kernelParams(node)
        i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, params[i] + ": " + emitWGSLType("int"))
            i = i + 1
        }
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = kernelBody(node)
        i = 0
        while (i < len(body)) {
            emitWGSLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "FuncDecl") {
        emit(state, "fn " + funcName(node) + "(")
        let params = funcParams(node)
        let i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, params[i] + ": " + emitWGSLType("int"))
            i = i + 1
        }
        emit(state, ") -> " + emitWGSLType(funcReturnType(node)))
        emitLine(state, " {")
        state[2] = codegenIndent(state) + 1
        let body = funcBody(node)
        i = 0
        while (i < len(body)) {
            emitWGSLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "StructDecl") {
        emitLine(state, "struct " + structName(node) + " {")
        state[2] = codegenIndent(state) + 1
        let fields = structFields(node)
        let i = 0
        while (i < len(fields)) {
            emitLine(state, fields[i][1] + ": " + emitWGSLType(fields[i][0]) + ",")
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "While") {
        emit(state, "loop {")
        state[2] = codegenIndent(state) + 1
        emit(state, "if (!")
        emitWGSLExpr(state, whileCondition(node))
        emitLine(state, ") { break; }")
        let body = whileBody(node)
        let i = 0
        while (i < len(body)) {
            emitWGSLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "For") {
        emitLine(state, "{")
        state[2] = codegenIndent(state) + 1
        emitWGSLStmt(state, forInit(node))
        emit(state, "loop {")
        state[2] = codegenIndent(state) + 1
        emit(state, "if (!")
        emitWGSLExpr(state, forCondition(node))
        emitLine(state, ") { break; }")
        let body = forBody(node)
        let i = 0
        while (i < len(body)) {
            emitWGSLStmt(state, body[i])
            i = i + 1
        }
        emit(state, "")
        emitWGSLExpr(state, forPost(node))
        emitLine(state, ";")
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }
}

func generateWGSL(ast) {
    let state = createCodegenState("wgsl")
    emitWGSLEpreamble(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        emitWGSLStmt(state, stmts[i])
        i = i + 1
    }

    return codegenOutput(state)
}

// ============================================================
// OpenCL Code Generation
// ============================================================

func emitOpenCLPreamble(state) {
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 (Stable Build) - OpenCL")
    emitLine(state, "#pragma OPENCL EXTENSION cl_khr_byte_addressable_store : enable")
    emitNewline(state)
}

func emitOpenCLType(varType) {
    if (varType == "int") { return "int" }
    if (varType == "float64") { return "double" }
    if (varType == "float32") { return "float" }
    if (varType == "bool") { return "int" }
    if (varType == "string") { return "char*" }
    return varType
}

func emitOpenCLExpr(state, node) {
    let nt = getNodeType(node)

    if (nt == "IntLiteral") { emit(state, literalValue(node)) }
    if (nt == "FloatLiteral") { emit(state, literalValue(node)) }
    if (nt == "StringLiteral") { emit(state, "\"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") {
        if (literalValue(node) == "true") { emit(state, "1") }
        if (literalValue(node) == "false") { emit(state, "0") }
    }
    if (nt == "Ident") { emit(state, identName(node)) }

    if (nt == "BinaryExpr") {
        emit(state, "(")
        emitOpenCLExpr(state, binaryLeft(node))
        emit(state, " " + binaryOp(node) + " ")
        emitOpenCLExpr(state, binaryRight(node))
        emit(state, ")")
    }

    if (nt == "Call") {
        emit(state, callFunc(node) + "(")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            if (i > 0) { emit(state, ", ") }
            emitOpenCLExpr(state, args[i])
            i = i + 1
        }
        emit(state, ")")
    }

    if (nt == "GlobalId") {
        let dim = globalIdDim(node)
        emit(state, "get_global_id(")
        emitOpenCLExpr(state, dim)
        emit(state, ")")
    }

    if (nt == "Member") {
        emitOpenCLExpr(state, memberObject(node))
        emit(state, "->" + memberField(node))
    }

    if (nt == "Index") {
        emitOpenCLExpr(state, indexLeft(node))
        emit(state, "[")
        emitOpenCLExpr(state, indexExpr(node))
        emit(state, "]")
    }
}

func emitOpenCLStmt(state, node) {
    let nt = getNodeType(node)

    if (nt == "VarDecl") {
        let vtype = emitOpenCLType(varDeclType(node))
        emit(state, vtype + " " + varDeclName(node) + " = ")
        emitOpenCLExpr(state, varDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "LetDecl") {
        emit(state, emitOpenCLType("int") + " " + letDeclName(node) + " = ")
        emitOpenCLExpr(state, letDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "ConstDecl") {
        emit(state, emitOpenCLType("int") + " " + constDeclName(node) + " = ")
        emitOpenCLExpr(state, constDeclValue(node))
        emitLine(state, ";")
    }

    if (nt == "Return") {
        emit(state, "return ")
        let rv1 = returnExpr(node)
        if (len(rv1) == 0) { emit(state, "mk_nil()") } else { emitOpenCLExpr(state, rv1) }
        emitLine(state, ";")
    }

    if (nt == "Print") {
        emit(state, "printf(\"%d\\n\", ")
        emitOpenCLExpr(state, printExpr(node))
        emitLine(state, ");")
    }

    if (nt == "ExprStmt") {
        emitOpenCLExpr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }

    if (nt == "If") {
        emit(state, "if (")
        emitOpenCLExpr(state, ifCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitOpenCLStmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        let elseB = ifElse(node)
        if (len(elseB) > 0) {
            emitLine(state, "} else {")
            state[2] = codegenIndent(state) + 1
            i = 0
            while (i < len(elseB)) {
                emitOpenCLStmt(state, elseB[i])
                i = i + 1
            }
            state[2] = codegenIndent(state) - 1
        }
        emitLine(state, "}")
    }

    if (nt == "Barrier") {
        emitLine(state, "barrier(CLK_GLOBAL_MEM_FENCE);")
    }

    if (nt == "KernelDecl") {
        emit(state, "__kernel void " + kernelName(node) + "(")
        let params = kernelParams(node)
        let i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, "__global " + emitOpenCLType("int") + "* " + params[i])
            i = i + 1
        }
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = kernelBody(node)
        i = 0
        while (i < len(body)) {
            emitOpenCLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "FuncDecl") {
        let rtype = emitOpenCLType(funcReturnType(node))
        emit(state, rtype + " " + funcName(node) + "(")
        let params = funcParams(node)
        let i = 0
        while (i < len(params)) {
            if (i > 0) { emit(state, ", ") }
            emit(state, emitOpenCLType("int") + " " + params[i])
            i = i + 1
        }
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = funcBody(node)
        i = 0
        while (i < len(body)) {
            emitOpenCLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
        emitNewline(state)
    }

    if (nt == "StructDecl") {
        emitLine(state, "typedef struct " + structName(node) + " {")
        state[2] = codegenIndent(state) + 1
        let fields = structFields(node)
        let i = 0
        while (i < len(fields)) {
            emitLine(state, emitOpenCLType(fields[i][0]) + " " + fields[i][1] + ";")
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "} " + structName(node) + ";")
        emitNewline(state)
    }

    if (nt == "While") {
        emit(state, "while (")
        emitOpenCLExpr(state, whileCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = whileBody(node)
        let i = 0
        while (i < len(body)) {
            emitOpenCLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }

    if (nt == "For") {
        emit(state, "for (")
        emitOpenCLStmt(state, forInit(node))
        emitOpenCLExpr(state, forCondition(node))
        emit(state, "; ")
        emitOpenCLExpr(state, forPost(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let body = forBody(node)
        let i = 0
        while (i < len(body)) {
            emitOpenCLStmt(state, body[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }
}

func generateOpenCL(ast) {
    let state = createCodegenState("opencl")
    emitOpenCLPreamble(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        emitOpenCLStmt(state, stmts[i])
        i = i + 1
    }

    return codegenOutput(state)
}

// ============================================================
// SPIR-V Placeholder (requires external tools)
// ============================================================

func generateSPIRV(ast) {
    return "// SPIR-V generation requires external spirv-tools\n// Use: karkain build --target spirv input.kark\n"
}

// ============================================================
// OpenQASM 3.0 Code Generation (Quantum)
// ============================================================

func emitOpenQASMExpr(state, node) {
    let nt = getNodeType(node)
    if (nt == "IntLiteral") { emit(state, literalValue(node)) }
    if (nt == "FloatLiteral") { emit(state, literalValue(node)) }
    if (nt == "StringLiteral") { emit(state, "\"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") {
        if (literalValue(node) == "true") { emit(state, "true") }
        if (literalValue(node) == "false") { emit(state, "false") }
    }
    if (nt == "Ident") { emit(state, identName(node)) }
    if (nt == "BinaryExpr") {
        emit(state, "(")
        emitOpenQASMExpr(state, binaryLeft(node))
        emit(state, " " + binaryOp(node) + " ")
        emitOpenQASMExpr(state, binaryRight(node))
        emit(state, ")")
    }
    if (nt == "Call") {
        emit(state, callFunc(node) + "(")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            if (i > 0) { emit(state, ", ") }
            emitOpenQASMExpr(state, args[i])
            i = i + 1
        }
        emit(state, ")")
    }
    if (nt == "Index") {
        emitOpenQASMExpr(state, indexLeft(node))
        emit(state, "[")
        emitOpenQASMExpr(state, indexExpr(node))
        emit(state, "]")
    }
    if (nt == "Member") {
        emitOpenQASMExpr(state, memberObject(node))
        emit(state, "." + memberField(node))
    }
}

func emitOpenQASMStmt(state, node) {
    let nt = getNodeType(node)
    if (nt == "ExprStmt") {
        emitOpenQASMExpr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }
    if (nt == "If") {
        emit(state, "if (")
        emitOpenQASMExpr(state, ifCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitOpenQASMStmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }
    if (nt == "Print") {
        emitLine(state, "// print() - not supported in OpenQASM")
    }
}

func generateOpenQASM(ast) {
    let state = createCodegenState("openqasm")
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 (Stable Build) - OpenQASM 3.0")
    emitLine(state, "OPENQASM 3.0;")
    emitLine(state, "include \"stdgates.inc\";")
    emitNewline(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        let nt = getNodeType(stmts[i])
        if (nt == "KernelDecl") {
            emit(state, "gate " + kernelName(stmts[i]) + "(")
            let params = kernelParams(stmts[i])
            let j = 0
            while (j < len(params)) {
                if (j > 0) { emit(state, ", ") }
                emit(state, params[j])
                j = j + 1
            }
            emitLine(state, ") {")
            state[2] = codegenIndent(state) + 1
            let body = kernelBody(stmts[i])
            j = 0
            while (j < len(body)) {
                emitOpenQASMStmt(state, body[j])
                j = j + 1
            }
            state[2] = codegenIndent(state) - 1
            emitLine(state, "}")
            emitNewline(state)
        }
        i = i + 1
    }

    return codegenOutput(state)
}

// ============================================================
// QIR Code Generation (Quantum Intermediate Representation)
// ============================================================

func emitQIRExpr(state, node) {
    let nt = getNodeType(node)
    if (nt == "IntLiteral") { emit(state, literalValue(node)) }
    if (nt == "FloatLiteral") { emit(state, literalValue(node)) }
    if (nt == "StringLiteral") { emit(state, "\"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") {
        if (literalValue(node) == "true") { emit(state, "true") }
        if (literalValue(node) == "false") { emit(state, "false") }
    }
    if (nt == "Ident") { emit(state, identName(node)) }
    if (nt == "BinaryExpr") {
        emit(state, "(")
        emitQIRExpr(state, binaryLeft(node))
        emit(state, " " + binaryOp(node) + " ")
        emitQIRExpr(state, binaryRight(node))
        emit(state, ")")
    }
    if (nt == "Call") {
        emit(state, "@__quantum__qis__" + callFunc(node) + "__body(")
        let args = callArgs(node)
        let i = 0
        while (i < len(args)) {
            if (i > 0) { emit(state, ", ") }
            emitQIRExpr(state, args[i])
            i = i + 1
        }
        emit(state, ")")
    }
    if (nt == "Member") {
        emitQIRExpr(state, memberObject(node))
        emit(state, "." + memberField(node))
    }
    if (nt == "Index") {
        emitQIRExpr(state, indexLeft(node))
        emit(state, "[")
        emitQIRExpr(state, indexExpr(node))
        emit(state, "]")
    }
}

func emitQIRStmt(state, node) {
    let nt = getNodeType(node)
    if (nt == "ExprStmt") {
        emitQIRExpr(state, exprStmtExpr(node))
        emitLine(state, ";")
    }
    if (nt == "If") {
        emit(state, "if (")
        emitQIRExpr(state, ifCondition(node))
        emitLine(state, ") {")
        state[2] = codegenIndent(state) + 1
        let thenB = ifThen(node)
        let i = 0
        while (i < len(thenB)) {
            emitQIRStmt(state, thenB[i])
            i = i + 1
        }
        state[2] = codegenIndent(state) - 1
        emitLine(state, "}")
    }
    if (nt == "Print") {
        emitLine(state, "// print() - not supported in QIR")
    }
}

func generateQIR(ast) {
    let state = createCodegenState("qir")
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 (Stable Build) - QIR")
    emitLine(state, "define void @main() {")
    state[2] = codegenIndent(state) + 1

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        emitQIRStmt(state, stmts[i])
        i = i + 1
    }

    state[2] = codegenIndent(state) - 1
    emitLine(state, "}")
    return codegenOutput(state)
}

// ============================================================
// KBC Bytecode Emission (.kbc binary format)
// ============================================================

// KBC opcode constants
func KBC_OP_LOAD_INT() { return 1 }
func KBC_OP_LOAD_STR() { return 2 }
func KBC_OP_LOAD_BOOL() { return 3 }
func KBC_OP_ADD() { return 10 }
func KBC_OP_SUB() { return 11 }
func KBC_OP_MUL() { return 12 }
func KBC_OP_DIV() { return 13 }
func KBC_OP_EQ() { return 14 }
func KBC_OP_NEQ() { return 15 }
func KBC_OP_LT() { return 16 }
func KBC_OP_GT() { return 17 }
func KBC_OP_PRINT() { return 20 }
func KBC_OP_CALL() { return 30 }
func KBC_OP_RET() { return 31 }
func KBC_OP_JMP() { return 40 }
func KBC_OP_JMP_IF() { return 41 }
func KBC_OP_HALT() { return 99 }

func emitKBCPreamble(state) {
    emitLine(state, "// Generated by Karkain Compiler v1.0.0 (Stable Build) - KBC Bytecode")
    emitLine(state, "// Format: OP [operands...]")
    emitNewline(state)
}

func emitKBCExpr(state, node) {
    let nt = getNodeType(node)
    if (nt == "IntLiteral") { emitLine(state, "LOAD_INT " + literalValue(node)) }
    if (nt == "FloatLiteral") { emitLine(state, "LOAD_FLOAT " + literalValue(node)) }
    if (nt == "StringLiteral") { emitLine(state, "LOAD_STR \"" + literalValue(node) + "\"") }
    if (nt == "BoolLiteral") { emitLine(state, "LOAD_BOOL " + literalValue(node)) }
    if (nt == "Ident") { emitLine(state, "LOAD_VAR " + identName(node)) }
    if (nt == "BinaryExpr") {
        emitKBCExpr(state, binaryLeft(node))
        emitKBCExpr(state, binaryRight(node))
        let op = binaryOp(node)
        if (op == "+") { emitLine(state, "ADD") }
        if (op == "-") { emitLine(state, "SUB") }
        if (op == "*") { emitLine(state, "MUL") }
        if (op == "/") { emitLine(state, "DIV") }
        if (op == "==") { emitLine(state, "EQ") }
        if (op == "!=") { emitLine(state, "NEQ") }
        if (op == "<") { emitLine(state, "LT") }
        if (op == ">") { emitLine(state, "GT") }
    }
    if (nt == "Call") {
        let args = callArgs(node)
        let i = len(args) - 1
        while (i >= 0) {
            emitKBCExpr(state, args[i])
            i = i - 1
        }
        emitLine(state, "CALL " + callFunc(node) + " " + str(len(args)))
    }
}

func emitKBCStmt(state, node) {
    let nt = getNodeType(node)
    if (nt == "LetDecl") {
        emitKBCExpr(state, letDeclValue(node))
        emitLine(state, "STORE_VAR " + letDeclName(node))
    }
    if (nt == "ConstDecl") {
        emitKBCExpr(state, constDeclValue(node))
        emitLine(state, "STORE_VAR " + constDeclName(node))
    }
    if (nt == "VarDecl") {
        emitKBCExpr(state, varDeclValue(node))
        emitLine(state, "STORE_VAR " + varDeclName(node))
    }
    if (nt == "Print") {
        emitKBCExpr(state, printExpr(node))
        emitLine(state, "PRINT")
    }
    if (nt == "Return") {
        let rv2 = returnExpr(node)
        if (len(rv2) > 0) { emitKBCExpr(state, rv2) }
        emitLine(state, "RET")
    }
    if (nt == "ExprStmt") {
        emitKBCExpr(state, exprStmtExpr(node))
    }
    if (nt == "If") {
        emitKBCExpr(state, ifCondition(node))
        emitLine(state, "JMP_IF L")
    }
    if (nt == "FuncDecl") {
        emitLine(state, "FUNC " + funcName(node))
        let body = funcBody(node)
        let i = 0
        while (i < len(body)) {
            emitKBCStmt(state, body[i])
            i = i + 1
        }
        emitLine(state, "RET")
    }
}

func generateKBC(ast) {
    let state = createCodegenState("kbc")
    emitKBCPreamble(state)

    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        emitKBCStmt(state, stmts[i])
        i = i + 1
    }

    emitLine(state, "HALT")
    return codegenOutput(state)
}

// ============================================================
// Forward Declaration Generation
// ============================================================

func generateForwardDecls(ast) {
    let result = ""
    let stmts = programStatements(ast)
    let i = 0
    while (i < len(stmts)) {
        let nt = getNodeType(stmts[i])
        if (nt == "FuncDecl") {
            result = result + "Value* " + funcName(stmts[i]) + "("
            let params = funcParams(stmts[i])
            let j = 0
            while (j < len(params)) {
                if (j > 0) { result = result + ", " }
                result = result + "Value* " + params[j]
                j = j + 1
            }
            result = result + ");\n"
        }
        i = i + 1
    }
    return result + "\n"
}

// ============================================================
// Main generation function
// ============================================================

func generate(ast, target, sourceName) {
    if (target == "c23") { return generateC11(ast, sourceName) }
    if (target == "c11") { return generateC11(ast, sourceName) }
    if (target == "c99") { return generateC11(ast, sourceName) } // legacy alias
    if (target == "wgsl") { return generateWGSL(ast) }
    if (target == "opencl") { return generateOpenCL(ast) }
    if (target == "openqasm") { return generateOpenQASM(ast) }
    if (target == "qir") { return generateQIR(ast) }
    if (target == "kbc") { return generateKBC(ast) }
    if (target == "spirv") { return generateSPIRV(ast) }
    return generateC11(ast, sourceName)
}

// ============================================================
// Native machine-code ENCODER (Phase 151B)
//
// The byte-level encoder the self-hosted engine needs before it can emit
// anything at all. It is the Karkain counterpart of the Go `Emitter` in
// pkg/native/emit.go, and the two must agree BYTE FOR BYTE: the whole
// point of increment 151 is that kcc's images are identical to the Go
// oracle's, and a single differing REX prefix or displacement byte is a
// different image.
//
// THE MECHANISM IS THE HARD PART, NOT THE OPCODES. Three things make the
// Go encoder work, and all three are reproduced here rather than
// improved on:
//
//   1. EAGER label resolution with a rel32 fixup pass at Finish(). The Go
//      emitter records (offset, label) and patches `rel = target -
//      (offset+4)` once every label is known. Resolving earlier, or
//      patching at emission time, changes the bytes.
//   2. Labels must be Marked before they are referenced; a missing one is
//      a hard error, never a silent zero displacement. The Go side
//      panics; the self-hosted side raises error[K117] and refuses, which
//      is the same class of failure expressed in its own language.
//   3. imm64 placeholders. Address sites are emitted as a 10-byte
//      `mov r64, imm64` with the immediate left at zero and the POSITION
//      returned, so a linker can fill in an absolute address it alone
//      knows. The position, not the value, is what this layer owns.
//
// STATE REPRESENTATION. Karkain has no structs, so the emitter state is
// threaded as one array with fixed slots (see natSt* below). Every
// mutating helper returns the new state, which is the same discipline
// kir.kark uses when it threads `lines` through its renderers.
//
// Byte values are carried as ints, not bytes: Karkain has no byte type in
// this surface, and the Go oracle stores them in a []byte. appending an
// int and truncating with & 0xFF at Finish() is the exact equivalent of
// writing into a []byte, and the parity gate compares the finished
// images rather than trusting this conversion.
// ============================================================

// ============================================================
// Opcode / mask constants.
//
// Karkain has NO HEX LITERALS: `0xFF` lexes as the identifier `xFF`, so a
// port of pkg/native/emit.go has to state every bit mask in decimal. Bare
// decimals in an x86 encoder are close to unreadable, so the constants
// live in one selector and the hex each stands for lives in its comment.
// That is the only reason this is a function and not a global: the
// self-hosted language has no module-level `let`.
//
// natMask TAKES AN ARGUMENT, AND THAT IS LOAD-BEARING -- not a style
// choice. A zero-argument call in expression position (`natMask(0)`)
// works on the Go engine and is BROKEN in the kcc C codegen, which drops
// the call and emits a bare identifier reference, so the expression fails
// to compile under the default engine. Measured on 2026-09-28:
//
//   func zero() { return 42 }   let a = zero()    -> go: 42
//                                                    kcc: 'zero' undeclared
//   let d = zero() + 1                            -> go: 43
//                                                    kcc: 'zero' undeclared
//
// One-argument calls are fine on both engines, so every constant here is
// reached as natMask(0) rather than natMask(0). See
// docs/audit/PHASE-151B-BASELINE.md for the recorded defect.
//
// The values are checked against the Go oracle by the Phase 151B gate; if
// one drifts, the gate fails rather than an image.
// ============================================================

// natMask returns an opcode or bit mask by selector. Call it with an
// argument: natMask(0), not natMask().
//
// Every value carries its hex in the comment, and the hex is what to trust.
// The first draft of this table was produced by converting decimal-looking
// strings as if they were hex, which turned 0xFF into 597 (0x255) and 0x0F
// into 21 (0x15) -- and the encoder then emitted garbage. Karkain has no hex
// literals (0xFF lexes as the identifier xFF), so this conversion is done by
// hand and is therefore pinned: the gate asserts every selector against an
// independently computed constant, so a wrong value fails the test rather
// than reaching an image.
func natMask(which) {
    if (which == 0) { return 255 }                      // 0xFF  byte mask
    if (which == 1) { return 15 }                       // 0x0F  low-nibble mask
    if (which == 2) { return 72 }                       // 0x48  REX.W
    if (which == 3) { return 144 }                      // 0x90  nop
    if (which == 4) { return 195 }                      // 0xC3  ret
    if (which == 5) { return 233 }                      // 0xE9  jmp rel32
    if (which == 6) { return 1234605616436508552 }      // 0x1122334455667788
    if (which == 7) { return 15 }                       // 0x0F  two-byte opcode escape
    if (which == 8) { return 133 }                      // 0x85  jnz rel32 opcode
    if (which == 9) { return 1 }                        // 0x01  add r/m64, r64
    if (which == 10) { return 41 }                      // 0x29  sub r/m64, r64
    if (which == 11) { return 184 }                     // 0xB8  mov r64, imm32/64 base
    if (which == 12) { return 192 }                     // 0xC0  ModRM base for mod=11 (used only for reading; natModrm shifts instead)
    if (which == 13) { return 64 }                      // 0x40  REX base
    if (which == 14) { return 8 }                       // 0x08  REX.W bit
    if (which == 15) { return 4 }                       // 0x04  REX.R bit
    if (which == 16) { return 1 }                       // 0x01  REX.B bit
    if (which == 17) { return 232 }                     // 0xE8  call rel32
    // Phase 151A Step 1: the opcodes a frame prologue and a local-slot
    // access need. 151B deliberately shipped a representative subset; these
    // are the ones the value/frame foundation actually emits, and each is the
    // byte-for-byte counterpart of the identically named Go method.
    //
    // These CONTINUE the table at 18. The first draft of this block started
    // at 17 and silently shadowed the existing call-rel32 selector, so
    // natCall32 began emitting 0x89 (mov) in place of 0xE8 (call). The 151B
    // gate caught it; a selector table is a shared namespace and a new entry
    // has to be appended after reading its whole existing range, not after
    // reading the part that happened to be visible.
    if (which == 18) { return 137 }                     // 0x89  mov r/m64, r64 (store to memory)
    if (which == 19) { return 139 }                     // 0x8B  mov r64, r/m64 (load from memory)
    if (which == 20) { return 49 }                      // 0x31  xor r/m64, r64
    if (which == 21) { return 129 }                     // 0x81  group-1 r/m64, imm32
    if (which == 22) { return 131 }                     // 0x83  group-1 r/m64, imm8
    if (which == 23) { return 36 }                      // 0x24  SIB: scale-0, index-none, base-rsp
    if (which == 24) { return 5 }                       // 0x05  group-1 /5 = sub r/m64, imm
    if (which == 25) { return 0 }                       // 0x00  group-1 /0 = add r/m64, imm
    // Phase 151A Step 2: the opcodes integer expression lowering needs. Same
    // discipline as the block above -- continue the table, never renumber.
    if (which == 26) { return 132 }                     // 0x84  jz  rel32 opcode
    if (which == 27) { return 140 }                     // 0x8C  jl  rel32 opcode (signed)
    if (which == 28) { return 141 }                     // 0x8D  jge rel32 opcode (signed)
    if (which == 29) { return 142 }                     // 0x8E  jle rel32 opcode (signed)
    if (which == 30) { return 143 }                     // 0x8F  jg  rel32 opcode (signed)
    if (which == 31) { return 247 }                     // 0xF7  group-3: neg r/m64 is /3
    if (which == 32) { return 57 }                      // 0x39  cmp r/m64, r64
    if (which == 33) { return 175 }                     // 0xAF  imul r64, r/m64
    if (which == 17) { return 232 }                     // 0xE8  call rel32
    // Phase 151A: the Linux exit tail in `_start`. These are the first kcc
    // bytes that are not a frame/local operation -- `syscall` is an
    // operating-system boundary, and it is the byte-for-byte counterpart of
    // the identically named Go Emitter.Syscall. Same discipline as the blocks
    // above: continue the table at 34 rather than renumbering, because
    // natMask is a shared namespace.
    if (which == 34) { return 15 }                      // 0x0F  syscall escape byte
    if (which == 35) { return 5 }                       // 0x05  syscall opcode
    // Phase 151A Step 5: the Windows entry, the PEB bootstrap and the Win64
    // exit tail. These CONTINUE the table at 36 and never renumber -- natMask
    // is a shared namespace, and Step 1 shipped exactly that bug when a block
    // started at 17 and silently shadowed the existing call-rel32 selector.
    if (which == 36) { return 101 }                     // 0x65  GS segment override
    if (which == 37) { return 183 }                     // 0xB7  movzx r32, r/m16
    if (which == 38) { return 204 }                     // 0xCC  int3
    if (which == 39) { return 1 }                       // group-1 /1  or  r/m64, imm
    if (which == 40) { return 4 }                       // group-1 /4  and r/m64, imm
    if (which == 41) { return 7 }                       // group-1 /7  cmp r/m64, imm
    if (which == 42) { return 240 }                     // 0xF0  imm8 of `and rsp, -16`
    if (which == 43) { return 37 }                      // 0x25  SIB scale-0 index-none base-rsp
    if (which == 44) { return 255 }                     // 0xFF  group-5 (call /2, dec /1)
    if (which == 45) { return 133 }                     // 0x85  test r/m64, r64
    if (which == 46) { return 163 }                     // 0xA3  mov moffs64, rax
    if (which == 47) { return 2 }                       // 0x02  REX.X bit (SIB index)
    // Phase 151A Step 7: int `print`. These CONTINUE the table at 48 and never
    // renumber -- natMask is a shared namespace, so a new block that starts
    // inside the existing range silently changes the bytes an unrelated
    // primitive emits. That is not hypothetical: Step 1 started a block at 17
    // and turned natCall32's 0xE8 into a 0x89 mov.
    if (which == 48) { return 153 }                     // 0x99  cqo (sign-extend rax into rdx:rax)
    if (which == 49) { return 136 }                     // 0x88  mov [base], r8 (single-byte store)
    if (which == 50) { return 80 }                      // 0x50  push r64
    if (which == 51) { return 88 }                      // 0x58  pop r64
    if (which == 52) { return 137 }                     // 0x89  jns rel32 opcode
    // Phase 151A Step 8a: SSE2 scalar-double primitives. These CONTINUE the
    // table at 53 and never renumber, for the reason the Step 1 block records.
    //
    // THE PREFIX GOES BEFORE REX, and that ordering is the whole subtlety of
    // these eight. pkg/native/emit.go emits `e.byte(0xF2); e.rex(...)`, not
    // the reverse, and the two produce different bytes for every operand that
    // needs a REX at all. An x86-64 legacy prefix must precede REX; a REX
    // emitted first is not a prefix of the mandatory-prefix instruction, and
    // for xmm8-15 (which is what REX.B selects) the encoding silently changes
    // meaning rather than failing loudly.
    if (which == 53) { return 242 }                     // 0xF2  mandatory prefix (packed / cvt)
    if (which == 54) { return 102 }                     // 0x66  mandatory prefix (ucomisd / xorpd)
    if (which == 55) { return 88 }                      // 0x58  addsd
    if (which == 56) { return 92 }                      // 0x5C  subsd
    if (which == 57) { return 89 }                      // 0x59  mulsd
    if (which == 58) { return 94 }                      // 0x5E  divsd
    if (which == 59) { return 46 }                      // 0x2E  ucomisd
    if (which == 60) { return 42 }                      // 0x2A  cvtsi2sd
    if (which == 61) { return 44 }                      // 0x2C  cvttsd2si
    if (which == 62) { return 87 }                      // 0x57  xorpd
    // Phase 151A Step 8b: print_float. These CONTINUE the table at 63.
    if (which == 63) { return 33 }                      // 0x21  and r/m64, r64
    if (which == 64) { return 193 }                     // 0xC1  shift-by-imm8 group
    if (which == 65) { return 141 }                     // 0x8D  lea
    if (which == 66) { return 182 }                     // 0xB6  movzx r32, r/m8
    if (which == 67) { return 110 }                     // 0x6E  movq xmm, r/m64
    if (which == 68) { return 126 }                     // 0x7E  movq r/m64, xmm
    return 0
}

// natRegExt reports whether a register number needs a REX extension bit.
// Mirrors Reg.ext() in pkg/native/emit.go.
func natRegExt(r) {
    if (r >= 8) { return 1 }
    return 0
}

// natRex emits a REX prefix when needed: W for 64-bit operand size, R for a
// high modrm.reg, B for a high modrm.rm.
//
// It emits NOTHING when the computed prefix equals the null REX 0x40, because
// pkg/native/emit.go's rex() does the same. A redundant 0x40 would still be
// valid x86, but it is a different byte, and this encoder's entire contract is
// to be byte-identical rather than merely equivalent.
func natRex(s, w, reg, rm) {
    let r = natMask(13)
    if (w == 1) { r = r | natMask(14) }
    if (natRegExt(reg) == 1) { r = r | natMask(15) }
    if (natRegExt(rm) == 1) { r = r | natMask(16) }
    if (r != natMask(13)) {
        s = natByte(s, r)
    }
    return s
}

// natModrm emits the ModRM byte: mod(2) | reg(3) | rm(3).
//
// The mode field is SHIFTED IN, not added as a base. The first draft added
// natMask(12) (0xC0, which is mod=3 already shifted) on top of (mod << 6),
// so mod=3 produced 0xC0 + 0xC0 = 392, which truncated to 0x88 -- a memory
// operand where a register operand was meant. The bug was invisible in the
// imm64 and multi sequences because neither uses ModRM, and it was caught by
// decoding the loop's output rather than by any test asserting the value.
//
// Mirrors pkg/native/emit.go's modrm(), which is (mod<<6)|(reg<<3)|rm.
// natModrm emits a ModRM byte.
//
// BOTH register fields are masked to three bits, mirroring the Go side's `.low()`
// at every call site. Phase 151A Step 5 found this the hard way: R8 is register
// 8, so an unmasked `reg << 3` writes 0x40 into the MOD field and silently turns
// a `movzx r8d, [rdx]` (0F B7 02) into `movzx r8d, [rdx+disp8]` (0F B7 42 xx),
// which then consumed the following immediate as a displacement.
//
// Every pre-Step-5 caller passes rax/rcx/rdx/rsp/rdi (0-7), so masking is a
// no-op for them and cannot change an existing byte.
func natModrm(s, mod, reg, rm) {
    return natByte(s, (mod << 6) + ((reg & 7) << 3) + (rm & 7))
}

// natMovRegImm32 emits mov r32, imm32: optional REX + B8+rd io32.
// Modelled on pkg/native/emit.go MovRegImm32, which is what a small integer
// constant uses; natMovImm64 is the 64-bit form.
func natMovRegImm32(s, r, v) {
    s = natRex(s, 0, 0, r)
    s = natByte(s, 184 + (r & 7))
    return natU32(s, v)
}

// natAddRegReg emits add r64, r64: REX.W + 01 /r.
// Phase 151A Step 1 — frame prologue / epilogue and local-slot access.
//
// These are additive only: nothing above them is changed, and each is the
// byte-for-byte counterpart of the identically named Go method in
// pkg/native/emit.go. The 151B subset was deliberately representative, and
// these are the opcodes a frame actually needs before anything can be emitted.

// natMemRsp emits ModRM+SIB+disp for [rsp+off] (rm=100 selects SIB; the SIB
// byte 0x24 is scale-0, index-none, base-rsp). off==0 encodes with NO
// displacement, exactly as the Go memRsp does -- disp8 and disp32 are used
// only when the offset actually needs them, and choosing a wider form
// unconditionally would be a different byte.
func natMemRsp(s, reg, off) {
    if (off == 0) {
        s = natModrm(s, 0, reg, 4)
        return natByte(s, natMask(23))
    }
    if (off >= -128 && off <= 127) {
        s = natModrm(s, 1, reg, 4)
        s = natByte(s, natMask(23))
        return natByte(s, off & 255)
    }
    s = natModrm(s, 2, reg, 4)
    s = natByte(s, natMask(23))
    return natU32(s, off)
}

// natLoadStack emits mov r64, [rsp+off]: REX.W + 8B /r.
func natLoadStack(s, dst, off) {
    s = natRex(s, 1, dst, 4)
    s = natByte(s, natMask(19))
    return natMemRsp(s, dst, off)
}

// natStoreStack emits mov [rsp+off], r64: REX.W + 89 /r.
func natStoreStack(s, src, off) {
    s = natRex(s, 1, src, 4)
    s = natByte(s, natMask(18))
    return natMemRsp(s, src, off)
}

// natSubRegImm32 emits sub r64, imm32 (83 /5 ib, or 81 /5 id when the value
// does not fit in a signed byte). The short form is not a size optimisation:
// the Go oracle picks it, so picking it differently would be a different
// image.
func natSubRegImm32(s, r, v) {
    s = natRex(s, 1, 0, r)
    if (v >= -128 && v <= 127) {
        s = natByte(s, natMask(22))
        s = natModrm(s, 3, natMask(24), r)
        return natByte(s, v & 255)
    }
    s = natByte(s, natMask(21))
    s = natModrm(s, 3, natMask(24), r)
    return natU32(s, v)
}

// natAddRegImm32 emits add r64, imm32 (83 /0 ib, or 81 /0 id).
func natAddRegImm32(s, r, v) {
    s = natRex(s, 1, 0, r)
    if (v >= -128 && v <= 127) {
        s = natByte(s, natMask(22))
        s = natModrm(s, 3, natMask(25), r)
        return natByte(s, v & 255)
    }
    s = natByte(s, natMask(21))
    s = natModrm(s, 3, natMask(25), r)
    return natU32(s, v)
}

// natXorRegReg emits xor r64, r64: REX.W + 31 /r. The oracle passes the same
// register as src and dst, which is how it zero-extends a return value.
func natXorRegReg(s, r) {
    s = natRex(s, 1, r, r)
    s = natByte(s, natMask(20))
    return natModrm(s, 3, r, r)
}

// natRet emits ret (C3).
func natRet(s) {
    return natByte(s, natMask(4))
}

// Phase 151A Step 2 — integer expression lowering primitives. Each is the
// byte-for-byte counterpart of the identically named Go method.

// natNegReg emits neg r64: REX.W + F7 /3 (two's complement).
func natNegReg(s, r) {
    s = natRex(s, 1, 0, r)
    s = natByte(s, natMask(31))
    return natModrm(s, 3, 3, r)
}

// natMovRegReg emits mov r64, r64: REX.W + 89 /r.
//
// The oracle passes (src, dst) to rex() here and (dst, src) to rex() in
// MulRegReg. That asymmetry is reproduced rather than tidied: for rax/rcx both
// spellings yield the same 0x48, and "tidying" it would silently diverge from
// the oracle the moment a high register is involved.
func natMovRegReg(s, dst, src) {
    s = natRex(s, 1, src, dst)
    s = natByte(s, natMask(18))      // 0x89, the same selector natStoreStack uses
    return natModrm(s, 3, src, dst)
}

// natMulRegReg emits imul r64, r64: REX.W + 0F AF /r.
func natMulRegReg(s, dst, src) {
    s = natRex(s, 1, dst, src)
    s = natByte(s, natMask(7))       // 0x0F two-byte escape
    s = natByte(s, natMask(33))      // 0xAF
    return natModrm(s, 3, dst, src)
}

// natCmpRegReg emits cmp r64, r64: REX.W + 39 /r, comparing dst against src.
// It sets flags only; no value is produced, which is exactly why the oracle
// reaches a boolean only by BRANCHING rather than by materialising one.
func natCmpRegReg(s, dst, src) {
    s = natRex(s, 1, src, dst)
    s = natByte(s, natMask(32))
    return natModrm(s, 3, src, dst)
}

// natJcc emits a near condition-code jump: 0F 8x cd. The near form is
// uniform with natJnz, which is what the oracle uses for every conditional
// branch; a short (8-bit displacement) form would be a different byte.
//
// `op` selects the condition, matching the Go Emitter's methods exactly:
//
//   natJccOpJz 0x84   natJccOpJnz 0x85   natJccOpJl  0x8C
//   natJccOpJge 0x8D   natJccOpJle 0x8E   natJccOpJg  0x8F
func natJcc(s, op, label) {
    s = natByte(s, natMask(7))
    s = natByte(s, op)
    // natRel32 returns the [state, pos] PAIR, not the state, so the state has
    // to be taken back out. The 151B natJnz below does the same thing.
    let r = natRel32(s, label)
    return r[0]
}

// The five condition selectors this slice adds beyond 151B's natJnz, as
// selector numbers into natMask. Jnz is deliberately absent: natJnz already
// existed and is unchanged.
func natJccOpJz()  { return natMask(26) }
func natJccOpJl()  { return natMask(27) }
func natJccOpJge() { return natMask(28) }
func natJccOpJle() { return natMask(29) }
func natJccOpJg()  { return natMask(30) }

func natJz(s, label)  { return natJcc(s, natJccOpJz(), label) }
func natJl(s, label)  { return natJcc(s, natJccOpJl(), label) }
func natJge(s, label) { return natJcc(s, natJccOpJge(), label) }
func natJle(s, label) { return natJcc(s, natJccOpJle(), label) }
func natJg(s, label)  { return natJcc(s, natJccOpJg(), label) }

// natJmp emits jmp rel32: E9 cd.
func natJmp(s, label) {
    s = natByte(s, natMask(5))
    let r = natRel32(s, label)
    return r[0]
}

func natAddRegReg(s, dst, src) {
    s = natRex(s, 1, src, dst)
    s = natByte(s, natMask(9))
    return natModrm(s, 3, src, dst)
}

// natSubRegReg emits sub r64, r64: REX.W + 29 /r.
func natSubRegReg(s, dst, src) {
    s = natRex(s, 1, src, dst)
    s = natByte(s, natMask(10))
    return natModrm(s, 3, src, dst)
}

// natJnz emits jnz rel32: 0F 85 cd.
func natJnz(s, label) {
    s = natByte(s, natMask(7))
    s = natByte(s, natMask(8))
    let r = natRel32(s, label)
    return r[0]
}

// natMovImm64Op returns 0xB8 + rd, the opcode byte of `mov r64, imm64`
// for register number rd (0 = rax). Register arithmetic is confined here
// so no other part of the encoder needs to know the numbering.
func natMovImm64Op(rd) { return 184 + rd }

// natStCode, natStLabelName, natStLabelOff, natStPatchOff, natStPatchLabel,
// natStImm64 are the fixed slots of the emitter state array.
func natStCode(s) { return s[0] }
func natStLabelName(s) { return s[1] }
func natStLabelOff(s) { return s[2] }
func natStPatchOff(s) { return s[3] }
func natStPatchLabel(s) { return s[4] }
func natStImm64(s) { return s[5] }

// natNewEmitter returns a fresh emitter state: empty code, no labels, no
// rel32 fixups, no imm64 placeholders.
func natNewEmitter(unused) {
    return [[], [], [], [], [], []]
}

// natLen reports how many bytes have been emitted so far. It is the value
// every label offset and patch position is relative to, so it must match
// the Go Emitter's Len() exactly or every rel32 is wrong.
func natLen(s) {
    return len(natStCode(s))
}

// natByte appends one raw byte, truncated to 8 bits.
func natByte(s, b) {
    s[0] = appendArray(s[0], b & natMask(0))
    return s
}

// natBytes appends a little-endian run of bytes from a value, least
// significant first. Go's u32/u64 do exactly this.
func natBytesLE(s, v, n) {
    let i = 0
    while (i < n) {
        s[0] = appendArray(s[0], (v >> (i * 8)) & natMask(0))
        i = i + 1
    }
    return s
}

// natU32 appends a 4-byte little-endian immediate.
func natU32(s, v) {
    return natBytesLE(s, v, 4)
}

// natU64 appends an 8-byte little-endian immediate.
func natU64(s, v) {
    return natBytesLE(s, v, 8)
}

// natMark defines a label at the current offset.
//
// Marking the same label twice is deferred to natFinish rather than
// rejected here, for one reason: this function has no way to return an
// error, and returning a silently-discarded error is how a bug hides. The
// duplicate is therefore caught at the one point where the emitter can
// fail as a whole, which is the same class of failure as a missing label
// and matches the Go emitter, which panics on both.
func natMark(s, label) {
    s[1] = appendArray(s[1], label)
    s[2] = appendArray(s[2], natLen(s))
    return s
}

// natLabelPos returns the index of a label, or -1 when it is not defined.
// The lookup is a linear scan: an emitter holds tens of labels, and a
// scan keeps the structure identical to the Go map-free path.
func natLabelPos(s, label) {
    let i = 0
    while (i < len(natStLabelName(s))) {
        if (natStLabelName(s)[i] == label) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// natLabelOff returns the offset a label resolves to, or -1 if undefined.
func natLabelOff(s, label) {
    let p = natLabelPos(s, label)
    if (p < 0) {
        return 0 - 1
    }
    return natStLabelOff(s)[p]
}

// natRel32 records a 4-byte rel32 fixup that will resolve to `label` at
// Finish time, and returns the position of the displacement field.
//
// The displacement is written as four zero bytes now and rewritten later.
// That is the whole trick: the instruction stream's LENGTH must be known
// at emission time (everything after it is positioned relative to it)
// while the TARGET is not known until every label is marked.
func natRel32(s, label) {
    let pos = natLen(s)
    s[3] = appendArray(s[3], pos)
    s[4] = appendArray(s[4], label)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    return [s, pos]
}

// natImm64Patch emits `mov r64, <placeholder>` (REX.W + B8+rd + 8 zero
// bytes) and returns the position of the 8 immediate bytes.
//
// The register is passed as its opcode byte so this layer stays free of
// register-number arithmetic; the caller supplies the already-computed
// opcode. 10 bytes total, matching the Go imm64Patch exactly.
func natImm64Patch(s, opcode) {
    s[0] = appendArray(s[0], natMask(2))
    s[0] = appendArray(s[0], opcode)     // B8 + rd
    let pos = natLen(s)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    s[0] = appendArray(s[0], 0)
    return [s, pos]
}

// natMovImm64 emits `mov r64, imm64` (REX.W + B8+rd + 8 little-endian
// bytes) and returns the position of the immediate.
//
// This is the two-step form of natImm64Patch for the case where the
// value is already known at emission time, so there is nothing for a
// linker to fix up. The position is still recorded so that the caller can
// tell an absolute-address site from an ordinary immediate if it needs to;
// a linker must not clobber this one, which is the whole reason the
// placeholder form exists as a separate call.
//
// `opcode` is the already-computed B8+rd byte, keeping register-number
// arithmetic out of this layer. 10 bytes total.
func natMovImm64(s, opcode, v) {
    s[0] = appendArray(s[0], natMask(2))
    s[0] = appendArray(s[0], opcode)      // B8 + rd
    let pos = natLen(s)
    s = natU64(s, v)
    s[5] = appendArray(s[5], pos)
    return s
}

// natFinish resolves every rel32 fixup and returns the finished code.
//
// Returns the code on success. On a duplicate label or a missing one it
// returns the string "error[K117]: <detail>" instead, so the caller can
// refuse loudly. The alternative -- writing a zero displacement -- would
// produce an image that jumps to the wrong place and looks like a compiler
// bug rather than a build error.
func natFinish(s) {
    // Duplicate labels first: a duplicate is a definition error, and
    // resolving against the second definition would hide it behind a
    // plausible-looking displacement.
    let dup = natFindDupLabel(s)
    if (dup != "") {
        return "error[K117]: native encoder: duplicate label '" + dup + "'"
    }
    let i = 0
    while (i < len(natStPatchOff(s))) {
        let target = natLabelOff(s, natStPatchLabel(s)[i])
        if (target < 0) {
            return "error[K117]: native encoder: undefined label '" + natStPatchLabel(s)[i] + "' referenced by a rel32 fixup at byte " + str(natStPatchOff(s)[i])
        }
        // rel = target - (pos + 4), written as a signed 32-bit value.
        let rel = target - (natStPatchOff(s)[i] + 4)
        s[0][natStPatchOff(s)[i]] = rel & natMask(0)
        s[0][natStPatchOff(s)[i] + 1] = (rel >> 8) & natMask(0)
        s[0][natStPatchOff(s)[i] + 2] = (rel >> 16) & natMask(0)
        s[0][natStPatchOff(s)[i] + 3] = (rel >> 24) & natMask(0)
        i = i + 1
    }
    return natStCode(s)
}

// natFindDupLabel returns the first label marked more than once, or "" when
// every label is unique.
func natFindDupLabel(s) {
    let i = 0
    while (i < len(natStLabelName(s))) {
        let j = i + 1
        while (j < len(natStLabelName(s))) {
            if (natStLabelName(s)[j] == natStLabelName(s)[i]) {
                return natStLabelName(s)[i]
            }
            j = j + 1
        }
        i = i + 1
    }
    return ""
}

// natToHex renders finished bytes as lowercase hex, two digits per byte.
//
// The parity gate compares this string between the Go and kcc engines, so
// the rendering must be unambiguous and fixed-width: a one-digit encoding
// would let 0x0f and 0xf0 compare equal in a sloppy implementation.
func natToHex(code) {
    let digits = "0123456789abcdef"
    let out = ""
    let i = 0
    while (i < len(code)) {
        let b = code[i] & natMask(0)
        out = out + substr(digits, b >> 4, 1) + substr(digits, b & natMask(1), 1)
        i = i + 1
    }
    return out
}

// ============================================================
// Reference sequences (increment 151B)
//
// These are the encoder's MEASUREMENT SURFACE. The gate runs every one of
// them through BOTH this encoder and the Go oracle (pkg/native Emitter) and
// compares the bytes, so the encoder can be proven byte-identical to the
// oracle before any value model is layered on top of it.
//
// They are chosen to cover the three things the encoder must get right and
// nothing else, so a failure names a subsystem rather than a program:
// a forward fixup, a BACKWARD fixup (negative displacement, two's
// complement), several fixups in one stream, and an imm64 placeholder that
// is recorded and never resolved here because filling absolute addresses is
// the linker's job.
// ============================================================

// natSeqImm64: mov rax, imm64; jmp later; nop; nop; later: ret
//
// The padding is load-bearing. Without it the displacement would be 0 even
// before the finish pass runs, so a finish pass that did nothing would still
// produce the correct-looking bytes.
func natSeqImm64(s) {
    s = natMovImm64(s, natMovImm64Op(0), natMask(6))
    s = natByte(s, natMask(5))
    let r = natRel32(s, "later")
    s = r[0]
    s = natByte(s, natMask(3))
    s = natByte(s, natMask(3))
    s = natMark(s, "later")
    return natByte(s, natMask(4))
}

// natSeqLoop: a counted loop whose jnz targets a BACKWARD label.
//
// This is the hard case for a rel32 fixup. The displacement is negative, so
// it must be written as a little-endian two's-complement 32-bit value; an
// implementation that gets the sign wrong emits a jump far outside the text
// rather than a subtly wrong answer. The sequence computes sum(10..1) = 55,
// and the gate checks the displacement against that independently.
//
//	mov rax, 0
//	mov rcx, 10
//	mov rdx, 1
// loop:
//	add rax, rcx
//	sub rcx, rdx
//	jnz loop
//	ret
func natSeqLoop(s) {
    s = natMovRegImm32(s, 0, 0)
    s = natMovRegImm32(s, 1, 10)
    s = natMovRegImm32(s, 2, 1)
    s = natMark(s, "loop")
    s = natAddRegReg(s, 0, 1)
    s = natSubRegReg(s, 1, 2)
    s = natJnz(s, "loop")
    return natByte(s, natMask(4))
}

// natCall32 emits the 0xE8 call rel32 opcode. It gets its own selector
// rather than being derived from the jnz opcode: the first draft computed it
// as natMask(8) - 128, which is arithmetically right but makes a reader
// verify the relationship instead of reading the byte.
func natCall32(s) {
    return natByte(s, natMask(17))
}

// natSyscall emits syscall (0F 05): the two-byte opcode with no REX prefix
// and no ModRM. It is the counterpart of the identically named Go
// Emitter.Syscall, and it exists because the Linux exit tail of `_start` is
// the first kcc native code that leaves the instruction set and enters the
// kernel ABI.
//
// The bytes are stated here rather than derived, because a two-byte opcode has
// no ModRM to catch a swapped pair -- the 151B record shows how a wrong
// constant table produced output that was not x86 at all, silently.
func natSyscall(s) {
    s = natByte(s, natMask(34))
    s = natByte(s, natMask(35))
    return s
}

// natSeqMulti: three fixups, two forward and one backward, plus an imm64
// placeholder.
//
// A single fixup cannot distinguish a real fixup table from one global
// displacement variable, so the gate needs more than one per stream, and
// needs a mix of directions to catch a sign error that only shows up
// backwards.
func natSeqMulti(s) {
    s = natCall32(s)
    let r1 = natRel32(s, "helper_a")
    s = r1[0]
    s = natByte(s, natMask(5))
    let r2 = natRel32(s, "done")
    s = r2[0]
    s = natMark(s, "helper_a")
    s = natCall32(s)
    let r3 = natRel32(s, "helper_b")
    s = r3[0]
    s = natMark(s, "back")
    s = natByte(s, natMask(5))
    let r4 = natRel32(s, "done")
    s = r4[0]
    s = natMark(s, "helper_b")
    s = natCall32(s)
    let r5 = natRel32(s, "back")
    s = r5[0]
    s = natMark(s, "done")
    s = natByte(s, natMask(4))
    let p = natImm64Patch(s, natMovImm64Op(0))
    return p[0]
}

// natSeqUndefinedLabel: a rel32 to a label that is never marked.
//
// The finish pass must REFUSE rather than write a zero displacement, because
// a zero displacement silently jumps to the wrong place and reads as a
// compiler bug rather than as a build error.
func natSeqUndefinedLabel(s) {
    s = natByte(s, natMask(5))
    let r = natRel32(s, "nowhere")
    return r[0]
}

// natSeqDuplicateLabel marks one label twice. The second definition would
// otherwise win silently, so the finish pass must refuse here too. This is
// the condition pkg/native/emit.go's Mark panics on, and a self-hosted
// compiler that cannot panic has to report it instead.
func natSeqDuplicateLabel(s) {
    s = natMark(s, "twice")
    s = natByte(s, natMask(3))
    s = natMark(s, "twice")
    return natByte(s, natMask(3))
}

// natEncodeCorpus runs one named sequence to completion and returns either
// its hex or the error string the finish pass produced.
//
// The dispatch is a plain if-chain because a zero-argument call in expression
// position is dropped by this engine's C codegen, and a switch on a computed
// value would reintroduce that shape.
func natEncodeCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natSeqImm64(natNewEmitter(0)))) }
    if (which == 1) { return natToHex(natFinish(natSeqLoop(natNewEmitter(0)))) }
    if (which == 2) { return natToHex(natFinish(natSeqMulti(natNewEmitter(0)))) }
    if (which == 3) { return natFinish(natSeqUndefinedLabel(natNewEmitter(0))) }
    if (which == 4) { return natFinish(natSeqDuplicateLabel(natNewEmitter(0))) }
    return ""
}

// ============================================================
// Phase 151A Step 5 -- the Windows boundary emitter primitives.
//
// Every function is the byte-for-byte counterpart of the identically named Go
// method in pkg/native/emit.go. The block is ADDITIVE: nothing above it is
// changed, which preserves the property Step 1 established.
//
// The ModRM/SIB/displacement CHOICES are not size optimisations. The oracle
// picks the narrowest form that fits, so picking a different width here is a
// DIFFERENT BYTE and therefore a different image.
// ============================================================

// natMemBaseOff emits ModRM + displacement for a plain [base+off] form with no
// SIB byte, mirroring Go memBaseOff.
//
// RSP is the one register with no low-3-bit ModRM encoding (rm=101 means
// RIP-relative when mod != 00), so it is addressed through a SIB. The SIB byte
// must be emitted BEFORE the displacement, because the ModRM rm=100 promises a
// SIB and the disp follows it.
func natMemBaseOff(s, gp, base, off) {
    if (base == natRegRSP()) {
        // SIB 0x24 = scale-0, index-none, base-RSP. NOT natMask(43), which is
        // 0x25 = index-none, base-RBP -- and in mod=00, RBP-as-base means "NO
        // base, disp32", i.e. the ABSOLUTE form. So 0x25 here would silently
        // rebase every [rsp+off] access to [rbp+off] or to an absolute
        // displacement.
        //
        // This was wrong from the moment natMemBaseOff was written and stayed
        // latent because nothing called it with base=RSP: natStoreStack and
        // natLoadStack go through natMemRsp (which correctly uses natMask(23),
        // the same 0x24), and the Step 5/6 PE export walk reads gs-relative
        // structures through a general register. Step 8b's natStoreMem8Off with
        // base RSP is the first caller to reach this branch, and the
        // byte-499 difference `88 04 25` vs `88 04 24` is what exposed it.
        if (off == 0) {
            s = natModrm(s, 0, gp, 4)
            return natByte(s, natMask(23))
        }
        if (off >= -128 && off <= 127) {
            s = natModrm(s, 1, gp, 4)
            s = natByte(s, natMask(23))
            return natByte(s, off & 255)
        }
        s = natModrm(s, 2, gp, 4)
        s = natByte(s, natMask(23))
        return natU32(s, off)
    }
    if (off == 0) {
        return natModrm(s, 0, gp, base)
    }
    if (off >= -128 && off <= 127) {
        s = natModrm(s, 1, gp, base)
        return natByte(s, off & 255)
    }
    s = natModrm(s, 2, gp, base)
    return natU32(s, off)
}

// natLoadBaseOff emits mov r64, [base+off]: REX.W + 8B /r.
func natLoadBaseOff(s, dst, base, off) {
    s = natRex(s, 1, dst, base)
    s = natByte(s, natMask(19))
    return natMemBaseOff(s, dst, base, off)
}

// natLoadBaseOff32 emits mov r32, [base+off] (zero-extending): 8B /r with NO
// REX.W -- only REX.B, and only for an extended base register.
func natLoadBaseOff32(s, dst, base, off) {
    s = natRex(s, 0, dst, base)
    s = natByte(s, natMask(19))
    return natMemBaseOff(s, dst, base, off)
}

// natMovzxRegMem16 emits movzx r32, word [base+off]: 0F B7 /r with NO REX.W
// (a 32-bit destination). Reads UNICODE_STRING Length fields and WCHARs.
func natMovzxRegMem16(s, dst, base, off) {
    s = natRex(s, 0, dst, base)
    s = natByte(s, natMask(7))
    s = natByte(s, natMask(37))
    return natMemBaseOff(s, dst, base, off)
}

// natMovRegGsMem emits mov r64, gs:[disp32]: 0x65 + REX.W + 8B /r + SIB 0x25 +
// disp32. Used exactly once: rax = PEB, which is gs:[0x60] on x86-64 Windows.
func natMovRegGsMem(s, dst, disp) {
    s = natByte(s, natMask(36))
    s = natRex(s, 1, dst, natRegRSP())
    s = natByte(s, natMask(19))
    s = natModrm(s, 0, dst, 4)
    s = natByte(s, natMask(43))
    return natU32(s, disp)
}

// natAndRspNeg16 emits and rsp, -16: REX.W + 83 /4 + F0.
//
// The Windows entry alignment fix, and it must come FIRST: main frame
// arithmetic and every kernel32 call assume rsp % 16 == 0 at the call.
func natAndRspNeg16(s) {
    s = natRex(s, 1, natRegRSP(), natRegRSP())
    s = natByte(s, natMask(22))
    s = natModrm(s, 3, natMask(40), natRegRSP())
    return natByte(s, natMask(42))
}

// natOrRegImm8 emits or r64, imm8: REX.W + 83 /1 ib. The register operand sits
// in the ModRM rm field, so only REX.B is relevant.
func natOrRegImm8(s, r, v) {
    s = natRex(s, 1, 0, r)
    s = natByte(s, natMask(22))
    s = natModrm(s, 3, natMask(39), r)
    return natByte(s, v & 255)
}

// natCmpRegImm32 emits cmp r64, imm: REX.W + 81 /7 id, or the three-bytes-shorter
// REX.W + 83 /7 ib when the value fits a signed byte. Both mean the same thing
// and the oracle picks the short one, so choosing differently is a diff image.
func natCmpRegImm32(s, r, v) {
    if (v <= 127) {
        s = natRex(s, 1, 0, r)
        s = natByte(s, natMask(22))
        s = natModrm(s, 3, natMask(41), r)
        return natByte(s, v & 255)
    }
    s = natRex(s, 1, 0, r)
    s = natByte(s, natMask(21))
    s = natModrm(s, 3, natMask(41), r)
    return natU32(s, v)
}

// natDecReg emits dec r64: REX.W + FF /1.
func natDecReg(s, r) {
    s = natRex(s, 1, 0, r)
    s = natByte(s, natMask(44))
    return natModrm(s, 3, 1, r)
}

// natTestRegReg emits test r64, r64: REX.W + 85 /r.
//
// Like natMovRegReg the oracle passes (src, dst) to rex() and puts src in the
// ModRM reg field; the asymmetry is reproduced, not tidied.
func natTestRegReg(s, a, b) {
    s = natRex(s, 1, b, a)
    s = natByte(s, natMask(45))
    return natModrm(s, 3, b, a)
}

// natCallReg emits call r64: FF /2.
//
// RSP (low 4) and RBP (low 5) are the two forms ModRM cannot encode directly:
// rm=100 promises a SIB and rm=101 is RIP-relative at mod=00. Both take the
// special forms Go CallReg uses; that asymmetry was part of the one-byte
// execution blocker in Phase 149 and is reproduced deliberately.
func natCallReg(s, r) {
    s = natRex(s, 0, 0, r)
    s = natByte(s, natMask(44))
    if (r == 4) {
        s = natModrm(s, 0, 2, 4)
        return natByte(s, 32 + (r & 7))
    }
    if (r == 5) {
        s = natModrm(s, 1, 2, 5)
        return natByte(s, 0)
    }
    return natModrm(s, 0, 2, r)
}

// natInt3 emits int3 (0xCC): the oracle LOUD failure. A missing module or an
// exhausted export walk reaches this rather than producing silent wrong code.
func natInt3(s) {
    return natByte(s, natMask(38))
}

// natStoreAbs64 emits `mov [imm64], rax` -- REX.W + A3 + eight immediate bytes --
// and returns the [state, pos] pair, mirroring Go StoreAbs64Placeholder.
//
// The moffs64 form is accumulator-only, so this is ALWAYS rax: a caller holding
// a value elsewhere must move it into rax first. Phase 149 stored RDX
// predecessor (the raw function RVA) and published garbage.
//
// The eight bytes stay ZERO because the LINKER resolves them against .idata.
func natStoreAbs64(s) {
    s = natRex(s, 1, natRegRAX(), natRegRAX())
    s = natByte(s, natMask(46))
    let pos = natLen(s)
    s = natU64(s, 0)
    // Record the position so the linker can be told where to write the resolved
    // IAT address. natFinish ignores this slot, so recording cannot change a byte;
    // it is how Step 6 turns these placeholders into a real image. The order is
    // the emission order: ExitProcess, GetStdHandle, WriteFile.
    s[5] = appendArray(s[5], pos)
    return [s, pos]
}

// natSibScale returns the SIB scale field for a scale of 1, 2, 4 or 8.
func natSibScale(scale) {
    if (scale == 1) { return 0 }
    if (scale == 2) { return 1 }
    if (scale == 4) { return 2 }
    return 3
}

// natLoadScaled32 emits mov r32, [base+index*scale+disp]: 8B /r + ModRM + SIB +
// disp. Used for the export functions table, [funcsPtr + ordinal*4].
//
// The SIB byte comes AFTER the ModRM (its rm=100 promises one), and the
// displacement uses the same narrowest-fits form as everywhere else.
func natLoadScaled32(s, dst, base, index, scale, disp) {
    let sc = natSibScale(scale)
    let r = natMask(13)
    if (natRegExt(dst) == 1) { r = r | natMask(15) }
    if (natRegExt(index) == 1) { r = r | natMask(47) }   // REX.X -- NOT natMask(14),
                                                        // which is the REX.W bit
    if (natRegExt(base) == 1) { r = r | natMask(16) }
    if (r != natMask(13)) { s = natByte(s, r) }
    s = natByte(s, natMask(19))
    // The oracle's chain is if / else-if / else, so when the first arm fails
    // BECAUSE base is rbp (low 5), a zero displacement still qualifies for the
    // disp8 arm. Reproducing that as two independent `if`s over an initialised
    // narrow value is what this is: the second test must NOT also require
    // disp != 0, or disp==0 with an rbp base emits mod=10 + disp32 and the image
    // grows by three bytes.
    let narrow = 2
    if (disp == 0 && base != 5) { narrow = 0 }
    if (narrow == 2 && disp >= -128 && disp <= 127) { narrow = 1 }
    if (narrow == 0) {
        s = natModrm(s, 0, dst, 4)
    } else {
        if (narrow == 1) { s = natModrm(s, 1, dst, 4) } else { s = natModrm(s, 2, dst, 4) }
    }
    s = natByte(s, (sc * 64) + ((index & 7) * 8) + (base & 7))
    if (narrow == 0) { return s }
    if (narrow == 1) { return natByte(s, disp & 255) }
    return natU32(s, disp)
}

// ============================================================
// Phase 151A Step 7 -- the primitives int `print` needs.
//
// Every one of these is the byte-for-byte counterpart of the identically named
// method in pkg/native/emit.go. Two of them (natCqo, natStoreMem8) have NO
// REX.W, which is load-bearing rather than an omission, and each says so.
// ============================================================

// natCqo emits cqo (sign-extend rax into rdx:rax, the dividend the digit loop
// divides): REX.W + 99.
func natCqo(s) {
    s = natByte(s, natMask(2))
    return natByte(s, natMask(48))
}

// natDivReg emits div r/m64 (unsigned rdx:rax / r): REX.W + F7 /6.
//
// natMask(31) is the existing 0xF7 group-3 opcode byte that natNegReg already
// uses; it is reused rather than duplicated, because it is the same byte.
func natDivReg(s, r) {
    s = natRex(s, 1, 0, r)
    s = natByte(s, natMask(31))
    return natModrm(s, 3, 6, r)
}

// natStoreMem8 emits mov [base], r8 for a single byte: 88 /r.
//
// NO REX PREFIX, and that is a correctness requirement rather than a byte
// detail: 88 /r with REX.W is not a byte store at all, it is a different
// encoding. The 64-bit operand size here comes from the ABSENCE of a prefix,
// so adding one would break the store and also stop matching the oracle.
//
// base must be a plain base register (rsi/rdi/...); rsp would require a SIB
// byte this helper deliberately does not emit, which is why the oracle's own
// comment says the same thing.
func natStoreMem8(s, base, src) {
    s = natByte(s, natMask(49))
    return natModrm(s, 0, src, base)
}

// natPushReg emits push r64: 50+rd, with REX.B (0x41) for r8-r15.
//
// The REX byte is built from the existing natMask(13)=0x40 and natMask(16)=0x01
// components that natRex already uses, rather than being spelled as a literal,
// so it cannot drift away from the rest of the encoder.
func natPushReg(s, r) {
    if (natRegExt(r) == 1) { s = natByte(s, natMask(13) | natMask(16)) }
    return natByte(s, natMask(50) + (r & 7))
}

// natPopReg emits pop r64: 58+rd, with REX.B (0x41) for r8-r15.
func natPopReg(s, r) {
    if (natRegExt(r) == 1) { s = natByte(s, natMask(13) | natMask(16)) }
    return natByte(s, natMask(51) + (r & 7))
}

// natJns emits jns rel32 (jump if not sign, SF == 0): 0F 89 cd.
//
// This is the digit loop's "is the magnitude still non-negative" test, and it
// is jns rather than jg ON PURPOSE: the oracle tests the sign bit alone here,
// with no comparison against zero, so a `jg` would be a different program.
func natJns(s, label) {
    s = natByte(s, natMask(7))
    s = natByte(s, natMask(52))
    let r = natRel32(s, label)
    return r[0]
}

// ============================================================
// Phase 151A Step 8a - SSE2 scalar-double primitives
//
// Each is the byte-for-byte counterpart of the identically named method in
// pkg/native/emit.go, and each reproduces that method's EMISSION ORDER rather
// than just its opcode:
//
//     e.byte(prefix); e.rex(w, reg, rm); e.byte(0x0F); e.byte(op); e.modrm(3, reg, rm)
//
// The order matters twice over. The legacy mandatory prefix (0xF2 / 0x66)
// precedes REX -- see the natMask Step 8a block for why that is not
// interchangeable -- and the 0x0F escape byte sits BETWEEN the REX and the
// opcode, which is the one place it is legal.
//
// ModRM is mod=11 (register form) throughout: there is no memory operand in
// any of these eight, so no SIB byte and no displacement.
//
// `natRex(s, w, dst, src)` maps onto the Go `rex(w, Reg(dst), Reg(src))`:
// the destination is the ModRM.reg field and the source is the ModRM.rm
// field. That is true of all eight, including the two converts, where the
// roles look reversed until you notice the Go side still passes them in the
// same order and then writes `modrm(3, dst.low(), src.low())` unchanged.
func natAddsdXmmXmm(s, dst, src) {
    s = natByte(s, natMask(53))
    s = natRex(s, 0, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(55))
    return natModrm(s, 3, dst, src)
}

func natSubsdXmmXmm(s, dst, src) {
    s = natByte(s, natMask(53))
    s = natRex(s, 0, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(56))
    return natModrm(s, 3, dst, src)
}

func natMulsdXmmXmm(s, dst, src) {
    s = natByte(s, natMask(53))
    s = natRex(s, 0, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(57))
    return natModrm(s, 3, dst, src)
}

func natDivsdXmmXmm(s, dst, src) {
    s = natByte(s, natMask(53))
    s = natRex(s, 0, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(58))
    return natModrm(s, 3, dst, src)
}

// natUcomisdXmmXmm emits ucomisd, which sets CF/ZF/PF for the unordered
// compare. It takes 0x66, not 0xF2: the SSE2 double compare is the one member
// of this family keyed on 66 rather than F2, and using F2 here would assemble
// a different instruction rather than fail.
func natUcomisdXmmXmm(s, dst, src) {
    s = natByte(s, natMask(54))
    s = natRex(s, 0, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(59))
    return natModrm(s, 3, dst, src)
}

// The two converts carry REX.W because their GP operand is 64-bit. Their xmm
// operand is packed-double regardless, so the prefix stays 0xF2 in both
// directions.
func natCvtsi2sdXmmGp(s, dst, src) {
    s = natByte(s, natMask(53))
    s = natRex(s, 1, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(60))
    return natModrm(s, 3, dst, src)
}

func natCvttsd2siGpXmm(s, dst, src) {
    s = natByte(s, natMask(53))
    s = natRex(s, 1, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(61))
    return natModrm(s, 3, dst, src)
}

func natXorpdXmmXmm(s, dst, src) {
    s = natByte(s, natMask(54))
    s = natRex(s, 0, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(62))
    return natModrm(s, 3, dst, src)
}

// natFloatCorpus emits the Step 8a reference sequences, one hex line per arm.
//
// The arms are chosen to cover every DISTINCT encoding decision in this block
// rather than one per primitive, because a corpus of eight near-identical
// sequences would pass while the prefix/REX ordering was wrong:
//
//   0. all four arithmetic ops on xmm0 <- xmm1, the common case: no REX at all
//      (both registers are 0/1), so this arm is the ONLY one that would notice
//      a spurious 0x40.
//   1. addsd xmm8 <- xmm9: both fields need REX, so REX = 0x45 and the prefix
//      must land BEFORE it. A reversed order emits a different instruction.
//   2. ucomisd xmm0 <- xmm1 (the 0x66 family) next to addsd (the 0xF2 family),
//      in one sequence, so swapping the two prefixes is visible.
//   3. both converts on high GP + high xmm registers, which is the only arm
//      that exercises REX.W together with REX.R and REX.B at once.
func natFloatCorpus(which) {
    let s = natNewEmitter(0)
    if (which == 0) {
        s = natAddsdXmmXmm(s, 0, 1)
        s = natSubsdXmmXmm(s, 0, 1)
        s = natMulsdXmmXmm(s, 0, 1)
        s = natDivsdXmmXmm(s, 0, 1)
        return natToHex(natFinish(s))
    }
    if (which == 1) {
        s = natAddsdXmmXmm(s, 8, 9)
        s = natDivsdXmmXmm(s, 15, 8)
        return natToHex(natFinish(s))
    }
    if (which == 2) {
        s = natAddsdXmmXmm(s, 0, 1)
        s = natUcomisdXmmXmm(s, 0, 1)
        s = natXorpdXmmXmm(s, 0, 1)
        return natToHex(natFinish(s))
    }
    if (which == 3) {
        s = natCvtsi2sdXmmGp(s, 0, 8)
        s = natCvttsd2siGpXmm(s, 9, 0)
        s = natCvtsi2sdXmmGp(s, 15, 15)
        return natToHex(natFinish(s))
    }
    // Step 8b: the whole print_float helper. Emitted here so the corpus can
    // carry it as a single arm alongside the encoder-level sequences.
    if (which == 4) {
        return natToHex(natFinish(natPrintFloatHelper()))
    }
    return ""
}

// ============================================================
// Phase 151A Step 8b - the primitives print_float needs
//
// Each is the byte-for-byte counterpart of the identically named method in
// pkg/native/emit.go. Two of them are easy to get subtly wrong and are called
// out below.
//
// natMovXmmRegGp is `movq xmm, r64`, and its mandatory prefix is 0x66, NOT
// 0xF2. Every other double instruction in this file is 0xF2, so reaching for
// F2 here is the natural mistake; the Go oracle uses 66 and so does this.
//
// natMovGpRegXmm passes its two operands to natRex in the OPPOSITE order from
// every other primitive in this file. The Go side is `e.rex(true,
// Reg(src), dst)` then `e.modrm(3, src.low(), dst.low())`: for this
// instruction the xmm register occupies the ModRM.reg field and the GP
// register the rm field, which is the reverse of the SSE arithmetic ops where
// the destination xmm is the reg field. Copying the argument order from a
// neighbouring primitive produces a REX byte with R and B exchanged, which is
// a valid-looking encoding of a different instruction.

// natMovRegImm64 emits mov r64, imm64: REX.W + B8+rd io64.
func natMovRegImm64(s, r, v) {
    s = natRex(s, 1, 0, r)
    s = natByte(s, 184 + (r & 7))
    return natU64(s, v)
}

func natAndRegReg(s, dst, src) {
    s = natRex(s, 1, src, dst)
    s = natByte(s, natMask(63))
    return natModrm(s, 3, src, dst)
}

func natShrRegImm(s, r, imm) {
    s = natRex(s, 1, 0, r)
    s = natByte(s, natMask(64))
    s = natModrm(s, 3, 5, r)
    return natByte(s, imm & 255)
}

func natLeaRegStack(s, dst, off) {
    s = natRex(s, 1, dst, 4)
    s = natByte(s, natMask(65))
    return natMemRsp(s, dst, off)
}

func natMovzxRegMem8(s, dst, base, off) {
    s = natRex(s, 1, dst, base)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(66))
    return natMemBaseOff(s, dst, base, off)
}

// natStoreMem8Off stores a byte at [base+off]. Note there is NO REX.W here:
// StoreMem8Off is the byte form, and the Go oracle deliberately passes
// rex(false, ...) because the operand size is irrelevant for an 8-bit store
// and emitting REX.W would change the encoding.
func natStoreMem8Off(s, src, base, off) {
    s = natRex(s, 0, src, base)
    s = natByte(s, natMask(49))
    return natMemBaseOff(s, src, base, off)
}

func natMovXmmRegGp(s, dst, src) {
    s = natByte(s, natMask(54))
    s = natRex(s, 1, dst, src)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(67))
    return natModrm(s, 3, dst, src)
}

func natMovGpRegXmm(s, dst, src) {
    s = natByte(s, natMask(54))
    s = natRex(s, 1, src, dst)
    s = natByte(s, natMask(1))
    s = natByte(s, natMask(68))
    return natModrm(s, 3, src, dst)
}

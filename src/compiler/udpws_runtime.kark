    emitLine(state, "    free(frame);")
    emitLine(state, "    return make_int((long long)total);")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "Value karkain_ws_recv_text(Value fd, Value maxv) {")
    emitLine(state, "    _karkain_udpws_error[0] = '\\0';")
    emitLine(state, "    if (fd.type != TYPE_INT || maxv.type != TYPE_INT) {")
    emitLine(state, "        karkain_udpws_err(\"ws: invalid argument\");")
    emitLine(state, "        return make_string(\"\");")
    emitLine(state, "    }")
    emitLine(state, "    long long cap = maxv.intVal;")
    emitLine(state, "    if (cap <= 0 || cap > 1048576) cap = 1048576;")
    emitLine(state, "    unsigned char head[2];")
    emitLine(state, "    if (karkain_recv_exact((KarkainSock)fd.intVal, head, 2) != 0) {")
    emitLine(state, "        karkain_udpws_err(\"ws: receive failed\");")
    emitLine(state, "        return make_string(\"\");")
    emitLine(state, "    }")
    emitLine(state, "    int opcode = head[0] & 0x0f;")
    emitLine(state, "    int masked = (head[1] & 0x80) != 0;")
    emitLine(state, "    unsigned long long n = head[1] & 0x7f;")
    emitLine(state, "    if (n == 126) {")
    emitLine(state, "        unsigned char x[2];")
    emitLine(state, "        if (karkain_recv_exact((KarkainSock)fd.intVal, x, 2) != 0) { karkain_udpws_err(\"ws: receive failed\"); return make_string(\"\"); }")
    emitLine(state, "        n = ((unsigned long long)x[0] << 8) | x[1];")
    emitLine(state, "    } else if (n == 127) {")
    emitLine(state, "        unsigned char x[8];")
    emitLine(state, "        if (karkain_recv_exact((KarkainSock)fd.intVal, x, 8) != 0) { karkain_udpws_err(\"ws: receive failed\"); return make_string(\"\"); }")
    emitLine(state, "        n = 0;")
    emitLine(state, "        int i;")
    emitLine(state, "        for (i = 0; i < 8; i++) n = (n << 8) | x[i];")
    emitLine(state, "    }")
    emitLine(state, "    unsigned char mask[4] = {0,0,0,0};")
    emitLine(state, "    if (masked && karkain_recv_exact((KarkainSock)fd.intVal, mask, 4) != 0) {")
    emitLine(state, "        karkain_udpws_err(\"ws: receive failed\");")
    emitLine(state, "        return make_string(\"\");")
    emitLine(state, "    }")
    emitLine(state, "    if (opcode == 0x8) return make_string(\"\");")
    emitLine(state, "    if (opcode != 0x1) { karkain_udpws_err(\"ws: expected text frame\"); return make_string(\"\"); }")
    emitLine(state, "    if (n > (unsigned long long)cap) { karkain_udpws_err(\"ws: frame too large\"); return make_string(\"\"); }")
    emitLine(state, "    unsigned char* buf = (unsigned char*)malloc((size_t)n + 1);")
    emitLine(state, "    if (!buf) { karkain_udpws_err(\"ws: out of memory\"); return make_string(\"\"); }")
    emitLine(state, "    if (n && karkain_recv_exact((KarkainSock)fd.intVal, buf, (size_t)n) != 0) {")
    emitLine(state, "        free(buf); karkain_udpws_err(\"ws: receive failed\"); return make_string(\"\");")
    emitLine(state, "    }")
    emitLine(state, "    if (masked) {")
    emitLine(state, "        size_t i;")
    emitLine(state, "        for (i = 0; i < (size_t)n; i++) buf[i] ^= mask[i % 4];")
    emitLine(state, "    }")
    emitLine(state, "    buf[n] = 0;")
    emitLine(state, "    Value r = make_string((const char*)buf);")
    emitLine(state, "    free(buf);")
    emitLine(state, "    return r;")
    emitLine(state, "}")
    emitLine(state, "")
}

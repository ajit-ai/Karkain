    emitLine(state, "        }")
    emitLine(state, "        size_t n = 0;")
    emitLine(state, "        while (*p && *p != '.' && *p != '[') {")
    emitLine(state, "            if (n + 1 >= sizeof(key)) { karkain_json_err(\"json: path component too long\"); return make_int(0); }")
    emitLine(state, "            key[n++] = *p++;")
    emitLine(state, "        }")
    emitLine(state, "        key[n] = '\\0';")
    emitLine(state, "        cur = map_get(cur, make_string(key));")
    emitLine(state, "    }")
    emitLine(state, "    return cur;")
    emitLine(state, "}")
    emitLine(state, "")
}

// ============================================================
// Native VALUE and FRAME foundation (Phase 151A Step 1)
//
// The Karkain counterpart of the value/frame half of the Go oracle in
// pkg/native/program.go. The oracle is authoritative: this file is a PORT
// and must reproduce its conventions exactly, because increment 151's
// contract is that kcc's images are byte-identical to the Go oracle's.
//
// WHAT IS HERE, and nothing else:
//
//   1. The native value-kind model and kindUnits -- how many 8-byte frame
//      units a kind occupies.
//   2. The frame layout -- the ORDER and SIZING of the frame regions.
//   3. Local-slot addressing -- the byte offset of a local of a given kind.
//
// The code GENERATION that consumes these (int lowering, float, arrays,
// arena, strings, records, maps, the entry stub and syscall tails) is later
// 151A work and is deliberately absent. This slice's whole job is that the
// layout be right before any bytes depend on it.
//
// VALUES ARE STATICALLY KEDD AND UNBOXED. The roadmap's word "boxed" does
// NOT mean a tagged runtime Value here: the Go oracle assigns each local a
// compile-time kind and stores a raw 8-byte unit (or two, for string and
// array) at [rsp+off]. There is no tag word, and none is introduced. The
// TAGGED Value with TYPE_RESULT / resVal.tag belongs to the C path, which is
// a different model entirely (it is what the `?` operator inspects), and it
// must not leak into the native path.
//
// KindInt is 0 on purpose: the Go oracle makes it `iota` so that every
// pre-150 default -- an untyped parameter, a missing return, an unknown slot
// -- keeps meaning int without touching any of its logic. Every
// "cannot determine the kind" path in the oracle returns 0, so preserving
// that value is what keeps those paths working unchanged.
//
// STATE REPRESENTATION. Karkain has no structs, so the frame layout is
// returned as one array with fixed slots (natFr*), the same discipline
// native_emit.kark uses for the encoder and kir.kark uses for `lines`.
// ============================================================

// ============================================================
// 1. Value kinds and their unit widths.
// ============================================================

// natKindInt .. natKindMap mirror the Go oracle's KindInt..KindMap. The
// NUMBERS are the contract, because the oracle's `iota` numbering is what
// every default in its code compares against.
func natKindInt()    { return 0 }   // KindInt
func natKindString() { return 1 }   // KindString
func natKindFloat()  { return 2 }   // KindFloat
func natKindArray()  { return 3 }   // KindArray
func natKindStruct() { return 4 }   // KindStruct
func natKindMap()    { return 5 }   // KindMap

// natKindUnits returns the 8-byte frame/call slots a kind occupies.
//
//   int 1, float 1, bool 1 (a bool IS an int here), struct 1, map 1,
//   string 2, array 2.
//
// string and array are TWO units (ptr+len); everything else is one. This is
// the oracle's kindUnits verbatim. A record and a map are one unit because
// the value IS the address of the field area / arena header, so neither
// copies a byte when it is passed to a function.
func natKindUnits(kind) {
    if (kind == natKindString()) { return 2 }
    if (kind == natKindArray()) { return 2 }
    return 1
}

// natKindName renders a kind for diagnostics, matching the oracle's kindName.
func natKindName(kind) {
    if (kind == natKindString()) { return "string" }
    if (kind == natKindFloat()) { return "float" }
    if (kind == natKindArray()) { return "array" }
    if (kind == natKindStruct()) { return "struct" }
    if (kind == natKindMap()) { return "map" }
    return "int"
}

// ============================================================
// 2. Fixed frame-layout constants.
//
// These three are the oracle's, and they are load-bearing: changing any of
// them changes every image.
// ============================================================

// natArgSpillBytes is the fixed caller-side argument spill area: 6 args x
// (ptr+len) = 6 x 16 = 96 bytes, always reserved.
func natArgSpillBytes() { return 96 }

// natMaxBinDepth bounds nested binary-expression evaluation. It sizes
// binTemp, and it is a CONSTANT in the oracle (64), not a computed maximum:
// the frame must have the same size for every program so that a slot offset
// never depends on the program being compiled.
func natMaxBinDepth() { return 64 }

// natBinTempBytes is the binary-operand scratch area: 8 bytes per depth.
func natBinTempBytes() { return 8 * natMaxBinDepth() }

// natStrTempBytes is the string staging area: FIVE 8-byte units per nesting
// level. Five because a concat needs two operands, a result, and two length
// temporaries staged at once.
func natStrTempBytes() { return 8 * 5 * natMaxBinDepth() }

// natMapStageBytes is the single frame unit that carries a map key across the
// evaluation of its value.
func natMapStageBytes() { return 8 }

// ============================================================
// 3. The frame layout.
//
// Slot indices into the array returned by natFrameLayout:
//   0 localsEnd    1 binTemp   2 strTemp   3 mapStage
//   4 extrasBase   5 next      6 frame
// ============================================================

func natFrLocals()  { return 0 }
func natFrBinTemp() { return 1 }
func natFrStrTemp() { return 2 }
func natFrMapStage() { return 3 }
func natFrExtras() { return 4 }
func natFrNext()   { return 5 }
func natFrFrame()  { return 6 }

// natFrameLayout reproduces the oracle's layout() ordering and sizing for one
// function. Every parameter is a fact the oracle computed, so this function
// makes no decision of its own:
//
//   locals -> recArgAreas -> binTemp -> strTemp? -> mapStage? ->
//   extrasBase -> Windows 16-byte rounding -> + argSpillBytes
//
// Parameters, in the oracle's terms:
//   localBytes   the locals region already laid out (params first, then one
//                slot per let, strings and arrays taking two units each)
//   recArgBytes  Phase 150B3b record field areas for literals passed
//                straight to a call; 0 when the program has none
//   usesStr      true when the program has a concat / string-compare /
//                string-slice / push / string-field operation
//   usesMap      true when the program uses maps
//   maxExtra     the largest caller-side extras-unit count over this
//                function's call sites (Phase 148)
//   isWindows    whether the target is Windows
//
// strTemp and mapStage are CONDITIONAL in the oracle, and unconditionally
// reserving them would grow every frame that does not need them -- which
// would break the byte-identity of every image that does not use strings or
// maps. The conditionals are therefore part of the contract, not an
// optimisation, and they are reproduced exactly.
func natFrameLayout(localBytes, recArgBytes, usesStr, usesMap, maxExtra, isWindows) {
    let next = localBytes + recArgBytes
    next = next + natBinTempBytes()
    let strTemp = 0
    if (usesStr == 1) {
        strTemp = next
        next = next + natStrTempBytes()
    }
    let mapStage = 0
    if (usesMap == 1) {
        mapStage = next
        next = next + natMapStageBytes()
    }
    let extrasBase = next
    next = next + maxExtra * 8
    // Phase 149: Win64 calls fault on a misaligned stack, so the frame is
    // rounded to 16 on Windows. Linux never noticed, because syscalls do not
    // care -- and gating this on Windows is what keeps Linux images
    // byte-frozen.
    if (isWindows == 1) {
        if (next % 16 != 0) { next = next + 8 }
    }
    let frame = next + natArgSpillBytes()

    let f = []
    f = appendArray(f, localBytes)
    // binTemp is the region START, so an operand scratch slot is
    // binTemp + depth*8 and lands at localBytes+recArgBytes+depth*8. Recording
    // the region END here (localBytes+recArgBytes+binTempBytes) shifted every
    // staged operand by the whole scratch area -- 512 bytes -- which the
    // binary-expression differential caught immediately. Step 1 did not see it
    // because nothing emitted through binTemp and its layout corpus printed
    // only frame/strTemp/mapStage/slot offsets.
    f = appendArray(f, localBytes + recArgBytes)
    f = appendArray(f, strTemp)
    f = appendArray(f, mapStage)
    f = appendArray(f, extrasBase)
    f = appendArray(f, next)
    f = appendArray(f, frame)
    return f
}

// ============================================================
// 4. Local-slot addressing.
// ============================================================

// natLocalOff returns the byte offset of local `index` of `kind` within the
// locals region.
//
// Locals are laid out in declaration order with no gaps and no alignment
// padding: each occupies exactly kindUnits(kind) 8-byte units, so the offset
// of a unit-1 local is 8*index and the two-unit kinds simply consume two.
// That contiguity is why the oracle can address a slot with a compile-time
// displacement and never needs a relocation for it.
func natLocalOff(index, kind) {
    return 8 * index * natKindUnits(kind)
}

// ============================================================
// 5. The reference program bodies.
//
// Step 1's evidence is the machine code for the smallest programs that
// exercise a frame and a local slot. There is deliberately no helper, no
// `print`, no arena and no entry stub: those are later 151A work, and
// including them would make this slice's evidence depend on slices that do
// not exist yet.
//
// The two cases are:
//
//   one   `let x = 42`         one int local, stored, never read
//   two   `let x = 42; let y = x`   two int locals, load slot 0, store slot 1
//
// `two` is the case that actually proves the foundation: it emits a load and
// a store at two DIFFERENT compile-time displacements, so a wrong slot
// ordering, a wrong unit width or a wrong displacement form shows up as a
// different byte rather than as a coincidence.
// ============================================================

// The x86-64 register numbers, matching the Go oracle's Reg constants
// (RAX = 0 ...). They are named because a bare 0 or 4 in an encoder is a
// bug waiting to happen.
func natRegRAX() { return 0 }
func natRegRSP() { return 4 }

// natValueMain emits the body of `main` for the reference program.
// `nLocals` is 1 or 2; with 2 the second local copies the first.
//
// The sequence is the oracle's emitFunc prologue + one or two let
// lowerings + the return, and nothing else:
//
//   sub rsp, frame          prologue
//   mov rax, 42             the initialiser
//   mov [rsp+slot], rax     bind the local
//   mov rax, [rsp+slot]     (two locals only) read the first local
//   mov [rsp+slot+8], rax   bind the second local
//   xor rax, rax            the missing-return-yields-0 rule
//   add rsp, frame          epilogue
//   ret
func natValueMain(nLocals) {
    // One int local per declaration; int is one unit each, so the locals
    // region is 8 bytes per local. Computed through natKindUnits rather
    // than hard-coded, so the layout cannot drift away from the kind model.
    let localBytes = 8 * nLocals * natKindUnits(natKindInt())
    // recArgBytes 0 (no record literal is passed to a call),
    // usesStr 0 and usesMap 0 (no string or map operation exists yet, so
    // those two regions are NOT reserved -- the oracle's own conditionals),
    // maxExtra 0 (no call site), isWindows 0 (the reference case is Linux,
    // which never rounds).
    let f = natFrameLayout(localBytes, 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]

    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 42)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    if (nLocals == 2) {
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
    }
    s = natXorRegReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natValueLayoutCorpus reports the layout facts as text, so the gate can pin
// the frame arithmetic itself and not only the bytes it produced. These are
// the numbers the oracle computes for the same inputs; the gate derives them
// independently from first principles and compares BOTH the numbers and the
// bytes, because a layout that is wrong in the same way on both sides would
// still produce matching bytes.
func natValueLayoutCorpus(which) {
    if (which == 0) {
        // one int local
        let f = natFrameLayout(8, 0, 0, 0, 0, 0)
        return "int1 units=" + natKindUnits(natKindInt()) + " frame=" + f[natFrFrame()] + " slot0=" + natLocalOff(0, natKindInt())
    }
    if (which == 1) {
        // two int locals
        let f = natFrameLayout(16, 0, 0, 0, 0, 0)
        return "int2 units=" + natKindUnits(natKindInt()) + " frame=" + f[natFrFrame()] + " slot0=" + natLocalOff(0, natKindInt()) + " slot1=" + natLocalOff(1, natKindInt())
    }
    if (which == 2) {
        // kind units for every kind, in the oracle's numbering
        return "units int=" + natKindUnits(natKindInt()) + " string=" + natKindUnits(natKindString()) + " float=" + natKindUnits(natKindFloat()) + " array=" + natKindUnits(natKindArray()) + " struct=" + natKindUnits(natKindStruct()) + " map=" + natKindUnits(natKindMap())
    }
    if (which == 3) {
        // the conditional regions: reserved for a string program, skipped for
        // an int program. The int case must report 0, because reserving
        // them unconditionally would grow every int image.
        let fi = natFrameLayout(8, 0, 0, 0, 0, 0)
        let fs = natFrameLayout(8, 0, 1, 0, 0, 0)
        let fm = natFrameLayout(8, 0, 0, 1, 0, 0)
        return "cond int_strTemp=" + fi[natFrStrTemp()] + " int_mapStage=" + fi[natFrMapStage()] + " str_strTemp=" + fs[natFrStrTemp()] + " str_frame=" + fs[natFrFrame()] + " map_mapStage=" + fm[natFrMapStage()] + " map_frame=" + fm[natFrFrame()]
    }
    if (which == 4) {
        // Windows rounds the frame to 16; Linux does not. With maxExtra 2
        // (16 bytes) the unsized total is 8+512+16 = 536, which is 8 mod 16,
        // so Windows adds one unit and Linux does not.
        let fw = natFrameLayout(8, 0, 0, 0, 2, 1)
        let fl = natFrameLayout(8, 0, 0, 0, 2, 0)
        return "round win_frame=" + fw[natFrFrame()] + " linux_frame=" + fl[natFrFrame()]
    }
    return ""
}

// natValueCorpus is the measurement surface: the finished machine code of
// each reference program, as hex. natFinish returns an error string for a
// malformed emission, so a case that fails to encode reports that rather
// than an empty string.
func natValueCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natValueMain(1))) }
    if (which == 1) { return natToHex(natFinish(natValueMain(2))) }
    return ""
}

// natValuePrim renders one encoder opcode on its own, so each of the
// primitives Step 1 added to native_emit.kark can be compared individually
// against the Go oracle's identically named method. The composite program
// above already exercises all of them, but a composite mismatch does not say
// WHICH primitive is wrong.
//
// The order here is the gate's order and must stay in step with it.
func natValuePrim(which) {
    let s = natNewEmitter(0)
    if (which == 0) { s = natStoreStack(s, natRegRAX(), 0) }
    if (which == 1) { s = natLoadStack(s, natRegRAX(), 0) }
    if (which == 2) { s = natLoadStack(s, natRegRAX(), 8) }
    if (which == 3) { s = natStoreStack(s, natRegRAX(), 8) }
    // 616 is the real frame size of the one-local reference program, so the
    // wide-displacement path is exercised with a value that actually occurs.
    if (which == 4) { s = natStoreStack(s, natRegRAX(), 616) }
    if (which == 5) { s = natSubRegImm32(s, natRegRSP(), 616) }
    if (which == 6) { s = natAddRegImm32(s, natRegRSP(), 616) }
    // 16 fits in a signed byte, so this is the short (83 /digit ib) form. The
    // oracle picks the short form too, and picking the wide one instead would
    // be a different image.
    if (which == 7) { s = natSubRegImm32(s, natRegRSP(), 16) }
    if (which == 8) { s = natAddRegImm32(s, natRegRSP(), 16) }
    if (which == 9) { s = natXorRegReg(s, natRegRAX()) }
    if (which == 10) { s = natRet(s) }
    // Phase 151A Step 2 additions, in the gate's order.
    if (which == 11) { s = natNegReg(s, natRegRAX()) }
    if (which == 12) { s = natCmpRegReg(s, natRegRAX(), natRegRCX()) }
    if (which == 13) { s = natMovRegReg(s, natRegRAX(), natRegRCX()) }
    if (which == 14) { s = natMulRegReg(s, natRegRAX(), natRegRCX()) }
    return natToHex(natFinish(s))
}

// Registers, matching the oracle's Reg constants.
func natRegRCX() { return 1 }

// RDI is the first System V integer argument register, and the only argument
// register the Linux exit tail needs (the exit status). The oracle's Reg
// numbering is the architectural one, so RDI is 7 -- the accessor is named
// rather than written as the literal so the gate can pin it against
// pkg/native.RDI independently.
func natRegRDI() { return 7 }

// Phase 151A Step 5: the registers the Windows bootstrap walks over. RBX, RBP
// and R8-R11 are callee-saved under BOTH System V and Win64, which is why the
// oracle can hold the walk cursor, the module base and the export pointers in
// them across the whole pre-main sequence.
//
// The numbering is architectural and must match pkg/native exactly: R8-R11 are
// 8..11, and ModRM uses the low three bits, which is why natRegExt returns 1 for
// them.
func natRegRDX() { return 2 }
func natRegRSI() { return 6 }
func natRegRBX() { return 3 }
func natRegRBP() { return 5 }
func natRegR8()  { return 8 }
func natRegR9()  { return 9 }
func natRegR10() { return 10 }
func natRegR11() { return 11 }
// NAT-REG: the allocatable set. R12-R15 are callee-saved under BOTH ABIs in
// play (System V and Win64), so a value parked there survives a call to a user
// function, a helper or a kernel32 export without a spill; and they are
// untouched by the rest of the backend, which works in
// RAX/RCX/RDX/RSI/RDI/R8-R11 and clobbers RBX. RBX and RBP are deliberately
// NOT allocatable: both are live scratch inside emitted helpers.
//
// This is the ORACLE's allocatable set (pkg/native/regalloc.go: allocRegs),
// chosen for the same reasons.
func natRegR12() { return 12 }
func natRegR13() { return 13 }
func natRegR14() { return 14 }
func natRegR15() { return 15 }

// ============================================================
// Phase 151A Step 7 -- int `print`.
//
// The first kcc value-model surface that makes a real program's OUTPUT
// observable. Everything before this slice could compute a value and could
// enter and exit the image, but a kcc-compiled program could not say anything,
// so whole-image parity against the Go engine was untestable for want of
// anything to compare.
//
// This mirrors emitHelpers' print_int in pkg/native/program.go instruction
// for instruction, in the same order, because the oracle's order is not
// incidental: the digit pointer walks DOWN from the buffer end so no length
// has to be computed before the digits exist, and the sign is written from a
// separate pushed copy because the write syscall clobbers volatile registers.
// ============================================================

// The three target OS identities, in the one place they are spelled. They are
// stored in the emitter state (slot 15) rather than passed as arguments because
// natWriteStdout is reached from ~16 call sites inside the frozen print helpers.
func natOSLinux() { return 0 }
func natOSWindows() { return 1 }
func natOSMac() { return 2 }

// natSysWrite is the raw write(2) syscall number for the target OS.
//
// Linux and macOS both reach the kernel through a raw syscall, but with
// DIFFERENT numbers: Linux is 1, Darwin numbers its syscalls with a 0x2000000
// prefix and write is 0x2000004. The oracle spells the same choice in
// Builder.sysWrite (pkg/native/program.go:62-67) and getting it wrong is not a
// loud failure -- the syscall would trap.
//
// The Darwin values are written as ARITHMETIC (33554432 + n) rather than as
// hand-converted decimal, because this file has no hex literals and increment
// 151B recorded exactly that failure: hand-converting 0x0F produced 21 (0x15)
// and the emitted output was not x86 at all. Writing 33554432 + 4 keeps the
// relationship to the 0x2000000 prefix visible, so a wrong constant has to be
// wrong in a way a reader can spot, and the gate asserts the decimal values
// independently.
func natSysWrite(isMac) {
    if (isMac) { return 33554432 + 4 }
    return 1
}

// natSysExit is the exit syscall number for the target OS: Linux __NR_exit is
// 60, Darwin's is 0x2000001 = 0x2000000 + 1. Mirrors Builder.sysExit
// (program.go:70-75). Same arithmetic-not-literal rule as natSysWrite.
func natSysExit(isMac) {
    if (isMac) { return 33554432 + 1 }
    return 60
}

// natRodataRef emits `mov r64, <absolute rodata address>` as a placeholder plus
// a recorded patch position, mirroring rodataRef's imm64Patch+internRodata.
//
// The bytes here are therefore NOT the oracle's final bytes -- the oracle
// resolves the placeholder to a real rodata address at link time, and so does
// this. The differential that matters for this slice is over the instruction
// SEQUENCES, and natPrintIntCorpus arm 2 exists to pin the placeholder form
// itself so it cannot be quietly changed into something that resolves locally.
func natRodataRef(s, r) {
    let p = natImm64Patch(s, natMovImm64Op(r))
    return p[0]
}

// natWriteStdout emits the Linux payload write for (RDI=fd, RSI=ptr, RDX=len)
// through the raw syscall, mirroring emitWrite's non-Windows body.
//
// Raw emitter calls on purpose, exactly as the oracle's own body insists:
// emitWrite is what Step 4 called natSyscall, and routing the syscall back
// through a helper that is itself named write is how the 148C replaceAll once
// produced infinite self-recursion.
func natWriteStdout(s) {
    let isMac = 0
    if (natStTargetOS(s) == natOSMac()) { isMac = 1 }
    s = natMovRegImm32(s, natRegRAX(), natSysWrite(isMac))
    return natSyscall(s)
}

// natPrintNewline mirrors printNewline: a one-byte rodata reference plus the
// payload write. RDI is still 1 from the preceding payload write.
func natPrintNewline(s) {
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    return natWriteStdout(s)
}

// natPayloadWrite emits the stdout payload write for the current OS.
//
// Step 9b's reason this exists: print_int is the FIRST helper with real output,
// and it wrote through the LINUX `write` syscall unconditionally. That is the
// oracle's emitWrite NON-WINDOWS body; the oracle's emitWrite switches on b.goos
// and dispatches to emitWinWrite, which kcc had never ported. So a PE image
// built from the existing print_int would execute a Linux `syscall` instruction
// on Windows and fault on the first digit -- which is exactly why every earlier
// PE gate deliberately built images that do NOT print.
//
// `winWrite` is 1 for Windows and 0 for Linux/ELF. The parameter is a number
// rather than a boolean because this language has no other way to select a
// function, and a literal 0/1 keeps the call sites self-documenting.
func natPayloadWrite(s, winWrite) {
    if (winWrite == 1) { return natWinWrite(s) }
    return natWriteStdout(s)
}

// natPrintNewlineOff is natPrintNewline with the rodata OFFSET recorded, so a
// real program can resolve the newline address against its own rodata section.
// The Step 7 corpus calls the byte-identical natPrintNewline, which records
// nothing, and that separation is deliberate.
func natPrintNewlineOff(s, winWrite, offNewline) {
    s = natRodataRefOff(s, natRegRSI(), offNewline)
    s = natMovRegImm32(s, natRegRDX(), 1)
    return natPayloadWrite(s, winWrite)
}

// natPrintIntBody is the SHARED print_int body, and it is the whole of Step 9b's
// first half: one body that can be emitted into a caller-owned emitter state, so
// print_int's rodata references land in the SAME state as the program's own and
// can therefore be resolved.
//
// Contract: RDI carries the value, output is decimal text plus a newline on
// stdout. The 64 bytes reserved below RSP are the digit buffer; the pointer
// starts at the TOP of that buffer and walks down, which is why no count is
// needed up front.
//
// `offMinus`/`offNewline` are offsets into the caller's rodata section. They are
// passed in rather than interned here because interning is a property of the
// WHOLE program: Step 9a established that the oracle's internRodata deduplicates
// by FIRST USE across every reference in the program, so a helper that invented
// its own offsets would be guessing at where its strings landed.
//
// Recording an offset does not change a byte -- natRodataRefOff and natRodataRef
// differ only in the two recorded lists -- which is why the frozen Step 7 corpus
// can move onto this body without its bytes moving.
func natPrintIntBody(s, winWrite, offMinus, offNewline) {
    s = natMark(s, "print_int")
    s = natSubRegImm32(s, natRegRSP(), 64)
    s = natMovRegReg(s, natRegRAX(), natRegRDI())
    s = natMovRegReg(s, natRegRSI(), natRegRSP())
    s = natAddRegImm32(s, natRegRSI(), 64)
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJns(s, "print_int_pos")
    s = natNegReg(s, natRegRAX())
    // RSI (the digit pointer) and RAX (the magnitude) are pushed across the sign
    // write, because the write clobbers volatile registers and both are needed by
    // the digit loop below.
    s = natPushReg(s, natRegRAX())
    s = natPushReg(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natRodataRefOff(s, natRegRSI(), offMinus)
    s = natPayloadWrite(s, winWrite)
    s = natPopReg(s, natRegRSI())
    s = natPopReg(s, natRegRAX())
    s = natMark(s, "print_int_pos")
    s = natMovRegImm32(s, natRegRCX(), 10)
    s = natMark(s, "print_int_loop")
    s = natCqo(s)
    s = natDivReg(s, natRegRCX())
    s = natAddRegImm32(s, natRegRDX(), 48)   // 48 is '0'
    s = natDecReg(s, natRegRSI())
    s = natStoreMem8(s, natRegRSI(), natRegRDX())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "print_int_loop")
    s = natMovRegReg(s, natRegRBX(), natRegRSP())
    s = natAddRegImm32(s, natRegRBX(), 64)
    s = natMovRegReg(s, natRegRDX(), natRegRBX())
    s = natSubRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natPayloadWrite(s, winWrite)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natPrintNewlineOff(s, winWrite, offNewline)
    return natRet(s)
}

// natPrintIntHelper is the FROZEN Step 7 entry point, now a wrapper over
// natPrintIntBody with the Linux write and the two rodata offsets the Step 7
// corpus implies.
//
// WHY IT STAYS, rather than being replaced: Step 7's gate compares these bytes
// against the oracle's print_int, and that corpus is the evidence that the digit
// loop is correct. Removing the corpus's only caller would leave the body
// reachable only from the new program path, and a differential that exists only
// on the path under test is a weaker differential than one that also runs
// unchanged.
//
// The offsets are 0 and 1 -- "-" first, then "\n" -- which is first-use interning
// order. They are recorded but never resolved here, so natPrintCorpus arm 2 still
// pins the UNRESOLVED placeholder shape independently of this helper.
//
// It returns the STATE, not finished bytes: natPrintCorpus calls natFinish on it,
// which is where label resolution belongs. An earlier draft returned the finished
// bytes from here as well, so natFinish ran twice -- the second pass read a byte
// array as an emitter state, every corpus arm printed empty, and arm 0 came back
// as the 28-byte digit loop under the wrong index.
func natPrintIntHelper() {
    return natPrintIntBody(natNewEmitter(0), 0, 0, 1)
}

// natPrintCorpus renders the print_int helper in three shapes.
//
// Arm 0 is the whole helper with its two internal rel32 fixups resolved, which
// is the differential against the Go oracle. Arms 1 and 2 isolate the pieces a
// whole-helper comparison cannot blame on the right instruction when it fails:
// arm 1 is the digit loop alone (so a wrong divide or a missing sign extension
// fails there rather than somewhere inside 40 instructions), and arm 2 is a
// bare rodata reference (so the unresolved placeholder shape is pinned on its
// own, independently of the helper that uses it).
func natPrintCorpus(which) {
    if (which == 0) {
        return natToHex(natFinish(natPrintIntHelper()))
    }
    if (which == 1) {
        let s = natNewEmitter(0)
        s = natMark(s, "print_int_pos")
        s = natMovRegImm32(s, natRegRCX(), 10)
        s = natMark(s, "print_int_loop")
        s = natCqo(s)
        s = natDivReg(s, natRegRCX())
        s = natAddRegImm32(s, natRegRDX(), 48)
        s = natDecReg(s, natRegRSI())
        s = natStoreMem8(s, natRegRSI(), natRegRDX())
        s = natTestRegReg(s, natRegRAX(), natRegRAX())
        s = natJnz(s, "print_int_loop")
        return natToHex(natFinish(s))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
        s = natRodataRef(s, natRegRSI())
        return natToHex(natFinish(s))
    }
    return ""
}

// The three kernel32 IAT slots the bootstrap publishes, mirroring the constants
// in pkg/native/pe.go. Declared on both sides so a renumber on one side cannot
// silently disagree with the other.
func natIatExitProcess()  { return 0 }
func natIatGetStdHandle() { return 1 }
func natIatWriteFile()    { return 2 }

// ============================================================
// 6. Integer statement and expression lowering (Step 2)
//
// Every sequence below is the Go oracle's, in the oracle's order, and the gate
// compares the finished bytes against pkg/native. Each reference program's
// SHAPE is compiled in rather than parsed -- the convention 151B/151C/151C2/
// 151C3/Step 1 already use -- because no AST-driven native driver exists yet.
// That boundary is real and is not papered over: what is proven here is that
// these lowering SEQUENCES match the oracle byte for byte, not that kcc can
// yet parse a source file and lower it.
//
// The oracle's surface, and this file's, is deliberately NARROWER than the
// language, and the narrowing is preserved rather than "fixed":
//
//   * Integer arithmetic is +, - and * ONLY. The oracle's emitBinary refuses
//     every other operator, `/` included, with a loud K145. That refusal is
//     reproduced verbatim below rather than quietly implemented, because
//     implementing division here would be a NEW capability and not a port.
//   * A comparison is a BRANCH, not a value. emitCond sets flags and jumps on
//     the INVERSE condition; it never leaves a boolean in RAX. There is
//     therefore no boolean value to materialise on the native path, and
//     inventing one would also be a new capability.
//
// Operand staging is the Phase-147 rule: the LEFT operand goes to the
// depth-indexed scratch slot, the right into RAX and then RCX, the left is
// reloaded into RAX, and the operation is applied. rsp never moves.
// ============================================================

// natIntRefusal reproduces the oracle's refusals for integer operators it does
// not lower. These are DATA on the measurement surface rather than build
// failures, so the gate can assert kcc refuses exactly what the oracle does.
func natIntRefusal(which) {
    if (which == 0) { return "error[K145]: unsupported operator '/' (want +, - or *)" }
    if (which == 1) { return "error[K145]: unsupported operator '%' (want +, - or *)" }
    if (which == 2) { return "error[K145]: condition must be a comparison (==, !=, <, <=, >, >=) over ints or floats" }
    if (which == 3) { return "error[K145]: expression nesting exceeds 64 binary levels" }
    // Step 2b: the `?` propagation operator is REFUSED by the oracle, not
    // lowered. `?` desugars to *parser.PropagateExpr and there is no
    // PropagateExpr case anywhere in pkg/native -- the native value model has
    // no Result/Option representation, so there is nothing to propagate to.
    // Implementing it here would be a NEW capability, not a port, so it stays
    // a refusal.
    //
    // The two messages DIFFER, and the difference is load-bearing rather than
    // cosmetic: a `?` in RETURN position is refused by retKindOfExpr during
    // kind inference, which runs before emitExpr, so it never reaches the
    // emission site's own wording.
    if (which == 4) { return "error[K145]: unsupported expression *parser.PropagateExpr" }
if (which == 5) { return "error[K145]: unsupported return expression *parser.PropagateExpr" }
  // Step 9g: a concatenation operand that is ITSELF a concatenation.
  //
  // natEmitStrValue handles a literal, then ASSUMES everything else is an
  // identifier -- so `a + b + "ef"` parsed its left operand `(a + b)` as an
  // identifier, called identName on a BinaryExpr, and indexed the slot plan with
  // the garbage. Both `print(a + b + "ef")` and `return a + "cd"` died with
  // "array index out of range" in natNativeSlotOff.
  //
  // Refusing BY NAME is the honest boundary for this slice. Recursing would need
  // depth threaded through natEmitStrValue and a strTemp sized for the deepest
  // chain, and the arena bound would then have to be re-proved per nesting level
  // rather than per site. That is its own slice; what must not happen is a
  // SHAPE REACHING EMISSION UNCHECKED, which is what produced the crash.
  if (which == 6) { return "error[K145]: chained string concatenation is not lowered (a concatenation operand may not itself be a concatenation)" }
  return ""
}

// natIntBody emits the straight-line integer reference programs. The shape
// selector picks the program because the oracle's statement order is only
// correct for a known shape; nLocals sizes the frame exactly as the oracle's
// layout would.
//
// Prologue and epilogue are emitFunc: Mark(name), SubRsp(frame), body,
// XorRegReg(RAX) when no return was seen, Mark(name+"$ret"), AddRsp(frame),
// Ret(). The 150C callee-saved push/pop is emitted only for a function the
// register allocator claimed; no reference program here qualifies, so it is
// absent from BOTH sides -- a boundary, not an omission.
func natIntBody(shape, nLocals) {
    let f = natFrameLayout(8 * nLocals * natKindUnits(natKindInt()), 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]

    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), frame)
    let returned = 0

    // shape 0: let x = 42 ; return x   -- literal, store, load, return
    if (shape == 0) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 42)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 1: let a = 6 ; let b = 7 ; return a * b
    if (shape == 1) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 6)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 7)
        s = natStoreStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natLoadStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natMulRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 2: return -(3 + 4)   -- unary minus over a binary, so the nested
    // operand lands at depth 1 and gets its OWN scratch slot
    if (shape == 2) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natNegReg(s, natRegRAX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 3: return (2 + 3) * (10 - 4)   -- two nested binaries, depth 0 and 1
    if (shape == 3) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
        s = natStoreStack(s, natRegRAX(), bt + 1 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 1 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 10)
        s = natStoreStack(s, natRegRAX(), bt + 1 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 1 * 8)
        s = natSubRegReg(s, natRegRAX(), natRegRCX())
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natMulRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 4: a function body with NO return statement at all. The oracle's
    // `if !returned { XorRegReg(RAX) }` supplies the 0, and the same single
    // xor is what an explicit bare `return` produces (emitReturn's
    // `n.Value == nil` branch), so this one case covers both spellings.
    if (shape == 4) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        returned = 0
    }

    // shape 5: let x = 1 ; x = 2 ; return x   -- Step 2b. A bare assignment
    // to an EXISTING int local takes exactly the same lowering path as the
    // `let` that bound it: emitExprStmt evaluates the right side into RAX and
    // stores to the slot that is already there, so the frame is UNCHANGED at
    // one local. That "unchanged" is the property worth pinning -- a
    // reassignment allocates nothing -- and the gate's frame layer checks it.
    if (shape == 5) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 6: let x = 3 ; x = 4 ; return x + 1  -- Step 2b. A REASSIGNED local
    // read as a binary operand goes through the ordinary depth-indexed staging
    // path (shape 1), which is the point: being reassigned earlier must not put
    // the local on any different lowering than a freshly bound one.
    if (shape == 6) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }

    if (returned == 0) { s = natXorRegReg(s, natRegRAX()) }
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natIntExprCorpus renders the straight-line integer programs as hex.
func natIntExprCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natIntBody(0, 1))) }
    if (which == 1) { return natToHex(natFinish(natIntBody(1, 2))) }
    if (which == 2) { return natToHex(natFinish(natIntBody(2, 0))) }
    if (which == 3) { return natToHex(natFinish(natIntBody(3, 0))) }
    if (which == 4) { return natToHex(natFinish(natIntBody(4, 1))) }
    // Step 2b: the bare-assignment shapes. Both have one local, and the frame
    // layer independently recomputes that, so an accidental extra local would
    // show up as a frame mismatch rather than as plausible-looking bytes.
    if (which == 5) { return natToHex(natFinish(natIntBody(5, 1))) }
    if (which == 6) { return natToHex(natFinish(natIntBody(6, 1))) }
    return ""
}

// natIntCond emits a comparison in the oracle's emitCond shape: evaluate the
// left into the scratch slot, the right into RAX and then RCX, the left back
// into RAX, CmpRegReg, then jump to the false label on the INVERSE condition.
//
// The jump opcode is the oracle's mapping, verbatim:
//
//	==  jumps on Jnz (not equal)      !=  jumps on Jz  (equal)
//	<   jumps on Jge                  <=  jumps on Jg
//	>   jumps on Jle                  >=  jumps on Jl
//
// The scratch slot is passed in rather than recomputed, so this composes with
// whichever frame the enclosing function has.
func natIntCond(s, op, falseLabel, bt) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 5)
    s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 9)
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    if (op == 0) { return natJnz(s, falseLabel) }
    if (op == 1) { return natJz(s, falseLabel) }
    if (op == 2) { return natJge(s, falseLabel) }
    if (op == 3) { return natJg(s, falseLabel) }
    if (op == 4) { return natJle(s, falseLabel) }
    if (op == 5) { return natJl(s, falseLabel) }
    return s
}

// natIntIf emits an `if` with no else branch, in the oracle's emitIf order.
//
// The label NAMES and their order are part of the bytes, because a rel32
// displacement encodes the distance between the jump and its target, and
// because a rel32 is patched at Finish(). The oracle's fresh() allocates the
// ELSE label FIRST and the END label second, so ifelse$1 precedes ifend$2
// even though the jump to ifelse$1 appears before the jump to ifend$2. That
// counter order is reproduced here, not tidied.
func natIntIf(op) {
    let f = natFrameLayout(8, 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natIntCond(s, op, "ifelse$1", bt)
    // consequence: let x = 1
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    s = natJmp(s, "ifend$2")
    s = natMark(s, "ifelse$1")
    // alternative: let x = 2
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    s = natMark(s, "ifend$2")
    s = natXorRegReg(s, natRegRAX())
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natIntIfCorpus renders the six comparison operators. One program per
// operator, because the opcode is the only thing that varies and a single
// case would not prove the mapping.
func natIntIfCorpus(op) {
    return natToHex(natFinish(natIntIf(op)))
}

// ============================================================
// 7. Control-flow lowering: while / for / break / continue (Step 3)
// ============================================================
//
// The oracle's structure, reproduced from pkg/native:
//
//   emitWhile (program.go:3720)
//     loopLabel = fresh("while"); endLabel = fresh("whileend")
//     Mark(loopLabel); push loops{brk:endLabel, cont:loopLabel}
//     emitCond(cond, endLabel); body; pop
//     Jmp(loopLabel); Mark(endLabel)
//
//   emitFor (program.go:3742)
//     init (inline, BEFORE any label)
//     loopLabel = fresh("for"); postLabel = fresh("forpost"); endLabel = fresh("forend")
//     Mark(loopLabel); push loops{brk:endLabel, cont:POSTLabel}
//     cond (if present); body
//     Mark(postLabel); post; pop
//     Jmp(loopLabel); Mark(endLabel)
//
//   break    -> Jmp(loops[top].brk)   (program.go:3403)
//   continue -> Jmp(loops[top].cont)   (program.go:3409)
//
// Four facts the MEASURED label table settled, each recorded because it is
// easy to get wrong and each verified against the oracle rather than assumed:
//
//  1. `fresh()` is ONE counter shared by every prefix, and it is incremented
//     where the construct is ENTERED, not where it is emitted. So a nested
//     loop numbers $3/$4 while its parent keeps $1/$2, and the parent's end
//     label -- emitted last -- is still the LOWER number.
//     Measured: nested_while has while$1=214, while$3=265, whileend$4=379,
//     whileend$2=418.
//  2. `for` allocates THREE labels in the order for, forpost, forend, so the
//     POST label is $2 and the END label is $3. Reading it as
//     for/forend/forpost renumbers every jump in the program.
//  3. `break` targets the loop's END label; `continue` targets the loop's
//     continuation label, which is the HEAD for `while` and the POST label
//     for a C-style `for`. That asymmetry is the oracle's (loops[] carries
//     cont:postLabel for `for`, program.go:3752) and is why a `continue` in a
//     `for` still runs the post clause.
//  4. An `if` inside a loop allocates BOTH of its labels even with no else
//     branch, and with an empty consequence they land on the SAME offset.
//     Measured: while_break has ifelse$3 == ifend$4 == 315.
//
// Operand lowering is UNCHANGED from Step 2: the left operand is staged in the
// depth-indexed scratch slot, the right is evaluated into RAX and moved to
// RCX, the left is reloaded, and the operation is applied. A loop changes
// nothing about that, because the scratch slot is written before it is read on
// every iteration. rsp never moves.
//
// emitCond passes depth 1 to emitExpr for its operands but stores the staged
// left operand at b.binTemp (the region START, depth 0), which is why the
// condition and a depth-0 body expression share the same scratch slot.

// natLoopOpAdd is the only binary operator the reference programs use in a
// loop body. It reuses natAddRegReg, the Step 2 primitive.
func natLoopOpAdd() { return 0 }

// natLoopStageLocal parks the LEFT operand of a comparison or an assignment:
// read the local, store it into the depth-indexed scratch slot.
func natLoopStageLocal(s, slot, bt, depth) {
    s = natLoadStack(s, natRegRAX(), slot)
    s = natStoreStack(s, natRegRAX(), bt + depth * 8)
    return s
}

// natLoopStageLit parks a LITERAL left operand by the same two instructions,
// so a condition over two constants has the same shape as one over a local.
func natLoopStageLit(s, v, bt, depth) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), v)
    s = natStoreStack(s, natRegRAX(), bt + depth * 8)
    return s
}

// natLoopLit emits a literal into RAX. Used as a RIGHT operand, which is
// never staged: it goes straight to RAX and then to RCX.
func natLoopLit(s, v) {
    return natMovImm64(s, natMovImm64Op(natRegRAX()), v)
}

// natLoopLoad emits an identifier read into RAX. Used as a RIGHT operand.
func natLoopLoad(s, slot) {
    return natLoadStack(s, natRegRAX(), slot)
}

// natLoopFinishCmp completes `staged <cmp> rightInRax` and branches to
// falseLabel on the INVERSE condition, exactly as natIntCond does. The cmp
// MUST precede the branch: a branch ahead of its cmp is a correct-looking
// sequence testing stale flags.
func natLoopFinishCmp(s, op, falseLabel, bt, depth) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + depth * 8)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    if (op == 0) { return natJnz(s, falseLabel) }
    if (op == 1) { return natJz(s, falseLabel) }
    if (op == 2) { return natJge(s, falseLabel) }
    if (op == 3) { return natJg(s, falseLabel) }
    if (op == 4) { return natJle(s, falseLabel) }
    if (op == 5) { return natJl(s, falseLabel) }
    return s
}


// natLoopFinishAdd completes `staged + rightInRax`, the Step 2 binary shape.
func natLoopFinishAdd(s, bt, depth) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + depth * 8)
    return natAddRegReg(s, natRegRAX(), natRegRCX())
}

// natLoopCondLocal emits `local <op> literal`, the condition shape every
// reference loop uses. The false label is the loop's END label, because that
// is what the oracle passes to emitCond.
func natLoopCondLocal(s, op, falseLabel, bt, slot, lit) {
    s = natLoopStageLocal(s, slot, bt, 0)
    s = natLoopLit(s, lit)
    return natLoopFinishCmp(s, op, falseLabel, bt, 0)
}

// natLoopAssignAddLit emits `slot = src + lit`, the reassignment shape Step 2b
// established: evaluate the right side into RAX, then store to the slot that
// already exists. The frame does not change.
func natLoopAssignAddLit(s, bt, slot, srcSlot, lit) {
    s = natLoopStageLocal(s, srcSlot, bt, 0)
    s = natLoopLit(s, lit)
    s = natLoopFinishAdd(s, bt, 0)
    s = natStoreStack(s, natRegRAX(), slot)
    return s
}

// natLoopAssignAddLocal emits `dst = src + other`, where the right operand is
// a local rather than a literal. Same staging, different right-operand source.
func natLoopAssignAddLocal(s, bt, dst, src, other) {
    s = natLoopStageLocal(s, src, bt, 0)
    s = natLoopLoad(s, other)
    s = natLoopFinishAdd(s, bt, 0)
    s = natStoreStack(s, natRegRAX(), dst)
    return s
}

// natLoopLet emits `let slot = v`.
func natLoopLet(s, slot, v) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), v)
    s = natStoreStack(s, natRegRAX(), slot)
    return s
}

// natLoopEpilogue closes a reference program: the `return slot` read, the jmp
// to the $ret label the oracle emits after EVERY return, the $ret mark, and
// the frame teardown. Every reference program here returns explicitly, so the
// `if !returned` xor of Step 2 does not apply.
func natLoopEpilogue(s, frame, retSlot) {
    s = natLoadStack(s, natRegRAX(), retSlot)
    s = natJmp(s, "karkain_main$ret")
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natLoopFrame computes the reference frame for a function with nLocals int
// locals: locals, binTemp, no strTemp, no mapStage, no extras, Linux (no
// 16-byte rounding), plus the fixed arg spill.
func natLoopFrame(nLocals) {
    let f = natFrameLayout(8 * nLocals * natKindUnits(natKindInt()), 0, 0, 0, 0, 0)
    return f
}

// natLoopPrologue emits Mark(karkain_main) + SubRsp(frame).
func natLoopPrologue(nLocals) {
    let f = natLoopFrame(nLocals)
    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), f[natFrFrame()])
    return s
}


// ------------------------------------------------------------
// The ten reference programs, in the corpus order the gate uses.
//
// Slot assignment is the oracle's: locals are numbered in DECLARATION order,
// so in `let i = 0 ; let s = 0` i is slot 0 and s is slot 1. The `for` init's
// `let i` is declared AFTER `let s`, which is why for_full has s at slot 0.
// ------------------------------------------------------------

// natLoopWhileSimple: let i = 0 ; while i < 5 { i = i + 1 } ; return i
// Measured: frame 616 (1 local), while$1=199, whileend$2=274, $ret=283.
func natLoopWhileSimple() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 5)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopWhileArith: let i = 0 ; let s = 0 ;
//   while i < 5 { s = s + i ; i = i + 1 } ; return s
// Measured: frame 624 (2 locals), while$1=214, whileend$2=319, $ret=329.
func natLoopWhileArith() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, s0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 5)
    // s = s + i : the RIGHT operand is a local here, not a literal
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, s0)
}

// natLoopWhileBreak: let i = 0 ; while i < 10 { i = i + 1 ; if i == 5 { break } }
//   ; return i
// Measured: frame 616 (1 local), while$1=199, whileend$2=320,
//           ifelse$3=315, ifend$4=315, $ret=329.
//
// The break jumps to whileend$2 -- the loop's END label, not the head. The
// `if` allocates ifelse$3 and ifend$4 AFTER the while's own two labels,
// because the shared counter is incremented at loop ENTRY.
func natLoopWhileBreak() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 10)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    // if i == 5 { break }
    s = natLoopCondLocal(s, 0, "ifelse$3", bt, i0, 5)
    s = natJmp(s, "whileend$2")
    // emitIf's own unconditional jump to the end label, BEFORE Mark(ifelse$3).
    // It is 5 bytes and it is easy to miss: the `if` has no else branch, so the
    // next two marks land on the SAME offset and the jump reads like a no-op.
    s = natJmp(s, "ifend$4")
    s = natMark(s, "ifelse$3")
    s = natMark(s, "ifend$4")
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopWhileContinue: let i = 0 ; let s = 0 ;
//   while i < 6 { i = i + 1 ; if i == 3 { continue } ; s = s + i } ; return s
// Measured: frame 624 (2 locals), while$1=214, whileend$2=365,
//           ifelse$3=330, ifend$4=330, $ret=375.
//
// The continue jumps back to while$1 -- the loop HEAD. Continuing to the end
// label would exit the loop, so the two targets are not interchangeable.
func natLoopWhileContinue() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, s0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 6)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    // if i == 3 { continue }
    s = natLoopCondLocal(s, 0, "ifelse$3", bt, i0, 3)
    s = natJmp(s, "while$1")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$4")
    s = natMark(s, "ifelse$3")
    s = natMark(s, "ifend$4")
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, s0)
}


// natLoopForSimple: let i = 0 ; for (i = 0; i < 5; i = i + 1) { } ; return i
// Measured: frame 616 (1 local), for$1=213, forpost$2=249, forend$3=288, $ret=297.
//
// The init clause is emitted BEFORE for$1 is marked. It is a bare assignment to
// an already-bound local, so it lowers exactly like Step 2b shape 5 and the
// frame does NOT grow.
func natLoopForSimple() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    // for init: i = 0
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 5)
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopForFull: let s = 0 ; for (let i = 0; i < 5; i = i + 1) { s = s + i }
//   ; return s
// Measured: frame 624 (2 locals), for$1=214, forpost$2=280, forend$3=321, $ret=330.
//
// s is slot 0 and i is slot 1, because `let s` is declared first and the
// for-init's `let i` second.
func natLoopForFull() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, s0, 0)
    // for init: let i = 0
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 5)
    // body: s = s + i
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    // forpost$2: the post clause, AFTER the body
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, s0)
}

// natLoopForBreak: let i = 0 ; for (i = 0; i < 10; i = i + 1) { if i == 5 { break } }
//   ; return i
// Measured: frame 616 (1 local), for$1=213, forpost$2=295, forend$3=334,
//           ifelse$4=295, ifend$5=295, $ret=343.
//
// The break targets forend$3. Note ifelse$4 / ifend$5 / forpost$2 all share
// offset 295: the if's consequence is a single break, the alternative is empty,
// and the post label immediately follows the body.
func natLoopForBreak() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 10)
    // if i == 5 { break }
    s = natLoopCondLocal(s, 0, "ifelse$4", bt, i0, 5)
    s = natJmp(s, "forend$3")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$5")
    s = natMark(s, "ifelse$4")
    s = natMark(s, "ifend$5")
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopForContinue: let s = 0 ; for (let i = 0; i < 6; i = i + 1) {
//   if i == 3 { continue } ; s = s + i } ; return s
// Measured: frame 624 (2 locals), for$1=214, forpost$2=327, forend$3=368,
//           ifelse$4=298, ifend$5=298, $ret=377.
//
// THE ASYMMETRY CASE: here `continue` targets forpost$2, NOT for$1, because
// a C-style for's continuation label is its post clause (program.go:3752
// pushes loopTgt{brk: endLabel, cont: postLabel}). Jumping to the head would
// skip the increment and loop forever.
func natLoopForContinue() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, s0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 6)
    // if i == 3 { continue }
    s = natLoopCondLocal(s, 0, "ifelse$4", bt, i0, 3)
    s = natJmp(s, "forpost$2")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$5")
    s = natMark(s, "ifelse$4")
    s = natMark(s, "ifend$5")
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, s0)
}


// natLoopNestedWhile: let i = 0 ; let t = 0 ;
//   while i < 3 { let j = 0 ; while j < 2 { t = t + 1 ; j = j + 1 } ; i = i + 1 }
//   ; return t
// Measured: frame 632 (3 locals), while$1=214, while$3=265,
//           whileend$4=379, whileend$2=418, $ret=428.
//
// THREE locals (i, t, j) -- the inner `let j` is declared inside the outer
// body but still occupies a frame slot. The OUTER end label is $2 even though
// it is marked last, because fresh() allocated it when the outer loop was
// entered. Nesting is what proves the counter is shared, not per-prefix.
func natLoopNestedWhile() {
    let f = natLoopFrame(3)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let t0 = natLocalOff(1, natKindInt())
    let j0 = natLocalOff(2, natKindInt())
    let s = natLoopPrologue(3)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, t0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 3)
    // outer body prologue: let j = 0
    s = natLoopLet(s, j0, 0)
    s = natMark(s, "while$3")
    s = natLoopCondLocal(s, 2, "whileend$4", bt, j0, 2)
    s = natLoopAssignAddLit(s, bt, t0, t0, 1)
    s = natLoopAssignAddLit(s, bt, j0, j0, 1)
    s = natJmp(s, "while$3")
    s = natMark(s, "whileend$4")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, t0)
}

// natLoopNestedForWhile: let t = 0 ; for (let i = 0; i < 2; i = i + 1) {
//   let j = 0 ; while j < 2 { t = t + 1 ; j = j + 1 } } ; return t
// Measured: frame 632 (3 locals), for$1=214, forpost$2=378, forend$3=419,
//           while$4=266, whileend$5=378, $ret=428.
//
// A `for` OUTER and a `while` INNER, which is the case that pins BOTH shared-
// counter rules at once: the for takes $1/$2/$3 and the while, entered later,
// continues the same counter at $4/$5 rather than restarting.
func natLoopNestedForWhile() {
    let f = natLoopFrame(3)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let t0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let j0 = natLocalOff(2, natKindInt())
    let s = natLoopPrologue(3)
    s = natLoopLet(s, t0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 2)
    s = natLoopLet(s, j0, 0)
    s = natMark(s, "while$4")
    s = natLoopCondLocal(s, 2, "whileend$5", bt, j0, 2)
    s = natLoopAssignAddLit(s, bt, t0, t0, 1)
    s = natLoopAssignAddLit(s, bt, j0, j0, 1)
    s = natJmp(s, "while$4")
    s = natMark(s, "whileend$5")
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, t0)
}

// natLoopLabels reports the label NAMES each reference program uses, in
// allocation order, so the gate can pin the fresh() numbering as DATA.
//
// A rel32 encodes only a displacement, so a renumbered label can produce a
// byte stream that is coincidentally equal -- the displacement might come out
// the same. The names are the layer that catches that, and they are why this
// surface reports labels separately from code.
func natLoopLabels(which) {
    if (which == 0) { return "while$1 whileend$2" }
    if (which == 1) { return "while$1 whileend$2" }
    if (which == 2) { return "while$1 whileend$2 ifelse$3 ifend$4" }
    if (which == 3) { return "while$1 whileend$2 ifelse$3 ifend$4" }
    if (which == 4) { return "for$1 forpost$2 forend$3" }
    if (which == 5) { return "for$1 forpost$2 forend$3" }
    if (which == 6) { return "for$1 forpost$2 forend$3 ifelse$4 ifend$5" }
    if (which == 7) { return "for$1 forpost$2 forend$3 ifelse$4 ifend$5" }
    if (which == 8) { return "while$1 whileend$2 while$3 whileend$4" }
    if (which == 9) { return "for$1 forpost$2 forend$3 while$4 whileend$5" }
    return ""
}

// natLoopCorpus renders the ten control-flow reference programs as hex, in the
// same order the gate and the label corpus use.
func natLoopCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natLoopWhileSimple())) }
    if (which == 1) { return natToHex(natFinish(natLoopWhileArith())) }
    if (which == 2) { return natToHex(natFinish(natLoopWhileBreak())) }
    if (which == 3) { return natToHex(natFinish(natLoopWhileContinue())) }
    if (which == 4) { return natToHex(natFinish(natLoopForSimple())) }
    if (which == 5) { return natToHex(natFinish(natLoopForFull())) }
    if (which == 6) { return natToHex(natFinish(natLoopForBreak())) }
    if (which == 7) { return natToHex(natFinish(natLoopForContinue())) }
    if (which == 8) { return natToHex(natFinish(natLoopNestedWhile())) }
    if (which == 9) { return natToHex(natFinish(natLoopNestedForWhile())) }
    return ""
}

// ============================================================
// 7. The `_start` entry stub and the Linux exit tail
//
// The Go oracle emits `_start` first thing in pkg/native/program.go:
//
//	b.e.Mark("_start")
//	if b.goos == OSWindows { b.e.AndRspNeg16(); b.emitWinBootstrap() }
//	b.e.Call("karkain_main")
//	if b.goos == OSWindows { b.emitWindowsExit() } else {
//	    b.e.MovRegReg(RDI, RAX)
//	    b.e.MovRegImm32(RAX, b.sysExit())
//	    b.e.Syscall()
//	}
//
// This slice is the Linux half ONLY. The Windows alignment fix, the PEB
// bootstrap and the Windows exit tail are deliberately absent, and the macOS
// exit number is absent: each is separately recorded as open 151A work, and
// emitting them here would be inventing scope rather than porting it. The
// corpus therefore cannot be run -- it has no `main` body, no `print` and no
// arena -- and the gate claims BYTES, not execution.
//
// The `karkain_main` label is placed immediately after the tail, so the corpus
// is self-contained: natRel32 must still resolve a real forward reference,
// which is the property 151B introduced it for. The resulting displacement is
// therefore 10 -- offset(karkain_main)=15 minus offset(next instruction)=5 --
// which is a property of this corpus and NOT of a real image, where
// `karkain_main` sits at its own offset. The gate pins that arithmetic
// separately from the instruction bytes for exactly that reason. (This comment
// first said 12; the arithmetic is 15-5. The gate DERIVED 10 from the
// encodings and passed, so the wrong number was here, not there.)
func natStartStub() {
    return natStartStubOS(natOSLinux())
}

// natStartEntryOS emits ONLY the `_start` sequence: mark the entry, call
// karkain_main, move main's return into RDI, load the OS's exit syscall number,
// syscall.
//
// It deliberately does NOT mark `karkain_main`. That is the whole point of
// separating it from natStartStubOS: the oracle emits helpers, then the user
// functions, and only THEN `_start` (pkg/native/program.go:1585-1593), so
// `_start` sits at the END of .text. Marking `karkain_main` from the entry
// sequence would force `_start` to be emitted FIRST, and the two images would
// then carry the same instructions in a different order -- a CONSTANT byte
// delta that was previously mis-attributed to frame padding.
//
// macOS shares this shape with Linux word for word -- the difference is ONLY the
// exit number (0x2000001 vs 60). That is why it is one function with a
// parameter rather than a second entry: a duplicate would be a second place for
// the two entry paths to drift apart.
func natStartEntryOS(s, os) {
    s = natMark(s, "_start")
    s = natCall32(s)
    let r = natRel32(s, "karkain_main")
    s = r[0]
    s = natMovRegReg(s, natRegRDI(), natRegRAX())
    // The exit number follows the OS: 60 is Linux __NR_exit, 0x2000001 Darwin's.
    let isMac = 0
    if (os == natOSMac()) { isMac = 1 }
    s = natMovRegImm32(s, natRegRAX(), natSysExit(isMac))
    return natSyscall(s)
}

// natStartStubOS is the Unix-family entry, self-contained: `_start` immediately
// followed by the `karkain_main` label. It is RETAINED unchanged because the
// frozen 151A Step 4 corpus (natStartCorpus) is gated on its exact bytes and on
// the forward rel32 reference it contains; the whole-program driver uses
// natStartEntryOS instead so `_start` can be emitted last.
func natStartStubOS(os) {
    let s = natNewEmitter(0)
    s = natSetTargetOS(s, os)
    s = natStartEntryOS(s, os)
    s = natMark(s, "karkain_main")
    return s
}

// natStartCorpus renders the `_start` stub, the syscall primitive alone, and
// the exit tail without its call -- three shapes so the gate can separate the
// instruction bytes from the rel32 fixup.
func natStartCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natStartStub())) }
    if (which == 1) {
        let s = natNewEmitter(0)
        return natToHex(natFinish(natSyscall(s)))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
        s = natMark(s, "_start")
        s = natMovRegReg(s, natRegRDI(), natRegRAX())
        s = natMovRegImm32(s, natRegRAX(), 60)
        s = natSyscall(s)
        return natToHex(natFinish(s))
    }
    return ""
}

// ============================================================
// Phase 151A Step 5 -- the Windows entry, the PEB bootstrap and
// the Win64 exit tail.
//
// This is the PE counterpart of natStartStub and the mirror image of
// emitWinBootstrap + emitWindowsExit in pkg/native/program.go, in the oracle order.
// The order is load-bearing:
//
//   1. `and rsp, -16` FIRST -- main frame math and every kernel32 call assume
//      rsp % 16 == 0 at the call.
//   2. The bootstrap, publishing ExitProcess/GetStdHandle/WriteFile into the IAT
//      before main can call any of them.
//   3. The call to karkain_main.
//   4. The Win64 exit tail, passing main return value to ExitProcess.
//
// The host loader maps the image and runs entry but does NOT snap the IAT on
// these minimal images (Phase 149: the slots keep their file contents at run
// time), which is why the bootstrap exists at all. RSP never moves.
// ============================================================

// natWinFoldCmp emits one WCHAR of the "kernel32.dll" comparison: load the
// 16-bit character at character-index k from the BaseDllName buffer, fold it
// to lowercase with 0x20, compare against the expected character, and branch to
// the walk next label on a mismatch.
//
// The fold is not cosmetic. Phase 149 read BaseDllName live from the PEB and it
// arrives UPPERCASE (KERNEL32.DLL), so an unfolded comparison against the
// lowercase spelling would never match and every program would take the Int3.
// Folding is a no-op for the digits and dots in this alphabet, which is why the
// oracle applies it unconditionally instead of branching per character class.
func natWinFoldCmp(s, k, ch) {
    s = natMovzxRegMem16(s, natRegR8(), natRegRDX(), k * 2)
    s = natOrRegImm8(s, natRegR8(), 32)
    s = natCmpRegImm32(s, natRegR8(), ch)
    return natJnz(s, "wk$next")
}

// natWinCmpPair emits one aligned character-pair comparison of an export name,
// branching to nextLbl on a mismatch.
//
// nextLbl is passed in rather than derived from `ch`: the oracle allocates a
// FRESH label set per resolve (b.fresh), so ExitProcess, GetStdHandle and
// WriteFile each own their labels. Reusing one set is not merely untidy -- the
// encoder rejects a duplicate label outright, which is how the gate's first
// draft of the oracle half failed with `duplicate label "exp$loop"`.
//
// An odd-length name's final pair has a ZERO high byte and is COMPARED against
// the string's NUL terminator, not skipped. Dropping it would let the walk match
// a shorter name.
func natWinCmpPair(s, k, ch, nextLbl) {
    s = natMovzxRegMem16(s, natRegR8(), natRegRDX(), k)
    s = natCmpRegImm32(s, natRegR8(), ch)
    return natJnz(s, nextLbl)
}

// natWinResolve emits one export-table walk resolving a kernel32 name, with R10
// holding the module base. It mirrors emitWinResolve exactly.
//
// loopLbl/nextLbl/doneLbl/failLbl are passed in so each of the three resolves
// owns a FRESH set, exactly as the oracle's b.fresh() does. The pair constants
// c0..c5 are the aligned 16-bit character pairs DERIVED FROM THE NAME STRING by
// the caller, not re-typed here: the gate recomputes them independently and a
// mistyped pair would otherwise agree with a second copy of the same typo.
//
// The export directory sits at NT+136 (COFF 24 + Optional 112); the +96 shape
// is the 32-bit header and reads garbage, measured in Phase 149. The resolved
// address moves RDX -> RAX before the store because 48 A3 is accumulator-only.
func natWinResolve(s, c0, c1, c2, c3, c4, c5, loopLbl, nextLbl, doneLbl, failLbl, iatIdx) {
    s = natLoadBaseOff32(s, natRegRCX(), natRegR10(), 60)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 136)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    s = natLoadBaseOff32(s, natRegR9(), natRegRDX(), 24)
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 32)
    s = natMovRegReg(s, natRegRSI(), natRegR10())
    s = natAddRegReg(s, natRegRSI(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 36)
    s = natMovRegReg(s, natRegRDI(), natRegR10())
    s = natAddRegReg(s, natRegRDI(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 28)
    s = natMovRegReg(s, natRegRBP(), natRegR10())
    s = natAddRegReg(s, natRegRBP(), natRegRCX())
    s = natMark(s, loopLbl)
    s = natTestRegReg(s, natRegR9(), natRegR9())
    s = natJz(s, failLbl)
    s = natLoadBaseOff32(s, natRegRCX(), natRegRSI(), 0)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    if (c0 != 0) { s = natWinCmpPair(s, 0, c0, nextLbl) }
    if (c1 != 0) { s = natWinCmpPair(s, 2, c1, nextLbl) }
    if (c2 != 0) { s = natWinCmpPair(s, 4, c2, nextLbl) }
    if (c3 != 0) { s = natWinCmpPair(s, 6, c3, nextLbl) }
    if (c4 != 0) { s = natWinCmpPair(s, 8, c4, nextLbl) }
    if (c5 != 0) { s = natWinCmpPair(s, 10, c5, nextLbl) }
    s = natMovzxRegMem16(s, natRegR8(), natRegRDI(), 0)
    s = natLoadScaled32(s, natRegRAX(), natRegRBP(), natRegR8(), 4, 0)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRAX())
    s = natMovRegReg(s, natRegRAX(), natRegRDX())
    // The absolute pointer to the resolved kernel32 address is a LINK-TIME
    // placeholder, and it is paired with its IAT INDEX here rather than by
    // emission position. Step 9b needed this: once print_int contributes its own
    // IAT references, a positional reader mispairs the bootstrap's stores.
    //
    // Note there is NO `let p = ...; s = p[0]` here. natStoreAbs64 returns
    // [s, pos]; natStoreAbs64Idx returns the state alone. Keeping the old
    // two-line destructuring assigned the CODE ARRAY to s, so every subsequent
    // emitter call operated on the code bytes -- and because natFinish rejected
    // the labels afterwards, the corpus arms printed EMPTY and the failure only
    // surfaced much later inside natPELink as an out-of-range write. The
    // one-line form is the honest one.
    s = natStoreAbs64Idx(s, iatIdx)
    s = natJmp(s, doneLbl)
    s = natMark(s, nextLbl)
    s = natAddRegImm32(s, natRegRSI(), 4)
    s = natAddRegImm32(s, natRegRDI(), 2)
    s = natDecReg(s, natRegR9())
    s = natJmp(s, loopLbl)
    s = natMark(s, failLbl)
    s = natInt3(s)
    s = natMark(s, doneLbl)
    return s
}

// natWinBootstrap emits the loader-independent kernel32 resolution, mirroring
// emitWinBootstrap. R10 keeps the module base across all three resolves.
//
// The module walk matches the NAME "kernel32.dll" and never a position: the
// entry list order is not stable across boots. The 64-entry bound is a backstop,
// not a heuristic. A missing module or an exhausted export walk reaches an Int3.
//
// Pair constants are the aligned 16-bit little-endian character pairs derived
// from each name: name[k] | name[k+1]<<8, with a zero high byte on the tail of an
// odd-length name. "ExitProcess" is 11 characters (6 pairs), "GetStdHandle" is 12
// (6 pairs, NO tail pair) and "WriteFile" is 9 (5 pairs, odd tail).
func natWinBootstrap(s) {
    s = natMovRegGsMem(s, natRegRAX(), 96)
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 24)
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 32)
    s = natMovRegImm32(s, natRegR11(), 64)
    s = natMark(s, "wk$walk")
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 0)
    s = natMovRegReg(s, natRegRBX(), natRegRAX())
    s = natSubRegImm32(s, natRegRBX(), 16)
    // 64-bit LDR_DATA_TABLE_ENTRY: DllBase at +0x30, BaseDllName at +0x58
    // (Length +0, Buffer +8). The 32-bit +0x28/+0x50 shape skips every module
    // into the Int3 -- measured in Phase 149.
    s = natMovzxRegMem16(s, natRegRCX(), natRegRBX(), 88)
    s = natCmpRegImm32(s, natRegRCX(), 24)
    s = natJnz(s, "wk$next")
    s = natLoadBaseOff(s, natRegRDX(), natRegRBX(), 96)
    s = natWinFoldCmp(s, 0, 107)
    s = natWinFoldCmp(s, 1, 101)
    s = natWinFoldCmp(s, 2, 114)
    s = natWinFoldCmp(s, 3, 110)
    s = natWinFoldCmp(s, 4, 101)
    s = natWinFoldCmp(s, 5, 108)
    s = natWinFoldCmp(s, 6, 51)
    s = natWinFoldCmp(s, 7, 50)
    s = natWinFoldCmp(s, 8, 46)
    s = natWinFoldCmp(s, 9, 100)
    s = natWinFoldCmp(s, 10, 108)
    s = natWinFoldCmp(s, 11, 108)
    s = natLoadBaseOff(s, natRegR10(), natRegRBX(), 48)
    s = natJmp(s, "wk$found")
    s = natMark(s, "wk$next")
    s = natDecReg(s, natRegR11())
    s = natJnz(s, "wk$walk")
    s = natMark(s, "wk$fail")
    s = natInt3(s)
    s = natMark(s, "wk$found")
    // "ExitProcess": E|x=0x7845 i|t=0x7469 P|r=0x7250 o|c=0x636F e|s=0x7365 s|\0=0x73
    s = natWinResolve(s, 30789, 29801, 29264, 25455, 29541, 115, "wx$loop$0", "wx$next$0", "wx$done$0", "wx$fail$0", 0)
    // "GetStdHandle": G|e=0x6547 t|S=0x5374 t|d=0x6474 H|a=0x6148 n|d=0x646E l|e=0x656C
    // The H|a pair was FIRST written as 24896 = 0x6140, whose low byte is '@',
    // not 'H'. The oracle comparison caught it as a single differing byte in a
    // 982-byte shape -- the same one-digit class 152-B2 hit on a SHA-256 round
    // constant, and the reason this gate derives the pair table a third time.
    s = natWinResolve(s, 25927, 21364, 25716, 24904, 25710, 25964, "wx$loop$1", "wx$next$1", "wx$done$1", "wx$fail$1", 1)
    // "WriteFile": W|r=0x7257 i|t=0x7469 e|F=0x4665 i|l=0x6C69 e|\0=0x65
    s = natWinResolve(s, 29271, 29801, 18021, 27753, 101, 0, "wx$loop$2", "wx$next$2", "wx$done$2", "wx$fail$2", 2)
    return s
}

// natWinExitTail emits the Win64 exit tail: ExitProcess(main's return value).
// Win64 requires 32 bytes of caller shadow even for a single argument; the
// entry alignment itself is fixed by natAndRspNeg16 before the main call.
func natWinExitTail(s) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natSubRegImm32(s, natRegRSP(), 32)
    // natIatCall records ExitProcess's IAT index with the placeholder, so the
    // exit call is no longer identified by "the fourth emitted site".
    s = natIatCall(s, natRegRAX(), natIatExitProcess())
    return natCallReg(s, natRegRAX())
}

// natWinStub emits the complete Windows _start in the oracle order: alignment,
// bootstrap, call main, Win64 exit.
// natWinEntry emits ONLY the Windows `_start` sequence -- alignment fix, the
// loader-independent PEB bootstrap, the call to karkain_main and the Win64 exit
// tail -- and does NOT mark `karkain_main`, for the same reason
// natStartEntryOS does not: the oracle emits `_start` LAST, after the helpers
// and the user functions.
func natWinEntry(s) {
    s = natMark(s, "_start")
    s = natAndRspNeg16(s)
    s = natWinBootstrap(s)
    s = natCall32(s)
    let r = natRel32(s, "karkain_main")
    s = r[0]
    return natWinExitTail(s)
}

// natWinStub is the self-contained Windows entry, RETAINED unchanged because the
// frozen 151A Step 5/6 corpus (natWinCorpus shape 0) is gated on its exact
// 982-byte bytes. The whole-program driver uses natWinEntry instead.
func natWinStub() {
    let s = natNewEmitter(0)
    s = natWinEntry(s)
    s = natMark(s, "karkain_main")
    return s
}

// natWinCorpus renders the Windows pieces separately as well as whole, so a
// failure names a SUBSYSTEM (bootstrap, resolve, exit tail) rather than pointing
// at one long sequence.
//
// Shape 0 is the whole _start; shape 1 the alignment fix alone; shape 2 one
// export resolve alone; shape 3 the Win64 exit tail alone. This is the same
// four-shape split natStartCorpus uses for the Linux entry.
func natWinCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natWinStub())) }
    if (which == 1) {
        let s = natNewEmitter(0)
        return natToHex(natFinish(natAndRspNeg16(s)))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
s = natWinResolve(s, 30789, 29801, 29264, 25455, 29541, 115, "wx$loop$0", "wx$next$0", "wx$done$0", "wx$fail$0", 0)
        return natToHex(natFinish(s))
    }
    if (which == 3) {
        let s = natNewEmitter(0)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natSubRegImm32(s, natRegRSP(), 32)
        return natToHex(natFinish(s))
    }
    return ""
}

// ============================================================
// Phase 151A Step 6 -- assemble a RUNNABLE PE from the Step-5 sequences.
//
// Everything below is TEST SCAFFOLDING for the Step-6 gate, not language
// implementation. It composes the already-byte-verified `_start` with a minimal
// synthetic main body and links it through kcc's OWN natPELink, so the image is
// produced by the self-hosted engine and not by the Go oracle.
//
// The synthetic main body is deliberately the smallest thing that exercises
// startup and exit integration:
//
//	mov rax, <code>
//	ret
//
// It uses no frame slot, no allocator, no print and no stack, so it requires
// nothing from the value model that later 151A work still owes. It is NOT print,
// NOT print_float and NOT a general calling convention -- it is a return value.
//
// `code` is the process exit status, which is how the Win64 exit tail is
// observable: _start passes main's RAX to ExitProcess.
// ============================================================

// natWinExe assembles _start + a synthetic main and links a PE image.
//
// The patch bookkeeping is the whole point. The bootstrap stores three resolved
// kernel32 addresses with `mov [imm64], rax` (natStoreAbs64) and the exit tail
// loads ExitProcess with `movabs rax, <slot>`; both are LINK-TIME placeholders.
// Positions are recorded in the emitter's imm64 slot in emission order:
// ExitProcess, GetStdHandle, WriteFile, then the exit call. natPELink takes
// flat [pos, index] pairs, so those four become three apatches and one ipatch.
func natWinExe(code) {
    let s = natWinStub()
    // The synthetic main, emitted after the karkain_main label natWinStub left.
    s = natMovRegImm32(s, natRegRAX(), code)
    s = natRet(s)
    let text = natFinish(s)
    let p = natStImm64(s)
    let ap = []
    ap = appendArray(ap, p[0])
    ap = appendArray(ap, natIatExitProcess())
    ap = appendArray(ap, p[1])
    ap = appendArray(ap, natIatGetStdHandle())
    ap = appendArray(ap, p[2])
    ap = appendArray(ap, natIatWriteFile())
    let ip = []
    ip = appendArray(ip, p[3])
    ip = appendArray(ip, natIatExitProcess())
    return natToHex(natPELink(text, [], [], [], ip, ap, [], natPETextOff(), natPETextOff()))
}

// natWinExeC assembles _start + a synthetic main that CALLS GetStdHandle.
//
// This is the Step-6 Case C body. It exists to prove the PEB bootstrap's export
// resolution actually produced a callable address for a SECOND API, not just the
// one the exit tail uses.
//
// It deliberately does NOT print. Implementing print is later 151A work and is
// out of scope here; calling the resolved GetStdHandle and surviving is the proof.
// If the bootstrap had published a bad address, this call would fault and the
// process would die with an access violation instead of exiting 0.
//
// The call follows the Win64 rules the oracle already established: rsp is 8 (mod
// 16) at main entry because _start aligned it and then called, so subtracting 40
// puts it at 0 (mod 16) at the call site, and 32 of that is caller shadow.
func natWinExeC() {
    let s = natWinStub()
    s = natSubRegImm32(s, natRegRSP(), 40)
    // STD_OUTPUT_HANDLE is -11; MovRegImm32 writes it as the 32-bit constant the
    // oracle uses, which is what the kernel32 stub reads.
    s = natMovRegImm32(s, natRegRCX(), 4294967285)
    s = natIatCall(s, natRegRAX(), natIatGetStdHandle())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 40)
    s = natMovRegImm32(s, natRegRAX(), 0)
    s = natRet(s)
    let text = natFinish(s)
    let p = natStImm64(s)
    let ap = []
    ap = appendArray(ap, p[0])
    ap = appendArray(ap, natIatExitProcess())
    ap = appendArray(ap, p[1])
    ap = appendArray(ap, natIatGetStdHandle())
    ap = appendArray(ap, p[2])
    ap = appendArray(ap, natIatWriteFile())
    let ip = []
    ip = appendArray(ip, p[3])
    ip = appendArray(ip, natIatExitProcess())
    ip = appendArray(ip, p[4])
    ip = appendArray(ip, natIatGetStdHandle())
    return natToHex(natPELink(text, [], [], [], ip, ap, [], natPETextOff(), natPETextOff()))
}

// natIatCall emits `movabs rax, <IAT slot>`, the Win64 import-call shape the
// oracle's iatCall produces, and records the slot INDEX alongside the placeholder
// position.
//
// The `slot` parameter existed but was UNUSED until Step 9b: the oracle pairs
// each position with its index (`iatPatch{pos, index}`), while kcc recorded the
// position alone and left callers to recover the index from emission order. That
// worked only while four sites existed. The comment on natStIatIndex explains
// why the positional reading is now wrong, and it is worth restating that the
// consequence of getting it wrong is a silent call through the WRONG kernel32
// entry point rather than a crash.
//
// Note the `call rax` is NOT emitted here: the oracle's iatCall emits it
// internally, but kcc's Step-6 call sites emit natCallReg immediately after, and
// that split is already byte-verified, so it is preserved rather than "fixed".
func natIatCall(s, reg, slot) {
    let p = natImm64Patch(s, natMovImm64Op(reg))
    s = p[0]
    // Slot 5 is appended here as well as slot 11. natMovImm64 -- which is what
    // this used to call -- appends to slot 5, and the frozen Step 6 image builders
    // (natWinExe / natWinExeC) read their ipatch position straight out of slot 5
    // by index. natImm64Patch does NOT append there, so switching to it without
    // this line would silently shorten slot 5 and make those readers index past
    // its end. The bytes are identical either way: both emit REX, the opcode and
    // eight zero bytes, because natMovImm64 is always called with v == 0 here.
    s[5] = appendArray(s[5], p[1])
    s[8] = appendArray(s[8], slot)
    s[11] = appendArray(s[11], p[1])
    s[12] = appendArray(s[12], slot)
    return s
}
// ============================================================
// Phase 151A Step 8b - print_float
//
// This mirrors Builder.emitPrintFloatHelper in pkg/native/program.go
// (lines 4185-4390) instruction for instruction and IN THE SAME ORDER. The
// order is load-bearing twice over:
//
//   - the Go helper interleaves writes with live values, and several of those
//     values are parked in the frame rather than a register. The frame map is
//     rsp+0..5 fraction digits, rsp+8..15 the R11 digit count (across the "."
//     write), rsp+16..23 the fraction bit pattern, rsp+24..31 the integer part,
//     rsp+45..63 the integer digit buffer. RCX/RAX/RDX are volatile at BOTH the
//     Win64 kernel32 boundary and the raw syscall -- the syscall itself assigns
//     RCX the return RIP -- so a caller-saved park is not enough in either
//     container. Parking the integer part is what makes NEGATIVE values
//     correct: the sign write would otherwise clobber RCX before it is read.
//   - every fresh() label is allocated at the point the Go helper allocates it.
//     Label NAMES do not affect a single byte, but the ORDER of the marks does,
//     because the rel32 displacements are computed from positions.
//
// The writes go through natWriteStdout, which is the Linux syscall form, so
// this corpus is Linux by construction exactly as Step 7's is.

// natPrintFloatHelper emits the whole print_float helper.
func natPrintFloatHelper() {
    let s = natNewEmitter(0)
    s = natMark(s, "print_float")
    s = natSubRegImm32(s, natRegRSP(), 64)
    s = natMovRegReg(s, natRegRAX(), natRegRDI())
s = natMovRegImm64(s, natRegRCX(), 0 - 9223372036854775807 - 1)
    s = natMovRegReg(s, natRegR11(), natRegRAX())
    s = natAndRegReg(s, natRegR11(), natRegRCX())
    s = natMovRegImm64(s, natRegRCX(), 9223372036854775807)
    s = natAndRegReg(s, natRegRAX(), natRegRCX())
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natShrRegImm(s, natRegRCX(), 52)
    s = natMovRegImm32(s, natRegR10(), 2047)
    s = natAndRegReg(s, natRegRCX(), natRegR10())
    s = natCmpRegImm32(s, natRegRCX(), 2047)
    s = natJz(s, "fltsp")
    s = natJmp(s, "fltfin")
    s = natMark(s, "fltsp")
    s = natMovRegImm64(s, natRegR10(), 4503599627370495)
    s = natAndRegReg(s, natRegRAX(), natRegR10())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltnan")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnoinf")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnoinf")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 3)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natRet(s)
    s = natMark(s, "fltnan")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnonan")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnonan")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 3)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natRet(s)
    s = natMark(s, "fltfin")
    s = natMovXmmRegGp(s, 0, natRegRAX())
    s = natCvttsd2siGpXmm(s, natRegRCX(), 0)
    s = natCvtsi2sdXmmGp(s, 1, natRegRCX())
    s = natSubsdXmmXmm(s, 0, 1)
    s = natMovGpRegXmm(s, natRegRAX(), 0)
    s = natStoreStack(s, natRegRAX(), 16)
    s = natStoreStack(s, natRegRCX(), 24)
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnosign")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnosign")
    s = natLoadStack(s, natRegRAX(), 24)
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltintnz")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natJmp(s, "fltintdone")
    s = natMark(s, "fltintnz")
    s = natMovRegImm32(s, natRegR10(), 10)
    s = natLeaRegStack(s, natRegRSI(), 64)
    s = natMark(s, "fltintloop")
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRDX(), 48)
    s = natDecReg(s, natRegRSI())
    s = natStoreMem8(s, natRegRSI(), natRegRDX())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltintloop")
    s = natLeaRegStack(s, natRegRBX(), 64)
    s = natMovRegReg(s, natRegRDX(), natRegRBX())
    s = natSubRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltintdone")
    s = natLoadStack(s, natRegRCX(), 16)
    s = natMovXmmRegGp(s, 0, natRegRCX())
    s = natMovRegImm64(s, natRegR10(), 4696837146684686336)
    s = natMovXmmRegGp(s, 1, natRegR10())
    s = natMulsdXmmXmm(s, 0, 1)
    s = natCvttsd2siGpXmm(s, natRegRCX(), 0)
    s = natMovRegImm32(s, natRegR10(), 100000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 0)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 10000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 1)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 1000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 2)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 100)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 3)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 10)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 4)
    s = natAddRegImm32(s, natRegRDX(), 48)
    s = natStoreMem8Off(s, natRegRDX(), natRegRSP(), 5)
    s = natMovRegImm32(s, natRegR11(), 6)
    s = natLeaRegStack(s, natRegRAX(), 0)
    s = natMark(s, "flttrim")
    s = natMovRegReg(s, natRegRCX(), natRegR11())
    s = natAddRegReg(s, natRegRAX(), natRegRCX())
    s = natMovzxRegMem8(s, natRegRCX(), natRegRAX(), -1)
    s = natLeaRegStack(s, natRegRAX(), 0)
    s = natCmpRegImm32(s, natRegRCX(), 48)
    s = natJnz(s, "flttrimdone")
    s = natDecReg(s, natRegR11())
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJnz(s, "flttrim")
    s = natMark(s, "flttrimdone")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnofrac")
    // The digit count lives in R11 across the "." write below, and a Win64
    // kernel32 call CLOBBERS R11 (caller-saved), so it is spilled and reloaded.
    // Without this the fraction write uses the clobbered count: on the raw
    // syscall path R11 happens to survive, so the bug is invisible on Linux,
    // but on Windows every float would print as a bare integer ("1.5" -> "1").
    s = natStoreStack(s, natRegR11(), 8)
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natLeaRegStack(s, natRegRSI(), 0)
    s = natLoadStack(s, natRegRDX(), 8)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnofrac")
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    return natRet(s)
}

// The sign-mask constant 1<<63 is written as 0 - 9223372036854775807 - 1
// rather than as the literal 9223372036854775808, and that is a CORRECTNESS
// requirement rather than a style choice.
//
// Karkain's integer surface is signed 64-bit, so the literal 9223372036854775808
// (which is 1<<63, one past the maximum) cannot be represented: the parser
// clamps it and natBytesLE then emits FF FF FF FF FF FF FF FF where the oracle
// emits 00 00 00 00 00 00 00 80. That is the 151B constant-class bug recurring
// in a new place -- a hand-written decimal that looks right and silently
// produces a different instruction, here `and r11, rcx` testing the wrong mask
// and therefore printing the wrong result for every negative float.
//
// Written as a negative it is exact, and natBytesLE masks each byte, so the
// arithmetic shift of a negative value yields the correct two's-complement
// bytes: (-1<<63) >> 56 = 0xFF..80, & 0xFF = 0x80.
// ============================================================
// Phase 151A Step 8c - float statement lowering in kcc
//
// Step 8a ported the SSE2 primitives and Step 8b the print_float helper; both
// were unreachable from an actual statement. This slice is the first one where
// an expression LOWERING exists, and it is what makes whole-image parity
// testable for a real program.
//
// THE LOAD-BEARING FACT, and it is the reason this slice is smaller than it
// looks: a float local is ONE 8-byte unit in exactly the same frame slot an int
// would occupy. emitLet's float path is therefore the int path's
// `StoreStack(RAX, off)` with the f64 bits left in RAX by emitFloat. Nothing
// about the frame changes between kinds, and `rsp` never moves.
//
// Mirrors, in pkg/native/program.go:
//   emitFloat      -> natFloatLit / natFloatLocal
//   emitFloatBinary-> natFloatBinary (staging through binTemp, then xmm0/xmm1)
//   emitFloatDiv   -> the zero-divisor short-circuit
//   emitFloatNeg   -> XOR with 1<<63, never 0.0 - x, so -0.0 survives
//   emitFloatCond  -> the six comparisons as real branches
//
// The corpus arms are the distinct SHAPES, not one per operator: the literal
// store, the staged binary, the divide short-circuit, unary negation, and the
// three comparison families (`==`, `!=`, and the four ordered ones which share
// a shape).

// natFloatLit emits a float literal by materialising its IEEE-754 pattern
// verbatim: movabs rax, <bits>. No rounding and no sign-bit normalisation, so
// the bits of 0.0 and -0.0 stay distinct.
func natFloatLit(bits) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), bits)
    return natToHex(natFinish(s))
}

// natFloatLet mirrors emitLet's non-string path for a float binding: the value
// arrives in RAX and is stored with the int path's single StoreStack.
func natFloatLet(bits, off) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), bits)
    s = natStoreStack(s, natRegRAX(), off)
    return natToHex(natFinish(s))
}

// natFloatBinary mirrors emitFloatBinary for one operator. The operands are
// staged through binTemp+depth*8 exactly as the oracle does, because RAX must
// carry both sides into xmm in a defined order and the right side is evaluated
// second.
func natFloatBinary(op, lbits, rbits, temp, depth) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), lbits)
    s = natStoreStack(s, natRegRAX(), temp + depth * 8)
    s = natMovRegImm64(s, natRegRAX(), rbits)
    s = natMovXmmRegGp(s, 1, natRegRAX())
    s = natLoadStack(s, natRegRAX(), temp + depth * 8)
    s = natMovXmmRegGp(s, 0, natRegRAX())
    if (op == "add") {
        s = natAddsdXmmXmm(s, 0, 1)
    }
    if (op == "sub") {
        s = natSubsdXmmXmm(s, 0, 1)
    }
    if (op == "mul") {
        s = natMulsdXmmXmm(s, 0, 1)
    }
    if (op == "div") {
        s = natFloatDiv(s, 0, 1)
    }
    s = natMovGpRegXmm(s, natRegRAX(), 0)
    return natToHex(natFinish(s))
}

// natFloatDiv mirrors emitFloatDiv: a zero divisor short-circuits to +0.0
// rather than producing an infinity that would poison every later step.
// ucomisd reports ZF=1 for 0.0, -0.0 and NaN, and all three compare unequal to
// zero in C, so all three take the short-circuit -- exactly the `r != 0.0`
// guard the C backend writes.
func natFloatDiv(s, num, den) {
    s = natXorpdXmmXmm(s, 2, 2)
    s = natUcomisdXmmXmm(s, den, 2)
    s = natJnz(s, "fdiv")
    s = natXorpdXmmXmm(s, num, num)
    s = natJmp(s, "fdivend")
    s = natMark(s, "fdiv")
    s = natDivsdXmmXmm(s, num, den)
    s = natMark(s, "fdivend")
    return s
}

// natFloatNeg mirrors emitFloatNeg: XOR with 1<<63 is exact for every finite
// value, both zeros and NaN payloads keep their magnitude, so -0.0 stays -0.0
// where a `0.0 - x` or an integer NegReg would silently destroy it.
func natFloatNeg(bits) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRCX(), 0 - 9223372036854775807 - 1)
    s = natMovXmmRegGp(s, 1, natRegRCX())
    s = natMovXmmRegGp(s, 0, natRegRAX())
    s = natXorpdXmmXmm(s, 0, 1)
    s = natMovGpRegXmm(s, natRegRAX(), 0)
    return natToHex(natFinish(s))
}

// natFloatCond mirrors emitFloatCond for one comparison. It emits the whole
// condition, jumping to `falseLabel` when the comparison does NOT hold, which
// is the oracle's shape: the caller supplies the false edge.
//
// `lt`, `le`, `gt` and `ge` differ only in which operand order feeds ucomisd
// and in whether the branch is jbe or jb, so they are one shape parameterised
// by which side is compared and which branch is taken.
func natFloatCond(op, lbits, rbits, temp, falseLabel) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), lbits)
    s = natStoreStack(s, natRegRAX(), temp)
    s = natMovRegImm64(s, natRegRAX(), rbits)
    s = natMovXmmRegGp(s, 1, natRegRAX())
    s = natLoadStack(s, natRegRAX(), temp)
    s = natMovXmmRegGp(s, 0, natRegRAX())
    if (op == "eq") {
        s = natUcomisdXmmXmm(s, 0, 1)
        s = natJp(s, falseLabel)
        s = natJnz(s, falseLabel)
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    if (op == "ne") {
        s = natUcomisdXmmXmm(s, 0, 1)
        s = natJp(s, "fne")
        s = natJnz(s, "fne")
        s = natJmp(s, falseLabel)
        s = natMark(s, "fne")
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    // Ordered comparisons: `<`/`<=` feed the operands to ucomisd SWAPPED, so
    // the single branch becomes the "greater" case on the other operand. `<`
    // and `<=` differ only in jbe vs jb (below-or-equal vs strictly below), and
    // `>`/`>=` are the same two branches on the unswapped compare.
    if (op == "lt") {
        s = natUcomisdXmmXmm(s, 1, 0)
        s = natJbe(s, falseLabel)
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    if (op == "le") {
        s = natUcomisdXmmXmm(s, 1, 0)
        s = natJb(s, falseLabel)
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    if (op == "gt") {
        s = natUcomisdXmmXmm(s, 0, 1)
        s = natJbe(s, falseLabel)
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    s = natUcomisdXmmXmm(s, 0, 1)
    s = natJb(s, falseLabel)
    s = natMark(s, falseLabel)
    return natToHex(natFinish(s))
}
// natFloatStmtCorpus emits the Step 8c reference shapes, one hex line per arm.
//
// The literals are 1.5 and 2.25, and their IEEE-754 patterns were computed
// rather than written by eye -- the same discipline the 151B constant bug
// demanded. `b1515` is float64bits(1.5) = 0x3FF8000000000000 and `b225` is
// float64bits(2.25) = 0x4002000000000000; both are passed in from the caller so
// the test file states them, which keeps this file free of new magic numbers.
//
// temp is the oracle's binTemp base for a one-local frame, so the staging
// offsets are the ones the oracle really uses.
func natFloatStmtCorpus(which, b1515, b225, temp) {
    if (which == 0) {
        return natFloatLet(b1515, 0)
    }
    if (which == 1) {
        return natFloatLocal(0)
    }
    if (which == 2) {
        return natFloatBinary("add", b1515, b225, temp, 0)
    }
    if (which == 3) {
        return natFloatBinary("sub", b1515, b225, temp, 0)
    }
    if (which == 4) {
        return natFloatBinary("mul", b1515, b225, temp, 0)
    }
    if (which == 5) {
        return natFloatBinary("div", b1515, b225, temp, 0)
    }
    if (which == 6) {
        return natFloatNeg(b1515)
    }
    if (which == 7) {
        return natFloatCond("eq", b1515, b225, temp, "$false")
    }
    if (which == 8) {
        return natFloatCond("ne", b1515, b225, temp, "$false")
    }
    if (which == 9) {
        return natFloatCond("lt", b1515, b225, temp, "$false")
    }
    if (which == 10) {
        return natFloatCond("le", b1515, b225, temp, "$false")
    }
    if (which == 11) {
        return natFloatCond("gt", b1515, b225, temp, "$false")
    }
    if (which == 12) {
        return natFloatCond("ge", b1515, b225, temp, "$false")
    }
    return ""
}

// natFloatLocal mirrors emitFloat's identifier case: the stored 64-bit pattern
// is reloaded unchanged, exactly as the int path reloads an int.
func natFloatLocal(off) {
    let s = natNewEmitter(0)
    s = natLoadStack(s, natRegRAX(), off)
    return natToHex(natFinish(s))
}

// ============================================================
// Phase 151A Step 8d - the call ABI (int first)
//
// Phase 148's convention, which this slice ports:
//
//   CALLER. Each argument is evaluated and staged to the per-arg spill, then
//   all units are loaded back into the argument registers, the extras pointer
//   is materialised if any unit exceeded the budget, and the call is made.
//   Units 0-5 travel in RDI,RSI,RDX,RCX,R8,R9; further units travel in the
//   CALLER's extras area, addressed through R10.
//
//   CALLEE. After `sub rsp, frame`, each parameter's unit is homed from its
//   argument register into its frame slot; units past the budget are read
//   through R10. The homing happens at entry, before R10 can die.
//
// WHY THE FRAME IS NOT TOUCHED. The per-arg spill is NOT a separate region
// inserted before extrasBase. The oracle computes
//
//     argTemp(i) = frame - argSpillBytes + i*16
//
// i.e. it indexes DOWNWARD from the frame size, 16 bytes per argument. Phase
// 151A Step 1 already reserved exactly that: native_value.kark computes
// `frame = next + natArgSpillBytes()` with argSpillBytes() = 96 (6 x 16) and
// exposes frame as layout slot 6. No region is inserted and NOTHING moves, which
// is why this slice asserts the frame numbers and the whole-tree KIR pin are
// UNCHANGED. Had a region genuinely been missing, extrasBase, next and frame
// would all have shifted, along with every frame-dependent displacement in
// Steps 1-8c. Their not moving is the evidence the reading is right.
//
// SCOPE IS INT ONLY. Every int takes ONE unit, so stageUnit's string special
// case -- where RSI is the high half of a two-unit argument and lands 8 bytes
// higher -- cannot arise here. Float is also one unit (kindUnits(KindFloat) == 1)
// and therefore rides the identical path; it is a kind-plumbing follow-up, not
// new emission.

// natArgTemp mirrors Builder.argTemp: the caller-side per-argument spill at the
// top of the frame, addressed downward from the frame size.
func natArgTemp(i, frame) { return frame - natArgSpillBytes() + i * 16 }

// natCallArgsN mirrors emitCallValue for N int arguments, units 0..N-1 all
// within the register budget: stage every argument, then load every unit back.
func natCallArgsN(vals, n, frame) {
    let s = natNewEmitter(0)
    let i = 0
    while (i < n) {
        s = natMovRegImm64(s, natRegRAX(), vals[i])
        s = natStoreStack(s, natRegRAX(), natArgTemp(i, frame))
        i = i + 1
    }
    i = 0
    while (i < n) {
        s = natLoadStack(s, natArgReg(i), natArgTemp(i, frame))
        i = i + 1
    }
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natCallArgsExtras mirrors the same call with SEVEN int arguments, so unit 6
// exceeds the register budget. That unit is staged straight to the extras area
// (no spill slot), and R10 is loaded with the extras base so the callee can read
// it.
func natCallArgsExtras(vals, frame, extrasBase) {
    let s = natNewEmitter(0)
    let i = 0
    while (i < 7) {
        s = natMovRegImm64(s, natRegRAX(), vals[i])
        if (i < 6) {
            s = natStoreStack(s, natRegRAX(), natArgTemp(i, frame))
        } else {
            s = natStoreStack(s, natRegRAX(), extrasBase)
        }
        i = i + 1
    }
    i = 0
    while (i < 6) {
        s = natLoadStack(s, natArgReg(i), natArgTemp(i, frame))
        i = i + 1
    }
    s = natLeaRegStack(s, natRegR10(), extrasBase)
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natPrologueArgsN mirrors the callee's arg homing for N parameters, all within
// the register budget: each parameter's slot is written from its argument
// register, in parameter order.
func natPrologueArgsN(n, frame, localsBytes) {
    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    let i = 0
    while (i < n) {
        s = natStoreStack(s, natArgReg(i), localsBytes + i * 8)
        i = i + 1
    }
    return natToHex(natFinish(s))
}

// natPrologueExtras mirrors the callee's homing when a parameter's unit sits
// past the register budget: it is read through R10 at (unit-6)*8 and stored.
// The read happens at ENTRY, before R10 can be clobbered by anything else.
func natPrologueExtras(n, frame, localsBytes) {
    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    let i = 0
    while (i < n) {
        if (i < 6) {
            s = natStoreStack(s, natArgReg(i), localsBytes + i * 8)
        } else {
            s = natLoadBaseOff(s, natRegRAX(), natRegR10(), (i - 6) * 8)
            s = natStoreStack(s, natRegRAX(), localsBytes + i * 8)
        }
        i = i + 1
    }
    return natToHex(natFinish(s))
}

// natArgReg returns the argument register for unit i: RDI,RSI,RDX,RCX,R8,R9.
func natArgReg(i) {
    if (i == 0) { return natRegRDI() }
    if (i == 1) { return natRegRSI() }
    if (i == 2) { return natRegRDX() }
    if (i == 3) { return natRegRCX() }
    if (i == 4) { return natRegR8() }
    return natRegR9()
}

// natCallCorpus emits the Step 8d reference sequences.
//
// The literals are 1..7 so each staged value is distinguishable from its
// neighbours in a hex dump -- a corpus of identical values would hide an
// off-by-one in the spill indexing, which is precisely the bug this slice could
// plausibly introduce.
//
// `frame` and `extrasBase` are passed in rather than computed here, so the test
// states the oracle's real layout numbers and this file gains no magic numbers.
func natCallCorpus(which, frame, extrasBase, localsBytes) {
    let one = [7]
    let three = [7, 11, 13]
    let seven = [7, 11, 13, 17, 19, 23, 29]
    if (which == 0) { return natCallArgsN(one, 1, frame) }
    if (which == 1) { return natCallArgsN([7, 11], 2, frame) }
    if (which == 2) { return natCallArgsN(three, 3, frame) }
    if (which == 3) { return natCallArgsExtras(seven, frame, extrasBase) }
    if (which == 4) { return natPrologueArgsN(1, frame, localsBytes) }
    if (which == 5) { return natPrologueArgsN(3, frame, localsBytes) }
    if (which == 6) { return natPrologueExtras(7, frame, localsBytes) }
    return ""
}
// ============================================================
// Phase 151A Step 8e - floats through the call ABI
//
// This slice exists to PROVE a claim rather than to add emission, and the claim
// is the load-bearing one for the whole float kind:
//
//   floats need NO new ABI code.
//
// `kindUnits(KindFloat) == 1` in the oracle and `natKindUnits` in kcc already
// agree, so a float parameter occupies exactly one frame slot and a float
// argument is staged, loaded and passed by the byte-for-byte identical path an
// int uses. What Step 8d built is already float-capable; this slice demonstrates
// that rather than asserting it.
//
// The consequence worth stating: a float argument is `emitFloat` followed by
// `stageUnit(i, unit, RAX)` and `unit++` -- the int arm with a different
// evaluator in front of it. A float return is the int return, since the f64 bits
// are already in RAX. So the shapes below are the Step 8d shapes with float
// operands, and the gate's strongest layer asserts they are BYTE-IDENTICAL to the
// int shapes rather than merely similar.

// natFloatArgCall is Step 8d's one-argument call with a FLOAT literal staged.
// The staging, the spill address, the RDI load and the call are all the same
// emission; only the literal's bits differ.
func natFloatArgCall(bits, frame) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), bits)
    s = natStoreStack(s, natRegRAX(), natArgTemp(0, frame))
    s = natLoadStack(s, natRegRDI(), natArgTemp(0, frame))
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natFloatParamHome is Step 8d's callee homing for one parameter, with the
// parameter declared FLOAT. A float parameter is homed from RDI into its frame
// slot exactly as an int is; there is no conversion and no separate area.
func natFloatParamHome(frame, localsBytes) {
    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natStoreStack(s, natRegRDI(), localsBytes)
    return natToHex(natFinish(s))
}

// natFloatReturn is the float return: emitFloat has already left the f64 bits in
// RAX, and the int return convention applies unchanged.
//
// There is deliberately NO frame teardown here. The oracle's ReturnStmt case is
// `emitReturn(...)` followed by `Jmp("fn_<name>$ret")` (program.go:4893-4900),
// and the `AddRsp(frame)` happens AT the `$ret` label in the epilogue
// (program.go:4863-4866). A first draft of this function emitted
// `sub rsp, frame` before the jmp, which would have torn the frame down twice.
//
// This also corrects a stale reference: the Step 2 note recorded the `$ret` jmp
// at program.go:3386, and that line now holds an unrelated function
// (emitBase64OutByte). The reference was accurate when written and drifted as the
// file grew, which is the argument for finding a label by searching for it rather
// than by following a remembered line number.
func natFloatReturn(bits) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), bits)
    s = natJmp(s, "$ret")
    s = natMark(s, "$ret")
    return natToHex(natFinish(s))
}

// natFloatCallCorpus emits the Step 8e shapes. `frame`, `extrasBase` and
// `localsBytes` come from the caller so the test states the real layout numbers.
//
// `b1515` is float64bits(1.5) and `b42` is 42 as an int, chosen so the two
// literals are distinguishable from each other AND from the Step 8d corpus,
// which is what makes the float-vs-int byte comparison meaningful rather than
// accidentally equal.
func natFloatCallCorpus(which, b1515, b42, frame, extrasBase, localsBytes) {
    if (which == 0) { return natFloatArgCall(b1515, frame) }
    if (which == 1) { return natFloatArgCall(b42, frame) }
    if (which == 2) { return natFloatParamHome(frame, localsBytes) }
    if (which == 3) { return natFloatReturn(b1515) }
    return ""
}

// ============================================================
// Phase 151A Step 8f - strings through the call ABI
//
// A string is the FIRST TWO-UNIT kind: kindUnits(KindString) == 2, so it
// occupies two of the argument registers and, more importantly, it is the case
// that exercises stageUnit's high-half rule for the first time.
//
// THE RULE, and it is subtle enough to state exactly. stageUnit homes one
// evaluated unit and picks the slot like this:
//
//     if unit < 6 {
//         off := argTemp(arg)
//         if r == RSI { off += 8 }
//         StoreStack(r, off)
//     }
//
// The check is on the REGISTER, not on the unit index. That is sound because
// stageUnit is called with RSI in exactly one place -- the string branch of
// emitCallValue passes RDI for the pointer and RSI for the length, while every
// other kind passes RAX. So "r == RSI" is a reliable proxy for "this is a
// string's second unit", and argTemp's 16-byte stride is what gives the pair its
// low and high halves.
//
// The load-back loop then reads argTemp(i) + k*8, where k is the unit index
// WITHIN the argument, so the two halves line up wherever in the register
// sequence the argument happens to start. That is why an int followed by a
// string still works: the string's units land at global indices 1 and 2, but the
// reader indexes by (arg, k), not by global unit.
//
// NO RODATA. A string LITERAL would need a rodata reference, which is unresolved
// at this layer and would force the masked comparison Step 8b needed. A string
// LOCAL is loaded straight from its two frame slots instead, so this slice keeps
// the RAW differential.

// natStringArgCall is a one-string-argument call. The string local occupies two
// frame slots at `loc` (ptr) and `loc+8` (len), matching the oracle's slot
// layout for a two-unit kind.
func natStringArgCall(frame, loc) {
    let s = natNewEmitter(0)
    s = natLoadStack(s, natRegRDI(), loc)
    s = natLoadStack(s, natRegRSI(), loc + 8)
    s = natStoreStack(s, natRegRDI(), natArgTemp(0, frame))
    s = natStoreStack(s, natRegRSI(), natArgTemp(0, frame) + 8)
    s = natLoadStack(s, natRegRDI(), natArgTemp(0, frame))
    s = natLoadStack(s, natRegRSI(), natArgTemp(0, frame) + 8)
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natIntStringArgCall is an int argument followed by a string. The interesting
// property is that the string's two units land at GLOBAL unit indices 1 and 2,
// so RSI is the string's pointer and RDX its length -- while the reader still
// indexes by (arg, k). A corpus that only ever passed a string first could not
// tell the two conventions apart.
func natIntStringArgCall(frame, loc) {
    let s = natNewEmitter(0)
    // arg 0: an int, staged from RAX
    s = natMovRegImm64(s, natRegRAX(), 7)
    s = natStoreStack(s, natRegRAX(), natArgTemp(0, frame))
    // arg 1: a string, staged from the (RDI, RSI) pair
    s = natLoadStack(s, natRegRDI(), loc)
    s = natLoadStack(s, natRegRSI(), loc + 8)
    s = natStoreStack(s, natRegRDI(), natArgTemp(1, frame))
    s = natStoreStack(s, natRegRSI(), natArgTemp(1, frame) + 8)
    // load back, in (arg, k) order
    s = natLoadStack(s, natRegRDI(), natArgTemp(0, frame))
    s = natLoadStack(s, natRegRSI(), natArgTemp(1, frame))
    s = natLoadStack(s, natRegRDX(), natArgTemp(1, frame) + 8)
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natStringParamHome is the callee side: a string parameter occupies two units,
// homed from RDI into the low slot and from RSI into the high slot. There is no
// conversion and no separate area -- a string is passed as two registers, exactly
// as Phase 148 specifies.
func natStringParamHome(frame, loc) {
    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natStoreStack(s, natRegRDI(), loc)
    s = natStoreStack(s, natRegRSI(), loc + 8)
    return natToHex(natFinish(s))
}

// natStringArgsExtras is four string arguments -- eight units, so units 6 and 7
// exceed the register budget and travel in the caller's extras area. This is the
// first case that puts the extras region AND the two-unit stride together.
func natStringArgsExtras(frame, loc, extrasBase) {
    let s = natNewEmitter(0)
    let a = 0
    while (a < 4) {
        s = natLoadStack(s, natRegRDI(), loc + a * 16)
        s = natLoadStack(s, natRegRSI(), loc + a * 16 + 8)
        let unit = a * 2
        if (unit < 6) {
            s = natStoreStack(s, natRegRDI(), natArgTemp(a, frame))
            s = natStoreStack(s, natRegRSI(), natArgTemp(a, frame) + 8)
        } else {
            s = natStoreStack(s, natRegRDI(), extrasBase + (unit - 6) * 8)
            s = natStoreStack(s, natRegRSI(), extrasBase + (unit - 6) * 8 + 8)
        }
        a = a + 1
    }
    a = 0
    while (a < 4) {
        let unit = a * 2
        if (unit < 6) {
            s = natLoadStack(s, natArgReg(unit), natArgTemp(a, frame))
            s = natLoadStack(s, natArgReg(unit + 1), natArgTemp(a, frame) + 8)
        }
        a = a + 1
    }
    s = natLeaRegStack(s, natRegR10(), extrasBase)
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natStringCallCorpus emits the Step 8f shapes. frame/loc/extrasBase come from
// the caller so the test states the real layout numbers and this file gains no
// magic numbers.
//
// `loc` is 8, the first local slot after the frame's zero-argument case; four
// string locals then occupy 8..39 at 16 bytes each, which is what the extras
// arm reads.
func natStringCallCorpus(which, frame, loc, extrasBase) {
    if (which == 0) { return natStringArgCall(frame, loc) }
    if (which == 1) { return natIntStringArgCall(frame, loc) }
    if (which == 2) { return natStringParamHome(frame, loc) }
    if (which == 3) { return natStringArgsExtras(frame, loc, extrasBase) }
    return ""
}
// ============================================================
// Phase 151A Step 9a - rodata resolution
//
// Every absolute address in a kcc image is emitted as a 10-byte `mov r64, imm64`
// with the immediate left at zero, and the POSITION recorded. That is the only
// way a linker can fill in an address it alone knows, and it is what
// natImm64Patch has always produced. What was missing is the other half: nothing
// recorded WHICH rodata byte each position refers to, so print_int's two `"-"`
// and `"\n"` references had sites but no destinations.
//
// This is the piece every section of this baseline has named as the thing
// blocking 151D, so it is deliberately small and deliberately boring:
//
//   natRodataRefOff  emits a rodata reference AND records (position, offset)
//   natRodataSection builds the rodata byte array, interning duplicates
//   natResolveRodata fills every recorded site with base + rva + offset
//
// `natRodataRef` is deliberately NOT changed. The frozen Step 7 and Step 8b
// corpora use it, and both compare emitted BYTES, which recording would not
// alter. The new function sits alongside it.

// natRodataRefOff emits `movabs r, <rodata placeholder>` and records the site
// together with the offset it refers to.
//
// The immediate stays ZERO here. Resolution happens once, later, in
// natResolveRodata, because the base address is not known until the container
// writer has chosen a layout -- an emitter that filled the address in would be
// guessing a number the linker owns.
func natRodataRefOff(s, r, roOff) {
    let p = natImm64Patch(s, natMovImm64Op(r))
    s = p[0]
    s[6] = appendArray(s[6], p[1])
    s[7] = appendArray(s[7], roOff)
    return s
}

// natRodataSection builds the rodata byte array from a list of strings,
// interning duplicates, and returns [bytes, offsetOfFirstUse].
//
// Interning matters for byte-identity: the oracle's `internRodata` also
// deduplicates, so a repeated string occupies ONE rodata entry there and must
// occupy one here, or every following offset moves.
//
// The return carries the offset of the FIRST string so the caller can record it
// against the first site it emits without a second lookup.
func natRodataSection(strs) {
    let bytes = []
    let offs = []
    let i = 0
    while (i < len(strs)) {
        // linear scan for an existing interned copy
        let found = -1
        let j = 0
        while (j < len(strs)) {
            if (j < i) {
                if (natStrEq(strs[j], strs[i])) { found = offs[j] }
            }
            j = j + 1
        }
        if (found >= 0) {
            offs = appendArray(offs, found)
        } else {
            offs = appendArray(offs, len(bytes))
            bytes = natAppendStr(bytes, strs[i])
        }
        i = i + 1
    }
    return [bytes, offs]
}

// natStrEq compares two Karkain strings for equality.
//
// A first draft indexed the string (`a[i] != b[i]`), which compiles and yields
// 0 for every position -- Karkain strings are NOT indexable, and the comparison
// silently succeeded on two different strings. The compiler's own idiom is
// `substr(s, i, 1)`, which is what Step 6's Mach-O writer uses, so that is what
// this uses.
func natStrEq(a, b) {
    if (len(a) != len(b)) { return 0 }
    let i = 0
    while (i < len(a)) {
        if (substr(a, i, 1) != substr(b, i, 1)) { return 0 }
        i = i + 1
    }
    return 1
}

// natAppendStr appends a Karkain string's bytes to a byte array.
//
// Karkain has no byte string literal and its strings are not indexable, so each
// byte is taken with `asciiVal(substr(str, i, 1))` -- the same idiom the
// compiler's own lexer and the Mach-O writer use. Truncating to 8 bits is exact
// for the ASCII payloads the runtime emits, and is stated here so the limit is a
// decision rather than an accident.
func natAppendStr(dst, str) {
    let i = 0
    while (i < len(str)) {
        dst = appendArray(dst, asciiVal(substr(str, i, 1)) & 255)
        i = i + 1
    }
    return dst
}

// natResolveRodata fills every recorded rodata site with base + roRVA + offset,
// in place, and returns the number of sites resolved.
//
// `base` is the container's load base and `roRVA` the rodata section's RVA. Both
// come from the writer, not from here: this layer knows WHERE a site is and WHAT
// it points at, and the writer knows what the image will actually be loaded at.
func natResolveRodata(s, base, roRVA) {
    let n = 0
    let i = 0
    while (i < len(s[6])) {
        let pos = s[6][i]
        let off = s[7][i]
        // The name avoids `addr`, which is a RESERVED WORD in this language (the
        // same class of trap as Step 8b's `raw` parameter): the parse error names
        // the token rather than the offending field, so a reserved word reads as a
        // malformed declaration.
        let av = base + roRVA + off
        let code = natStCode(s)
        // little-endian, 8 bytes, written in place
        code[pos] = av & 255
        code[pos + 1] = (av >> 8) & 255
        code[pos + 2] = (av >> 16) & 255
        code[pos + 3] = (av >> 24) & 255
        code[pos + 4] = (av >> 32) & 255
        code[pos + 5] = (av >> 40) & 255
        code[pos + 6] = (av >> 48) & 255
        code[pos + 7] = (av >> 56) & 255
        n = n + 1
        i = i + 1
    }
    return n
}

// natRodataSiteCount reports how many rodata sites have been recorded, so a gate
// can assert a count rather than trusting that resolution happened.
func natRodataSiteCount(s) { return len(s[6]) }
// ============================================================
// Phase 151A Step 9a - the rodata resolution measurement corpus
//
// Four strings with one deliberate duplicate, so interning is observable: the
// oracle's internRodata deduplicates by FIRST USE, so the repeated "-" must
// occupy one entry and the section must be 5 bytes, not 8. An implementation that
// appended every occurrence would produce the same bytes for the first two
// entries and a different length, which is exactly what the length assertion
// catches.
//
// Two reference sites are recorded, at offsets 0 and 2, and then resolved with
// base 0x140000000 and roRVA 0x3000 -- the PE values Step 5/6 use -- so the
// expected addresses are 0x140003000 and 0x140003002.
func natRodataCorpus() {
    let strs = ["-", "\n", "abc", "-"]
    let sec = natRodataSection(strs)
    let rodata = sec[0]
    let offs = sec[1]

    let s = natNewEmitter(0)
    s = natMark(s, "prog")
    s = natRodataRefOff(s, natRegRSI(), offs[0])
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natRodataRefOff(s, natRegRSI(), offs[2])
    s = natMovRegImm32(s, natRegRDI(), 2)

    print(natToHex(rodata))
    print(natToHex(natStCode(s)))

    // Resolve with the PE base and the PE rodata RVA, then emit again: the two
    // immediates are the only bytes that differ between the two lines.
    natResolveRodata(s, 5368709120, 12288)
    print(natToHex(natStCode(s)))
    print(str(natRodataSiteCount(s)))
    return
}


// ============================================================
// Phase 151A Step 9b - the Windows write path and one-state program assembly
//
// WHY THIS SLICE EXISTS. Step 9a could resolve rodata addresses but had nothing
// to resolve them FOR: no whole program was ever emitted. Step 9b assembles one.
//
// The blocker found by measuring, not by planning: print_int writes through the
// LINUX `write` syscall. natWriteStdout is natSysWrite()==1 plus natSyscall, which
// is the oracle's emitWrite NON-WINDOWS body. The oracle's emitWrite switches on
// b.goos and dispatches to emitWinWrite, and that Windows body was never ported.
// So a PE image built from the existing print_int would execute a Linux `syscall`
// instruction on Windows and fault on the first digit -- which is why Step 6's
// PE images deliberately do NOT print.
//
// So Step 9b ports emitWinWrite. Every instruction is the oracle's, in the
// oracle's order.
// ============================================================

// natStdOutHandle is STD_OUTPUT_HANDLE, -11 as the 32-bit constant the oracle
// moves into RCX (4294967285 = 0xFFFFFFF5).
// natRuntimeErrorHelper is the Phase-100/152-B0 runtime-error reporter, the
// body the Go backend calls `emitRuntimeErrorHelper` (program.go:3712-3793).
//
// WHY IT EXISTS ON kcc AT ALL: 152-B0 added 379 lines to
// pkg/native/program.go and touched NO .kark file, so the reporter existed on
// the Go engine only. That is the whole of why `array_index` was 600 bytes short
// of parity -- not a byte-form difference, but a missing mechanism.
//
//	frame layout (offsets are the oracle's constants, not derived):
//	  +0   kind pointer     +8   kind length
//	  +16  file pointer    +24   file length
//	  +32  line            +40..+64  digit scratch, written BACKWARDS from +64
//	  frame = 64
//
// The five argument units are homed into the frame on entry because evaluating
// the arguments already happened at the call site, and the caller's registers
// are not preserved across the calls this body makes.
//
// `rt` is the reporter's own rodata substring list -- ["runtime error: ",
// " at ", ":", "\n"] in interning order -- passed in rather than looked up, so
// this function carries no knowledge of where in the section they landed. That
// is what lets the SAME helper serve any call site (the 152-B1 codec sites come
// later), and it is why the rodata offsets are resolved against the CALLER's
// section rather than computed here.
func natRuntimeErrorHelper(s, rt, winWrite) {
    s = natMark(s, "karkain_runtime_error")
    s = natSubRegImm32(s, natRegRSP(), 64)
    s = natStoreStack(s, natRegRDI(), 0)     // kind ptr
    s = natStoreStack(s, natRegRSI(), 8)     // kind len
    s = natStoreStack(s, natRegRDX(), 16)    // file ptr
    s = natStoreStack(s, natRegRCX(), 24)    // file len
    s = natStoreStack(s, natRegR8(), 32)     // line

    // "runtime error: "
    s = natMovRegImm32(s, natRegRDI(), 2)
    s = natRodataRefOff(s, natRegRSI(), rt[0])
    s = natMovRegImm32(s, natRegRDX(), 15)
    s = natStderrWrite(s, winWrite)

    // <kind>
    s = natLoadStack(s, natRegRSI(), 0)
    s = natLoadStack(s, natRegRDX(), 8)
    s = natMovRegImm32(s, natRegRDI(), 2)
    s = natStderrWrite(s, winWrite)

    // " at "
    s = natMovRegImm32(s, natRegRDI(), 2)
    s = natRodataRefOff(s, natRegRSI(), rt[1])
    s = natMovRegImm32(s, natRegRDX(), 4)
    s = natStderrWrite(s, winWrite)

    // <file>
    s = natLoadStack(s, natRegRSI(), 16)
    s = natLoadStack(s, natRegRDX(), 24)
    s = natMovRegImm32(s, natRegRDI(), 2)
    s = natStderrWrite(s, winWrite)

    // ":"
    s = natMovRegImm32(s, natRegRDI(), 2)
    s = natRodataRefOff(s, natRegRSI(), rt[2])
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natStderrWrite(s, winWrite)

    // <line> as decimal -- the SAME divide-by-10 digit loop print_int uses, with
    // the digit pointer walking DOWN from the frame top so the byte count is
    // (frame top) - (current pointer). The oracle states that the line is always
    // > 0 so no sign handling is needed and the digit area cannot underflow; a
    // call site with no line reports the kind alone.
    s = natLoadStack(s, natRegRAX(), 32)
    s = natLeaRegStack(s, natRegRSI(), 64)
    s = natMovRegImm32(s, natRegRCX(), 10)
    s = natMark(s, "rtline$loop")
    s = natCqo(s)
    s = natDivReg(s, natRegRCX())
    s = natAddRegImm32(s, natRegRDX(), 48)   // 48 is '0'
    s = natDecReg(s, natRegRSI())
    s = natStoreMem8(s, natRegRSI(), natRegRDX())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "rtline$loop")
    // RDX = byte count = (frame top) - RSI, with RSI still the start pointer.
    s = natLeaRegStack(s, natRegRDX(), 64)
    s = natSubRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegImm32(s, natRegRDI(), 2)
    s = natStderrWrite(s, winWrite)

    // "\n"
    s = natMovRegImm32(s, natRegRDI(), 2)
    s = natRodataRefOff(s, natRegRSI(), rt[3])
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natStderrWrite(s, winWrite)

    // exit(1)
    s = natExitWithCode(s, 1, winWrite)
    // The oracle emits the teardown and a ret even though the block above never
    // returns. That is not dead code to be tidied away: it is what makes the
    // helper a well-formed callee for every CALLER, and the array-index
    // call site relies on the reporter being callable the ordinary way.
    s = natAddRegImm32(s, natRegRSP(), 64)
    return natRet(s)
}

// The map runtime: natMapFind, natMapSet and natMapGet, the byte-for-byte
// counterparts of emitMapFind / emitMapSet / emitMapGet.
//
// WHY THESE EXIST ON kcc FOR A PROGRAM WITH NO MAP is the D5 baseline's ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â§3.1
// finding, and it is not a porting error to reproduce. The Go backend's
// scanMapUsage decides "is this a map index" with:
//
//	_, isVar := ix.Left.(*parser.Identifier)
//	return isVar
//
// -- purely the syntactic shape `name[...]`, never the receiver's kind. So
// `print(a[1])` on an ARRAY sets usesMap = true and the oracle emits all three
// helpers as code the program can never reach. Byte-identity is defined as
// agreement with the oracle, so kcc emits them on the SAME predicate.
//
// `natNativeUsesMap` below therefore implements `isMapIndex` deliberately, and
// its comment names the over-approximation rather than quietly widening it. The
// alternative -- tightening BOTH engines to consult the receiver's kind -- is
// recorded in the baseline as an owner decision, because it changes the Go
// backend and every frozen Go-side gold.
//
// LABEL NAMES again come from natFresh in the oracle's allocation order, for
// the Step 3 reason: a rel32 stores a displacement, so a wrong label name can
// leave every byte identical while the discipline is wrong.

// natMapFind scans the entries and returns the address of the one whose key
// matches, or 0. RDI = map address, RSI = key. RAX = result.
func natMapFind(s) {
    let fa = natFresh(s, "mapfind")
    s = fa[0]
    let loop = fa[1]
    let fb = natFresh(s, "mapfind$found")
    s = fb[0]
    let found = fb[1]
    let fc = natFresh(s, "mapfind$miss")
    s = fc[0]
    let notFound = fc[1]
    s = natMark(s, "map_find")
    // R8 = map, RCX = index, R9 = count.
    s = natMovRegReg(s, natRegR8(), natRegRDI())
    s = natXorRegReg(s, natRegRCX())
    s = natLoadBaseOff(s, natRegR9(), natRegR8(), natMapCountOff())
    s = natMark(s, loop)
    s = natCmpRegReg(s, natRegRCX(), natRegR9())
    s = natJge(s, notFound)
    // entry = map + mapHeaderBytes + index*mapEntryBytes
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natShlRegImm(s, natRegRAX(), natMapEntryShift())
    s = natAddRegReg(s, natRegRAX(), natRegR8())
    s = natAddRegImm32(s, natRegRAX(), natMapHeaderBytes())
    s = natLoadBaseOff(s, natRegRDX(), natRegRAX(), natMapKeyOff())
    s = natCmpRegReg(s, natRegRDX(), natRegRSI())
    s = natJz(s, found)
    s = natIncReg(s, natRegRCX())
    s = natJmp(s, loop)
    s = natMark(s, found)
    s = natRet(s)
    s = natMark(s, notFound)
    s = natXorRegReg(s, natRegRAX())
    return natRet(s)
}

// natMapSet stores key -> (v0, v1), appending when the key is absent.
// RDI = map, RSI = key, RDX = value0, RCX = value1.
//
// map_find clobbers RDX and RCX, so the value pair is staged in a 16-byte
// helper frame first. That frame is entirely internal: the helper restores rsp
// before every ret, so a caller never sees it.
func natMapSet(s) {
    let fa = natFresh(s, "mapset$full")
    s = fa[0]
    let full = fa[1]
    let fb = natFresh(s, "mapset$appended")
    s = fb[0]
    let appended = fb[1]
    s = natMark(s, "map_set")
    s = natSubRegImm32(s, natRegRSP(), 16)
    s = natStoreStack(s, natRegRDX(), 0)
    s = natStoreStack(s, natRegRCX(), 8)
    s = natCall32(s)
    let r = natRel32(s, "map_find")
    s = r[0]
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJz(s, appended)
    // Existing entry: overwrite key and both value units.
    s = natStoreBaseOff(s, natRegRSI(), natRegRAX(), natMapKeyOff())
    s = natLoadStack(s, natRegRDX(), 0)
    s = natStoreBaseOff(s, natRegRDX(), natRegRAX(), natMapVal0Off())
    s = natLoadStack(s, natRegRDX(), 8)
    s = natStoreBaseOff(s, natRegRDX(), natRegRAX(), natMapVal1Off())
    s = natAddRegImm32(s, natRegRSP(), 16)
    s = natRet(s)
    s = natMark(s, appended)
    // RDI still holds the map (map_find never writes it).
    s = natLoadBaseOff(s, natRegR8(), natRegRDI(), natMapCountOff())
    s = natLoadBaseOff(s, natRegR9(), natRegRDI(), natMapCapOff())
    s = natCmpRegReg(s, natRegR8(), natRegR9())
    s = natJae(s, full)
    // entry = map + mapHeaderBytes + count*mapEntryBytes
    s = natMovRegReg(s, natRegRCX(), natRegR8())
    s = natShlRegImm(s, natRegRCX(), natMapEntryShift())
    s = natAddRegReg(s, natRegRCX(), natRegRDI())
    s = natAddRegImm32(s, natRegRCX(), natMapHeaderBytes())
    s = natStoreBaseOff(s, natRegRSI(), natRegRCX(), natMapKeyOff())
    s = natLoadStack(s, natRegRDX(), 0)
    s = natStoreBaseOff(s, natRegRDX(), natRegRCX(), natMapVal0Off())
    s = natLoadStack(s, natRegRDX(), 8)
    s = natStoreBaseOff(s, natRegRDX(), natRegRCX(), natMapVal1Off())
    s = natIncReg(s, natRegR8())
    s = natStoreBaseOff(s, natRegR8(), natRegRDI(), natMapCountOff())
    s = natAddRegImm32(s, natRegRSP(), 16)
    s = natRet(s)
    s = natMark(s, full)
    // Out of capacity. The oracle traps rather than growing: map capacity is a
    // compile-time bound (see scanMapUsage), so reaching this means the bound
    // was wrong, and an Int3 says so instead of corrupting a neighbouring
    // entry.
    s = natInt3(s)
    s = natAddRegImm32(s, natRegRSP(), 16)
    return natRet(s)
}

// natMapGet returns the value pair for a key. RDI = map, RSI = key.
// RAX = value0, RDX = value1.
func natMapGet(s) {
    let fa = natFresh(s, "mapget$miss")
    s = fa[0]
    let miss = fa[1]
    let fb = natFresh(s, "mapget$have")
    s = fb[0]
    let have = fb[1]
    s = natMark(s, "map_get")
    s = natCall32(s)
    let r = natRel32(s, "map_find")
    s = r[0]
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJz(s, miss)
    // R8 = entry, so loading into RAX cannot destroy the base.
    s = natMovRegReg(s, natRegR8(), natRegRAX())
    s = natLoadBaseOff(s, natRegRAX(), natRegR8(), natMapVal0Off())
    s = natLoadBaseOff(s, natRegRDX(), natRegR8(), natMapVal1Off())
    s = natMark(s, have)
    s = natRet(s)
    s = natMark(s, miss)
    s = natXorRegReg(s, natRegRAX())
    s = natXorRegReg(s, natRegRDX())
    return natRet(s)
}

// The map layout constants, mirroring the Go block at program.go:173-190.
//
// Written as ARITHMETIC rather than literals wherever the value is derived, so
// a reader can check the derivation. 32 is 1<<5, which is why the oracle shifts
// rather than multiplies, and the header is TWO units (count, capacity).
func natMapHeaderUnits() { return 2 }
func natMapEntryUnits() { return 4 }
func natMapEntryShift() { return 5 }
func natMapHeaderBytes() { return natMapHeaderUnits() * 8 }
func natMapCountOff() { return 0 }
func natMapCapOff() { return 8 }
func natMapKeyOff() { return 0 }
func natMapVal0Off() { return 8 }
func natMapVal1Off() { return 16 }

// natNativeUsesMap is the kcc form of scanMapUsage's usesMap for the ONE
// question D5 needs: does the program contain an `name[...]`?
//
// It deliberately implements the oracle's over-approximation (see the section
// header above) rather than checking the receiver's kind. A future increment
// that tightens BOTH engines must change this function and isMapIndex TOGETHER,
// which is why the predicate is named after isMapIndex rather than after what
// it means.
//
// The two call shapes D5 can lower -- an index in print position and an index
// in return position -- are both checked, because the gate and the lowering must
// not disagree: a shape the gate misses is emitted with no map runtime, and a
// shape it sees that the lowering refuses is dead weight.
func natNativeUsesMap(stmts) {
    let i = 0
    while (i < len(stmts)) {
        if (natStmtHasIndex(stmts[i]) == 1) { return 1 }
        i = i + 1
    }
    return 0
}

// natNativeProgramUsesMap is the PROGRAM-WIDE map-usage flag.
//
// NAT-FRAME: this exists because the oracle's `b.usesMap` is a property of the
// WHOLE PROGRAM (program.go:1571: `mapUses, mapLoop, mapCap, mapHeap :=
// scanMapUsage(prog)`), and the oracle's per-function layout reserves the
// map-stage slot in EVERY function when it is set (program.go:4461).
//
// The driver reserved that slot in NO function, because the two layout call
// sites passed a literal 0 for the flag. The consequence was an 8-byte frame
// difference in every program that indexes an array -- and an array access IS a
// map use to the oracle, because its `isMapIndex` predicate is "an index
// expression whose target is a VARIABLE" (program.go:730-737), which an array
// access satisfies.
//
// So the flag is computed once, over the whole program, and threaded to every
// function's layout -- which is what the oracle does.
func natNativeProgramUsesMap(body, fns) {
    if (natNativeUsesMap(body) == 1) { return 1 }
    let i = 0
    while (i < natNativeFuncCount(fns)) {
        if (natNativeUsesMap(natNativeFuncBodyAt(fns, i)) == 1) { return 1 }
        i = i + 1
    }
    return 0
}

func natStdOutHandle() { return 4294967285 }

// natStdErrHandle is STD_ERROR_HANDLE (0xFFFFFFF6), the counterpart of
// natStdOutHandle's 0xFFFFFFF5.
//
// WRITTEN AS ARITHMETIC, NOT AS A LITERAL, and the reason is the Step 8b
// lesson. 0xFFFFFFF6 is 4294967286, which is PAST the largest signed 64-bit
// value's 32-bit range and past this language's literal clamp -- the Step 8b
// record is the `1<<63` sign mask silently clamped to ...807, which produced a
// wrong immediate that compiled cleanly and printed every negative float
// without its sign.
//
// So it is written as `-10`. That is not a clever encoding: MovRegImm32 masks
// its immediate to 32 bits, and -10's two's-complement 32-bit form is exactly
// 0xFFFFFFF6. The arithmetic keeps the -10 <-> 0xFFFFFFF6 relationship visible to
// a reader, where a bare 4294967286 would look like it should work and would
// not.
func natStdErrHandle() { return 0 - 10 }

// natWinWriteStderr is natWinWrite with STD_ERROR_HANDLE in place of
// STD_OUTPUT_HANDLE -- the whole of the difference, because the oracle factors
// the two out as emitWriteStderr -> emitWinWriteHandle(handle).
//
// The 152-B0 / 152-B1 record is that on THIS HOST stderr output is empty for PE
// images, because GetStdHandle(STD_ERROR_HANDLE) returns INVALID_HANDLE_VALUE on
// a minimal image. That is a property of the ROUTE, not of kcc: the Go backend
// goes through the identical sequence and is equally silent, exiting 1 with no
// output. So this function reproduces the oracle's route rather than routing
// somewhere that "works better" -- a stdout diagnostic would be a DIVERGENCE
// from the oracle, not an improvement, and would cost byte-identity.
func natWinWriteStderr(s) {
    s = natPushReg(s, natRegRBX())
    s = natPushReg(s, natRegRSI())
    s = natPushReg(s, natRegRDX())
    s = natSubRegImm32(s, natRegRSP(), 32)
    s = natMovRegImm32(s, natRegRCX(), natStdErrHandle())
    s = natIatCall(s, natRegRAX(), natIatGetStdHandle())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 32)
    s = natPopReg(s, natRegRDX())
    s = natPopReg(s, natRegRSI())
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natMovRegReg(s, natRegR8(), natRegRDX())
    s = natMovRegReg(s, natRegRDX(), natRegRSI())
    s = natSubRegImm32(s, natRegRSP(), 48)
    s = natLeaRegStack(s, natRegR9(), 24)
    s = natXorRegReg(s, natRegRAX())
    s = natStoreStack(s, natRegRAX(), 32)
    s = natIatCall(s, natRegRAX(), natIatWriteFile())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 48)
    return natPopReg(s, natRegRBX())
}

// natWriteStderr is the LINUX/macOS body of the oracle's emitWriteStderr: fd 2
// plus the raw write syscall. The Windows body is natWinWriteStderr.
//
// It is natPayloadWrite with the descriptor changed from 1 to 2, and NOT a
// generalisation of natWriteStdout: the oracle spells the two out separately, so
// keeping them separate here is what lets the frozen stdout bytes stay frozen.
func natWriteStderr(s) {
    s = natMovRegImm32(s, natRegRDI(), 2)
    s = natMovRegImm32(s, natRegRAX(), 1)   // Linux write(2)
    return natSyscall(s)
}

// natStderrWrite dispatches on the OS, matching emitWriteStderr's switch.
func natStderrWrite(s, winWrite) {
    if (winWrite == 1) { return natWinWriteStderr(s) }
    return natWriteStderr(s)
}

// natExitWithCode mirrors Builder.emitExitWithCode (program.go:2279):
// ExitProcess(code) on Windows, exit(code) through the raw syscall elsewhere.
// Phase 100 ends every runtime diagnostic with exit code 1, and that 1 is the
// OBSERVABLE on this host -- stderr is empty, so the exit code is what a test
// can actually assert (the 152-B1 record asserts it for the same reason).
//
// The Windows body does NOT rebalance rsp or return: ExitProcess does not
// return, and the oracle returns immediately after the iatCall without adding
// back the shadow it just subtracted.
func natExitWithCode(s, code, winWrite) {
    if (winWrite == 1) {
        s = natMovRegImm32(s, natRegRCX(), code)
        s = natSubRegImm32(s, natRegRSP(), 32)
        s = natIatCall(s, natRegRAX(), natIatExitProcess())
        return natCallReg(s, natRegRAX())
    }
    s = natMovRegImm32(s, natRegRDI(), code)
    s = natMovRegImm32(s, natRegRAX(), 60)   // Linux exit(2)
    return natSyscall(s)
}

// natWinWrite mirrors Builder.emitWinWrite in pkg/native/program.go.
//
// Contract: write (RSI=ptr, RDX=len) to stdout through kernel32 WriteFile.
//
// Two facts in the oracle's own comment are load-bearing and are reproduced
// rather than re-derived:
//
//  1. PUSH ORDER. RBX is pushed FIRST (deepest) because its POP happens LAST; it
//     has to survive BOTH kernel32 calls, and print_int keeps an end pointer in
//     RBX across writes. A Phase 150C defect once pushed RSI,RDX,RBX but popped
//     RDX,RSI,...,RBX, so every pop read the wrong slot; WriteFile then received a
//     garbage pointer and length, wrote nothing, and returned without an error --
//     so the process exited 0 with EMPTY stdout, which is exactly what the
//     `if out != ""` guard in the PE tests silently skips. This ordering is
//     therefore load-bearing for the test to mean anything, not a style choice.
//
//  2. 48, NOT 40, for the WriteFile shadow. RBX is still live on the stack (8
//     bytes), so the caller's rsp already sits 8 lower than the pre-push baseline;
//     48 keeps rsp%16 == 0 at the call where 40 would flip it to 8 and fault
//     inside kernel32.
func natWinWrite(s) {
    s = natPushReg(s, natRegRBX())
    s = natPushReg(s, natRegRSI())
    s = natPushReg(s, natRegRDX())
    // 32 = the Win64 caller shadow for GetStdHandle. With three live pushes
    // (24 bytes) above it, rsp%16 lands on 0 before the call.
    s = natSubRegImm32(s, natRegRSP(), 32)
    s = natMovRegImm32(s, natRegRCX(), natStdOutHandle())
    s = natIatCall(s, natRegRAX(), natIatGetStdHandle())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 32)
    s = natPopReg(s, natRegRDX())
    s = natPopReg(s, natRegRSI())
    // Win64 WriteFile(hFile=RCX, lpBuffer=RDX, nBytes=R8, written=R9):
    // the handle comes from GetStdHandle in RAX, and ptr/len must be moved into
    // RDX/R8 AFTER the pops, because the GetStdHandle call clobbered RCX/RDX.
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natMovRegReg(s, natRegR8(), natRegRDX())
    s = natMovRegReg(s, natRegRDX(), natRegRSI())
    s = natSubRegImm32(s, natRegRSP(), 48)
    s = natLeaRegStack(s, natRegR9(), 24)
    s = natXorRegReg(s, natRegRAX())
    s = natStoreStack(s, natRegRAX(), 32)
    s = natIatCall(s, natRegRAX(), natIatWriteFile())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 48)
    // Win64 WriteFile may clobber RCX/RDX (and R8-R11) on return, so the
    // caller's RBX is restored after the shadow is released.
    s = natPopReg(s, natRegRBX())
    return s
}


// ============================================================
// Phase 151A Step 9b - ONE-STATE PE PROGRAM ASSEMBLY
//
// Steps 1-8f and 9a all emitted CORRECTLY but never TOGETHER into one runnable
// program: each was a corpus shape compared against the oracle, and Step 9a could
// resolve rodata addresses but had nothing to resolve them FOR. Step 9b is the
// first composition, and it is deliberately small:
//
//	_start -> karkain_main -> print_int
//
// All three pieces go into ONE emitter state, which is the whole point. Two states
// cannot work: print_int's rodata sites would live in a different state from the
// linker's, so nothing could join them, and the IAT indices the print path
// contributes would have to be recovered from emission order.
//
// WHAT THIS IS NOT, stated before it is misread: this is still a fixed program
// compiled into kcc, NOT the whole-program driver 151A still owes. The driver is
// what makes kcc own native targets; this proves the MACHINERY -- one state,
// resolved rodata, index-tagged IAT, a real linked image -- so the driver has
// something to drive.
// ============================================================

// The PE load base and .text RVA are NOT redefined here: native_pe.kark already
// declares natPEBaseAddr (0x140000000) and natPETextRVA (0x1000) as the
// container's own constants, and a second pair with the same values would be two
// facts that could disagree. Reusing them means a change to the container's base
// propagates here automatically instead of silently resolving every rodata
// address against a stale number.

// natFlatPairs interleaves two parallel lists into the flat [pos, idx, pos, idx]
// shape natPELink takes.
//
// The oracle's patch slices are Go structs; Karkain has no records, so the pairing
// is expressed as a flat array of alternating position and index. That is also why
// there are TWO lists per kind rather than one: a flat array cannot be indexed as
// a pair without knowing where each pair starts, and recomputing that per element
// is exactly the kind of arithmetic a wrong assumption hides inside.
func natFlatPairs(posArr, idxArr) {
    let out = []
    let i = 0
    while (i < len(posArr)) {
        out = appendArray(out, posArr[i])
        out = appendArray(out, idxArr[i])
        i = i + 1
    }
    return out
}

// natPEPrintValue is the value karkain_main prints. A distinctive literal on
// purpose: a program that prints 0, or prints nothing, is indistinguishable from
// a program whose print path silently wrote to a bad handle -- which is precisely
// the failure mode Step 9b exists to make impossible.
func natPEPrintValue() { return 12345 }

// natPEMainBody emits karkain_main's body into an existing state.
//
// It is factored out because BOTH natPEProgram and natPEShape need it, and a
// gate that inspected a separately rebuilt text would be testing a second
// emission -- the same class of failure as comparing a transcription instead of a
// compiler.
//
// The `sub rsp, 40` is Win64 ABI, not decoration: _start aligned rsp to 16 and
// then called, so rsp % 16 == 8 at main entry, and a Win64 call site requires
// rsp % 16 == 0 immediately before the `call`. 40 = 32 bytes of caller shadow
// space plus 8 bytes that restore the alignment. Without it the callee is entered
// misaligned and kernel32 faults on the first call inside print_int.
//
// RAX is main's return value and _start passes it straight to ExitProcess, so 0
// is both "return 0" and "exit code 0".
func natPEMainBody(s) {
    s = natSubRegImm32(s, natRegRSP(), 40)
    s = natMovRegImm32(s, natRegRDI(), natPEPrintValue())
    s = natCall32(s)
    let r = natRel32(s, "print_int")
    s = r[0]
    s = natAddRegImm32(s, natRegRSP(), 40)
    s = natMovRegImm32(s, natRegRAX(), 0)
    return natRet(s)
}

// natPEProgram builds the whole Step 9b PE image: _start, karkain_main,
// print_int, resolved rodata, index-tagged IAT patches, and a linked image.
//
// The rodata section is interned FIRST-USE across the program's references.
// print_int references "-" on the sign path and "\n" for the terminator, in that
// emission order, so the offsets are 0 and 1. Those are passed into
// natPrintIntBody rather than interned inside it, because interning is a property
// of the whole program: once another function contributes a rodata string the
// offsets move, and a helper that invented its own would be wrong.
func natPEProgram() {
    // natWinStub emits _start, the alignment, the PEB bootstrap, the call to
    // karkain_main and the Win64 exit tail, then MARKS karkain_main -- so
    // everything appended by natPEMainBody lands inside main.
    let s = natWinStub()
    s = natPEMainBody(s)
    // print_int, in the SAME state. winWrite = 1 selects the Windows write path
    // ported above; rodata offsets 0 ("-") and 1 ("\n").
    s = natPrintIntBody(s, 1, 0, 1)
    let text = natFinish(s)

    // Resolve rodata against the REAL PE layout. pkg/native/pe.go lays .text out
    // as code followed by rodata, so a rodata byte at offset `off` is at
    // PEBase + textRVA + len(text) + off. len(text) is MEASURED from the finished
    // text and never assumed: a hard-coded length would resolve every address in a
    // program whose main body differed by even one byte, and every such program
    // would still LINK -- it would just read the wrong memory.
    let ro = natRodataSection(["-", "\n"])
    // NOT `s = natResolveRodata(...)`: that function returns the NUMBER of sites
    // it resolved, not the state. Assigning it would overwrite the emitter with
    // an integer, and every subsequent natSt* accessor would read an int's "slot"
    // and return 0 -- silently producing an image with NO resolved rodata and NO
    // IAT patches, which still links and still has the right length. Arm 3 exists
    // precisely to make that failure visible; this is the bug it was added for.
    natResolveRodata(s, natPEBaseAddr() + natPETextRVA() + len(text), 0)

    // THE RODATA PATCH LIST GOES TO THE LINKER, and that is the fix for a real
    // defect this slice's own execution evidence exposed.
    //
    // natPELink does TWO things with it: it writes the immediate (roBase + offset,
    // the same formula used here) AND it adds a DIR64 entry for each site. Passing
    // an EMPTY list -- which the first version did -- resolved nothing through the
    // linker and put NO relocation entry on either rodata site.
    //
    // This image sets DYNAMIC_BASE and HIGH_ENTROPY_VA, and the host DOES rebase
    // it, so those two immediates kept the preferred load address and pointed at
    // unmapped memory.
    //
    // The symptom was the nastiest kind available. print_int wrote its digits from
    // the STACK (no absolute address, so unaffected), then its newline write read
    // from an unmapped pointer, and WriteFile failed, wrote ZERO bytes and returned
    // no error -- so the process exited 0. Every structural layer passed: the image
    // was a valid PE, the rodata addresses were exactly the ones this file
    // computed, the IAT pairing was right. All of them were checked against the
    // FILE, and the FILE is correct. Only running it could see this, which is why
    // the execution layer is not optional here, and why an assertion that trims
    // whitespace off stdout is not enough: the missing byte was the newline.
    let rp = natFlatPairs(natStRodataPos(s), natStRodataOff(s))

    // IAT patches come from the recorded per-kind lists, never from position.
    //   apatches: absolute STORES of resolved kernel32 addresses (the bootstrap)
    //   ipatches: IAT LOADS, i.e. `movabs rax, <slot>` the print path and the exit
    //             tail emit before `call rax`
    // print_int's Windows write contributes FOUR ipatches -- GetStdHandle and
    // WriteFile for each of its two write sites that a positive value reaches --
    // and the exit tail one, on top of the bootstrap's three apatches. The sign
    // write is a third emitted site and adds two more, for 7 ipatches in total.
    // A positional reader would pair the wrong ones.
    let ap = natFlatPairs(natStAbsPos(s), natStAbsIdx(s))
    let ip = natFlatPairs(natStIatPos(s), natStIatIdx(s))
    return natPELink(text, ro[0], [], rp, ip, ap, [], natPETextOff(), natPETextOff())
}

// natPECorpusProg renders the Step 9b composition in four shapes, so a failure
// names a SUBSYSTEM rather than pointing into one long image.
//
//  0 the linked PE image        - the composition, and what 9c will execute
//  1 the resolved .text         - rodata immediates and the main->print call
//  2 the rodata section         - interning and placement
//  3 a count report             - sites and patch kinds, so a resolver that filled
//                                 nothing cannot pass against an all-zero buffer
//
// Arm 3 is deliberately NOT hex. The site and patch counts are the guard against a
// vacuous pass: an image whose placeholders were never filled has the same length
// and the same structure as a correct one, and only the counts prove the work
// happened.
func natPECorpusProg(which) {
    if (which == 0) { return natToHex(natPEProgram()) }
    if (which == 1) { return natToHex(natPEShape(1)) }
    if (which == 2) { return natToHex(natPEShape(2)) }
    if (which == 3) { return natPEShape(3) }
    return ""
}

// natPEShape produces one intermediate of the composition.
//
// The program body is factored out so arms 1 and 2 observe the SAME emission the
// linked image is built from. A gate that rebuilt the text separately to inspect
// it would be testing a second emission, and a defect in the shared path would be
// invisible to it.
func natPEShape(which) {
    let s = natWinStub()
    s = natPEMainBody(s)
    s = natPrintIntBody(s, 1, 0, 1)
    let text = natFinish(s)
    let ro = natRodataSection(["-", "\n"])
    natResolveRodata(s, natPEBaseAddr() + natPETextRVA() + len(text), 0)
    if (which == 1) { return text }
    if (which == 2) { return ro[0] }
    return "sites=" + str(natRodataSiteCount(s)) +
           " ap=" + str(len(natStAbsPos(s))) +
           " ip=" + str(len(natStIatPos(s)))
}

// ============================================================
// Phase 151A Step 9c - the whole-program driver
//
// Step 9b proved the MACHINERY: one emitter state, resolved rodata, index-tagged
// IAT, a real linked image that runs. But its program was a FIXED shape compiled
// into kcc -- `_start + karkain_main(with a hard-coded value) + print_int` -- so
// kcc could demonstrate native execution while still being unable to compile a
// USER'S program.
//
// This is the piece that changes the architecture from "fixed program" to
// "user AST -> native emission". The driver walks the REAL AST that
// `buildNativeFile` already parsed and type-checked, finds `func main` by NAME,
// sizes a frame from main's ACTUAL int locals, lowers each of its statements, and
// refuses anything it cannot lower.
//
// WHAT MAKES IT REAL, stated precisely because the failure this increment exists
// to remove is a compiler that looks like it is doing the work while something
// else does it:
//   * `main` is located by NAME in the program's real top-level statement list.
//     There is no `if program == knownCorpusProgram` anywhere, and no corpus: the
//     driver never learns which file it was given.
//   * the frame size is DERIVED from the count of `let` bindings main actually has,
//     through the same natFrameLayout the value model uses, so two locals and one
//     local produce different frames.
//   * a local's slot comes from its DECLARATION ORDER (natLocalOff), not a table.
//   * `print` resolves an IDENTIFIER to the slot of the binding that introduced
//     it, so `let x = 7; print(x)` and `print(7)` are genuinely different
//     lowerings rather than the same bytes with a different label.
//
// SCOPE, stated as a bound rather than an aspiration. This slice lowers exactly
// what 9b already proved, driven by the AST instead of hard-coded:
//   let <name> = <int literal>
//   print(<int literal>) | print(<name>)
//   return <int literal> | return <name>
// Anything else is a LOUD refusal naming the construct and its line. It is not a
// silent skip and not a fallback to the Go engine.
//
// NOT CLAIMED: whole-program parity with the Go engine, loops, arrays, strings
// beyond print_int's own literals, calls, records or maps. Those are the rest of
// 151A.
// ============================================================

// natNativeFindMain returns the FuncDecl node named `main`, or 0 when there is
// none. It is a NAME lookup, not a shape match: any function called `main` is the
// entry point regardless of how many others exist.
func natNativeFindMain(stmts) {
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        if (nodeType(n) == NODE_FUNC_DECL()) {
            if (funcName(n) == "main") { return n }
        }
        i = i + 1
    }
    return 0
}

// natNativeBodyStmts returns main's statement list.
//
// `funcBody` IS already the statement list -- parseBlock returns its statements
// directly rather than wrapping them in a Block node. The first draft of this
// driver assumed it was a Block, fell through to its single-element fallback, and
// therefore handed the scanner a LIST where it expected a statement: every
// element read back with an empty node type and the refusal text said "statement
// kind [array]". The checker's own consumer is the authority here -- it calls
// checkStmts(tab, funcBody(node), 0) with no unwrapping -- so this does the same.
func natNativeBodyStmts(mainFn) {
    return funcBody(mainFn)
}

// natNativeIsDecl reports whether a statement introduces a binding.
//
// `let` and `var` produce DIFFERENT node kinds -- makeLetDecl vs makeVarDecl,
// i.e. NODE_LET_DECL vs NODE_VAR_DECL -- and the checker tests for both. A first
// draft matched only NODE_VAR_DECL, so `let x = 1` was not recognised as a
// binding at all and was reported as an unsupported statement kind. `const` is
// deliberately NOT a binding here: it is NODE_CONST_DECL and stays unsupported,
// because a constant is not a frame slot.
func natNativeIsDecl(n) {
    let t = nodeType(n)
    return t == NODE_LET_DECL() || t == NODE_VAR_DECL()
}

func natNativeDeclName(n) {
    if (nodeType(n) == NODE_LET_DECL()) { return letDeclName(n) }
    return varDeclName(n)
}

func natNativeDeclValue(n) {
    if (nodeType(n) == NODE_LET_DECL()) { return letDeclValue(n) }
    return varDeclValue(n)
}

func natNativeDeclLine(n) {
    if (nodeType(n) == NODE_LET_DECL()) { return letDeclLine(n) }
    return varDeclLine(n)
}

// natNativeSlotIndex returns the slot index of the local or PARAMETER called
// `name`, or -1.
//
// It searches the PLAN, not the statement list, and that is a correctness
// requirement rather than a tidy-up. A parameter has no declaration statement
// inside the body, so no body walk can ever find one; NAT-CALL gives every
// function's parameters the plan's first slots, and the plan carries each
// slot's NAME so both kinds of binding resolve through one lookup.
//
// Declaration order IS the slot order (natLocalOff), the same rule the oracle's
// layout() uses -- parameters first, then body bindings -- so the two agree on
// layout without sharing a table. The FIRST binding wins: re-binding a name is
// shadowing, which is a later slice, and silently using the last one would let
// the frame and the value disagree.
func natNativeSlotIndex(plan, name) {
    let i = 0
    while (i < natNativePlanCount(plan)) {
        if (natNativeSlotName(plan, i) == name) { return i }
        i = i + 1
    }
    return 0 - 1
}

// ============================================================
// Phase 151A Step 9d -- native arrays through the real AST driver.
//
// Step 9c's driver handled integers only. This adds the SMALLEST array subset the
// existing native value model can honestly support, driven from the real AST:
//
//     let a = [<int>, <int>, ...]
//     print(a[<int>])
//
// THE ORACLE'S FRAME CONTRACT, reproduced exactly:
//     [off]            = address of the element area
//     [off + 8]        = element count
//     [off + 16 + i*8] = element i
// An array local therefore occupies a TWO-unit header plus 8 bytes per element, all
// in the frame, and NOTHING is allocated. rsp never moves and the element base
// never sits in rsp, so every element access is a constant-displacement SIB through
// a register.
//
// MEASURED BOUNDARY, stated rather than papered over. The oracle's out-of-range path
// calls karkain_runtime_error with the source file and line, which is increment
// 152-B0 machinery: a runtime-error helper, source-filename plumbing and a new rodata
// string. None of that exists in kcc and this slice does not build it. The bound IS
// checked, and an out-of-range index TRAPS with Int3 -- exactly the behaviour
// increment 150A measured and recorded ("arr[i] with a checked bound (negative or
// >= len traps)"). An in-range index executes correctly, which is what the gate
// proves.
//
// NOT IN THIS SLICE: len(), for-in, push, string elements, nested arrays, printing an
// array as a whole, or arrays as call arguments. Each is a separate capability.
// ============================================================

// natNativePlan builds the slot plan: one [offset, kind, elemCount] triple per local,
// in DECLARATION ORDER, sized exactly as the oracle's scanLets sizes them.
//
// The offset is SEQUENTIAL rather than 8 * index * units, because an array owns a
// variable-sized element area that the fixed-stride formula cannot express. That is
// the same reason the oracle allocates sequentially: an array is a two-unit header
// plus 8 bytes per element, so the next local starts after that area.
// ============================================================
// Step 9h-1 - records: declaration collection and layout table
// ============================================================
//
// A record VALUE is exactly one 8-byte unit whose content is the ADDRESS of a
// compile-time-sized field area (the oracle's KindStruct). Nothing is allocated, so a
// record program stays out of the heap arena entirely.
//
// Layout is the oracle's newStructInfo exactly: DECLARATION ORDER; int and float occupy
// 1 unit, string occupies 2 units (ptr+len); every field starts on an 8-byte boundary,
// so no padding rule exists and none is added.
//
// The table is a FLAT array because Karkain has no structs. Per record:
//
//   name, size, fieldCount, then fieldCount triples of (fieldName, off, kind)
//
// natStructFieldOff / natStructFieldKind resolve a field to its compile-time constants,
// so a field access is ONE load/store at a constant displacement with no runtime
// descriptor and no per-field tag.

func natFieldSpecName(spec) {
  let c = indexOf(spec, ":")
  if (c < 0) { return spec }
  return substr(spec, 0, c)
}

func natFieldSpecType(spec) {
  let c = indexOf(spec, ":")
  if (c < 0) { return "" }
  return substr(spec, c + 1, len(spec) - c - 1)
}

// natFieldSpecKind mirrors newStructInfo's switch exactly. Anything that is not
// int/string/float becomes natKindUnsupported(), which callers refuse LOUDLY rather
// than silently mis-sizing the record. Nested records, arrays and maps inside a struct
// are not in 150B3b.
func natFieldSpecKind(ty) {
  if (ty == "string") { return natKindString() }
  if (ty == "float") { return natKindFloat() }
  if (ty == "int") { return natKindInt() }
  if (ty == "") { return natKindInt() }
  return natKindUnsupported()
}

func natKindUnsupported() { return 0 - 1 }

// natStructTable collects every top-level `type X struct {...}` declaration in
// declaration order. Karkain has no reflection: this is the whole of the compile-time
// record information the lowering needs.
func natStructTable(stmts) {
  let tbl = []
  let i = 0
  while (i < len(stmts)) {
    let n = stmts[i]
    if (nodeType(n) == NODE_STRUCT_DECL()) { tbl = natStructPushDecl(tbl, n) }
    i = i + 1
  }
  return tbl
}

func natStructPushDecl(tbl, d) {
  let specs = structDeclFields(d)
  let rec = []
  let size = 0
  let j = 0
  while (j < len(specs)) {
    let sp = specs[j]
    let fk = natFieldSpecKind(natFieldSpecType(sp))
    rec = appendArray(rec, natFieldSpecName(sp))
    rec = appendArray(rec, size)
    rec = appendArray(rec, fk)
    size = size + 8 * natKindUnits(fk)
    j = j + 1
  }
  tbl = appendArray(tbl, structDeclName(d))
  tbl = appendArray(tbl, size)
  tbl = appendArray(tbl, len(specs))
  let r = 0
  while (r < len(rec)) { tbl = appendArray(tbl, rec[r]); r = r + 1 }
  return tbl
}

// natStructRecAt returns the index of a record's fieldCount entry, or -1 when the type
// is unknown. Stepping to the next record is header(3) + 3 per field.
func natStructRecAt(tbl, typeName) {
  let i = 0
  while (i < len(tbl)) {
    if (tbl[i] == typeName) { return i + 2 }
    i = i + 3 + tbl[i + 2] * 3
  }
  return -1
}

// natStructSizeOf is the record's field-area size in BYTES, or -1 for an unknown type.
func natStructSizeOf(tbl, typeName) {
  let b = natStructRecAt(tbl, typeName)
  if (b < 0) { return -1 }
  return tbl[b - 1]
}

func natStructFieldOff(tbl, typeName, fieldName) {
  let b = natStructRecAt(tbl, typeName)
  if (b < 0) { return -1 }
  let cnt = tbl[b]
  let j = 0
  while (j < cnt) {
    let p = b + 1 + j * 3
    if (tbl[p] == fieldName) { return tbl[p + 1] }
    j = j + 1
  }
  return -1
}

func natStructFieldKind(tbl, typeName, fieldName) {
  let b = natStructRecAt(tbl, typeName)
  if (b < 0) { return -1 }
  let cnt = tbl[b]
  let j = 0
  while (j < cnt) {
    let p = b + 1 + j * 3
    if (tbl[p] == fieldName) { return tbl[p + 2] }
    j = j + 1
  }
  return -1
}

// ------------------------------------------------------------
// Step 9h-1 - record lowering
// ------------------------------------------------------------
//
// The record VALUE slot holds the field-area ADDRESS; the field area follows the slot
// immediately, so fieldArea = slot + 8. Every field access recomputes that address
// from the frame -- following natArrayValue's rule that a base is never carried across
// an expression. natStoreBaseOff is the authoritative mem[base+off] = val primitive.

// natRecordArea emits LEA of the field area and stores it in the record's slot.
func natRecordArea(s, slotOff) {
  s = natLeaRegStack(s, natRegRAX(), slotOff + 8)
  return natStoreStack(s, natRegRAX(), slotOff)
}

// natRecordFieldAddr leaves the address of `base + off` in RAX. `base` is a REGISTER
// holding the field-area address, reloaded by the caller from the record's frame slot.
func natRecordFieldAddr(s, base, off) {
  if (off == 0) { return s }
  s = natAddRegImm32(s, base, off)
  return s
}

// natRecordStoreLiteral stores one literal field of a record.
//
// The base register is passed in by the caller, which reloaded it from the record's
// frame slot immediately before calling -- so no field expression is ever evaluated
// between the reload and the store. That is what makes this correct for `p.x + p.y`
// without inventing a persistent base register.
//
// A string field is TWO units: the interned rodata pointer at `off`, the length at
// `off + 8`. Storing one unit would truncate it, which is exactly what `mixed_fields`
// (string between an int and a float) is there to catch.
//
// Returns a TWO-element array [newState, newSidx] because Karkain has no multiple
// return and no reference mechanism: the caller-owned rodata cursor must travel back
// out with the emitter state.
func natRecordStoreLiteral(s, stmts, lit, off, kind, roffs, sidx) {
  let out = []
  if (kind == natKindString()) {
    s = natRodataRefOff(s, natRegRAX(), natRodataOffsetFor(stringLitVal(lit), stmts, roffs))
    s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off)
    s = natMovRegImm32(s, natRegRAX(), len(stringLitVal(lit)))
    s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off + 8)
    out = appendArray(out, s)
    out = appendArray(out, sidx + 1)
    return out
  }
  s = natMovRegImm64(s, natRegRAX(), int(intLitVal(lit)))
  s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off)
  out = appendArray(out, s)
  out = appendArray(out, sidx)
  return out
}

func natNativePlan(stmts, tbl) {
    return natNativePlanForKinds([], [], stmts, tbl, [])
}

// natNativePlanFor is kept as the all-int entry point so every frozen caller keeps
// driving the same numbers.
func natNativePlanFor(params, stmts, tbl) {
    return natNativePlanForKinds(params, natNativeAllIntKinds(len(params)), stmts, tbl, [])
}

func natNativePlanForKinds(params, kinds, stmts, tbl, fns) {
    let plan = []
    let next = 0
    let pi = 0
    while (pi < len(params)) {
  plan = appendArray(plan, next)
  plan = appendArray(plan, kinds[pi])
  plan = appendArray(plan, 0)
  plan = appendArray(plan, params[pi])
  plan = appendArray(plan, -1)
  next = next + natKindUnits(kinds[pi]) * 8
  pi = pi + 1
  }
  let r = natNativePlanDecls(plan, stmts, tbl, next, fns)
  return r[0]
}

// natNativePlanDecls allocates a slot for every binding a statement list
  // declares, and returns the plan and the next free offset.
  //
  // NAT-IF: it DESCENDS into an `if`'s branches, because the oracle's layout
  // pass does (program.go:4674-4676: `case *parser.IfStmt: scanLets(n.Consequence);
  // scanLets(n.Alternative)`). The order matters as much as the fact: the
  // oracle's walk allocates the branch's slot at the point the `if` is reached,
  // so a program with `let a` before the `if` and `let c` after it gives the
  // branch's binding the MIDDLE slot. A plan that did not descend would give
  // the branch's binding the LAST slot, and every frame displacement after it
  // would move.
  //
  // An earlier draft of this slice REFUSED a binding inside a branch, on the
  // belief that the layout pass walked only the top level. That belief was
  // wrong, and the gate that caught it was the byte-identity differential: the
  // oracle produced an image for such a program and the self-hosted driver
  // refused it. The refusal is withdrawn and the driver matches the oracle.
  func natNativePlanDecls(plan, stmts, tbl, next, fns) {
  let i = 0
  while (i < len(stmts)) {
  let n = stmts[i]
  if (natNativeIsDecl(n)) {
  let v = natNativeDeclValue(n)
  let k = natKindInt()
  let ne = 0
  if (nodeType(v) == NODE_ARRAY_LIT()) {
  k = natKindArray()
  ne = len(arrayLitElems(v))
  }
  if (nodeType(v) == NODE_STRING_LIT()) { k = natKindString() }
  // Step 9h-1: a record literal is ONE 8-byte unit whose value is the ADDRESS of its
  // field area, and the area follows the slot immediately. `ne` carries the field area
  // in UNITS -- the same convention the array clause uses for its element count -- so the
  // byte contribution below stays `8 * ne` for both, and there is no second size formula.
    if (nodeType(v) == NODE_STRUCT_LIT()) {
        k = natKindStruct()
        ne = natStructSizeOf(tbl, structLitName(v)) / 8
    }
    if (nodeType(v) == NODE_CALL()) {
        if (callFunc(v) == "push") {
            k = natKindArray()
            ne = 0
        } else if (natNativeFuncReturnKindOf(fns, callFunc(v)) == 2) {
            k = natKindString()
        }
    }
    if (nodeType(v) == NODE_INDEX()) {
        // NAT-STRIDX: `let b = s[i]` binds the one-byte view the index yields.
        // The kind MUST be the string kind so the slot is two units and every
        // downstream reader (print, concat, len, another index) sees a string.
        if (natNativeStrKind(v, 0, plan) == 1) { k = natKindString() }
    }
  plan = appendArray(plan, next)
  plan = appendArray(plan, k)
  plan = appendArray(plan, ne)
  plan = appendArray(plan, natNativeDeclName(n))
  plan = appendArray(plan, -1)
  next = next + 8
  if (natKindUnits(k) == 2) { next = next + 8 }
  if (k == natKindArray()) { next = next + 8 * ne }
  if (k == natKindStruct()) { next = next + 8 * ne }
  }
  if (nodeType(n) == NODE_IF()) {
  let rc = natNativePlanDecls(plan, ifCons(n), tbl, next, fns)
  plan = rc[0]
  next = rc[1]
  let ra = natNativePlanDecls(plan, ifAlt(n), tbl, next, fns)
  plan = ra[0]
  next = ra[1]
  }
  // NAT-LOOP: the oracle's layout pass descends into a loop body and into a
  // C-style for's INIT (program.go:4677-4683), and the ORDER matters as much
  // as the fact: the init's binding is allocated BEFORE the body's, and both
  // are allocated at the point the loop is reached in the enclosing walk.
  //
  // Getting this wrong is not a cosmetic difference: a slot allocated in a
  // different ORDER moves every frame displacement after it, so the whole
  // image differs.
  if (nodeType(n) == NODE_WHILE()) {
  let rw = natNativePlanDecls(plan, whileBody(n), tbl, next, fns)
  plan = rw[0]
  next = rw[1]
  }
  if (nodeType(n) == NODE_FOR()) {
  if (len(forInit(n)) > 0) {
  let ri = natNativePlanDecls(plan, appendArray([], forInit(n)), tbl, next, fns)
  plan = ri[0]
  next = ri[1]
  }
  let rf = natNativePlanDecls(plan, forBody(n), tbl, next, fns)
  plan = rf[0]
  next = rf[1]
  }
  i = i + 1
  }
  return [plan, next]
  }

func natNativePlanCount(plan) { return len(plan) / 5 }

func natNativeSlotOff(plan, idx) { return plan[idx * 5] }
func natNativeSlotKind(plan, idx) { return plan[idx * 5 + 1] }
func natNativeSlotElems(plan, idx) { return plan[idx * 5 + 2] }
func natNativeSlotName(plan, idx) { return plan[idx * 5 + 3] }
// natNativeSlotReg is the register a slot was allocated, or -1 for "keep the
// frame slot". NAT-REG: the allocation lives in the PLAN, so it is per function
// and needs no global state and no extra parameter anywhere.
func natNativeSlotReg(plan, idx) { return plan[idx * 5 + 4] }
// natNativeSlotCount is the number of slots in a plan.
func natNativeSlotCount(plan) { return len(plan) / 5 }

// natNativePlanBytes is the total locals-region size, which is the first argument
// natFrameLayout takes.
//
// It is the offset of the LAST local plus that local's own size, recomputed from the
// plan rather than by summing a second time, so the number the frame is sized from
// and the numbers the slots were allocated from cannot drift apart.
func natNativePlanBytes(plan) {
    if (len(plan) == 0) { return 0 }
    let last = natNativePlanCount(plan) - 1
    let units = natKindUnits(natNativeSlotKind(plan, last))
    let size = units * 8
    if (natNativeSlotKind(plan, last) == natKindArray()) {
        size = size + 8 * natNativeSlotElems(plan, last)
    }
  // Step 9h-1: a record's footprint is 8 bytes for the value slot PLUS 8 * units of
  // field area. Same `8 * extra` convention as the array clause, so planned bytes and
  // natRecordArea's allocation cannot drift apart.
  if (natNativeSlotKind(plan, last) == natKindStruct()) {
  size = size + 8 * natNativeSlotElems(plan, last)
  }
  return natNativeSlotOff(plan, last) + size
}

// natNativeSubset is the SHARED tail of every native refusal, kept in one place
// so the described surface cannot drift between a refusal that knows its line
// number and one that does not.
//
// It is deliberately an enumeration rather than a promise: a user reading a
// refusal needs to know what IS lowered, and a stale list is worse than a short
// one. NAT-CALL added the two items this text names -- an integer expression,
// and a call to a user function -- because both became reachable in that slice.
//
// The two phrases `native target:` and `not handed to the Go engine.` are part
// of the refusal CONTRACT that frozen gates assert, so they stay even as the
// enumeration between them changes.
func natNativeSubset() {
    return "The native driver lowers `let` of an integer literal, a string literal, " +
        "an integer array literal or a record literal, `let ... = push(arr, v)`, and `let` of an integer " +
        "expression inside a called function; `print` and `return` of an integer " +
        "literal, a local, `a[i]`, `len(a)`, an int/float record field, an integer " +
        "expression (`+ - *`, unary `-`), a call to a user function, and (in direct " +
        "print position) a string record field; and `record.field = value` for an " +
        "integer local/literal or a string literal. This is refused HERE, by kcc, " +
        "and is not handed to the Go engine."
}

// natNativeRefuse builds the refusal text. K145 is the native backend's own code
// -- the same one the increment-150 gates use for a construct the native target
// will not lower -- so a user sees one consistent family of native refusals
// whether the program came through the Go or the self-hosted engine.
func natNativeRefuse(what, line) {
    return "error[K145]: native target: " + what + " (main.kark line " + str(line) +
        "). " + natNativeSubset()
}

// natNativeRefuseNoLine is natNativeRefuse for a refusal where the offending
// node's line is not reachable through a typed accessor. Naming the construct is
// what makes a refusal actionable; inventing a line number would be worse than
// omitting it.
func natNativeRefuseNoLine(what) {
    return "error[K145]: native target: " + what + ". " + natNativeSubset()
}

// natNativeScan validates main's statements and counts its int locals in ONE
// pass, returning [refusal, nLocals].
//
// One pass, not two, so the count and the verdict can never describe different
// statements: a separate scan would let a construct be rejected by the validator
// while still being counted by the framer, and the frame would then be sized for a
// program that is never emitted.
//
// `refusal` is "" when every statement is supported. The refusals NAME the
// construct, because a refusal a user cannot act on is barely better than a crash.
// natNativeScanStructLit validates a record literal against the declared layout.
// It is deliberately a VALIDATOR, not an emitter: unknown type, unknown field and
// unsupported field kind are all loud refusals, so a mis-sized record can never reach
// emission.
func natNativeScanStructLit(tbl, lit, line) {
let typeName = structLitName(lit)
if (natStructSizeOf(tbl, typeName) < 0) {
return natNativeRefuse("unknown record type `" + typeName + "`", line)
}
let fields = structLitFields(lit)
let i = 0
while (i < len(fields)) {
let fname = identName(binaryLeft(fields[i]))
if (natStructFieldOff(tbl, typeName, fname) < 0) {
return natNativeRefuse("record `" + typeName + "` has no field `" + fname + "`", line)
}
let fk = natStructFieldKind(tbl, typeName, fname)
if (fk == natKindString()) {
if (nodeType(binaryRight(fields[i])) != NODE_STRING_LIT()) {
return natNativeRefuse("record field `" + fname + "` is a string; only a string " +
"literal is lowered for it in 151A Step 9h-1", line)
}
} else {
if (nodeType(binaryRight(fields[i])) != NODE_INT_LIT()) {
return natNativeRefuse("record field `" + fname + "` must be initialised with an " +
"integer literal in 151A Step 9h-1", line)
}
}
i = i + 1
}
return ""
}

// natNativeWhere names the function a refusal came from, for the message tail. It is
// a suffix rather than a prefix so the frozen gates that assert the phrase
// "is not lowered by the native driver" keep matching, and so main's wording is
// byte-identical to the pre-NAT-CALL text.
func natNativeWhere(isMain) {
    if (isMain == 1) { return " in `func main`" }
    return " in a called function"
}

// natNativeStmtKindName names the statement a refusal came from.
//
// A refusal that says "statement kind 5" names a NUMBER, which is not something a
// user can act on -- the 151 baseline calls that out as a refusal that invites a
// fallback. An unrecognised kind keeps the number rather than being mislabelled.
func natNativeStmtKindName(k) {
    if (k == NODE_IF()) { return "`if` statement" }
    if (k == NODE_WHILE()) { return "`while` statement" }
    if (k == NODE_FOR()) { return "`for` statement" }
    if (k == NODE_FOR_IN()) { return "`for-in` statement" }
    if (k == NODE_BREAK()) { return "`break` statement" }
    if (k == NODE_CONTINUE()) { return "`continue` statement" }
    return "statement kind " + str(k)
}

func natNativeScanFor(params, stmts, tbl, fns, isMain, useRegAlloc, kinds) {
    let plan = natNativePlanForKinds(params, kinds, stmts, tbl, fns)
    // NAT-REG: the allocation is per function and lives in the plan, so it is
    // computed here -- once, where the plan is complete -- and every access
    // site reads it back out of the plan.
    if (useRegAlloc == 1) { plan = natNativeRegAlloc(stmts, plan) }
    let r = natNativeScanStmts(stmts, plan, tbl, fns, isMain, stmts, 0, 0)
    return [r[0], plan, r[1]]
}

// natNativeScanStmts validates a STATEMENT LIST.
//
// `loopDepth` is the number of enclosing loops. It is what decides whether a
// `break` or a `continue` has a loop to leave: the oracle refuses both at
// emission time when its loop stack is empty (program.go:4913-4923), and the
// scan refuses them here instead, with the same words.
//
// `fnStmts` is the FUNCTION's statement list, not the list being validated.
// The record-type lookup needs it: a record bound at the top level is still
// that record when a field inside a branch or a loop body is assigned.
//
// NAT-LOOP turned this from "the function's own statements" into "any
// statement list", because a branch body, a loop body and a function body are
// validated by the SAME rules -- except for the loop depth, which is the one
// thing that differs between them.
func natNativeScanStmts(stmts, plan, tbl, fns, isMain, fnStmts, loopDepth, inBody) {
    let hasReturn = 0
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        let k = nodeType(n)
        if (natNativeIsDecl(n)) {
            let bad = ""
            if (inBody == 1) {
                // A binding in a NESTED body is INT-only: a string binding
                // would need the rodata cursor, which this driver threads per
                // STATEMENT LIST. See natNativeScanStmts' header.
                bad = natNativeScanIntExpr(natNativeDeclValue(n), plan, natNativeDeclLine(n), fns, 0)
            } else {
                bad = natNativeScanDecl(n, plan, tbl, fns, isMain)
            }
            if (bad != "") { return [bad, hasReturn] }
        } else {
if (k == NODE_PRINT()) {
                // A callee's `print` uses the SAME value scan as main's: the literal
                // collector is program-wide and recurses into branches, so a literal
                // in a callee is interned like any other.
                let bad = natNativeScanValue(printVal(n), stmts, plan, printLine(n), tbl, 1, fns)
                if (bad != "") { return [bad, hasReturn] }
            } else {
                if (k == NODE_RETURN()) {
                    let bad = ""
                    if (inBody == 1) {
                        // A return in a NESTED body is allowed the string kind too:
                        // branches now recurse into the literal collector, so the
                        // value model is uniform. It still does NOT set the function's
                        // `returned` flag (only a TOP-LEVEL return does, per the
                        // oracle's emitStmts).
                        if (natNativeValueKindOf(retVal(n), plan, fns) == 2) {
                            bad = natNativeScanReturn(retVal(n), stmts, plan, retLine(n), tbl, fns, isMain)
                        } else {
                            bad = natNativeScanIntExpr(retVal(n), plan, retLine(n), fns, 0)
                        }
                    } else {
                        hasReturn = 1
                        bad = natNativeScanReturn(retVal(n), stmts, plan, retLine(n), tbl, fns, isMain)
                    }
                    if (bad != "") { return [bad, hasReturn] }
} else {
  if (k == NODE_EXPR_STMT()) {
  let e = exprStmtExpr(n)
  if (natNativeIsAssignExpr(e)) {
  let bad = ""
  if (nodeType(binaryLeft(e)) == NODE_IDENT()) {
  // NAT-LOOP: a plain-local assignment -- `i = i + 1`, the loop counter's
  // form. It arrives as an ExprStmt (the parser wraps the expression), so the
  // EXPR_STMT arm is where it is seen, not the bare-`=` statement arm.
  bad = natNativeScanAssignLocal(plan, fns, exprStmtLine(n), binaryLeft(e), binaryRight(e))
  } else {
  bad = natNativeScanAssign(tbl, stmts, plan, exprStmtLine(n), binaryLeft(e), binaryRight(e))
  }
  if (bad != "") { return [bad, hasReturn] }
  } else {
  // NAT-CALL: a bare call statement -- `show(7)` for a void callee -- is the only
  // way to reach a function that PRINTS. Without this arm a non-main function that
  // prints is unreachable, because the only other call positions (`print(...)` and
  // `return ...`) both require an int. It is an accepted statement rather than a
  // widened expression, so the discarded RAX changes nothing about the value model:
  // natEmitIntCall lowers the call, and a void callee's implicit `xor rax,rax` is
  // simply never read.
  if (nodeType(e) == NODE_CALL()) {
  let bad = natNativeScanCall(e, plan, exprStmtLine(n), fns)
  if (bad != "") { return [bad, hasReturn] }
  } else {
  return [natNativeRefuseNoLine("expression statement `" + getNodeType(e) +
  "` is not lowered by the native driver"),
  hasReturn]
  }
  }
  } else {
  if (k == NODE_IF()) {
  // NAT-IF: a conditional branch. The condition is an integer comparison; the
  // branch bodies are int-only. natNativeScanIf says why.
  let bad = natNativeScanIf(n, plan, tbl, fns, isMain, fnStmts, loopDepth)
  if (bad != "") { return [bad, hasReturn] }
  } else {
  if (k == NODE_WHILE()) {
  // NAT-LOOP: a `while` loop. The arena-using constructs are refused BEFORE
  // anything else is looked at, because a loop is where the compile-time arena
  // bound stops being provable.
  let bad = natNativeScanLoopArena(whileBody(n), plan)
  if (bad != "") { return [bad, hasReturn] }
  let bad2 = natNativeScanCond(whileCond(n), plan, whileLine(n), fns)
  if (bad2 != "") { return [bad2, hasReturn] }
  let bad3 = natNativeScanStmts(whileBody(n), plan, tbl, fns, isMain, fnStmts, loopDepth + 1, 1)
  if (bad3[0] != "") { return [bad3[0], hasReturn] }
  } else {
  if (k == NODE_FOR()) {
  // NAT-LOOP: a C-style `for`. The INIT is a statement (a `let` or an
  // assignment), the CONDITION is an integer comparison, and the POST is an
  // assignment -- the oracle wraps a bare `=` post in an ExprStmt before
  // lowering it (program.go:5282-5285), which is what the driver does too.
  let bad = natNativeScanLoopArena(forBody(n), plan)
  if (bad != "") { return [bad, hasReturn] }
  let bad2 = natNativeScanForInit(forInit(n), plan, tbl, fns, isMain)
  if (bad2 != "") { return [bad2, hasReturn] }
  let bad3 = natNativeScanCond(forCond(n), plan, forLine(n), fns)
  if (bad3 != "") { return [bad3, hasReturn] }
  let bad4 = natNativeScanForPost(forPost(n), plan, tbl, fns, isMain)
  if (bad4 != "") { return [bad4, hasReturn] }
  let bad5 = natNativeScanStmts(forBody(n), plan, tbl, fns, isMain, fnStmts, loopDepth + 1, 1)
  if (bad5[0] != "") { return [bad5[0], hasReturn] }
  } else {
  if (k == NODE_BREAK()) {
  // NAT-LOOP: `break` leaves the NEAREST enclosing loop. The oracle refuses it
  // when its loop stack is empty (program.go:4913-4916) and says exactly this.
  if (loopDepth < 1) {
  return [natNativeRefuse("break outside of a loop", breakLine(n)),
  hasReturn]
  }
  } else {
  if (k == NODE_CONTINUE()) {
  if (loopDepth < 1) {
  return [natNativeRefuse("continue outside of a loop", continueLine(n)),
  hasReturn]
  }
  } else {
  if (natNativeIsAssignExpr(n)) {
  // NAT-LOOP: a BARE `=` BinaryExpr statement is the shape a C-style `for`'s
  // INIT and POST arrive in -- program.go:5280 wraps the post into an ExprStmt
  // only when walking. It used to be refused by name (9h-2a) because the loop
  // was not lowered; now it is a supported statement.
  let bad = natNativeScanAssignLocal(plan, fns, binaryLine(n), binaryLeft(n), binaryRight(n))
  if (bad != "") { return [bad, hasReturn] }
  } else {
  return [natNativeRefuseNoLine(natNativeStmtKindName(k) +
  " is not lowered by the native driver" + natNativeWhere(isMain)),
  hasReturn]
  }
  }
  }
  }
  }
  }
  }
            }
        }
        }
        i = i + 1
    }
    return ["", hasReturn]
}

// natNativeScanDecl validates one `let`/`var` binding.
//
// The split is not cosmetic. MAIN keeps the exact arms 9c-9h froze -- a literal of
// one of the four supported kinds and nothing else -- because those arms are pinned
// by byte-identity gates and NAT-CALL has no reason to move them. A CALLED function
// accepts an int EXPRESSION, which is what makes a callee like `add(a, b)` return
// `a + b` at all.
//
// The asymmetry is deliberate and is named in the refusal text rather than hidden:
// `let c = a + b` in main is still refused, while the same line inside a callee is
// lowered. Widening main's arm would have moved frozen bytes for no gain, and this
// slice is scoped to calls, not to a general expression driver.
func natNativeScanDecl(n, plan, tbl, fns, isMain) {
    let v = natNativeDeclValue(n)
    if (isMain == 0) {
        if (nodeType(v) == NODE_CALL() && natNativeFuncReturnKindOf(fns, callFunc(v)) == 2) {
            return natNativeScanCall(v, plan, natNativeDeclLine(n), fns)
        }
        return natNativeScanIntExpr(v, plan, natNativeDeclLine(n), fns, 0)
    }
    let vt = nodeType(v)
    if (vt == NODE_ARRAY_LIT()) {
        return natNativeScanElems(arrayLitElems(v), natNativeDeclLine(n))
    }
    if (vt == NODE_STRUCT_LIT()) {
        // Step 9h-1: a record literal is validated by checking that the
        // declared type exists and that every named field exists with a
        // supported kind. An unknown type or field is a LOUD refusal, never
        // a silently mis-sized record.
        return natNativeScanStructLit(tbl, v, natNativeDeclLine(n))
    }
    if (vt == NODE_STRING_LIT()) {
        // Accepted as-is: the value is the literal's own bytes, interned
        // into rodata, so there is nothing to evaluate.
        return ""
    }
    if (vt == NODE_CALL()) {
        if (callFunc(v) == "push") {
            let args = callArgs(v)
            if (len(args) != 2) {
                return natNativeRefuse("push() takes exactly 2 arguments (got " + str(len(args)) + ")", natNativeDeclLine(n))
            }
            if (nodeType(args[0]) != NODE_IDENT()) {
                return natNativeRefuse("push() requires an array variable (got " + getNodeType(args[0]) + ")", natNativeDeclLine(n))
            }
            let srcName = identName(args[0])
            let srcOrd = natNativeSlotIndex(plan, srcName)
            if (srcOrd < 0) {
                return natNativeRefuse("undeclared local `" + srcName + "`", natNativeDeclLine(n))
            }
            if (natNativeSlotKind(plan, srcOrd) != natKindArray()) {
                return natNativeRefuse("push() requires an array receiver (got " + natKindName(natNativeSlotKind(plan, srcOrd)) + ")", natNativeDeclLine(n))
            }
            let bad = natNativeScanIntExpr(args[1], plan, natNativeDeclLine(n), fns, 0)
            if (bad != "") { return bad }
            return ""
        }
        // A string-returning call binds as-is; letting the caller's ordinary
        // call scan validate the arguments covers arity and argument kinds.
        if (natNativeFuncReturnKindOf(fns, callFunc(v)) == 2) {
            return natNativeScanCall(v, plan, natNativeDeclLine(n), fns)
        }
    }
    if (vt == NODE_INDEX()) {
      // NAT-STRIDX: `let b = s[i]` initialised from a string-typed byte index
      // binds a one-byte string; anything else initialised from an index is
      // refused by the non-integer check below, which is the honest answer.
      if (natNativeStrKind(v, 0, plan) == 1) {
        return ""
      }
    }
    if (vt != NODE_INT_LIT()) {
        return natNativeRefuse("`let " + natNativeDeclName(n) +
            "` initialised from a non-integer expression", natNativeDeclLine(n))
    }
    return ""
}

// natNativeIsStrBinary reports whether a `+` is a STRING concatenation.
//
// It exists because NAT-CALL made integer `+` reachable, and until then every `+`
// in a program WAS a concat. natNativeConcatIn/print's dispatch both used "is the
// node a BinaryExpr with +" as the test, which was exactly right while int
// arithmetic was refused and is exactly wrong now: an int `+` would turn usesStr
// on (adding 41 bytes of print_str and a spurious 1024-byte arena) and would route
// an int addition into natStrConcat, whose operand arms expect literals and
// identifiers.
//
// UNKNOWN classifies as NOT a string on purpose. natNativeStrKind returns -2 for a
// call and for an int literal, and in this slice a call returns an int, so an
// unknown operand cannot make an expression a concat. The alternative -- treating
// unknown as string -- would refuse int calls.
func natNativeIsStrBinary(e, stmts, plan) {
    if (natNativeStrKind(binaryLeft(e), stmts, plan) == 1) { return 1 }
    if (natNativeStrKind(binaryRight(e), stmts, plan) == 1) { return 1 }
    return 0
}

// natNativeFuncs returns the quad descriptors [name, params, body, kinds, ...] in
// source order (see natNativeReachable for the reachability handling).
// slots each: [name, params, body]. Source order is preserved because that is the
// order the oracle emits functions in, and emission order decides every byte
// natNativeFuncs builds the quad descriptors [name, params, body, kinds, ...] in
// source order, with `kinds` the per-parameter kind INFERRED from the call sites
// (see natNativeInferParamKinds) and the dead functions PRUNED (see
// natNativePruneFns).
//
// `params` comes back exactly as the parser stored it: NAMES only. A parameter's
// kind is NOT recoverable from the source, which is why inference is required for
// array parameters; everything else is an int.
// natNativeFuncs returns [fns, diagnostic]. fns is the quad descriptors
// [name, params, body, kinds, ...] in SOURCE ORDER (dead functions included:
// emission-time skipping, not list-time pruning, is how unreachable unsupported
// functions are tolerated). diagnostic is "" on success. A conflict stops the
// caller before emission.
func natNativeFuncs(stmts) {
    let triple = []
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        if (nodeType(n) == NODE_FUNC_DECL()) {
            triple = appendArray(triple, funcName(n))
            triple = appendArray(triple, funcParams(n))
            triple = appendArray(triple, funcBody(n))
        }
        i = i + 1
    }
    // Reachability computed on the RAW triple (names + bodies only), before
    // kind inference. A function unreachable from main can never be called, so
    // no call site ever binds its result; its return kind cannot feed a guess
    // anywhere else either. Conflicts that arise only inside dead functions
    // therefore carry no risk to the emitted image and are not refused here.
    let tempFns = []
    i = 0
    while (i < len(triple) / 3) {
        tempFns = appendArray(tempFns, triple[i * 3])
        tempFns = appendArray(tempFns, triple[i * 3 + 1])
        tempFns = appendArray(tempFns, triple[i * 3 + 2])
        tempFns = appendArray(tempFns, natNativeAllIntKinds(len(triple[i * 3 + 1])))
        tempFns = appendArray(tempFns, 1)
        i = i + 1
    }
    let reachable = natNativeReachable(tempFns)
    let inf = natNativeInferParamKinds(triple, reachable)
    let kinds = inf[0]
    let retkinds = inf[1]
    if (inf[2] != "") { return [triple, inf[2]] }
    let out = []
    i = 0
    while (i < len(triple) / 3) {
        out = appendArray(out, triple[i * 3])
        out = appendArray(out, triple[i * 3 + 1])
        out = appendArray(out, triple[i * 3 + 2])
        out = appendArray(out, kinds[i])
        out = appendArray(out, retkinds[i])
        i = i + 1
    }
    return [out, ""]
}

// natNativeRetKindWalk classifies every `return` in a statement list: 0 when a
// body RETURNS BOTH a string and an int (undefined, refused), 1 when all are
// int (the default), 2 when any return is a string. It RECURSES into nested
// bodies (branches, loops), because a string returned inside a branch is still
// a string return.
func natNativeRetKindWalk(stmts, plan, fds) {
    let rk = 1
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        let t = nodeType(n)
        if (t == NODE_RETURN()) {
            let v = retVal(n)
            let k = natNativeValueKindOf(v, plan, fds)
            if (k == 2) {
                if (rk == 1) {
                    rk = 2
                } else if (rk == 1) {
                    // unreachable; kept for clarity
                    rk = 2
                }
            } else if (k == 1) {
                if (rk == 2) { rk = 0 }
            }
        } else if (natNativeIsDecl(n)) {
            // binding a call result is not a RETURN, but later return kind
            // inference for calls reads kinds of idents through the plan,
            // which natNativeValueKindOf resolves ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â nothing to do here.
        } else if (t == NODE_IF()) {
            let rc = natNativeRetKindWalk(ifCons(n), plan, fds)
            if (rc == 0) { return 0 }
            if (rc == 2) {
                if (rk == 1) { rk = 2 } else if (rk == 1) { rk = 2 }
            }
            let ra = natNativeRetKindWalk(ifAlt(n), plan, fds)
            if (ra == 0) { return 0 }
            if (ra == 2) {
                if (rk == 1) { rk = 2 } else if (rk == 1) { rk = 2 }
            }
        } else if (t == NODE_WHILE()) {
            let rw = natNativeRetKindWalk(whileBody(n), plan, fds)
            if (rw == 0) { return 0 }
            if (rw == 2) {
                if (rk == 1) { rk = 2 } else if (rk == 1) { rk = 2 }
            }
        } else if (t == NODE_FOR()) {
            let ri = natNativeRetKindWalk(forBody(n), plan, fds)
            if (ri == 0) { return 0 }
            if (ri == 2) {
                if (rk == 1) { rk = 2 } else if (rk == 1) { rk = 2 }
            }
        } else if (t == NODE_FOR_IN()) {
            let rin = natNativeRetKindWalk(forInBody(n), plan, fds)
            if (rin == 0) { return 0 }
            if (rin == 2) {
                if (rk == 1) { rk = 2 } else if (rk == 1) { rk = 2 }
            }
        }
        i = i + 1
    }
    return rk
}

// natNativeReachable computes, over the quad descriptors, the set of function
// indices reachable from `main`. Reachability is a sound over-approximation
// for the purpose here: a function is kept if ANY reachable function mentions
// it, and the report is a 1/0 array in source order.
//
// WHY REACHABILITY, AND WHY EMIT-TIME. An unmodified stdlib module carries
// functions the program never calls, and their bodies may use constructs the
// driver refuses (maps, strings, other kinds of call). Requiring every
// unreachable function in the module to lower would make `import std.collections`
// impossible regardless of the calling program. A dead function whose body the
// driver CANNOT lower is therefore skipped, while a dead function the driver
// CAN lower is emitted normally ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â the latter preserves the byte-identity the
// frozen gates pin (a supported dead helper emits exactly as the Go oracle
// emits it). A function that is reachable from main, or from a reachable
// callee, is never skipped: refusing a reachable function is the contract.
//
// The Go oracle emits dead functions unconditionally, so a program carrying
// unsupported-unreachable dead code is NOT byte-identical to it ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â an accepted,
// documented divergence: those programs cannot build on the oracle at all.
func natNativeReachable(fns) {
    let np = natNativeFuncCount(fns)
    let reach = []
    let i = 0
    while (i < np) {
        reach = appendArray(reach, 0)
        i = i + 1
    }
    let mi = natNativeFuncIndex(fns, "main")
    if (mi < 0) { return reach }
    reach[mi] = 1
    let q = [mi]
    let qi = 0
    while (qi < len(q)) {
        let cur = q[qi]
        qi = qi + 1
        let body = natNativeFuncBodyAt(fns, cur)
        let calls = natNativeCallsOf(body)
        let j = 0
        while (j < len(calls)) {
            let fi = natNativeFuncIndex(fns, calls[j])
            if (fi >= 0) {
                if (reach[fi] == 0) {
                    reach[fi] = 1
                    q = appendArray(q, fi)
                }
            }
            j = j + 1
        }
    }
    return reach
}

// natNativeCallsOf walks a statement list and collects the NAMES of the callees it
// mentions, so reachability is a sound over-approximation of the call graph.
//
// THE ACCUMULATION MATTERS: natNativeCallsInNode may already carry calls found
// in an earlier position (the `if` arm walks the condition BEFORE the branches),
// so the list is threaded through, not restarted per position. An earlier draft
// restarted it, which silently discarded the condition's calls -- `if f(1) == 1`
// was reported as calling nothing, and the pruned program then failed to build
// with "call to undefined function".
func natNativeCallsOf(stmts) {
    return natNativeCallsOfInto(stmts, [])
}

func natNativeCallsOfInto(stmts, out) {
    let i = 0
    while (i < len(stmts)) {
        out = natNativeCallsInNode(stmts[i], out)
        i = i + 1
    }
    return out
}

func natNativeCallsInNode(n, out) {
    let t = nodeType(n)
    if (t == NODE_FUNC_DECL()) {
        return natNativeCallsOf(funcBody(n))
    }
    if (t == NODE_LET_DECL() || t == NODE_VAR_DECL()) {
        return natNativeCallsInExpr(natNativeDeclValue(n), out)
    }
    if (t == NODE_PRINT()) {
        return natNativeCallsInExpr(printVal(n), out)
    }
    if (t == NODE_RETURN()) {
        return natNativeCallsInExpr(retVal(n), out)
    }
    if (t == NODE_EXPR_STMT()) {
        return natNativeCallsInExpr(exprStmtExpr(n), out)
    }
    if (t == NODE_IF()) {
        out = natNativeCallsInExpr(ifCond(n), out)
        out = natNativeCallsOfInto(ifCons(n), out)
        out = natNativeCallsOfInto(ifAlt(n), out)
        return out
    }
    if (t == NODE_WHILE()) {
        out = natNativeCallsInExpr(whileCond(n), out)
        out = natNativeCallsOfInto(whileBody(n), out)
        return out
    }
    if (t == NODE_FOR()) {
        if (nodeType(forInit(n)) == NODE_EXPR_STMT()) {
            out = natNativeCallsInExpr(exprStmtExpr(forInit(n)), out)
        } else if (natNativeIsDecl(forInit(n))) {
            out = natNativeCallsInExpr(natNativeDeclValue(forInit(n)), out)
        }
        out = natNativeCallsInExpr(forCond(n), out)
        out = natNativeCallsInExpr(forPost(n), out)
        out = natNativeCallsOfInto(forBody(n), out)
        return out
    }
    if (t == NODE_FOR_IN()) {
        out = natNativeCallsOfInto(forInBody(n), out)
        return out
    }
    if (t == NODE_BINARY()) {
        // an assignment is a BinaryExpr with = in statement position; the left
        // is handled as an expression too so calls there are counted.
        out = natNativeCallsInExpr(binaryLeft(n), out)
        return natNativeCallsInExpr(binaryRight(n), out)
    }
    if (t == NODE_BLOCK()) {
        return natNativeCallsOfInto(blockStmts(n), out)
    }
    return out
}

func natNativeCallsInExpr(e, out) {
    let t = nodeType(e)
    if (t == NODE_CALL()) {
        out = appendArray(out, callFunc(e))
        let aa = callArgs(e)
        let i = 0
        while (i < len(aa)) {
            out = natNativeCallsInExpr(aa[i], out)
            i = i + 1
        }
        return out
    }
    if (t == NODE_INDEX()) {
        out = natNativeCallsInExpr(indexLeft(e), out)
        return natNativeCallsInExpr(indexExpr(e), out)
    }
    if (t == NODE_BINARY()) {
        out = natNativeCallsInExpr(binaryLeft(e), out)
        return natNativeCallsInExpr(binaryRight(e), out)
    }
    if (t == NODE_UNARY()) {
        return natNativeCallsInExpr(unaryOperand(e), out)
    }
    if (t == NODE_ARRAY_LIT()) {
        let elems = arrayLitElems(e)
        let i = 0
        while (i < len(elems)) {
            out = natNativeCallsInExpr(elems[i], out)
            i = i + 1
        }
        return out
    }
    if (t == NODE_STRUCT_LIT()) {
        let fields = structLitFields(e)
        let i = 0
        while (i < len(fields)) {
            out = natNativeCallsInExpr(binaryRight(fields[i]), out)
            i = i + 1
        }
        return out
    }
    if (t == NODE_DOT()) {
        return natNativeCallsInExpr(dotLeft(e), out)
    }
    if (t == NODE_BLOCK()) {
        return natNativeCallsOf(blockStmts(e))
    }
    return out
}

func natNativeRawIndex(triple, name) {
    let i = 0
    let np = len(triple) / 3
    while (i < np) {
        if (triple[i * 3] == name) { return i }
        i = i + 1
    }
    return 0 - 1
}

// natNativeArgKindFor reports the kind of an ARGUMENT EXPRESSION as observed at a
// call site: 2 for an array (an array literal, or a name whose slot is an array --
// a literal or a parameter), 1 for anything else.
//
// The parser discards parameter annotations, so this is the only kind evidence a
// native driver can have. Everything that returns 1 that is not actually an int
// (a float literal, a record literal, a string literal) is refused BY NAME in the
// scan before emission; the value here only decides UNIT COUNT for the ABI, where
// every non-array is one unit anyway.
func natNativeArgKindFor(e, plan) {
    let t = nodeType(e)
    if (t == NODE_STRING_LIT()) { return 2 }
    if (t == NODE_ARRAY_LIT()) { return 3 }
    if (t == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(e))
        if (ord >= 0) {
            let k = natNativeSlotKind(plan, ord)
            if (k == natKindString()) { return 2 }
            if (k == natKindArray()) { return 3 }
        }
    }
    if (t == NODE_CALL()) {
        // A runtime builtin whose declared return is a string (see the table
        // in natNativeFuncReturnKindOf). Without this, `str_split(hex_decode(x), y)`
        // promoted nothing and stdlib's callers stayed int-typed.
        let b = natNativeBuiltinRetKind(callFunc(e))
        if (b == 2) { return 2 }
    }
    return 1
}

// natNativeValueKindOf classifies an expression for RETURN-kind inference:
// 1 = int, 2 = string. It is deliberately conservative ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â unknown shapes are int,
// because a wrong string classification only reserves a strTemp plan where an
// int would do ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â and it is monotone (anything that could be a string is).
func natNativeValueKindOf(e, plan, fns) {
    let t = nodeType(e)
    if (t == NODE_STRING_LIT()) { return 2 }
    if (t == NODE_SLICE()) {
        if (natNativeStrKind(sliceLeft(e), 0, plan) == 1) { return 2 }
        return 1
    }
    if (t == NODE_BINARY()) {
        if (binaryOp(e) == "+") {
            if (natNativeValueKindOf(binaryLeft(e), plan, fns) == 2) { return 2 }
        }
        return 1
    }
    if (t == NODE_UNARY()) { return natNativeValueKindOf(unaryOperand(e), plan, fns) }
    if (t == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(e))
        if (ord >= 0) {
            let k = natNativeSlotKind(plan, ord)
            if (k == natKindString()) { return 2 }
        }
        return 1
    }
    if (t == NODE_INDEX()) {
        // Byte indexing of a string: the result is a one-byte string, the way
        // `s[index]` is shaped today (and how str_char_at reads it). A non-string
        // base keeps the historical int classification.
        //
        // NAT-STRIDX: the classification is the shared str-kind, so a base this
        // function's slot walk could not classify by itself is still decided by
        // the one classifier every string position uses. Unclassifiable stays
        // the int default, which is the pre-existing conservative answer.
        if (natNativeStrKind(e, 0, plan) == 1) { return 2 }
        return 1
    }
    if (t == NODE_CALL()) {
        return natNativeFuncReturnKindOf(fns, callFunc(e))
    }
    return 1
}

// natNativeBuiltinRetKind reports the RETURN KIND of a runtime builtin.
//   2 = returns a string, 1 = returns an int, 0 = not a known builtin here.
//
// The declared-kind table, not a heuristic: these are the signatures the Go
// and kcc C codegen implement today (pkg/codegen/codegen.go: make_string
// results for the byte helpers and the hex digests; make_int elsewhere).
// A call to one of these in a Karkain source never type-checks as its arg
// kind INT silently again -- misclassifying `return hex_decode_bytes(x)` as
// an int return is exactly the mixed string/int return conflict that refused
// stdlib's hex_decode in the inference.
func natNativeBuiltinRetKind(name) {
    if (name == "hex_encode_bytes") { return 2 }
    if (name == "hex_decode_bytes") { return 2 }
    if (name == "base64_encode_bytes") { return 2 }
    if (name == "base64_decode_bytes") { return 2 }
    if (name == "utf8_encode_bytes") { return 2 }
    if (name == "sha256_hex") { return 2 }
    if (name == "sha512_hex") { return 2 }
    if (name == "trim") { return 2 }
    if (name == "utf8_valid_bytes") { return 1 }
    if (name == "int") { return 1 }
    if (name == "len") { return 1 }
    return 0
}

func natNativeFuncReturnKindOf(fns, name) {
    let b = natNativeBuiltinRetKind(name)
    if (b != 0) { return b }
    let i = 0
    let np = natNativeFuncCount(fns)
    while (i < np) {
        if (natNativeFuncNameAt(fns, i) == name) { return fns[i * 5 + 4] }
        i = i + 1
    }
    return 1
}

// natNativeAllIntKinds returns n int kinds.
func natNativeAllIntKinds(n) {
    let out = []
    let i = 0
    while (i < n) {
        out = appendArray(out, natKindInt())
        i = i + 1
    }
    return out
}

// natNativeInferParamKinds computes one KIND PER PARAMETER, from every call site
// in the program, by fixpoint.
//
// WHY INFERENCE IS REQUIRED. The parser discards parameter annotations, so a
// parameter's declared type is unrecoverable; the argument at a call site is the
// only evidence available. The rule is deliberately simple and total:
//
//   * every parameter starts as an int (one unit);
//   * for each call site to a callee, each argument's kind is ORed in;
//   * a parameter becomes an ARRAY if any site passes an array there, and stays
//     an int otherwise;
//   * a parameter that RECEIVES BOTH an array and a non-array argument across
//     the program is a CONFLICT, refused by name with the function and parameter.
//
// Fixpoint, because an array may flow through a chain of functions: main passes
// `scores` to array_max; array_max passes it to nothing; but a wrapper can pass
// its own array parameter on to a third function, and one pass is not enough. At
// most np*params promotions ever happen, so 8 passes is a generous bound; the
// cap reports non-convergence as a refusal rather than producing a half-inferred
// plan.
//
// RETURNS [kinds, retkinds, ""] on success, or [kinds, retkinds, diagnostic]
// on a conflict.
func natNativeInferParamKinds(triple, reachable) {
    let np = len(triple) / 3
    let kinds = []
    let retkinds = []
    let i = 0
    while (i < np) {
        kinds = appendArray(kinds, natNativeAllIntKinds(len(triple[i * 3 + 1])))
        retkinds = appendArray(retkinds, 1)
        i = i + 1
    }
    let pass = 0
    while (pass < 16) {
        // Build the current descriptors: they carry BOTH the parameter kinds and
        // the return kinds, so the let-binding planner reads a two-unit slot for
        // `let name = <string callee>` (and the argument walker reads a string
        // kind slot as a string). Each pass re-reads them, which is what makes
        // the fixpoint correct for chains like main -> f -> g.
        let fds = []
        i = 0
        while (i < np) {
            fds = appendArray(fds, triple[i * 3])
            fds = appendArray(fds, triple[i * 3 + 1])
            fds = appendArray(fds, triple[i * 3 + 2])
            fds = appendArray(fds, kinds[i])
            fds = appendArray(fds, retkinds[i])
            i = i + 1
        }
        let changed = 0
        i = 0
        while (i < np) {
            let plans = []
            let j = 0
            while (j < np) {
                plans = appendArray(plans, natNativePlanForKinds(triple[j * 3 + 1], kinds[j], triple[j * 3 + 2], natStructTable([]), fds))
                j = j + 1
            }
            let r = natNativeInferInStmts(triple[i * 3 + 2], plans[i], fds, kinds, 1)
            changed = changed + r[0]
            let wr = natNativeRetKindWalk(triple[i * 3 + 2], plans[i], fds)
            if (wr == 0) {
                // A MIXED return is only unsafe when a call site can BIND the result to
                // the wrong-typed slot. An unreachable function has no call sites, so
                // its mixed return binds nothing and the program can be emitted with
                // it skipped. A reachable one is refused by name.
                if (i < len(reachable) && reachable[i] == 0) {
                    i = i + 1
                    continue
                }
                return [kinds, retkinds, "mixed string and int return kinds in `" + triple[i * 3] + "`; refused rather than guess which value binds"]
            }
            if (wr == 2 && retkinds[i] == 1) {
                retkinds[i] = 2
                changed = changed + 1
            }
            i = i + 1
        }
        if (changed == 0) {
            // Final validation pass: no promotions; find conflicts.
            let fdsv = []
            i = 0
            while (i < np) {
                fdsv = appendArray(fdsv, triple[i * 3])
                fdsv = appendArray(fdsv, triple[i * 3 + 1])
                fdsv = appendArray(fdsv, triple[i * 3 + 2])
                fdsv = appendArray(fdsv, kinds[i])
                fdsv = appendArray(fdsv, retkinds[i])
                i = i + 1
            }
            i = 0
            while (i < np) {
                let plans = []
                let j = 0
                while (j < np) {
                    plans = appendArray(plans, natNativePlanForKinds(triple[j * 3 + 1], kinds[j], triple[j * 3 + 2], natStructTable([]), fdsv))
                    j = j + 1
                }
                let r = natNativeInferInStmts(triple[i * 3 + 2], plans[i], fdsv, kinds, 0)
                if (r[1] != "") { return [kinds, retkinds, r[1]] }
                i = i + 1
            }
            return [kinds, retkinds, ""]
        }
        pass = pass + 1
    }
    return [kinds, retkinds, "kind inference did not converge in 16 passes; refused rather than emit a half-inferred plan"]
}

// natNativeInferInStmts walks a statement list and processes every call site.
// `promote` is 1 in the propagation phase (an array or string argument promotes
// the callee parameter) and 0 in the validation phase (a non-matching argument
// for the promoted parameter is a conflict, reported with the function and
// parameter). `fds` are the descriptors the ret-kind resolution reads.
//
// Returns [promotions, conflict] - conflict is the first one found, "" when none.
func natNativeInferInStmts(stmts, plan, fds, kinds, promote) {
    let changed = 0
    let bad = ""
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        let t = nodeType(n)
        if (natNativeIsDecl(n)) {
            let r = natNativeInferInExpr(natNativeDeclValue(n), plan, fds, kinds, promote)
            changed = changed + r[0]
            if (bad == "") { bad = r[1] }
        } else if (t == NODE_PRINT()) {
            let r = natNativeInferInExpr(printVal(n), plan, fds, kinds, promote)
            changed = changed + r[0]
            if (bad == "") { bad = r[1] }
        } else if (t == NODE_RETURN()) {
            let r = natNativeInferInExpr(retVal(n), plan, fds, kinds, promote)
            changed = changed + r[0]
            if (bad == "") { bad = r[1] }
        } else if (t == NODE_EXPR_STMT()) {
            let r = natNativeInferInExpr(exprStmtExpr(n), plan, fds, kinds, promote)
            changed = changed + r[0]
            if (bad == "") { bad = r[1] }
        } else if (t == NODE_IF()) {
            let r = natNativeInferInExpr(ifCond(n), plan, fds, kinds, promote)
            changed = changed + r[0]
            if (bad == "") { bad = r[1] }
            let r2 = natNativeInferInStmts(ifCons(n), plan, fds, kinds, promote)
            changed = changed + r2[0]
            if (bad == "") { bad = r2[1] }
            let r3 = natNativeInferInStmts(ifAlt(n), plan, fds, kinds, promote)
            changed = changed + r3[0]
            if (bad == "") { bad = r3[1] }
        } else if (t == NODE_WHILE()) {
            let r = natNativeInferInExpr(whileCond(n), plan, fds, kinds, promote)
            changed = changed + r[0]
            if (bad == "") { bad = r[1] }
            let r2 = natNativeInferInStmts(whileBody(n), plan, fds, kinds, promote)
            changed = changed + r2[0]
            if (bad == "") { bad = r2[1] }
        } else if (t == NODE_FOR()) {
            let ini = forInit(n)
            if (nodeType(ini) == NODE_EXPR_STMT()) {
                let r = natNativeInferInExpr(exprStmtExpr(ini), plan, fds, kinds, promote)
                changed = changed + r[0]
                if (bad == "") { bad = r[1] }
            } else if (natNativeIsDecl(ini)) {
                let r = natNativeInferInExpr(natNativeDeclValue(ini), plan, fds, kinds, promote)
                changed = changed + r[0]
                if (bad == "") { bad = r[1] }
            }
            let r2 = natNativeInferInExpr(forCond(n), plan, fds, kinds, promote)
            changed = changed + r2[0]
            if (bad == "") { bad = r2[1] }
            let r3 = natNativeInferInExpr(forPost(n), plan, fds, kinds, promote)
            changed = changed + r3[0]
            if (bad == "") { bad = r3[1] }
            let r4 = natNativeInferInStmts(forBody(n), plan, fds, kinds, promote)
            changed = changed + r4[0]
            if (bad == "") { bad = r4[1] }
        } else if (t == NODE_FOR_IN()) {
            let r2 = natNativeInferInStmts(forInBody(n), plan, fds, kinds, promote)
            changed = changed + r2[0]
            if (bad == "") { bad = r2[1] }
        } else if (t == NODE_BINARY()) {
            let r = natNativeInferInExpr(binaryLeft(n), plan, fds, kinds, promote)
            changed = changed + r[0]
            if (bad == "") { bad = r[1] }
            let r2 = natNativeInferInExpr(binaryRight(n), plan, fds, kinds, promote)
            changed = changed + r2[0]
            if (bad == "") { bad = r2[1] }
        }
        i = i + 1
    }
    return [changed, bad]
}

func natNativeInferInExpr(e, plan, fds, kinds, promote) {
    let t = nodeType(e)
    if (t == NODE_CALL()) {
        let callee = callFunc(e)
        let fi = natNativeFuncIndex(fds, callee)
        if (fi >= 0) {
            let pk = fds[fi * 5 + 1]
            let args = callArgs(e)
            let changed = 0
            let bad = ""
            let i = 0
            while (i < len(args)) {
                // A call IN ARGUMENT POSITION consumes the argument spill before the
                // enclosing call reads it, so an inner call in argument 1+ is refused
                // in the scan; the inference can still see its call sites there, which
                // is what keeps promotions complete for supported programs.
                let ak = natNativeArgKindFor(args[i], plan)
                let r = natNativeInferInExpr(args[i], plan, fds, kinds, promote)
                changed = changed + r[0]
                if (bad == "") { bad = r[1] }
                if (ak == 2 || ak == 3) {
                    let want = natKindArray()
                    if (ak == 2) { want = natKindString() }
                    if (promote == 1) {
                        if (kinds[fi][i] == natKindInt()) {
                            kinds[fi][i] = want
                            changed = changed + 1
                        }
                    } else {
                        if (kinds[fi][i] != want) {
                            let kindName = "array"
                            if (ak == 2) { kindName = "string" }
                            if (bad == "") { bad = "argument " + str(i + 1) + " of the call to `" + callee + "` is a " + kindName + ", but its parameter `" + pk[i] + "` was not promoted to one" }
                        }
                    }
                } else {
                    if (promote == 0 && kinds[fi][i] == natKindArray()) {
                        if (bad == "") { bad = "int argument for array parameter `" + pk[i] + "` (call to `" + callee + "`)" }
                    }
                    if (promote == 0 && kinds[fi][i] == natKindString()) {
                        if (bad == "") { bad = "int argument for string parameter `" + pk[i] + "` (call to `" + callee + "`)" }
                    }
                }
                i = i + 1
            }
            return [changed, bad]
        }
        return [0, ""]
    }
    if (t == NODE_INDEX()) {
        let r = natNativeInferInExpr(indexExpr(e), plan, fds, kinds, promote)
        return [r[0], r[1]]
    }
    if (t == NODE_BINARY()) {
        let r = natNativeInferInExpr(binaryLeft(e), plan, fds, kinds, promote)
        let r2 = natNativeInferInExpr(binaryRight(e), plan, fds, kinds, promote)
        let bad2 = ""
        if (r[1] != "") { bad2 = r[1] } else { bad2 = r2[1] }
        return [r[0] + r2[0], bad2]
    }
    if (t == NODE_UNARY()) {
        return natNativeInferInExpr(unaryOperand(e), plan, fds, kinds, promote)
    }
    if (t == NODE_ARRAY_LIT()) {
        let elems = arrayLitElems(e)
        let i = 0
        let changed = 0
        let bad = ""
        while (i < len(elems)) {
            let r = natNativeInferInExpr(elems[i], plan, fds, kinds, promote)
            changed = changed + r[0]
            if (bad == "") { bad = r[1] }
            i = i + 1
        }
        return [changed, bad]
    }
    if (t == NODE_DOT()) {
        return natNativeInferInExpr(dotLeft(e), plan, fds, kinds, promote)
    }
    return [0, ""]
}

func natNativeFuncCount(fns) { return len(fns) / 5 }
func natNativeFuncNameAt(fns, i) { return fns[i * 5] }
func natNativeFuncParamsAt(fns, i) { return fns[i * 5 + 1] }
func natNativeFuncBodyAt(fns, i) { return fns[i * 5 + 2] }
func natNativeFuncKindsAt(fns, i) { return fns[i * 5 + 3] }

// natNativeFuncIndex returns the descriptor index for `name`, or -1.
func natNativeFuncIndex(fns, name) {
    let i = 0
    while (i < natNativeFuncCount(fns)) {
        if (natNativeFuncNameAt(fns, i) == name) { return i }
        i = i + 1
    }
    return 0 - 1
}

// natNativeFuncLabel is the oracle's naming rule (program.go:4811-4814), reproduced
// rather than invented: main is `karkain_main` because the entry stub calls that
// symbol, and every other function is `fn_<name>`. The `$ret` label a body jumps to
// is derived from THIS label, so the two cannot disagree.
func natNativeFuncLabel(name) {
    if (name == "main") { return "karkain_main" }
    return "fn_" + name
}

// natNativeExprHasCall reports whether an expression contains a call anywhere inside.
//
// It exists to REFUSE one shape rather than to accept one. The argument spill is
// PER ARGUMENT INDEX and is reused by every call: `f(g(1), h(2))` evaluates g, stores
// its result at argTemp(0), then evaluates h -- whose own argument is staged at
// argTemp(0), clobbering f's first argument. The oracle has the same defect and this
// slice does not fix it; it refuses it, by name, so it cannot be mistaken for working.
// An argument at index 0 is unaffected (its spill is written last), which is why the
// check is conditioned on the index rather than applied to every argument.
func natNativeExprHasCall(e) {
    let t = nodeType(e)
    if (t == NODE_CALL()) { return 1 }
    if (t == NODE_BINARY()) {
        return natNativeExprHasCall(binaryLeft(e)) + natNativeExprHasCall(binaryRight(e))
    }
    if (t == NODE_UNARY()) { return natNativeExprHasCall(unaryOperand(e)) }
    return 0
}

// natNativeScanCall validates a call to a USER function.
//
// Everything here is a refusal path except the recursive argument check, and that is
// the point: a call is either fully understood (arity, defined callee, int arguments)
// or named. `len` is refused HERE rather than treated as undefined, because it IS
// defined -- it is a builtin the driver lowers in main but not inside a callee, and
// telling a user their call to a real builtin is "undefined" would be a worse
// diagnostic than the true one.
func natNativeScanCall(e, plan, line, fns) {
    let fname = callFunc(e)
    if (fname == "trim") { return natNativeScanTrim(e, plan, line, fns) }
    if (fname == "len") {
        return natNativeRefuse("`len()` inside a called function is not lowered by the " +
            "native driver in this slice", line)
    }
    let fi = natNativeFuncIndex(fns, fname)
    if (fi < 0) {
        // A callee that is not one of this program's functions is a BUILTIN in every
        // case that reaches here: kcc's checker already rejects a genuinely undefined
        // function with error[K101] before the driver runs (measured). Naming it as a
        // builtin is therefore accurate, and it keeps the phrase "is not lowered by
        // the native driver" that the frozen 9e gate asserts -- the first draft said
        // "call to undefined function `abs`", which is not true of `abs` and which
        // turned a correct refusal into a wrong diagnostic.
        if (isCheckerBuiltin(fname) == 1) {
            return natNativeRefuse("call to builtin `" + fname + "` is not lowered by " +
                "the native driver in this slice (only a function defined in this " +
                "program can be called)", line)
        }
        return natNativeRefuse("call to undefined function `" + fname + "`", line)
    }
    let params = natNativeFuncParamsAt(fns, fi)
    let args = callArgs(e)
    let pkinds = natNativeFuncKindsAt(fns, fi)
    if (len(args) != len(params)) {
        return natNativeRefuse("call to `" + fname + "` has " + str(len(args)) +
            " argument(s) but `" + fname + "` declares " + str(len(params)), line)
    }
    let i = 0
    while (i < len(args)) {
        if (i >= 1) {
            if (natNativeExprHasCall(args[i]) == 1) {
                // An argument at index >= 1 that contains a call would be
                // overwritten when the inner call reuses the spill area.
                // Refusing it is honest; silently mis-passing is not. This
                // applies to every argument at index >= 1, whatever its kind.
                return natNativeRefuse("argument " + str(i + 1) + " of the call to `" +
                    fname + "` contains another call; the argument spill area is reused " +
                    "across calls, so an inner call would clobber an earlier argument -- " +
                    "bind the inner result to a local first", line)
            }
        } else {
            // NAT-STRTRIM: an inner call at argument index 0 is the one nesting
            // shape the spill area permits -- nothing earlier needs to survive
            // it, and an int argument goes through the int walker, which
            // recurses into the callee natively. A string or array argument
            // does not: the two-unit staging resolves identName() on the CALL
            // node to a slot that does not exist, and the self-hosted compiler
            // died with an access violation (measured, f(trim(s))). Refused by
            // name for those kinds; the int case is unchanged.
            if (natNativeExprHasCall(args[i]) == 1 && natNativeArgKindFor(args[i], plan) != 1) {
                return natNativeRefuse("argument " + str(i + 1) + " of the call to `" +
                    fname + "` contains another call; the argument spill area is reused " +
                    "across calls, so an inner call would clobber an earlier argument -- " +
                    "bind the inner result to a local first", line)
            }
        }
        // An ARRAY parameter receives exactly one shape: an identifier whose slot
        // is an array (a literal or another parameter). Everything else -- an int
        // literal, a call, an expression -- is refused BY NAME rather than
        // mis-homed into a two-unit array slot.
        // A STRING parameter receives a string literal or an identifier whose
        // slot holds a string. Everything else is refused BY NAME.
        if (pkinds[i] == natKindString()) {
            let ak = natNativeArgKindFor(args[i], plan)
            if (ak != 2) {
                if (nodeType(args[i]) == NODE_CALL()) {
                    return natNativeRefuse("string parameter `" + params[i] + "` (call to `" +
                        fname + "`) receives an inner call; the argument spill area is reused " +
                        "across calls, so an inner call would clobber an earlier argument -- " +
                        "bind the inner result to a local first", line)
                }
                return natNativeRefuse("int argument for string parameter `" + params[i] +
                    "` (call to `" + fname + "`)", line)
            }
            if (nodeType(args[i]) != NODE_IDENT() && nodeType(args[i]) != NODE_STRING_LIT()) {
                return natNativeRefuse("string parameter `" + params[i] + "` (call to `" +
                    fname + "`) receives an expression; bind it to a local first", line)
            }
            i = i + 1
            continue
        }
        if (pkinds[i] == natKindArray()) {
            let ak = natNativeArgKindFor(args[i], plan)
            if (ak != 3) {
                if (nodeType(args[i]) == NODE_INT_LIT() || nodeType(args[i]) == NODE_IDENT()) {
                    return natNativeRefuse("int argument for array parameter `" + params[i] +
                        "` (call to `" + fname + "`)", line)
                }
                return natNativeRefuse("array parameter `" + params[i] + "` (call to `" +
                    fname + "`) receives an array literal or expression; bind it to a local " +
                    "first", line)
            }
            // Identifiers only: an array LITERAL as an argument has no slots to
            // stage from, so it is refused rather than mis-emitted.
            if (nodeType(args[i]) != NODE_IDENT()) {
                return natNativeRefuse("array parameter `" + params[i] + "` (call to `" +
                    fname + "`) receives an array literal; bind it to a local first", line)
            }
            i = i + 1
            continue
        }
        // An int parameter receives exactly one unit. A string or array argument
        // is named with its own kind.
        let ak = natNativeArgKindFor(args[i], plan)
        if (ak == 2) {
            return natNativeRefuse("string argument for int parameter `" + params[i] +
                "` (call to `" + fname + "`)", line)
        }
        if (ak == 3) {
            return natNativeRefuse("array argument for int parameter `" + params[i] +
                "` (call to `" + fname + "`)", line)
        }
        // Every parameter is an int in this slice (the parser stores parameter NAMES
        // only, so a parameter's declared kind is not recoverable here). Naming the
        // offending argument's kind and the parameter it targets matches the oracle's
        // own diagnostic word for word -- measured: `error[K145]: string argument for
        // int parameter 'n' (call to 'f')` -- instead of falling through to the generic
        // "expression of kind 23", which names a node number nobody can act on.
        let wk = natNativeArgKindName(args[i], plan)
        if (wk != "") {
            return natNativeRefuse(wk + " argument for int parameter `" +
                params[i] + "` (call to `" + fname + "`)", line)
        }
        let bad = natNativeScanIntExpr(args[i], plan, line, fns, 0)
        if (bad != "") { return bad }
        i = i + 1
    }
    return ""
}

// natNativeArgKindName names the kind of a call argument that this slice CANNOT pass,
// or "" when the argument is not one of the named cases and the ordinary int scan
// should decide. It exists to make the diagnostic specific: the scan below would
// otherwise report a node NUMBER.
func natNativeArgKindName(e, plan) {
    let t = nodeType(e)
    if (t == NODE_STRING_LIT()) { return "string" }
    if (t == NODE_FLOAT_LIT()) { return "float" }
    if (t == NODE_BOOL_LIT()) { return "bool" }
    if (t == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(e))
        if (ord >= 0) {
            let k = natNativeSlotKind(plan, ord)
            if (k != natKindInt()) { return natKindName(k) }
        }
    }
    return ""
}

// natNativeCondOp maps a comparison operator to the oracle's condition opcode.
//
// The mapping is the oracle's emitCond switch (program.go:5121-5134) read as the
// JUMP it emits: the condition FALLS THROUGH when the comparison HOLDS, so each
// operator jumps to the false label on the INVERSE test.
//
//	==  jumps on Jnz (not equal)   !=  jumps on Jz  (equal)
//	<   jumps on Jge               <=  jumps on Jg
//	>   jumps on Jle               >=  jumps on Jl
//
// The same six codes appear in the Step 3 reference corpus (natIntCond), which
// is where this mapping was first pinned against the oracle's bytes.
func natNativeCondOp(op) {
    if (op == "==") { return 0 }
    if (op == "!=") { return 1 }
    if (op == "<") { return 2 }
    if (op == "<=") { return 3 }
    if (op == ">") { return 4 }
    if (op == ">=") { return 5 }
    return -1
}

// natNativeScanCond validates the CONDITION of an `if`.
//
// The condition must be an integer comparison. The wording is the ORACLE's own
// (program.go:5074/5079), because the two engines must say the same thing about
// the same program: the C path and the native path already share that sentence,
// and a third wording would make the native refusal look like a different rule.
//
// A comparison is a CONDITION, not a value: the oracle's emitExpr refuses any
// operator other than + - *, so `let c = (a < b)` is not an expression in this
// language on this target, and the condition scan is the only place a comparison
// is accepted.
func natNativeScanCond(cond, plan, line, fns) {
    if (nodeType(cond) != NODE_BINARY()) {
        return natNativeRefuse("condition must be a comparison (==, !=, <, <=, >, >=) over ints or floats", line)
    }
    if (natNativeCondOp(binaryOp(cond)) < 0) {
        return natNativeRefuse("condition must be a comparison (==, !=, <, <=, >, >=) over ints or floats, found '" +
            binaryOp(cond) + "'", line)
    }
    // NAT-STREQ: either side a string makes this a STRING comparison -- the
    // oracle's emitCond routes on isStringExpr(Left) (program.go:5081) then
    // isStringExpr(Right) (:5093), and "the handler names whichever operand
    // is not one". The classifier is natNativeStrKind, the same one
    // natEmitCond routes the EMIT side with, so the scan and the emission
    // cannot disagree about which path a condition takes.
    if (natNativeStrKind(binaryLeft(cond), 0, plan) == 1 ||
        natNativeStrKind(binaryRight(cond), 0, plan) == 1) {
        return natNativeScanStrEqCond(cond, plan, line)
    }
    // The oracle evaluates the operands at depth 1 (program.go:5135/5140), so a
    // nested binary operand stages at the same offsets.
    let bad = natNativeScanIntExpr(binaryLeft(cond), plan, line, fns, 1)
    if (bad != "") { return bad }
    return natNativeScanIntExpr(binaryRight(cond), plan, line, fns, 1)
}

// NAT-STREQ scan half. natNativeScanStrEqCond validates one STRING comparison
// in the oracle's emitCond/emitStrEqCond order (program.go:5088-5091 then
// :4999-5012): the operator is checked FIRST -- only == and != exist, and an
// ordering operator gets the ordering refusal -- then each operand is kinded.
//
// SLICE-1 SCOPE, recorded as a divergence from the oracle: an operand must be
// a string LITERAL or a string LOCAL. The oracle accepts a concatenation
// operand (emitStr lowers it and the arena pays for it), a record-field read
// and a call operand; reproducing those needs the arena reachable from the
// condition path, which is its own slice. The refusal names the construct.
func natNativeScanStrEqCond(cond, plan, line) {
    let op = binaryOp(cond)
    if (op != "==" && op != "!=") {
        // The oracle's wording, verbatim (program.go:5089/5099) with kcc's
        // own line prefix around it.
        return natNativeRefuse("string ordering ('" + op + "') is not supported; == and != compare content", line)
    }
    let bad = natNativeScanStrEqOperand(binaryLeft(cond), plan, line)
    if (bad != "") { return bad }
    return natNativeScanStrEqOperand(binaryRight(cond), plan, line)
}

// natNativeScanStrEqOperand kinds ONE equality operand. The oracle does this
// with exprKind inside emitStrEqCond (program.go:4999-5012) and refuses with
// kindName; the slice-1 classifier handles the shapes the driver can lower
// (literal, string local) and names every other one.
func natNativeScanStrEqOperand(e, plan, line) {
    if (nodeType(e) == NODE_STRING_LIT()) { return "" }
    if (nodeType(e) == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(e))
        if (ord < 0) {
            return natNativeRefuse("cannot determine the kind of '" + identName(e) +
                "' in a string comparison", line)
        }
        if (natNativeSlotKind(plan, ord) != natKindString()) {
            // The oracle's message, verbatim (program.go:5004/5011): the
            // handler names whichever operand is not a string.
            return natNativeRefuse(natKindName(natNativeSlotKind(plan, ord)) +
                " operand in string comparison (no implicit conversion)", line)
        }
        return ""
    }
    // Literal kinds the value model has but a string comparison cannot mix
    // with. The oracle reaches the same refusals through exprKind + kindName.
    if (nodeType(e) == NODE_INT_LIT()) {
        return natNativeRefuse("int operand in string comparison (no implicit conversion)", line)
    }
    if (nodeType(e) == NODE_FLOAT_LIT()) {
        return natNativeRefuse("float operand in string comparison (no implicit conversion)", line)
    }
    if (nodeType(e) == NODE_BOOL_LIT()) {
        return natNativeRefuse("bool operand in string comparison (no implicit conversion)", line)
    }
    // Slice-1 divergence, recorded: a concatenation, a call, a record-field
    // read or an indexed operand inside a comparison is refused BY NAME.
    // Equality stages its operands directly and allocates nothing, so the
    // arena machinery is deliberately not reachable from here yet.
    let what = "this operand"
    if (nodeType(e) == NODE_BINARY()) { what = "a concatenation operand" }
    if (nodeType(e) == NODE_CALL()) { what = "a call operand" }
    if (nodeType(e) == NODE_DOT()) { what = "a record-field operand" }
    if (nodeType(e) == NODE_INDEX()) { what = "an indexed operand" }
    return natNativeRefuse(what + " in a string comparison is not lowered by the native driver here" +
        " (a string literal or a string local is required)", line)
}

// natNativeScanIf validates one `if` statement: its condition and both branch
// bodies.
//
// `fnStmts` is the FUNCTION's statement list, not the branch's. The branch's
// own list is what is being validated; the function's list is what the
// record-type lookup needs, because a record bound at the top level is still
// that record when a field inside a branch is assigned.
func natNativeScanIf(n, plan, tbl, fns, isMain, fnStmts, loopDepth) {
    let bad = natNativeScanCond(ifCond(n), plan, ifLine(n), fns)
    if (bad != "") { return bad }
    bad = natNativeScanStmts(ifCons(n), plan, tbl, fns, isMain, fnStmts, loopDepth, 1)[0]
    if (bad != "") { return bad }
    return natNativeScanStmts(ifAlt(n), plan, tbl, fns, isMain, fnStmts, loopDepth, 1)[0]
}

// natNativeScanLoopArena refuses the ARENA-using constructs inside a loop body.
//
// THIS IS THE MEMORY-SAFETY GATE OF NAT-LOOP, and it is the reason a loop can
// be lowered at all.
//
// The native path's heap arena is sized AT COMPILE TIME from the program's
// allocation sites: the oracle's rule is that each site runs at most ONCE, so
// `sites * bytes` bounds the total. Inside a loop the same site runs an
// unbounded number of times, and that bound stops being provable. The oracle
// therefore refuses exactly three things inside a loop, and this driver
// refuses the same three with the same words:
//
//	string concatenation   (program.go:6629)
//	push()                 (program.go:5487)
//	map insertion          (program.go:4136)
//
// The refusal is by NAME and says WHY, because "not supported" would leave the
// reader guessing whether the program is wrong or the toolchain is.
//
// The scan walks the WHOLE loop body, including nested branches and nested
// loops, because a concatenation inside an `if` inside a loop is still a
// concatenation inside a loop. `natNativeArenaKindInStmts` recurses, so the
// bound it protects is the bound that actually applies.
//
// NOTE what is NOT here: a plain integer local, an array literal, a record
// literal and a string LITERAL are all fine inside a loop, because none of
// them allocates at RUN time. An array literal's elements live in the frame
// (Phase 150A), a record's field area lives in the frame (Phase 150B3b), and
// a string literal's bytes live in the static rodata section. The only
// run-time allocations in this driver are the arena ones listed above, and
// they are exactly the ones refused here.
func natNativeScanLoopArena(stmts, plan) {
    let kind = natNativeArenaKindInStmts(stmts, plan)
    if (kind == 1) {
        return "string concatenation inside a loop is not supported on the native target (the heap arena is sized at compile time, so a repeated concatenation cannot be bounded)"
    }
    if (kind == 2) {
        return "push() inside a loop is not supported on the native target (the heap arena is sized at compile time, so a repeated push cannot be bounded)"
    }
    if (kind == 3) {
        return "map insertion inside a loop is not supported on the native target (map capacity is sized at compile time, so a repeated insert cannot be bounded)"
    }
    return ""
}

// natNativeArenaKindInStmts scans a statement list for an arena-using
// construct, recursing into nested branches and nested loops.
//
// It returns 1 for a string concatenation, 2 for a push(), 3 for a map
// insertion, and 0 when there is none.
func natNativeArenaKindInStmts(stmts, plan) {
    let i = 0
    while (i < len(stmts)) {
        let st = stmts[i]
        let k = 0
        if (natNativeIsDecl(st)) {
            k = natNativeArenaKindIn(natNativeDeclValue(st), plan)
        }
        if (k == 0 && nodeType(st) == NODE_PRINT()) {
            k = natNativeArenaKindIn(printVal(st), plan)
        }
        if (k == 0 && nodeType(st) == NODE_RETURN()) {
            k = natNativeArenaKindIn(retVal(st), plan)
        }
        if (k == 0 && nodeType(st) == NODE_EXPR_STMT()) {
            let e = exprStmtExpr(st)
            // A map INSERTION is `m[k] = v`: an assignment whose target is an
            // index into a MAP local. An index into an ARRAY is not an
            // insertion, so the local's kind decides -- the oracle makes the
            // same distinction (program.go:791).
            if (natNativeIsAssignExpr(e) && nodeType(binaryLeft(e)) == NODE_INDEX()) {
                let lidx = binaryLeft(e)
                let ordm = natNativeSlotIndex(plan, identName(indexLeft(lidx)))
                if (ordm >= 0 && natNativeSlotKind(plan, ordm) == natKindMap()) { k = 3 }
            }
            if (k == 0) { k = natNativeArenaKindIn(e, plan) }
        }
        if (k == 0 && nodeType(st) == NODE_IF()) {
            k = natNativeArenaKindInStmts(ifCons(st), plan)
            if (k == 0) { k = natNativeArenaKindInStmts(ifAlt(st), plan) }
        }
        if (k == 0 && nodeType(st) == NODE_WHILE()) {
            k = natNativeArenaKindInStmts(whileBody(st), plan)
        }
        if (k == 0 && nodeType(st) == NODE_FOR()) {
            k = natNativeArenaKindInStmts(forBody(st), plan)
        }
        if (k != 0) { return k }
        i = i + 1
    }
    return 0
}

// natNativeArenaKindIn scans an expression tree for an arena-using construct.
//
// The two it can find are a string concatenation (a `+` whose operands are
// strings) and a push() call. A map INSERTION is a statement shape, not an
// expression shape, so it is not looked for here -- and the driver refuses
// map insertions in every position already, so a loop cannot smuggle one in.
//
// The string test is natNativeIsStrBinary, which resolves an operand's kind
// through the PLAN; its `stmts` argument is unused, which is why an empty
// list is passed here.
func natNativeArenaKindIn(e, plan) {
    let t = nodeType(e)
    if (t == NODE_BINARY()) {
        if (binaryOp(e) == "+") {
            if (natNativeIsStrBinary(e, [], plan) == 1) { return 1 }
        }
        let k = natNativeArenaKindIn(binaryLeft(e), plan)
        if (k != 0) { return k }
        return natNativeArenaKindIn(binaryRight(e), plan)
    }
    if (t == NODE_CALL()) {
        if (callFunc(e) == "push") { return 2 }
        let i = 0
        while (i < len(callArgs(e))) {
            let k = natNativeArenaKindIn(callArgs(e)[i], plan)
            if (k != 0) { return k }
            i = i + 1
        }
        return 0
    }
    if (t == NODE_UNARY()) { return natNativeArenaKindIn(unaryOperand(e), plan) }
    if (t == NODE_INDEX()) { return natNativeArenaKindIn(indexExpr(e), plan) }
    return 0
}

// natNativeScanForInit validates a C-style `for`'s INIT clause.
//
// The init is either a `let`/`var` binding or an assignment to an existing
// local. The oracle emits it as a statement BEFORE the loop's first label
// (program.go:5257-5261), so a `let` in the init is a real binding with a
// real frame slot -- the oracle's layout pass descends into the init
// (program.go:4679-4682), and natNativePlanDecls does the same.
func natNativeScanForInit(init, plan, tbl, fns, isMain) {
    if (len(init) == 0) { return "" }
    if (natNativeIsDecl(init)) {
        return natNativeScanIntExpr(natNativeDeclValue(init), plan, natNativeDeclLine(init), fns, 0)
    }
    if (natNativeIsAssignExpr(init)) {
        return natNativeScanAssignLocal(plan, fns, binaryLine(init), binaryLeft(init), binaryRight(init))
    }
    return natNativeRefuseNoLine("a `for` init must be a `let` or an assignment, not `" +
        getNodeType(init) + "`")
}

// natNativeScanForPost validates a C-style `for`'s POST clause.
//
// The post is an ASSIGNMENT to an existing local. The oracle wraps a bare `=`
// BinaryExpr in an ExprStmt before lowering it (program.go:5282-5285), which
// is why the post arrives here as a bare expression rather than as a
// statement.
func natNativeScanForPost(post, plan, tbl, fns, isMain) {
    if (len(post) == 0) { return "" }
    if (natNativeIsAssignExpr(post)) {
        return natNativeScanAssignLocal(plan, fns, binaryLine(post), binaryLeft(post), binaryRight(post))
    }
    return natNativeRefuseNoLine("a `for` post must be an assignment, not `" +
        getNodeType(post) + "`")
}

// natNativeScanAssignLocal validates `x = <int expression>` where x is an
// existing local.
//
// This is the loop counter's assignment. The oracle's rule (program.go:4952-
// 4969) is: the target must be a plain variable, it must have a slot, it must
// not be a string or an array (those are immutable through this form), and
// the right-hand side's kind must match the variable's.
//
// The right-hand side must be an INTEGER here, because the driver's value
// model has one unit for an int and the reassignment is a frame-slot store;
// a string or an array reassignment would need the rodata cursor or the
// arena, and the oracle refuses those anyway.
func natNativeScanAssignLocal(plan, fns, line, lhs, rhs) {
    if (nodeType(lhs) != NODE_IDENT()) {
        return natNativeRefuse("assignment target must be a variable", line)
    }
    let ord = natNativeSlotIndex(plan, identName(lhs))
    if (ord < 0) {
        return natNativeRefuse("undefined identifier '" + identName(lhs) + "'", line)
    }
    let k = natNativeSlotKind(plan, ord)
    if (k != natKindInt()) {
        if (k == natKindString() || k == natKindArray()) {
            return natNativeRefuse("cannot reassign " + natKindName(k) + " '" + identName(lhs) +
                "' (declare a fresh variable)", line)
        }
        return natNativeRefuse("cannot assign to a " + natKindName(k) + " variable '" +
            identName(lhs) + "'", line)
    }
    return natNativeScanIntExpr(rhs, plan, line, fns, 0)
}

// natNativeScanIntExpr validates an INTEGER expression and nothing else.
//
// The subset is the oracle's int path: literals, int locals, `+ - *`, unary `-`, and
// calls to user functions. It deliberately has no `stmts`/`roffs`/`tbl` parameter --
// an int expression cannot touch rodata, a record or a string path, and passing them
// would invite an arm that does.
//
// `depth` mirrors the oracle exactly (program.go:6717-6723): the operator is checked
// BEFORE the depth guard, and both operands are emitted at depth+1. Unary `-` passes
// the SAME depth (program.go:5944), which is why `-a + b` and `a + b` nest alike.
func natNativeScanIntExpr(e, plan, line, fns, depth) {
    let t = nodeType(e)
    if (t == NODE_INT_LIT()) { return "" }
    if (t == NODE_BOOL_LIT()) { return "" }
    if (t == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(e))
        if (ord < 0) {
            return natNativeRefuse("undeclared local `" + identName(e) + "`", line)
        }
        let k = natNativeSlotKind(plan, ord)
        if (k != natKindInt()) {
            return natNativeRefuse("`" + identName(e) + "` is " + natKindName(k) +
                "; only an int may appear in an arithmetic expression or be passed to a " +
                "function in this slice", line)
        }
        return ""
    }
    if (t == NODE_UNARY()) {
        if (unaryOp(e) != "-") {
            return natNativeRefuse("unsupported unary operator '" + unaryOp(e) + "'", line)
        }
        return natNativeScanIntExpr(unaryOperand(e), plan, line, fns, depth)
    }
    if (t == NODE_INDEX()) {
        // NAT-IDX: an array element read. The target must be an ARRAY local,
        // and the index must itself be an integer expression -- which is what
        // makes `a[i]` ordinary array iteration rather than a literal-only
        // special case.
        //
        // The KIND CHECK IS LOAD-BEARING, not decoration. Without it,
        // `let a = 7; print(a[0])` scans clean: the target is an identifier, it
        // resolves to a local, and the index is an integer expression.
        // Lowering then treats that local's 8-byte scalar slot as a two-unit
        // (base, len) array header, loads a "length" out of the neighbouring
        // slot, and reads an element from whatever address that base happens
        // to be. It produced a VALID PE, which is the worst outcome: no
        // diagnostic, no trap, a wrong number.
        //
        // The diagnostics are the oracle's own (program.go:6290-6297): an index
        // target must be a variable, it must exist, and it must be an array.
        if (nodeType(indexLeft(e)) != NODE_IDENT()) {
            return natNativeRefuse("array index target must be a variable", line)
        }
        let ord = natNativeSlotIndex(plan, identName(indexLeft(e)))
        if (ord < 0) {
            return natNativeRefuse("undefined identifier '" + identName(indexLeft(e)) + "'", line)
        }
        let k = natNativeSlotKind(plan, ord)
        if (k == natKindString()) {
            return natNativeRefuse("string index of '" + identName(indexLeft(e)) +
                "' cannot appear in an integer expression " +
                "(a byte index yields a string)", line)
        }
        if (k != natKindArray()) {
            return natNativeRefuse("index target must be an array (got " + natKindName(k) +
                " '" + identName(indexLeft(e)) + "')", line)
        }
        // The index is evaluated at depth+1, which is the oracle's depth for the
        // index expression (program.go:6320).
        return natNativeScanIntExpr(indexExpr(e), plan, line, fns, depth + 1)
    }
    if (t == NODE_BINARY()) {
        let op = binaryOp(e)
        if (op != "+" && op != "-" && op != "*") {
            return natNativeRefuse("unsupported operator '" + op + "' (want +, - or *)", line)
        }
        if (depth >= natMaxBinDepth()) {
            return natNativeRefuse("expression nesting exceeds " + str(natMaxBinDepth()) +
                " binary levels", line)
        }
        let bad = natNativeScanIntExpr(binaryLeft(e), plan, line, fns, depth + 1)
        if (bad != "") { return bad }
        return natNativeScanIntExpr(binaryRight(e), plan, line, fns, depth + 1)
    }
    if (t == NODE_CALL()) {
        if (callFunc(e) == "len") {
            // NAT-STRTRIM: `len(trim(s))` is lowered only at a len site that
            // carries string-value context (a direct print or return value).
            // Nested inside arithmetic it would need the string emitter inside
            // the int walker, which is its own slice; refused by name rather than
            // emitting a wrong answer.
            let margs = callArgs(e)
            if (len(margs) == 1) {
                if (nodeType(margs[0]) == NODE_CALL()) {
                    if (callFunc(margs[0]) == "trim") {
                        return natNativeRefuse("len(trim(s)) inside arithmetic is not lowered (only as a direct print or return value)", line)
                    }
                }
            }
            return natNativeScanLen(e, plan, line, fns)
        }
        return natNativeScanCall(e, plan, line, fns)
    }
    // getNodeType, not a node NUMBER. "expression of kind 23" was the first draft and
    // it names something a reader cannot act on; the AST bridge's own name is what the
    // rest of the compiler reports.
    return natNativeRefuse("`" + getNodeType(e) + "` is not an integer expression " +
        "the native driver lowers here", line)
}

// natNativeMaxExtras reproduces the oracle's scanMaxExtras (program.go:4494): the
// largest number of 8-byte argument UNITS any call in this function leaves in the
// caller-frame extras area. It is measured PER FUNCTION because the extras area is
// reserved in the CALLER's frame, so one function's deep call must not enlarge
// another's frame.
func natNativeMaxExtras(stmts, plan) {
    let best = 0
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        if (natNativeIsDecl(n)) {
            let m = natNativeMaxExtrasExpr(natNativeDeclValue(n), plan)
            if (m > best) { best = m }
        }
        if (nodeType(n) == NODE_PRINT()) {
            let m = natNativeMaxExtrasExpr(printVal(n), plan)
            if (m > best) { best = m }
        }
        if (nodeType(n) == NODE_RETURN()) {
            let m = natNativeMaxExtrasExpr(retVal(n), plan)
            if (m > best) { best = m }
        }
        if (nodeType(n) == NODE_EXPR_STMT()) {
            let m = natNativeMaxExtrasExpr(exprStmtExpr(n), plan)
            if (m > best) { best = m }
        }
        i = i + 1
    }
    return best
}

// natNativeMaxExtrasExpr walks an expression tree counting the UNITS a call
// would stage. `plan` resolves an argument's kind (ident whose slot is an int
// is one unit; an array literal or an array ident is two) ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â the same rule the
// call-site staging uses, so the spill sizing and the emission cannot disagree.
func natNativeMaxExtrasExpr(e, plan) {
    let t = nodeType(e)
    if (t == NODE_BINARY()) {
        let l = natNativeMaxExtrasExpr(binaryLeft(e), plan)
        let r = natNativeMaxExtrasExpr(binaryRight(e), plan)
        if (l > r) { return l }
        return r
    }
    if (t == NODE_UNARY()) { return natNativeMaxExtrasExpr(unaryOperand(e), plan) }
    if (t == NODE_CALL()) {
        let args = callArgs(e)
        // UNITS BEYOND THE SIX REGISTER ARGUMENTS, not the total. The oracle floors at
        // zero and subtracts `len(argRegs)` (program.go:4512-4514:
        // `if e := units - len(argRegs); e > max`). Returning the TOTAL here reserved
        // 56 bytes of extras for a seven-argument call where the oracle reserves 8 --
        // a 48-byte frame difference on the caller, which showed up as a byte-identity
        // failure on `main` alone while the callee (which has no calls) matched.
        //
        // Each argument is ONE unit for an int and TWO for an array (its
        // (base, len) header), so `units` is a sum, not a count.
        let units = 0
        let ui = 0
        while (ui < len(args)) {
            if (natNativeArgKindFor(args[ui], plan) != 1) {
                units = units + 2
            } else {
                units = units + 1
            }
            ui = ui + 1
        }
        let best = 0
        if (units > 6) { best = units - 6 }
        let inner = 0
        let i = 0
        while (i < len(args)) {
            let m = natNativeMaxExtrasExpr(args[i], plan)
            if (m > inner) { inner = m }
            i = i + 1
        }
        // Both, because the oracle takes the max of this call's overflow and its
        // arguments' overflow: `f(g(1),2,3,4,5,6,7)` overflows by 1 and its argument
        // by 0, while `f(g(1,2,3,4,5,6,7))` overflows by 0 and its argument by 1.
        if (inner > best) { return inner }
        return best
    }
    return 0
}

// natArrayValue materialises an array literal into its frame slot: the (base, len)
// header plus one int element per literal.
//
// The base is stored in the frame and RELOADED before each element store, exactly as
// the oracle does. The reason is worth keeping: evaluating an element is an arbitrary
// expression, and a base left in RBX across that evaluation could have been
// clobbered, so a stale base would write the element into the wrong place. With int
// literals today nothing clobbers it, but the reload is one instruction and it is
// what keeps the sequence correct for the non-literal elements a later slice allows.
func natArrayValue(s, off, elems) {
    s = natLeaRegStack(s, natRegRBX(), off + 16)
    s = natStoreStack(s, natRegRBX(), off)
    s = natMovRegImm64(s, natRegRAX(), len(elems))
    s = natStoreStack(s, natRegRAX(), off + 8)
    let i = 0
    while (i < len(elems)) {
        s = natMovRegImm64(s, natRegRAX(), int(intLitVal(elems[i])))
        s = natLoadStack(s, natRegRBX(), off)
        // 64-bit immediate into RCX, NOT the 32-bit form.
        //
        // Two reasons, and the second is the one that bites. (1) The oracle
        // emits MovRegImm64 for the index (program.go, emitArrayValue), so the
        // immediate is the same 10 bytes either side. (2) natMovRegImm32 emits
        // a bare `B9+rd` with NO REX prefix -- correct for rax..rdi, wrong for
        // RCX, because B9 with mod=3 and reg=001 *is* `mov ecx, imm32`, so the
        // index landed in the low half and the scaled store read the high half.
        // RCX is exactly the register the scaled form uses as its index, so the
        // bug is in the one register that cannot absorb it.
        //
        // This is the same class as the D2 operand-form fixes (int literals
        // computed straight into RDI) and as the D3 natHeapRef fix: a 32-bit
        // immediate is only valid for the low eight registers.
        s = natMovRegImm64(s, natRegRCX(), i)
        s = natStoreScaled64(s, natRegRAX(), natRegRBX(), natRegRCX(), 8, 0)
        i = i + 1
    }
    return s
}

// natArrayIndex loads element `idx` of the array whose header is at `off`, leaving
// the element in RAX.
//
// The bound is `0 <= i < len`, mirroring the oracle: the index is TESTed for a
// negative value first, then COMPAREd against the count with a `jge` to the failure
// arm.
//
// `tag` makes the three labels unique per call site. kcc has no fresh() counter --
// the existing loops write their labels literally -- so the driver passes the
// statement ordinal. Two prints of the same array would otherwise Mark the same label
// twice, and natFinish refuses a duplicate label rather than silently emitting two
// fixups to the same slot.
// natArrayIndex lowers `a[i]`, and is the byte-for-byte counterpart of
// Builder.emitArrayIndex (program.go:6287-6335).
//
// The $fail arm used to be an Int3 TRAP. The 150A note recorded that as
// temporary ("the native target has no stderr runtime diagnostic yet -- 150B
// wires the message"), and Phase D5 is that wiring: the reporter now exists on
// BOTH engines (152-B0 for the Go backend, this for kcc), so the trap is replaced
// by the real Phase-100 diagnostic -- the same "array index out of range" kind,
// the same file:line, on stderr, ending in exit(1).
//
// LABEL NAMING IS LOAD-BEARING. The oracle allocates badLbl then doneLbl via
// b.fresh, so the names are "idxbad$3" and "idxok$4" -- counters, not literals.
// A previous version here derived them from the `tag` argument instead, which
// produced the same SHAPE but different names, and a rel32 encodes only a
// displacement: the bytes could have matched while the naming discipline was
// wrong, which is precisely what Step 3's label layer was added to catch. So the
// two names come from natFresh in the oracle's order and nothing is hand-written.
//
// `roffsKind` is the rodata OFFSET of the reporter's "kind" argument, and
// `srcOff`/`srcLen` are the interned source basename's offset and length.
// `line` is the diagnostic's line.
// natArrayIndex lowers the bounds check and the element load for `a[i]`.
//
// The INDEX EXPRESSION IS NOT EVALUATED HERE. The caller evaluates it into RAX
// and moves it to RCX first, which is the ORACLE's order
// (pkg/native/program.go:6320-6324):
//
//	emitExpr(x.Index, depth+1)   // the index, as an expression
//	MovRegReg(RCX, RAX)
//	LoadStack(RBX, off)           // the array's base
//	LoadStack(RAX, off + 8)       // the array's length
//	... the bounds check ...
//	LoadScaled64(RAX, RBX, RCX, 8, 0)
//
// This function used to take the index LITERAL and materialise it straight
// into RCX, which is why an index that was not a literal was refused. That was
// a literal-only special case, and it was the whole of the limitation: the
// oracle has never required a literal index, and a literal-only index is
// exactly what makes ordinary array iteration impossible.
//
// `roffsKind`, `srcOff` and `srcLen` are the runtime-error REPORTER's context:
// the rodata offset of the reporter's "kind" argument, and the source
// basename's offset and length. They reach this function through the shared
// expression walker's context, which is why an index can be lowered inside ANY
// integer expression and not only directly under a `print`.
//
// `line` is the index expression's own line, so the diagnostic points at the
// index and not at the statement that contains it.
func natArrayIndex(s, off, roffsKind, srcOff, srcLen, line) {
    let fa = natFresh(s, "idxbad")
    s = fa[0]
    let badLbl = fa[1]
    let fb = natFresh(s, "idxok")
    s = fb[0]
    let doneLbl = fb[1]
    s = natLoadStack(s, natRegRBX(), off)
    s = natLoadStack(s, natRegRAX(), off + 8)
    // Bounds: 0 <= i < len, else the Phase-100 runtime error. Both arms jump to
    // the same block, which never returns (it ends in exit(1)).
    s = natTestRegReg(s, natRegRCX(), natRegRCX())
    s = natJns(s, badLbl + "$neg")
    s = natJmp(s, badLbl + "$fail")
    s = natMark(s, badLbl + "$neg")
    s = natCmpRegReg(s, natRegRCX(), natRegRAX())
    s = natJge(s, badLbl + "$fail")
    s = natLoadScaled64(s, natRegRAX(), natRegRBX(), natRegRCX(), 8, 0)
    s = natJmp(s, doneLbl)
    s = natMark(s, badLbl + "$fail")
    // Arguments: kind (ptr,len), file (ptr,len), line -- the native user-call
    // convention, units 0-4 of argRegs.
    s = natRodataRefOff(s, natRegRDI(), roffsKind)
    // Phase D8: this was the literal 25, while "array index out of range" is
    // 24 characters -- the reporter was told the string was one byte longer
    // than it is. The oracle derives it with len("array index out of range")
    // (program.go:6324); the same derivation is used here, written from the
    // LITERAL rather than from the interned offset because the interning list
    // is only an offset table and carries no lengths. Using len() on the
    // literal means a future edit to the message can no longer desynchronise
    // the immediate from the text, which is the defect this line WAS.
    s = natMovRegImm32(s, natRegRSI(), len("array index out of range"))
    s = natRodataRefOff(s, natRegRDX(), srcOff)
    s = natMovRegImm32(s, natRegRCX(), srcLen)
    s = natMovRegImm32(s, natRegR8(), line)
    s = natCall32(s)
    let cr = natRel32(s, "karkain_runtime_error")
    s = cr[0]
    // The reporter ends in exit(1) and does not return, but the emitter does
    // not assume that: mark the join so the success path can never fall into
    // the diagnostic block. (Its absence was a real regression in the oracle --
    // every array-using PE golden then ran the diagnostic on a VALID index.)
    s = natMark(s, doneLbl)
    return s
}

// natEmitStrIndex lowers `s[i]` -- a STRING's byte at index i -- to a VIEW:
// (s.ptr + i, 1), the same shape natEmitStrSlice produces for s[i:i+1] and for
// the same reason. A Karkain string is immutable on this path (no byte-store
// exists), so a view is observationally identical to a copy, and it costs no
// arena, no allocation and no copy -- "repeated indexing without allocating
// memory" is therefore free, not just possible.
//
// The BOUNDS check is the array path's, instruction for instruction, with the
// ONE difference the C backend defines: the kind argument is "string index out
// of range" (codegen.go's TYPE_STRING arm of karkain_checked_get), not the
// array's. An out-of-range byte index is the same Phase-100 diagnostic --
// stderr, exit(1) -- because a silent wrong byte is the worst outcome for a
// read that feeds every consumer.
//
// The INDEX EXPRESSION is evaluated into RAX at depth+1, in the ARRAY path's
// order (index first, then the load of base and length into RBX/RAX): the
// walker may read a local, and the base and the length must survive it.
//
// `rctx[3]` is the rodata offset of the "string index out of range" kind string,
// `rctx[1]`/`rctx[2]` the source basename's offset and length. `line` is the
// index expression's own line, so the diagnostic points at the index.
func natEmitStrIndex(s, expr, plan, fns, binTemp, extrasBase, frame, rctx, line) {
    let ord = natNativeSlotIndex(plan, identName(indexLeft(expr)))
    let off = natNativeSlotOff(plan, ord)
    s = natEmitIntExpr(s, indexExpr(expr), plan, fns, binTemp, extrasBase, frame, 1, rctx)
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    let fa = natFresh(s, "idxbad")
    s = fa[0]
    let badLbl = fa[1]
    let fb = natFresh(s, "stridxok")
    s = fb[0]
    let doneLbl = fb[1]
    s = natLoadStack(s, natRegRBX(), off)
    s = natLoadStack(s, natRegRAX(), off + 8)
    s = natTestRegReg(s, natRegRCX(), natRegRCX())
    s = natJns(s, badLbl + "$neg")
    s = natJmp(s, badLbl + "$fail")
    s = natMark(s, badLbl + "$neg")
    s = natCmpRegReg(s, natRegRCX(), natRegRAX())
    s = natJge(s, badLbl + "$fail")
    s = natAddRegReg(s, natRegRBX(), natRegRCX())
    s = natMovRegReg(s, natRegRDI(), natRegRBX())
    s = natMovRegImm32(s, natRegRSI(), 1)
    s = natJmp(s, doneLbl)
    s = natMark(s, badLbl + "$fail")
    s = natRodataRefOff(s, natRegRDI(), rctx[3])
    // The LENGTH OF THE LITERAL, not a count of characters typed: the Phase D8
    // lesson is that the immediate must be derived or the diagnostic reads past
    // the string.
    s = natMovRegImm32(s, natRegRSI(), len("string index out of range"))
    s = natRodataRefOff(s, natRegRDX(), rctx[1])
    s = natMovRegImm32(s, natRegRCX(), rctx[2])
    s = natMovRegImm32(s, natRegR8(), line)
    s = natCall32(s)
    let cr = natRel32(s, "karkain_runtime_error")
    s = cr[0]
    s = natMark(s, doneLbl)
    return s
}

// natTrimGotoWs emits the four-way whitespace test and jumps to `advLbl` when
// the byte in `ch` is one of the FOUR ASCII whitespace bytes the Karkain
// standard library removes (space 0x20, tab 0x09, LF 0x0a, CR 0x0d -- the
// stdlib's own str_trim_left/right and the C backend's karkain_trim agree,
// SPEC strings: case conversion is ASCII-only and trim is byte-wise). Any
// other byte, including every byte >= 0x7f, falls through.
func natTrimGotoWs(s, ch, advLbl) {
    s = natCmpRegImm32(s, ch, 32)
    s = natJz(s, advLbl)
    s = natCmpRegImm32(s, ch, 9)
    s = natJz(s, advLbl)
    s = natCmpRegImm32(s, ch, 10)
    s = natJz(s, advLbl)
    s = natCmpRegImm32(s, ch, 13)
    return natJz(s, advLbl)
}

// natEmitTrim lowers the std.string builtin `trim` (the builtin that
// `str_trim` delegates to) to a NON-ALLOCATING VIEW: (ptr + start,
// trimmed_len) of the source bytes. Nothing is copied, nothing is
// allocated, the source string is not modified, and the view's lifetime is
// the source's lifetime -- every string on this path is rodata- or
// arena-backed, and both live for the process.
//
// THE VERIFIED CONTRACT (the actual declarations/implementation in this
// repo, not an assumption):
//   - stdlib/string/string.kark: `str_trim` delegates to the builtin
//     `trim(s)`; `str_trim_left`/`str_trim_right` pin the same four bytes
//     (space/tab/LF/CR) as the whitespace set.
//   - the C backend (pkg/codegen/codegen.go, karkain_trim): strips exactly
//     those four bytes from both ends; everything else, internal whitespace
//     included, is preserved; all-whitespace input yields ""; an all- or
//     zero-length view is returned in place.
//   - the Go resolver treats `trim` as a known builtin (pkg/sema/resolve.go
//     and the checker tables list it with arity 1).
//   - non-ASCII bytes (>= 0x80) are NOT whitespace; they are preserved.
//
// Empty input yields a zero-length view; an all-whitespace input yields a
// zero-length view whose pointer is one-past-the-last byte, which is never
// dereferenced because the length is zero. Repeated trim calls are safe:
// every level is another view of the same storage.
//
// The result is the SAME (ptr, len) pair when nothing is trimmed -- this is
// not a copy of a trimmed string, it IS the source string re-armed.
//
// Registers: RBX = base, R11 = original length, RCX = scan index, RAX =
// trailing index, R10 = scratch byte. R12-R15 (the NAT-REG allocated-int
// registers) and RDI/RSI (the string-pair result) are not held across the
// scan.
func natEmitTrim(s, arg, stmts, plan, roffs, tbl, ictx) {
    // The argument lowers to the ordinary string value pair (RDI=ptr, RSI=len).
    s = natEmitStrValue(s, arg, stmts, plan, roffs, tbl, ictx)
    s = natMovRegReg(s, natRegRBX(), natRegRDI())
    s = natMovRegReg(s, natRegR11(), natRegRSI())
    // --- leading scan: RCX = index of the first non-ws byte (== len if all ws)
    s = natXorRegReg(s, natRegRCX())
    let fp = natFresh(s, "trimlead")
    s = fp[0]
    let leadLbl = fp[1]
    let fd = natFresh(s, "trimlend")
    s = fd[0]
    let leadDone = fd[1]
    let lwa = natFresh(s, "trimlws")
    s = lwa[0]
    let leadWs = lwa[1]
    s = natMark(s, leadLbl)
    s = natCmpRegReg(s, natRegRCX(), natRegR11())
    s = natJge(s, leadDone)
    s = natLoadScaled8(s, natRegR10(), natRegRBX(), natRegRCX(), 1, 0)
    s = natTrimGotoWs(s, natRegR10(), leadWs)
    s = natJmp(s, leadDone)
    s = natMark(s, leadWs)
    s = natIncReg(s, natRegRCX())
    s = natJmp(s, leadLbl)
    s = natMark(s, leadDone)
    // --- trailing scan: RAX = index of the last non-ws byte (before RCX if none)
    s = natMovRegReg(s, natRegRAX(), natRegR11())
    s = natDecReg(s, natRegRAX())
    let tr = natFresh(s, "trimtail")
    s = tr[0]
    let tailLbl = tr[1]
    let td = natFresh(s, "trimtend")
    s = td[0]
    let tailDone = td[1]
    let twa = natFresh(s, "trimtws")
    s = twa[0]
    let tailWs = twa[1]
    s = natMark(s, tailLbl)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    s = natJl(s, tailDone)
    s = natLoadScaled8(s, natRegR10(), natRegRBX(), natRegRAX(), 1, 0)
    s = natTrimGotoWs(s, natRegR10(), tailWs)
    s = natJmp(s, tailDone)
    s = natMark(s, tailWs)
    s = natDecReg(s, natRegRAX())
    s = natJmp(s, tailLbl)
    s = natMark(s, tailDone)
    // --- view: (RBX + RCX, RAX - RCX + 1), or a zero-length view
    s = natMovRegReg(s, natRegRDI(), natRegRBX())
    s = natAddRegReg(s, natRegRDI(), natRegRCX())
    let az = natFresh(s, "trimempty")
    s = az[0]
    let emptyLbl = az[1]
    let fin = natFresh(s, "trimdone")
    s = fin[0]
    let doneLbl = fin[1]
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    s = natJl(s, emptyLbl)
    s = natMovRegReg(s, natRegRSI(), natRegRAX())
    s = natSubRegReg(s, natRegRSI(), natRegRCX())
    s = natIncReg(s, natRegRSI())
    s = natJmp(s, doneLbl)
    s = natMark(s, emptyLbl)
    s = natXorRegReg(s, natRegRSI())
    s = natMark(s, doneLbl)
    return s
}

// natNativeScanElems validates an array literal's elements and returns "" or a
// refusal. Only int literals are supported; anything else names the offending INDEX,
// which is the oracle's own discipline -- its diagnostic says "array element 2 must
// be int" rather than failing later inside the int path with a message about
// expression shape.
func natNativeScanElems(elems, line) {
    let i = 0
    while (i < len(elems)) {
        if (nodeType(elems[i]) != NODE_INT_LIT()) {
            return natNativeRefuse("array element " + str(i) +
                " is not an integer literal", line)
        }
        i = i + 1
    }
    return ""
}

// natNativeScanLen validates a `len(x)` call and returns "" or a refusal.
//
// Only `len` of an ARRAY LOCAL is supported, and every other shape is named rather
// than coerced: len of a scalar, len of an undeclared name, len of an expression, and
// any other builtin call all get their own message.
func natNativeScanLen(call, plan, line, fns) {
    if (callFunc(call) != "len") {
        return natNativeRefuse("call to `" + callFunc(call) + "` is not lowered by the " +
            "native driver", line)
    }
    let args = callArgs(call)
    if (len(args) != 1) {
        return natNativeRefuse("len() takes exactly 1 argument, got " + str(len(args)), line)
    }
    if (nodeType(args[0]) == NODE_CALL() && callFunc(args[0]) == "trim") {
        // NAT-STRTRIM: `len(trim(s))` -- the trimmed length IS the second unit of
        // the view pair. The trim call is validated by its own scanner; the
        // emission lowers it inline, so this position carries the string context
        // directly (print and return values).
        return natNativeScanTrim(args[0], plan, line, fns)
    }
    if (nodeType(args[0]) != NODE_IDENT()) {
        return natNativeRefuse("len() requires an array or string variable, not an " +
            "expression", line)
    }
    let ord = natNativeSlotIndex(plan, identName(args[0]))
    if (ord < 0) {
        return natNativeRefuse("len() of undeclared local `" + identName(args[0]) + "`", line)
    }
    let k = natNativeSlotKind(plan, ord)
    // A STRING is accepted for free, and deliberately so: a string's two frame units
    // are (ptr, len), so its length is at exactly the offset an array's COUNT is, and
    // the same single load returns both. Refusing it would have been an arbitrary
    // restriction rather than a real boundary.
    if (k != natKindArray() && k != natKindString()) {
        return natNativeRefuse("len() requires an array or string, but `" +
            identName(args[0]) + "` is not one (its kind is " + natKindName(k) + ")",
            line)
    }
    return ""
}

// natArrayLen loads an array's element count into RAX.
//
// The oracle's array branch of `emitLen` is exactly one instruction
// (`e.LoadStack(RAX, off+8)`) because the count is the array header's second unit. The
// map branch needs an extra indirection -- a map's address lives in its slot -- but
// maps are not lowered by this driver yet, so that difference is not reachable here.
//
// The count offset is written literally as off+8 and NOT derived from
// `natLocalOff(ord, natKindArray())`: an array's element AREA starts at off+16 while
// its count is at off+8, so deriving the count from the slot formula would be wrong.
func natArrayLen(s, off) {
    return natLoadStack(s, natRegRAX(), off + 8)
}

// natCallPrintInt and natCallPrintStr are the two print call sites, and the
// `sub rsp, 8` in each is Win64 ABI rather than padding -- but ONLY on Windows.
//
// The alignment argument, which was previously stated for all three targets and
// was wrong for two of them:
//
//   - Windows: `_start` runs `and rsp, -16`, so main is entered with
//     rsp % 16 == 0; the frame (608, a multiple of 16) leaves it 0, and a
//     `call` requires rsp % 16 == 0 immediately before it. The 8 bytes are
//     REQUIRED.
//   - Linux and macOS: `_start` does NOT align. rsp % 16 is 0 at entry, the
//     `call` into main leaves main at 8, and the frame keeps it at 8 (608 %
//     16 == 0). A `call` from main then leaves its callee at 0, which is what
//     the ABI wants. The extra `sub rsp, 8` therefore made the callee
//     MISaligned. It went unnoticed because print_int uses no aligned SSE
//     spills -- so the bytes were wrong and the program still ran.
//
// The oracle settles it: AndRspNeg16 appears ONLY inside the Windows branch of
// the entry (pkg/native/program.go:1594-1600), and its Linux/macOS print call
// sites carry no compensating sub. Matching the oracle means doing the same.
//
// They are functions rather than inline sequences because there are several
// print shapes (int literal, string literal, element, len, local) and a copy
// per shape is a place for the alignment to be dropped from one and kept in
// another.
func natCallPrintInt(s) {
    if (natStTargetOS(s) == natOSWindows()) {
        s = natSubRegImm32(s, natRegRSP(), 8)
    }
    s = natCall32(s)
    let r = natRel32(s, "print_int")
    s = r[0]
    if (natStTargetOS(s) == natOSWindows()) {
        s = natAddRegImm32(s, natRegRSP(), 8)
    }
    return s
}

func natCallPrintStr(s) {
    if (natStTargetOS(s) == natOSWindows()) {
        s = natSubRegImm32(s, natRegRSP(), 8)
    }
    s = natCall32(s)
    let r = natRel32(s, "print_str")
    s = r[0]
    if (natStTargetOS(s) == natOSWindows()) {
        s = natAddRegImm32(s, natRegRSP(), 8)
    }
    return s
}

// natPrintStrBody emits the `print_str` helper: write the caller's string bytes,
// then a newline.
//
// It is the byte-for-byte counterpart of the oracle's print_str, which is seven
// instructions because a string needs no formatting at all:
//
//	Mark("print_str"); MovRegReg(RDX, RSI); MovRegReg(RSI, RDI);
//	MovRegImm32(RDI, 1); emitWrite(); printNewline(); Ret()
//
// The three register moves are the (RDI=ptr, RSI=len) string convention being
// reshuffled into (RDI=fd, RSI=ptr, RDX=len), which is what natPayloadWrite -- and the
// oracle's emitWrite -- consume. The newline is the same contract print_int
// terminates with, so `"42\n"` and `"hi\n"` are both right; the C-backend goldens pin
// exactly that, and a missing terminator is a real defect rather than a style choice.
//
// It takes the newline's rodata OFFSET rather than interning it itself, because the
// driver owns the rodata list and a helper that interned independently would put the
// newline somewhere the linker never resolves.
func natPrintStrBody(s, winWrite, offNewline) {
    s = natMark(s, "print_str")
    s = natMovRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegReg(s, natRegRSI(), natRegRDI())
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natPayloadWrite(s, winWrite)
    s = natPrintNewlineOff(s, winWrite, offNewline)
    return natRet(s)
}

// natNativeRodataList builds the rodata input list: print_int's two strings followed
// by the program's own literals, in source order.
//
// It is built with an explicit append loop rather than an array-join operator on
// purpose. The obvious `["-", "\n"] ++ lits` does not exist -- Karkain has no `++` --
// and the first draft of this slice used it, which compiled into an image that printed
// a run of NUL bytes: the literal offsets it recorded were computed against a list that
// was not the list the linker interned.
//
// The ORDER is load-bearing in the same way. natRodataSection returns one offset per
// INPUT entry, with a repeated literal resolving to the slot it was first interned
// into, so the k-th literal in the program is always input entry 2+k.
// natNativeUsesRuntimeError reports whether the program contains an operation
// that can raise a Phase-100 diagnostic -- currently ONLY an array index, the
// single call site the reporter is wired for in Phase D5.
//
// WHY IT LOOKS INSIDE A STATEMENT rather than at its node type: an earlier
// version compared only `nodeType(n) == NODE_INDEX()`, which never fires for the
// shape the gate exists to catch. `print(a[1])` is a NODE_PRINT whose ARGUMENT
// is the index, so the predicate returned 0, the reporter was never emitted, and
// the lowering still recorded a reference to `karkain_runtime_error` -- an
// undefined label, which natFinish reports as a refusal. From the outside that
// looked like the port had no effect at all, and it is exactly the failure the
// evidence-discipline rule exists to prevent: a check that can pass without
// checking anything.
//
// A gate that is a PREDICATE rather than a hardcoded 1 is also what keeps a
// program that cannot fault from carrying ~615 bytes of reporter it never calls.
// Those bytes are not free: the reporter's rodata strings sit in the section and
// move every address after them.
// natNativeUsesRuntimeError reports whether the program needs the Phase-100
// runtime-error REPORTER.
//
// NAT-IDX: this predicate must see an array index wherever it can occur, and
// that is now EVERYWHERE an integer expression can occur -- inside a loop
// body, inside a branch, or nested inside another expression.
//
// The previous version looked only at a `print`'s argument and a `return`'s
// value, at the TOP level of the function. That was correct while the driver
// lowered an index only in those two positions, and it would have been WRONG
// the moment an index could appear anywhere else: the reporter would not be
// emitted, and the index's diagnostic would reference rodata that does not
// exist.
//
// The reporter's absence is not a crash and not a wrong answer -- the bounds
// check still jumps to its failure block -- but that block CALLS the reporter,
// so a missing reporter is a call into a label that was never emitted. This is
// the "the gate and the lowering cannot disagree" rule the original comment
// stated, applied to the shapes that now exist.
func natNativeUsesRuntimeError(stmts) {
    let i = 0
    while (i < len(stmts)) {
        if (natStmtHasIndex(stmts[i]) == 1) { return 1 }
        i = i + 1
    }
    return 0
}

// natStmtHasIndex reports whether a statement CONTAINS an array index.
//
// It inspects every position the driver can lower an index in, and it RECURSES
// into nested bodies: a branch inside a loop, a loop inside a branch, and a
// loop inside a loop all carry their statements' indexes.
func natStmtHasIndex(n) {
    let k = nodeType(n)
    if (k == NODE_INDEX()) { return 1 }
    if (k == NODE_PRINT()) { return natExprHasIndex(printVal(n)) }
    if (k == NODE_RETURN()) { return natExprHasIndex(retVal(n)) }
    if (natNativeIsDecl(n)) { return natExprHasIndex(natNativeDeclValue(n)) }
    if (k == NODE_EXPR_STMT()) { return natExprHasIndex(exprStmtExpr(n)) }
    if (k == NODE_IF()) {
        // The CONDITION carries indexes too, and it is the position that is
        // easiest to forget: an `if a[0] < a[1] { ... }` has its indexes in the
        // condition, not in the branch body.
        //
        // Missing one is not a crash and not a wrong answer -- the bounds
        // check still jumps to its failure block -- but that block CALLS the
        // reporter, so a missing reporter is a call into a label that was
        // never emitted. That is what the linker-time crash was.
        if (natExprHasIndex(ifCond(n)) == 1) { return 1 }
        if (natStmtHasIndexIn(ifCons(n)) == 1) { return 1 }
        return natStmtHasIndexIn(ifAlt(n))
    }
    if (k == NODE_WHILE()) {
        if (natExprHasIndex(whileCond(n)) == 1) { return 1 }
        return natStmtHasIndexIn(whileBody(n))
    }
    if (k == NODE_FOR()) {
        if (natExprHasIndex(forCond(n)) == 1) { return 1 }
        if (len(forInit(n)) > 0 && natExprHasIndex(forInit(n)) == 1) { return 1 }
        if (len(forPost(n)) > 0 && natExprHasIndex(forPost(n)) == 1) { return 1 }
        return natStmtHasIndexIn(forBody(n))
    }
    return 0
}

// natStmtHasIndexIn is the statement-list form of natStmtHasIndex.
func natStmtHasIndexIn(stmts) {
    let i = 0
    while (i < len(stmts)) {
        if (natStmtHasIndex(stmts[i]) == 1) { return 1 }
        i = i + 1
    }
    return 0
}

// natExprHasIndex looks through an expression for an index node.
//
// It is a full walk rather than a one-level test, because an index can now be
// nested inside an arithmetic expression (`a[i] + 1`), inside a comparison
// (`a[i] == 3`), or inside a call's arguments (`f(a[i])`).
//
// It is a named function rather than an inline test because the SAME question
// is asked in several places, and one copy that is later extended without the
// other is how the two drift apart.
func natExprHasIndex(e) {
    let t = nodeType(e)
    if (t == NODE_INDEX()) { return 1 }
    if (t == NODE_BINARY()) {
        if (natExprHasIndex(binaryLeft(e)) == 1) { return 1 }
        return natExprHasIndex(binaryRight(e))
    }
    if (t == NODE_UNARY()) { return natExprHasIndex(unaryOperand(e)) }
    if (t == NODE_CALL()) {
        let i = 0
        while (i < len(callArgs(e))) {
            if (natExprHasIndex(callArgs(e)[i]) == 1) { return 1 }
            i = i + 1
        }
        return 0
    }
    if (t == NODE_INDEX()) { return 1 }
    return 0
}

// natExprHasStrIndex / natStmtHasStrIndex / natStmtHasStrIndexIn are the
// STRING-index counterparts of the walker above: they report a NODE_INDEX
// whose BASE IS A STRING, which is the only case the "string index out of
// range" kind string exists for.
//
// They need the plan, because which base is a string is a plan question, not
// a node-type question. The walk mirrors natStmtHasIndex position by position
// (conditions, inits, posts, branch bodies, loop bodies) so the interner
// cannot miss a site the emitter can reach.
func natExprHasStrIndex(e, plan) {
    let t = nodeType(e)
    if (t == NODE_INDEX()) {
        if (natNativeStrIndexSlot(plan, e) >= 0) { return 1 }
        return natExprHasStrIndex(indexExpr(e), plan)
    }
    if (t == NODE_BINARY()) {
        if (natExprHasStrIndex(binaryLeft(e), plan) == 1) { return 1 }
        return natExprHasStrIndex(binaryRight(e), plan)
    }
    if (t == NODE_UNARY()) { return natExprHasStrIndex(unaryOperand(e), plan) }
    if (t == NODE_CALL()) {
        let i = 0
        while (i < len(callArgs(e))) {
            if (natExprHasStrIndex(callArgs(e)[i], plan) == 1) { return 1 }
            i = i + 1
        }
        return 0
    }
    return 0
}

func natStmtHasStrIndex(n, plan) {
    let k = nodeType(n)
    if (k == NODE_PRINT()) { return natExprHasStrIndex(printVal(n), plan) }
    if (k == NODE_RETURN()) { return natExprHasStrIndex(retVal(n), plan) }
    if (natNativeIsDecl(n)) { return natExprHasStrIndex(natNativeDeclValue(n), plan) }
    if (k == NODE_EXPR_STMT()) { return natExprHasStrIndex(exprStmtExpr(n), plan) }
    if (k == NODE_IF()) {
        if (natExprHasStrIndex(ifCond(n), plan) == 1) { return 1 }
        if (natStmtHasStrIndexIn(ifCons(n), plan) == 1) { return 1 }
        return natStmtHasStrIndexIn(ifAlt(n), plan)
    }
    if (k == NODE_WHILE()) {
        if (natExprHasStrIndex(whileCond(n), plan) == 1) { return 1 }
        return natStmtHasStrIndexIn(whileBody(n), plan)
    }
    if (k == NODE_FOR()) {
        if (natExprHasStrIndex(forCond(n), plan) == 1) { return 1 }
        if (len(forInit(n)) > 0 && natExprHasStrIndex(forInit(n), plan) == 1) { return 1 }
        if (len(forPost(n)) > 0 && natExprHasStrIndex(forPost(n), plan) == 1) { return 1 }
        return natStmtHasStrIndexIn(forBody(n), plan)
    }
    return 0
}

func natStmtHasStrIndexIn(stmts, plan) {
    let i = 0
    while (i < len(stmts)) {
        if (natStmtHasStrIndex(stmts[i], plan) == 1) { return 1 }
        i = i + 1
    }
    return 0
}

// natNativeUsesStringIndex reports whether the program contains a string byte
// index anywhere. The gate mirrors usesRtErr's discipline -- EVERY function,
// not main's body alone -- because the caller needs the string interned even
// when the site lives in a callee. A callee that cannot be lowered is scanned
// anyway (the same conservative over-intern as usesRtErr), which can only cost
// a few bytes of rodata, never a crash.
func natNativeUsesStringIndex(stmts, plan) {
    let i = 0
    while (i < len(stmts)) {
        if (natStmtHasStrIndex(stmts[i], plan) == 1) { return 1 }
        i = i + 1
    }
    return 0
}

func natNativeRodataList(stmts) {
    let lits = natNativeStrLiterals(stmts)
    let strs = ["-", "\n"]
    let i = 0
    while (i < len(lits)) {
        strs = appendArray(strs, lits[i])
        i = i + 1
    }
    return strs
}

// natNativeStrLiterals collects every string literal the program binds, in source
// order, WITHOUT de-duplicating.
//
// De-duplication is deliberately NOT done here: natRodataSection performs the
// first-use interning, and natRodataLookup scans this list for the FIRST occurrence,
// so a repeated literal naturally resolves to the slot it was first interned into. If
// this list de-duplicated too, the two would still agree -- but keeping one function
// responsible for interning is what stops them disagreeing.
// natNativeStrLiterals collects every string literal the program puts into an image,
// in the order the driver will RECORD a reference to it.
//
// It walks statements once and takes literals from BOTH places that can produce one: a
// `let` initialiser and a `print` argument. Collecting only from `let` was a real bug --
// `print("hi")` with no binding recorded a reference to an offset that had never been
// interned, and kcc died with "array index out of range" inside the lowering.
//
// The ORDER must match natNativeLower's walk exactly, because the lowering advances a
// single sidx through this list as it emits. Both iterate the same statements in the
// same order and handle the decl before the print within each statement, so the two
// walks agree by construction rather than by convention.
func natNativeStrLiterals(stmts) {
    let out = []
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        if (natNativeIsDecl(n)) {
            out = natNativeStrLitAppend(out, natNativeDeclValue(n))
        }
if (nodeType(n) == NODE_PRINT()) {
  out = natNativeStrLitAppend(out, printVal(n))
  }
  // 9h-2a: statement-level assignment. Without this arm `s.label = "changed"` records no
  // roffs entry, so natNativeLowerAssign reads `roffs[sidx]` past the end -- the same
  // collector/emitter desynchronisation 9h-1 fixed for record literals.
  if (nodeType(n) == NODE_EXPR_STMT()) {
  let ae = exprStmtExpr(n)
  if (natNativeIsAssignExpr(ae)) {
  out = natNativeStrLitAppend(out, binaryRight(ae))
  }
  }
  if (nodeType(n) == NODE_RETURN()) {
  // A literal RETURNED from a callee is produced by the return arm too, and
  // it was missing here: `func hi() string { return "x" }` collected nothing,
  // `natRodataOffsetFor` returned 0, and the image printed from image
  // offset 0 (the DOS header). The return lowering and this collector must
  // agree by construction.
  out = natNativeStrLitAppend(out, retVal(n))
  }
  // Recurse into the bodies the driver lowers. `let s = "x"` inside a branch
  // was never collected before, so its reference silently resolved to offset 0.
  // Value lookup makes the walk order irrelevant.
  if (nodeType(n) == NODE_IF()) {
      // NAT-STREQ: the CONDITION descends too. A condition literal -- the "a"
      // in `if ("a" == b)` -- is staged by the equality emit through
      // natEmitStrValue exactly like a print literal, so the collector must
      // intern it or the lookup would resolve to offset 0 (print_int's own
      // "-"). natNativeStrLitAppend already descends through the comparison
      // operators, so the whole condition can be appended.
      out = natNativeStrLitAppend(out, ifCond(n))
      out = natNativeStrLitConcat(out, natNativeStrLiterals(ifCons(n)))
      out = natNativeStrLitConcat(out, natNativeStrLiterals(ifAlt(n)))
  }
  if (nodeType(n) == NODE_WHILE()) {
      out = natNativeStrLitAppend(out, whileCond(n))
      out = natNativeStrLitConcat(out, natNativeStrLiterals(whileBody(n)))
  }
  if (nodeType(n) == NODE_FOR()) {
      if (len(forInit(n)) > 0 && natNativeIsDecl(forInit(n))) {
          out = natNativeStrLitAppend(out, natNativeDeclValue(forInit(n)))
      }
      out = natNativeStrLitAppend(out, forCond(n))
      out = natNativeStrLitConcat(out, natNativeStrLiterals(forBody(n)))
  }
  if (nodeType(n) == NODE_FOR_IN()) {
      out = natNativeStrLitConcat(out, natNativeStrLiterals(forInBody(n)))
  }
        i = i + 1
    }
    return out
}

// natNativeStrLitConcat appends every literal of list b onto out (value lookup
// makes order irrelevant; this only preserves determinism).
func natNativeStrLitConcat(a, b) {
    let i = 0
    while (i < len(b)) {
        a = appendArray(a, b[i])
        i = i + 1
    }
    return a
}

// natNativeStrLitAppend appends every string literal reachable from ONE expression,
// descending through `+`.
//
// THE DESCENT IS THE STEP 9g FIX, and it is a defect fix rather than a refinement.
// The previous collector only took a literal when the WHOLE value was a string
// literal, so `print("ab" + "cd")` collected NOTHING. Two failures followed that looked
// like one unrelated linker bug:
//
//   * natNativeUsesString returned false, so print_str was never emitted, while the
//     concat arm still CALLED it. natFinish therefore returned the STRING
//     "undefined label 'print_str'", which natNativeProgram passed to natPELink as if it
//     were code. The image was nonsense and the first hpatches store ran off the end of
//     it -- a panic in natPEStore64 with nothing to do with patch coordinates.
//   * the literals were never interned, so their rodata offsets would have resolved to
//     offset 0 (print_int's own "-") even once the helper was emitted.
//
// The arena-sizing path already descended into `+`, so the two collectors DISAGREED:
// one sized an arena from literals the other could not see. They are now ONE function
// with one rule, so they cannot disagree again.
func natNativeStrLitAppend(out, e) {
    if (nodeType(e) == NODE_STRING_LIT()) {
        return appendArray(out, stringLitVal(e))
    }
    if (nodeType(e) == NODE_SLICE()) {
        out = natNativeStrLitAppend(out, sliceLeft(e))
        out = natNativeStrLitAppend(out, sliceStart(e))
        return natNativeStrLitAppend(out, sliceEnd(e))
    }
if (nodeType(e) == NODE_BINARY()) {
  // NAT-STREQ: a COMPARISON descends too. A condition literal -- the "a" in
  // `if ("a" == s)` -- is staged by the equality emit exactly like a print
  // literal, so the collector must intern it or the lookup would resolve to
  // offset 0 (print_int's own "-"). The oracle stages equality operands
  // through emitStr (program.go:5014/5019), so its literal set includes
  // condition literals by construction.
  //
  // The descent is deliberately NOT restricted to == and !=: a literal under
  // a refused ordering comparison (<) is collected but never looked up,
  // which only grows the interned section by a few deterministic bytes, and
  // over-collection is the safe direction -- under-collection is the
  // offset-0 landmine this collector exists to close.
  if (binaryOp(e) == "+" || binaryOp(e) == "==" || binaryOp(e) == "!=" ||
      binaryOp(e) == "<" || binaryOp(e) == "<=" || binaryOp(e) == ">" ||
      binaryOp(e) == ">=") {
  out = natNativeStrLitAppend(out, binaryLeft(e))
  return natNativeStrLitAppend(out, binaryRight(e))
  }
  }
  // 9h-2a: a `rec.field = "literal"` statement consumes one roffs entry, consumed by
  // natNativeLowerAssign in exactly statement order. Without this arm the collector
  // would not intern the literal and `roffs` would come out one entry short -- the same
  // collector/emitter desynchronisation that 9h-1 fixed for record literals.
  if (natNativeIsAssignExpr(e)) {
  return natNativeStrLitAppend(out, binaryRight(e))
  }
  // Step 9h-1: descend a RECORD LITERAL's fields, in `structLitFields` order.
  //
  // This is a COLLECTOR/EMITTER ORDERING fix, not a refinement. natRecordStoreLiteral
  // consumes exactly one roffs entry per STRING field, walking `structLitFields` in order.
  // Before this arm the collector visited only `let` initialisers and `print` arguments,
  // so a literal inside a struct literal was never interned: roffs came out one entry
  // short and the store read `roffs[sidx]` past the end --
  // "array index out of range" in natRecordStoreLiteral on `string_between_ints`.
  //
  // The order MUST match the emitter exactly. `let s = S{...}` reaches here through
  // natNativeStrLitAppend(out, natNativeDeclValue(n)), so the fields are walked in the
  // same order natRecordStoreLiteral walks them. Desynchronising the two is the identical
  // defect 9g fixed when the concat descent was added: one more place where the accepted
  // and recorded shapes can drift apart.
  if (nodeType(e) == NODE_STRUCT_LIT()) {
  let sf = structLitFields(e)
  let j = 0
  while (j < len(sf)) {
  out = natNativeStrLitAppend(out, binaryRight(sf[j]))
  j = j + 1
  }
  return out
  }
  // Call ARGUMENTS, walked in source order. `print(greet("direct literal"))` has the
  // literal nested inside a call expression; the old collector never looked inside a
  // call, so the literal was never interned and its reference resolved to offset 0.
  if (nodeType(e) == NODE_CALL()) {
  let args = callArgs(e)
  let j = 0
  while (j < len(args)) {
  out = natNativeStrLitAppend(out, args[j])
  j = j + 1
  }
  return out
  }
  if (nodeType(e) == NODE_UNARY()) {
  return natNativeStrLitAppend(out, unaryOperand(e))
  }
  return out
  }

// natNativeUsesString reports whether the program can produce a string at all, which
// is what gates the print_str helper.
func natNativeUsesString(stmts) {
    return len(natNativeStrLiterals(stmts)) > 0
}

// natNativeScanValue validates one expression in a value position -- what `print` and
// `return` accept -- and returns "" or a refusal.
//
// One function for both, because a second copy is a second place for the accepted and
// the refused shapes to drift apart, and a driver that accepts `print(a[i])` but
// refuses `return a[i]` (or the reverse) is exactly the inconsistency a user cannot act
// on.
// ------------------------------------------------------------
// Step 9h-1 - record field reads
// ------------------------------------------------------------

// natRecordTypeOfLocal recovers a local's record type by re-walking the declarations for
// a STRUCT-LITERAL binding of that name. The plan triple carries the kind but not the
// type name, and adding a fourth plan element would change a structure every existing
// consumer indexes positionally, so the type is resolved here from the SAME AST the
// construction path used. Construction and read therefore cannot disagree.
func natRecordTypeOfLocal(stmts, name) {
  let i = 0
  while (i < len(stmts)) {
  let n = stmts[i]
  if (natNativeIsDecl(n)) {
  if (natNativeDeclName(n) == name) {
  let v = natNativeDeclValue(n)
  if (nodeType(v) == NODE_STRUCT_LIT()) { return structLitName(v) }
  return ""
  }
  }
  i = i + 1
  }
  return ""
}

// natRecordBase loads the record's field-area ADDRESS from its frame slot into `reg`.
// The base is ALWAYS reloaded from the frame rather than carried in a register across a
// field expression -- the rule natArrayValue already follows for an array element base.
func natRecordBase(s, stmts, plan, name, reg) {
  let ord = natNativeSlotIndex(plan, name)
  return natLoadStack(s, reg, natNativeSlotOff(plan, ord))
}

// natRecordFieldLoadInt loads an int/float field's single 8-byte unit into RAX.
//
// mem[base + off] is loaded with index = RCX = 0 and disp = off, which is the same
// addressing natRecordStoreLiteral writes with, so read and write cannot disagree.
func natRecordFieldLoadInt(s, stmts, plan, tbl, recName, fieldName) {
  let tname = natRecordTypeOfLocal(stmts, recName)
  let off = natStructFieldOff(tbl, tname, fieldName)
  s = natRecordBase(s, stmts, plan, recName, natRegRBX())
  s = natMovRegImm32(s, natRegRCX(), 0)
  return natLoadScaled64(s, natRegRAX(), natRegRBX(), natRegRCX(), 1, off)
}

// natRecordFieldLoadStr loads a string field's TWO units into (RDI, RSI), which is the
// established native string result convention.
func natRecordFieldLoadStr(s, stmts, plan, tbl, recName, fieldName) {
  let tname = natRecordTypeOfLocal(stmts, recName)
  let off = natStructFieldOff(tbl, tname, fieldName)
  s = natRecordBase(s, stmts, plan, recName, natRegRBX())
  s = natMovRegImm32(s, natRegRCX(), 0)
  s = natLoadScaled64(s, natRegRDI(), natRegRBX(), natRegRCX(), 1, off)
  s = natLoadScaled64(s, natRegRSI(), natRegRBX(), natRegRCX(), 1, off + 8)
  return s
}

// natNativeScanField validates `rec.field` against the record table.
//
// It resolves the base local, the record type, the field offset and the field kind, and
// accepts only an int or float field. A string field is NOT accepted here: a string
// reaches print through natEmitStrValue's own DotExpr arm, which is dispatched BEFORE
// this validator runs.
func natNativeScanField(expr, stmts, plan, line, tbl, allowStr) {
  if (nodeType(dotLeft(expr)) != NODE_IDENT()) {
  return natNativeRefuse("record field read is only lowered on a local record in " +
  "151A Step 9h-1", line)
  }
  let recName = identName(dotLeft(expr))
  if (natNativeSlotIndex(plan, recName) < 0) {
  return natNativeRefuse("undeclared local `" + recName + "` in a field read", line)
  }
    let tname = natRecordTypeOfLocal(stmts, recName)
  if (tname == "") {
  return natNativeRefuse("`" + recName + "` is not a record bound from a record " +
  "literal, so `" + memberField(expr) + "` cannot be resolved", line)
  }
  let fname = memberField(expr)
  if (natStructFieldOff(tbl, tname, fname) < 0) {
  return natNativeRefuse("record `" + tname + "` has no field `" + fname + "`", line)
  }
  let fk = natStructFieldKind(tbl, tname, fname)
  if (fk == natKindInt() || fk == natKindFloat()) { return "" }
  // Step 9h-1: a string field is accepted ONLY in direct print position.
  //
  // `allowStr` is 1 from exactly one call site -- the NODE_PRINT scan, whose lowering
  // already routes a NODE_DOT string to natEmitStrValue's DotExpr arm. It is 0 from
  // `return`, because a return value becomes the process exit status and must be an int,
  // and 0 for every other context. So this widens ONE context, not the expression surface.
  if (fk == natKindString() && allowStr == 1) { return "" }
  return natNativeRefuse("record field `" + fname + "` is a " + natKindName(fk) +
  "; only int and float field reads are lowered in 151A Step 9h-1", line)
}

// natNativeIsAssignExpr reports whether `e` is a BinaryExpr carrying the "=" operator.
func natNativeIsAssignExpr(e) {
  if (nodeType(e) != NODE_BINARY()) { return 0 }
  if (binaryOp(e) != "=") { return 0 }
  return 1
}

// natNativeScanAssign validates `rec.field = rhs` (9h-2a).
//
// The LHS must be a NODE_DOT on a record local whose field resolves through the SAME
// table natRecordFieldLoadInt uses -- no second field table exists or is created here.
// The RHS must be an integer local/literal or a string literal, matching the two
// representations natRecordStoreLiteral already writes (one unit; pointer + length).
//
// Integer ARITHMETIC on the RHS and assignment inside `if` are deliberately NOT
// accepted: neither capability exists in this driver, so accepting them would create
// exactly the accept-without-emit state that 9h-1 had to repair. Each is refused by
// name instead of silently mis-lowered.
func natNativeScanAssign(tbl, stmts, plan, line, lhs, rhs) {
  if (nodeType(lhs) != NODE_DOT()) {
    return natNativeRefuse("assignment target must be `record.field`; only a record " +
    "field is lowered in 151A Step 9h-2a", line)
  }
  if (nodeType(dotLeft(lhs)) != NODE_IDENT()) {
    return natNativeRefuse("assignment target `" + memberField(lhs) + "` must be a field " +
    "of a local record", line)
  }
  let recName = identName(dotLeft(lhs))
  if (natNativeSlotIndex(plan, recName) < 0) {
    return natNativeRefuse("undeclared local `" + recName + "` in a field assignment", line)
  }
  let tname = natRecordTypeOfLocal(stmts, recName)
  if (tname == "") {
    return natNativeRefuse("`" + recName + "` is not a record bound from a record " +
    "literal, so `" + memberField(lhs) + "` cannot be assigned", line)
  }
  let fname = memberField(lhs)
  if (natStructFieldOff(tbl, tname, fname) < 0) {
    return natNativeRefuse("record `" + tname + "` has no field `" + fname + "`", line)
  }
  let fk = natStructFieldKind(tbl, tname, fname)
  let rt = nodeType(rhs)
  if (fk == natKindInt() || fk == natKindFloat()) {
    if (rt == NODE_INT_LIT()) { return "" }
    if (rt == NODE_IDENT()) {
      let ord = natNativeSlotIndex(plan, identName(rhs))
      if (ord < 0) {
        return natNativeRefuse("undeclared local `" + identName(rhs) + "` in a field " +
        "assignment", line)
      }
      if (natNativeSlotKind(plan, ord) != natKindInt()) {
        return natNativeRefuse("cannot assign a " +
        natKindName(natNativeSlotKind(plan, ord)) + " to int field `" + fname + "`", line)
      }
      return ""
    }
    if (rt == NODE_BINARY()) {
      return natNativeRefuse("integer arithmetic on the right-hand side of a field " +
      "assignment is not lowered in 151A Step 9h-2a", line)
    }
    if (rt == NODE_DOT()) {
      return natNativeRefuse("a record field read on the right-hand side of a field " +
      "assignment is not lowered in 151A Step 9h-2a", line)
    }
    return natNativeRefuse("field `" + fname + "` is " + natKindName(fk) +
    "; only an integer local or literal is assigned in 151A Step 9h-2a", line)
  }
  if (fk == natKindString()) {
    if (rt == NODE_STRING_LIT()) { return "" }
    return natNativeRefuse("field `" + fname + "` is a string; only a string literal " +
    "is assigned in 151A Step 9h-2a", line)
  }
  return natNativeRefuse("field `" + fname + "` has kind " + natKindName(fk) +
  ", which is not assignable in 151A Step 9h-2a", line)
}

// natNativeLowerAssign emits `rec.field = rhs` (9h-2a).
//
// The base is reloaded from the record's frame slot and the field is stored through
// the SAME addressing natRecordStoreLiteral writes with -- natStoreBaseOff(base=RBX,
// disp=off) -- so a field read and a field write cannot disagree about where the
// field lives. A string writes BOTH units: the interned rodata pointer at `off` and the
// length at `off + 8`, which is what natRecordFieldLoadStr reads back.
//
// Returns [newState, newSidx]: a string assignment consumes one rodata entry, so the
// caller-owned cursor must travel back out, exactly as natRecordStoreLiteral does.
func natNativeLowerAssign(s, stmts, plan, tbl, roffs, sidx, lhs, rhs) {
  let recName = identName(dotLeft(lhs))
  let fname = memberField(lhs)
  let tname = natRecordTypeOfLocal(stmts, recName)
  let off = natStructFieldOff(tbl, tname, fname)
  let fk = natStructFieldKind(tbl, tname, fname)
  s = natRecordBase(s, stmts, plan, recName, natRegRBX())
  if (fk == natKindString()) {
    s = natRodataRefOff(s, natRegRAX(), natRodataOffsetFor(stringLitVal(rhs), stmts, roffs))
    s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off)
    s = natMovRegImm32(s, natRegRAX(), len(stringLitVal(rhs)))
    s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off + 8)
    return [s, sidx]
  }
  if (nodeType(rhs) == NODE_IDENT()) {
    let ord = natNativeSlotIndex(plan, identName(rhs))
    s = natLoadStack(s, natRegRAX(), natNativeSlotOff(plan, ord))
    s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off)
    return [s, sidx]
  }
  s = natMovRegImm64(s, natRegRAX(), int(intLitVal(rhs)))
  s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off)
  return [s, sidx]
}

func natNativeScanStrSlice(e, stmts, plan, line) {
    if (nodeType(sliceLeft(e)) == NODE_SLICE()) {
        return natNativeRefuse("chained string slicing is not lowered", line)
    }
    if (nodeType(sliceLeft(e)) == NODE_INDEX()) {
        return natNativeRefuse("string slicing of a string index is not lowered", line)
    }
    if (nodeType(sliceLeft(e)) == NODE_BINARY()) {
        return natNativeRefuse("string slicing of a concatenation is not lowered", line)
    if (sliceStart(e) == 0 || nodeType(sliceStart(e)) == 0) {
        return natNativeRefuse("open-ended string slicing (s[:b]) is not lowered yet", line)
    }
    if (sliceEnd(e) == 0 || nodeType(sliceEnd(e)) == 0) {
        return natNativeRefuse("open-ended string slicing (s[a:]) is not lowered yet", line)
    }
    }
    return ""
}

// natNativeStrIndexSlot resolves a STRING byte index `s[i]` to its base local's
// slot ordinal, or -1 when `e` is not one.
//
// One predicate, used by the scan's kind split, by every emission dispatch, and
// by the arena accounting -- so there is exactly one notion of "which base makes
// this a string index". The base MUST be a plain variable: the array-index
// discipline established for `a[i]` (NAT-IDX) refuses every other base by name,
// because an expression-shaped base reaches the slot plan as an unknown name and
// the only possible outcomes are a crash or a wrong answer. Literals, composed
// strings and calls are refused for the same reason, with their own message.
func natNativeStrIndexSlot(plan, e) {
    if (nodeType(e) != NODE_INDEX()) { return 0 - 1 }
    let base = indexLeft(e)
    if (nodeType(base) != NODE_IDENT()) { return 0 - 1 }
    let ord = natNativeSlotIndex(plan, identName(base))
    if (ord < 0) { return 0 - 1 }
    if (natNativeSlotKind(plan, ord) != natKindString()) { return 0 - 1 }
    return ord
}

// natNativeScanStrIndex validates `s[i]` when `s` IS a string: the index must be
// an integer expression, and the base must be a string variable. It mirrors the
// array validator's shape (an index as an expression is what makes iteration a
// program rather than a literal-only special case), with the array-specific
// diagnostics replaced by this construct's own.
func natNativeScanStrIndex(expr, line, fns, plan) {
    let base = indexLeft(expr)
    if (nodeType(base) != NODE_IDENT()) {
        return natNativeRefuse("string index target must be a variable", line)
    }
    let ord = natNativeSlotIndex(plan, identName(base))
    if (ord < 0) {
        return natNativeRefuse("undefined identifier '" + identName(base) + "'", line)
    }
    if (natNativeSlotKind(plan, ord) != natKindString()) {
        return natNativeRefuse("index target must be a string (got " +
            natKindName(natNativeSlotKind(plan, ord)) +
            " '" + identName(base) + "')", line)
    }
    return natNativeScanIntExpr(indexExpr(expr), plan, line, fns, 0)
}

// natNativeScanTrim validates a `trim(x)` call.
//
// The verified contract (see natEmitTrim's header): the argument must be a
// string the driver can lower to (ptr, len) -- a literal, a string variable, a
// string byte index, or a nested trim() call. Anything else, including record
// fields, slices, concatenations and calls to anything but trim(), is refused
// by name; accepting an operand the emitter cannot lower is how this driver
// produced valid-looking images that compute garbage.
func natNativeScanTrim(call, plan, line, fns) {
    let args = callArgs(call)
    if (len(args) != 1) {
        return natNativeRefuse("trim() takes exactly 1 argument (got " + str(len(args)) + ")", line)
    }
    let e = args[0]
    let t = nodeType(e)
    if (t == NODE_STRING_LIT()) { return "" }
    if (t == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(e))
        if (ord < 0) {
            return natNativeRefuse("undefined identifier '" + identName(e) + "'", line)
        }
        if (natNativeSlotKind(plan, ord) != natKindString()) {
            return natNativeRefuse("trim() argument must be a string (got " +
                natKindName(natNativeSlotKind(plan, ord)) + " '" + identName(e) + "')", line)
        }
        return ""
    }
    if (t == NODE_INDEX()) {
        if (natNativeStrIndexSlot(plan, e) >= 0) { return "" }
        return natNativeRefuse("trim() argument must be a string; the index target must be a string", line)
    }
    if (t == NODE_CALL()) {
        if (callFunc(e) == "trim") { return natNativeScanTrim(e, plan, line, fns) }
        return natNativeRefuse("trim() argument must be a string literal, a string variable, a string index or trim(); a call to `" + callFunc(e) + "` is not", line)
    }
    if (t == NODE_DOT()) {
        return natNativeRefuse("trim() of a record field is not lowered", line)
    }
    if (t == NODE_BINARY()) {
        return natNativeRefuse("trim() of a concatenation is not lowered (bind it to a local first)", line)
    }
    if (t == NODE_SLICE()) {
        return natNativeRefuse("trim() of a string slice is not lowered (bind it to a local first)", line)
    }
    return natNativeRefuse("trim() argument must be a string literal, a string variable, a string index or trim()", line)
}

func natNativeScanValue(expr, stmts, plan, line, tbl, allowStr, fns) {
    let t = nodeType(expr)
    if (t == NODE_INT_LIT()) { return "" }
    if (t == NODE_BOOL_LIT()) { return "" }
    if (t == NODE_STRING_LIT()) { return "" }
    if (t == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(expr))
        if (ord < 0) {
            return natNativeRefuse("undeclared local `" + identName(expr) + "`", line)
        }
        let k = natNativeSlotKind(plan, ord)
        // A STRING is printable as itself: its value is already the (ptr, len) pair
        // print_str wants. An ARRAY is not printable as itself.
        if (k == natKindInt() || k == natKindString()) { return "" }
        return natNativeRefuse("cannot print `" + identName(expr) + "` as a whole; " +
            "its kind is " + natKindName(k) + ", so print an element or len() instead",
            line)
    }
if (t == NODE_BINARY()) {
    if (natNativeIsStrBinary(expr, stmts, plan) == 1) {
        return natNativeScanConcat(expr, stmts, plan, line)
    }
    return natNativeScanIntExpr(expr, plan, line, fns, 0)
}
  if (t == NODE_UNARY()) { return natNativeScanIntExpr(expr, plan, line, fns, 0) }
  // NAT-IDX: an index is an ordinary integer expression, validated by the
  // SHARED walker validator. It used to have its own validator here, which
  // required a LITERAL index -- the very limitation this increment removes --
  // and two validators for one construct is how they drift apart.
  // NAT-STRIDX: a string base is a byte index (the index is an integer
  // expression and the base a string variable); a non-string base keeps the
  // historical integer path, byte for byte. A literal base is refused with
  // its own message rather than the array's: "array index target must be a
  // variable" would name the wrong construct for `"abc"[0]`.
  if (t == NODE_INDEX()) {
      if (nodeType(indexLeft(expr)) == NODE_STRING_LIT()) {
          return natNativeRefuse("string index target must be a variable", line)
      }
      if (natNativeStrIndexSlot(plan, expr) >= 0) {
          return natNativeScanStrIndex(expr, line, fns, plan)
      }
      return natNativeScanIntExpr(expr, plan, line, fns, 0)
  }
  if (t == NODE_SLICE()) {
      if (natNativeStrKind(sliceLeft(expr), stmts, plan) != 1) {
          return natNativeRefuse("a string slice target must be a string", line)
      }
      return natNativeScanStrSlice(expr, stmts, plan, line)
  }
  if (t == NODE_CALL()) {
      if (callFunc(expr) == "len") { return natNativeScanLen(expr, plan, line, fns) }
      return natNativeScanCall(expr, plan, line, fns)
  }
  // Step 9h-1: a record field read, `rec.field`. NARROW by construction -- only an
  // int or float field on a local bound from a record literal is accepted. Anything else
  // (unknown base, unknown field, a string field, a non-identifier base, arithmetic) is
  // refused by name.
  //
  // Accepting NODE_DOT does NOT weaken the invariant below: this arm is reached only
  // after the record type AND the field offset AND the field kind are all resolved. An
  // unresolved field returns a refusal and never reaches emission, so a struct field can
  // never fall through to natMovRegImm32(RAX, intLitVal(v)).
  if (t == NODE_DOT()) { return natNativeScanField(expr, stmts, plan, line, tbl, allowStr) }
  // Step 9h-1 SAFETY REFUSAL. A struct literal must never fall through to the generic
  // integer path: `natMovRegImm32(RAX, intLitVal(v))` on a NODE_STRUCT_LIT emits a
  // STRUCTURALLY VALID PE that computes a meaningless integer, because intLitVal of a
  // non-literal yields 0. That is the worst possible outcome for a native backend -- it
  // is exactly the class of defect this gate exists to catch -- and it is what an earlier
  // Session-A attempt produced when the planner recognised struct literals before the
  // lowering did.
  //
  // This refusal is DELIBERATE and stays until literal construction is wired into
  // natNativeLower. The planner deliberately does NOT yet recognise NODE_STRUCT_LIT
  // either, so plan and lowering cannot disagree.
  if (t == NODE_STRUCT_LIT()) {
  return natNativeRefuse("record literals are not lowered by the native driver yet " +
  "(151A Step 9h-1 is in progress); this is refused HERE, by kcc", line)
  }
  return natNativeRefuse("expression of kind " + str(t) + " is neither an integer " +
        "literal, a local, an index nor len()", line)
}

// natNativeScanReturn validates a `return` value.
//
// It is natNativeScanValue plus ONE extra rule, and the rule is load-bearing: `return`
// feeds the process exit status, which is an int. A string is printable as itself, so
// the shared validator accepts it -- and without this check `return s` silently loaded
// the string's POINTER and exited with it. That is a valid image emitting a meaningless
// exit code, which the oracle refuses outright ("string return values are not
// supported"). The gate's refusal table found it.
func natNativeScanReturn(expr, stmts, plan, line, tbl, fns, isMain) {
    // A string LITERAL in return position is refused explicitly, and this is a
    // PRE-EXISTING hole rather than a NAT-CALL regression: natNativeScanValue accepts
    // a string literal unconditionally (it must, because a literal is printable as
    // itself), so the `allowStr` flag never reached that arm and `return "x"` passed
    // this validator, fell through to the return dispatch, and resolved identName() on
    // a literal to a slot that does not exist. It is closed here rather than left for
    // a crash to find.
    if (nodeType(expr) == NODE_STRING_LIT()) {
        if (isMain == 1) {
            // `main` feeds the process exit status, which is an int. A callee's
            // literal return is fine: the literal is interned program-wide now.
            return natNativeRefuse("`return` of a string from `main` is not supported; " +
                "a return value becomes the process exit status and must be an int " +
                "(a string returned by a called function is fine)", line)
        }
        return ""
    }
    if (nodeType(expr) == NODE_SLICE()) {
        return natNativeRefuse("string slicing in return position is not lowered", line)
    }
    if (nodeType(expr) == NODE_INDEX()) {
      if (isMain == 1) {
        if (natNativeStrIndexSlot(plan, expr) >= 0) {
          // `main` feeds the process exit status, which is an int; a string
          // byte index in a callee is fine.
          return natNativeRefuse("`return` of a string from `main` is not supported; " +
              "a return value becomes the process exit status and must be an int " +
              "(a string returned by a called function is fine)", line)
        }
      }
    }
    if (nodeType(expr) == NODE_CALL()) {
      if (isMain == 1) {
        if (callFunc(expr) == "trim") {
          // NAT-STRTRIM: same boundary as `return trim(s)` in `main`: the view
          // is a (ptr, len) pair and `main` feeds the process exit status,
          // which is an int.
          return natNativeRefuse("`return` of a string from `main` is not supported; " +
              "a return value becomes the process exit status and must be an int " +
              "(a string returned by a called function is fine)", line)
        }
      }
    }
    let bad = ""
    if (nodeType(expr) == NODE_CALL()) {
        if (natNativeFuncReturnKindOf(fns, callFunc(expr)) == 2) {
            return ""
        }
    }
    bad = natNativeScanValue(expr, stmts, plan, line, tbl, 0, fns)
    if (bad != "") { return bad }
if (nodeType(expr) == NODE_IDENT()) {
  let k = natNativeSlotKind(plan, natNativeSlotIndex(plan, identName(expr)))
  if (k == natKindInt() || k == natKindString()) {
  return ""
  }
  return natNativeRefuse("`return` of a " + natKindName(k) + " is not " +
  "supported; a return value becomes the process exit status and must be " +
  "an int or a string", line)
  }
  // A concatenated string is a STRING, and a string is not an exit status --
  // and this position never had an arm to lower it anyway: natEmitStrValue has
  // no BinaryExpr case, so `return "a" + "b"` in a callee fell through to the
  // identifier path and resolved identName() on a BinaryExpr to a slot that
  // does not exist (the self-hosted compiler died with an access violation,
  // measured). Refusing BY NAME is strictly better than crashing. The test is
  // the string-concat classification, not the node type: `return a + b` over
  // two ints is the ordinary int return and stays untouched.
  if (nodeType(expr) == NODE_BINARY()) {
      if (natNativeIsStrBinary(expr, stmts, plan) == 1) {
          return natNativeRefuse("`return` of a string concatenation is not lowered by the native driver", line)
      }
  }
  return ""
  }

// natEmitIntExpr lowers an INTEGER expression into RAX.
//
// It mirrors the oracle's emitExpr for exactly the kinds NAT-CALL admits, and the
// byte shapes are the oracle's, not invented:
//
//   - literal: MovRegImm64(RAX) -- the 64-bit form, for the same reason D2 recorded
//     on the print path (program.go:5887).
//   - local/parameter: LoadStack(RAX, slot) -- one instruction, because the slot is a
//     compile-time displacement.
//   - unary minus: operand at the SAME depth, then NegReg(RAX) (program.go:5944).
//     Passing depth+1 here would double the scratch usage of `-a + b` for no reason.
//   - binary: left at depth+1, stage RAX into binTemp+depth*8, right at depth+1,
//     RCX<-RAX, RAX<-the staged left, then the operator (program.go:6717-6745). The
//     operator is checked BEFORE the depth guard in the oracle; here the SCAN has
//     already refused every operator outside the set, so the emitter only has to
//     lower the three it accepts.
//
// There is deliberately no `stmts`, `roffs` or `tbl`: an integer expression cannot
// reference rodata, a record or a string, and passing them would invite an arm that
// does. Anything else falls through to the CALL arm, which is the only other integer
// producer in this slice.
func natEmitIntExpr(s, e, plan, fns, binTemp, extrasBase, frame, depth, rctx) {
    let t = nodeType(e)
    if (t == NODE_INT_LIT()) {
        return natMovRegImm64(s, natRegRAX(), int(intLitVal(e)))
    }
    if (t == NODE_BOOL_LIT()) {
        if (boolLitVal(e) == "true") { return natMovRegImm64(s, natRegRAX(), 1) }
        return natMovRegImm64(s, natRegRAX(), 0)
    }
    if (t == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(e))
        // NAT-REG: an allocated local lives in a callee-saved register; the
        // frame slot is the fallback for everything else.
        return natNativeLoadLocal(s, plan, ord, natRegRAX())
    }
    if (t == NODE_INDEX()) {
        // NAT-IDX: an array element read. The order is the oracle's
        // (program.go:6320-6324): the INDEX EXPRESSION is evaluated first, at
        // depth+1, then moved into RCX, and only then are the array's base and
        // length loaded.
        //
        // The index is evaluated BEFORE the base is loaded, which matters: the
        // index expression may itself read a local, and the base and the
        // length are loaded into RBX and RAX afterwards.
        let ord = natNativeSlotIndex(plan, identName(indexLeft(e)))
        s = natEmitIntExpr(s, indexExpr(e), plan, fns, binTemp, extrasBase, frame, depth + 1, rctx)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        return natArrayIndex(s, natNativeSlotOff(plan, ord), rctx[0], rctx[1], rctx[2], indexLine(e))
    }
    if (t == NODE_UNARY()) {
        s = natEmitIntExpr(s, unaryOperand(e), plan, fns, binTemp, extrasBase, frame, depth, rctx)
        return natNegReg(s, natRegRAX())
    }
    if (t == NODE_BINARY()) {
        s = natEmitIntExpr(s, binaryLeft(e), plan, fns, binTemp, extrasBase, frame, depth + 1, rctx)
        s = natStoreStack(s, natRegRAX(), binTemp + depth * 8)
        s = natEmitIntExpr(s, binaryRight(e), plan, fns, binTemp, extrasBase, frame, depth + 1, rctx)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), binTemp + depth * 8)
        let op = binaryOp(e)
        if (op == "+") { return natAddRegReg(s, natRegRAX(), natRegRCX()) }
        if (op == "-") { return natSubRegReg(s, natRegRAX(), natRegRCX()) }
        return natMulRegReg(s, natRegRAX(), natRegRCX())
    }
    if (t == NODE_CALL()) {
        if (callFunc(e) == "len") {
            // `len` is a driver builtin, not a user function: route it in place,
            // exactly as the print and return positions do, rather than falling
            // into natEmitIntCall, which would emit a call to a label that does
            // not exist. This was a pre-existing defect: `while (i < len(arr))`
            // in EITHER main or a callee crashed the PE linker instead of doing
            // the length load. The dedicated print/return arms did len correctly
            // and the condition path did not, which is why no gate caught it.
            let lo = natNativeSlotIndex(plan, identName(callArgs(e)[0]))
            return natArrayLen(s, natNativeSlotOff(plan, lo))
        }
        return natEmitIntCall(s, e, plan, fns, binTemp, extrasBase, frame, depth, rctx)
    }
    return natEmitIntCall(s, e, plan, fns, binTemp, extrasBase, frame, depth, rctx)
}

// natEmitIntCond lowers an integer comparison and jumps to falseLabel when the
// comparison does NOT hold.
//
// It is the oracle's emitCond int path (program.go:5135-5146) instruction for
// It is the oracle's emitCond int path (program.go:5135-5146) instruction for
// instruction:
//
//	evaluate the LEFT operand into RAX
//	spill it to the scratch slot
//	evaluate the RIGHT operand into RAX, move it to RCX
//	reload the LEFT operand into RAX
//	CmpRegReg(RAX, RCX)
//	jump to falseLabel on the INVERSE of the comparison
//
// The scratch slot is the region's START (depth 0), not the depth-1 slot the
// operands themselves use, which is why a condition and a depth-0 body
// expression share one slot. The operands are evaluated at depth 1, exactly as
// the oracle does, so a nested binary operand stages at the same offsets.
//
// The jump opcode per operator is natNativeCondOp's mapping, and it is the
// oracle's: the condition FALLS THROUGH when the comparison holds.
func natEmitIntCond(s, cond, plan, fns, binTemp, extrasBase, frame, falseLabel, rctx) {
    let op = natNativeCondOp(binaryOp(cond))
    s = natEmitIntExpr(s, binaryLeft(cond), plan, fns, binTemp, extrasBase, frame, 1, rctx)
    s = natStoreStack(s, natRegRAX(), binTemp)
    s = natEmitIntExpr(s, binaryRight(cond), plan, fns, binTemp, extrasBase, frame, 1, rctx)
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), binTemp)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    if (op == 0) { return natJnz(s, falseLabel) }
    if (op == 1) { return natJz(s, falseLabel) }
    if (op == 2) { return natJge(s, falseLabel) }
    if (op == 3) { return natJg(s, falseLabel) }
    if (op == 4) { return natJle(s, falseLabel) }
    if (op == 5) { return natJl(s, falseLabel) }
    return s
}

// NAT-STREQ emit half. natEmitStrEqCond ports the oracle's emitStrEqCond
// (pkg/native/program.go:4998-5068) instruction for instruction:
//
//   - both operands stage through natEmitStrValue (the emitStr counterpart)
//     into the strTemp staging area -- left (ptr,len) at base+0/base+8, right
//     at base+16/base+24 -- so the second evaluation cannot disturb the first;
//   - unequal lengths decide immediately (LoadStack RAX=left len, CmpRegReg
//     against RSI which STILL holds the right length, Jnz to the not-equal
//     block) with no byte reads at all;
//   - the byte loop compares one byte at a time through the scaled 8-bit
//     loads, RDX as the index and RCX as the count, Jae leaving on the count;
//   - two outcomes, and the operator only decides which one continues into
//     the then-branch: the ne block jumps to falseLabel for `==` and to the
//     past-eq label for `!=` (without that hop `!=` would fall into the equal
//     block's own false jump and behave exactly like `==`), the eq block
//     falls through for `==` and jumps to falseLabel for `!=`.
//
// The label NAMES are kcc's own (seeded from the construct's existing unique
// label, so two comparisons cannot collide); only the instruction ORDER and
// NUMBER reach the bytes.
func natEmitStrEqCond(s, cond, falseLabel, strTemp, stmts, plan, roffs, tbl, seed, ictx) {
    let op = binaryOp(cond)
    let base = strTemp
    s = natEmitStrValue(s, binaryLeft(cond), stmts, plan, roffs, tbl, ictx)
    s = natStoreStack(s, natRegRDI(), base)
    s = natStoreStack(s, natRegRSI(), base + 8)
    s = natEmitStrValue(s, binaryRight(cond), stmts, plan, roffs, tbl, ictx)
    s = natStoreStack(s, natRegRDI(), base + 16)
    s = natStoreStack(s, natRegRSI(), base + 24)
    let neLbl = seed + "$streqne"
    let eqLbl = seed + "$streqeq"
    let endLbl = seed + "$streqend"
    let loopLbl = seed + "$streqlp"
    s = natLoadStack(s, natRegRAX(), base + 8)
    s = natCmpRegReg(s, natRegRAX(), natRegRSI())
    s = natJnz(s, neLbl)
    s = natLoadStack(s, natRegR8(), base)
    s = natLoadStack(s, natRegR9(), base + 16)
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natXorRegReg(s, natRegRDX())
    s = natMark(s, loopLbl)
    s = natCmpRegReg(s, natRegRDX(), natRegRCX())
    s = natJae(s, eqLbl)
    s = natLoadScaled8(s, natRegR10(), natRegR8(), natRegRDX(), 1, 0)
    s = natLoadScaled8(s, natRegR11(), natRegR9(), natRegRDX(), 1, 0)
    s = natCmpRegReg(s, natRegR10(), natRegR11())
    s = natJnz(s, neLbl)
    s = natIncReg(s, natRegRDX())
    s = natJmp(s, loopLbl)
    s = natMark(s, neLbl)
    if (op == "==") {
        s = natJmp(s, falseLabel)
    } else {
        s = natJmp(s, endLbl)
    }
    s = natMark(s, eqLbl)
    if (op == "!=") {
        s = natJmp(s, falseLabel)
    }
    s = natMark(s, endLbl)
    return s
}

// natEmitCond is the condition dispatcher both the scan (natNativeScanCond)
// and this emit half route through: a comparison with a string operand goes
// to the equality emit, everything else keeps the int path BYTE-IDENTICAL to
// what the frozen NAT-IF / NAT-LOOP gates pinned -- the wrapper is invisible
// to an int condition because the classifier returns non-string for both
// operands of every int comparison.
//
// The seed is the construct's existing unique label (elseLabel / endLabel),
// so the equality's own labels cannot collide across statements or functions.
func natEmitCond(s, cond, plan, fns, binTemp, extrasBase, frame, falseLabel, rctx,
    strTemp, stmts, roffs, tbl, seed) {
    if (nodeType(cond) == NODE_BINARY() &&
        (natNativeStrKind(binaryLeft(cond), 0, plan) == 1 ||
         natNativeStrKind(binaryRight(cond), 0, plan) == 1)) {
        return natEmitStrEqCond(s, cond, falseLabel, strTemp, stmts, plan, roffs, tbl, seed,
            [fns, binTemp, extrasBase, frame, rctx])
    }
    return natEmitIntCond(s, cond, plan, fns, binTemp, extrasBase, frame, falseLabel, rctx)
}

// natStoreArgUnit homes one argument UNIT into the spill area: the six register
// slots (16 bytes apart, matching the oracle's argTemp) first, then the caller's
// extras area addressed through R10 by the callee.
func natStoreArgUnit(s, reg, unit, frame, extrasBase) {
    if (unit < 6) {
        return natStoreStack(s, reg, natArgTemp(unit, frame))
    }
    return natStoreStack(s, reg, extrasBase + (unit - 6) * 8)
}

// natEmitIntCall lowers a call to a USER function and leaves the result in RAX.
//
// The convention is Phase 148's, reproduced rather than simplified, because a
// different-but-reasonable staging order would still work and still be wrong:
//
//   1. Evaluate every argument and spill it. Unit i goes to argTemp(i) for i < 6;
//      further units go to extrasBase + (i-6)*8.
//   2. Load units 0..5 back into RDI,RSI,RDX,RCX,R8,R9. The spill exists because
//      argument 1's evaluation would otherwise clobber argument 0's register.
//   3. If any unit exceeded the six registers, materialise R10 = extrasBase -- the
//      CALLEE addresses its extras through R10, which it must home before its first
//      call destroys it.
//   4. call <label>.
//
// ARGUMENT i IS UNIT i here, and that is sound rather than sloppy: kcc's parser
// stores parameter NAMES only, so every parameter is a one-unit int, and
// natNativeScanCall refuses any argument whose kind is not int. A two-unit argument
// (a string) would need the (arg, unit) split the oracle uses -- including the
// `r == RSI` high-half rule -- and the refusal is what keeps that unrepresentable
// state unreachable rather than silently mis-homed.
//
// WINDOWS GETS ITS OWN 8 BYTES. `call` pushes a return address, so a callee entered
// from an rsp%-16==8 call site lands at 0 (mod 16) and every aligned SSE spill it
// makes faults. System V callers do not require the adjustment and the oracle does
// not emit it, so Linux and macOS emit nothing and stay byte-identical; Windows
// already differs from the oracle's bytes (its whole entry and stdout path do), so
// correctness there costs nothing that parity was measuring.
func natEmitIntCall(s, e, plan, fns, binTemp, extrasBase, frame, depth, rctx) {
    let fname = callFunc(e)
    let args = callArgs(e)
    let isWin = 0
    if (natStTargetOS(s) == natOSWindows()) { isWin = 1 }
    let i = 0
    let unit = 0
    while (i < len(args)) {
        if (natNativeArgKindFor(args[i], plan) != 1) {
            // Two units: the two-unit (ptr, len) header of a string or an array,
            // off its two frame slots. An IDENTIFIER argument loads from its slot;
            // a STRING LITERAL argument materialises (ptr, len) from the interned
            // rodata directly, which needs the emitting function's own body and
            // roffs slice from the emitter's string context.
            if (nodeType(args[i]) == NODE_STRING_LIT()) {
                let lit = args[i]
                s = natRodataRefOff(s, natRegRAX(),
                    natRodataOffsetFor(stringLitVal(lit), natStStrStmts(s), natStStrRoffs(s)))
                s = natStoreArgUnit(s, natRegRAX(), unit, frame, extrasBase)
                s = natMovRegImm32(s, natRegRAX(), len(stringLitVal(lit)))
                s = natStoreArgUnit(s, natRegRAX(), unit + 1, frame, extrasBase)
                unit = unit + 2
            } else {
                let ord = natNativeSlotIndex(plan, identName(args[i]))
                s = natLoadStack(s, natRegRAX(), natNativeSlotOff(plan, ord))
                s = natStoreArgUnit(s, natRegRAX(), unit, frame, extrasBase)
                s = natLoadStack(s, natRegRAX(), natNativeSlotOff(plan, ord) + 8)
                s = natStoreArgUnit(s, natRegRAX(), unit + 1, frame, extrasBase)
                unit = unit + 2
            }
        } else {
            s = natEmitIntExpr(s, args[i], plan, fns, binTemp, extrasBase, frame, depth, rctx)
            s = natStoreArgUnit(s, natRegRAX(), unit, frame, extrasBase)
            unit = unit + 1
        }
        i = i + 1
    }
    let k = 0
    while (k < unit) {
        if (k < 6) {
            s = natLoadStack(s, natArgReg(k), natArgTemp(k, frame))
        }
        k = k + 1
    }
    if (unit > 6) {
        s = natLeaRegStack(s, natRegR10(), extrasBase)
    }
    if (isWin == 1) { s = natSubRegImm32(s, natRegRSP(), 8) }
    s = natCall32(s)
    // natRel32 returns the [state, patch-position] PAIR, not the state. Assigning it
    // straight to `s` leaves `s` holding two elements, and the very next helper that
    // reads a slot (natCallPrintInt reads natStTargetOS) fails with an array-index
    // error far from here. Step 8d's corpus always destructured the pair; this is the
    // production copy and it has to as well.
    let rr = natRel32(s, natNativeFuncLabel(fname))
    s = rr[0]
    if (isWin == 1) { s = natAddRegImm32(s, natRegRSP(), 8) }
    return s
}

// natNativeHomeParams copies the argument registers into the parameter slots at
// function entry.
//
// This MUST run before anything else in the body, and the reason is not style: R10
// carries the extras base, and R10 is caller-saved, so the first call the body makes
// destroys it. The oracle's own emitFunc says the same thing (program.go:4832-4836)
// and homes parameters at the top of the prologue for exactly that reason.
func natNativeHomeParams(s, params, plan) {
    let unit = 0
    let i = 0
    while (i < len(params)) {
        let ord = natNativeSlotIndex(plan, params[i])
        let units = natKindUnits(natNativeSlotKind(plan, ord))
        let k = 0
        while (k < units) {
            if (unit < 6) {
                // NAT-REG: an allocated parameter is homed straight into its
                // register. Only an INT parameter is ever allocated, so it is
                // one unit and the "+ k * 8" offset does not apply.
                let preg = natNativeSlotReg(plan, ord)
                if (preg >= 0) {
                    s = natMovRegReg(s, preg, natArgReg(unit))
                } else {
                    s = natStoreStack(s, natArgReg(unit), natNativeSlotOff(plan, ord) + k * 8)
                }
            } else {
                s = natLoadBaseOff(s, natRegRAX(), natRegR10(), (unit - 6) * 8)
                s = natStoreStack(s, natRegRAX(), natNativeSlotOff(plan, ord) + k * 8)
            }
            unit = unit + 1
            k = k + 1
        }
        i = i + 1
    }
    return s
}

// natNativeLower emits one function's body into an existing emitter state.
//
// The `sub rsp, 8` around a USER call is Win64 ABI, not padding, and it lives in
// natEmitIntCall rather than here: `_start` aligns rsp to 16 and then calls, so rsp
// is 8 (mod 16) at function entry, and a call site requires rsp to be 0 (mod 16)
// immediately before the `call`. The 8 bytes restore that alignment and are released
// immediately after. Calls to the emitted HELPERS do not need it -- print_int and
// print_str take no arguments from the aligned SSE area and are entered the same way
// the oracle enters them -- so adding it there would break byte-identity for nothing.
//
// The statement ORDINAL doubles as the label tag for `a[i]`, so no counter can fall
// out of step with the statement list.
func natNativeLower(s, stmts, fnStmts, plan, roffs, tbl, rtErr, rtKindSlot, srcOff, srcLen, strIdxKindSlot, fns, lay, retLabel, tag, listPath) {
    // The scratch regions come from the CALLER's layout, because the caller is the
    // function being lowered. Reading them here instead of threading three more
    // arguments keeps ONE source of truth: natFrameLayout is the only place a frame
    // number is decided, and a function's binTemp must be ITS binTemp -- a callee
    // with a different locals region has a different scratch offset, and reusing
    // main's would stage operands over the callee's own locals.
    let binTemp = lay[1]
    let strTemp = lay[2]
    let extrasBase = lay[4]
    let frame = lay[6]
    // NAT-IDX: the runtime-error REPORTER's context, bundled so it can travel
    // through the shared expression walker as ONE argument.
    //
    // The three values are the rodata offset of the reporter's "kind" argument
    // and the source basename's offset and length. They are a property of the
    // FUNCTION, not of a statement, so bundling them here -- once, where the
    // function's own parameters arrive -- keeps them out of every call site.
    //
    // It is an explicit parameter and not global state: two functions in one
    // image have different basenames, and a global would have to be saved and
    // restored around every call.
    //
    // NAT-STRIDX: the string index bounds-check calls the SAME reporter with a
    // different "kind" string, so the context carries its offset as a fourth
    // element. The array path keeps reading rctx[0..2] and is unchanged.
    let rctx = [rtKindSlot, srcOff, srcLen, strIdxKindSlot]
    // NAT-STRIDX: the int-expression evaluation context bundled as ONE value,
    // for the same reason rctx is one value. The string value emitter needs it
    // to lower a string byte index (its index is an ordinary int expression,
    // evaluated by the SAME walker the int path uses), and threading five
    // parameters individually would drift at exactly the one caller that
    // rebuilds the pair.
    let ictx = [fns, binTemp, extrasBase, frame, rctx]
    // sidx walks the LITERALS' offset list in lockstep with the literals the
    // program binds. Lockstep is what makes a literal's recorded offset agree
    // with the list the linker interns; recomputing an offset from the
    // literal's VALUE instead would break the moment two bindings shared one
    // string, which natRodataSection interns only once.
    //
    // The list holds the LITERALS' offsets and nothing else, so the cursor
    // starts at 0. It used to hold the WHOLE rodata offset array and start at
    // 2, which tied the cursor's start to how many non-literal entries came
    // before the literals -- so the interning order and the cursor were the
    // same fact, and moving the reporter's strings moved the cursor too.
    let sidx = 0
    // Concat-site counter; used only to make the byte-copy labels unique.
    let site = 0
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        let k = nodeType(n)
        if (natNativeIsDecl(n)) {
            // The slot index is resolved by NAME against the plan rather than carried
            // as a running counter, because a function's first bindings are its
            // PARAMETERS and those have no declaration statement to count. A counter
            // would make `func add(a, b)` put its first `let` in the slot a parameter
            // already owns. natNativeSlotIndex searches the plan, whose first slots are
            // the parameters, so both kinds of binding resolve through one lookup.
            let idx = natNativeSlotIndex(plan, natNativeDeclName(n))
            let v = natNativeDeclValue(n)
            if (nodeType(v) == NODE_ARRAY_LIT()) {
                s = natArrayValue(s, natNativeSlotOff(plan, idx), arrayLitElems(v))
            } else {
if (nodeType(v) == NODE_STRUCT_LIT()) {
      // Step 9h-1: the field area sits at slotOff+8; natRecordArea LEA's it and stores
      // that ADDRESS into the record's value slot.
      s = natRecordArea(s, natNativeSlotOff(plan, idx))
      let rtype = structLitName(v)
      let rfields = structLitFields(v)
      let f = 0
      while (f < len(rfields)) {
        let fd = rfields[f]
        let fname = identName(binaryLeft(fd))
        let foff = natStructFieldOff(tbl, rtype, fname)
        let fk = natStructFieldKind(tbl, rtype, fname)
        let fv = binaryRight(fd)
        // Reload the base from the record's frame slot immediately before each store,
        // so no field expression is evaluated between the reload and the store.
        s = natLoadStack(s, natRegRBX(), natNativeSlotOff(plan, idx))
        // NAT-STREQ provenance: the FUNCTION-WIDE list, not the current
        // sub-list. roffs was sliced from fnStmts, and natRodataOffsetFor
        // matches by VALUE in the list it is given and then INDEXES roffs by
        // that position -- so a branch-local list answers with the wrong
        // entry whenever an earlier statement in the function bound a
        // literal (p1: print("alpha") then print("beta") in an if printed
        // "alph"). Value lookup makes the walk order irrelevant; the list
        // IDENTITY is what has to agree.
        let rr = natRecordStoreLiteral(s, fnStmts, fv, foff, fk, roffs, sidx)
        s = rr[0]
        sidx = rr[1]
        f = f + 1
      }
    } else {
    if (nodeType(v) == NODE_STRING_LIT()) {
                    // A string literal's value IS its own bytes, so the binding is two
                    // stores: the interned rodata pointer and the byte length. No arena
                    // is involved -- an arena is only needed to BUILD a string, and a
                    // literal is already built.
                    s = natRodataRefOff(s, natRegRDI(), natRodataOffsetFor(stringLitVal(v), fnStmts, roffs))
                    s = natMovRegImm32(s, natRegRSI(), len(stringLitVal(v)))
                    s = natStoreStack(s, natRegRDI(), natNativeSlotOff(plan, idx))
                    s = natStoreStack(s, natRegRSI(), natNativeSlotOff(plan, idx) + 8)
                } else if (nodeType(v) == NODE_CALL() && natNativeFuncReturnKindOf(fns, callFunc(v)) == 2
                        && callFunc(v) != "trim") {
                    // A string-returning call: the callee leaves the result in
                    // (RDI, RSI). This arm binds it straight into the slot;
                    // natEmitIntExpr has no arm for a two-unit string value, so
                    // letting it fall through would emit garbage. `trim` is
                    // excluded because it is not a callable callee -- it has
                    // no label, and routing it here left an unresolved call site
                    // that crashed the PE linker (measured, t04/t07/t08).
                    s = natEmitIntCall(s, v, plan, fns, binTemp, extrasBase, frame, 0, rctx)
                    s = natStoreStack(s, natRegRDI(), natNativeSlotOff(plan, idx))
                    s = natStoreStack(s, natRegRSI(), natNativeSlotOff(plan, idx) + 8)
                } else if (nodeType(v) == NODE_CALL() && callFunc(v) == "trim") {
                    // NAT-STRTRIM: `let b = trim(s)` binds the non-allocating
                    // view. The slot store is the string convention.
                    s = natEmitTrim(s, callArgs(v)[0], fnStmts, plan, roffs, tbl, ictx)
                    s = natStoreStack(s, natRegRDI(), natNativeSlotOff(plan, idx))
                    s = natStoreStack(s, natRegRSI(), natNativeSlotOff(plan, idx) + 8)
                } else {
                if (nodeType(v) == NODE_INDEX() && natNativeStrIndexSlot(plan, v) >= 0) {
                    // NAT-STRIDX: `let b = s[i]` binds the one-byte view the
                    // index yields. The slot store is the string convention:
                    // the pointer at +0, the length at +8.
                    s = natEmitStrValue(s, v, fnStmts, plan, roffs, tbl, ictx)
                    s = natStoreStack(s, natRegRDI(), natNativeSlotOff(plan, idx))
                    s = natStoreStack(s, natRegRSI(), natNativeSlotOff(plan, idx) + 8)
                } else if (nodeType(v) == NODE_CALL() && callFunc(v) == "push") {
                    // push: alloc a new array, copy old elements, append v.
                    // Ported from pkg/native/program.go emitPush.
                    let args = callArgs(v)
                    let srcName = identName(args[0])
                    let srcOrd = natNativeSlotIndex(plan, srcName)
                    let srcOff = natNativeSlotOff(plan, srcOrd)
                    let stage = strTemp
                    // value
                    s = natEmitIntExpr(s, args[1], plan, fns, binTemp, extrasBase, frame, 0, rctx)
                    s = natStoreStack(s, natRegRAX(), stage)
                    // old base / old len
                    s = natLoadStack(s, natRegRAX(), srcOff)
                    s = natStoreStack(s, natRegRAX(), stage + 8)
                    s = natLoadStack(s, natRegRAX(), srcOff + 8)
                    s = natStoreStack(s, natRegRAX(), stage + 16)
                    // bytes = (old len + 1) * 8
                    s = natLoadStack(s, natRegRDI(), stage + 16)
                    s = natAddRegImm32(s, natRegRDI(), 1)
                    s = natShlRegImm(s, natRegRDI(), 3)
                    s = natCallAlloc(s)
                    s = natStoreStack(s, natRegRAX(), stage + 24)
                    // copy loop
                    s = natLoadStack(s, natRegR8(), stage + 8)
                    s = natLoadStack(s, natRegR9(), stage + 16)
                    s = natLoadStack(s, natRegR10(), stage + 24)
                    let loopLbl = "push$cp" + str(i)
                    let doneLbl = "push$done" + str(i)
                    s = natXorRegReg(s, natRegRDX())
                    s = natMark(s, loopLbl)
                    s = natCmpRegReg(s, natRegRDX(), natRegR9())
                    s = natJae(s, doneLbl)
                    s = natLoadScaled64(s, natRegRAX(), natRegR8(), natRegRDX(), 8, 0)
                    s = natStoreScaled64(s, natRegRAX(), natRegR10(), natRegRDX(), 8, 0)
                    s = natIncReg(s, natRegRDX())
                    s = natJmp(s, loopLbl)
                    s = natMark(s, doneLbl)
                    // append v
                    s = natLoadStack(s, natRegRAX(), stage)
                    s = natStoreScaled64(s, natRegRAX(), natRegR10(), natRegR9(), 8, 0)
                    // header: base = newbase, len = oldlen + 1
                    s = natLoadStack(s, natRegRAX(), stage + 24)
                    s = natStoreStack(s, natRegRAX(), natNativeSlotOff(plan, idx))
                    s = natLoadStack(s, natRegRAX(), stage + 16)
                    s = natAddRegImm32(s, natRegRAX(), 1)
                    s = natStoreStack(s, natRegRAX(), natNativeSlotOff(plan, idx) + 8)
                } else {
                    s = natEmitIntExpr(s, v, plan, fns, binTemp, extrasBase, frame, 0, rctx)
                    s = natNativeStoreLocal(s, plan, idx, natRegRAX())
                }
                }
            }
}
}
        if (k == NODE_PRINT()) {
            let pv = printVal(n)
            // The argument is loaded BEFORE the alignment adjustment, and that
            // ordering is load-bearing rather than cosmetic.
            //
            // natLoadStack addresses [rsp + off], i.e. the CURRENT rsp. The 8-byte
            // `sub rsp, 8` needed for Win64 call alignment therefore shifts every
            // frame-relative load that follows it 8 bytes too low -- the first
            // draft emitted `sub rsp,8; mov (%rsp),%rdi`, which read the byte
            // BELOW the first local. The symptom was not a crash: with two locals
            // the program printed `0` then `7`, because `print(b)`'s `mov 8(%rsp)`
            // happened to land back on slot 0. A literal argument was unaffected,
            // which is why the literal-only case passed while every local case
            // failed -- and why a single passing case would not have been evidence
            // that the path was right.
            //
            // Nothing between the load and the `call` touches RDI, so loading early
            // is safe and is also the shape the oracle's call sequence uses.
            //
            // An `a[i]` argument is loaded EARLIER still, before RDI is touched at
            // all: natArrayIndex leaves the element in RAX and needs RBX and RCX, so
            // it runs, and only then does the value move to RDI. Materialising the
            // index before the alignment adjust is not a choice -- the scaled load
            // addresses the element area through a register base and would read eight
            // bytes low if it came after the `sub`.
            // A `+` on two strings is the CONCAT arm. It is the OUTERMOST `if` rather
            // than a fifth else-if because that needs exactly one brace pair; an earlier
            // attempt appended an inner `} else {` without its match and produced a K001
            // parse cascade.
            //
            // natStrConcat leaves (RDI, RSI) = (dst, len), which is already print_str's
            // convention, so the call follows directly.
            //
            // The int-expression arm is decided FIRST and by KIND rather than by node
            // type, because `+` is two different operations now: on two strings it is a
            // concat (the arena path), and on two ints it is arithmetic (the binTemp
            // path). Before NAT-CALL every `+` in a printable position WAS a concat, so
            // the node type alone was the right test; using it alone now would route
            // `print(a + b)` into natStrConcat, whose operands are resolved as string
            // slots. Unary `-` is included for the same reason: the scan accepts it, so
            // the lowering must reach it.
            let isIntExpr = 0
            if (nodeType(pv) == NODE_BINARY()) {
                if (natNativeIsStrBinary(pv, stmts, plan) == 0) { isIntExpr = 1 }
            }
            if (nodeType(pv) == NODE_UNARY()) { isIntExpr = 1 }
            if (isIntExpr == 1) {
                s = natEmitIntExpr(s, pv, plan, fns, binTemp, extrasBase, frame, 0, rctx)
                s = natMovRegReg(s, natRegRDI(), natRegRAX())
                s = natCallPrintInt(s)
            } else {
            if (nodeType(pv) == NODE_BINARY()) {
                s = natStrConcat(s, binaryLeft(pv), binaryRight(pv), 0, site, strTemp,
                    fnStmts, plan, roffs, tbl, ictx)
                s = natCallPrintStr(s)
                site = site + 1
            } else {
            if (nodeType(pv) == NODE_SLICE()) {
                s = natEmitStrSlice(s, pv, fns, binTemp, extrasBase, frame, rctx, strTemp, fnStmts, plan, roffs, tbl)
                s = natCallPrintStr(s)
                site = site + 1
            } else {
            if (nodeType(pv) == NODE_INT_LIT()) {
                // The oracle computes an int literal into RAX with a 64-bit
                // immediate and then moves it to RDI (emitExpr -> MovRegImm64,
                // then MovRegReg(RDI, RAX) at program.go:5641-5642). kcc wrote
                // straight into RDI with a 32-bit immediate, which is 5 bytes
                // instead of 10 and skips the move -- so the operand form itself
                // differed, not only the alignment around the call.
                s = natMovRegImm64(s, natRegRAX(), int(intLitVal(pv)))
                s = natMovRegReg(s, natRegRDI(), natRegRAX())
                s = natCallPrintInt(s)
            } else {
                if (nodeType(pv) == NODE_STRING_LIT()) {
                    // NAT-STREQ provenance: fnStmts, the list roffs was
                    // sliced from -- see the natRecordStoreLiteral note.
                    s = natRodataRefOff(s, natRegRDI(), natRodataOffsetFor(stringLitVal(pv), fnStmts, roffs))
                    s = natMovRegImm32(s, natRegRSI(), len(stringLitVal(pv)))
                    s = natCallPrintStr(s)
                } else {
                    if (nodeType(pv) == NODE_INDEX()) {
                        // NAT-STRIDX: a string byte index prints as the one-byte
                        // string it is; an array element keeps the int path.
                        if (natNativeStrIndexSlot(plan, pv) >= 0) {
                            s = natEmitStrValue(s, pv, fnStmts, plan, roffs, tbl, ictx)
                            s = natCallPrintStr(s)
                        } else {
                            s = natEmitIntExpr(s, pv, plan, fns, binTemp, extrasBase, frame, 0, rctx)
                            s = natMovRegReg(s, natRegRDI(), natRegRAX())
                            s = natCallPrintInt(s)
                        }
} else {
if (nodeType(pv) == NODE_DOT()) {
let drec = identName(dotLeft(pv))
let dkn = natStructFieldKind(tbl, natRecordTypeOfLocal(fnStmts, drec), memberField(pv))
if (dkn == natKindString()) {
s = natEmitStrValue(s, pv, fnStmts, plan, roffs, tbl, ictx)
s = natCallPrintStr(s)
} else {
s = natRecordFieldLoadInt(s, stmts, plan, tbl, drec, memberField(pv))
s = natMovRegReg(s, natRegRDI(), natRegRAX())
s = natCallPrintInt(s)
}
} else {
if (nodeType(pv) == NODE_CALL()) {
// `len` lowers in place; a call to a USER function goes through the
// call ABI. They share the print_int tail and nothing else.
if (callFunc(pv) == "len") {
let pargs = callArgs(pv)
if (nodeType(pargs[0]) == NODE_CALL() && callFunc(pargs[0]) == "trim") {
    // NAT-STRTRIM: `len(trim(s))` -- the trimmed length IS the second unit of
    // the view pair, so the int walker has nothing to do with it; lower the
    // trim in place and print RSI.
    s = natEmitTrim(s, callArgs(pargs[0])[0], fnStmts, plan, roffs, tbl, ictx)
    s = natMovRegReg(s, natRegRDI(), natRegRSI())
    s = natCallPrintInt(s)
} else {
let ordl = natNativeSlotIndex(plan,
identName(pargs[0]))
                            s = natArrayLen(s, natNativeSlotOff(plan, ordl))
                            s = natMovRegReg(s, natRegRDI(), natRegRAX())
                            s = natCallPrintInt(s)
}
                        } else if (callFunc(pv) == "trim") {
                            // NAT-STRTRIM: `print(trim(s))` -- the view is a
                            // two-unit (ptr, len) pair, print_str's own shape.
                            s = natEmitTrim(s, callArgs(pv)[0], fnStmts, plan, roffs, tbl, ictx)
                            s = natCallPrintStr(s)
                        } else if (natNativeFuncReturnKindOf(fns, callFunc(pv)) == 2) {
                            // A string-returning call prints straight out of
                            // (RDI, RSI) ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â no MovRegReg shimming.
                            s = natEmitIntCall(s, pv, plan, fns, binTemp, extrasBase, frame, 0, rctx)
                            s = natCallPrintStr(s)
                        } else {
                        s = natEmitIntCall(s, pv, plan, fns, binTemp, extrasBase, frame, 0, rctx)
                            s = natMovRegReg(s, natRegRDI(), natRegRAX())
                            s = natCallPrintInt(s)
                        }
                        } else {
                            let ordp = natNativeSlotIndex(plan, identName(pv))
                            if (natNativeSlotKind(plan, ordp) == natKindString()) {
                                s = natLoadStack(s, natRegRDI(),
                                    natNativeSlotOff(plan, ordp))
                                s = natLoadStack(s, natRegRSI(),
                                    natNativeSlotOff(plan, ordp) + 8)
                                s = natCallPrintStr(s)
                            } else {
                // Load into RAX, then move to RDI. The oracle reads an
                // identifier through emitExpr's Identifier case, which is
                // LoadStack(RAX, off), and only then does the print path do
                // MovRegReg(RDI, RAX) (program.go:5887 and :5642). kcc loaded
                // straight into RDI, which is a different instruction AND
                // skips the move.
                s = natLoadStack(s, natRegRAX(),
                    natNativeSlotOff(plan, ordp))
                s = natMovRegReg(s, natRegRDI(), natRegRAX())
                s = natCallPrintInt(s)
            }
}
}
}
}
}
            }
            }
        }
        }
        if (k == NODE_EXPR_STMT()) {
        let ae = exprStmtExpr(n)
        if (natNativeIsAssignExpr(ae)) {
        if (nodeType(binaryLeft(ae)) == NODE_IDENT()) {
        // NAT-LOOP: a plain-local assignment -- `i = i + 1`. The
        // record-field form is the other arm.
        s = natEmitAssignLocal(s, plan, binaryLeft(ae), binaryRight(ae), fns, binTemp, extrasBase, frame, rctx)
        } else {
        let rr = natNativeLowerAssign(s, fnStmts, plan, tbl, roffs, sidx,
        binaryLeft(ae), binaryRight(ae))
        s = rr[0]
        sidx = rr[1]
        }
        } else {
        // A bare call statement -- see the scan arm for why it exists. The result is
        // discarded, which is exactly what a void callee's caller does; a callee that
        // DOES return a value here is not an error, just an unused one, matching the
        // oracle's expression-statement handling.
        s = natEmitIntCall(s, ae, plan, fns, binTemp, extrasBase, frame, 0, rctx)
        }
        } else {
        if (k == NODE_RETURN()) {
            let rv = retVal(n)
            // A string return is dispatched BEFORE the int paths: the value is a
            // two-unit (RDI, RSI) pair, not an int in RAX, and the int walker has
            // no arm for it. String emit goes through natEmitStrValue, which
            // leaves (RDI, RSI) already set for the exit teardown.
            if (natNativeValueKindOf(rv, plan, fns) == 2) {
                s = natEmitStrValue(s, rv, fnStmts, plan, roffs, tbl, ictx)
                s = natJmp(s, retLabel)
            } else {
            // The dispatch is by NODE TYPE only where the type alone is decisive.
            // `a[i]` and `len(a)` are their own lowerings; everything else that is
            // an INT belongs to the shared integer expression walker. That walker's
            // IntLiteral and Identifier cases are byte-for-byte what this block used
            // to emit inline (MovRegImm64 into RAX; LoadStack into RAX), which is why
            // the frozen return_value golden does not move.
            if (nodeType(rv) == NODE_INDEX()) {
                // The int-kind index goes through the shared integer expression
                // walker (the string-kind one was routed to the string path above
                // via natNativeValueKindOf).
                s = natEmitIntExpr(s, rv, plan, fns, binTemp, extrasBase, frame, 0, rctx)
            } else {
                let handledLen = 0
                if (nodeType(rv) == NODE_CALL()) {
                    // `len` is a driver builtin rather than a user function, so it is
                    // NOT routed through natEmitIntCall: that function lowers the call
                    // ABI, and `len` has no callee to call.
                    if (callFunc(rv) == "len") {
                        let rargs = callArgs(rv)
                        if (nodeType(rargs[0]) == NODE_CALL() && callFunc(rargs[0]) == "trim") {
                            // NAT-STRTRIM: `len(trim(s))` -- the trimmed length
                            // is the view pair's second unit.
                            s = natEmitTrim(s, callArgs(rargs[0])[0], fnStmts, plan, roffs, tbl, ictx)
                            s = natMovRegReg(s, natRegRAX(), natRegRSI())
                        } else {
                            let ordl = natNativeSlotIndex(plan, identName(rargs[0]))
                            s = natArrayLen(s, natNativeSlotOff(plan, ordl))
                        }
                        handledLen = 1
                    }
                }
                if (handledLen == 0) {
                    s = natEmitIntExpr(s, rv, plan, fns, binTemp, extrasBase, frame, 0, rctx)
                }
            }
            // Route the return through the single teardown the label marks, the
            // way the oracle does (program.go:4900: `b.e.Jmp(name + "$ret")`,
            // emitted by the ReturnStmt case of the statement walker, AFTER
            // emitReturn has put the value in RAX).
            //
            // The value is already in RAX and the jump preserves it, so the
            // epilogue that follows the label sees it unchanged. Emitting the
            // teardown inline at each return instead would be the same bytes
            // once, and would duplicate it as soon as a program had two returns
            // -- so this is not only about the missing 5 bytes.
            //
            // natJmp, NOT natCall32 + natRel32. That pairing is the `call`
            // idiom (0xE8) and the two differ by exactly one byte; Step 8e
            // records making this mistake once already, where a bare movabs
            // with no jump at all came out the other end.
            s = natJmp(s, retLabel)
            }
        }
        else {
        if (k == NODE_IF()) {
        // NAT-IF: the conditional branch, in the oracle's emitIf order
        // (program.go:5215-5231): the condition jumps to the ELSE label, the
        // consequence runs, an unconditional jump crosses to the END label, the
        // alternative runs, and the END label closes both.
        //
        // The oracle allocates the ELSE label FIRST and the END label second
        // (program.go:5216-5217), and an `if` with NO else still emits both --
        // the alternative is an empty statement list, so the two labels can
        // land on the same offset. That is reproduced rather than tidied.
        //
        // The label NAMES are kcc's own. The oracle's fresh() counter produces
        // different names for the same construct, and names do not reach the
        // bytes: a rel32 encodes a DISPLACEMENT, so only the ORDER and the
        // NUMBER of the emitted instructions can differ. What has to match is
        // the instruction sequence, and that is what this reproduces.
        //
        // The tag and the path make the names unique across the whole image.
        // The tag is the FUNCTION's label, because two functions may each have
        // an `if` at the same statement ordinal; the path is the statement's
        // position in the enclosing list, so a nested `if` cannot collide with
        // its parent. (The push() labels have the same hazard and are safe only
        // because a push is a `let`, which a branch cannot contain.)
        let sp = listPath + "." + str(i)
        let elseLabel = "nat$ifelse$" + tag + "$" + sp
        let endLabel = "nat$ifend$" + tag + "$" + sp
        s = natEmitCond(s, ifCond(n), plan, fns, binTemp, extrasBase, frame, elseLabel, rctx, strTemp, fnStmts, roffs, tbl, elseLabel)
        s = natNativeLower(s, ifCons(n), fnStmts, plan, roffs, tbl, rtErr, rtKindSlot, srcOff, srcLen, strIdxKindSlot, fns, lay, retLabel, tag, sp)
        s = natJmp(s, endLabel)
        s = natMark(s, elseLabel)
        s = natNativeLower(s, ifAlt(n), fnStmts, plan, roffs, tbl, rtErr, rtKindSlot, srcOff, srcLen, strIdxKindSlot, fns, lay, retLabel, tag, sp + "e")
        s = natMark(s, endLabel)
        }
        else {
        if (k == NODE_WHILE()) {
        // NAT-LOOP: a `while` loop, in the oracle's emitWhile order
        // (program.go:5234-5251):
        //
        //   loopLabel = fresh("while"); endLabel = fresh("whileend")
        //   Mark(loopLabel); push loops{brk:endLabel, cont:loopLabel}
        //   emitCond(cond, endLabel); body; pop
        //   Jmp(loopLabel); Mark(endLabel)
        //
        // The loop context is what makes `break` and `continue` mean the
        // NEAREST enclosing loop. For a `while`, `break` targets the loop's END
        // label and `continue` targets its HEAD, so a `continue` re-evaluates
        // the condition. That is the oracle's choice (program.go:5238) and it
        // is why a `continue` in a C-style `for` behaves differently -- there
        // the continue target is the POST label.
        let sp = listPath + "." + str(i)
        let loopLabel = "nat$while$" + tag + "$" + sp
        let endLabel = "nat$whileend$" + tag + "$" + sp
        s = natMark(s, loopLabel)
        s = natLoopPush(s, endLabel, loopLabel)
        s = natEmitCond(s, whileCond(n), plan, fns, binTemp, extrasBase, frame, endLabel, rctx, strTemp, fnStmts, roffs, tbl, endLabel)
        s = natNativeLower(s, whileBody(n), fnStmts, plan, roffs, tbl, rtErr, rtKindSlot, srcOff, srcLen, strIdxKindSlot, fns, lay, retLabel, tag, sp)
        s = natLoopPop(s)
        s = natJmp(s, loopLabel)
        s = natMark(s, endLabel)
        }
        else {
        if (k == NODE_FOR()) {
        // NAT-LOOP: a C-style `for`, in the oracle's emitFor order
        // (program.go:5256-5295):
        //
        //   init (inline, BEFORE any label)
        //   loopLabel = fresh("for"); postLabel = fresh("forpost"); endLabel = fresh("forend")
        //   Mark(loopLabel); push loops{brk:endLabel, cont:postLabel}
        //   cond (if present); body
        //   Mark(postLabel); post; pop
        //   Jmp(loopLabel); Mark(endLabel)
        //
        // Three facts in that order are load-bearing:
        //
        //  * The INIT is emitted BEFORE the loop's first label, so a `let` in
        //    the init runs ONCE and not once per iteration.
        //  * The POST is emitted at the post label, and the post label is ALSO
        //    the CONTINUE target -- so a `continue` in a `for` runs the update
        //    clause before the condition is evaluated again. That is the
        //    asymmetry with `while`, and it is the oracle's (program.go:5266).
        //  * The CONTINUE target of a `for` is the post label, NOT the head, so
        //    a `continue` skips the body but not the update.
        let sp = listPath + "." + str(i)
        let loopLabel = "nat$for$" + tag + "$" + sp
        let postLabel = "nat$forpost$" + tag + "$" + sp
        let endLabel = "nat$forend$" + tag + "$" + sp
        if (len(forInit(n)) > 0) {
        if (natNativeIsDecl(forInit(n))) {
        let idx = natNativeSlotIndex(plan, natNativeDeclName(forInit(n)))
        s = natEmitIntExpr(s, natNativeDeclValue(forInit(n)), plan, fns, binTemp, extrasBase, frame, 0, rctx)
        s = natNativeStoreLocal(s, plan, idx, natRegRAX())
        } else {
        s = natEmitAssignLocal(s, plan, binaryLeft(forInit(n)), binaryRight(forInit(n)), fns, binTemp, extrasBase, frame, rctx)
        }
        }
        s = natMark(s, loopLabel)
        s = natLoopPush(s, endLabel, postLabel)
        s = natEmitCond(s, forCond(n), plan, fns, binTemp, extrasBase, frame, endLabel, rctx, strTemp, fnStmts, roffs, tbl, endLabel)
        s = natNativeLower(s, forBody(n), fnStmts, plan, roffs, tbl, rtErr, rtKindSlot, srcOff, srcLen, strIdxKindSlot, fns, lay, retLabel, tag, sp)
        s = natMark(s, postLabel)
        if (len(forPost(n)) > 0) {
        s = natEmitAssignLocal(s, plan, binaryLeft(forPost(n)), binaryRight(forPost(n)), fns, binTemp, extrasBase, frame, rctx)
        }
        s = natLoopPop(s)
        s = natJmp(s, loopLabel)
        s = natMark(s, endLabel)
        }
        else {
        if (k == NODE_BREAK()) {
        // NAT-LOOP: `break` leaves the NEAREST enclosing loop. The oracle's
        // rule is `Jmp(b.loops[len(b.loops)-1].brk)` (program.go:4917), and the
        // scan has already refused a `break` with no loop to leave.
        s = natJmp(s, natLoopBrk(s))
        }
        else {
        if (k == NODE_CONTINUE()) {
        // NAT-LOOP: `continue` jumps to the innermost loop's continue target.
        // For a `while` that is the loop head (so the condition is evaluated
        // again); for a C-style `for` it is the post label (so the update runs
        // first). The oracle's rule is `Jmp(b.loops[len(b.loops)-1].cont)`
        // (program.go:4923).
        s = natJmp(s, natLoopCont(s))
        }
        else {
        if (natNativeIsAssignExpr(n)) {
        // NAT-LOOP: a bare `=` statement -- the shape a C-style `for`'s init
        // and post arrive in. It used to be refused by name (9h-2a) because
        // the loop was not lowered; now it is a supported statement.
        s = natEmitAssignLocal(s, plan, binaryLeft(n), binaryRight(n), fns, binTemp, extrasBase, frame, rctx)
        }
        }
        }
        }
        }
        }
        }
        }
        i = i + 1
    }
    return s
}

// natEmitAssignLocal lowers `x = <int expression>`.
//
// It is the oracle's emitExprStmt assignment path (program.go:4970-4981)
// without the register case: the oracle writes an allocated int local back to
// its register (Phase 150C), and this driver has no register allocator, so
// every local is a frame slot and the store is unconditional.
//
// The oracle's order is: evaluate the right-hand side into RAX, then store it
// to the slot. The right-hand side is evaluated at depth 0, which is what
// makes the operands stage in the same scratch slots the oracle's do.
func natEmitAssignLocal(s, plan, lhs, rhs, fns, binTemp, extrasBase, frame, rctx) {
    let ord = natNativeSlotIndex(plan, identName(lhs))
    s = natEmitIntExpr(s, rhs, plan, fns, binTemp, extrasBase, frame, 0, rctx)
    // NAT-REG: an allocated local is reassigned in its register; everything
    // else is stored to the frame slot, which is the pre-existing path.
    s = natNativeStoreLocal(s, plan, ord, natRegRAX())
    return s
}

// natNativeEmitFunc emits one function in the oracle's exact shape
// (pkg/native/program.go:4805-4873): label, frame prologue, parameter homing, body,
// implicit zero return, `$ret` label, frame teardown, ret.
//
// The frame is computed HERE, per function, from that function's own plan and its
// own maximum extras. That is not tidiness: the scratch regions (binTemp, extras) sit
// after the locals, so a function with more locals has different offsets for
// everything, and reusing main's layout for a callee would stage operands over the
// callee's own locals.
//
// `usesStrProg` is the PROGRAM-WIDE string flag, threaded in for the same reason
// `usesMapProg` is. The oracle's string staging area is reserved from
// program-wide flags and lands in EVERY function's layout (program.go:4454),
// so a per-function flag left a callee's frame 2560 bytes short whenever main
// did any string work at all -- measured on the Linux ELF target, where the
// Windows frame rounding cannot hide the difference.
//
// It is defined AFTER natNativeLower on purpose: this file is assembled and compiled
// in source order, so a function that CALLS another must be declared later than it
// (the Phase-133 "wrapper use-before-def" class). Every other definition here follows
// the same rule.
//
// `roffs` is the LITERALS' rodata offsets -- one entry per string literal the program
// binds or prints, in the collector's order (NAT-RODATA). It is not the whole rodata
// offset array: the linker owns the section's interning order, and the emitter only
// ever wants "the offset of the k-th literal".
func natNativeEmitFunc(s, name, params, body, plan, hasReturn, fns, roffs, tbl, rtErr, rtKindSlot, srcOff, srcLen, strIdxKindSlot, isWin, usesMapProg, usesStrProg) {
    // NAT-STR-STAGE: the string staging area is reserved when the PROGRAM
    // performs a string operation, not when this function does. The oracle's
    // `b.usesConcat || b.usesStrEq || b.usesStrSlice || b.usesPush ||
    // b.usesStrField` is a set of program-wide flags (program.go:4454) and its
    // layout reserves the area in every function, so a per-function flag made
    // every callee's frame short by natStrTempBytes().
    let usesStr = usesStrProg
    // NAT-FRAME: the map-stage slot is reserved when the PROGRAM uses a map,
    // not when this function does. The oracle's `b.usesMap` is program-wide
    // and its layout reserves the slot in every function, so a per-function
    // flag would make a callee's frame 8 bytes short whenever main indexed
    // something.
    let lay = natFrameLayout(natNativePlanBytes(plan), 0, usesStr, usesMapProg, natNativeMaxExtras(body, plan), isWin)
    let frame = lay[6]
    let label = natNativeFuncLabel(name)
    let retLabel = label + "$ret"
    // The string-lowering context: the argument walker needs the emitting
    // function's own body (for the literal collector) and its own roffs slice
    // to intern a literal passed DIRECTLY as an argument. Carried in the
    // emitter state rather than threaded, because the walker is shared.
    s = natSetNativeStringCtx(s, body, roffs)
    s = natMark(s, label)
    // NAT-REG: save the claimed callee-saved registers BEFORE the frame is
    // taken, so the frame's rsp-relative displacements stay unchanged, and
    // restore them after the frame is released.
    s = natNativeRegPush(s, plan)
    if (frame > 0) { s = natSubRegImm32(s, natRegRSP(), frame) }
    s = natNativeHomeParams(s, params, plan)
    s = natNativeLower(s, body, body, plan, roffs, tbl, rtErr, rtKindSlot, srcOff, srcLen, strIdxKindSlot, fns, lay, retLabel, label, "")
    if (hasReturn == 0) { s = natXorRegReg(s, natRegRAX()) }
    s = natMark(s, retLabel)
    if (frame > 0) { s = natAddRegImm32(s, natRegRSP(), frame) }
    s = natNativeRegPop(s, plan)
    return natRet(s)
}

// natNativeProgram compiles a PARSED PROGRAM to a native PE image.
//
// It returns [refusal, image]: refusal is "" on success, and image is then the
// bytes. The pair is deliberate rather than a bare return. Karkain cannot say
// "either a string or a byte array" without the caller having to guess which it
// got, and guessing is how a refusal gets hex-encoded and printed as though it
// were an image. Two slots removes the question.
//
// This is what the fixed `natPEProgram` is being replaced by, and the two share
// only the parts 9b already proved: the same `natWinStub` entry, the same
// `print_int` body, the same rodata interning and the same per-kind patch lists.
// What differs is where main's bytes come from -- here they come from the AST.
//
// The rodata list is ["-", "\n"] because the ONLY strings this driver can emit are
// print_int's own two, in first-use order. That is a property of the supported
// subset rather than an assumption about a particular program: a construct that
// would introduce another string is refused during the scan, before any emission.
// natNativeProgram compiles a PARSED PROGRAM to a native PE image. It is the
// Windows-only entry point and is retained so `karkain native-ast` and every
// frozen 151A Step 9c-9h gate keep driving exactly the code they were gated
// against. Increment A1 adds the Linux container and Phase B the macOS one,
// both behind natNativeProgramOS, which shares this whole body;
// `natNativeProgram` is a one-line wrapper naming the Windows target rather
// than a second copy of the driver.
func natNativeProgram(ast, useRegAlloc) {
    return natNativeProgramOS(ast, natOSWindows(), "", useRegAlloc)
}

// natNativeProgramOS compiles a PARSED PROGRAM to a native image for one OS.
//
// targetOS is the ONLY OS-dependent input: the entry stub, the frame's 16-byte
// alignment rule, the stdout write shape, the syscall numbers and the container
// writer all follow from it. That is the whole reason this is a parameter
// rather than three drivers -- there is exactly one copy of the
// scan/plan/lower sequence, so the three targets cannot disagree about a
// program's frame, its rodata interning or its refusals.
//
// The three container paths differ in ways that are NOT parameters, and the
// differences are load-bearing:
//
//   - PE (Windows) resolves its patches INSIDE the linker, because the loader
//     rebases a DYNAMIC_BASE image and each absolute slot needs a DIR64
//     relocation entry as well as a value. Getting that wrong produced a valid
//     PE whose print lost its newline (Step 9b).
//   - ELF (Linux) is non-PIE, so the values are baked in place BEFORE linking
//     and no relocation entry exists at all.
//   - Mach-O (macOS) is a PIE: like ELF the values are baked before linking, but
//     UNLIKE ELF dyld slides the image, so every baked absolute additionally
//     needs a REBASE OPCODE. Without one the image loads and then reads through
//     a pointer nobody slid -- no crash, no diagnostic, just wrong data.
//
// Calling natPELink for Linux (or vice versa) would not fail loudly; it would
// produce a PE under a Linux target NAME. That is a miscompile, so the container
// choice is made once, here, by the same targetOS that chose the stub.
func natNativeProgramOS(ast, targetOS, sourceBase, useRegAlloc) {
    let stmts = ast[1]
    let mainFn = natNativeFindMain(stmts)
    if (mainFn == 0) {
        return [natNativeRefuseNoLine("no `func main`; the native entry stub calls " +
            "karkain_main, so a `main` is required"), []]
    }
    let body = natNativeBodyStmts(mainFn)
  // Step 9h-1: record declarations live at PROGRAM top level, not in main's body, so
  // the layout table is built ONCE from the top-level statements and threaded into
  // the planner, the scanner and the lowering. Building it from the body found no
  // declarations at all and refused every record as an unknown type.
  let tbl = natStructTable(stmts)
    // NAT-CALL: the program is no longer one function. `fns` is every top-level
    // function declaration in SOURCE ORDER, which is the order the oracle emits them
    // in and therefore the order their labels must be assigned in -- `fresh()`
    // numbering is global, so emitting a helper for one function before another moves
    // every subsequent label displacement and breaks byte-identity.
    let fnp = natNativeFuncs(stmts)
    let fns = fnp[0]
    if (fnp[1] != "") {
        return [natNativeRefuseNoLine("call-site parameter kind mismatch across the program; " +
            "this build does not guess: " + fnp[1]), []]
    }
    let mainIdx = natNativeFuncIndex(fns, "main")
    if (mainIdx < 0) {
        return [natNativeRefuseNoLine("no `func main`; the native entry stub calls " +
            "karkain_main, so a `main` is required"), []]
    }
    let reach = natNativeReachable(fns)
    let mainParams = natNativeFuncParamsAt(fns, mainIdx)
    // A parameterised main has no caller to pass arguments, so the entry stub would
    // hand it whatever the kernel left in the argument registers. Refused by name
    // rather than mis-homed.
    if (len(mainParams) > 0) {
        return [natNativeRefuseNoLine("`main` must take no parameters on the native " +
            "target: the entry stub calls it with none"), []]
    }
    let scan = natNativeScanFor(mainParams, body, tbl, fns, 1, useRegAlloc, [])
    if (scan[0] != "") { return [scan[0], []] }
    let plan = scan[1]
    let mainHasReturn = scan[2]

    // The frame is DERIVED from the program's own bindings through the value model's
    // own layout pass, so a program with two locals gets a different frame from one
    // with one, and a program with an array gets a frame carrying that array's
    // element area. All three agree with the oracle's scanLets for the same program.
    //
    // NAT-CALL moves the layout PER FUNCTION (into natNativeEmitFunc): the scratch
    // regions sit after the locals, so a callee with a different locals region has a
    // different binTemp and extrasBase, and reusing main's would stage a callee's
    // operands over its own locals. What stays here is the part that is genuinely a
    // property of the PROGRAM rather than of a function -- whether a string path, an
    // arena or the runtime-error reporter exists at all.
    //
    // NAT-STR-STAGE: the string flag is one of those program-level properties, and
    // it is COMPUTED HERE, ONCE, and threaded into every function's layout -- the
    // same way the map flag is. The dead per-function copy that stood here (a
    // concat-site count and a push-site count over main's body) was computed twice,
    // read by nothing, and was the wrong scope anyway: the oracle's staging area
    // is reserved from PROGRAM-wide flags (program.go:4454) and lands in every
    // function's layout, so a callee's frame was 2560 bytes short whenever main
    // did any string work.
    // isWin is the BOOLEAN form of targetOS, for the two places that genuinely
    // only care about the Windows/Unix split: the frame's 16-byte alignment rule
    // and the stdout write SHAPE (Win64 kernel32 vs a raw syscall). Both treat
    // Linux and macOS identically -- neither pads the frame, and both reach the
    // kernel through a raw syscall whose NUMBER comes from the emitter state
    // (slot 15), not from here.
    let isWin = 0
    if (targetOS == natOSWindows()) { isWin = 1 }

    // Phase D5: the runtime-error reporter and its rodata.
    //
    // The gate is `natNativeUsesRuntimeError`, which must look INSIDE a
    // statement for an index rather than at the statement's own node type. An
    // earlier version compared only `nodeType(n) == NODE_INDEX()`, which never
    // fires for the shape the gate exists to catch: `print(a[1])` is a
    // NODE_PRINT whose ARGUMENT is the index. The gate returned 0, the reporter
    // was never emitted, and the lowering still recorded a reference to
    // `karkain_runtime_error` -- an undefined label. That looked like the port
    // simply had no effect, and it is the "a gate that can pass without checking
    // anything" failure the evidence discipline warns about.
    //
    // NAT-RODATA: the rodata INPUT list is built in the ORACLE'S INTERNING
    // ORDER, which is its EMISSION order, because the oracle interns by FIRST
    // USE as it emits (pkg/native/program.go:2136-2144: a map from the
    // string's CONTENT to the offset it was interned at, and the offset is
    // assigned at the moment of the first use). The order is:
    //
    //   1. print_int's own two strings ("-", "\n") -- print_int is the first
    //      helper in both engines (program.go:2475-2481).
    //   2. the runtime-error REPORTER HELPER's four strings -- the helper is
    //      emitted BEFORE the user function in both engines (program.go:2519
    //      against the driver's own helper order), so the oracle interns them
    //      before any of the program's own literals.
    //   3. the PROGRAM's own literals, in source order.
    //   4. the CALL SITE's two strings -- "array index out of range" and the
    //      source basename -- which the oracle interns at the first index
    //      site, inside the user function.
    //
    // The list used to put (2) and (4) AFTER (3), which is NOT the oracle's
    // order: the driver's own comment claimed the oracle's order and the code
    // did not do it, which is why it was a defect and not a design choice.
    // Measured: a program with a reporter AND a string literal had 31
    // differing bytes and a different rodata layout.
    //
    // The offsets are read back OUT of natRodataSection's offset array, which
    // is the D5 baseline's stated rule (PHASE-D5-BASELINE.md section 8.3) and
    // the only thing that can be correct when a duplicate is interned: a LIST
    // POSITION is not an OFFSET.
    let usesRtErr = 0
    if (natNativeUsesRuntimeError(body) == 1) { usesRtErr = 1 }
    // The reporter is needed when an INDEX exists ANYWHERE in the program --
    // and since every callee can carry one, the gate must look at every
    // function, not at main's body alone. The callee-side counterpart of the
    // missing-reporter refusal was a crash in the PE linker (the bounds
    // check's failure block calls karkain_runtime_error, which was never
    // emitted, and the recorded rodata reference landed past the interned
    // list). This is the same rule NAT-STR-STAGE applied to the string staging
    // area and NAT-FRAME to the map-stage slot: a PROGRAM-wide flag for a
    // PROGRAM-wide contract, computed over every function.
    if (usesRtErr == 0) {
        let fi = 0
        while (fi < natNativeFuncCount(fns)) {
            if (natNativeFuncNameAt(fns, fi) != "main") {
                if (natNativeUsesRuntimeError(natNativeFuncBodyAt(fns, fi)) == 1) {
                    usesRtErr = 1
                }
            }
            fi = fi + 1
        }
    }
    // NAT-STRIDX: the string-index kind string is interned only when a string
    // byte index actually exists, so a program whose indexes are ALL over
    // arrays produces the SAME bytes as before this increment (the frozen
    // NAT-IDX gate pins that byte-identity). Detection is plan-based -- the
    // same predicate the emission dispatch uses -- and re-scans each callee
    // exactly the way the arena accounting does.
    let usesStrIdx = 0
    if (natNativeUsesStringIndex(body, plan) == 1) { usesStrIdx = 1 }
    if (usesStrIdx == 0) {
        let fiS = 0
        while (fiS < natNativeFuncCount(fns)) {
            if (natNativeFuncNameAt(fns, fiS) != "main") {
                let fiBodyS = natNativeFuncBodyAt(fns, fiS)
                let fsS = natNativeScanFor(natNativeFuncParamsAt(fns, fiS), fiBodyS, tbl, fns, 0, useRegAlloc, natNativeFuncKindsAt(fns, fiS))
                if (fsS[0] == "") {
                    if (natNativeUsesStringIndex(fiBodyS, fsS[1]) == 1) { usesStrIdx = 1 }
                }
            }
            fiS = fiS + 1
        }
    }
    // Program-wide literal collection, in EMISSION order (fi order, which is
    // function source order), over EXACTLY the functions the emitter will
    // emit. This mirrors the emission loop's skip decision: main always;
    // a callee that cannot be lowered is emitted only when it is reachable,
    // which is also the case where this build aborts without emitting.
    //
    // Per-function slices are built from this ONE list in the same order, so
    // every function's `sidx` cursor starts at 0 into its own slice and the
    // collector/emitter stay in lockstep. Concatenation/push sites inside
    // callees are accounted for the same way in the arena bound below.
    let lits = []
    let lf = 0
    while (lf < natNativeFuncCount(fns)) {
        let flemit = 0
        if (natNativeFuncNameAt(fns, lf) == "main") {
            flemit = 1
        } else {
            let fs = natNativeScanFor(natNativeFuncParamsAt(fns, lf),
                natNativeFuncBodyAt(fns, lf), tbl, fns, 0, useRegAlloc,
                natNativeFuncKindsAt(fns, lf))
            if (fs[0] == "" || reach[lf] == 1) { flemit = 1 }
        }
        if (flemit == 1) {
            let fl2 = natNativeStrLiterals(natNativeFuncBodyAt(fns, lf))
            let fj = 0
            while (fj < len(fl2)) {
                lits = appendArray(lits, fl2[fj])
                fj = fj + 1
            }
        }
        lf = lf + 1
    }
    let strs = ["-", "\n"]
    // litBase is the list position of the first literal.
    let litBase = 2
    if (usesRtErr == 1) {
        strs = appendArray(strs, "runtime error: ")
        strs = appendArray(strs, " at ")
        strs = appendArray(strs, ":")
        strs = appendArray(strs, "\n")
        litBase = 6
    }
    let li = 0
    while (li < len(lits)) {
        strs = appendArray(strs, lits[li])
        li = li + 1
    }
    // callBase is the list position of the call site's first string.
    let callBase = litBase + len(lits)
    let rtKindSlot = 0
    let srcOff = 0
    let srcLen = 0
    let strIdxKindSlot = 0
    let rtErr = []
    if (usesRtErr == 1) {
        strs = appendArray(strs, "array index out of range")
        // The source basename goes through the SAME interning list rather than
        // being special-cased, so `file:line` is genuine and the offset comes
        // from the same mechanism as every other string.
        strs = appendArray(strs, sourceBase)
        srcLen = len(sourceBase)
        // NAT-STRIDX: the string index bounds-check calls the same reporter with
        // its own kind string, interned at the SAME call site so the two kinds
        // travel together -- and ONLY when a string index exists, so a program
        // whose indexes are all over arrays produces the same bytes as before
        // this increment. The cost of the append is 25 bytes of rodata, paid
        // only by images that can reach the string-index arm.
        if (usesStrIdx == 1) {
            strs = appendArray(strs, "string index out of range")
        }
    }
    let ro = natRodataSection(strs)
    // The reporter's OWN four strings, read back OUT of the section's offset
    // array rather than assumed -- the D5 baseline's section 8.3 risk. rtErr[k]
    // is the offset of the k-th reporter string in the interned section.
    //
    // The CALL SITE's two are read back the same way, and they used to be the
    // LIST POSITIONS 2 + len(lits) + 4 and + 5. A position counts ENTRIES and
    // an offset counts BYTES, and the two differ as soon as any earlier string
    // is longer than one byte -- which every one of them is. The symptom was
    // the out-of-range diagnostic pointing at the WRONG BYTES: at offsets 6
    // and 7 of the section, which are the middle of "runtime error: ", instead
    // of at "array index out of range" and the file name. The two absolute
    // addresses in the image therefore differed from the oracle's by 16 and 39
    // bytes, and the NAT-FRAME record read that as an ORDER difference.
    if (usesRtErr == 1) {
        let rk = 0
        while (rk < 4) {
            rtErr = appendArray(rtErr, ro[1][2 + rk])
            rk = rk + 1
        }
        rtKindSlot = ro[1][callBase]
        srcOff = ro[1][callBase + 1]
        if (usesStrIdx == 1) {
            strIdxKindSlot = ro[1][callBase + 2]
        }
    }
    // The EMITTER gets the LITERALS' offsets and nothing else.
    //
    // It used to get the whole offset array and start its cursor at 2, which
    // coupled the emitter's cursor to the INTERNING ORDER: the cursor's start
    // depended on how many non-literal entries preceded the literals, so
    // moving the reporter's strings moved every literal's offset and with it
    // the cursor. Two lists, two jobs: the linker wants the whole section in
    // the oracle's interning order, and the emitter wants the k-th literal's
    // offset. Handing the emitter exactly that decouples them, so the interning
    // order can follow the oracle's without the lowering knowing anything
    // about it.
    let roffs = []
    let ok = 0
    while (ok < len(lits)) {
        roffs = appendArray(roffs, ro[1][litBase + ok])
        ok = ok + 1
    }
    // The entry stub is OS-specific and nothing else is: all three Mark
    // `_start` first and Mark `karkain_main` last, so every label displacement
    // the body and the helpers encode is identical between them. That is what
    // lets ONE driver serve all three targets.
    // EMISSION ORDER matches the oracle exactly, and that is what makes byte-identity
    // reachable rather than merely aspirational. The oracle runs
    // emitHelpers(), then the user functions, then `_start`
    // (pkg/native/program.go:1585-1593), so `_start` lands at the END of .text
    // and `karkain_main` sits before it.
    //
    // This order was MEASURED, not assumed: for a one-statement main that prints a
    // literal, the Go image puts `_start` at .text offset 214 and kcc put it at
    // 0, giving a CONSTANT 39-byte delta across programs with 0, 1 and 2
    // locals. A constant delta cannot be frame padding -- padding scales with
    // the locals region -- and the difference was therefore the ORDER, not the
    // layout. The previous record attributed it to padding; that attribution
    // was wrong and is corrected here.
    //
    // (The example program is described rather than quoted on purpose:
    // assembleProject decides which sibling file "has a main" by searching the
    // source TEXT for the literal signature, so quoting that signature in a
    // comment here made THIS file look like the entry point, and the sibling
    // join then silently dropped every other compiler source. It surfaced as a
    // 2512-line collapse of the whole-tree KIR count plus a wall of
    // undefined-function errors -- an assembler behaviour, not a compiler one.)
    //
    // The helpers come first because the body CALLS them, and the oracle emits
    // them first for the same reason. rel32 fixups resolve against label offsets
    // in natFinish, so order is free at emission time and costs nothing: only the
    // final byte layout is affected.
    let s = natNewEmitter(0)
    s = natSetTargetOS(s, targetOS)
    // NAT-FRAME: the map-stage flag is a property of the WHOLE PROGRAM, as it
    // is in the oracle (`b.usesMap` comes from scanMapUsage over the program,
    // program.go:1571), and the oracle's per-function layout reserves the slot
    // in EVERY function when it is set. Computing it here, once, and threading
    // it into every function's layout is what reproduces that.
    let usesMapProg = natNativeProgramUsesMap(body, fns)
    // NAT-STR-STAGE: the string flag is a program-wide property for the same
    // reason the map flag is. The oracle's five string flags (program.go:4454)
    // are all properties of the WHOLE program, and its layout reserves the
    // staging area in every function when any of them is set. So the flag is
    // computed once, over every function, and threaded into every function's
    // layout -- exactly as the map flag is.
    let usesStrProg = natNativeProgramUsesStr(fns, tbl)
    // helpers first: print_int, then print_str when the program can produce a
    // string, then the arena allocator when it allocates.
    s = natPrintIntBody(s, isWin, 0, 1)
    // print_str is emitted UNCONDITIONALLY, because the oracle emits it as part of
    // the standard helper set (pkg/native/program.go:2475-2481) and it is present
    // in every image, including one whose program never prints a string.
    //
    // It used to be gated on the program using strings, with the stated reason
    // that gating "keeps every string-free image byte-identical". That reason was
    // circular: byte-identical TO WHAT? Measured against the oracle, the gating is
    // precisely what made every string-free image DIFFER, by the 41 bytes of
    // print_str. So the gate was optimizing against an invented baseline rather
    // than the one parity is measured against.
    s = natPrintStrBody(s, isWin, 1)
    // Program-wide arena bound. A callee that concatenates or pushes allocates
    // from the same arena as main, and main's plan cannot describe a callee's
    // slots, so each function's sites are counted against ITS plan and summed.
    // Over-allocation is the safe direction for a bump allocator; the floor is
    // re-applied once on the total.
    let arenaLen = 0
    let afe = 0
    while (afe < natNativeFuncCount(fns)) {
        let fbodyA = natNativeFuncBodyAt(fns, afe)
        let plA = plan
        if (natNativeFuncNameAt(fns, afe) != "main") {
            let fscanA = natNativeScanFor(natNativeFuncParamsAt(fns, afe), fbodyA, tbl, fns, 0, useRegAlloc, natNativeFuncKindsAt(fns, afe))
            plA = fscanA[1]
            if (fscanA[0] != "" && reach[afe] != 1) {
                afe = afe + 1
                continue
            }
        }
        arenaLen = arenaLen + natNativeArenaBytes(fbodyA, plA)
        afe = afe + 1
    }
    if (arenaLen > 0) {
        s = natAllocHelper(s, arenaLen)
    }
    // The map runtime, on the oracle's syntactic predicate rather than on the
    // program's actual needs -- see natMapFind's header and the D5 baseline ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â§3.1.
    // Order matters: emitHelpers runs print_int, print_str, [print_float],
    // [alloc], map, runtime_error (program.go:2497-2520), and the map helpers
    // call alloc, so they must come after it.
    //
    // The flag is the SAME `usesMapProg` the layout uses, read from the variable
    // rather than recomputed: two call sites of one computation are exactly the
    // shape that let Step 9g's two literal collectors disagree, and the map
    // helpers must be emitted under PRECISELY the condition that reserves the
    // map-stage slot.
    if (usesMapProg == 1) {
        s = natMapFind(s)
        s = natMapSet(s)
        s = natMapGet(s)
    }
    // ... and LAST among the helpers, the Phase-152-B0 runtime-error reporter,
    // only when the program can raise a diagnostic.
    //
    // The ORDER is the oracle's (program.go:2497-2520): print_int, print_str,
    // [print_float], [alloc], [map], runtime_error. Placing it before the
    // allocator would reorder .text and move every baked address after it.
    if (usesRtErr == 1) {
        s = natRuntimeErrorHelper(s, rtErr, isWin)
    }
    // Then the user functions, in SOURCE ORDER, each in the oracle's own shape: a
    // label, a frame prologue, parameter homing, the body, the `$ret` label, the
    // epilogue.
    //
    // NAT-CALL scans and emits in ONE pass. That is deliberate rather than merely
    // compact: a scan that ran over the whole program first would have to build a
    // plan per function anyway, and a mid-loop refusal DISCARDS the partial emitter
    // (the caller writes nothing unless the image comes back valid), so there is no
    // state to unwind. Every function is scanned with `isMain` set only for main, so
    // the callee subset and main's frozen arms cannot be confused.
    //
    // MAIN IS NOT SPECIAL-CASED ANY MORE: it is emitted by the same call, which is
    // what keeps its shape -- and therefore its bytes -- identical to the oracle's
    // emitFunc rather than a second implementation that happens to agree.
    let fi = 0
    let sbase = 0
    let okfn = []
    while (fi < natNativeFuncCount(fns)) {
        let fname = natNativeFuncNameAt(fns, fi)
        let fparams = natNativeFuncParamsAt(fns, fi)
        let fbody = natNativeFuncBodyAt(fns, fi)
        let fisMain = 0
        if (fname == "main") { fisMain = 1 }
        if (fisMain == 1) {
            okfn = appendArray(okfn, 1)
            fi = fi + 1
            continue
        }
        // A callee's own plan and return flag. A REACHABLE callee that cannot be
        // lowered aborts the WHOLE program: a half-emitted image is not a build
        // with a warning, it is an image whose missing function is a link-time
        // surprise. An UNREACHABLE callee that cannot be lowered is skipped
        // instead (see natNativeReachable) ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â the program never calls it, so
        // nothing reaches the missing label.
        let fscan = natNativeScanFor(fparams, fbody, tbl, fns, 0, useRegAlloc, natNativeFuncKindsAt(fns, fi))
        if (fscan[0] != "") {
            if (reach[fi] == 1) { return [fscan[0], []] }
            okfn = appendArray(okfn, 0)
        } else {
            okfn = appendArray(okfn, 1)
        }
        fi = fi + 1
    }
    fi = 0
    while (fi < natNativeFuncCount(fns)) {
        let fname = natNativeFuncNameAt(fns, fi)
        let fparams = natNativeFuncParamsAt(fns, fi)
        let fbody = natNativeFuncBodyAt(fns, fi)
        let fisMain = 0
        if (fname == "main") { fisMain = 1 }
        // Dead, unsupported: skipped entirely rather than emitted broken. A
        // caller reaching this label is impossible (it would have been
        // reachable), which is exactly what natNativeReachable computed.
        if (fisMain == 0 && okfn[fi] == 0 && reach[fi] == 0) {
            fi = fi + 1
            continue
        }
        let fplan = plan
        let fhasReturn = mainHasReturn
        // This function's own literal slice, in the same order the global
        // collection walked them, so its `sidx` cursor starts at 0 into ITS
        // slice. A callee that binds a literal must not consume main's.
        let sroffs = []
        if (okfn[fi] == 1) {
            let mylits = natNativeStrLiterals(fbody)
            let j2 = 0
            while (j2 < len(mylits)) { sroffs = appendArray(sroffs, roffs[sbase + j2]); j2 = j2 + 1 }
            sbase = sbase + len(mylits)
        }
        if (fisMain == 0) {
            let fscan = natNativeScanFor(fparams, fbody, tbl, fns, 0, useRegAlloc, natNativeFuncKindsAt(fns, fi))
            fplan = fscan[1]
            fhasReturn = fscan[2]
        }
        s = natNativeEmitFunc(s, fname, fparams, fbody, fplan, fhasReturn, fns,
            sroffs, tbl, rtErr, rtKindSlot, srcOff, srcLen, strIdxKindSlot, isWin, usesMapProg,
            usesStrProg)
        fi = fi + 1
    }
    // and `_start` LAST, calling into `karkain_main`.
    if (isWin == 1) {
        s = natWinEntry(s)
    } else {
        s = natStartEntryOS(s, targetOS)
    }
    // The entry is `_start`'s offset WITHIN .text, read from the label table
    // after it is marked. It must be read AFTER the entry sequence is emitted,
    // because that is what fixes the label's offset -- reading it before would
    // capture a placeholder.
    let entryOff = natLabelOff(s, "_start")
    let text = natFinish(s)

    // The rodata patch list is what makes the linker resolve the immediates AND
    // give each one a DIR64 entry. Passing an empty list is the Step 9b defect
    // this slice inherits: the immediates keep the preferred base on a rebasing
    // host and the print silently loses its newline.
    let rp = natFlatPairs(natStRodataPos(s), natStRodataOff(s))
    let ap = natFlatPairs(natStAbsPos(s), natStAbsIdx(s))
    let ip = natFlatPairs(natStIatPos(s), natStIatIdx(s))
    // The arena rides inside .idata via the 151C3 plumbing: it is the heap argument
    // and absolute arena pointers are flat [pos, off] hpatches pairs -- the SAME
    // mechanism, not a second one. Both stay EMPTY for a program that does not
    // allocate, which is what keeps every string-free image byte-identical.
    let heap = []
    if (arenaLen > 0) { heap = natNativeArenaBytes0(arenaLen) }
    let hp = natFlatPairs(natStHeapPos(s), natStHeapOff(s))

    if (targetOS == natOSWindows()) {
        // The PE entry follows the same rule as ELF and Mach-O: it is the
        // FILE offset of `_start`, which is natPETextOff() + the label's offset
        // within .text. It was previously hardcoded to natPETextOff(), which was
        // correct only while `_start` was emitted first. It is passed as a FILE
        // offset for the same reason the other two are -- the loader compares it
        // against BaseOfCode.
        return ["", natPELink(text, ro[0], heap, rp, ip, ap, hp, natPETextOff(), natPETextOff() + entryOff)]
    }
    if (targetOS == natOSMac()) {
        return ["", natNativeLinkMac(s, text, ro[0], heap, rp, hp, entryOff)]
    }
    return ["", natNativeLinkLinux(s, text, ro[0], heap, entryOff)]
}

// natNativeLinkMac links the macOS image: a position-independent executable
// whose baked absolute addresses dyld slides at load time.
//
// Mach-O is the third shape of the three, and the distinction is what this
// function exists to get right:
//
//   - PE  (Windows): resolved INSIDE the linker, because a DYNAMIC_BASE image is
//     rebased and each absolute needs a DIR64 ENTRY as well as a value.
//   - ELF (Linux): resolved before linking, no relocation entries -- ET_EXEC at a
//     fixed base is never moved.
//   - Mach-O (macOS): resolved before linking like ELF, BUT the image is a PIE
//     (MH_PIE), so dyld DOES move it. Every baked absolute therefore needs a
//     REBASE OPCODE telling dyld to add the slide to it, or the image loads
//     cleanly and then dereferences a pointer nobody slid -- a failure mode that
//     is not a crash and not a diagnostic, just wrong data.
//
// So the rebase sites are not an optional extra here; they are what makes the
// resolved values correct. They are DERIVED from the same two patch lists the
// addresses were resolved from (rodata rp and the arena hp), which is what makes
// a missed site structurally impossible rather than merely unlikely -- the
// oracle does the same at pkg/native/program.go:1702 (machoRebaseSiteOffsets),
// for the reason its comment gives: a hand-kept inventory of "the places we bake
// an address" is a second source of truth that can silently miss one.
func natNativeLinkMac(s, text, rodata, heap, rp, hp, entryOff) {
    let hasData = false
    if (len(heap) > 0) { hasData = true }
    let textOff = natMachoTextOffset(hasData)
    let base = natMachoBase()
    // Same base arithmetic as ELF, read from the oracle: rodata follows .text,
    // and the arena's absolute address is machoAddr(MachoDataOffset(bodyEnd)),
    // i.e. MachoBase + the page-aligned offset -- the +natMachoBase() is what
    // makes it an ADDRESS rather than a file offset, and dropping it would bake
    // an offset where dyld expects an address.
    natResolveRodata(s, base, textOff + len(text))
    let bodyEnd = textOff + len(text) + len(rodata)
    natResolveArena(s, base + natMachoDataOffset(bodyEnd))
    // The rebase sites are the union of both patch lists' positions.
    let sites = natFlatPositions(rp, hp)
    // The entry is `_start`'s real offset within .text, not textOff, for the
    // same reason the ELF arm uses entryOff: the entry sequence is emitted
    // LAST, matching the oracle's order.
    return natMachoLink(text, rodata, heap, textOff, textOff + entryOff, sites)
}

// natFlatPositions returns the POSITION half of two flat [pos, off] pair-lists
// concatenated: entry 0 of each pair-list, in list order.
//
// It reads the pairs the addresses were resolved from rather than keeping its
// own inventory, so a site cannot be added to the patch lists and forgotten
// here. The rebase stream addresses every one of these by dyld.
func natFlatPositions(rp, hp) {
    let out = []
    let i = 0
    while (i < len(rp)) {
        if (i % 2 == 0) { out = appendArray(out, rp[i]) }
        i = i + 1
    }
    i = 0
    while (i < len(hp)) {
        if (i % 2 == 0) { out = appendArray(out, hp[i]) }
        i = i + 1
    }
    return out
}

// natNativeLinkLinux resolves the non-PIE ELF's absolute addresses and links the
// image. It is the ELF counterpart of the natPELink call above, and the two
// differ in WHERE the patches are applied:
//
//   - PE: natPELink writes each immediate AND adds a DIR64 relocation entry,
//     because a PE carrying DYNAMIC_BASE is rebased by the loader and a baked
//     absolute is stale. Step 9b shipped the missing-entry defect: a structurally
//     valid PE that printed its digits and silently lost its newline.
//   - ELF: ET_EXEC at a fixed base, never rebased, so no relocation entry exists
//     and the value is simply written where it belongs.
//
// The arithmetic below is the oracle's, read from pkg/native/program.go:1650-1683
// rather than re-derived:
//
//	roBase   = BaseAddr + textOff + len(text)
//	heapBase = BaseAddr + alignUp(bodyEnd, 0x1000)
//	bodyEnd  = textOff + len(text) + len(rodata)
//
// textOff depends on whether a data segment follows, because ELF's program
// header COUNT does: one PT_LOAD for a heapless program, two for one with an
// arena. That is the same rule natELFLink enforces, so the two are computed from
// one expression rather than restated.
func natNativeLinkLinux(s, text, rodata, heap, entryOff) {
    let phnum = 1
    if (len(heap) > 0) { phnum = 2 }
    let textOff = natEhSize() + natPhSize() * phnum
    // The rodata sites are resolved first because natResolveRodata writes into
    // the emitter's own byte buffer in place; the heap sites then need the SAME
    // buffer, so both must run before natFinish copies it out.
    natResolveRodata(s, natBaseAddr(), textOff + len(text))
    let bodyEnd = textOff + len(text) + len(rodata)
    let heapBase = natBaseAddr() + natAlignUp(bodyEnd, natPage())
    natResolveArena(s, heapBase)
    // natELFLink returns a diagnostic STRING on its one failure condition -- a
    // textOffset it does not expect -- and a byte array otherwise. That refusal
    // is unreachable here by construction rather than by a runtime type test:
    // textOff above is computed from natEhSize() + natPhSize()*phnum with
    // phnum derived from len(heap), which is exactly the expression
    // natELFLink validates against, so the two agree by arithmetic and not by
    // coincidence. It is stated because Step 9b shipped the mistake of handing a
    // linker error STRING back as if it were an image.
    //
    // The ENTRY is `_start`'s real label offset, NOT textOff. The oracle's entry
    // is `textOff + b.e.labels["_start"]` (pkg/native/program.go:1643), and since
    // the helpers and the user function are emitted BEFORE `_start` that offset
    // is not zero. Passing textOff here assumed `_start` was the first byte --
    // true while the stub was emitted first, false once the emission order
    // matched the oracle. The image was still STRUCTURALLY VALID and still
    // executed, because an entry inside .text is accepted; it just entered
    // print_int's helper instead of the entry stub.
    return natELFLink(text, rodata, heap, textOff, textOff + entryOff)
}

// natResolveArena writes the arena's absolute addresses into the emitted bytes,
// mirroring natResolveRodata for the heap patch list (emitter slots 13/14).
//
// It is a separate function rather than a shared one with a kind parameter
// because the two lists are flat [pos, off] pairs in DIFFERENT emitter slots,
// and threading that difference through one routine would mean passing both slot
// numbers into it -- which is how the two lists get crossed.
func natResolveArena(s, base) {
    let n = 0
    let i = 0
    while (i < len(s[13])) {
        let pos = s[13][i]
        let off = s[14][i]
        let av = base + off
        let code = natStCode(s)
        code[pos] = av & 255
        code[pos + 1] = (av >> 8) & 255
        code[pos + 2] = (av >> 16) & 255
        code[pos + 3] = (av >> 24) & 255
        code[pos + 4] = (av >> 32) & 255
        code[pos + 5] = (av >> 40) & 255
        code[pos + 6] = (av >> 48) & 255
        code[pos + 7] = (av >> 56) & 255
        n = n + 1
        i = i + 1
    }
    return n
}

// ============================================================
// Phase 151A Step 9g -- the arena allocator and string concatenation.
// Port of the oracle's emitAllocHelper / emitByteCopy / emitStrConcat.
// ============================================================

func natHeapRef(s, r, heapOff) {
    // This does NOT reuse natImm64Patch, and the reason is the crash it used to cause.
    //
    // natMovImm64Op(rd) = 184 + rd, which is correct only for rax..rdi (0..7). For R10
    // it produced 0xC2 and for R11 **0xC3 -- which is the `ret` opcode**. So the arena
    // base/limit were emitted as `48 C3 00 00 00 00 00 00 00 00`: a spurious `ret` in the
    // middle of `alloc` followed by eight zero bytes that the CPU then decoded as
    // instructions.
    //
    // That fault produced a STRUCTURALLY VALID PE -- the linker does not check opcode
    // semantics -- which ran and then died with 0xC0000005. It is exactly the class of
    // defect this slice's gates exist to catch, and it is why an invalid opcode must be
    // read off the emitted bytes rather than assumed from the call site.
    //
    // REX.W + REX.B (0x49) carries the high register, and the opcode base is
    // B8 + (rd & 7).
    let rex = natMask(13) | natMask(14)          // 0x40 | 0x08 = 0x48, REX.W
    if (natRegExt(r) == 1) { rex = rex | natMask(16) }   // REX.B for r8-r15
    s = natByte(s, rex)
    s = natByte(s, natMask(11) + (r & natMask(72)))     // 0xB8 + (rd & 7)
    let pos = natLen(s)
    let i = 0
    while (i < 8) {
        s = natByte(s, 0)
        i = i + 1
    }
    s[13] = appendArray(s[13], pos)
    s[14] = appendArray(s[14], heapOff)
    return s
}

func natStoreBaseOff(s, val, base, off) {
    let r = natMask(13) | natMask(14)
    if (natRegExt(val) == 1) { r = r | natMask(15) }
    if (natRegExt(base) == 1) { r = r | natMask(16) }
    s = natByte(s, r)
    s = natByte(s, natMask(18))
    return natMemBaseOff(s, val, base, off)
}

// R10 = arena base, R11 = arena end (link-time imm64 patches).
// [R10+0] cursor, [R10+8] limit. RDI = request, RAX = block start.
//
// The header lives INSIDE the arena, so no global and no writable image text is
// needed. The cursor SELF-INITIALISES: it is zero in the image and zero is the
// "not started" sentinel, so the first call sets it to arena+16 and stores it.
//
// Exhaustion is `ja` -- UNSIGNED above, so it also catches wraparound on an absurd
// request. A signed compare would miss that and return a block overlapping live bytes.
func natAllocHelper(s, heapLimitOff) {
    s = natMark(s, "alloc")
    s = natHeapRef(s, natRegR10(), 0)
    s = natHeapRef(s, natRegR11(), heapLimitOff)
    s = natLoadBaseOff(s, natRegRAX(), natRegR10(), 0)
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "alloc$have")
    s = natMovRegReg(s, natRegRAX(), natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 16)
    s = natStoreBaseOff(s, natRegRAX(), natRegR10(), 0)
    s = natMark(s, "alloc$have")
    s = natMovRegReg(s, natRegRCX(), natRegRDI())
    s = natAddRegReg(s, natRegRCX(), natRegRAX())
    s = natCmpRegReg(s, natRegRCX(), natRegR11())
    s = natJa(s, "alloc$oom")
    s = natStoreBaseOff(s, natRegRCX(), natRegR10(), 0)
    s = natJmp(s, "alloc$done")
    s = natMark(s, "alloc$oom")
    s = natInt3(s)
    s = natMark(s, "alloc$done")
    return natRet(s)
}

// `n` is a RUNTIME value, so the count lives in a register and this is a real loop.
// `tag` makes the labels unique per call site: the concat emits this twice per site and
// kcc has no fresh() counter, so two copies of one label would be Marked twice and
// natFinish refuses a duplicate label.
func natByteCopy(s, dst, src, n, tag) {
    let loopLbl = "cp" + str(tag) + "$loop"
    let doneLbl = "cp" + str(tag) + "$done"
    s = natXorRegReg(s, natRegRDX())
    s = natMark(s, loopLbl)
    s = natCmpRegReg(s, natRegRDX(), n)
    s = natJae(s, doneLbl)
    s = natLoadScaled8(s, natRegRBX(), src, natRegRDX(), 1, 0)
    s = natStoreScaled8(s, natRegRBX(), dst, natRegRDX(), 1, 0)
    s = natIncReg(s, natRegRDX())
    s = natJmp(s, loopLbl)
    s = natMark(s, doneLbl)
    return s
}

func natCallAlloc(s) {
    // The Win64 stack alignment, exactly as for the print call sites: required
    // on Windows (whose `_start` runs `and rsp, -16`), and NOT on Linux/macOS
    // (whose `_start` does not), where it would misalign `alloc`'s frame. The
    // oracle's alloc call site carries no compensating sub
    // (pkg/native/program.go:2467 and the concat path beside it).
    if (natStTargetOS(s) == natOSWindows()) {
        s = natSubRegImm32(s, natRegRSP(), 8)
    }
    s = natCall32(s)
    let r = natRel32(s, "alloc")
    s = r[0]
    if (natStTargetOS(s) == natOSWindows()) {
        s = natAddRegImm32(s, natRegRSP(), 8)
    }
    return s
}

// natRodataSection returns one offset per INPUT entry with first-use interning, so the
// k-th literal in the program is entry 2+k (0 and 1 are print_int's "-" and "\n").
// The FIRST match is used, so a repeated literal resolves to the one copy interned.
//
// NAT-RODATA: `roffs` is now the LITERALS' offset list -- one entry per literal, in
// the collector's order -- so the k-th literal is entry k and the "+2" is gone. The
// list used to be the WHOLE offset array, which coupled this lookup to the
// interning order: the literals' positions depended on how many non-literal
// entries came before them.
func natRodataOffsetFor(val, stmts, roffs) {
    let lits = natNativeStrLiterals(stmts)
    let i = 0
    while (i < len(lits)) {
        if (lits[i] == val) { return roffs[i] }
        i = i + 1
    }
    return 0
}

// NAT-STRIDX: `ictx` is the int-expression evaluation context bundled by the
// caller ([fns, binTemp, extrasBase, frame, rctx]). It exists because a string
// byte index's index is an ordinary int expression and lowering it needs the
// same walker the int path uses; threading the five pieces individually would
// make this signature unmanageable and would drift at exactly the one caller
// that rebuilds the pair.
func natEmitStrValue(s, expr, stmts, plan, roffs, tbl, ictx) {
  // NAT-STRTRIM: `trim(s)` -- a non-allocating view of the source bytes,
  // available in every string position (print, concat, let binding, return,
  // len, nested trim).
  if (nodeType(expr) == NODE_CALL()) {
      if (callFunc(expr) == "trim") {
          return natEmitTrim(s, callArgs(expr)[0], stmts, plan, roffs, tbl, ictx)
      }
  }
  // NAT-STRIDX: `s[i]` -- a one-byte view of the string. The bounds check and
  // the view itself live in natEmitStrIndex; this arm only routes.
  if (nodeType(expr) == NODE_INDEX()) {
      return natEmitStrIndex(s, expr, plan, ictx[0], ictx[1], ictx[2], ictx[3], ictx[4], indexLine(expr))
  }
  // Step 9h-1: a record string field -- the NARROW case only. A general DotExpr
  // rewrite is deliberately NOT attempted.
  if (nodeType(expr) == NODE_DOT()) {
  return natRecordFieldLoadStr(s, stmts, plan, tbl, identName(dotLeft(expr)), memberField(expr))
  }
  if (nodeType(expr) == NODE_STRING_LIT()) {
        s = natRodataRefOff(s, natRegRDI(),
            natRodataOffsetFor(stringLitVal(expr), stmts, roffs))
        return natMovRegImm32(s, natRegRSI(), len(stringLitVal(expr)))
    }
let off = natNativeSlotOff(plan, natNativeSlotIndex(plan, identName(expr)))
  s = natLoadStack(s, natRegRDI(), off)
  return natLoadStack(s, natRegRSI(), off + 8)
  }

// The oracle's structure exactly, including the five staging units per depth in the
// DEDICATED strTemp area:
//
//   base+0 left ptr   base+8 left len
//   base+16 right ptr base+24 right len
//   base+32 allocated block
//
// strTemp rather than the int path's 8-bytes-per-depth bin scratch: five units are
// needed and the int area would be overrun.
//
// The right half's destination is `block + llen`, and llen is a RUNTIME value, so the
// oracle ADVANCES the destination register by the staged length instead of encoding the
// offset in the SIB displacement -- which cannot hold it. That is why the copy loop
// exists in this shape.
func natStrConcat(s, left, right, depth, site, strTemp, stmts, plan, roffs, tbl, ictx) {
    let base = strTemp + depth * 5 * 8
    s = natEmitStrValue(s, left, stmts, plan, roffs, tbl, ictx)
    s = natStoreStack(s, natRegRDI(), base)
    s = natStoreStack(s, natRegRSI(), base + 8)
    s = natEmitStrValue(s, right, stmts, plan, roffs, tbl, ictx)
    s = natStoreStack(s, natRegRDI(), base + 16)
    s = natStoreStack(s, natRegRSI(), base + 24)
    s = natLoadStack(s, natRegRDI(), base + 8)
    s = natLoadStack(s, natRegRSI(), base + 24)
    s = natAddRegReg(s, natRegRDI(), natRegRSI())
    s = natCallAlloc(s)
    s = natStoreStack(s, natRegRAX(), base + 32)
    s = natLoadStack(s, natRegR9(), base + 32)
    s = natLoadStack(s, natRegR8(), base)
    s = natLoadStack(s, natRegRCX(), base + 8)
    s = natByteCopy(s, natRegR9(), natRegR8(), natRegRCX(), site * 2)
    s = natLoadStack(s, natRegR9(), base + 32)
    s = natLoadStack(s, natRegR8(), base + 8)
    s = natAddRegReg(s, natRegR9(), natRegR8())
    s = natLoadStack(s, natRegR8(), base + 16)
    s = natLoadStack(s, natRegRCX(), base + 24)
    s = natByteCopy(s, natRegR9(), natRegR8(), natRegRCX(), site * 2 + 1)
    // The total is RECOMPUTED from the two staged lengths, not reused from RCX, which
    // the copy loop leaves holding its exit counter.
    s = natLoadStack(s, natRegRDI(), base + 32)
    s = natLoadStack(s, natRegRSI(), base + 8)
    s = natLoadStack(s, natRegRCX(), base + 24)
    return natAddRegReg(s, natRegRSI(), natRegRCX())
}

func natEmitStrSlice(s, sliceExpr, fns, binTemp, extrasBase, frame, rctx, strTemp, stmts, plan, roffs, tbl) {
    let base = strTemp
    if (nodeType(sliceLeft(sliceExpr)) == NODE_STRING_LIT()) {
        s = natRodataRefOff(s, natRegRDI(),
            natRodataOffsetFor(stringLitVal(sliceLeft(sliceExpr)), stmts, roffs))
        s = natMovRegImm32(s, natRegRSI(), len(stringLitVal(sliceLeft(sliceExpr))))
    } else {
        let off = natNativeSlotOff(plan, natNativeSlotIndex(plan, identName(sliceLeft(sliceExpr))))
        s = natLoadStack(s, natRegRDI(), off)
        s = natLoadStack(s, natRegRSI(), off + 8)
    }
    s = natStoreStack(s, natRegRDI(), base)
    s = natStoreStack(s, natRegRSI(), base + 8)
    let _ss = sliceStart(sliceExpr)
    let _ssOk = 0
    if (_ss != 0) {
        let _sst = nodeType(_ss)
        if (_sst == NODE_INT_LIT() || _sst == NODE_IDENT() || _sst == NODE_BINARY() || _sst == NODE_UNARY() || _sst == NODE_INDEX() || _sst == NODE_CALL()) { _ssOk = 1 }
    }
    if (_ssOk == 0) {
        s = natXorRegReg(s, natRegRAX())
    } else {
        s = natEmitIntExpr(s, sliceStart(sliceExpr), plan, fns, binTemp, extrasBase, frame, 0, rctx)
    }
    s = natStoreStack(s, natRegRAX(), base + 16)
    let _se = sliceEnd(sliceExpr)
    let _seOk = 0
    if (_se != 0) {
        let _set = nodeType(_se)
        if (_set == NODE_INT_LIT() || _set == NODE_IDENT() || _set == NODE_BINARY() || _set == NODE_UNARY() || _set == NODE_INDEX() || _set == NODE_CALL()) { _seOk = 1 }
    }
    if (_seOk == 0) {
        s = natLoadStack(s, natRegRAX(), base + 8)
    } else {
        s = natEmitIntExpr(s, sliceEnd(sliceExpr), plan, fns, binTemp, extrasBase, frame, 0, rctx)
    }
    s = natStoreStack(s, natRegRAX(), base + 24)
    let ba = natFresh(s, "sl$bad")
    s = ba[0]
    let badLbl = ba[1]
    let ca = natFresh(s, "sl$chk")
    s = ca[0]
    let chkLbl = ca[1]
    s = natLoadStack(s, natRegRCX(), base + 16)
    s = natTestRegReg(s, natRegRCX(), natRegRCX())
    s = natJns(s, chkLbl)
    s = natMark(s, badLbl)
    s = natInt3(s)
    s = natMark(s, chkLbl)
    s = natLoadStack(s, natRegRAX(), base + 24)
    s = natCmpRegReg(s, natRegRAX(), natRegRSI())
    s = natJa(s, badLbl)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    s = natJl(s, badLbl)
    s = natMovRegReg(s, natRegRSI(), natRegRAX())
    s = natLoadStack(s, natRegRDI(), base)
    s = natAddRegReg(s, natRegRDI(), natRegRCX())
    return natSubRegReg(s, natRegRSI(), natRegRCX())
}

func natNativeStrKind(e, stmts, plan) {
    if (nodeType(e) == NODE_STRING_LIT()) { return 1 }
    if (nodeType(e) == NODE_SLICE()) {
        if (natNativeStrKind(sliceLeft(e), stmts, plan) == 1) { return 1 }
        return 0 - 2
    }
    if (nodeType(e) == NODE_CALL()) {
        if (callFunc(e) == "trim") { return 1 }
        return 0 - 2
    }
    if (nodeType(e) == NODE_INDEX()) {
        // NAT-STRIDX: a byte index of a string yields a one-byte string. A
        // base that is not a string is not a string; an unclassifiable one
        // stays unknown.
        let kb = natNativeStrKind(indexLeft(e), stmts, plan)
        if (kb == 1) { return 1 }
        if (kb == 0 - 1) { return 0 - 1 }
        return 0 - 2
    }
    if (nodeType(e) == NODE_BINARY()) {
        if (binaryOp(e) == "+") {
            if (natNativeStrKind(binaryLeft(e), stmts, plan) == 1) { return 1 }
            return 0 - 1
        }
        return 0 - 2
    }
    if (nodeType(e) == NODE_IDENT()) {
        let ord = natNativeSlotIndex(plan, identName(e))
        if (ord < 0) { return 0 - 2 }
        if (natNativeSlotKind(plan, ord) == natKindString()) { return 1 }
        return 0 - 1
    }
    return 0 - 2
}

func natNativeScanConcat(e, stmts, plan, line) {
  if (binaryOp(e) != "+") {
  return natNativeRefuse("`" + binaryOp(e) + "` is not lowered by the native " +
  "driver", line)
  }
  // A CHAINED concatenation -- an operand that is ITSELF a `+` BinaryExpr.
  //
  // natNativeStrKind RECURSES, so `(a + b)` classified as a string and this
  // validator was satisfied. The crash came later: natEmitStrValue handles a
  // literal, then assumes everything else is an identifier, so it called
  // identName on the nested BinaryExpr and indexed the slot plan with garbage --
  // "array index out of range" in natNativeSlotOff. Both `print(a + b + "ef")`
  // and `return a + "cd"` hit it.
  //
  // Refused BY NAME here rather than fixed by recursion: depth would have to be
  // threaded through natEmitStrValue, strTemp sized for the deepest chain, and
  // the arena bound re-proved per nesting level instead of per site. That is its
  // own slice. What must not happen is a shape reaching emission unchecked.
  if (nodeType(binaryLeft(e)) == NODE_BINARY()) {
  return natNativeRefuse("chained string concatenation is not lowered (a " +
  "concatenation operand may not itself be a concatenation)", line)
  }
  if (nodeType(binaryRight(e)) == NODE_BINARY()) {
  return natNativeRefuse("chained string concatenation is not lowered (a " +
  "concatenation operand may not itself be a concatenation)", line)
  }
  if (natNativeStrKind(binaryLeft(e), stmts, plan) != 1) {
        return natNativeRefuse("`+` needs two strings on the native target; the left " +
            "operand is not one", line)
    }
    if (natNativeStrKind(binaryRight(e), stmts, plan) != 1) {
        return natNativeRefuse("`+` needs two strings on the native target; the right " +
            "operand is not one", line)
    }
    return ""
}

func natNativeConcatSites(stmts, plan) {
    let n = 0
    let i = 0
    while (i < len(stmts)) {
        let st = stmts[i]
        if (nodeType(st) == NODE_PRINT()) { n = n + natNativeConcatIn(printVal(st), stmts, plan) }
        if (natNativeIsDecl(st)) { n = n + natNativeConcatIn(natNativeDeclValue(st), stmts, plan) }
        // if/else bodies share the plan, so their concat sites share the arena
        // bound. Loop bodies are deliberately EXCLUDED: a concat inside a loop
        // is refused by the loop scan, so no site there ever executes, and
        // counting one would inflate the bound by an unbounded factor.
        if (nodeType(st) == NODE_IF()) {
            n = n + natNativeConcatSites(ifCons(st), plan) + natNativeConcatSites(ifAlt(st), plan)
        }
        i = i + 1
    }
    return n
}

// natNativePushCount counts push() call sites in a statement list, recursively
// into let-values and print-arguments. A push inside a loop is not possible here
// because the driver refuses loops before reaching this scan, so the count is
// a flat site count.
func natNativePushCount(stmts) {
    let n = 0
    let i = 0
    while (i < len(stmts)) {
        let st = stmts[i]
        if (nodeType(st) == NODE_PRINT()) {
            n = n + natNativePushIn(printVal(st))
        }
        if (natNativeIsDecl(st)) {
            n = n + natNativePushIn(natNativeDeclValue(st))
        }
        if (nodeType(st) == NODE_RETURN()) {
            n = n + natNativePushIn(retVal(st))
        }
        // if/else bodies share the accounting; loop bodies stay at 0 for the
        // same reason as in natNativeConcatSites (the loop scan refuses a
        // push inside a loop before emission).
        if (nodeType(st) == NODE_IF()) {
            n = n + natNativePushCount(ifCons(st)) + natNativePushCount(ifAlt(st))
        }
        i = i + 1
    }
    return n
}

func natNativePushIn(e) {
    if (nodeType(e) == NODE_CALL()) {
        if (callFunc(e) == "push") { return 1 }
    }
    if (nodeType(e) == NODE_BINARY()) {
        return natNativePushIn(binaryLeft(e)) + natNativePushIn(binaryRight(e))
    }
    if (nodeType(e) == NODE_UNARY()) {
        return natNativePushIn(unaryOperand(e))
    }
    return 0
}

func natNativeConcatIn(e, stmts, plan) {
    if (nodeType(e) != NODE_BINARY()) { return 0 }
    if (binaryOp(e) != "+") { return 0 }
    // The STRING gate. Counting every `+` was correct only while integer `+` was
    // refused outright; NAT-CALL makes `a + b` reachable, and an int addition that
    // counted as a concat site would switch usesStr on (41 bytes of print_str) and
    // reserve an arena the program never allocates from -- breaking byte-identity
    // for a program that only does arithmetic.
    if (natNativeIsStrBinary(e, stmts, plan) != 1) { return 0 }
    return 1 + natNativeConcatIn(binaryLeft(e), stmts, plan) +
        natNativeConcatIn(binaryRight(e), stmts, plan)
}

// natNativeConcatViewBytes counts the one-byte operands a concat expression
// would contribute from a STRING BYTE INDEX. A view's bytes are NOT in the
// literal census, and a bound that silently forgot them would be a bound that
// is provable for programs without indices and untrue for programs with them.
// The count is exact: one byte per view operand, and every site runs at most
// once (loops are refused), so adding it to the literal bound pays for every
// possible allocation exactly.
//
// The statement walk mirrors natNativeConcatSites precisely, so a view whose
// site exists is always counted.
func natNativeConcatViewBytes(stmts, plan) {
    let n = 0
    let i = 0
    while (i < len(stmts)) {
        let st = stmts[i]
        if (nodeType(st) == NODE_PRINT()) { n = n + natNativeConcatViewsIn(printVal(st), stmts, plan) }
        if (natNativeIsDecl(st)) { n = n + natNativeConcatViewsIn(natNativeDeclValue(st), stmts, plan) }
        if (nodeType(st) == NODE_IF()) {
            n = n + natNativeConcatViewBytes(ifCons(st), plan) + natNativeConcatViewBytes(ifAlt(st), plan)
        }
        i = i + 1
    }
    return n
}

func natNativeConcatViewsIn(e, stmts, plan) {
    if (nodeType(e) == NODE_INDEX()) {
        if (natNativeStrIndexSlot(plan, e) >= 0) { return 1 }
        return 0
    }
    if (nodeType(e) == NODE_UNARY()) {
        return natNativeConcatViewsIn(unaryOperand(e), stmts, plan)
    }
    if (nodeType(e) != NODE_BINARY()) { return 0 }
    if (binaryOp(e) != "+") { return 0 }
    if (natNativeIsStrBinary(e, stmts, plan) != 1) { return 0 }
    return natNativeConcatViewsIn(binaryLeft(e), stmts, plan) + natNativeConcatViewsIn(binaryRight(e), stmts, plan)
}

// natNativeArenaBytes is the compile-time arena size: sites * totalLiteralBytes + 16.
//
// SOUNDNESS rests on two facts, not on hope:
//  1. Every concat SITE runs at most once. A concat reached from a loop body would run
//     once per iteration, which a compile-time size cannot cover. The driver does not
//     lower loops at all, so such a program is refused before emission; the rule is
//     restated here because it is the ASSUMPTION this bound rests on.
//  2. Every string value in a supported program is a literal or a concatenation of
//     literals, so no runtime string exceeds the sum of the program's literals.
// Together they bound the sum of all allocations. +16 is the allocator header, which
// lives inside the arena.
//
// Exhaustion is therefore unreachable for a supported program and is kept anyway:
// alloc traps with Int3 rather than writing outside the arena.
//
// The bound is FLOORED at natArenaMinSize, because the oracle floors it at
// heapMinSize = 1024 (pkg/native/program.go:574, applied at :890): "floors the
// computed arena bound so trivial programs get a usable arena without the bound
// arithmetic having to be exact". kcc used the exact bound alone, so a program
// concatenating two short literals got a 20-byte arena where the oracle's is
// 1040 -- and the arena is part of the image, so the segment's filesz differed
// by 1020 bytes and every baked arena address moved with it. That was the last
// obstacle to byte-identity for an allocating program.
//
// The ORDER matters and is the oracle's: it computes arenaLen as
// heapHeaderLen + heapSize, with the floor applied to heapSize ALONE
// (program.go:1618). Folding the header in before the floor would make a
// floored arena 1024 bytes instead of 16 + 1024, so the header must be added
// after the floor has already been applied to the data size.
func natNativeArenaBytes(stmts, plan) {
    let pushSites = natNativePushCount(stmts)
    if (pushSites > 0) {
        // Arena bound for pushes: site i sees at most (largest literal length + i)
        // elements. Since the driver refuses loops, no site runs more than once.
        // Simplified: pushSites * (pushSites + 1) * 8, floored at 1024.
        let pushBytes = pushSites * (pushSites + 1) * 8
        if (pushBytes < natArenaMinSize()) { pushBytes = natArenaMinSize() }
        return pushBytes + natArenaHeaderLen()
    }
    let sites = natNativeConcatSites(stmts, plan)
    if (sites == 0) { return 0 }
    let dataBytes = sites * natNativeStrTotalBytes(stmts) + natNativeConcatViewBytes(stmts, plan)
    if (dataBytes < natArenaMinSize()) { dataBytes = natArenaMinSize() }
    return dataBytes + natArenaHeaderLen()
}

// natArenaHeaderLen is the oracle's heapHeaderLen (program.go:573): the bump
// cursor and the limit, both absolute addresses, stored inside the arena.
func natArenaHeaderLen() { return 16 }

// natArenaMinSize is the oracle's heapMinSize floor, applied to the DATA size
// alone (program.go:574).
func natArenaMinSize() { return 1024 }

func natNativeStrTotalBytes(stmts) {
    let total = 0
    let lits = natNativeStrLiterals(stmts)
    let j = 0
    while (j < len(lits)) {
        total = total + len(lits[j])
        j = j + 1
    }
    return total
}
// ============================================================
// NAT-REG: the register allocator.
//
// The design is in docs/audit/NAT-REG-DESIGN.md. The short version: this
// mirrors the ORACLE's Phase-150C allocator (pkg/native/regalloc.go) -- the
// same allocatable set, the same engagement gate, the same linear scan over
// live ranges and the same no-split rule -- over the DRIVER's own AST.
//
// A local that does not get a register keeps its frame slot, which is the
// pre-existing path and needs no new code. The frame does NOT shrink: a
// spilled local's slot is still reserved, so every slot displacement is
// unchanged and what the allocator saves is memory TRAFFIC, not frame size.

// natNativeHasControlFlow reports whether the statements contain a branch or
// a loop. It is one half of the engagement gate: below the pressure
// threshold there is nothing to relieve, and in a straight-line body a
// push/pop pair would cost more than the load it removes.
func natNativeHasControlFlow(stmts) {
    let found = 0
    let i = 0
    while (i < len(stmts)) {
        let k = nodeType(stmts[i])
        if (k == NODE_IF() || k == NODE_WHILE() || k == NODE_FOR() || k == NODE_FOR_IN()) { found = 1 }
        i = i + 1
    }
    return found
}

// natNativeRegAlloc promotes int locals into callee-saved registers.
//
// The gate is the ORACLE's (pkg/native/program.go's planRegs): the function
// must have control flow AND the peak number of simultaneously-live int
// locals must be at least five (raMinLive = allocRegCount + 1).
func natNativeRegAlloc(stmts, plan) {
    if (natNativeHasControlFlow(stmts) == 0) { return plan }
    let n = natNativeSlotCount(plan)
    if (n < 5) { return plan }
    // The live ranges: two entries per slot, the first and the last position
    // at which the slot is touched, or -1 when it never is.
    let ranges = []
    let i = 0
    while (i < n) {
        ranges = appendArray(ranges, -1)
        ranges = appendArray(ranges, -1)
        i = i + 1
    }
    let w = natNativeLiveWalk(stmts, plan, ranges, [], 0)
    ranges = natNativeRegWiden(w[0], n, w[1])
    if (natNativeRegPeak(ranges, n) < 5) { return plan }
    return natNativeRegScan(plan, n, ranges)
}

// natNativeRegWiden widens the ranges that INTERSECT a loop.
//
// A local mentioned inside a loop is live for the WHOLE loop: the body may run
// many times, and a value defined before the loop must survive every
// iteration. Widening is conservative in the safe direction -- it can only
// cause an extra spill, never a wrong answer.
func natNativeRegWiden(ranges, n, loops) {
    let li = 0
    while (li < len(loops)) {
        let s = loops[li]
        let e = loops[li + 1]
        let i = 0
        while (i < n) {
            let f = ranges[i * 2]
            let l = ranges[i * 2 + 1]
            if (f >= 0 && f <= e && l >= s) {
                if (s < f) { ranges[i * 2] = s }
                if (e > l) { ranges[i * 2 + 1] = e }
            }
            i = i + 1
        }
        li = li + 2
    }
    return ranges
}

// natNativeRegPeak is the largest number of ranges covering one point.
//
// The coverage only changes at a range's endpoints, so evaluating it at
// every range's start is enough.
func natNativeRegPeak(ranges, n) {
    let peak = 0
    let i = 0
    while (i < n) {
        let f = ranges[i * 2]
        if (f >= 0) {
            let c = 0
            let j = 0
            while (j < n) {
                let f2 = ranges[j * 2]
                let l2 = ranges[j * 2 + 1]
                if (f2 >= 0 && f2 <= f && l2 >= f) { c = c + 1 }
                j = j + 1
            }
            if (c > peak) { peak = c }
        }
        i = i + 1
    }
    return peak
}

// natNativeRegScan is the linear scan.
//
// A register is available when the local holding it is dead before this
// range starts; otherwise the candidate spills to its frame slot, which is
// the pre-existing behaviour and needs no new code path.
//
// The scan walks the slots in PLAN order, which is the declaration order and
// therefore the order of first definition, so the allocation is a pure
// function of the program.
func natNativeRegScan(plan, n, ranges) {
    // held[r] is the last position of the range holding register r, or -1.
    let held = [-1, -1, -1, -1]
    let i = 0
    while (i < n) {
        let f = ranges[i * 2]
        let l = ranges[i * 2 + 1]
        if (f >= 0) {
            let r = -1
            let k = 0
            while (k < 4) {
                if (held[k] < 0 || held[k] < f) {
                    r = k
                    k = 4
                }
                k = k + 1
            }
            if (r >= 0) {
                plan[i * 5 + 4] = 12 + r
                held[r] = l
            }
        }
        i = i + 1
    }
    return plan
}

// natNativeLiveWalk computes the live ranges.
//
// It returns [ranges, loops, pos]:
//   ranges  two entries per slot: the first and the last position at which
//           the slot is touched, or -1 when it never is
//   loops   two entries per loop: the position it starts at and the position
//           it ends at
//   pos     the final position counter
//
// The walk is POINT ORDERED: every statement and every expression advances
// the counter, so a local's range runs from its first touch to its last.
func natNativeLiveWalk(stmts, plan, ranges, loops, pos) {
    let i = 0
    while (i < len(stmts)) {
        let w = natNativeLiveStmt(stmts[i], plan, ranges, loops, pos)
        ranges = w[0]
        loops = w[1]
        pos = w[2]
        i = i + 1
    }
    return [ranges, loops, pos]
}

// natNativeLiveStmt handles ONE statement.
//
// The FOR arm's init and post are single STATEMENT nodes and not lists --
// that is the AST's shape (ast.kark: makeFor stores the init, the condition,
// the post and the body as four separate fields) -- which is why they are
// handled here and not by natNativeLiveWalk.
func natNativeLiveStmt(n, plan, ranges, loops, pos) {
    let k = nodeType(n)
    if (natNativeIsDecl(n)) {
        pos = pos + 1
        let r = natNativeLiveTouch(ranges, plan, natNativeDeclName(n), pos, 1)
        ranges = r[0]
        let w = natNativeLiveExpr(natNativeDeclValue(n), plan, ranges, pos + 1)
        ranges = w[0]
        pos = w[1]
    }
    if (k == NODE_PRINT()) {
        let w = natNativeLiveExpr(printVal(n), plan, ranges, pos + 1)
        ranges = w[0]
        pos = w[1]
    }
    if (k == NODE_RETURN()) {
        let w = natNativeLiveExpr(retVal(n), plan, ranges, pos + 1)
        ranges = w[0]
        pos = w[1]
    }
    if (k == NODE_EXPR_STMT()) {
        let e = exprStmtExpr(n)
        let isAssign = 0
        if (natNativeIsAssignExpr(e)) { isAssign = 1 }
        if (isAssign == 1) {
            let lhs = binaryLeft(e)
            if (nodeType(lhs) == NODE_IDENT()) {
                // `x = v` defines x and uses v.
                pos = pos + 1
                let r = natNativeLiveTouch(ranges, plan, identName(lhs), pos, 1)
                ranges = r[0]
                let w = natNativeLiveExpr(binaryRight(e), plan, ranges, pos + 1)
                ranges = w[0]
                pos = w[1]
            } else {
                let w = natNativeLiveExpr(e, plan, ranges, pos + 1)
                ranges = w[0]
                pos = w[1]
            }
        } else {
            let w = natNativeLiveExpr(e, plan, ranges, pos + 1)
            ranges = w[0]
            pos = w[1]
        }
    }
    if (k == NODE_IF()) {
        let w = natNativeLiveExpr(ifCond(n), plan, ranges, pos + 1)
        ranges = w[0]
        pos = w[1]
        let c = natNativeLiveWalk(ifCons(n), plan, ranges, loops, pos + 1)
        ranges = c[0]
        loops = c[1]
        pos = c[2]
        let a = natNativeLiveWalk(ifAlt(n), plan, ranges, loops, pos + 1)
        ranges = a[0]
        loops = a[1]
        pos = a[2]
    }
    if (k == NODE_WHILE()) {
        let lstart = pos
        let w = natNativeLiveExpr(whileCond(n), plan, ranges, pos + 1)
        ranges = w[0]
        pos = w[1]
        let b = natNativeLiveWalk(whileBody(n), plan, ranges, loops, pos + 1)
        ranges = b[0]
        loops = b[1]
        pos = b[2]
        loops = appendArray(loops, lstart)
        loops = appendArray(loops, pos)
    }
    if (k == NODE_FOR()) {
        let lstart = pos
        let fi = forInit(n)
        if (len(fi) > 0) {
            let w = natNativeLiveStmt(fi, plan, ranges, loops, pos + 1)
            ranges = w[0]
            loops = w[1]
            pos = w[2]
        }
        let w = natNativeLiveExpr(forCond(n), plan, ranges, pos + 1)
        ranges = w[0]
        pos = w[1]
        let b = natNativeLiveWalk(forBody(n), plan, ranges, loops, pos + 1)
        ranges = b[0]
        loops = b[1]
        pos = b[2]
        let fp = forPost(n)
        if (len(fp) > 0) {
            let w = natNativeLiveStmt(fp, plan, ranges, loops, pos + 1)
            ranges = w[0]
            loops = w[1]
            pos = w[2]
        }
        loops = appendArray(loops, lstart)
        loops = appendArray(loops, pos)
    }
    return [ranges, loops, pos]
}
// natNativeLiveTouch records a use (or a def) of a local at a position.
//
// Only INT locals are candidates: a string or an array is two units and is
// never promoted.
func natNativeLiveTouch(ranges, plan, name, pos, isDef) {
    let ord = natNativeSlotIndex(plan, name)
    if (ord < 0) { return [ranges, 0] }
    if (natNativeSlotKind(plan, ord) != natKindInt()) { return [ranges, 0] }
    let f = ranges[ord * 2]
    let l = ranges[ord * 2 + 1]
    if (f < 0) { f = pos }
    if (isDef == 1 && pos < f) { f = pos }
    if (pos > l) { l = pos }
    ranges[ord * 2] = f
    ranges[ord * 2 + 1] = l
    return [ranges, 0]
}

// natNativeLiveExpr walks an expression for the identifiers it touches.
func natNativeLiveExpr(e, plan, ranges, pos) {
    let k = nodeType(e)
    if (k == NODE_IDENT()) {
        let r = natNativeLiveTouch(ranges, plan, identName(e), pos, 0)
        return [r[0], pos + 1]
    }
    if (k == NODE_BINARY()) {
        let l = natNativeLiveExpr(binaryLeft(e), plan, ranges, pos + 1)
        let r = natNativeLiveExpr(binaryRight(e), plan, l[0], l[1])
        return [r[0], r[1]]
    }
    if (k == NODE_UNARY()) {
        let r = natNativeLiveExpr(unaryOperand(e), plan, ranges, pos + 1)
        return [r[0], r[1]]
    }
    if (k == NODE_INDEX()) {
        let l = natNativeLiveExpr(indexLeft(e), plan, ranges, pos + 1)
        let r = natNativeLiveExpr(e[2], plan, l[0], l[1])
        return [r[0], r[1]]
    }
    if (k == NODE_CALL()) {
        let args = callArgs(e)
        let rr = [ranges, pos + 1]
        let i = 0
        while (i < len(args)) {
            let w = natNativeLiveExpr(args[i], plan, rr[0], rr[1])
            rr = [w[0], w[1]]
            i = i + 1
        }
        return [rr[0], rr[1]]
    }
    if (k == NODE_ARRAY_LIT()) {
        let elems = arrayLitElems(e)
        let rr = [ranges, pos + 1]
        let i = 0
        while (i < len(elems)) {
            let w = natNativeLiveExpr(elems[i], plan, rr[0], rr[1])
            rr = [w[0], w[1]]
            i = i + 1
        }
        return [rr[0], rr[1]]
    }
    if (k == NODE_STRUCT_LIT()) {
        let sf = structLitFields(e)
        let rr = [ranges, pos + 1]
        let i = 0
        while (i < len(sf)) {
            let w = natNativeLiveExpr(binaryRight(sf[i]), plan, rr[0], rr[1])
            rr = [w[0], w[1]]
            i = i + 1
        }
        return [rr[0], rr[1]]
    }
    return [ranges, pos + 1]
}

// natNativeRegList returns the registers the plan claims, in R12..R15 order.
//
// The order is the ALLOCATABLE SET's order and not the plan's, so the push/pop
// sequence is a pure function of the allocation and never of the order the
// slots happen to be declared in.
func natNativeRegList(plan) {
    let out = []
    let r = 12
    while (r < 16) {
        let i = 0
        let n = natNativeSlotCount(plan)
        let found = 0
        while (i < n) {
            if (natNativeSlotReg(plan, i) == r) { found = 1 }
            i = i + 1
        }
        if (found == 1) { out = appendArray(out, r) }
        r = r + 1
    }
    return out
}

// natNativeRegPush saves the claimed callee-saved registers.
//
// They are pushed BEFORE the frame is taken, so the frame's rsp-relative
// displacements below stay unchanged.
func natNativeRegPush(s, plan) {
    let regs = natNativeRegList(plan)
    let i = 0
    while (i < len(regs)) {
        s = natPushReg(s, regs[i])
        i = i + 1
    }
    return s
}

// natNativeRegPop restores them, in exact reverse order.
func natNativeRegPop(s, plan) {
    let regs = natNativeRegList(plan)
    let i = len(regs) - 1
    while (i >= 0) {
        s = natPopReg(s, regs[i])
        i = i - 1
    }
    return s
}

// natNativeStoreLocal stores an int local's value: in its allocated register
// when it has one, and in its frame slot otherwise.
func natNativeStoreLocal(s, plan, ord, valueReg) {
    let reg = natNativeSlotReg(plan, ord)
    if (reg >= 0) { return natMovRegReg(s, reg, valueReg) }
    return natStoreStack(s, valueReg, natNativeSlotOff(plan, ord))
}

// natNativeLoadLocal reads an int local into a register: from its allocated
// register when it has one, and from its frame slot otherwise.
func natNativeLoadLocal(s, plan, ord, dstReg) {
    let reg = natNativeSlotReg(plan, ord)
    if (reg >= 0) { return natMovRegReg(s, dstReg, reg) }
    return natLoadStack(s, dstReg, natNativeSlotOff(plan, ord))
}

// The arena is all zeros because the header SELF-INITIALISES: the cursor is zero in the
// image and zero is the "not started" sentinel. The stored limit is never read either --
// natAllocHelper materialises the arena END from the link-time patch -- so no
// initialisation step is needed at all.
func natNativeArenaBytes0(n) {
    let out = []
    let i = 0
    while (i < n) {
        out = appendArray(out, 0)
        i = i + 1
    }
    return out
}

// ============================================================
// NAT-STR-STAGE: the program-wide string-usage flag.
//
// The oracle reserves the string staging area from a set of FIVE program-wide
// flags, and the reservation lands in EVERY function's layout:
//
//   pkg/native/program.go:4454
//     if b.usesConcat || b.usesStrEq || b.usesStrSlice || b.usesPush || b.usesStrField {
//         b.strTemp = next
//         next += 8*5*maxBinDepth
//     }
//
// All five flags are properties of the PROGRAM -- scanValueUsage (program.go:873)
// and scanStructUsage (program.go:615) walk the whole program -- and the
// oracle's layout() is called once PER FUNCTION, so a program with ONE string
// operation reserves the staging area in EVERY function, including the callees
// that never touch it.
//
// The driver reserved it PER FUNCTION, and only for two of the five
// operations. Measured on the Linux ELF target, because the Windows 16-byte
// frame rounding quantises an 8-byte difference away and cannot see a
// 2560-byte one:
//
//   program                     driver frames   oracle frames
//   helper + concat in main     [608, 3168]     [3168, 3168]
//   helper + push in main       [608, 3208]     [3168, 3208]
//   string field assignment     [640]           [3200]
//
// Every difference is the same 2560 bytes -- natStrTempBytes() -- and every one
// of them is the driver's own SCOPE and COVERAGE, not the oracle's.
//
// This has the same shape as natNativeProgramUsesMap, whose map-stage slot has
// the same program-wide scope in the oracle (program.go:4461): the precedent is
// established rather than invented.
//
// The plan is RECOMPUTED here rather than threaded in, because
// natNativePlanFor is a PURE function of (params, body, tbl) and the emitter
// will compute the same slots from the same inputs. The alternative -- turning
// the one-pass scan/emit loop into a scan pass and an emit pass -- would give
// up the property that loop was built for: a refusal aborts the program
// before anything is emitted.
func natNativeProgramUsesStr(fns, tbl) {
    let fi = 0
    while (fi < natNativeFuncCount(fns)) {
        let fparams = natNativeFuncParamsAt(fns, fi)
        let fbody = natNativeFuncBodyAt(fns, fi)
        let fplan = natNativePlanForKinds(fparams, natNativeFuncKindsAt(fns, fi), fbody, tbl, fns)
        if (natNativeStrOpIn(fbody, fplan) == 1) { return 1 }
        fi = fi + 1
    }
    return 0
}

// natNativeStrOpIn reports whether a statement list performs any of the FIVE
// string operations the oracle's staging area exists for.
//
//   1. a string CONCATENATION    -- usesConcat
//   2. a string EQUALITY         -- usesStrEq
//   3. a string SLICE            -- usesStrSlice
//   4. a push()                  -- usesPush
//   5. a string FIELD ASSIGNMENT -- usesStrField
//
// Arms 1 and 4 REUSE the detectors the arena bound already uses
// (natNativeConcatSites and natNativePushCount), so there is ONE notion of
// where a concat site is rather than two collectors that could disagree -- the
// Step 9g defect class.
//
// Arms 3 and 5 are still UNREACHABLE from the driver's accepted subset: a
// string slice and a string field assignment from anything but a literal are
// refused by name (the kind-46 refusal and natNativeScanAssign's string-field
// arm). They are implemented anyway, because the reservation is a LAYOUT
// CONTRACT with the oracle: when one of them is lowered, the staging area has
// to be reserved already, or the frame would move at that point and every
// image with it.
//
// Arm 2 WAS in that state and is LOWERED now (NAT-STREQ): a string equality
// in a CONDITION position stages through strTemp, so the counter must see
// conditions and recurse into branch and loop bodies -- the equality is
// allocation-free, so the loop refusal that keeps the arena constructs out of
// loop bodies does not apply to it. natNativeStrEqSites does that.
//
// The statement positions scanned are the ones the driver lowers: a print
// value, a binding's initialiser, a returned value, an expression statement,
// and now a branch/loop CONDITION plus the bodies beneath it.
func natNativeStrOpIn(stmts, plan) {
    if (natNativeConcatSites(stmts, plan) > 0) { return 1 }
    if (natNativePushCount(stmts) > 0) { return 1 }
    if (natNativeStrEqSites(stmts, plan) > 0) { return 1 }
    if (natNativeStrSliceSites(stmts, plan) > 0) { return 1 }
    if (natNativeStrFieldSites(stmts) > 0) { return 1 }
    return 0
}

// natNativeStrEqSites counts string EQUALITY sites: a `==` or `!=` whose two
// operands are both strings.
//
// The oracle's predicate is name-based and program-wide (scanStringViewOps,
// program.go:1410: `x.Operator == "==" || x.Operator == "!="` with
// `strKind(x.Left) && strKind(x.Right)`); this one is kind-based and
// per-function, because the driver's kind inference is the plan's slot kinds
// and the plan is per function. The NAT-STR-STAGE record already pins the
// name-table over-approximation this avoids (a name bound to a string
// ANYWHERE is a string EVERYWHERE in the oracle, including an int parameter
// shadowed in another function); the driver follows the EMISSION instead.
//
// A string FIELD read is not classified as a string by this test, because the
// driver's kind inference resolves slots, not field accesses. The oracle's
// name-based test does classify it. A field-read operand is refused by the
// slice-1 scan (natNativeScanStrEqOperand), so the difference stays in an
// arm that cannot reach an emitted frame, and it is recorded rather than
// papered over.
func natNativeStrEqSites(stmts, plan) {
    let n = 0
    let i = 0
    while (i < len(stmts)) {
        let st = stmts[i]
        if (nodeType(st) == NODE_PRINT()) { n = n + natNativeStrEqIn(printVal(st), plan) }
        if (natNativeIsDecl(st)) { n = n + natNativeStrEqIn(natNativeDeclValue(st), plan) }
        if (nodeType(st) == NODE_RETURN()) { n = n + natNativeStrEqIn(retVal(st), plan) }
        // NAT-STREQ: a comparison exists only in CONDITION positions, and a
        // condition sits on an if/while/for -- so the counter scans the
        // condition AND recurses into the bodies, because an equality inside
        // a branch or a loop body is LOWERED now (equality allocates
        // nothing, so the loop refusal that keeps concat/push out of loop
        // bodies does not apply to it). Missing the reservation would stage
        // the comparison past the reserved area -- silent corruption, the
        // exact class the Step 9g dual-collector defect taught.
        if (nodeType(st) == NODE_IF()) {
            n = n + natNativeStrEqIn(ifCond(st), plan)
            n = n + natNativeStrEqSites(ifCons(st), plan)
            n = n + natNativeStrEqSites(ifAlt(st), plan)
        }
        if (nodeType(st) == NODE_WHILE()) {
            n = n + natNativeStrEqIn(whileCond(st), plan)
            n = n + natNativeStrEqSites(whileBody(st), plan)
        }
        if (nodeType(st) == NODE_FOR()) {
            n = n + natNativeStrEqIn(forCond(st), plan)
            n = n + natNativeStrEqSites(forBody(st), plan)
        }
        i = i + 1
    }
    return n
}

// natNativeStrEqIn walks an expression for a string equality.
//
// It descends into a comparison's operands as well as into the surrounding
// expression, because the equality may sit anywhere in the tree.
func natNativeStrEqIn(e, plan) {
    if (nodeType(e) == NODE_BINARY()) {
        let op = binaryOp(e)
        if (op == "==" || op == "!=") {
            if (natNativeStrKind(binaryLeft(e), 0, plan) == 1) {
                if (natNativeStrKind(binaryRight(e), 0, plan) == 1) { return 1 }
            }
        }
        return natNativeStrEqIn(binaryLeft(e), plan) + natNativeStrEqIn(binaryRight(e), plan)
    }
    if (nodeType(e) == NODE_UNARY()) { return natNativeStrEqIn(unaryOperand(e), plan) }
    if (nodeType(e) == NODE_CALL()) {
        let n = 0
        let i = 0
        while (i < len(callArgs(e))) {
            n = n + natNativeStrEqIn(callArgs(e)[i], plan)
            i = i + 1
        }
        return n
    }
    return 0
}

// natNativeStrSliceSites counts string SLICE sites: a `s[a:b]` whose target is
// a string.
//
// The oracle's predicate is scanStringViewOps's `slice` arm (program.go:1405-1408:
// a SliceExpr whose target is a string). This one is kind-based and
// per-function, for the same reason the equality arm is.
func natNativeStrSliceSites(stmts, plan) {
    let n = 0
    let i = 0
    while (i < len(stmts)) {
        let st = stmts[i]
        if (nodeType(st) == NODE_PRINT()) { n = n + natNativeStrSliceIn(printVal(st), plan) }
        if (natNativeIsDecl(st)) { n = n + natNativeStrSliceIn(natNativeDeclValue(st), plan) }
        if (nodeType(st) == NODE_RETURN()) { n = n + natNativeStrSliceIn(retVal(st), plan) }
        i = i + 1
    }
    return n
}

// natNativeStrSliceIn walks an expression for a string slice.
func natNativeStrSliceIn(e, plan) {
    if (nodeType(e) == NODE_SLICE()) {
        if (natNativeStrKind(sliceLeft(e), 0, plan) == 1) { return 1 }
        return natNativeStrSliceIn(sliceStart(e), plan) + natNativeStrSliceIn(sliceEnd(e), plan)
    }
    if (nodeType(e) == NODE_BINARY()) {
        return natNativeStrSliceIn(binaryLeft(e), plan) + natNativeStrSliceIn(binaryRight(e), plan)
    }
    if (nodeType(e) == NODE_UNARY()) { return natNativeStrSliceIn(unaryOperand(e), plan) }
    if (nodeType(e) == NODE_CALL()) {
        let n = 0
        let i = 0
        while (i < len(callArgs(e))) {
            n = n + natNativeStrSliceIn(callArgs(e)[i], plan)
            i = i + 1
        }
        return n
    }
    return 0
}

// natNativeStrFieldSites counts STRING FIELD ASSIGNMENTS: a `record.field = ...`
// whose right-hand side carries a string literal.
//
// This is the oracle's scanStructUsage predicate (program.go:615-705), and it
// is SYNTACTIC there too: an expression statement whose expression is `=`,
// whose left side is a field access, and whose right side carries a string
// literal -- recursing through `+`, because `f.label = "a" + "b"` carries one.
// The oracle does not check the field's type here; the layout decides it
// later. The driver keeps the same predicate, so the reservation matches.
//
// The driver's own field write does NOT stage through the area: it stores the
// (pointer, length) pair directly into the field area (natNativeLowerAssign).
// That is why the FRAME can match the oracle's without the CODE matching --
// the driver does not duplicate the oracle's staging implementation, it only
// reserves the region the oracle reserves.
func natNativeStrFieldSites(stmts) {
    let n = 0
    let i = 0
    while (i < len(stmts)) {
        let st = stmts[i]
        if (nodeType(st) == NODE_EXPR_STMT()) {
            let e = exprStmtExpr(st)
            if (natNativeIsAssignExpr(e)) {
                if (nodeType(binaryLeft(e)) == NODE_DOT()) {
                    if (natNativeStrLitIn(binaryRight(e)) == 1) { n = n + 1 }
                }
            }
        }
        i = i + 1
    }
    return n
}

// natNativeStrLitIn reports whether an expression carries a string literal,
// recursing through `+` -- the oracle's hasStrLiteral (program.go:617-630).
func natNativeStrLitIn(e) {
    if (nodeType(e) == NODE_STRING_LIT()) { return 1 }
    if (nodeType(e) == NODE_SLICE()) {
        if (natNativeStrLitIn(sliceLeft(e)) == 1) { return 1 }
        if (natNativeStrLitIn(sliceStart(e)) == 1) { return 1 }
        if (natNativeStrLitIn(sliceEnd(e)) == 1) { return 1 }
        return 0
    }
    if (nodeType(e) == NODE_BINARY()) {
        if (binaryOp(e) == "+") {
            if (natNativeStrLitIn(binaryLeft(e)) == 1) { return 1 }
            return natNativeStrLitIn(binaryRight(e))
        }
    }
    return 0
}

// ============================================================
// Native VALUE and FRAME foundation (Phase 151A Step 1)
//
// The Karkain counterpart of the value/frame half of the Go oracle in
// pkg/native/program.go. The oracle is authoritative: this file is a PORT
// and must reproduce its conventions exactly, because increment 151's
// contract is that kcc's images are byte-identical to the Go oracle's.
//
// WHAT IS HERE, and nothing else:
//
//   1. The native value-kind model and kindUnits -- how many 8-byte frame
//      units a kind occupies.
//   2. The frame layout -- the ORDER and SIZING of the frame regions.
//   3. Local-slot addressing -- the byte offset of a local of a given kind.
//
// The code GENERATION that consumes these (int lowering, float, arrays,
// arena, strings, records, maps, the entry stub and syscall tails) is later
// 151A work and is deliberately absent. This slice's whole job is that the
// layout be right before any bytes depend on it.
//
// VALUES ARE STATICALLY KEDD AND UNBOXED. The roadmap's word "boxed" does
// NOT mean a tagged runtime Value here: the Go oracle assigns each local a
// compile-time kind and stores a raw 8-byte unit (or two, for string and
// array) at [rsp+off]. There is no tag word, and none is introduced. The
// TAGGED Value with TYPE_RESULT / resVal.tag belongs to the C path, which is
// a different model entirely (it is what the `?` operator inspects), and it
// must not leak into the native path.
//
// KindInt is 0 on purpose: the Go oracle makes it `iota` so that every
// pre-150 default -- an untyped parameter, a missing return, an unknown slot
// -- keeps meaning int without touching any of its logic. Every
// "cannot determine the kind" path in the oracle returns 0, so preserving
// that value is what keeps those paths working unchanged.
//
// STATE REPRESENTATION. Karkain has no structs, so the frame layout is
// returned as one array with fixed slots (natFr*), the same discipline
// native_emit.kark uses for the encoder and kir.kark uses for `lines`.
// ============================================================

// ============================================================
// 1. Value kinds and their unit widths.
// ============================================================

// natKindInt .. natKindMap mirror the Go oracle's KindInt..KindMap. The
// NUMBERS are the contract, because the oracle's `iota` numbering is what
// every default in its code compares against.
func natKindInt()    { return 0 }   // KindInt
func natKindString() { return 1 }   // KindString
func natKindFloat()  { return 2 }   // KindFloat
func natKindArray()  { return 3 }   // KindArray
func natKindStruct() { return 4 }   // KindStruct
func natKindMap()    { return 5 }   // KindMap

// natKindUnits returns the 8-byte frame/call slots a kind occupies.
//
//   int 1, float 1, bool 1 (a bool IS an int here), struct 1, map 1,
//   string 2, array 2.
//
// string and array are TWO units (ptr+len); everything else is one. This is
// the oracle's kindUnits verbatim. A record and a map are one unit because
// the value IS the address of the field area / arena header, so neither
// copies a byte when it is passed to a function.
func natKindUnits(kind) {
    if (kind == natKindString()) { return 2 }
    if (kind == natKindArray()) { return 2 }
    return 1
}

// natKindName renders a kind for diagnostics, matching the oracle's kindName.
func natKindName(kind) {
    if (kind == natKindString()) { return "string" }
    if (kind == natKindFloat()) { return "float" }
    if (kind == natKindArray()) { return "array" }
    if (kind == natKindStruct()) { return "struct" }
    if (kind == natKindMap()) { return "map" }
    return "int"
}

// ============================================================
// 2. Fixed frame-layout constants.
//
// These three are the oracle's, and they are load-bearing: changing any of
// them changes every image.
// ============================================================

// natArgSpillBytes is the fixed caller-side argument spill area: 6 args x
// (ptr+len) = 6 x 16 = 96 bytes, always reserved.
func natArgSpillBytes() { return 96 }

// natMaxBinDepth bounds nested binary-expression evaluation. It sizes
// binTemp, and it is a CONSTANT in the oracle (64), not a computed maximum:
// the frame must have the same size for every program so that a slot offset
// never depends on the program being compiled.
func natMaxBinDepth() { return 64 }

// natBinTempBytes is the binary-operand scratch area: 8 bytes per depth.
func natBinTempBytes() { return 8 * natMaxBinDepth() }

// natStrTempBytes is the string staging area: FIVE 8-byte units per nesting
// level. Five because a concat needs two operands, a result, and two length
// temporaries staged at once.
func natStrTempBytes() { return 8 * 5 * natMaxBinDepth() }

// natMapStageBytes is the single frame unit that carries a map key across the
// evaluation of its value.
func natMapStageBytes() { return 8 }

// ============================================================
// 3. The frame layout.
//
// Slot indices into the array returned by natFrameLayout:
//   0 localsEnd    1 binTemp   2 strTemp   3 mapStage
//   4 extrasBase   5 next      6 frame
// ============================================================

func natFrLocals()  { return 0 }
func natFrBinTemp() { return 1 }
func natFrStrTemp() { return 2 }
func natFrMapStage() { return 3 }
func natFrExtras() { return 4 }
func natFrNext()   { return 5 }
func natFrFrame()  { return 6 }

// natFrameLayout reproduces the oracle's layout() ordering and sizing for one
// function. Every parameter is a fact the oracle computed, so this function
// makes no decision of its own:
//
//   locals -> recArgAreas -> binTemp -> strTemp? -> mapStage? ->
//   extrasBase -> Windows 16-byte rounding -> + argSpillBytes
//
// Parameters, in the oracle's terms:
//   localBytes   the locals region already laid out (params first, then one
//                slot per let, strings and arrays taking two units each)
//   recArgBytes  Phase 150B3b record field areas for literals passed
//                straight to a call; 0 when the program has none
//   usesStr      true when the program has a concat / string-compare /
//                string-slice / push / string-field operation
//   usesMap      true when the program uses maps
//   maxExtra     the largest caller-side extras-unit count over this
//                function's call sites (Phase 148)
//   isWindows    whether the target is Windows
//
// strTemp and mapStage are CONDITIONAL in the oracle, and unconditionally
// reserving them would grow every frame that does not need them -- which
// would break the byte-identity of every image that does not use strings or
// maps. The conditionals are therefore part of the contract, not an
// optimisation, and they are reproduced exactly.
func natFrameLayout(localBytes, recArgBytes, usesStr, usesMap, maxExtra, isWindows) {
    let next = localBytes + recArgBytes
    next = next + natBinTempBytes()
    let strTemp = 0
    if (usesStr == 1) {
        strTemp = next
        next = next + natStrTempBytes()
    }
    let mapStage = 0
    if (usesMap == 1) {
        mapStage = next
        next = next + natMapStageBytes()
    }
    let extrasBase = next
    next = next + maxExtra * 8
    // Phase 149: Win64 calls fault on a misaligned stack, so the frame is
    // rounded to 16 on Windows. Linux never noticed, because syscalls do not
    // care -- and gating this on Windows is what keeps Linux images
    // byte-frozen.
    if (isWindows == 1) {
        if (next % 16 != 0) { next = next + 8 }
    }
    let frame = next + natArgSpillBytes()

    let f = []
    f = appendArray(f, localBytes)
    // binTemp is the region START, so an operand scratch slot is
    // binTemp + depth*8 and lands at localBytes+recArgBytes+depth*8. Recording
    // the region END here (localBytes+recArgBytes+binTempBytes) shifted every
    // staged operand by the whole scratch area -- 512 bytes -- which the
    // binary-expression differential caught immediately. Step 1 did not see it
    // because nothing emitted through binTemp and its layout corpus printed
    // only frame/strTemp/mapStage/slot offsets.
    f = appendArray(f, localBytes + recArgBytes)
    f = appendArray(f, strTemp)
    f = appendArray(f, mapStage)
    f = appendArray(f, extrasBase)
    f = appendArray(f, next)
    f = appendArray(f, frame)
    return f
}

// ============================================================
// 4. Local-slot addressing.
// ============================================================

// natLocalOff returns the byte offset of local `index` of `kind` within the
// locals region.
//
// Locals are laid out in declaration order with no gaps and no alignment
// padding: each occupies exactly kindUnits(kind) 8-byte units, so the offset
// of a unit-1 local is 8*index and the two-unit kinds simply consume two.
// That contiguity is why the oracle can address a slot with a compile-time
// displacement and never needs a relocation for it.
func natLocalOff(index, kind) {
    return 8 * index * natKindUnits(kind)
}

// ============================================================
// 5. The reference program bodies.
//
// Step 1's evidence is the machine code for the smallest programs that
// exercise a frame and a local slot. There is deliberately no helper, no
// `print`, no arena and no entry stub: those are later 151A work, and
// including them would make this slice's evidence depend on slices that do
// not exist yet.
//
// The two cases are:
//
//   one   `let x = 42`         one int local, stored, never read
//   two   `let x = 42; let y = x`   two int locals, load slot 0, store slot 1
//
// `two` is the case that actually proves the foundation: it emits a load and
// a store at two DIFFERENT compile-time displacements, so a wrong slot
// ordering, a wrong unit width or a wrong displacement form shows up as a
// different byte rather than as a coincidence.
// ============================================================

// The x86-64 register numbers, matching the Go oracle's Reg constants
// (RAX = 0 ...). They are named because a bare 0 or 4 in an encoder is a
// bug waiting to happen.
func natRegRAX() { return 0 }
func natRegRSP() { return 4 }

// natValueMain emits the body of `main` for the reference program.
// `nLocals` is 1 or 2; with 2 the second local copies the first.
//
// The sequence is the oracle's emitFunc prologue + one or two let
// lowerings + the return, and nothing else:
//
//   sub rsp, frame          prologue
//   mov rax, 42             the initialiser
//   mov [rsp+slot], rax     bind the local
//   mov rax, [rsp+slot]     (two locals only) read the first local
//   mov [rsp+slot+8], rax   bind the second local
//   xor rax, rax            the missing-return-yields-0 rule
//   add rsp, frame          epilogue
//   ret
func natValueMain(nLocals) {
    // One int local per declaration; int is one unit each, so the locals
    // region is 8 bytes per local. Computed through natKindUnits rather
    // than hard-coded, so the layout cannot drift away from the kind model.
    let localBytes = 8 * nLocals * natKindUnits(natKindInt())
    // recArgBytes 0 (no record literal is passed to a call),
    // usesStr 0 and usesMap 0 (no string or map operation exists yet, so
    // those two regions are NOT reserved -- the oracle's own conditionals),
    // maxExtra 0 (no call site), isWindows 0 (the reference case is Linux,
    // which never rounds).
    let f = natFrameLayout(localBytes, 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]

    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 42)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    if (nLocals == 2) {
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
    }
    s = natXorRegReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natValueLayoutCorpus reports the layout facts as text, so the gate can pin
// the frame arithmetic itself and not only the bytes it produced. These are
// the numbers the oracle computes for the same inputs; the gate derives them
// independently from first principles and compares BOTH the numbers and the
// bytes, because a layout that is wrong in the same way on both sides would
// still produce matching bytes.
func natValueLayoutCorpus(which) {
    if (which == 0) {
        // one int local
        let f = natFrameLayout(8, 0, 0, 0, 0, 0)
        return "int1 units=" + natKindUnits(natKindInt()) + " frame=" + f[natFrFrame()] + " slot0=" + natLocalOff(0, natKindInt())
    }
    if (which == 1) {
        // two int locals
        let f = natFrameLayout(16, 0, 0, 0, 0, 0)
        return "int2 units=" + natKindUnits(natKindInt()) + " frame=" + f[natFrFrame()] + " slot0=" + natLocalOff(0, natKindInt()) + " slot1=" + natLocalOff(1, natKindInt())
    }
    if (which == 2) {
        // kind units for every kind, in the oracle's numbering
        return "units int=" + natKindUnits(natKindInt()) + " string=" + natKindUnits(natKindString()) + " float=" + natKindUnits(natKindFloat()) + " array=" + natKindUnits(natKindArray()) + " struct=" + natKindUnits(natKindStruct()) + " map=" + natKindUnits(natKindMap())
    }
    if (which == 3) {
        // the conditional regions: reserved for a string program, skipped for
        // an int program. The int case must report 0, because reserving
        // them unconditionally would grow every int image.
        let fi = natFrameLayout(8, 0, 0, 0, 0, 0)
        let fs = natFrameLayout(8, 0, 1, 0, 0, 0)
        let fm = natFrameLayout(8, 0, 0, 1, 0, 0)
        return "cond int_strTemp=" + fi[natFrStrTemp()] + " int_mapStage=" + fi[natFrMapStage()] + " str_strTemp=" + fs[natFrStrTemp()] + " str_frame=" + fs[natFrFrame()] + " map_mapStage=" + fm[natFrMapStage()] + " map_frame=" + fm[natFrFrame()]
    }
    if (which == 4) {
        // Windows rounds the frame to 16; Linux does not. With maxExtra 2
        // (16 bytes) the unsized total is 8+512+16 = 536, which is 8 mod 16,
        // so Windows adds one unit and Linux does not.
        let fw = natFrameLayout(8, 0, 0, 0, 2, 1)
        let fl = natFrameLayout(8, 0, 0, 0, 2, 0)
        return "round win_frame=" + fw[natFrFrame()] + " linux_frame=" + fl[natFrFrame()]
    }
    return ""
}

// natValueCorpus is the measurement surface: the finished machine code of
// each reference program, as hex. natFinish returns an error string for a
// malformed emission, so a case that fails to encode reports that rather
// than an empty string.
func natValueCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natValueMain(1))) }
    if (which == 1) { return natToHex(natFinish(natValueMain(2))) }
    return ""
}

// natValuePrim renders one encoder opcode on its own, so each of the
// primitives Step 1 added to native_emit.kark can be compared individually
// against the Go oracle's identically named method. The composite program
// above already exercises all of them, but a composite mismatch does not say
// WHICH primitive is wrong.
//
// The order here is the gate's order and must stay in step with it.
func natValuePrim(which) {
    let s = natNewEmitter(0)
    if (which == 0) { s = natStoreStack(s, natRegRAX(), 0) }
    if (which == 1) { s = natLoadStack(s, natRegRAX(), 0) }
    if (which == 2) { s = natLoadStack(s, natRegRAX(), 8) }
    if (which == 3) { s = natStoreStack(s, natRegRAX(), 8) }
    // 616 is the real frame size of the one-local reference program, so the
    // wide-displacement path is exercised with a value that actually occurs.
    if (which == 4) { s = natStoreStack(s, natRegRAX(), 616) }
    if (which == 5) { s = natSubRegImm32(s, natRegRSP(), 616) }
    if (which == 6) { s = natAddRegImm32(s, natRegRSP(), 616) }
    // 16 fits in a signed byte, so this is the short (83 /digit ib) form. The
    // oracle picks the short form too, and picking the wide one instead would
    // be a different image.
    if (which == 7) { s = natSubRegImm32(s, natRegRSP(), 16) }
    if (which == 8) { s = natAddRegImm32(s, natRegRSP(), 16) }
    if (which == 9) { s = natXorRegReg(s, natRegRAX()) }
    if (which == 10) { s = natRet(s) }
    // Phase 151A Step 2 additions, in the gate's order.
    if (which == 11) { s = natNegReg(s, natRegRAX()) }
    if (which == 12) { s = natCmpRegReg(s, natRegRAX(), natRegRCX()) }
    if (which == 13) { s = natMovRegReg(s, natRegRAX(), natRegRCX()) }
    if (which == 14) { s = natMulRegReg(s, natRegRAX(), natRegRCX()) }
    return natToHex(natFinish(s))
}

// Registers, matching the oracle's Reg constants.
func natRegRCX() { return 1 }

// RDI is the first System V integer argument register, and the only argument
// register the Linux exit tail needs (the exit status). The oracle's Reg
// numbering is the architectural one, so RDI is 7 -- the accessor is named
// rather than written as the literal so the gate can pin it against
// pkg/native.RDI independently.
func natRegRDI() { return 7 }

// Phase 151A Step 5: the registers the Windows bootstrap walks over. RBX, RBP
// and R8-R11 are callee-saved under BOTH System V and Win64, which is why the
// oracle can hold the walk cursor, the module base and the export pointers in
// them across the whole pre-main sequence.
//
// The numbering is architectural and must match pkg/native exactly: R8-R11 are
// 8..11, and ModRM uses the low three bits, which is why natRegExt returns 1 for
// them.
func natRegRDX() { return 2 }
func natRegRSI() { return 6 }
func natRegRBX() { return 3 }
func natRegRBP() { return 5 }
func natRegR8()  { return 8 }
func natRegR9()  { return 9 }
func natRegR10() { return 10 }
func natRegR11() { return 11 }

// ============================================================
// Phase 151A Step 7 -- int `print`.
//
// The first kcc value-model surface that makes a real program's OUTPUT
// observable. Everything before this slice could compute a value and could
// enter and exit the image, but a kcc-compiled program could not say anything,
// so whole-image parity against the Go engine was untestable for want of
// anything to compare.
//
// This mirrors emitHelpers' print_int in pkg/native/program.go instruction
// for instruction, in the same order, because the oracle's order is not
// incidental: the digit pointer walks DOWN from the buffer end so no length
// has to be computed before the digits exist, and the sign is written from a
// separate pushed copy because the write syscall clobbers volatile registers.
// ============================================================

// natSysWrite is the Linux write(2) syscall number. macOS uses 0x2000004 and is
// not implemented here; the Linux exit tail's 60 (__NR_exit) is spelled as a
// literal in natStartStub for the same reason.
func natSysWrite() { return 1 }

// natRodataRef emits `mov r64, <absolute rodata address>` as a placeholder plus
// a recorded patch position, mirroring rodataRef's imm64Patch+internRodata.
//
// The bytes here are therefore NOT the oracle's final bytes -- the oracle
// resolves the placeholder to a real rodata address at link time, and so does
// this. The differential that matters for this slice is over the instruction
// SEQUENCES, and natPrintIntCorpus arm 2 exists to pin the placeholder form
// itself so it cannot be quietly changed into something that resolves locally.
func natRodataRef(s, r) {
    let p = natImm64Patch(s, natMovImm64Op(r))
    return p[0]
}

// natWriteStdout emits the Linux payload write for (RDI=fd, RSI=ptr, RDX=len)
// through the raw syscall, mirroring emitWrite's non-Windows body.
//
// Raw emitter calls on purpose, exactly as the oracle's own body insists:
// emitWrite is what Step 4 called natSyscall, and routing the syscall back
// through a helper that is itself named write is how the 148C replaceAll once
// produced infinite self-recursion.
func natWriteStdout(s) {
    s = natMovRegImm32(s, natRegRAX(), natSysWrite())
    return natSyscall(s)
}

// natPrintNewline mirrors printNewline: a one-byte rodata reference plus the
// payload write. RDI is still 1 from the preceding payload write.
func natPrintNewline(s) {
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    return natWriteStdout(s)
}

// natPrintIntHelper mirrors emitHelpers' print_int body byte for byte.
//
// Contract: RDI carries the value, output is decimal text plus a newline on
// stdout. The 64 bytes reserved below RSP are the digit buffer; the pointer
// starts at the TOP of that buffer and walks down, which is why no count is
// needed up front.
func natPrintIntHelper() {
    let s = natNewEmitter(0)
    s = natMark(s, "print_int")
    s = natSubRegImm32(s, natRegRSP(), 64)
    s = natMovRegReg(s, natRegRAX(), natRegRDI())
    s = natMovRegReg(s, natRegRSI(), natRegRSP())
    s = natAddRegImm32(s, natRegRSI(), 64)
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJns(s, "print_int_pos")
    s = natNegReg(s, natRegRAX())
    // RSI (the digit pointer) and RAX (the magnitude) are pushed across the
    // sign write, because the write syscall clobbers volatile registers and
    // both are needed by the digit loop below.
    s = natPushReg(s, natRegRAX())
    s = natPushReg(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natRodataRef(s, natRegRSI())
    s = natWriteStdout(s)
    s = natPopReg(s, natRegRSI())
    s = natPopReg(s, natRegRAX())
    s = natMark(s, "print_int_pos")
    s = natMovRegImm32(s, natRegRCX(), 10)
    s = natMark(s, "print_int_loop")
    s = natCqo(s)
    s = natDivReg(s, natRegRCX())
    s = natAddRegImm32(s, natRegRDX(), 48)   // 48 is '0'
    s = natDecReg(s, natRegRSI())
    s = natStoreMem8(s, natRegRSI(), natRegRDX())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "print_int_loop")
    s = natMovRegReg(s, natRegRBX(), natRegRSP())
    s = natAddRegImm32(s, natRegRBX(), 64)
    s = natMovRegReg(s, natRegRDX(), natRegRBX())
    s = natSubRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natPrintNewline(s)
    return natRet(s)
}

// natPrintCorpus renders the print_int helper in three shapes.
//
// Arm 0 is the whole helper with its two internal rel32 fixups resolved, which
// is the differential against the Go oracle. Arms 1 and 2 isolate the pieces a
// whole-helper comparison cannot blame on the right instruction when it fails:
// arm 1 is the digit loop alone (so a wrong divide or a missing sign extension
// fails there rather than somewhere inside 40 instructions), and arm 2 is a
// bare rodata reference (so the unresolved placeholder shape is pinned on its
// own, independently of the helper that uses it).
func natPrintCorpus(which) {
    if (which == 0) {
        return natToHex(natFinish(natPrintIntHelper()))
    }
    if (which == 1) {
        let s = natNewEmitter(0)
        s = natMark(s, "print_int_pos")
        s = natMovRegImm32(s, natRegRCX(), 10)
        s = natMark(s, "print_int_loop")
        s = natCqo(s)
        s = natDivReg(s, natRegRCX())
        s = natAddRegImm32(s, natRegRDX(), 48)
        s = natDecReg(s, natRegRSI())
        s = natStoreMem8(s, natRegRSI(), natRegRDX())
        s = natTestRegReg(s, natRegRAX(), natRegRAX())
        s = natJnz(s, "print_int_loop")
        return natToHex(natFinish(s))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
        s = natRodataRef(s, natRegRSI())
        return natToHex(natFinish(s))
    }
    return ""
}

// The three kernel32 IAT slots the bootstrap publishes, mirroring the constants
// in pkg/native/pe.go. Declared on both sides so a renumber on one side cannot
// silently disagree with the other.
func natIatExitProcess()  { return 0 }
func natIatGetStdHandle() { return 1 }
func natIatWriteFile()    { return 2 }

// ============================================================
// 6. Integer statement and expression lowering (Step 2)
//
// Every sequence below is the Go oracle's, in the oracle's order, and the gate
// compares the finished bytes against pkg/native. Each reference program's
// SHAPE is compiled in rather than parsed -- the convention 151B/151C/151C2/
// 151C3/Step 1 already use -- because no AST-driven native driver exists yet.
// That boundary is real and is not papered over: what is proven here is that
// these lowering SEQUENCES match the oracle byte for byte, not that kcc can
// yet parse a source file and lower it.
//
// The oracle's surface, and this file's, is deliberately NARROWER than the
// language, and the narrowing is preserved rather than "fixed":
//
//   * Integer arithmetic is +, - and * ONLY. The oracle's emitBinary refuses
//     every other operator, `/` included, with a loud K145. That refusal is
//     reproduced verbatim below rather than quietly implemented, because
//     implementing division here would be a NEW capability and not a port.
//   * A comparison is a BRANCH, not a value. emitCond sets flags and jumps on
//     the INVERSE condition; it never leaves a boolean in RAX. There is
//     therefore no boolean value to materialise on the native path, and
//     inventing one would also be a new capability.
//
// Operand staging is the Phase-147 rule: the LEFT operand goes to the
// depth-indexed scratch slot, the right into RAX and then RCX, the left is
// reloaded into RAX, and the operation is applied. rsp never moves.
// ============================================================

// natIntRefusal reproduces the oracle's refusals for integer operators it does
// not lower. These are DATA on the measurement surface rather than build
// failures, so the gate can assert kcc refuses exactly what the oracle does.
func natIntRefusal(which) {
    if (which == 0) { return "error[K145]: unsupported operator '/' (want +, - or *)" }
    if (which == 1) { return "error[K145]: unsupported operator '%' (want +, - or *)" }
    if (which == 2) { return "error[K145]: condition must be a comparison (==, !=, <, <=, >, >=) over ints or floats" }
    if (which == 3) { return "error[K145]: expression nesting exceeds 64 binary levels" }
    // Step 2b: the `?` propagation operator is REFUSED by the oracle, not
    // lowered. `?` desugars to *parser.PropagateExpr and there is no
    // PropagateExpr case anywhere in pkg/native -- the native value model has
    // no Result/Option representation, so there is nothing to propagate to.
    // Implementing it here would be a NEW capability, not a port, so it stays
    // a refusal.
    //
    // The two messages DIFFER, and the difference is load-bearing rather than
    // cosmetic: a `?` in RETURN position is refused by retKindOfExpr during
    // kind inference, which runs before emitExpr, so it never reaches the
    // emission site's own wording.
    if (which == 4) { return "error[K145]: unsupported expression *parser.PropagateExpr" }
    if (which == 5) { return "error[K145]: unsupported return expression *parser.PropagateExpr" }
    return ""
}

// natIntBody emits the straight-line integer reference programs. The shape
// selector picks the program because the oracle's statement order is only
// correct for a known shape; nLocals sizes the frame exactly as the oracle's
// layout would.
//
// Prologue and epilogue are emitFunc: Mark(name), SubRsp(frame), body,
// XorRegReg(RAX) when no return was seen, Mark(name+"$ret"), AddRsp(frame),
// Ret(). The 150C callee-saved push/pop is emitted only for a function the
// register allocator claimed; no reference program here qualifies, so it is
// absent from BOTH sides -- a boundary, not an omission.
func natIntBody(shape, nLocals) {
    let f = natFrameLayout(8 * nLocals * natKindUnits(natKindInt()), 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]

    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), frame)
    let returned = 0

    // shape 0: let x = 42 ; return x   -- literal, store, load, return
    if (shape == 0) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 42)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 1: let a = 6 ; let b = 7 ; return a * b
    if (shape == 1) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 6)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 7)
        s = natStoreStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natLoadStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natMulRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 2: return -(3 + 4)   -- unary minus over a binary, so the nested
    // operand lands at depth 1 and gets its OWN scratch slot
    if (shape == 2) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natNegReg(s, natRegRAX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 3: return (2 + 3) * (10 - 4)   -- two nested binaries, depth 0 and 1
    if (shape == 3) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
        s = natStoreStack(s, natRegRAX(), bt + 1 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 1 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 10)
        s = natStoreStack(s, natRegRAX(), bt + 1 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 1 * 8)
        s = natSubRegReg(s, natRegRAX(), natRegRCX())
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natMulRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 4: a function body with NO return statement at all. The oracle's
    // `if !returned { XorRegReg(RAX) }` supplies the 0, and the same single
    // xor is what an explicit bare `return` produces (emitReturn's
    // `n.Value == nil` branch), so this one case covers both spellings.
    if (shape == 4) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        returned = 0
    }

    // shape 5: let x = 1 ; x = 2 ; return x   -- Step 2b. A bare assignment
    // to an EXISTING int local takes exactly the same lowering path as the
    // `let` that bound it: emitExprStmt evaluates the right side into RAX and
    // stores to the slot that is already there, so the frame is UNCHANGED at
    // one local. That "unchanged" is the property worth pinning -- a
    // reassignment allocates nothing -- and the gate's frame layer checks it.
    if (shape == 5) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 6: let x = 3 ; x = 4 ; return x + 1  -- Step 2b. A REASSIGNED local
    // read as a binary operand goes through the ordinary depth-indexed staging
    // path (shape 1), which is the point: being reassigned earlier must not put
    // the local on any different lowering than a freshly bound one.
    if (shape == 6) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }

    if (returned == 0) { s = natXorRegReg(s, natRegRAX()) }
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natIntExprCorpus renders the straight-line integer programs as hex.
func natIntExprCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natIntBody(0, 1))) }
    if (which == 1) { return natToHex(natFinish(natIntBody(1, 2))) }
    if (which == 2) { return natToHex(natFinish(natIntBody(2, 0))) }
    if (which == 3) { return natToHex(natFinish(natIntBody(3, 0))) }
    if (which == 4) { return natToHex(natFinish(natIntBody(4, 1))) }
    // Step 2b: the bare-assignment shapes. Both have one local, and the frame
    // layer independently recomputes that, so an accidental extra local would
    // show up as a frame mismatch rather than as plausible-looking bytes.
    if (which == 5) { return natToHex(natFinish(natIntBody(5, 1))) }
    if (which == 6) { return natToHex(natFinish(natIntBody(6, 1))) }
    return ""
}

// natIntCond emits a comparison in the oracle's emitCond shape: evaluate the
// left into the scratch slot, the right into RAX and then RCX, the left back
// into RAX, CmpRegReg, then jump to the false label on the INVERSE condition.
//
// The jump opcode is the oracle's mapping, verbatim:
//
//	==  jumps on Jnz (not equal)      !=  jumps on Jz  (equal)
//	<   jumps on Jge                  <=  jumps on Jg
//	>   jumps on Jle                  >=  jumps on Jl
//
// The scratch slot is passed in rather than recomputed, so this composes with
// whichever frame the enclosing function has.
func natIntCond(s, op, falseLabel, bt) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 5)
    s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 9)
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    if (op == 0) { return natJnz(s, falseLabel) }
    if (op == 1) { return natJz(s, falseLabel) }
    if (op == 2) { return natJge(s, falseLabel) }
    if (op == 3) { return natJg(s, falseLabel) }
    if (op == 4) { return natJle(s, falseLabel) }
    if (op == 5) { return natJl(s, falseLabel) }
    return s
}

// natIntIf emits an `if` with no else branch, in the oracle's emitIf order.
//
// The label NAMES and their order are part of the bytes, because a rel32
// displacement encodes the distance between the jump and its target, and
// because a rel32 is patched at Finish(). The oracle's fresh() allocates the
// ELSE label FIRST and the END label second, so ifelse$1 precedes ifend$2
// even though the jump to ifelse$1 appears before the jump to ifend$2. That
// counter order is reproduced here, not tidied.
func natIntIf(op) {
    let f = natFrameLayout(8, 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natIntCond(s, op, "ifelse$1", bt)
    // consequence: let x = 1
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    s = natJmp(s, "ifend$2")
    s = natMark(s, "ifelse$1")
    // alternative: let x = 2
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    s = natMark(s, "ifend$2")
    s = natXorRegReg(s, natRegRAX())
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natIntIfCorpus renders the six comparison operators. One program per
// operator, because the opcode is the only thing that varies and a single
// case would not prove the mapping.
func natIntIfCorpus(op) {
    return natToHex(natFinish(natIntIf(op)))
}

// ============================================================
// 7. Control-flow lowering: while / for / break / continue (Step 3)
// ============================================================
//
// The oracle's structure, reproduced from pkg/native:
//
//   emitWhile (program.go:3720)
//     loopLabel = fresh("while"); endLabel = fresh("whileend")
//     Mark(loopLabel); push loops{brk:endLabel, cont:loopLabel}
//     emitCond(cond, endLabel); body; pop
//     Jmp(loopLabel); Mark(endLabel)
//
//   emitFor (program.go:3742)
//     init (inline, BEFORE any label)
//     loopLabel = fresh("for"); postLabel = fresh("forpost"); endLabel = fresh("forend")
//     Mark(loopLabel); push loops{brk:endLabel, cont:POSTLabel}
//     cond (if present); body
//     Mark(postLabel); post; pop
//     Jmp(loopLabel); Mark(endLabel)
//
//   break    -> Jmp(loops[top].brk)   (program.go:3403)
//   continue -> Jmp(loops[top].cont)   (program.go:3409)
//
// Four facts the MEASURED label table settled, each recorded because it is
// easy to get wrong and each verified against the oracle rather than assumed:
//
//  1. `fresh()` is ONE counter shared by every prefix, and it is incremented
//     where the construct is ENTERED, not where it is emitted. So a nested
//     loop numbers $3/$4 while its parent keeps $1/$2, and the parent's end
//     label -- emitted last -- is still the LOWER number.
//     Measured: nested_while has while$1=214, while$3=265, whileend$4=379,
//     whileend$2=418.
//  2. `for` allocates THREE labels in the order for, forpost, forend, so the
//     POST label is $2 and the END label is $3. Reading it as
//     for/forend/forpost renumbers every jump in the program.
//  3. `break` targets the loop's END label; `continue` targets the loop's
//     continuation label, which is the HEAD for `while` and the POST label
//     for a C-style `for`. That asymmetry is the oracle's (loops[] carries
//     cont:postLabel for `for`, program.go:3752) and is why a `continue` in a
//     `for` still runs the post clause.
//  4. An `if` inside a loop allocates BOTH of its labels even with no else
//     branch, and with an empty consequence they land on the SAME offset.
//     Measured: while_break has ifelse$3 == ifend$4 == 315.
//
// Operand lowering is UNCHANGED from Step 2: the left operand is staged in the
// depth-indexed scratch slot, the right is evaluated into RAX and moved to
// RCX, the left is reloaded, and the operation is applied. A loop changes
// nothing about that, because the scratch slot is written before it is read on
// every iteration. rsp never moves.
//
// emitCond passes depth 1 to emitExpr for its operands but stores the staged
// left operand at b.binTemp (the region START, depth 0), which is why the
// condition and a depth-0 body expression share the same scratch slot.

// natLoopOpAdd is the only binary operator the reference programs use in a
// loop body. It reuses natAddRegReg, the Step 2 primitive.
func natLoopOpAdd() { return 0 }

// natLoopStageLocal parks the LEFT operand of a comparison or an assignment:
// read the local, store it into the depth-indexed scratch slot.
func natLoopStageLocal(s, slot, bt, depth) {
    s = natLoadStack(s, natRegRAX(), slot)
    s = natStoreStack(s, natRegRAX(), bt + depth * 8)
    return s
}

// natLoopStageLit parks a LITERAL left operand by the same two instructions,
// so a condition over two constants has the same shape as one over a local.
func natLoopStageLit(s, v, bt, depth) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), v)
    s = natStoreStack(s, natRegRAX(), bt + depth * 8)
    return s
}

// natLoopLit emits a literal into RAX. Used as a RIGHT operand, which is
// never staged: it goes straight to RAX and then to RCX.
func natLoopLit(s, v) {
    return natMovImm64(s, natMovImm64Op(natRegRAX()), v)
}

// natLoopLoad emits an identifier read into RAX. Used as a RIGHT operand.
func natLoopLoad(s, slot) {
    return natLoadStack(s, natRegRAX(), slot)
}

// natLoopFinishCmp completes `staged <cmp> rightInRax` and branches to
// falseLabel on the INVERSE condition, exactly as natIntCond does. The cmp
// MUST precede the branch: a branch ahead of its cmp is a correct-looking
// sequence testing stale flags.
func natLoopFinishCmp(s, op, falseLabel, bt, depth) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + depth * 8)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    if (op == 0) { return natJnz(s, falseLabel) }
    if (op == 1) { return natJz(s, falseLabel) }
    if (op == 2) { return natJge(s, falseLabel) }
    if (op == 3) { return natJg(s, falseLabel) }
    if (op == 4) { return natJle(s, falseLabel) }
    if (op == 5) { return natJl(s, falseLabel) }
    return s
}


// natLoopFinishAdd completes `staged + rightInRax`, the Step 2 binary shape.
func natLoopFinishAdd(s, bt, depth) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + depth * 8)
    return natAddRegReg(s, natRegRAX(), natRegRCX())
}

// natLoopCondLocal emits `local <op> literal`, the condition shape every
// reference loop uses. The false label is the loop's END label, because that
// is what the oracle passes to emitCond.
func natLoopCondLocal(s, op, falseLabel, bt, slot, lit) {
    s = natLoopStageLocal(s, slot, bt, 0)
    s = natLoopLit(s, lit)
    return natLoopFinishCmp(s, op, falseLabel, bt, 0)
}

// natLoopAssignAddLit emits `slot = src + lit`, the reassignment shape Step 2b
// established: evaluate the right side into RAX, then store to the slot that
// already exists. The frame does not change.
func natLoopAssignAddLit(s, bt, slot, srcSlot, lit) {
    s = natLoopStageLocal(s, srcSlot, bt, 0)
    s = natLoopLit(s, lit)
    s = natLoopFinishAdd(s, bt, 0)
    s = natStoreStack(s, natRegRAX(), slot)
    return s
}

// natLoopAssignAddLocal emits `dst = src + other`, where the right operand is
// a local rather than a literal. Same staging, different right-operand source.
func natLoopAssignAddLocal(s, bt, dst, src, other) {
    s = natLoopStageLocal(s, src, bt, 0)
    s = natLoopLoad(s, other)
    s = natLoopFinishAdd(s, bt, 0)
    s = natStoreStack(s, natRegRAX(), dst)
    return s
}

// natLoopLet emits `let slot = v`.
func natLoopLet(s, slot, v) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), v)
    s = natStoreStack(s, natRegRAX(), slot)
    return s
}

// natLoopEpilogue closes a reference program: the `return slot` read, the jmp
// to the $ret label the oracle emits after EVERY return, the $ret mark, and
// the frame teardown. Every reference program here returns explicitly, so the
// `if !returned` xor of Step 2 does not apply.
func natLoopEpilogue(s, frame, retSlot) {
    s = natLoadStack(s, natRegRAX(), retSlot)
    s = natJmp(s, "karkain_main$ret")
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natLoopFrame computes the reference frame for a function with nLocals int
// locals: locals, binTemp, no strTemp, no mapStage, no extras, Linux (no
// 16-byte rounding), plus the fixed arg spill.
func natLoopFrame(nLocals) {
    let f = natFrameLayout(8 * nLocals * natKindUnits(natKindInt()), 0, 0, 0, 0, 0)
    return f
}

// natLoopPrologue emits Mark(karkain_main) + SubRsp(frame).
func natLoopPrologue(nLocals) {
    let f = natLoopFrame(nLocals)
    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), f[natFrFrame()])
    return s
}


// ------------------------------------------------------------
// The ten reference programs, in the corpus order the gate uses.
//
// Slot assignment is the oracle's: locals are numbered in DECLARATION order,
// so in `let i = 0 ; let s = 0` i is slot 0 and s is slot 1. The `for` init's
// `let i` is declared AFTER `let s`, which is why for_full has s at slot 0.
// ------------------------------------------------------------

// natLoopWhileSimple: let i = 0 ; while i < 5 { i = i + 1 } ; return i
// Measured: frame 616 (1 local), while$1=199, whileend$2=274, $ret=283.
func natLoopWhileSimple() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 5)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopWhileArith: let i = 0 ; let s = 0 ;
//   while i < 5 { s = s + i ; i = i + 1 } ; return s
// Measured: frame 624 (2 locals), while$1=214, whileend$2=319, $ret=329.
func natLoopWhileArith() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, s0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 5)
    // s = s + i : the RIGHT operand is a local here, not a literal
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, s0)
}

// natLoopWhileBreak: let i = 0 ; while i < 10 { i = i + 1 ; if i == 5 { break } }
//   ; return i
// Measured: frame 616 (1 local), while$1=199, whileend$2=320,
//           ifelse$3=315, ifend$4=315, $ret=329.
//
// The break jumps to whileend$2 -- the loop's END label, not the head. The
// `if` allocates ifelse$3 and ifend$4 AFTER the while's own two labels,
// because the shared counter is incremented at loop ENTRY.
func natLoopWhileBreak() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 10)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    // if i == 5 { break }
    s = natLoopCondLocal(s, 0, "ifelse$3", bt, i0, 5)
    s = natJmp(s, "whileend$2")
    // emitIf's own unconditional jump to the end label, BEFORE Mark(ifelse$3).
    // It is 5 bytes and it is easy to miss: the `if` has no else branch, so the
    // next two marks land on the SAME offset and the jump reads like a no-op.
    s = natJmp(s, "ifend$4")
    s = natMark(s, "ifelse$3")
    s = natMark(s, "ifend$4")
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopWhileContinue: let i = 0 ; let s = 0 ;
//   while i < 6 { i = i + 1 ; if i == 3 { continue } ; s = s + i } ; return s
// Measured: frame 624 (2 locals), while$1=214, whileend$2=365,
//           ifelse$3=330, ifend$4=330, $ret=375.
//
// The continue jumps back to while$1 -- the loop HEAD. Continuing to the end
// label would exit the loop, so the two targets are not interchangeable.
func natLoopWhileContinue() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, s0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 6)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    // if i == 3 { continue }
    s = natLoopCondLocal(s, 0, "ifelse$3", bt, i0, 3)
    s = natJmp(s, "while$1")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$4")
    s = natMark(s, "ifelse$3")
    s = natMark(s, "ifend$4")
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, s0)
}


// natLoopForSimple: let i = 0 ; for (i = 0; i < 5; i = i + 1) { } ; return i
// Measured: frame 616 (1 local), for$1=213, forpost$2=249, forend$3=288, $ret=297.
//
// The init clause is emitted BEFORE for$1 is marked. It is a bare assignment to
// an already-bound local, so it lowers exactly like Step 2b shape 5 and the
// frame does NOT grow.
func natLoopForSimple() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    // for init: i = 0
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 5)
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopForFull: let s = 0 ; for (let i = 0; i < 5; i = i + 1) { s = s + i }
//   ; return s
// Measured: frame 624 (2 locals), for$1=214, forpost$2=280, forend$3=321, $ret=330.
//
// s is slot 0 and i is slot 1, because `let s` is declared first and the
// for-init's `let i` second.
func natLoopForFull() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, s0, 0)
    // for init: let i = 0
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 5)
    // body: s = s + i
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    // forpost$2: the post clause, AFTER the body
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, s0)
}

// natLoopForBreak: let i = 0 ; for (i = 0; i < 10; i = i + 1) { if i == 5 { break } }
//   ; return i
// Measured: frame 616 (1 local), for$1=213, forpost$2=295, forend$3=334,
//           ifelse$4=295, ifend$5=295, $ret=343.
//
// The break targets forend$3. Note ifelse$4 / ifend$5 / forpost$2 all share
// offset 295: the if's consequence is a single break, the alternative is empty,
// and the post label immediately follows the body.
func natLoopForBreak() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 10)
    // if i == 5 { break }
    s = natLoopCondLocal(s, 0, "ifelse$4", bt, i0, 5)
    s = natJmp(s, "forend$3")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$5")
    s = natMark(s, "ifelse$4")
    s = natMark(s, "ifend$5")
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopForContinue: let s = 0 ; for (let i = 0; i < 6; i = i + 1) {
//   if i == 3 { continue } ; s = s + i } ; return s
// Measured: frame 624 (2 locals), for$1=214, forpost$2=327, forend$3=368,
//           ifelse$4=298, ifend$5=298, $ret=377.
//
// THE ASYMMETRY CASE: here `continue` targets forpost$2, NOT for$1, because
// a C-style for's continuation label is its post clause (program.go:3752
// pushes loopTgt{brk: endLabel, cont: postLabel}). Jumping to the head would
// skip the increment and loop forever.
func natLoopForContinue() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, s0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 6)
    // if i == 3 { continue }
    s = natLoopCondLocal(s, 0, "ifelse$4", bt, i0, 3)
    s = natJmp(s, "forpost$2")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$5")
    s = natMark(s, "ifelse$4")
    s = natMark(s, "ifend$5")
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, s0)
}


// natLoopNestedWhile: let i = 0 ; let t = 0 ;
//   while i < 3 { let j = 0 ; while j < 2 { t = t + 1 ; j = j + 1 } ; i = i + 1 }
//   ; return t
// Measured: frame 632 (3 locals), while$1=214, while$3=265,
//           whileend$4=379, whileend$2=418, $ret=428.
//
// THREE locals (i, t, j) -- the inner `let j` is declared inside the outer
// body but still occupies a frame slot. The OUTER end label is $2 even though
// it is marked last, because fresh() allocated it when the outer loop was
// entered. Nesting is what proves the counter is shared, not per-prefix.
func natLoopNestedWhile() {
    let f = natLoopFrame(3)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let t0 = natLocalOff(1, natKindInt())
    let j0 = natLocalOff(2, natKindInt())
    let s = natLoopPrologue(3)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, t0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 3)
    // outer body prologue: let j = 0
    s = natLoopLet(s, j0, 0)
    s = natMark(s, "while$3")
    s = natLoopCondLocal(s, 2, "whileend$4", bt, j0, 2)
    s = natLoopAssignAddLit(s, bt, t0, t0, 1)
    s = natLoopAssignAddLit(s, bt, j0, j0, 1)
    s = natJmp(s, "while$3")
    s = natMark(s, "whileend$4")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, t0)
}

// natLoopNestedForWhile: let t = 0 ; for (let i = 0; i < 2; i = i + 1) {
//   let j = 0 ; while j < 2 { t = t + 1 ; j = j + 1 } } ; return t
// Measured: frame 632 (3 locals), for$1=214, forpost$2=378, forend$3=419,
//           while$4=266, whileend$5=378, $ret=428.
//
// A `for` OUTER and a `while` INNER, which is the case that pins BOTH shared-
// counter rules at once: the for takes $1/$2/$3 and the while, entered later,
// continues the same counter at $4/$5 rather than restarting.
func natLoopNestedForWhile() {
    let f = natLoopFrame(3)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let t0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let j0 = natLocalOff(2, natKindInt())
    let s = natLoopPrologue(3)
    s = natLoopLet(s, t0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 2)
    s = natLoopLet(s, j0, 0)
    s = natMark(s, "while$4")
    s = natLoopCondLocal(s, 2, "whileend$5", bt, j0, 2)
    s = natLoopAssignAddLit(s, bt, t0, t0, 1)
    s = natLoopAssignAddLit(s, bt, j0, j0, 1)
    s = natJmp(s, "while$4")
    s = natMark(s, "whileend$5")
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, t0)
}

// natLoopLabels reports the label NAMES each reference program uses, in
// allocation order, so the gate can pin the fresh() numbering as DATA.
//
// A rel32 encodes only a displacement, so a renumbered label can produce a
// byte stream that is coincidentally equal -- the displacement might come out
// the same. The names are the layer that catches that, and they are why this
// surface reports labels separately from code.
func natLoopLabels(which) {
    if (which == 0) { return "while$1 whileend$2" }
    if (which == 1) { return "while$1 whileend$2" }
    if (which == 2) { return "while$1 whileend$2 ifelse$3 ifend$4" }
    if (which == 3) { return "while$1 whileend$2 ifelse$3 ifend$4" }
    if (which == 4) { return "for$1 forpost$2 forend$3" }
    if (which == 5) { return "for$1 forpost$2 forend$3" }
    if (which == 6) { return "for$1 forpost$2 forend$3 ifelse$4 ifend$5" }
    if (which == 7) { return "for$1 forpost$2 forend$3 ifelse$4 ifend$5" }
    if (which == 8) { return "while$1 whileend$2 while$3 whileend$4" }
    if (which == 9) { return "for$1 forpost$2 forend$3 while$4 whileend$5" }
    return ""
}

// natLoopCorpus renders the ten control-flow reference programs as hex, in the
// same order the gate and the label corpus use.
func natLoopCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natLoopWhileSimple())) }
    if (which == 1) { return natToHex(natFinish(natLoopWhileArith())) }
    if (which == 2) { return natToHex(natFinish(natLoopWhileBreak())) }
    if (which == 3) { return natToHex(natFinish(natLoopWhileContinue())) }
    if (which == 4) { return natToHex(natFinish(natLoopForSimple())) }
    if (which == 5) { return natToHex(natFinish(natLoopForFull())) }
    if (which == 6) { return natToHex(natFinish(natLoopForBreak())) }
    if (which == 7) { return natToHex(natFinish(natLoopForContinue())) }
    if (which == 8) { return natToHex(natFinish(natLoopNestedWhile())) }
    if (which == 9) { return natToHex(natFinish(natLoopNestedForWhile())) }
    return ""
}

// ============================================================
// 7. The `_start` entry stub and the Linux exit tail
//
// The Go oracle emits `_start` first thing in pkg/native/program.go:
//
//	b.e.Mark("_start")
//	if b.goos == OSWindows { b.e.AndRspNeg16(); b.emitWinBootstrap() }
//	b.e.Call("karkain_main")
//	if b.goos == OSWindows { b.emitWindowsExit() } else {
//	    b.e.MovRegReg(RDI, RAX)
//	    b.e.MovRegImm32(RAX, b.sysExit())
//	    b.e.Syscall()
//	}
//
// This slice is the Linux half ONLY. The Windows alignment fix, the PEB
// bootstrap and the Windows exit tail are deliberately absent, and the macOS
// exit number is absent: each is separately recorded as open 151A work, and
// emitting them here would be inventing scope rather than porting it. The
// corpus therefore cannot be run -- it has no `main` body, no `print` and no
// arena -- and the gate claims BYTES, not execution.
//
// The `karkain_main` label is placed immediately after the tail, so the corpus
// is self-contained: natRel32 must still resolve a real forward reference,
// which is the property 151B introduced it for. The resulting displacement is
// therefore 10 -- offset(karkain_main)=15 minus offset(next instruction)=5 --
// which is a property of this corpus and NOT of a real image, where
// `karkain_main` sits at its own offset. The gate pins that arithmetic
// separately from the instruction bytes for exactly that reason. (This comment
// first said 12; the arithmetic is 15-5. The gate DERIVED 10 from the
// encodings and passed, so the wrong number was here, not there.)
func natStartStub() {
    let s = natNewEmitter(0)
    s = natMark(s, "_start")
    s = natCall32(s)
    let r = natRel32(s, "karkain_main")
    s = r[0]
    s = natMovRegReg(s, natRegRDI(), natRegRAX())
    // 60 is __NR_exit on Linux. macOS uses 0x2000001 and is out of scope.
    s = natMovRegImm32(s, natRegRAX(), 60)
    s = natSyscall(s)
    s = natMark(s, "karkain_main")
    return s
}

// natStartCorpus renders the `_start` stub, the syscall primitive alone, and
// the exit tail without its call -- three shapes so the gate can separate the
// instruction bytes from the rel32 fixup.
func natStartCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natStartStub())) }
    if (which == 1) {
        let s = natNewEmitter(0)
        return natToHex(natFinish(natSyscall(s)))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
        s = natMark(s, "_start")
        s = natMovRegReg(s, natRegRDI(), natRegRAX())
        s = natMovRegImm32(s, natRegRAX(), 60)
        s = natSyscall(s)
        return natToHex(natFinish(s))
    }
    return ""
}

// ============================================================
// Phase 151A Step 5 -- the Windows entry, the PEB bootstrap and
// the Win64 exit tail.
//
// This is the PE counterpart of natStartStub and the mirror image of
// emitWinBootstrap + emitWindowsExit in pkg/native/program.go, in the oracle order.
// The order is load-bearing:
//
//   1. `and rsp, -16` FIRST -- main frame math and every kernel32 call assume
//      rsp % 16 == 0 at the call.
//   2. The bootstrap, publishing ExitProcess/GetStdHandle/WriteFile into the IAT
//      before main can call any of them.
//   3. The call to karkain_main.
//   4. The Win64 exit tail, passing main return value to ExitProcess.
//
// The host loader maps the image and runs entry but does NOT snap the IAT on
// these minimal images (Phase 149: the slots keep their file contents at run
// time), which is why the bootstrap exists at all. RSP never moves.
// ============================================================

// natWinFoldCmp emits one WCHAR of the "kernel32.dll" comparison: load the
// 16-bit character at character-index k from the BaseDllName buffer, fold it
// to lowercase with 0x20, compare against the expected character, and branch to
// the walk next label on a mismatch.
//
// The fold is not cosmetic. Phase 149 read BaseDllName live from the PEB and it
// arrives UPPERCASE (KERNEL32.DLL), so an unfolded comparison against the
// lowercase spelling would never match and every program would take the Int3.
// Folding is a no-op for the digits and dots in this alphabet, which is why the
// oracle applies it unconditionally instead of branching per character class.
func natWinFoldCmp(s, k, ch) {
    s = natMovzxRegMem16(s, natRegR8(), natRegRDX(), k * 2)
    s = natOrRegImm8(s, natRegR8(), 32)
    s = natCmpRegImm32(s, natRegR8(), ch)
    return natJnz(s, "wk$next")
}

// natWinCmpPair emits one aligned character-pair comparison of an export name,
// branching to nextLbl on a mismatch.
//
// nextLbl is passed in rather than derived from `ch`: the oracle allocates a
// FRESH label set per resolve (b.fresh), so ExitProcess, GetStdHandle and
// WriteFile each own their labels. Reusing one set is not merely untidy -- the
// encoder rejects a duplicate label outright, which is how the gate's first
// draft of the oracle half failed with `duplicate label "exp$loop"`.
//
// An odd-length name's final pair has a ZERO high byte and is COMPARED against
// the string's NUL terminator, not skipped. Dropping it would let the walk match
// a shorter name.
func natWinCmpPair(s, k, ch, nextLbl) {
    s = natMovzxRegMem16(s, natRegR8(), natRegRDX(), k)
    s = natCmpRegImm32(s, natRegR8(), ch)
    return natJnz(s, nextLbl)
}

// natWinResolve emits one export-table walk resolving a kernel32 name, with R10
// holding the module base. It mirrors emitWinResolve exactly.
//
// loopLbl/nextLbl/doneLbl/failLbl are passed in so each of the three resolves
// owns a FRESH set, exactly as the oracle's b.fresh() does. The pair constants
// c0..c5 are the aligned 16-bit character pairs DERIVED FROM THE NAME STRING by
// the caller, not re-typed here: the gate recomputes them independently and a
// mistyped pair would otherwise agree with a second copy of the same typo.
//
// The export directory sits at NT+136 (COFF 24 + Optional 112); the +96 shape
// is the 32-bit header and reads garbage, measured in Phase 149. The resolved
// address moves RDX -> RAX before the store because 48 A3 is accumulator-only.
func natWinResolve(s, c0, c1, c2, c3, c4, c5, loopLbl, nextLbl, doneLbl, failLbl) {
    s = natLoadBaseOff32(s, natRegRCX(), natRegR10(), 60)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 136)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    s = natLoadBaseOff32(s, natRegR9(), natRegRDX(), 24)
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 32)
    s = natMovRegReg(s, natRegRSI(), natRegR10())
    s = natAddRegReg(s, natRegRSI(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 36)
    s = natMovRegReg(s, natRegRDI(), natRegR10())
    s = natAddRegReg(s, natRegRDI(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 28)
    s = natMovRegReg(s, natRegRBP(), natRegR10())
    s = natAddRegReg(s, natRegRBP(), natRegRCX())
    s = natMark(s, loopLbl)
    s = natTestRegReg(s, natRegR9(), natRegR9())
    s = natJz(s, failLbl)
    s = natLoadBaseOff32(s, natRegRCX(), natRegRSI(), 0)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    if (c0 != 0) { s = natWinCmpPair(s, 0, c0, nextLbl) }
    if (c1 != 0) { s = natWinCmpPair(s, 2, c1, nextLbl) }
    if (c2 != 0) { s = natWinCmpPair(s, 4, c2, nextLbl) }
    if (c3 != 0) { s = natWinCmpPair(s, 6, c3, nextLbl) }
    if (c4 != 0) { s = natWinCmpPair(s, 8, c4, nextLbl) }
    if (c5 != 0) { s = natWinCmpPair(s, 10, c5, nextLbl) }
    s = natMovzxRegMem16(s, natRegR8(), natRegRDI(), 0)
    s = natLoadScaled32(s, natRegRAX(), natRegRBP(), natRegR8(), 4, 0)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRAX())
    s = natMovRegReg(s, natRegRAX(), natRegRDX())
    let p = natStoreAbs64(s)
    s = p[0]
    s = natJmp(s, doneLbl)
    s = natMark(s, nextLbl)
    s = natAddRegImm32(s, natRegRSI(), 4)
    s = natAddRegImm32(s, natRegRDI(), 2)
    s = natDecReg(s, natRegR9())
    s = natJmp(s, loopLbl)
    s = natMark(s, failLbl)
    s = natInt3(s)
    s = natMark(s, doneLbl)
    return s
}

// natWinBootstrap emits the loader-independent kernel32 resolution, mirroring
// emitWinBootstrap. R10 keeps the module base across all three resolves.
//
// The module walk matches the NAME "kernel32.dll" and never a position: the
// entry list order is not stable across boots. The 64-entry bound is a backstop,
// not a heuristic. A missing module or an exhausted export walk reaches an Int3.
//
// Pair constants are the aligned 16-bit little-endian character pairs derived
// from each name: name[k] | name[k+1]<<8, with a zero high byte on the tail of an
// odd-length name. "ExitProcess" is 11 characters (6 pairs), "GetStdHandle" is 12
// (6 pairs, NO tail pair) and "WriteFile" is 9 (5 pairs, odd tail).
func natWinBootstrap(s) {
    s = natMovRegGsMem(s, natRegRAX(), 96)
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 24)
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 32)
    s = natMovRegImm32(s, natRegR11(), 64)
    s = natMark(s, "wk$walk")
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 0)
    s = natMovRegReg(s, natRegRBX(), natRegRAX())
    s = natSubRegImm32(s, natRegRBX(), 16)
    // 64-bit LDR_DATA_TABLE_ENTRY: DllBase at +0x30, BaseDllName at +0x58
    // (Length +0, Buffer +8). The 32-bit +0x28/+0x50 shape skips every module
    // into the Int3 -- measured in Phase 149.
    s = natMovzxRegMem16(s, natRegRCX(), natRegRBX(), 88)
    s = natCmpRegImm32(s, natRegRCX(), 24)
    s = natJnz(s, "wk$next")
    s = natLoadBaseOff(s, natRegRDX(), natRegRBX(), 96)
    s = natWinFoldCmp(s, 0, 107)
    s = natWinFoldCmp(s, 1, 101)
    s = natWinFoldCmp(s, 2, 114)
    s = natWinFoldCmp(s, 3, 110)
    s = natWinFoldCmp(s, 4, 101)
    s = natWinFoldCmp(s, 5, 108)
    s = natWinFoldCmp(s, 6, 51)
    s = natWinFoldCmp(s, 7, 50)
    s = natWinFoldCmp(s, 8, 46)
    s = natWinFoldCmp(s, 9, 100)
    s = natWinFoldCmp(s, 10, 108)
    s = natWinFoldCmp(s, 11, 108)
    s = natLoadBaseOff(s, natRegR10(), natRegRBX(), 48)
    s = natJmp(s, "wk$found")
    s = natMark(s, "wk$next")
    s = natDecReg(s, natRegR11())
    s = natJnz(s, "wk$walk")
    s = natMark(s, "wk$fail")
    s = natInt3(s)
    s = natMark(s, "wk$found")
    // "ExitProcess": E|x=0x7845 i|t=0x7469 P|r=0x7250 o|c=0x636F e|s=0x7365 s|\0=0x73
    s = natWinResolve(s, 30789, 29801, 29264, 25455, 29541, 115, "wx$loop$0", "wx$next$0", "wx$done$0", "wx$fail$0")
    // "GetStdHandle": G|e=0x6547 t|S=0x5374 t|d=0x6474 H|a=0x6148 n|d=0x646E l|e=0x656C
    // The H|a pair was FIRST written as 24896 = 0x6140, whose low byte is '@',
    // not 'H'. The oracle comparison caught it as a single differing byte in a
    // 982-byte shape -- the same one-digit class 152-B2 hit on a SHA-256 round
    // constant, and the reason this gate derives the pair table a third time.
    s = natWinResolve(s, 25927, 21364, 25716, 24904, 25710, 25964, "wx$loop$1", "wx$next$1", "wx$done$1", "wx$fail$1")
    // "WriteFile": W|r=0x7257 i|t=0x7469 e|F=0x4665 i|l=0x6C69 e|\0=0x65
    s = natWinResolve(s, 29271, 29801, 18021, 27753, 101, 0, "wx$loop$2", "wx$next$2", "wx$done$2", "wx$fail$2")
    return s
}

// natWinExitTail emits the Win64 exit tail: ExitProcess(main's return value).
// Win64 requires 32 bytes of caller shadow even for a single argument; the
// entry alignment itself is fixed by natAndRspNeg16 before the main call.
func natWinExitTail(s) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natSubRegImm32(s, natRegRSP(), 32)
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 0)
    return natCallReg(s, natRegRAX())
}

// natWinStub emits the complete Windows _start in the oracle order: alignment,
// bootstrap, call main, Win64 exit.
func natWinStub() {
    let s = natNewEmitter(0)
    s = natMark(s, "_start")
    s = natAndRspNeg16(s)
    s = natWinBootstrap(s)
    s = natCall32(s)
    let r = natRel32(s, "karkain_main")
    s = r[0]
    s = natWinExitTail(s)
    s = natMark(s, "karkain_main")
    return s
}

// natWinCorpus renders the Windows pieces separately as well as whole, so a
// failure names a SUBSYSTEM (bootstrap, resolve, exit tail) rather than pointing
// at one long sequence.
//
// Shape 0 is the whole _start; shape 1 the alignment fix alone; shape 2 one
// export resolve alone; shape 3 the Win64 exit tail alone. This is the same
// four-shape split natStartCorpus uses for the Linux entry.
func natWinCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natWinStub())) }
    if (which == 1) {
        let s = natNewEmitter(0)
        return natToHex(natFinish(natAndRspNeg16(s)))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
        s = natWinResolve(s, 30789, 29801, 29264, 25455, 29541, 115, "wx$loop$0", "wx$next$0", "wx$done$0", "wx$fail$0")
        return natToHex(natFinish(s))
    }
    if (which == 3) {
        let s = natNewEmitter(0)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natSubRegImm32(s, natRegRSP(), 32)
        return natToHex(natFinish(s))
    }
    return ""
}

// ============================================================
// Phase 151A Step 6 -- assemble a RUNNABLE PE from the Step-5 sequences.
//
// Everything below is TEST SCAFFOLDING for the Step-6 gate, not language
// implementation. It composes the already-byte-verified `_start` with a minimal
// synthetic main body and links it through kcc's OWN natPELink, so the image is
// produced by the self-hosted engine and not by the Go oracle.
//
// The synthetic main body is deliberately the smallest thing that exercises
// startup and exit integration:
//
//	mov rax, <code>
//	ret
//
// It uses no frame slot, no allocator, no print and no stack, so it requires
// nothing from the value model that later 151A work still owes. It is NOT print,
// NOT print_float and NOT a general calling convention -- it is a return value.
//
// `code` is the process exit status, which is how the Win64 exit tail is
// observable: _start passes main's RAX to ExitProcess.
// ============================================================

// natWinExe assembles _start + a synthetic main and links a PE image.
//
// The patch bookkeeping is the whole point. The bootstrap stores three resolved
// kernel32 addresses with `mov [imm64], rax` (natStoreAbs64) and the exit tail
// loads ExitProcess with `movabs rax, <slot>`; both are LINK-TIME placeholders.
// Positions are recorded in the emitter's imm64 slot in emission order:
// ExitProcess, GetStdHandle, WriteFile, then the exit call. natPELink takes
// flat [pos, index] pairs, so those four become three apatches and one ipatch.
func natWinExe(code) {
    let s = natWinStub()
    // The synthetic main, emitted after the karkain_main label natWinStub left.
    s = natMovRegImm32(s, natRegRAX(), code)
    s = natRet(s)
    let text = natFinish(s)
    let p = natStImm64(s)
    let ap = []
    ap = appendArray(ap, p[0])
    ap = appendArray(ap, natIatExitProcess())
    ap = appendArray(ap, p[1])
    ap = appendArray(ap, natIatGetStdHandle())
    ap = appendArray(ap, p[2])
    ap = appendArray(ap, natIatWriteFile())
    let ip = []
    ip = appendArray(ip, p[3])
    ip = appendArray(ip, natIatExitProcess())
    return natToHex(natPELink(text, [], [], [], ip, ap, [], natPETextOff(), natPETextOff()))
}

// natWinExeC assembles _start + a synthetic main that CALLS GetStdHandle.
//
// This is the Step-6 Case C body. It exists to prove the PEB bootstrap's export
// resolution actually produced a callable address for a SECOND API, not just the
// one the exit tail uses.
//
// It deliberately does NOT print. Implementing print is later 151A work and is
// out of scope here; calling the resolved GetStdHandle and surviving is the proof.
// If the bootstrap had published a bad address, this call would fault and the
// process would die with an access violation instead of exiting 0.
//
// The call follows the Win64 rules the oracle already established: rsp is 8 (mod
// 16) at main entry because _start aligned it and then called, so subtracting 40
// puts it at 0 (mod 16) at the call site, and 32 of that is caller shadow.
func natWinExeC() {
    let s = natWinStub()
    s = natSubRegImm32(s, natRegRSP(), 40)
    // STD_OUTPUT_HANDLE is -11; MovRegImm32 writes it as the 32-bit constant the
    // oracle uses, which is what the kernel32 stub reads.
    s = natMovRegImm32(s, natRegRCX(), 4294967285)
    s = natIatCall(s, natRegRAX(), natIatGetStdHandle())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 40)
    s = natMovRegImm32(s, natRegRAX(), 0)
    s = natRet(s)
    let text = natFinish(s)
    let p = natStImm64(s)
    let ap = []
    ap = appendArray(ap, p[0])
    ap = appendArray(ap, natIatExitProcess())
    ap = appendArray(ap, p[1])
    ap = appendArray(ap, natIatGetStdHandle())
    ap = appendArray(ap, p[2])
    ap = appendArray(ap, natIatWriteFile())
    let ip = []
    ip = appendArray(ip, p[3])
    ip = appendArray(ip, natIatExitProcess())
    ip = appendArray(ip, p[4])
    ip = appendArray(ip, natIatGetStdHandle())
    return natToHex(natPELink(text, [], [], [], ip, ap, [], natPETextOff(), natPETextOff()))
}

// natIatCall emits `movabs rax, <IAT slot>` + `call rax`, the Win64 import call
// shape the oracle's iatCall produces. The placeholder position is recorded so
// natPELink can resolve it against .idata.
func natIatCall(s, reg, slot) {
    s = natMovImm64(s, natMovImm64Op(reg), 0)
    return s
}
// ============================================================
// Phase 151A Step 8b - print_float
//
// This mirrors Builder.emitPrintFloatHelper in pkg/native/program.go
// (lines 4185-4390) instruction for instruction and IN THE SAME ORDER. The
// order is load-bearing twice over:
//
//   - the Go helper interleaves writes with live values, and several of those
//     values are parked in the frame rather than a register. The frame map is
//     rsp+0..5 fraction digits, rsp+8..15 the R11 digit count (across the "."
//     write), rsp+16..23 the fraction bit pattern, rsp+24..31 the integer part,
//     rsp+45..63 the integer digit buffer. RCX/RAX/RDX are volatile at BOTH the
//     Win64 kernel32 boundary and the raw syscall -- the syscall itself assigns
//     RCX the return RIP -- so a caller-saved park is not enough in either
//     container. Parking the integer part is what makes NEGATIVE values
//     correct: the sign write would otherwise clobber RCX before it is read.
//   - every fresh() label is allocated at the point the Go helper allocates it.
//     Label NAMES do not affect a single byte, but the ORDER of the marks does,
//     because the rel32 displacements are computed from positions.
//
// The writes go through natWriteStdout, which is the Linux syscall form, so
// this corpus is Linux by construction exactly as Step 7's is.

// natPrintFloatHelper emits the whole print_float helper.
func natPrintFloatHelper() {
    let s = natNewEmitter(0)
    s = natMark(s, "print_float")
    s = natSubRegImm32(s, natRegRSP(), 64)
    s = natMovRegReg(s, natRegRAX(), natRegRDI())
s = natMovRegImm64(s, natRegRCX(), 0 - 9223372036854775807 - 1)
    s = natMovRegReg(s, natRegR11(), natRegRAX())
    s = natAndRegReg(s, natRegR11(), natRegRCX())
    s = natMovRegImm64(s, natRegRCX(), 9223372036854775807)
    s = natAndRegReg(s, natRegRAX(), natRegRCX())
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natShrRegImm(s, natRegRCX(), 52)
    s = natMovRegImm32(s, natRegR10(), 2047)
    s = natAndRegReg(s, natRegRCX(), natRegR10())
    s = natCmpRegImm32(s, natRegRCX(), 2047)
    s = natJz(s, "fltsp")
    s = natJmp(s, "fltfin")
    s = natMark(s, "fltsp")
    s = natMovRegImm64(s, natRegR10(), 4503599627370495)
    s = natAndRegReg(s, natRegRAX(), natRegR10())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltnan")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnoinf")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnoinf")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 3)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natRet(s)
    s = natMark(s, "fltnan")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnonan")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnonan")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 3)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natRet(s)
    s = natMark(s, "fltfin")
    s = natMovXmmRegGp(s, 0, natRegRAX())
    s = natCvttsd2siGpXmm(s, natRegRCX(), 0)
    s = natCvtsi2sdXmmGp(s, 1, natRegRCX())
    s = natSubsdXmmXmm(s, 0, 1)
    s = natMovGpRegXmm(s, natRegRAX(), 0)
    s = natStoreStack(s, natRegRAX(), 16)
    s = natStoreStack(s, natRegRCX(), 24)
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnosign")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnosign")
    s = natLoadStack(s, natRegRAX(), 24)
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltintnz")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natJmp(s, "fltintdone")
    s = natMark(s, "fltintnz")
    s = natMovRegImm32(s, natRegR10(), 10)
    s = natLeaRegStack(s, natRegRSI(), 64)
    s = natMark(s, "fltintloop")
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRDX(), 48)
    s = natDecReg(s, natRegRSI())
    s = natStoreMem8(s, natRegRSI(), natRegRDX())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltintloop")
    s = natLeaRegStack(s, natRegRBX(), 64)
    s = natMovRegReg(s, natRegRDX(), natRegRBX())
    s = natSubRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltintdone")
    s = natLoadStack(s, natRegRCX(), 16)
    s = natMovXmmRegGp(s, 0, natRegRCX())
    s = natMovRegImm64(s, natRegR10(), 4696837146684686336)
    s = natMovXmmRegGp(s, 1, natRegR10())
    s = natMulsdXmmXmm(s, 0, 1)
    s = natCvttsd2siGpXmm(s, natRegRCX(), 0)
    s = natMovRegImm32(s, natRegR10(), 100000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 0)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 10000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 1)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 1000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 2)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 100)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 3)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 10)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 4)
    s = natAddRegImm32(s, natRegRDX(), 48)
    s = natStoreMem8Off(s, natRegRDX(), natRegRSP(), 5)
    s = natMovRegImm32(s, natRegR11(), 6)
    s = natLeaRegStack(s, natRegRAX(), 0)
    s = natMark(s, "flttrim")
    s = natMovRegReg(s, natRegRCX(), natRegR11())
    s = natAddRegReg(s, natRegRAX(), natRegRCX())
    s = natMovzxRegMem8(s, natRegRCX(), natRegRAX(), -1)
    s = natLeaRegStack(s, natRegRAX(), 0)
    s = natCmpRegImm32(s, natRegRCX(), 48)
    s = natJnz(s, "flttrimdone")
    s = natDecReg(s, natRegR11())
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJnz(s, "flttrim")
    s = natMark(s, "flttrimdone")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnofrac")
    // The digit count lives in R11 across the "." write below, and a Win64
    // kernel32 call CLOBBERS R11 (caller-saved), so it is spilled and reloaded.
    // Without this the fraction write uses the clobbered count: on the raw
    // syscall path R11 happens to survive, so the bug is invisible on Linux,
    // but on Windows every float would print as a bare integer ("1.5" -> "1").
    s = natStoreStack(s, natRegR11(), 8)
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natLeaRegStack(s, natRegRSI(), 0)
    s = natLoadStack(s, natRegRDX(), 8)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnofrac")
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    return natRet(s)
}

// The sign-mask constant 1<<63 is written as 0 - 9223372036854775807 - 1
// rather than as the literal 9223372036854775808, and that is a CORRECTNESS
// requirement rather than a style choice.
//
// Karkain's integer surface is signed 64-bit, so the literal 9223372036854775808
// (which is 1<<63, one past the maximum) cannot be represented: the parser
// clamps it and natBytesLE then emits FF FF FF FF FF FF FF FF where the oracle
// emits 00 00 00 00 00 00 00 80. That is the 151B constant-class bug recurring
// in a new place -- a hand-written decimal that looks right and silently
// produces a different instruction, here `and r11, rcx` testing the wrong mask
// and therefore printing the wrong result for every negative float.
//
// Written as a negative it is exact, and natBytesLE masks each byte, so the
// arithmetic shift of a negative value yields the correct two's-complement
// bytes: (-1<<63) >> 56 = 0xFF..80, & 0xFF = 0x80.

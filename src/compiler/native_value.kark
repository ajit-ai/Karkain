// ============================================================
// Native VALUE and FRAME foundation (Phase 151A Step 1)
//
// The Karkain counterpart of the value/frame half of the Go oracle in
// pkg/native/program.go. The oracle is authoritative: this file is a PORT
// and must reproduce its conventions exactly, because increment 151's
// contract is that kcc's images are byte-identical to the Go oracle's.
//
// WHAT IS HERE, and nothing else:
//
//   1. The native value-kind model and kindUnits -- how many 8-byte frame
//      units a kind occupies.
//   2. The frame layout -- the ORDER and SIZING of the frame regions.
//   3. Local-slot addressing -- the byte offset of a local of a given kind.
//
// The code GENERATION that consumes these (int lowering, float, arrays,
// arena, strings, records, maps, the entry stub and syscall tails) is later
// 151A work and is deliberately absent. This slice's whole job is that the
// layout be right before any bytes depend on it.
//
// VALUES ARE STATICALLY KEDD AND UNBOXED. The roadmap's word "boxed" does
// NOT mean a tagged runtime Value here: the Go oracle assigns each local a
// compile-time kind and stores a raw 8-byte unit (or two, for string and
// array) at [rsp+off]. There is no tag word, and none is introduced. The
// TAGGED Value with TYPE_RESULT / resVal.tag belongs to the C path, which is
// a different model entirely (it is what the `?` operator inspects), and it
// must not leak into the native path.
//
// KindInt is 0 on purpose: the Go oracle makes it `iota` so that every
// pre-150 default -- an untyped parameter, a missing return, an unknown slot
// -- keeps meaning int without touching any of its logic. Every
// "cannot determine the kind" path in the oracle returns 0, so preserving
// that value is what keeps those paths working unchanged.
//
// STATE REPRESENTATION. Karkain has no structs, so the frame layout is
// returned as one array with fixed slots (natFr*), the same discipline
// native_emit.kark uses for the encoder and kir.kark uses for `lines`.
// ============================================================

// ============================================================
// 1. Value kinds and their unit widths.
// ============================================================

// natKindInt .. natKindMap mirror the Go oracle's KindInt..KindMap. The
// NUMBERS are the contract, because the oracle's `iota` numbering is what
// every default in its code compares against.
func natKindInt()    { return 0 }   // KindInt
func natKindString() { return 1 }   // KindString
func natKindFloat()  { return 2 }   // KindFloat
func natKindArray()  { return 3 }   // KindArray
func natKindStruct() { return 4 }   // KindStruct
func natKindMap()    { return 5 }   // KindMap

// natKindUnits returns the 8-byte frame/call slots a kind occupies.
//
//   int 1, float 1, bool 1 (a bool IS an int here), struct 1, map 1,
//   string 2, array 2.
//
// string and array are TWO units (ptr+len); everything else is one. This is
// the oracle's kindUnits verbatim. A record and a map are one unit because
// the value IS the address of the field area / arena header, so neither
// copies a byte when it is passed to a function.
func natKindUnits(kind) {
    if (kind == natKindString()) { return 2 }
    if (kind == natKindArray()) { return 2 }
    return 1
}

// natKindName renders a kind for diagnostics, matching the oracle's kindName.
func natKindName(kind) {
    if (kind == natKindString()) { return "string" }
    if (kind == natKindFloat()) { return "float" }
    if (kind == natKindArray()) { return "array" }
    if (kind == natKindStruct()) { return "struct" }
    if (kind == natKindMap()) { return "map" }
    return "int"
}

// ============================================================
// 2. Fixed frame-layout constants.
//
// These three are the oracle's, and they are load-bearing: changing any of
// them changes every image.
// ============================================================

// natArgSpillBytes is the fixed caller-side argument spill area: 6 args x
// (ptr+len) = 6 x 16 = 96 bytes, always reserved.
func natArgSpillBytes() { return 96 }

// natMaxBinDepth bounds nested binary-expression evaluation. It sizes
// binTemp, and it is a CONSTANT in the oracle (64), not a computed maximum:
// the frame must have the same size for every program so that a slot offset
// never depends on the program being compiled.
func natMaxBinDepth() { return 64 }

// natBinTempBytes is the binary-operand scratch area: 8 bytes per depth.
func natBinTempBytes() { return 8 * natMaxBinDepth() }

// natStrTempBytes is the string staging area: FIVE 8-byte units per nesting
// level. Five because a concat needs two operands, a result, and two length
// temporaries staged at once.
func natStrTempBytes() { return 8 * 5 * natMaxBinDepth() }

// natMapStageBytes is the single frame unit that carries a map key across the
// evaluation of its value.
func natMapStageBytes() { return 8 }

// ============================================================
// 3. The frame layout.
//
// Slot indices into the array returned by natFrameLayout:
//   0 localsEnd    1 binTemp   2 strTemp   3 mapStage
//   4 extrasBase   5 next      6 frame
// ============================================================

func natFrLocals()  { return 0 }
func natFrBinTemp() { return 1 }
func natFrStrTemp() { return 2 }
func natFrMapStage() { return 3 }
func natFrExtras() { return 4 }
func natFrNext()   { return 5 }
func natFrFrame()  { return 6 }

// natFrameLayout reproduces the oracle's layout() ordering and sizing for one
// function. Every parameter is a fact the oracle computed, so this function
// makes no decision of its own:
//
//   locals -> recArgAreas -> binTemp -> strTemp? -> mapStage? ->
//   extrasBase -> Windows 16-byte rounding -> + argSpillBytes
//
// Parameters, in the oracle's terms:
//   localBytes   the locals region already laid out (params first, then one
//                slot per let, strings and arrays taking two units each)
//   recArgBytes  Phase 150B3b record field areas for literals passed
//                straight to a call; 0 when the program has none
//   usesStr      true when the program has a concat / string-compare /
//                string-slice / push / string-field operation
//   usesMap      true when the program uses maps
//   maxExtra     the largest caller-side extras-unit count over this
//                function's call sites (Phase 148)
//   isWindows    whether the target is Windows
//
// strTemp and mapStage are CONDITIONAL in the oracle, and unconditionally
// reserving them would grow every frame that does not need them -- which
// would break the byte-identity of every image that does not use strings or
// maps. The conditionals are therefore part of the contract, not an
// optimisation, and they are reproduced exactly.
func natFrameLayout(localBytes, recArgBytes, usesStr, usesMap, maxExtra, isWindows) {
    let next = localBytes + recArgBytes
    next = next + natBinTempBytes()
    let strTemp = 0
    if (usesStr == 1) {
        strTemp = next
        next = next + natStrTempBytes()
    }
    let mapStage = 0
    if (usesMap == 1) {
        mapStage = next
        next = next + natMapStageBytes()
    }
    let extrasBase = next
    next = next + maxExtra * 8
    // Phase 149: Win64 calls fault on a misaligned stack, so the frame is
    // rounded to 16 on Windows. Linux never noticed, because syscalls do not
    // care -- and gating this on Windows is what keeps Linux images
    // byte-frozen.
    if (isWindows == 1) {
        if (next % 16 != 0) { next = next + 8 }
    }
    let frame = next + natArgSpillBytes()

    let f = []
    f = appendArray(f, localBytes)
    // binTemp is the region START, so an operand scratch slot is
    // binTemp + depth*8 and lands at localBytes+recArgBytes+depth*8. Recording
    // the region END here (localBytes+recArgBytes+binTempBytes) shifted every
    // staged operand by the whole scratch area -- 512 bytes -- which the
    // binary-expression differential caught immediately. Step 1 did not see it
    // because nothing emitted through binTemp and its layout corpus printed
    // only frame/strTemp/mapStage/slot offsets.
    f = appendArray(f, localBytes + recArgBytes)
    f = appendArray(f, strTemp)
    f = appendArray(f, mapStage)
    f = appendArray(f, extrasBase)
    f = appendArray(f, next)
    f = appendArray(f, frame)
    return f
}

// ============================================================
// 4. Local-slot addressing.
// ============================================================

// natLocalOff returns the byte offset of local `index` of `kind` within the
// locals region.
//
// Locals are laid out in declaration order with no gaps and no alignment
// padding: each occupies exactly kindUnits(kind) 8-byte units, so the offset
// of a unit-1 local is 8*index and the two-unit kinds simply consume two.
// That contiguity is why the oracle can address a slot with a compile-time
// displacement and never needs a relocation for it.
func natLocalOff(index, kind) {
    return 8 * index * natKindUnits(kind)
}

// ============================================================
// 5. The reference program bodies.
//
// Step 1's evidence is the machine code for the smallest programs that
// exercise a frame and a local slot. There is deliberately no helper, no
// `print`, no arena and no entry stub: those are later 151A work, and
// including them would make this slice's evidence depend on slices that do
// not exist yet.
//
// The two cases are:
//
//   one   `let x = 42`         one int local, stored, never read
//   two   `let x = 42; let y = x`   two int locals, load slot 0, store slot 1
//
// `two` is the case that actually proves the foundation: it emits a load and
// a store at two DIFFERENT compile-time displacements, so a wrong slot
// ordering, a wrong unit width or a wrong displacement form shows up as a
// different byte rather than as a coincidence.
// ============================================================

// The x86-64 register numbers, matching the Go oracle's Reg constants
// (RAX = 0 ...). They are named because a bare 0 or 4 in an encoder is a
// bug waiting to happen.
func natRegRAX() { return 0 }
func natRegRSP() { return 4 }

// natValueMain emits the body of `main` for the reference program.
// `nLocals` is 1 or 2; with 2 the second local copies the first.
//
// The sequence is the oracle's emitFunc prologue + one or two let
// lowerings + the return, and nothing else:
//
//   sub rsp, frame          prologue
//   mov rax, 42             the initialiser
//   mov [rsp+slot], rax     bind the local
//   mov rax, [rsp+slot]     (two locals only) read the first local
//   mov [rsp+slot+8], rax   bind the second local
//   xor rax, rax            the missing-return-yields-0 rule
//   add rsp, frame          epilogue
//   ret
func natValueMain(nLocals) {
    // One int local per declaration; int is one unit each, so the locals
    // region is 8 bytes per local. Computed through natKindUnits rather
    // than hard-coded, so the layout cannot drift away from the kind model.
    let localBytes = 8 * nLocals * natKindUnits(natKindInt())
    // recArgBytes 0 (no record literal is passed to a call),
    // usesStr 0 and usesMap 0 (no string or map operation exists yet, so
    // those two regions are NOT reserved -- the oracle's own conditionals),
    // maxExtra 0 (no call site), isWindows 0 (the reference case is Linux,
    // which never rounds).
    let f = natFrameLayout(localBytes, 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]

    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 42)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    if (nLocals == 2) {
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
    }
    s = natXorRegReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natValueLayoutCorpus reports the layout facts as text, so the gate can pin
// the frame arithmetic itself and not only the bytes it produced. These are
// the numbers the oracle computes for the same inputs; the gate derives them
// independently from first principles and compares BOTH the numbers and the
// bytes, because a layout that is wrong in the same way on both sides would
// still produce matching bytes.
func natValueLayoutCorpus(which) {
    if (which == 0) {
        // one int local
        let f = natFrameLayout(8, 0, 0, 0, 0, 0)
        return "int1 units=" + natKindUnits(natKindInt()) + " frame=" + f[natFrFrame()] + " slot0=" + natLocalOff(0, natKindInt())
    }
    if (which == 1) {
        // two int locals
        let f = natFrameLayout(16, 0, 0, 0, 0, 0)
        return "int2 units=" + natKindUnits(natKindInt()) + " frame=" + f[natFrFrame()] + " slot0=" + natLocalOff(0, natKindInt()) + " slot1=" + natLocalOff(1, natKindInt())
    }
    if (which == 2) {
        // kind units for every kind, in the oracle's numbering
        return "units int=" + natKindUnits(natKindInt()) + " string=" + natKindUnits(natKindString()) + " float=" + natKindUnits(natKindFloat()) + " array=" + natKindUnits(natKindArray()) + " struct=" + natKindUnits(natKindStruct()) + " map=" + natKindUnits(natKindMap())
    }
    if (which == 3) {
        // the conditional regions: reserved for a string program, skipped for
        // an int program. The int case must report 0, because reserving
        // them unconditionally would grow every int image.
        let fi = natFrameLayout(8, 0, 0, 0, 0, 0)
        let fs = natFrameLayout(8, 0, 1, 0, 0, 0)
        let fm = natFrameLayout(8, 0, 0, 1, 0, 0)
        return "cond int_strTemp=" + fi[natFrStrTemp()] + " int_mapStage=" + fi[natFrMapStage()] + " str_strTemp=" + fs[natFrStrTemp()] + " str_frame=" + fs[natFrFrame()] + " map_mapStage=" + fm[natFrMapStage()] + " map_frame=" + fm[natFrFrame()]
    }
    if (which == 4) {
        // Windows rounds the frame to 16; Linux does not. With maxExtra 2
        // (16 bytes) the unsized total is 8+512+16 = 536, which is 8 mod 16,
        // so Windows adds one unit and Linux does not.
        let fw = natFrameLayout(8, 0, 0, 0, 2, 1)
        let fl = natFrameLayout(8, 0, 0, 0, 2, 0)
        return "round win_frame=" + fw[natFrFrame()] + " linux_frame=" + fl[natFrFrame()]
    }
    return ""
}

// natValueCorpus is the measurement surface: the finished machine code of
// each reference program, as hex. natFinish returns an error string for a
// malformed emission, so a case that fails to encode reports that rather
// than an empty string.
func natValueCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natValueMain(1))) }
    if (which == 1) { return natToHex(natFinish(natValueMain(2))) }
    return ""
}

// natValuePrim renders one encoder opcode on its own, so each of the
// primitives Step 1 added to native_emit.kark can be compared individually
// against the Go oracle's identically named method. The composite program
// above already exercises all of them, but a composite mismatch does not say
// WHICH primitive is wrong.
//
// The order here is the gate's order and must stay in step with it.
func natValuePrim(which) {
    let s = natNewEmitter(0)
    if (which == 0) { s = natStoreStack(s, natRegRAX(), 0) }
    if (which == 1) { s = natLoadStack(s, natRegRAX(), 0) }
    if (which == 2) { s = natLoadStack(s, natRegRAX(), 8) }
    if (which == 3) { s = natStoreStack(s, natRegRAX(), 8) }
    // 616 is the real frame size of the one-local reference program, so the
    // wide-displacement path is exercised with a value that actually occurs.
    if (which == 4) { s = natStoreStack(s, natRegRAX(), 616) }
    if (which == 5) { s = natSubRegImm32(s, natRegRSP(), 616) }
    if (which == 6) { s = natAddRegImm32(s, natRegRSP(), 616) }
    // 16 fits in a signed byte, so this is the short (83 /digit ib) form. The
    // oracle picks the short form too, and picking the wide one instead would
    // be a different image.
    if (which == 7) { s = natSubRegImm32(s, natRegRSP(), 16) }
    if (which == 8) { s = natAddRegImm32(s, natRegRSP(), 16) }
    if (which == 9) { s = natXorRegReg(s, natRegRAX()) }
    if (which == 10) { s = natRet(s) }
    // Phase 151A Step 2 additions, in the gate's order.
    if (which == 11) { s = natNegReg(s, natRegRAX()) }
    if (which == 12) { s = natCmpRegReg(s, natRegRAX(), natRegRCX()) }
    if (which == 13) { s = natMovRegReg(s, natRegRAX(), natRegRCX()) }
    if (which == 14) { s = natMulRegReg(s, natRegRAX(), natRegRCX()) }
    return natToHex(natFinish(s))
}

// Registers, matching the oracle's Reg constants.
func natRegRCX() { return 1 }

// RDI is the first System V integer argument register, and the only argument
// register the Linux exit tail needs (the exit status). The oracle's Reg
// numbering is the architectural one, so RDI is 7 -- the accessor is named
// rather than written as the literal so the gate can pin it against
// pkg/native.RDI independently.
func natRegRDI() { return 7 }

// Phase 151A Step 5: the registers the Windows bootstrap walks over. RBX, RBP
// and R8-R11 are callee-saved under BOTH System V and Win64, which is why the
// oracle can hold the walk cursor, the module base and the export pointers in
// them across the whole pre-main sequence.
//
// The numbering is architectural and must match pkg/native exactly: R8-R11 are
// 8..11, and ModRM uses the low three bits, which is why natRegExt returns 1 for
// them.
func natRegRDX() { return 2 }
func natRegRSI() { return 6 }
func natRegRBX() { return 3 }
func natRegRBP() { return 5 }
func natRegR8()  { return 8 }
func natRegR9()  { return 9 }
func natRegR10() { return 10 }
func natRegR11() { return 11 }

// ============================================================
// Phase 151A Step 7 -- int `print`.
//
// The first kcc value-model surface that makes a real program's OUTPUT
// observable. Everything before this slice could compute a value and could
// enter and exit the image, but a kcc-compiled program could not say anything,
// so whole-image parity against the Go engine was untestable for want of
// anything to compare.
//
// This mirrors emitHelpers' print_int in pkg/native/program.go instruction
// for instruction, in the same order, because the oracle's order is not
// incidental: the digit pointer walks DOWN from the buffer end so no length
// has to be computed before the digits exist, and the sign is written from a
// separate pushed copy because the write syscall clobbers volatile registers.
// ============================================================

// natSysWrite is the Linux write(2) syscall number. macOS uses 0x2000004 and is
// not implemented here; the Linux exit tail's 60 (__NR_exit) is spelled as a
// literal in natStartStub for the same reason.
func natSysWrite() { return 1 }

// natRodataRef emits `mov r64, <absolute rodata address>` as a placeholder plus
// a recorded patch position, mirroring rodataRef's imm64Patch+internRodata.
//
// The bytes here are therefore NOT the oracle's final bytes -- the oracle
// resolves the placeholder to a real rodata address at link time, and so does
// this. The differential that matters for this slice is over the instruction
// SEQUENCES, and natPrintIntCorpus arm 2 exists to pin the placeholder form
// itself so it cannot be quietly changed into something that resolves locally.
func natRodataRef(s, r) {
    let p = natImm64Patch(s, natMovImm64Op(r))
    return p[0]
}

// natWriteStdout emits the Linux payload write for (RDI=fd, RSI=ptr, RDX=len)
// through the raw syscall, mirroring emitWrite's non-Windows body.
//
// Raw emitter calls on purpose, exactly as the oracle's own body insists:
// emitWrite is what Step 4 called natSyscall, and routing the syscall back
// through a helper that is itself named write is how the 148C replaceAll once
// produced infinite self-recursion.
func natWriteStdout(s) {
    s = natMovRegImm32(s, natRegRAX(), natSysWrite())
    return natSyscall(s)
}

// natPrintNewline mirrors printNewline: a one-byte rodata reference plus the
// payload write. RDI is still 1 from the preceding payload write.
func natPrintNewline(s) {
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    return natWriteStdout(s)
}

// natPayloadWrite emits the stdout payload write for the current OS.
//
// Step 9b's reason this exists: print_int is the FIRST helper with real output,
// and it wrote through the LINUX `write` syscall unconditionally. That is the
// oracle's emitWrite NON-WINDOWS body; the oracle's emitWrite switches on b.goos
// and dispatches to emitWinWrite, which kcc had never ported. So a PE image
// built from the existing print_int would execute a Linux `syscall` instruction
// on Windows and fault on the first digit -- which is exactly why every earlier
// PE gate deliberately built images that do NOT print.
//
// `winWrite` is 1 for Windows and 0 for Linux/ELF. The parameter is a number
// rather than a boolean because this language has no other way to select a
// function, and a literal 0/1 keeps the call sites self-documenting.
func natPayloadWrite(s, winWrite) {
    if (winWrite == 1) { return natWinWrite(s) }
    return natWriteStdout(s)
}

// natPrintNewlineOff is natPrintNewline with the rodata OFFSET recorded, so a
// real program can resolve the newline address against its own rodata section.
// The Step 7 corpus calls the byte-identical natPrintNewline, which records
// nothing, and that separation is deliberate.
func natPrintNewlineOff(s, winWrite, offNewline) {
    s = natRodataRefOff(s, natRegRSI(), offNewline)
    s = natMovRegImm32(s, natRegRDX(), 1)
    return natPayloadWrite(s, winWrite)
}

// natPrintIntBody is the SHARED print_int body, and it is the whole of Step 9b's
// first half: one body that can be emitted into a caller-owned emitter state, so
// print_int's rodata references land in the SAME state as the program's own and
// can therefore be resolved.
//
// Contract: RDI carries the value, output is decimal text plus a newline on
// stdout. The 64 bytes reserved below RSP are the digit buffer; the pointer
// starts at the TOP of that buffer and walks down, which is why no count is
// needed up front.
//
// `offMinus`/`offNewline` are offsets into the caller's rodata section. They are
// passed in rather than interned here because interning is a property of the
// WHOLE program: Step 9a established that the oracle's internRodata deduplicates
// by FIRST USE across every reference in the program, so a helper that invented
// its own offsets would be guessing at where its strings landed.
//
// Recording an offset does not change a byte -- natRodataRefOff and natRodataRef
// differ only in the two recorded lists -- which is why the frozen Step 7 corpus
// can move onto this body without its bytes moving.
func natPrintIntBody(s, winWrite, offMinus, offNewline) {
    s = natMark(s, "print_int")
    s = natSubRegImm32(s, natRegRSP(), 64)
    s = natMovRegReg(s, natRegRAX(), natRegRDI())
    s = natMovRegReg(s, natRegRSI(), natRegRSP())
    s = natAddRegImm32(s, natRegRSI(), 64)
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJns(s, "print_int_pos")
    s = natNegReg(s, natRegRAX())
    // RSI (the digit pointer) and RAX (the magnitude) are pushed across the sign
    // write, because the write clobbers volatile registers and both are needed by
    // the digit loop below.
    s = natPushReg(s, natRegRAX())
    s = natPushReg(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natRodataRefOff(s, natRegRSI(), offMinus)
    s = natPayloadWrite(s, winWrite)
    s = natPopReg(s, natRegRSI())
    s = natPopReg(s, natRegRAX())
    s = natMark(s, "print_int_pos")
    s = natMovRegImm32(s, natRegRCX(), 10)
    s = natMark(s, "print_int_loop")
    s = natCqo(s)
    s = natDivReg(s, natRegRCX())
    s = natAddRegImm32(s, natRegRDX(), 48)   // 48 is '0'
    s = natDecReg(s, natRegRSI())
    s = natStoreMem8(s, natRegRSI(), natRegRDX())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "print_int_loop")
    s = natMovRegReg(s, natRegRBX(), natRegRSP())
    s = natAddRegImm32(s, natRegRBX(), 64)
    s = natMovRegReg(s, natRegRDX(), natRegRBX())
    s = natSubRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natPayloadWrite(s, winWrite)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natPrintNewlineOff(s, winWrite, offNewline)
    return natRet(s)
}

// natPrintIntHelper is the FROZEN Step 7 entry point, now a wrapper over
// natPrintIntBody with the Linux write and the two rodata offsets the Step 7
// corpus implies.
//
// WHY IT STAYS, rather than being replaced: Step 7's gate compares these bytes
// against the oracle's print_int, and that corpus is the evidence that the digit
// loop is correct. Removing the corpus's only caller would leave the body
// reachable only from the new program path, and a differential that exists only
// on the path under test is a weaker differential than one that also runs
// unchanged.
//
// The offsets are 0 and 1 -- "-" first, then "\n" -- which is first-use interning
// order. They are recorded but never resolved here, so natPrintCorpus arm 2 still
// pins the UNRESOLVED placeholder shape independently of this helper.
//
// It returns the STATE, not finished bytes: natPrintCorpus calls natFinish on it,
// which is where label resolution belongs. An earlier draft returned the finished
// bytes from here as well, so natFinish ran twice -- the second pass read a byte
// array as an emitter state, every corpus arm printed empty, and arm 0 came back
// as the 28-byte digit loop under the wrong index.
func natPrintIntHelper() {
    return natPrintIntBody(natNewEmitter(0), 0, 0, 1)
}

// natPrintCorpus renders the print_int helper in three shapes.
//
// Arm 0 is the whole helper with its two internal rel32 fixups resolved, which
// is the differential against the Go oracle. Arms 1 and 2 isolate the pieces a
// whole-helper comparison cannot blame on the right instruction when it fails:
// arm 1 is the digit loop alone (so a wrong divide or a missing sign extension
// fails there rather than somewhere inside 40 instructions), and arm 2 is a
// bare rodata reference (so the unresolved placeholder shape is pinned on its
// own, independently of the helper that uses it).
func natPrintCorpus(which) {
    if (which == 0) {
        return natToHex(natFinish(natPrintIntHelper()))
    }
    if (which == 1) {
        let s = natNewEmitter(0)
        s = natMark(s, "print_int_pos")
        s = natMovRegImm32(s, natRegRCX(), 10)
        s = natMark(s, "print_int_loop")
        s = natCqo(s)
        s = natDivReg(s, natRegRCX())
        s = natAddRegImm32(s, natRegRDX(), 48)
        s = natDecReg(s, natRegRSI())
        s = natStoreMem8(s, natRegRSI(), natRegRDX())
        s = natTestRegReg(s, natRegRAX(), natRegRAX())
        s = natJnz(s, "print_int_loop")
        return natToHex(natFinish(s))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
        s = natRodataRef(s, natRegRSI())
        return natToHex(natFinish(s))
    }
    return ""
}

// The three kernel32 IAT slots the bootstrap publishes, mirroring the constants
// in pkg/native/pe.go. Declared on both sides so a renumber on one side cannot
// silently disagree with the other.
func natIatExitProcess()  { return 0 }
func natIatGetStdHandle() { return 1 }
func natIatWriteFile()    { return 2 }

// ============================================================
// 6. Integer statement and expression lowering (Step 2)
//
// Every sequence below is the Go oracle's, in the oracle's order, and the gate
// compares the finished bytes against pkg/native. Each reference program's
// SHAPE is compiled in rather than parsed -- the convention 151B/151C/151C2/
// 151C3/Step 1 already use -- because no AST-driven native driver exists yet.
// That boundary is real and is not papered over: what is proven here is that
// these lowering SEQUENCES match the oracle byte for byte, not that kcc can
// yet parse a source file and lower it.
//
// The oracle's surface, and this file's, is deliberately NARROWER than the
// language, and the narrowing is preserved rather than "fixed":
//
//   * Integer arithmetic is +, - and * ONLY. The oracle's emitBinary refuses
//     every other operator, `/` included, with a loud K145. That refusal is
//     reproduced verbatim below rather than quietly implemented, because
//     implementing division here would be a NEW capability and not a port.
//   * A comparison is a BRANCH, not a value. emitCond sets flags and jumps on
//     the INVERSE condition; it never leaves a boolean in RAX. There is
//     therefore no boolean value to materialise on the native path, and
//     inventing one would also be a new capability.
//
// Operand staging is the Phase-147 rule: the LEFT operand goes to the
// depth-indexed scratch slot, the right into RAX and then RCX, the left is
// reloaded into RAX, and the operation is applied. rsp never moves.
// ============================================================

// natIntRefusal reproduces the oracle's refusals for integer operators it does
// not lower. These are DATA on the measurement surface rather than build
// failures, so the gate can assert kcc refuses exactly what the oracle does.
func natIntRefusal(which) {
    if (which == 0) { return "error[K145]: unsupported operator '/' (want +, - or *)" }
    if (which == 1) { return "error[K145]: unsupported operator '%' (want +, - or *)" }
    if (which == 2) { return "error[K145]: condition must be a comparison (==, !=, <, <=, >, >=) over ints or floats" }
    if (which == 3) { return "error[K145]: expression nesting exceeds 64 binary levels" }
    // Step 2b: the `?` propagation operator is REFUSED by the oracle, not
    // lowered. `?` desugars to *parser.PropagateExpr and there is no
    // PropagateExpr case anywhere in pkg/native -- the native value model has
    // no Result/Option representation, so there is nothing to propagate to.
    // Implementing it here would be a NEW capability, not a port, so it stays
    // a refusal.
    //
    // The two messages DIFFER, and the difference is load-bearing rather than
    // cosmetic: a `?` in RETURN position is refused by retKindOfExpr during
    // kind inference, which runs before emitExpr, so it never reaches the
    // emission site's own wording.
    if (which == 4) { return "error[K145]: unsupported expression *parser.PropagateExpr" }
if (which == 5) { return "error[K145]: unsupported return expression *parser.PropagateExpr" }
  // Step 9g: a concatenation operand that is ITSELF a concatenation.
  //
  // natEmitStrValue handles a literal, then ASSUMES everything else is an
  // identifier -- so `a + b + "ef"` parsed its left operand `(a + b)` as an
  // identifier, called identName on a BinaryExpr, and indexed the slot plan with
  // the garbage. Both `print(a + b + "ef")` and `return a + "cd"` died with
  // "array index out of range" in natNativeSlotOff.
  //
  // Refusing BY NAME is the honest boundary for this slice. Recursing would need
  // depth threaded through natEmitStrValue and a strTemp sized for the deepest
  // chain, and the arena bound would then have to be re-proved per nesting level
  // rather than per site. That is its own slice; what must not happen is a
  // SHAPE REACHING EMISSION UNCHECKED, which is what produced the crash.
  if (which == 6) { return "error[K145]: chained string concatenation is not lowered (a concatenation operand may not itself be a concatenation)" }
  return ""
}

// natIntBody emits the straight-line integer reference programs. The shape
// selector picks the program because the oracle's statement order is only
// correct for a known shape; nLocals sizes the frame exactly as the oracle's
// layout would.
//
// Prologue and epilogue are emitFunc: Mark(name), SubRsp(frame), body,
// XorRegReg(RAX) when no return was seen, Mark(name+"$ret"), AddRsp(frame),
// Ret(). The 150C callee-saved push/pop is emitted only for a function the
// register allocator claimed; no reference program here qualifies, so it is
// absent from BOTH sides -- a boundary, not an omission.
func natIntBody(shape, nLocals) {
    let f = natFrameLayout(8 * nLocals * natKindUnits(natKindInt()), 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]

    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), frame)
    let returned = 0

    // shape 0: let x = 42 ; return x   -- literal, store, load, return
    if (shape == 0) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 42)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 1: let a = 6 ; let b = 7 ; return a * b
    if (shape == 1) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 6)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 7)
        s = natStoreStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natLoadStack(s, natRegRAX(), natLocalOff(1, natKindInt()))
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natMulRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 2: return -(3 + 4)   -- unary minus over a binary, so the nested
    // operand lands at depth 1 and gets its OWN scratch slot
    if (shape == 2) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natNegReg(s, natRegRAX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 3: return (2 + 3) * (10 - 4)   -- two nested binaries, depth 0 and 1
    if (shape == 3) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
        s = natStoreStack(s, natRegRAX(), bt + 1 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 1 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 10)
        s = natStoreStack(s, natRegRAX(), bt + 1 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 1 * 8)
        s = natSubRegReg(s, natRegRAX(), natRegRCX())
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natMulRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 4: a function body with NO return statement at all. The oracle's
    // `if !returned { XorRegReg(RAX) }` supplies the 0, and the same single
    // xor is what an explicit bare `return` produces (emitReturn's
    // `n.Value == nil` branch), so this one case covers both spellings.
    if (shape == 4) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        returned = 0
    }

    // shape 5: let x = 1 ; x = 2 ; return x   -- Step 2b. A bare assignment
    // to an EXISTING int local takes exactly the same lowering path as the
    // `let` that bound it: emitExprStmt evaluates the right side into RAX and
    // stores to the slot that is already there, so the frame is UNCHANGED at
    // one local. That "unchanged" is the property worth pinning -- a
    // reassignment allocates nothing -- and the gate's frame layer checks it.
    if (shape == 5) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }
    // shape 6: let x = 3 ; x = 4 ; return x + 1  -- Step 2b. A REASSIGNED local
    // read as a binary operand goes through the ordinary depth-indexed staging
    // path (shape 1), which is the point: being reassigned earlier must not put
    // the local on any different lowering than a freshly bound one.
    if (shape == 6) {
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 3)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 4)
        s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natLoadStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
        s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
        s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
        s = natAddRegReg(s, natRegRAX(), natRegRCX())
        s = natJmp(s, "karkain_main$ret")
        returned = 1
    }

    if (returned == 0) { s = natXorRegReg(s, natRegRAX()) }
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natIntExprCorpus renders the straight-line integer programs as hex.
func natIntExprCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natIntBody(0, 1))) }
    if (which == 1) { return natToHex(natFinish(natIntBody(1, 2))) }
    if (which == 2) { return natToHex(natFinish(natIntBody(2, 0))) }
    if (which == 3) { return natToHex(natFinish(natIntBody(3, 0))) }
    if (which == 4) { return natToHex(natFinish(natIntBody(4, 1))) }
    // Step 2b: the bare-assignment shapes. Both have one local, and the frame
    // layer independently recomputes that, so an accidental extra local would
    // show up as a frame mismatch rather than as plausible-looking bytes.
    if (which == 5) { return natToHex(natFinish(natIntBody(5, 1))) }
    if (which == 6) { return natToHex(natFinish(natIntBody(6, 1))) }
    return ""
}

// natIntCond emits a comparison in the oracle's emitCond shape: evaluate the
// left into the scratch slot, the right into RAX and then RCX, the left back
// into RAX, CmpRegReg, then jump to the false label on the INVERSE condition.
//
// The jump opcode is the oracle's mapping, verbatim:
//
//	==  jumps on Jnz (not equal)      !=  jumps on Jz  (equal)
//	<   jumps on Jge                  <=  jumps on Jg
//	>   jumps on Jle                  >=  jumps on Jl
//
// The scratch slot is passed in rather than recomputed, so this composes with
// whichever frame the enclosing function has.
func natIntCond(s, op, falseLabel, bt) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 5)
    s = natStoreStack(s, natRegRAX(), bt + 0 * 8)
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 9)
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + 0 * 8)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    if (op == 0) { return natJnz(s, falseLabel) }
    if (op == 1) { return natJz(s, falseLabel) }
    if (op == 2) { return natJge(s, falseLabel) }
    if (op == 3) { return natJg(s, falseLabel) }
    if (op == 4) { return natJle(s, falseLabel) }
    if (op == 5) { return natJl(s, falseLabel) }
    return s
}

// natIntIf emits an `if` with no else branch, in the oracle's emitIf order.
//
// The label NAMES and their order are part of the bytes, because a rel32
// displacement encodes the distance between the jump and its target, and
// because a rel32 is patched at Finish(). The oracle's fresh() allocates the
// ELSE label FIRST and the END label second, so ifelse$1 precedes ifend$2
// even though the jump to ifelse$1 appears before the jump to ifend$2. That
// counter order is reproduced here, not tidied.
func natIntIf(op) {
    let f = natFrameLayout(8, 0, 0, 0, 0, 0)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natIntCond(s, op, "ifelse$1", bt)
    // consequence: let x = 1
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 1)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    s = natJmp(s, "ifend$2")
    s = natMark(s, "ifelse$1")
    // alternative: let x = 2
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), 2)
    s = natStoreStack(s, natRegRAX(), natLocalOff(0, natKindInt()))
    s = natMark(s, "ifend$2")
    s = natXorRegReg(s, natRegRAX())
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natIntIfCorpus renders the six comparison operators. One program per
// operator, because the opcode is the only thing that varies and a single
// case would not prove the mapping.
func natIntIfCorpus(op) {
    return natToHex(natFinish(natIntIf(op)))
}

// ============================================================
// 7. Control-flow lowering: while / for / break / continue (Step 3)
// ============================================================
//
// The oracle's structure, reproduced from pkg/native:
//
//   emitWhile (program.go:3720)
//     loopLabel = fresh("while"); endLabel = fresh("whileend")
//     Mark(loopLabel); push loops{brk:endLabel, cont:loopLabel}
//     emitCond(cond, endLabel); body; pop
//     Jmp(loopLabel); Mark(endLabel)
//
//   emitFor (program.go:3742)
//     init (inline, BEFORE any label)
//     loopLabel = fresh("for"); postLabel = fresh("forpost"); endLabel = fresh("forend")
//     Mark(loopLabel); push loops{brk:endLabel, cont:POSTLabel}
//     cond (if present); body
//     Mark(postLabel); post; pop
//     Jmp(loopLabel); Mark(endLabel)
//
//   break    -> Jmp(loops[top].brk)   (program.go:3403)
//   continue -> Jmp(loops[top].cont)   (program.go:3409)
//
// Four facts the MEASURED label table settled, each recorded because it is
// easy to get wrong and each verified against the oracle rather than assumed:
//
//  1. `fresh()` is ONE counter shared by every prefix, and it is incremented
//     where the construct is ENTERED, not where it is emitted. So a nested
//     loop numbers $3/$4 while its parent keeps $1/$2, and the parent's end
//     label -- emitted last -- is still the LOWER number.
//     Measured: nested_while has while$1=214, while$3=265, whileend$4=379,
//     whileend$2=418.
//  2. `for` allocates THREE labels in the order for, forpost, forend, so the
//     POST label is $2 and the END label is $3. Reading it as
//     for/forend/forpost renumbers every jump in the program.
//  3. `break` targets the loop's END label; `continue` targets the loop's
//     continuation label, which is the HEAD for `while` and the POST label
//     for a C-style `for`. That asymmetry is the oracle's (loops[] carries
//     cont:postLabel for `for`, program.go:3752) and is why a `continue` in a
//     `for` still runs the post clause.
//  4. An `if` inside a loop allocates BOTH of its labels even with no else
//     branch, and with an empty consequence they land on the SAME offset.
//     Measured: while_break has ifelse$3 == ifend$4 == 315.
//
// Operand lowering is UNCHANGED from Step 2: the left operand is staged in the
// depth-indexed scratch slot, the right is evaluated into RAX and moved to
// RCX, the left is reloaded, and the operation is applied. A loop changes
// nothing about that, because the scratch slot is written before it is read on
// every iteration. rsp never moves.
//
// emitCond passes depth 1 to emitExpr for its operands but stores the staged
// left operand at b.binTemp (the region START, depth 0), which is why the
// condition and a depth-0 body expression share the same scratch slot.

// natLoopOpAdd is the only binary operator the reference programs use in a
// loop body. It reuses natAddRegReg, the Step 2 primitive.
func natLoopOpAdd() { return 0 }

// natLoopStageLocal parks the LEFT operand of a comparison or an assignment:
// read the local, store it into the depth-indexed scratch slot.
func natLoopStageLocal(s, slot, bt, depth) {
    s = natLoadStack(s, natRegRAX(), slot)
    s = natStoreStack(s, natRegRAX(), bt + depth * 8)
    return s
}

// natLoopStageLit parks a LITERAL left operand by the same two instructions,
// so a condition over two constants has the same shape as one over a local.
func natLoopStageLit(s, v, bt, depth) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), v)
    s = natStoreStack(s, natRegRAX(), bt + depth * 8)
    return s
}

// natLoopLit emits a literal into RAX. Used as a RIGHT operand, which is
// never staged: it goes straight to RAX and then to RCX.
func natLoopLit(s, v) {
    return natMovImm64(s, natMovImm64Op(natRegRAX()), v)
}

// natLoopLoad emits an identifier read into RAX. Used as a RIGHT operand.
func natLoopLoad(s, slot) {
    return natLoadStack(s, natRegRAX(), slot)
}

// natLoopFinishCmp completes `staged <cmp> rightInRax` and branches to
// falseLabel on the INVERSE condition, exactly as natIntCond does. The cmp
// MUST precede the branch: a branch ahead of its cmp is a correct-looking
// sequence testing stale flags.
func natLoopFinishCmp(s, op, falseLabel, bt, depth) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + depth * 8)
    s = natCmpRegReg(s, natRegRAX(), natRegRCX())
    if (op == 0) { return natJnz(s, falseLabel) }
    if (op == 1) { return natJz(s, falseLabel) }
    if (op == 2) { return natJge(s, falseLabel) }
    if (op == 3) { return natJg(s, falseLabel) }
    if (op == 4) { return natJle(s, falseLabel) }
    if (op == 5) { return natJl(s, falseLabel) }
    return s
}


// natLoopFinishAdd completes `staged + rightInRax`, the Step 2 binary shape.
func natLoopFinishAdd(s, bt, depth) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natLoadStack(s, natRegRAX(), bt + depth * 8)
    return natAddRegReg(s, natRegRAX(), natRegRCX())
}

// natLoopCondLocal emits `local <op> literal`, the condition shape every
// reference loop uses. The false label is the loop's END label, because that
// is what the oracle passes to emitCond.
func natLoopCondLocal(s, op, falseLabel, bt, slot, lit) {
    s = natLoopStageLocal(s, slot, bt, 0)
    s = natLoopLit(s, lit)
    return natLoopFinishCmp(s, op, falseLabel, bt, 0)
}

// natLoopAssignAddLit emits `slot = src + lit`, the reassignment shape Step 2b
// established: evaluate the right side into RAX, then store to the slot that
// already exists. The frame does not change.
func natLoopAssignAddLit(s, bt, slot, srcSlot, lit) {
    s = natLoopStageLocal(s, srcSlot, bt, 0)
    s = natLoopLit(s, lit)
    s = natLoopFinishAdd(s, bt, 0)
    s = natStoreStack(s, natRegRAX(), slot)
    return s
}

// natLoopAssignAddLocal emits `dst = src + other`, where the right operand is
// a local rather than a literal. Same staging, different right-operand source.
func natLoopAssignAddLocal(s, bt, dst, src, other) {
    s = natLoopStageLocal(s, src, bt, 0)
    s = natLoopLoad(s, other)
    s = natLoopFinishAdd(s, bt, 0)
    s = natStoreStack(s, natRegRAX(), dst)
    return s
}

// natLoopLet emits `let slot = v`.
func natLoopLet(s, slot, v) {
    s = natMovImm64(s, natMovImm64Op(natRegRAX()), v)
    s = natStoreStack(s, natRegRAX(), slot)
    return s
}

// natLoopEpilogue closes a reference program: the `return slot` read, the jmp
// to the $ret label the oracle emits after EVERY return, the $ret mark, and
// the frame teardown. Every reference program here returns explicitly, so the
// `if !returned` xor of Step 2 does not apply.
func natLoopEpilogue(s, frame, retSlot) {
    s = natLoadStack(s, natRegRAX(), retSlot)
    s = natJmp(s, "karkain_main$ret")
    s = natMark(s, "karkain_main$ret")
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    return s
}

// natLoopFrame computes the reference frame for a function with nLocals int
// locals: locals, binTemp, no strTemp, no mapStage, no extras, Linux (no
// 16-byte rounding), plus the fixed arg spill.
func natLoopFrame(nLocals) {
    let f = natFrameLayout(8 * nLocals * natKindUnits(natKindInt()), 0, 0, 0, 0, 0)
    return f
}

// natLoopPrologue emits Mark(karkain_main) + SubRsp(frame).
func natLoopPrologue(nLocals) {
    let f = natLoopFrame(nLocals)
    let s = natNewEmitter(0)
    s = natMark(s, "karkain_main")
    s = natSubRegImm32(s, natRegRSP(), f[natFrFrame()])
    return s
}


// ------------------------------------------------------------
// The ten reference programs, in the corpus order the gate uses.
//
// Slot assignment is the oracle's: locals are numbered in DECLARATION order,
// so in `let i = 0 ; let s = 0` i is slot 0 and s is slot 1. The `for` init's
// `let i` is declared AFTER `let s`, which is why for_full has s at slot 0.
// ------------------------------------------------------------

// natLoopWhileSimple: let i = 0 ; while i < 5 { i = i + 1 } ; return i
// Measured: frame 616 (1 local), while$1=199, whileend$2=274, $ret=283.
func natLoopWhileSimple() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 5)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopWhileArith: let i = 0 ; let s = 0 ;
//   while i < 5 { s = s + i ; i = i + 1 } ; return s
// Measured: frame 624 (2 locals), while$1=214, whileend$2=319, $ret=329.
func natLoopWhileArith() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, s0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 5)
    // s = s + i : the RIGHT operand is a local here, not a literal
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, s0)
}

// natLoopWhileBreak: let i = 0 ; while i < 10 { i = i + 1 ; if i == 5 { break } }
//   ; return i
// Measured: frame 616 (1 local), while$1=199, whileend$2=320,
//           ifelse$3=315, ifend$4=315, $ret=329.
//
// The break jumps to whileend$2 -- the loop's END label, not the head. The
// `if` allocates ifelse$3 and ifend$4 AFTER the while's own two labels,
// because the shared counter is incremented at loop ENTRY.
func natLoopWhileBreak() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 10)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    // if i == 5 { break }
    s = natLoopCondLocal(s, 0, "ifelse$3", bt, i0, 5)
    s = natJmp(s, "whileend$2")
    // emitIf's own unconditional jump to the end label, BEFORE Mark(ifelse$3).
    // It is 5 bytes and it is easy to miss: the `if` has no else branch, so the
    // next two marks land on the SAME offset and the jump reads like a no-op.
    s = natJmp(s, "ifend$4")
    s = natMark(s, "ifelse$3")
    s = natMark(s, "ifend$4")
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopWhileContinue: let i = 0 ; let s = 0 ;
//   while i < 6 { i = i + 1 ; if i == 3 { continue } ; s = s + i } ; return s
// Measured: frame 624 (2 locals), while$1=214, whileend$2=365,
//           ifelse$3=330, ifend$4=330, $ret=375.
//
// The continue jumps back to while$1 -- the loop HEAD. Continuing to the end
// label would exit the loop, so the two targets are not interchangeable.
func natLoopWhileContinue() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, s0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 6)
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    // if i == 3 { continue }
    s = natLoopCondLocal(s, 0, "ifelse$3", bt, i0, 3)
    s = natJmp(s, "while$1")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$4")
    s = natMark(s, "ifelse$3")
    s = natMark(s, "ifend$4")
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, s0)
}


// natLoopForSimple: let i = 0 ; for (i = 0; i < 5; i = i + 1) { } ; return i
// Measured: frame 616 (1 local), for$1=213, forpost$2=249, forend$3=288, $ret=297.
//
// The init clause is emitted BEFORE for$1 is marked. It is a bare assignment to
// an already-bound local, so it lowers exactly like Step 2b shape 5 and the
// frame does NOT grow.
func natLoopForSimple() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    // for init: i = 0
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 5)
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopForFull: let s = 0 ; for (let i = 0; i < 5; i = i + 1) { s = s + i }
//   ; return s
// Measured: frame 624 (2 locals), for$1=214, forpost$2=280, forend$3=321, $ret=330.
//
// s is slot 0 and i is slot 1, because `let s` is declared first and the
// for-init's `let i` second.
func natLoopForFull() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, s0, 0)
    // for init: let i = 0
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 5)
    // body: s = s + i
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    // forpost$2: the post clause, AFTER the body
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, s0)
}

// natLoopForBreak: let i = 0 ; for (i = 0; i < 10; i = i + 1) { if i == 5 { break } }
//   ; return i
// Measured: frame 616 (1 local), for$1=213, forpost$2=295, forend$3=334,
//           ifelse$4=295, ifend$5=295, $ret=343.
//
// The break targets forend$3. Note ifelse$4 / ifend$5 / forpost$2 all share
// offset 295: the if's consequence is a single break, the alternative is empty,
// and the post label immediately follows the body.
func natLoopForBreak() {
    let f = natLoopFrame(1)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let s = natLoopPrologue(1)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 10)
    // if i == 5 { break }
    s = natLoopCondLocal(s, 0, "ifelse$4", bt, i0, 5)
    s = natJmp(s, "forend$3")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$5")
    s = natMark(s, "ifelse$4")
    s = natMark(s, "ifend$5")
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, i0)
}

// natLoopForContinue: let s = 0 ; for (let i = 0; i < 6; i = i + 1) {
//   if i == 3 { continue } ; s = s + i } ; return s
// Measured: frame 624 (2 locals), for$1=214, forpost$2=327, forend$3=368,
//           ifelse$4=298, ifend$5=298, $ret=377.
//
// THE ASYMMETRY CASE: here `continue` targets forpost$2, NOT for$1, because
// a C-style for's continuation label is its post clause (program.go:3752
// pushes loopTgt{brk: endLabel, cont: postLabel}). Jumping to the head would
// skip the increment and loop forever.
func natLoopForContinue() {
    let f = natLoopFrame(2)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let s0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let s = natLoopPrologue(2)
    s = natLoopLet(s, s0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 6)
    // if i == 3 { continue }
    s = natLoopCondLocal(s, 0, "ifelse$4", bt, i0, 3)
    s = natJmp(s, "forpost$2")
    // emitIf's own unconditional jump to the end label (see natLoopWhileBreak)
    s = natJmp(s, "ifend$5")
    s = natMark(s, "ifelse$4")
    s = natMark(s, "ifend$5")
    s = natLoopAssignAddLocal(s, bt, s0, s0, i0)
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, s0)
}


// natLoopNestedWhile: let i = 0 ; let t = 0 ;
//   while i < 3 { let j = 0 ; while j < 2 { t = t + 1 ; j = j + 1 } ; i = i + 1 }
//   ; return t
// Measured: frame 632 (3 locals), while$1=214, while$3=265,
//           whileend$4=379, whileend$2=418, $ret=428.
//
// THREE locals (i, t, j) -- the inner `let j` is declared inside the outer
// body but still occupies a frame slot. The OUTER end label is $2 even though
// it is marked last, because fresh() allocated it when the outer loop was
// entered. Nesting is what proves the counter is shared, not per-prefix.
func natLoopNestedWhile() {
    let f = natLoopFrame(3)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let i0 = natLocalOff(0, natKindInt())
    let t0 = natLocalOff(1, natKindInt())
    let j0 = natLocalOff(2, natKindInt())
    let s = natLoopPrologue(3)
    s = natLoopLet(s, i0, 0)
    s = natLoopLet(s, t0, 0)
    s = natMark(s, "while$1")
    s = natLoopCondLocal(s, 2, "whileend$2", bt, i0, 3)
    // outer body prologue: let j = 0
    s = natLoopLet(s, j0, 0)
    s = natMark(s, "while$3")
    s = natLoopCondLocal(s, 2, "whileend$4", bt, j0, 2)
    s = natLoopAssignAddLit(s, bt, t0, t0, 1)
    s = natLoopAssignAddLit(s, bt, j0, j0, 1)
    s = natJmp(s, "while$3")
    s = natMark(s, "whileend$4")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "while$1")
    s = natMark(s, "whileend$2")
    return natLoopEpilogue(s, frame, t0)
}

// natLoopNestedForWhile: let t = 0 ; for (let i = 0; i < 2; i = i + 1) {
//   let j = 0 ; while j < 2 { t = t + 1 ; j = j + 1 } } ; return t
// Measured: frame 632 (3 locals), for$1=214, forpost$2=378, forend$3=419,
//           while$4=266, whileend$5=378, $ret=428.
//
// A `for` OUTER and a `while` INNER, which is the case that pins BOTH shared-
// counter rules at once: the for takes $1/$2/$3 and the while, entered later,
// continues the same counter at $4/$5 rather than restarting.
func natLoopNestedForWhile() {
    let f = natLoopFrame(3)
    let frame = f[natFrFrame()]
    let bt = f[natFrBinTemp()]
    let t0 = natLocalOff(0, natKindInt())
    let i0 = natLocalOff(1, natKindInt())
    let j0 = natLocalOff(2, natKindInt())
    let s = natLoopPrologue(3)
    s = natLoopLet(s, t0, 0)
    s = natLoopLet(s, i0, 0)
    s = natMark(s, "for$1")
    s = natLoopCondLocal(s, 2, "forend$3", bt, i0, 2)
    s = natLoopLet(s, j0, 0)
    s = natMark(s, "while$4")
    s = natLoopCondLocal(s, 2, "whileend$5", bt, j0, 2)
    s = natLoopAssignAddLit(s, bt, t0, t0, 1)
    s = natLoopAssignAddLit(s, bt, j0, j0, 1)
    s = natJmp(s, "while$4")
    s = natMark(s, "whileend$5")
    s = natMark(s, "forpost$2")
    s = natLoopAssignAddLit(s, bt, i0, i0, 1)
    s = natJmp(s, "for$1")
    s = natMark(s, "forend$3")
    return natLoopEpilogue(s, frame, t0)
}

// natLoopLabels reports the label NAMES each reference program uses, in
// allocation order, so the gate can pin the fresh() numbering as DATA.
//
// A rel32 encodes only a displacement, so a renumbered label can produce a
// byte stream that is coincidentally equal -- the displacement might come out
// the same. The names are the layer that catches that, and they are why this
// surface reports labels separately from code.
func natLoopLabels(which) {
    if (which == 0) { return "while$1 whileend$2" }
    if (which == 1) { return "while$1 whileend$2" }
    if (which == 2) { return "while$1 whileend$2 ifelse$3 ifend$4" }
    if (which == 3) { return "while$1 whileend$2 ifelse$3 ifend$4" }
    if (which == 4) { return "for$1 forpost$2 forend$3" }
    if (which == 5) { return "for$1 forpost$2 forend$3" }
    if (which == 6) { return "for$1 forpost$2 forend$3 ifelse$4 ifend$5" }
    if (which == 7) { return "for$1 forpost$2 forend$3 ifelse$4 ifend$5" }
    if (which == 8) { return "while$1 whileend$2 while$3 whileend$4" }
    if (which == 9) { return "for$1 forpost$2 forend$3 while$4 whileend$5" }
    return ""
}

// natLoopCorpus renders the ten control-flow reference programs as hex, in the
// same order the gate and the label corpus use.
func natLoopCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natLoopWhileSimple())) }
    if (which == 1) { return natToHex(natFinish(natLoopWhileArith())) }
    if (which == 2) { return natToHex(natFinish(natLoopWhileBreak())) }
    if (which == 3) { return natToHex(natFinish(natLoopWhileContinue())) }
    if (which == 4) { return natToHex(natFinish(natLoopForSimple())) }
    if (which == 5) { return natToHex(natFinish(natLoopForFull())) }
    if (which == 6) { return natToHex(natFinish(natLoopForBreak())) }
    if (which == 7) { return natToHex(natFinish(natLoopForContinue())) }
    if (which == 8) { return natToHex(natFinish(natLoopNestedWhile())) }
    if (which == 9) { return natToHex(natFinish(natLoopNestedForWhile())) }
    return ""
}

// ============================================================
// 7. The `_start` entry stub and the Linux exit tail
//
// The Go oracle emits `_start` first thing in pkg/native/program.go:
//
//	b.e.Mark("_start")
//	if b.goos == OSWindows { b.e.AndRspNeg16(); b.emitWinBootstrap() }
//	b.e.Call("karkain_main")
//	if b.goos == OSWindows { b.emitWindowsExit() } else {
//	    b.e.MovRegReg(RDI, RAX)
//	    b.e.MovRegImm32(RAX, b.sysExit())
//	    b.e.Syscall()
//	}
//
// This slice is the Linux half ONLY. The Windows alignment fix, the PEB
// bootstrap and the Windows exit tail are deliberately absent, and the macOS
// exit number is absent: each is separately recorded as open 151A work, and
// emitting them here would be inventing scope rather than porting it. The
// corpus therefore cannot be run -- it has no `main` body, no `print` and no
// arena -- and the gate claims BYTES, not execution.
//
// The `karkain_main` label is placed immediately after the tail, so the corpus
// is self-contained: natRel32 must still resolve a real forward reference,
// which is the property 151B introduced it for. The resulting displacement is
// therefore 10 -- offset(karkain_main)=15 minus offset(next instruction)=5 --
// which is a property of this corpus and NOT of a real image, where
// `karkain_main` sits at its own offset. The gate pins that arithmetic
// separately from the instruction bytes for exactly that reason. (This comment
// first said 12; the arithmetic is 15-5. The gate DERIVED 10 from the
// encodings and passed, so the wrong number was here, not there.)
func natStartStub() {
    let s = natNewEmitter(0)
    s = natMark(s, "_start")
    s = natCall32(s)
    let r = natRel32(s, "karkain_main")
    s = r[0]
    s = natMovRegReg(s, natRegRDI(), natRegRAX())
    // 60 is __NR_exit on Linux. macOS uses 0x2000001 and is out of scope.
    s = natMovRegImm32(s, natRegRAX(), 60)
    s = natSyscall(s)
    s = natMark(s, "karkain_main")
    return s
}

// natStartCorpus renders the `_start` stub, the syscall primitive alone, and
// the exit tail without its call -- three shapes so the gate can separate the
// instruction bytes from the rel32 fixup.
func natStartCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natStartStub())) }
    if (which == 1) {
        let s = natNewEmitter(0)
        return natToHex(natFinish(natSyscall(s)))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
        s = natMark(s, "_start")
        s = natMovRegReg(s, natRegRDI(), natRegRAX())
        s = natMovRegImm32(s, natRegRAX(), 60)
        s = natSyscall(s)
        return natToHex(natFinish(s))
    }
    return ""
}

// ============================================================
// Phase 151A Step 5 -- the Windows entry, the PEB bootstrap and
// the Win64 exit tail.
//
// This is the PE counterpart of natStartStub and the mirror image of
// emitWinBootstrap + emitWindowsExit in pkg/native/program.go, in the oracle order.
// The order is load-bearing:
//
//   1. `and rsp, -16` FIRST -- main frame math and every kernel32 call assume
//      rsp % 16 == 0 at the call.
//   2. The bootstrap, publishing ExitProcess/GetStdHandle/WriteFile into the IAT
//      before main can call any of them.
//   3. The call to karkain_main.
//   4. The Win64 exit tail, passing main return value to ExitProcess.
//
// The host loader maps the image and runs entry but does NOT snap the IAT on
// these minimal images (Phase 149: the slots keep their file contents at run
// time), which is why the bootstrap exists at all. RSP never moves.
// ============================================================

// natWinFoldCmp emits one WCHAR of the "kernel32.dll" comparison: load the
// 16-bit character at character-index k from the BaseDllName buffer, fold it
// to lowercase with 0x20, compare against the expected character, and branch to
// the walk next label on a mismatch.
//
// The fold is not cosmetic. Phase 149 read BaseDllName live from the PEB and it
// arrives UPPERCASE (KERNEL32.DLL), so an unfolded comparison against the
// lowercase spelling would never match and every program would take the Int3.
// Folding is a no-op for the digits and dots in this alphabet, which is why the
// oracle applies it unconditionally instead of branching per character class.
func natWinFoldCmp(s, k, ch) {
    s = natMovzxRegMem16(s, natRegR8(), natRegRDX(), k * 2)
    s = natOrRegImm8(s, natRegR8(), 32)
    s = natCmpRegImm32(s, natRegR8(), ch)
    return natJnz(s, "wk$next")
}

// natWinCmpPair emits one aligned character-pair comparison of an export name,
// branching to nextLbl on a mismatch.
//
// nextLbl is passed in rather than derived from `ch`: the oracle allocates a
// FRESH label set per resolve (b.fresh), so ExitProcess, GetStdHandle and
// WriteFile each own their labels. Reusing one set is not merely untidy -- the
// encoder rejects a duplicate label outright, which is how the gate's first
// draft of the oracle half failed with `duplicate label "exp$loop"`.
//
// An odd-length name's final pair has a ZERO high byte and is COMPARED against
// the string's NUL terminator, not skipped. Dropping it would let the walk match
// a shorter name.
func natWinCmpPair(s, k, ch, nextLbl) {
    s = natMovzxRegMem16(s, natRegR8(), natRegRDX(), k)
    s = natCmpRegImm32(s, natRegR8(), ch)
    return natJnz(s, nextLbl)
}

// natWinResolve emits one export-table walk resolving a kernel32 name, with R10
// holding the module base. It mirrors emitWinResolve exactly.
//
// loopLbl/nextLbl/doneLbl/failLbl are passed in so each of the three resolves
// owns a FRESH set, exactly as the oracle's b.fresh() does. The pair constants
// c0..c5 are the aligned 16-bit character pairs DERIVED FROM THE NAME STRING by
// the caller, not re-typed here: the gate recomputes them independently and a
// mistyped pair would otherwise agree with a second copy of the same typo.
//
// The export directory sits at NT+136 (COFF 24 + Optional 112); the +96 shape
// is the 32-bit header and reads garbage, measured in Phase 149. The resolved
// address moves RDX -> RAX before the store because 48 A3 is accumulator-only.
func natWinResolve(s, c0, c1, c2, c3, c4, c5, loopLbl, nextLbl, doneLbl, failLbl, iatIdx) {
    s = natLoadBaseOff32(s, natRegRCX(), natRegR10(), 60)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 136)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    s = natLoadBaseOff32(s, natRegR9(), natRegRDX(), 24)
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 32)
    s = natMovRegReg(s, natRegRSI(), natRegR10())
    s = natAddRegReg(s, natRegRSI(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 36)
    s = natMovRegReg(s, natRegRDI(), natRegR10())
    s = natAddRegReg(s, natRegRDI(), natRegRCX())
    s = natLoadBaseOff32(s, natRegRCX(), natRegRDX(), 28)
    s = natMovRegReg(s, natRegRBP(), natRegR10())
    s = natAddRegReg(s, natRegRBP(), natRegRCX())
    s = natMark(s, loopLbl)
    s = natTestRegReg(s, natRegR9(), natRegR9())
    s = natJz(s, failLbl)
    s = natLoadBaseOff32(s, natRegRCX(), natRegRSI(), 0)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRCX())
    if (c0 != 0) { s = natWinCmpPair(s, 0, c0, nextLbl) }
    if (c1 != 0) { s = natWinCmpPair(s, 2, c1, nextLbl) }
    if (c2 != 0) { s = natWinCmpPair(s, 4, c2, nextLbl) }
    if (c3 != 0) { s = natWinCmpPair(s, 6, c3, nextLbl) }
    if (c4 != 0) { s = natWinCmpPair(s, 8, c4, nextLbl) }
    if (c5 != 0) { s = natWinCmpPair(s, 10, c5, nextLbl) }
    s = natMovzxRegMem16(s, natRegR8(), natRegRDI(), 0)
    s = natLoadScaled32(s, natRegRAX(), natRegRBP(), natRegR8(), 4, 0)
    s = natMovRegReg(s, natRegRDX(), natRegR10())
    s = natAddRegReg(s, natRegRDX(), natRegRAX())
    s = natMovRegReg(s, natRegRAX(), natRegRDX())
    // The absolute pointer to the resolved kernel32 address is a LINK-TIME
    // placeholder, and it is paired with its IAT INDEX here rather than by
    // emission position. Step 9b needed this: once print_int contributes its own
    // IAT references, a positional reader mispairs the bootstrap's stores.
    //
    // Note there is NO `let p = ...; s = p[0]` here. natStoreAbs64 returns
    // [s, pos]; natStoreAbs64Idx returns the state alone. Keeping the old
    // two-line destructuring assigned the CODE ARRAY to s, so every subsequent
    // emitter call operated on the code bytes -- and because natFinish rejected
    // the labels afterwards, the corpus arms printed EMPTY and the failure only
    // surfaced much later inside natPELink as an out-of-range write. The
    // one-line form is the honest one.
    s = natStoreAbs64Idx(s, iatIdx)
    s = natJmp(s, doneLbl)
    s = natMark(s, nextLbl)
    s = natAddRegImm32(s, natRegRSI(), 4)
    s = natAddRegImm32(s, natRegRDI(), 2)
    s = natDecReg(s, natRegR9())
    s = natJmp(s, loopLbl)
    s = natMark(s, failLbl)
    s = natInt3(s)
    s = natMark(s, doneLbl)
    return s
}

// natWinBootstrap emits the loader-independent kernel32 resolution, mirroring
// emitWinBootstrap. R10 keeps the module base across all three resolves.
//
// The module walk matches the NAME "kernel32.dll" and never a position: the
// entry list order is not stable across boots. The 64-entry bound is a backstop,
// not a heuristic. A missing module or an exhausted export walk reaches an Int3.
//
// Pair constants are the aligned 16-bit little-endian character pairs derived
// from each name: name[k] | name[k+1]<<8, with a zero high byte on the tail of an
// odd-length name. "ExitProcess" is 11 characters (6 pairs), "GetStdHandle" is 12
// (6 pairs, NO tail pair) and "WriteFile" is 9 (5 pairs, odd tail).
func natWinBootstrap(s) {
    s = natMovRegGsMem(s, natRegRAX(), 96)
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 24)
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 32)
    s = natMovRegImm32(s, natRegR11(), 64)
    s = natMark(s, "wk$walk")
    s = natLoadBaseOff(s, natRegRAX(), natRegRAX(), 0)
    s = natMovRegReg(s, natRegRBX(), natRegRAX())
    s = natSubRegImm32(s, natRegRBX(), 16)
    // 64-bit LDR_DATA_TABLE_ENTRY: DllBase at +0x30, BaseDllName at +0x58
    // (Length +0, Buffer +8). The 32-bit +0x28/+0x50 shape skips every module
    // into the Int3 -- measured in Phase 149.
    s = natMovzxRegMem16(s, natRegRCX(), natRegRBX(), 88)
    s = natCmpRegImm32(s, natRegRCX(), 24)
    s = natJnz(s, "wk$next")
    s = natLoadBaseOff(s, natRegRDX(), natRegRBX(), 96)
    s = natWinFoldCmp(s, 0, 107)
    s = natWinFoldCmp(s, 1, 101)
    s = natWinFoldCmp(s, 2, 114)
    s = natWinFoldCmp(s, 3, 110)
    s = natWinFoldCmp(s, 4, 101)
    s = natWinFoldCmp(s, 5, 108)
    s = natWinFoldCmp(s, 6, 51)
    s = natWinFoldCmp(s, 7, 50)
    s = natWinFoldCmp(s, 8, 46)
    s = natWinFoldCmp(s, 9, 100)
    s = natWinFoldCmp(s, 10, 108)
    s = natWinFoldCmp(s, 11, 108)
    s = natLoadBaseOff(s, natRegR10(), natRegRBX(), 48)
    s = natJmp(s, "wk$found")
    s = natMark(s, "wk$next")
    s = natDecReg(s, natRegR11())
    s = natJnz(s, "wk$walk")
    s = natMark(s, "wk$fail")
    s = natInt3(s)
    s = natMark(s, "wk$found")
    // "ExitProcess": E|x=0x7845 i|t=0x7469 P|r=0x7250 o|c=0x636F e|s=0x7365 s|\0=0x73
    s = natWinResolve(s, 30789, 29801, 29264, 25455, 29541, 115, "wx$loop$0", "wx$next$0", "wx$done$0", "wx$fail$0", 0)
    // "GetStdHandle": G|e=0x6547 t|S=0x5374 t|d=0x6474 H|a=0x6148 n|d=0x646E l|e=0x656C
    // The H|a pair was FIRST written as 24896 = 0x6140, whose low byte is '@',
    // not 'H'. The oracle comparison caught it as a single differing byte in a
    // 982-byte shape -- the same one-digit class 152-B2 hit on a SHA-256 round
    // constant, and the reason this gate derives the pair table a third time.
    s = natWinResolve(s, 25927, 21364, 25716, 24904, 25710, 25964, "wx$loop$1", "wx$next$1", "wx$done$1", "wx$fail$1", 1)
    // "WriteFile": W|r=0x7257 i|t=0x7469 e|F=0x4665 i|l=0x6C69 e|\0=0x65
    s = natWinResolve(s, 29271, 29801, 18021, 27753, 101, 0, "wx$loop$2", "wx$next$2", "wx$done$2", "wx$fail$2", 2)
    return s
}

// natWinExitTail emits the Win64 exit tail: ExitProcess(main's return value).
// Win64 requires 32 bytes of caller shadow even for a single argument; the
// entry alignment itself is fixed by natAndRspNeg16 before the main call.
func natWinExitTail(s) {
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natSubRegImm32(s, natRegRSP(), 32)
    // natIatCall records ExitProcess's IAT index with the placeholder, so the
    // exit call is no longer identified by "the fourth emitted site".
    s = natIatCall(s, natRegRAX(), natIatExitProcess())
    return natCallReg(s, natRegRAX())
}

// natWinStub emits the complete Windows _start in the oracle order: alignment,
// bootstrap, call main, Win64 exit.
func natWinStub() {
    let s = natNewEmitter(0)
    s = natMark(s, "_start")
    s = natAndRspNeg16(s)
    s = natWinBootstrap(s)
    s = natCall32(s)
    let r = natRel32(s, "karkain_main")
    s = r[0]
    s = natWinExitTail(s)
    s = natMark(s, "karkain_main")
    return s
}

// natWinCorpus renders the Windows pieces separately as well as whole, so a
// failure names a SUBSYSTEM (bootstrap, resolve, exit tail) rather than pointing
// at one long sequence.
//
// Shape 0 is the whole _start; shape 1 the alignment fix alone; shape 2 one
// export resolve alone; shape 3 the Win64 exit tail alone. This is the same
// four-shape split natStartCorpus uses for the Linux entry.
func natWinCorpus(which) {
    if (which == 0) { return natToHex(natFinish(natWinStub())) }
    if (which == 1) {
        let s = natNewEmitter(0)
        return natToHex(natFinish(natAndRspNeg16(s)))
    }
    if (which == 2) {
        let s = natNewEmitter(0)
s = natWinResolve(s, 30789, 29801, 29264, 25455, 29541, 115, "wx$loop$0", "wx$next$0", "wx$done$0", "wx$fail$0", 0)
        return natToHex(natFinish(s))
    }
    if (which == 3) {
        let s = natNewEmitter(0)
        s = natMovRegReg(s, natRegRCX(), natRegRAX())
        s = natSubRegImm32(s, natRegRSP(), 32)
        return natToHex(natFinish(s))
    }
    return ""
}

// ============================================================
// Phase 151A Step 6 -- assemble a RUNNABLE PE from the Step-5 sequences.
//
// Everything below is TEST SCAFFOLDING for the Step-6 gate, not language
// implementation. It composes the already-byte-verified `_start` with a minimal
// synthetic main body and links it through kcc's OWN natPELink, so the image is
// produced by the self-hosted engine and not by the Go oracle.
//
// The synthetic main body is deliberately the smallest thing that exercises
// startup and exit integration:
//
//	mov rax, <code>
//	ret
//
// It uses no frame slot, no allocator, no print and no stack, so it requires
// nothing from the value model that later 151A work still owes. It is NOT print,
// NOT print_float and NOT a general calling convention -- it is a return value.
//
// `code` is the process exit status, which is how the Win64 exit tail is
// observable: _start passes main's RAX to ExitProcess.
// ============================================================

// natWinExe assembles _start + a synthetic main and links a PE image.
//
// The patch bookkeeping is the whole point. The bootstrap stores three resolved
// kernel32 addresses with `mov [imm64], rax` (natStoreAbs64) and the exit tail
// loads ExitProcess with `movabs rax, <slot>`; both are LINK-TIME placeholders.
// Positions are recorded in the emitter's imm64 slot in emission order:
// ExitProcess, GetStdHandle, WriteFile, then the exit call. natPELink takes
// flat [pos, index] pairs, so those four become three apatches and one ipatch.
func natWinExe(code) {
    let s = natWinStub()
    // The synthetic main, emitted after the karkain_main label natWinStub left.
    s = natMovRegImm32(s, natRegRAX(), code)
    s = natRet(s)
    let text = natFinish(s)
    let p = natStImm64(s)
    let ap = []
    ap = appendArray(ap, p[0])
    ap = appendArray(ap, natIatExitProcess())
    ap = appendArray(ap, p[1])
    ap = appendArray(ap, natIatGetStdHandle())
    ap = appendArray(ap, p[2])
    ap = appendArray(ap, natIatWriteFile())
    let ip = []
    ip = appendArray(ip, p[3])
    ip = appendArray(ip, natIatExitProcess())
    return natToHex(natPELink(text, [], [], [], ip, ap, [], natPETextOff(), natPETextOff()))
}

// natWinExeC assembles _start + a synthetic main that CALLS GetStdHandle.
//
// This is the Step-6 Case C body. It exists to prove the PEB bootstrap's export
// resolution actually produced a callable address for a SECOND API, not just the
// one the exit tail uses.
//
// It deliberately does NOT print. Implementing print is later 151A work and is
// out of scope here; calling the resolved GetStdHandle and surviving is the proof.
// If the bootstrap had published a bad address, this call would fault and the
// process would die with an access violation instead of exiting 0.
//
// The call follows the Win64 rules the oracle already established: rsp is 8 (mod
// 16) at main entry because _start aligned it and then called, so subtracting 40
// puts it at 0 (mod 16) at the call site, and 32 of that is caller shadow.
func natWinExeC() {
    let s = natWinStub()
    s = natSubRegImm32(s, natRegRSP(), 40)
    // STD_OUTPUT_HANDLE is -11; MovRegImm32 writes it as the 32-bit constant the
    // oracle uses, which is what the kernel32 stub reads.
    s = natMovRegImm32(s, natRegRCX(), 4294967285)
    s = natIatCall(s, natRegRAX(), natIatGetStdHandle())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 40)
    s = natMovRegImm32(s, natRegRAX(), 0)
    s = natRet(s)
    let text = natFinish(s)
    let p = natStImm64(s)
    let ap = []
    ap = appendArray(ap, p[0])
    ap = appendArray(ap, natIatExitProcess())
    ap = appendArray(ap, p[1])
    ap = appendArray(ap, natIatGetStdHandle())
    ap = appendArray(ap, p[2])
    ap = appendArray(ap, natIatWriteFile())
    let ip = []
    ip = appendArray(ip, p[3])
    ip = appendArray(ip, natIatExitProcess())
    ip = appendArray(ip, p[4])
    ip = appendArray(ip, natIatGetStdHandle())
    return natToHex(natPELink(text, [], [], [], ip, ap, [], natPETextOff(), natPETextOff()))
}

// natIatCall emits `movabs rax, <IAT slot>`, the Win64 import-call shape the
// oracle's iatCall produces, and records the slot INDEX alongside the placeholder
// position.
//
// The `slot` parameter existed but was UNUSED until Step 9b: the oracle pairs
// each position with its index (`iatPatch{pos, index}`), while kcc recorded the
// position alone and left callers to recover the index from emission order. That
// worked only while four sites existed. The comment on natStIatIndex explains
// why the positional reading is now wrong, and it is worth restating that the
// consequence of getting it wrong is a silent call through the WRONG kernel32
// entry point rather than a crash.
//
// Note the `call rax` is NOT emitted here: the oracle's iatCall emits it
// internally, but kcc's Step-6 call sites emit natCallReg immediately after, and
// that split is already byte-verified, so it is preserved rather than "fixed".
func natIatCall(s, reg, slot) {
    let p = natImm64Patch(s, natMovImm64Op(reg))
    s = p[0]
    // Slot 5 is appended here as well as slot 11. natMovImm64 -- which is what
    // this used to call -- appends to slot 5, and the frozen Step 6 image builders
    // (natWinExe / natWinExeC) read their ipatch position straight out of slot 5
    // by index. natImm64Patch does NOT append there, so switching to it without
    // this line would silently shorten slot 5 and make those readers index past
    // its end. The bytes are identical either way: both emit REX, the opcode and
    // eight zero bytes, because natMovImm64 is always called with v == 0 here.
    s[5] = appendArray(s[5], p[1])
    s[8] = appendArray(s[8], slot)
    s[11] = appendArray(s[11], p[1])
    s[12] = appendArray(s[12], slot)
    return s
}
// ============================================================
// Phase 151A Step 8b - print_float
//
// This mirrors Builder.emitPrintFloatHelper in pkg/native/program.go
// (lines 4185-4390) instruction for instruction and IN THE SAME ORDER. The
// order is load-bearing twice over:
//
//   - the Go helper interleaves writes with live values, and several of those
//     values are parked in the frame rather than a register. The frame map is
//     rsp+0..5 fraction digits, rsp+8..15 the R11 digit count (across the "."
//     write), rsp+16..23 the fraction bit pattern, rsp+24..31 the integer part,
//     rsp+45..63 the integer digit buffer. RCX/RAX/RDX are volatile at BOTH the
//     Win64 kernel32 boundary and the raw syscall -- the syscall itself assigns
//     RCX the return RIP -- so a caller-saved park is not enough in either
//     container. Parking the integer part is what makes NEGATIVE values
//     correct: the sign write would otherwise clobber RCX before it is read.
//   - every fresh() label is allocated at the point the Go helper allocates it.
//     Label NAMES do not affect a single byte, but the ORDER of the marks does,
//     because the rel32 displacements are computed from positions.
//
// The writes go through natWriteStdout, which is the Linux syscall form, so
// this corpus is Linux by construction exactly as Step 7's is.

// natPrintFloatHelper emits the whole print_float helper.
func natPrintFloatHelper() {
    let s = natNewEmitter(0)
    s = natMark(s, "print_float")
    s = natSubRegImm32(s, natRegRSP(), 64)
    s = natMovRegReg(s, natRegRAX(), natRegRDI())
s = natMovRegImm64(s, natRegRCX(), 0 - 9223372036854775807 - 1)
    s = natMovRegReg(s, natRegR11(), natRegRAX())
    s = natAndRegReg(s, natRegR11(), natRegRCX())
    s = natMovRegImm64(s, natRegRCX(), 9223372036854775807)
    s = natAndRegReg(s, natRegRAX(), natRegRCX())
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natShrRegImm(s, natRegRCX(), 52)
    s = natMovRegImm32(s, natRegR10(), 2047)
    s = natAndRegReg(s, natRegRCX(), natRegR10())
    s = natCmpRegImm32(s, natRegRCX(), 2047)
    s = natJz(s, "fltsp")
    s = natJmp(s, "fltfin")
    s = natMark(s, "fltsp")
    s = natMovRegImm64(s, natRegR10(), 4503599627370495)
    s = natAndRegReg(s, natRegRAX(), natRegR10())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltnan")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnoinf")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnoinf")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 3)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natRet(s)
    s = natMark(s, "fltnan")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnonan")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnonan")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 3)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    s = natRet(s)
    s = natMark(s, "fltfin")
    s = natMovXmmRegGp(s, 0, natRegRAX())
    s = natCvttsd2siGpXmm(s, natRegRCX(), 0)
    s = natCvtsi2sdXmmGp(s, 1, natRegRCX())
    s = natSubsdXmmXmm(s, 0, 1)
    s = natMovGpRegXmm(s, natRegRAX(), 0)
    s = natStoreStack(s, natRegRAX(), 16)
    s = natStoreStack(s, natRegRCX(), 24)
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnosign")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnosign")
    s = natLoadStack(s, natRegRAX(), 24)
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltintnz")
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natJmp(s, "fltintdone")
    s = natMark(s, "fltintnz")
    s = natMovRegImm32(s, natRegR10(), 10)
    s = natLeaRegStack(s, natRegRSI(), 64)
    s = natMark(s, "fltintloop")
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRDX(), 48)
    s = natDecReg(s, natRegRSI())
    s = natStoreMem8(s, natRegRSI(), natRegRDX())
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "fltintloop")
    s = natLeaRegStack(s, natRegRBX(), 64)
    s = natMovRegReg(s, natRegRDX(), natRegRBX())
    s = natSubRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltintdone")
    s = natLoadStack(s, natRegRCX(), 16)
    s = natMovXmmRegGp(s, 0, natRegRCX())
    s = natMovRegImm64(s, natRegR10(), 4696837146684686336)
    s = natMovXmmRegGp(s, 1, natRegR10())
    s = natMulsdXmmXmm(s, 0, 1)
    s = natCvttsd2siGpXmm(s, natRegRCX(), 0)
    s = natMovRegImm32(s, natRegR10(), 100000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 0)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 10000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 1)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 1000)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 2)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 100)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 3)
    s = natMovRegReg(s, natRegRCX(), natRegRDX())
    s = natMovRegImm32(s, natRegR10(), 10)
    s = natMovRegReg(s, natRegRAX(), natRegRCX())
    s = natCqo(s)
    s = natDivReg(s, natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 48)
    s = natStoreMem8Off(s, natRegRAX(), natRegRSP(), 4)
    s = natAddRegImm32(s, natRegRDX(), 48)
    s = natStoreMem8Off(s, natRegRDX(), natRegRSP(), 5)
    s = natMovRegImm32(s, natRegR11(), 6)
    s = natLeaRegStack(s, natRegRAX(), 0)
    s = natMark(s, "flttrim")
    s = natMovRegReg(s, natRegRCX(), natRegR11())
    s = natAddRegReg(s, natRegRAX(), natRegRCX())
    s = natMovzxRegMem8(s, natRegRCX(), natRegRAX(), -1)
    s = natLeaRegStack(s, natRegRAX(), 0)
    s = natCmpRegImm32(s, natRegRCX(), 48)
    s = natJnz(s, "flttrimdone")
    s = natDecReg(s, natRegR11())
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJnz(s, "flttrim")
    s = natMark(s, "flttrimdone")
    s = natTestRegReg(s, natRegR11(), natRegR11())
    s = natJz(s, "fltnofrac")
    // The digit count lives in R11 across the "." write below, and a Win64
    // kernel32 call CLOBBERS R11 (caller-saved), so it is spilled and reloaded.
    // Without this the fraction write uses the clobbered count: on the raw
    // syscall path R11 happens to survive, so the bug is invisible on Linux,
    // but on Windows every float would print as a bare integer ("1.5" -> "1").
    s = natStoreStack(s, natRegR11(), 8)
    s = natRodataRef(s, natRegRSI())
    s = natMovRegImm32(s, natRegRDX(), 1)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natLeaRegStack(s, natRegRSI(), 0)
    s = natLoadStack(s, natRegRDX(), 8)
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natWriteStdout(s)
    s = natMark(s, "fltnofrac")
    s = natPrintNewline(s)
    s = natAddRegImm32(s, natRegRSP(), 64)
    return natRet(s)
}

// The sign-mask constant 1<<63 is written as 0 - 9223372036854775807 - 1
// rather than as the literal 9223372036854775808, and that is a CORRECTNESS
// requirement rather than a style choice.
//
// Karkain's integer surface is signed 64-bit, so the literal 9223372036854775808
// (which is 1<<63, one past the maximum) cannot be represented: the parser
// clamps it and natBytesLE then emits FF FF FF FF FF FF FF FF where the oracle
// emits 00 00 00 00 00 00 00 80. That is the 151B constant-class bug recurring
// in a new place -- a hand-written decimal that looks right and silently
// produces a different instruction, here `and r11, rcx` testing the wrong mask
// and therefore printing the wrong result for every negative float.
//
// Written as a negative it is exact, and natBytesLE masks each byte, so the
// arithmetic shift of a negative value yields the correct two's-complement
// bytes: (-1<<63) >> 56 = 0xFF..80, & 0xFF = 0x80.
// ============================================================
// Phase 151A Step 8c - float statement lowering in kcc
//
// Step 8a ported the SSE2 primitives and Step 8b the print_float helper; both
// were unreachable from an actual statement. This slice is the first one where
// an expression LOWERING exists, and it is what makes whole-image parity
// testable for a real program.
//
// THE LOAD-BEARING FACT, and it is the reason this slice is smaller than it
// looks: a float local is ONE 8-byte unit in exactly the same frame slot an int
// would occupy. emitLet's float path is therefore the int path's
// `StoreStack(RAX, off)` with the f64 bits left in RAX by emitFloat. Nothing
// about the frame changes between kinds, and `rsp` never moves.
//
// Mirrors, in pkg/native/program.go:
//   emitFloat      -> natFloatLit / natFloatLocal
//   emitFloatBinary-> natFloatBinary (staging through binTemp, then xmm0/xmm1)
//   emitFloatDiv   -> the zero-divisor short-circuit
//   emitFloatNeg   -> XOR with 1<<63, never 0.0 - x, so -0.0 survives
//   emitFloatCond  -> the six comparisons as real branches
//
// The corpus arms are the distinct SHAPES, not one per operator: the literal
// store, the staged binary, the divide short-circuit, unary negation, and the
// three comparison families (`==`, `!=`, and the four ordered ones which share
// a shape).

// natFloatLit emits a float literal by materialising its IEEE-754 pattern
// verbatim: movabs rax, <bits>. No rounding and no sign-bit normalisation, so
// the bits of 0.0 and -0.0 stay distinct.
func natFloatLit(bits) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), bits)
    return natToHex(natFinish(s))
}

// natFloatLet mirrors emitLet's non-string path for a float binding: the value
// arrives in RAX and is stored with the int path's single StoreStack.
func natFloatLet(bits, off) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), bits)
    s = natStoreStack(s, natRegRAX(), off)
    return natToHex(natFinish(s))
}

// natFloatBinary mirrors emitFloatBinary for one operator. The operands are
// staged through binTemp+depth*8 exactly as the oracle does, because RAX must
// carry both sides into xmm in a defined order and the right side is evaluated
// second.
func natFloatBinary(op, lbits, rbits, temp, depth) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), lbits)
    s = natStoreStack(s, natRegRAX(), temp + depth * 8)
    s = natMovRegImm64(s, natRegRAX(), rbits)
    s = natMovXmmRegGp(s, 1, natRegRAX())
    s = natLoadStack(s, natRegRAX(), temp + depth * 8)
    s = natMovXmmRegGp(s, 0, natRegRAX())
    if (op == "add") {
        s = natAddsdXmmXmm(s, 0, 1)
    }
    if (op == "sub") {
        s = natSubsdXmmXmm(s, 0, 1)
    }
    if (op == "mul") {
        s = natMulsdXmmXmm(s, 0, 1)
    }
    if (op == "div") {
        s = natFloatDiv(s, 0, 1)
    }
    s = natMovGpRegXmm(s, natRegRAX(), 0)
    return natToHex(natFinish(s))
}

// natFloatDiv mirrors emitFloatDiv: a zero divisor short-circuits to +0.0
// rather than producing an infinity that would poison every later step.
// ucomisd reports ZF=1 for 0.0, -0.0 and NaN, and all three compare unequal to
// zero in C, so all three take the short-circuit -- exactly the `r != 0.0`
// guard the C backend writes.
func natFloatDiv(s, num, den) {
    s = natXorpdXmmXmm(s, 2, 2)
    s = natUcomisdXmmXmm(s, den, 2)
    s = natJnz(s, "fdiv")
    s = natXorpdXmmXmm(s, num, num)
    s = natJmp(s, "fdivend")
    s = natMark(s, "fdiv")
    s = natDivsdXmmXmm(s, num, den)
    s = natMark(s, "fdivend")
    return s
}

// natFloatNeg mirrors emitFloatNeg: XOR with 1<<63 is exact for every finite
// value, both zeros and NaN payloads keep their magnitude, so -0.0 stays -0.0
// where a `0.0 - x` or an integer NegReg would silently destroy it.
func natFloatNeg(bits) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRCX(), 0 - 9223372036854775807 - 1)
    s = natMovXmmRegGp(s, 1, natRegRCX())
    s = natMovXmmRegGp(s, 0, natRegRAX())
    s = natXorpdXmmXmm(s, 0, 1)
    s = natMovGpRegXmm(s, natRegRAX(), 0)
    return natToHex(natFinish(s))
}

// natFloatCond mirrors emitFloatCond for one comparison. It emits the whole
// condition, jumping to `falseLabel` when the comparison does NOT hold, which
// is the oracle's shape: the caller supplies the false edge.
//
// `lt`, `le`, `gt` and `ge` differ only in which operand order feeds ucomisd
// and in whether the branch is jbe or jb, so they are one shape parameterised
// by which side is compared and which branch is taken.
func natFloatCond(op, lbits, rbits, temp, falseLabel) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), lbits)
    s = natStoreStack(s, natRegRAX(), temp)
    s = natMovRegImm64(s, natRegRAX(), rbits)
    s = natMovXmmRegGp(s, 1, natRegRAX())
    s = natLoadStack(s, natRegRAX(), temp)
    s = natMovXmmRegGp(s, 0, natRegRAX())
    if (op == "eq") {
        s = natUcomisdXmmXmm(s, 0, 1)
        s = natJp(s, falseLabel)
        s = natJnz(s, falseLabel)
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    if (op == "ne") {
        s = natUcomisdXmmXmm(s, 0, 1)
        s = natJp(s, "fne")
        s = natJnz(s, "fne")
        s = natJmp(s, falseLabel)
        s = natMark(s, "fne")
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    // Ordered comparisons: `<`/`<=` feed the operands to ucomisd SWAPPED, so
    // the single branch becomes the "greater" case on the other operand. `<`
    // and `<=` differ only in jbe vs jb (below-or-equal vs strictly below), and
    // `>`/`>=` are the same two branches on the unswapped compare.
    if (op == "lt") {
        s = natUcomisdXmmXmm(s, 1, 0)
        s = natJbe(s, falseLabel)
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    if (op == "le") {
        s = natUcomisdXmmXmm(s, 1, 0)
        s = natJb(s, falseLabel)
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    if (op == "gt") {
        s = natUcomisdXmmXmm(s, 0, 1)
        s = natJbe(s, falseLabel)
        s = natMark(s, falseLabel)
        return natToHex(natFinish(s))
    }
    s = natUcomisdXmmXmm(s, 0, 1)
    s = natJb(s, falseLabel)
    s = natMark(s, falseLabel)
    return natToHex(natFinish(s))
}
// natFloatStmtCorpus emits the Step 8c reference shapes, one hex line per arm.
//
// The literals are 1.5 and 2.25, and their IEEE-754 patterns were computed
// rather than written by eye -- the same discipline the 151B constant bug
// demanded. `b1515` is float64bits(1.5) = 0x3FF8000000000000 and `b225` is
// float64bits(2.25) = 0x4002000000000000; both are passed in from the caller so
// the test file states them, which keeps this file free of new magic numbers.
//
// temp is the oracle's binTemp base for a one-local frame, so the staging
// offsets are the ones the oracle really uses.
func natFloatStmtCorpus(which, b1515, b225, temp) {
    if (which == 0) {
        return natFloatLet(b1515, 0)
    }
    if (which == 1) {
        return natFloatLocal(0)
    }
    if (which == 2) {
        return natFloatBinary("add", b1515, b225, temp, 0)
    }
    if (which == 3) {
        return natFloatBinary("sub", b1515, b225, temp, 0)
    }
    if (which == 4) {
        return natFloatBinary("mul", b1515, b225, temp, 0)
    }
    if (which == 5) {
        return natFloatBinary("div", b1515, b225, temp, 0)
    }
    if (which == 6) {
        return natFloatNeg(b1515)
    }
    if (which == 7) {
        return natFloatCond("eq", b1515, b225, temp, "$false")
    }
    if (which == 8) {
        return natFloatCond("ne", b1515, b225, temp, "$false")
    }
    if (which == 9) {
        return natFloatCond("lt", b1515, b225, temp, "$false")
    }
    if (which == 10) {
        return natFloatCond("le", b1515, b225, temp, "$false")
    }
    if (which == 11) {
        return natFloatCond("gt", b1515, b225, temp, "$false")
    }
    if (which == 12) {
        return natFloatCond("ge", b1515, b225, temp, "$false")
    }
    return ""
}

// natFloatLocal mirrors emitFloat's identifier case: the stored 64-bit pattern
// is reloaded unchanged, exactly as the int path reloads an int.
func natFloatLocal(off) {
    let s = natNewEmitter(0)
    s = natLoadStack(s, natRegRAX(), off)
    return natToHex(natFinish(s))
}

// ============================================================
// Phase 151A Step 8d - the call ABI (int first)
//
// Phase 148's convention, which this slice ports:
//
//   CALLER. Each argument is evaluated and staged to the per-arg spill, then
//   all units are loaded back into the argument registers, the extras pointer
//   is materialised if any unit exceeded the budget, and the call is made.
//   Units 0-5 travel in RDI,RSI,RDX,RCX,R8,R9; further units travel in the
//   CALLER's extras area, addressed through R10.
//
//   CALLEE. After `sub rsp, frame`, each parameter's unit is homed from its
//   argument register into its frame slot; units past the budget are read
//   through R10. The homing happens at entry, before R10 can die.
//
// WHY THE FRAME IS NOT TOUCHED. The per-arg spill is NOT a separate region
// inserted before extrasBase. The oracle computes
//
//     argTemp(i) = frame - argSpillBytes + i*16
//
// i.e. it indexes DOWNWARD from the frame size, 16 bytes per argument. Phase
// 151A Step 1 already reserved exactly that: native_value.kark computes
// `frame = next + natArgSpillBytes()` with argSpillBytes() = 96 (6 x 16) and
// exposes frame as layout slot 6. No region is inserted and NOTHING moves, which
// is why this slice asserts the frame numbers and the whole-tree KIR pin are
// UNCHANGED. Had a region genuinely been missing, extrasBase, next and frame
// would all have shifted, along with every frame-dependent displacement in
// Steps 1-8c. Their not moving is the evidence the reading is right.
//
// SCOPE IS INT ONLY. Every int takes ONE unit, so stageUnit's string special
// case -- where RSI is the high half of a two-unit argument and lands 8 bytes
// higher -- cannot arise here. Float is also one unit (kindUnits(KindFloat) == 1)
// and therefore rides the identical path; it is a kind-plumbing follow-up, not
// new emission.

// natArgTemp mirrors Builder.argTemp: the caller-side per-argument spill at the
// top of the frame, addressed downward from the frame size.
func natArgTemp(i, frame) { return frame - natArgSpillBytes() + i * 16 }

// natCallArgsN mirrors emitCallValue for N int arguments, units 0..N-1 all
// within the register budget: stage every argument, then load every unit back.
func natCallArgsN(vals, n, frame) {
    let s = natNewEmitter(0)
    let i = 0
    while (i < n) {
        s = natMovRegImm64(s, natRegRAX(), vals[i])
        s = natStoreStack(s, natRegRAX(), natArgTemp(i, frame))
        i = i + 1
    }
    i = 0
    while (i < n) {
        s = natLoadStack(s, natArgReg(i), natArgTemp(i, frame))
        i = i + 1
    }
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natCallArgsExtras mirrors the same call with SEVEN int arguments, so unit 6
// exceeds the register budget. That unit is staged straight to the extras area
// (no spill slot), and R10 is loaded with the extras base so the callee can read
// it.
func natCallArgsExtras(vals, frame, extrasBase) {
    let s = natNewEmitter(0)
    let i = 0
    while (i < 7) {
        s = natMovRegImm64(s, natRegRAX(), vals[i])
        if (i < 6) {
            s = natStoreStack(s, natRegRAX(), natArgTemp(i, frame))
        } else {
            s = natStoreStack(s, natRegRAX(), extrasBase)
        }
        i = i + 1
    }
    i = 0
    while (i < 6) {
        s = natLoadStack(s, natArgReg(i), natArgTemp(i, frame))
        i = i + 1
    }
    s = natLeaRegStack(s, natRegR10(), extrasBase)
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natPrologueArgsN mirrors the callee's arg homing for N parameters, all within
// the register budget: each parameter's slot is written from its argument
// register, in parameter order.
func natPrologueArgsN(n, frame, localsBytes) {
    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    let i = 0
    while (i < n) {
        s = natStoreStack(s, natArgReg(i), localsBytes + i * 8)
        i = i + 1
    }
    return natToHex(natFinish(s))
}

// natPrologueExtras mirrors the callee's homing when a parameter's unit sits
// past the register budget: it is read through R10 at (unit-6)*8 and stored.
// The read happens at ENTRY, before R10 can be clobbered by anything else.
func natPrologueExtras(n, frame, localsBytes) {
    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    let i = 0
    while (i < n) {
        if (i < 6) {
            s = natStoreStack(s, natArgReg(i), localsBytes + i * 8)
        } else {
            s = natLoadBaseOff(s, natRegRAX(), natRegR10(), (i - 6) * 8)
            s = natStoreStack(s, natRegRAX(), localsBytes + i * 8)
        }
        i = i + 1
    }
    return natToHex(natFinish(s))
}

// natArgReg returns the argument register for unit i: RDI,RSI,RDX,RCX,R8,R9.
func natArgReg(i) {
    if (i == 0) { return natRegRDI() }
    if (i == 1) { return natRegRSI() }
    if (i == 2) { return natRegRDX() }
    if (i == 3) { return natRegRCX() }
    if (i == 4) { return natRegR8() }
    return natRegR9()
}

// natCallCorpus emits the Step 8d reference sequences.
//
// The literals are 1..7 so each staged value is distinguishable from its
// neighbours in a hex dump -- a corpus of identical values would hide an
// off-by-one in the spill indexing, which is precisely the bug this slice could
// plausibly introduce.
//
// `frame` and `extrasBase` are passed in rather than computed here, so the test
// states the oracle's real layout numbers and this file gains no magic numbers.
func natCallCorpus(which, frame, extrasBase, localsBytes) {
    let one = [7]
    let three = [7, 11, 13]
    let seven = [7, 11, 13, 17, 19, 23, 29]
    if (which == 0) { return natCallArgsN(one, 1, frame) }
    if (which == 1) { return natCallArgsN([7, 11], 2, frame) }
    if (which == 2) { return natCallArgsN(three, 3, frame) }
    if (which == 3) { return natCallArgsExtras(seven, frame, extrasBase) }
    if (which == 4) { return natPrologueArgsN(1, frame, localsBytes) }
    if (which == 5) { return natPrologueArgsN(3, frame, localsBytes) }
    if (which == 6) { return natPrologueExtras(7, frame, localsBytes) }
    return ""
}
// ============================================================
// Phase 151A Step 8e - floats through the call ABI
//
// This slice exists to PROVE a claim rather than to add emission, and the claim
// is the load-bearing one for the whole float kind:
//
//   floats need NO new ABI code.
//
// `kindUnits(KindFloat) == 1` in the oracle and `natKindUnits` in kcc already
// agree, so a float parameter occupies exactly one frame slot and a float
// argument is staged, loaded and passed by the byte-for-byte identical path an
// int uses. What Step 8d built is already float-capable; this slice demonstrates
// that rather than asserting it.
//
// The consequence worth stating: a float argument is `emitFloat` followed by
// `stageUnit(i, unit, RAX)` and `unit++` -- the int arm with a different
// evaluator in front of it. A float return is the int return, since the f64 bits
// are already in RAX. So the shapes below are the Step 8d shapes with float
// operands, and the gate's strongest layer asserts they are BYTE-IDENTICAL to the
// int shapes rather than merely similar.

// natFloatArgCall is Step 8d's one-argument call with a FLOAT literal staged.
// The staging, the spill address, the RDI load and the call are all the same
// emission; only the literal's bits differ.
func natFloatArgCall(bits, frame) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), bits)
    s = natStoreStack(s, natRegRAX(), natArgTemp(0, frame))
    s = natLoadStack(s, natRegRDI(), natArgTemp(0, frame))
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natFloatParamHome is Step 8d's callee homing for one parameter, with the
// parameter declared FLOAT. A float parameter is homed from RDI into its frame
// slot exactly as an int is; there is no conversion and no separate area.
func natFloatParamHome(frame, localsBytes) {
    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natStoreStack(s, natRegRDI(), localsBytes)
    return natToHex(natFinish(s))
}

// natFloatReturn is the float return: emitFloat has already left the f64 bits in
// RAX, and the int return convention applies unchanged.
//
// There is deliberately NO frame teardown here. The oracle's ReturnStmt case is
// `emitReturn(...)` followed by `Jmp("fn_<name>$ret")` (program.go:4893-4900),
// and the `AddRsp(frame)` happens AT the `$ret` label in the epilogue
// (program.go:4863-4866). A first draft of this function emitted
// `sub rsp, frame` before the jmp, which would have torn the frame down twice.
//
// This also corrects a stale reference: the Step 2 note recorded the `$ret` jmp
// at program.go:3386, and that line now holds an unrelated function
// (emitBase64OutByte). The reference was accurate when written and drifted as the
// file grew, which is the argument for finding a label by searching for it rather
// than by following a remembered line number.
func natFloatReturn(bits) {
    let s = natNewEmitter(0)
    s = natMovRegImm64(s, natRegRAX(), bits)
    s = natJmp(s, "$ret")
    s = natMark(s, "$ret")
    return natToHex(natFinish(s))
}

// natFloatCallCorpus emits the Step 8e shapes. `frame`, `extrasBase` and
// `localsBytes` come from the caller so the test states the real layout numbers.
//
// `b1515` is float64bits(1.5) and `b42` is 42 as an int, chosen so the two
// literals are distinguishable from each other AND from the Step 8d corpus,
// which is what makes the float-vs-int byte comparison meaningful rather than
// accidentally equal.
func natFloatCallCorpus(which, b1515, b42, frame, extrasBase, localsBytes) {
    if (which == 0) { return natFloatArgCall(b1515, frame) }
    if (which == 1) { return natFloatArgCall(b42, frame) }
    if (which == 2) { return natFloatParamHome(frame, localsBytes) }
    if (which == 3) { return natFloatReturn(b1515) }
    return ""
}

// ============================================================
// Phase 151A Step 8f - strings through the call ABI
//
// A string is the FIRST TWO-UNIT kind: kindUnits(KindString) == 2, so it
// occupies two of the argument registers and, more importantly, it is the case
// that exercises stageUnit's high-half rule for the first time.
//
// THE RULE, and it is subtle enough to state exactly. stageUnit homes one
// evaluated unit and picks the slot like this:
//
//     if unit < 6 {
//         off := argTemp(arg)
//         if r == RSI { off += 8 }
//         StoreStack(r, off)
//     }
//
// The check is on the REGISTER, not on the unit index. That is sound because
// stageUnit is called with RSI in exactly one place -- the string branch of
// emitCallValue passes RDI for the pointer and RSI for the length, while every
// other kind passes RAX. So "r == RSI" is a reliable proxy for "this is a
// string's second unit", and argTemp's 16-byte stride is what gives the pair its
// low and high halves.
//
// The load-back loop then reads argTemp(i) + k*8, where k is the unit index
// WITHIN the argument, so the two halves line up wherever in the register
// sequence the argument happens to start. That is why an int followed by a
// string still works: the string's units land at global indices 1 and 2, but the
// reader indexes by (arg, k), not by global unit.
//
// NO RODATA. A string LITERAL would need a rodata reference, which is unresolved
// at this layer and would force the masked comparison Step 8b needed. A string
// LOCAL is loaded straight from its two frame slots instead, so this slice keeps
// the RAW differential.

// natStringArgCall is a one-string-argument call. The string local occupies two
// frame slots at `loc` (ptr) and `loc+8` (len), matching the oracle's slot
// layout for a two-unit kind.
func natStringArgCall(frame, loc) {
    let s = natNewEmitter(0)
    s = natLoadStack(s, natRegRDI(), loc)
    s = natLoadStack(s, natRegRSI(), loc + 8)
    s = natStoreStack(s, natRegRDI(), natArgTemp(0, frame))
    s = natStoreStack(s, natRegRSI(), natArgTemp(0, frame) + 8)
    s = natLoadStack(s, natRegRDI(), natArgTemp(0, frame))
    s = natLoadStack(s, natRegRSI(), natArgTemp(0, frame) + 8)
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natIntStringArgCall is an int argument followed by a string. The interesting
// property is that the string's two units land at GLOBAL unit indices 1 and 2,
// so RSI is the string's pointer and RDX its length -- while the reader still
// indexes by (arg, k). A corpus that only ever passed a string first could not
// tell the two conventions apart.
func natIntStringArgCall(frame, loc) {
    let s = natNewEmitter(0)
    // arg 0: an int, staged from RAX
    s = natMovRegImm64(s, natRegRAX(), 7)
    s = natStoreStack(s, natRegRAX(), natArgTemp(0, frame))
    // arg 1: a string, staged from the (RDI, RSI) pair
    s = natLoadStack(s, natRegRDI(), loc)
    s = natLoadStack(s, natRegRSI(), loc + 8)
    s = natStoreStack(s, natRegRDI(), natArgTemp(1, frame))
    s = natStoreStack(s, natRegRSI(), natArgTemp(1, frame) + 8)
    // load back, in (arg, k) order
    s = natLoadStack(s, natRegRDI(), natArgTemp(0, frame))
    s = natLoadStack(s, natRegRSI(), natArgTemp(1, frame))
    s = natLoadStack(s, natRegRDX(), natArgTemp(1, frame) + 8)
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natStringParamHome is the callee side: a string parameter occupies two units,
// homed from RDI into the low slot and from RSI into the high slot. There is no
// conversion and no separate area -- a string is passed as two registers, exactly
// as Phase 148 specifies.
func natStringParamHome(frame, loc) {
    let s = natNewEmitter(0)
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natStoreStack(s, natRegRDI(), loc)
    s = natStoreStack(s, natRegRSI(), loc + 8)
    return natToHex(natFinish(s))
}

// natStringArgsExtras is four string arguments -- eight units, so units 6 and 7
// exceed the register budget and travel in the caller's extras area. This is the
// first case that puts the extras region AND the two-unit stride together.
func natStringArgsExtras(frame, loc, extrasBase) {
    let s = natNewEmitter(0)
    let a = 0
    while (a < 4) {
        s = natLoadStack(s, natRegRDI(), loc + a * 16)
        s = natLoadStack(s, natRegRSI(), loc + a * 16 + 8)
        let unit = a * 2
        if (unit < 6) {
            s = natStoreStack(s, natRegRDI(), natArgTemp(a, frame))
            s = natStoreStack(s, natRegRSI(), natArgTemp(a, frame) + 8)
        } else {
            s = natStoreStack(s, natRegRDI(), extrasBase + (unit - 6) * 8)
            s = natStoreStack(s, natRegRSI(), extrasBase + (unit - 6) * 8 + 8)
        }
        a = a + 1
    }
    a = 0
    while (a < 4) {
        let unit = a * 2
        if (unit < 6) {
            s = natLoadStack(s, natArgReg(unit), natArgTemp(a, frame))
            s = natLoadStack(s, natArgReg(unit + 1), natArgTemp(a, frame) + 8)
        }
        a = a + 1
    }
    s = natLeaRegStack(s, natRegR10(), extrasBase)
    s = natCall32(s)
    let r = natRel32(s, "fn_f")
    s = natMark(r[0], "fn_f")
    return natToHex(natFinish(s))
}

// natStringCallCorpus emits the Step 8f shapes. frame/loc/extrasBase come from
// the caller so the test states the real layout numbers and this file gains no
// magic numbers.
//
// `loc` is 8, the first local slot after the frame's zero-argument case; four
// string locals then occupy 8..39 at 16 bytes each, which is what the extras
// arm reads.
func natStringCallCorpus(which, frame, loc, extrasBase) {
    if (which == 0) { return natStringArgCall(frame, loc) }
    if (which == 1) { return natIntStringArgCall(frame, loc) }
    if (which == 2) { return natStringParamHome(frame, loc) }
    if (which == 3) { return natStringArgsExtras(frame, loc, extrasBase) }
    return ""
}
// ============================================================
// Phase 151A Step 9a - rodata resolution
//
// Every absolute address in a kcc image is emitted as a 10-byte `mov r64, imm64`
// with the immediate left at zero, and the POSITION recorded. That is the only
// way a linker can fill in an address it alone knows, and it is what
// natImm64Patch has always produced. What was missing is the other half: nothing
// recorded WHICH rodata byte each position refers to, so print_int's two `"-"`
// and `"\n"` references had sites but no destinations.
//
// This is the piece every section of this baseline has named as the thing
// blocking 151D, so it is deliberately small and deliberately boring:
//
//   natRodataRefOff  emits a rodata reference AND records (position, offset)
//   natRodataSection builds the rodata byte array, interning duplicates
//   natResolveRodata fills every recorded site with base + rva + offset
//
// `natRodataRef` is deliberately NOT changed. The frozen Step 7 and Step 8b
// corpora use it, and both compare emitted BYTES, which recording would not
// alter. The new function sits alongside it.

// natRodataRefOff emits `movabs r, <rodata placeholder>` and records the site
// together with the offset it refers to.
//
// The immediate stays ZERO here. Resolution happens once, later, in
// natResolveRodata, because the base address is not known until the container
// writer has chosen a layout -- an emitter that filled the address in would be
// guessing a number the linker owns.
func natRodataRefOff(s, r, roOff) {
    let p = natImm64Patch(s, natMovImm64Op(r))
    s = p[0]
    s[6] = appendArray(s[6], p[1])
    s[7] = appendArray(s[7], roOff)
    return s
}

// natRodataSection builds the rodata byte array from a list of strings,
// interning duplicates, and returns [bytes, offsetOfFirstUse].
//
// Interning matters for byte-identity: the oracle's `internRodata` also
// deduplicates, so a repeated string occupies ONE rodata entry there and must
// occupy one here, or every following offset moves.
//
// The return carries the offset of the FIRST string so the caller can record it
// against the first site it emits without a second lookup.
func natRodataSection(strs) {
    let bytes = []
    let offs = []
    let i = 0
    while (i < len(strs)) {
        // linear scan for an existing interned copy
        let found = -1
        let j = 0
        while (j < len(strs)) {
            if (j < i) {
                if (natStrEq(strs[j], strs[i])) { found = offs[j] }
            }
            j = j + 1
        }
        if (found >= 0) {
            offs = appendArray(offs, found)
        } else {
            offs = appendArray(offs, len(bytes))
            bytes = natAppendStr(bytes, strs[i])
        }
        i = i + 1
    }
    return [bytes, offs]
}

// natStrEq compares two Karkain strings for equality.
//
// A first draft indexed the string (`a[i] != b[i]`), which compiles and yields
// 0 for every position -- Karkain strings are NOT indexable, and the comparison
// silently succeeded on two different strings. The compiler's own idiom is
// `substr(s, i, 1)`, which is what Step 6's Mach-O writer uses, so that is what
// this uses.
func natStrEq(a, b) {
    if (len(a) != len(b)) { return 0 }
    let i = 0
    while (i < len(a)) {
        if (substr(a, i, 1) != substr(b, i, 1)) { return 0 }
        i = i + 1
    }
    return 1
}

// natAppendStr appends a Karkain string's bytes to a byte array.
//
// Karkain has no byte string literal and its strings are not indexable, so each
// byte is taken with `asciiVal(substr(str, i, 1))` -- the same idiom the
// compiler's own lexer and the Mach-O writer use. Truncating to 8 bits is exact
// for the ASCII payloads the runtime emits, and is stated here so the limit is a
// decision rather than an accident.
func natAppendStr(dst, str) {
    let i = 0
    while (i < len(str)) {
        dst = appendArray(dst, asciiVal(substr(str, i, 1)) & 255)
        i = i + 1
    }
    return dst
}

// natResolveRodata fills every recorded rodata site with base + roRVA + offset,
// in place, and returns the number of sites resolved.
//
// `base` is the container's load base and `roRVA` the rodata section's RVA. Both
// come from the writer, not from here: this layer knows WHERE a site is and WHAT
// it points at, and the writer knows what the image will actually be loaded at.
func natResolveRodata(s, base, roRVA) {
    let n = 0
    let i = 0
    while (i < len(s[6])) {
        let pos = s[6][i]
        let off = s[7][i]
        // The name avoids `addr`, which is a RESERVED WORD in this language (the
        // same class of trap as Step 8b's `raw` parameter): the parse error names
        // the token rather than the offending field, so a reserved word reads as a
        // malformed declaration.
        let av = base + roRVA + off
        let code = natStCode(s)
        // little-endian, 8 bytes, written in place
        code[pos] = av & 255
        code[pos + 1] = (av >> 8) & 255
        code[pos + 2] = (av >> 16) & 255
        code[pos + 3] = (av >> 24) & 255
        code[pos + 4] = (av >> 32) & 255
        code[pos + 5] = (av >> 40) & 255
        code[pos + 6] = (av >> 48) & 255
        code[pos + 7] = (av >> 56) & 255
        n = n + 1
        i = i + 1
    }
    return n
}

// natRodataSiteCount reports how many rodata sites have been recorded, so a gate
// can assert a count rather than trusting that resolution happened.
func natRodataSiteCount(s) { return len(s[6]) }
// ============================================================
// Phase 151A Step 9a - the rodata resolution measurement corpus
//
// Four strings with one deliberate duplicate, so interning is observable: the
// oracle's internRodata deduplicates by FIRST USE, so the repeated "-" must
// occupy one entry and the section must be 5 bytes, not 8. An implementation that
// appended every occurrence would produce the same bytes for the first two
// entries and a different length, which is exactly what the length assertion
// catches.
//
// Two reference sites are recorded, at offsets 0 and 2, and then resolved with
// base 0x140000000 and roRVA 0x3000 -- the PE values Step 5/6 use -- so the
// expected addresses are 0x140003000 and 0x140003002.
func natRodataCorpus() {
    let strs = ["-", "\n", "abc", "-"]
    let sec = natRodataSection(strs)
    let rodata = sec[0]
    let offs = sec[1]

    let s = natNewEmitter(0)
    s = natMark(s, "prog")
    s = natRodataRefOff(s, natRegRSI(), offs[0])
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natRodataRefOff(s, natRegRSI(), offs[2])
    s = natMovRegImm32(s, natRegRDI(), 2)

    print(natToHex(rodata))
    print(natToHex(natStCode(s)))

    // Resolve with the PE base and the PE rodata RVA, then emit again: the two
    // immediates are the only bytes that differ between the two lines.
    natResolveRodata(s, 5368709120, 12288)
    print(natToHex(natStCode(s)))
    print(str(natRodataSiteCount(s)))
    return
}


// ============================================================
// Phase 151A Step 9b - the Windows write path and one-state program assembly
//
// WHY THIS SLICE EXISTS. Step 9a could resolve rodata addresses but had nothing
// to resolve them FOR: no whole program was ever emitted. Step 9b assembles one.
//
// The blocker found by measuring, not by planning: print_int writes through the
// LINUX `write` syscall. natWriteStdout is natSysWrite()==1 plus natSyscall, which
// is the oracle's emitWrite NON-WINDOWS body. The oracle's emitWrite switches on
// b.goos and dispatches to emitWinWrite, and that Windows body was never ported.
// So a PE image built from the existing print_int would execute a Linux `syscall`
// instruction on Windows and fault on the first digit -- which is why Step 6's
// PE images deliberately do NOT print.
//
// So Step 9b ports emitWinWrite. Every instruction is the oracle's, in the
// oracle's order.
// ============================================================

// natStdOutHandle is STD_OUTPUT_HANDLE, -11 as the 32-bit constant the oracle
// moves into RCX (4294967285 = 0xFFFFFFF5).
func natStdOutHandle() { return 4294967285 }

// natWinWrite mirrors Builder.emitWinWrite in pkg/native/program.go.
//
// Contract: write (RSI=ptr, RDX=len) to stdout through kernel32 WriteFile.
//
// Two facts in the oracle's own comment are load-bearing and are reproduced
// rather than re-derived:
//
//  1. PUSH ORDER. RBX is pushed FIRST (deepest) because its POP happens LAST; it
//     has to survive BOTH kernel32 calls, and print_int keeps an end pointer in
//     RBX across writes. A Phase 150C defect once pushed RSI,RDX,RBX but popped
//     RDX,RSI,...,RBX, so every pop read the wrong slot; WriteFile then received a
//     garbage pointer and length, wrote nothing, and returned without an error --
//     so the process exited 0 with EMPTY stdout, which is exactly what the
//     `if out != ""` guard in the PE tests silently skips. This ordering is
//     therefore load-bearing for the test to mean anything, not a style choice.
//
//  2. 48, NOT 40, for the WriteFile shadow. RBX is still live on the stack (8
//     bytes), so the caller's rsp already sits 8 lower than the pre-push baseline;
//     48 keeps rsp%16 == 0 at the call where 40 would flip it to 8 and fault
//     inside kernel32.
func natWinWrite(s) {
    s = natPushReg(s, natRegRBX())
    s = natPushReg(s, natRegRSI())
    s = natPushReg(s, natRegRDX())
    // 32 = the Win64 caller shadow for GetStdHandle. With three live pushes
    // (24 bytes) above it, rsp%16 lands on 0 before the call.
    s = natSubRegImm32(s, natRegRSP(), 32)
    s = natMovRegImm32(s, natRegRCX(), natStdOutHandle())
    s = natIatCall(s, natRegRAX(), natIatGetStdHandle())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 32)
    s = natPopReg(s, natRegRDX())
    s = natPopReg(s, natRegRSI())
    // Win64 WriteFile(hFile=RCX, lpBuffer=RDX, nBytes=R8, written=R9):
    // the handle comes from GetStdHandle in RAX, and ptr/len must be moved into
    // RDX/R8 AFTER the pops, because the GetStdHandle call clobbered RCX/RDX.
    s = natMovRegReg(s, natRegRCX(), natRegRAX())
    s = natMovRegReg(s, natRegR8(), natRegRDX())
    s = natMovRegReg(s, natRegRDX(), natRegRSI())
    s = natSubRegImm32(s, natRegRSP(), 48)
    s = natLeaRegStack(s, natRegR9(), 24)
    s = natXorRegReg(s, natRegRAX())
    s = natStoreStack(s, natRegRAX(), 32)
    s = natIatCall(s, natRegRAX(), natIatWriteFile())
    s = natCallReg(s, natRegRAX())
    s = natAddRegImm32(s, natRegRSP(), 48)
    // Win64 WriteFile may clobber RCX/RDX (and R8-R11) on return, so the
    // caller's RBX is restored after the shadow is released.
    s = natPopReg(s, natRegRBX())
    return s
}


// ============================================================
// Phase 151A Step 9b - ONE-STATE PE PROGRAM ASSEMBLY
//
// Steps 1-8f and 9a all emitted CORRECTLY but never TOGETHER into one runnable
// program: each was a corpus shape compared against the oracle, and Step 9a could
// resolve rodata addresses but had nothing to resolve them FOR. Step 9b is the
// first composition, and it is deliberately small:
//
//	_start -> karkain_main -> print_int
//
// All three pieces go into ONE emitter state, which is the whole point. Two states
// cannot work: print_int's rodata sites would live in a different state from the
// linker's, so nothing could join them, and the IAT indices the print path
// contributes would have to be recovered from emission order.
//
// WHAT THIS IS NOT, stated before it is misread: this is still a fixed program
// compiled into kcc, NOT the whole-program driver 151A still owes. The driver is
// what makes kcc own native targets; this proves the MACHINERY -- one state,
// resolved rodata, index-tagged IAT, a real linked image -- so the driver has
// something to drive.
// ============================================================

// The PE load base and .text RVA are NOT redefined here: native_pe.kark already
// declares natPEBaseAddr (0x140000000) and natPETextRVA (0x1000) as the
// container's own constants, and a second pair with the same values would be two
// facts that could disagree. Reusing them means a change to the container's base
// propagates here automatically instead of silently resolving every rodata
// address against a stale number.

// natFlatPairs interleaves two parallel lists into the flat [pos, idx, pos, idx]
// shape natPELink takes.
//
// The oracle's patch slices are Go structs; Karkain has no records, so the pairing
// is expressed as a flat array of alternating position and index. That is also why
// there are TWO lists per kind rather than one: a flat array cannot be indexed as
// a pair without knowing where each pair starts, and recomputing that per element
// is exactly the kind of arithmetic a wrong assumption hides inside.
func natFlatPairs(posArr, idxArr) {
    let out = []
    let i = 0
    while (i < len(posArr)) {
        out = appendArray(out, posArr[i])
        out = appendArray(out, idxArr[i])
        i = i + 1
    }
    return out
}

// natPEPrintValue is the value karkain_main prints. A distinctive literal on
// purpose: a program that prints 0, or prints nothing, is indistinguishable from
// a program whose print path silently wrote to a bad handle -- which is precisely
// the failure mode Step 9b exists to make impossible.
func natPEPrintValue() { return 12345 }

// natPEMainBody emits karkain_main's body into an existing state.
//
// It is factored out because BOTH natPEProgram and natPEShape need it, and a
// gate that inspected a separately rebuilt text would be testing a second
// emission -- the same class of failure as comparing a transcription instead of a
// compiler.
//
// The `sub rsp, 40` is Win64 ABI, not decoration: _start aligned rsp to 16 and
// then called, so rsp % 16 == 8 at main entry, and a Win64 call site requires
// rsp % 16 == 0 immediately before the `call`. 40 = 32 bytes of caller shadow
// space plus 8 bytes that restore the alignment. Without it the callee is entered
// misaligned and kernel32 faults on the first call inside print_int.
//
// RAX is main's return value and _start passes it straight to ExitProcess, so 0
// is both "return 0" and "exit code 0".
func natPEMainBody(s) {
    s = natSubRegImm32(s, natRegRSP(), 40)
    s = natMovRegImm32(s, natRegRDI(), natPEPrintValue())
    s = natCall32(s)
    let r = natRel32(s, "print_int")
    s = r[0]
    s = natAddRegImm32(s, natRegRSP(), 40)
    s = natMovRegImm32(s, natRegRAX(), 0)
    return natRet(s)
}

// natPEProgram builds the whole Step 9b PE image: _start, karkain_main,
// print_int, resolved rodata, index-tagged IAT patches, and a linked image.
//
// The rodata section is interned FIRST-USE across the program's references.
// print_int references "-" on the sign path and "\n" for the terminator, in that
// emission order, so the offsets are 0 and 1. Those are passed into
// natPrintIntBody rather than interned inside it, because interning is a property
// of the whole program: once another function contributes a rodata string the
// offsets move, and a helper that invented its own would be wrong.
func natPEProgram() {
    // natWinStub emits _start, the alignment, the PEB bootstrap, the call to
    // karkain_main and the Win64 exit tail, then MARKS karkain_main -- so
    // everything appended by natPEMainBody lands inside main.
    let s = natWinStub()
    s = natPEMainBody(s)
    // print_int, in the SAME state. winWrite = 1 selects the Windows write path
    // ported above; rodata offsets 0 ("-") and 1 ("\n").
    s = natPrintIntBody(s, 1, 0, 1)
    let text = natFinish(s)

    // Resolve rodata against the REAL PE layout. pkg/native/pe.go lays .text out
    // as code followed by rodata, so a rodata byte at offset `off` is at
    // PEBase + textRVA + len(text) + off. len(text) is MEASURED from the finished
    // text and never assumed: a hard-coded length would resolve every address in a
    // program whose main body differed by even one byte, and every such program
    // would still LINK -- it would just read the wrong memory.
    let ro = natRodataSection(["-", "\n"])
    // NOT `s = natResolveRodata(...)`: that function returns the NUMBER of sites
    // it resolved, not the state. Assigning it would overwrite the emitter with
    // an integer, and every subsequent natSt* accessor would read an int's "slot"
    // and return 0 -- silently producing an image with NO resolved rodata and NO
    // IAT patches, which still links and still has the right length. Arm 3 exists
    // precisely to make that failure visible; this is the bug it was added for.
    natResolveRodata(s, natPEBaseAddr() + natPETextRVA() + len(text), 0)

    // THE RODATA PATCH LIST GOES TO THE LINKER, and that is the fix for a real
    // defect this slice's own execution evidence exposed.
    //
    // natPELink does TWO things with it: it writes the immediate (roBase + offset,
    // the same formula used here) AND it adds a DIR64 entry for each site. Passing
    // an EMPTY list -- which the first version did -- resolved nothing through the
    // linker and put NO relocation entry on either rodata site.
    //
    // This image sets DYNAMIC_BASE and HIGH_ENTROPY_VA, and the host DOES rebase
    // it, so those two immediates kept the preferred load address and pointed at
    // unmapped memory.
    //
    // The symptom was the nastiest kind available. print_int wrote its digits from
    // the STACK (no absolute address, so unaffected), then its newline write read
    // from an unmapped pointer, and WriteFile failed, wrote ZERO bytes and returned
    // no error -- so the process exited 0. Every structural layer passed: the image
    // was a valid PE, the rodata addresses were exactly the ones this file
    // computed, the IAT pairing was right. All of them were checked against the
    // FILE, and the FILE is correct. Only running it could see this, which is why
    // the execution layer is not optional here, and why an assertion that trims
    // whitespace off stdout is not enough: the missing byte was the newline.
    let rp = natFlatPairs(natStRodataPos(s), natStRodataOff(s))

    // IAT patches come from the recorded per-kind lists, never from position.
    //   apatches: absolute STORES of resolved kernel32 addresses (the bootstrap)
    //   ipatches: IAT LOADS, i.e. `movabs rax, <slot>` the print path and the exit
    //             tail emit before `call rax`
    // print_int's Windows write contributes FOUR ipatches -- GetStdHandle and
    // WriteFile for each of its two write sites that a positive value reaches --
    // and the exit tail one, on top of the bootstrap's three apatches. The sign
    // write is a third emitted site and adds two more, for 7 ipatches in total.
    // A positional reader would pair the wrong ones.
    let ap = natFlatPairs(natStAbsPos(s), natStAbsIdx(s))
    let ip = natFlatPairs(natStIatPos(s), natStIatIdx(s))
    return natPELink(text, ro[0], [], rp, ip, ap, [], natPETextOff(), natPETextOff())
}

// natPECorpusProg renders the Step 9b composition in four shapes, so a failure
// names a SUBSYSTEM rather than pointing into one long image.
//
//  0 the linked PE image        - the composition, and what 9c will execute
//  1 the resolved .text         - rodata immediates and the main->print call
//  2 the rodata section         - interning and placement
//  3 a count report             - sites and patch kinds, so a resolver that filled
//                                 nothing cannot pass against an all-zero buffer
//
// Arm 3 is deliberately NOT hex. The site and patch counts are the guard against a
// vacuous pass: an image whose placeholders were never filled has the same length
// and the same structure as a correct one, and only the counts prove the work
// happened.
func natPECorpusProg(which) {
    if (which == 0) { return natToHex(natPEProgram()) }
    if (which == 1) { return natToHex(natPEShape(1)) }
    if (which == 2) { return natToHex(natPEShape(2)) }
    if (which == 3) { return natPEShape(3) }
    return ""
}

// natPEShape produces one intermediate of the composition.
//
// The program body is factored out so arms 1 and 2 observe the SAME emission the
// linked image is built from. A gate that rebuilt the text separately to inspect
// it would be testing a second emission, and a defect in the shared path would be
// invisible to it.
func natPEShape(which) {
    let s = natWinStub()
    s = natPEMainBody(s)
    s = natPrintIntBody(s, 1, 0, 1)
    let text = natFinish(s)
    let ro = natRodataSection(["-", "\n"])
    natResolveRodata(s, natPEBaseAddr() + natPETextRVA() + len(text), 0)
    if (which == 1) { return text }
    if (which == 2) { return ro[0] }
    return "sites=" + str(natRodataSiteCount(s)) +
           " ap=" + str(len(natStAbsPos(s))) +
           " ip=" + str(len(natStIatPos(s)))
}

// ============================================================
// Phase 151A Step 9c - the whole-program driver
//
// Step 9b proved the MACHINERY: one emitter state, resolved rodata, index-tagged
// IAT, a real linked image that runs. But its program was a FIXED shape compiled
// into kcc -- `_start + karkain_main(with a hard-coded value) + print_int` -- so
// kcc could demonstrate native execution while still being unable to compile a
// USER'S program.
//
// This is the piece that changes the architecture from "fixed program" to
// "user AST -> native emission". The driver walks the REAL AST that
// `buildNativeFile` already parsed and type-checked, finds `func main` by NAME,
// sizes a frame from main's ACTUAL int locals, lowers each of its statements, and
// refuses anything it cannot lower.
//
// WHAT MAKES IT REAL, stated precisely because the failure this increment exists
// to remove is a compiler that looks like it is doing the work while something
// else does it:
//   * `main` is located by NAME in the program's real top-level statement list.
//     There is no `if program == knownCorpusProgram` anywhere, and no corpus: the
//     driver never learns which file it was given.
//   * the frame size is DERIVED from the count of `let` bindings main actually has,
//     through the same natFrameLayout the value model uses, so two locals and one
//     local produce different frames.
//   * a local's slot comes from its DECLARATION ORDER (natLocalOff), not a table.
//   * `print` resolves an IDENTIFIER to the slot of the binding that introduced
//     it, so `let x = 7; print(x)` and `print(7)` are genuinely different
//     lowerings rather than the same bytes with a different label.
//
// SCOPE, stated as a bound rather than an aspiration. This slice lowers exactly
// what 9b already proved, driven by the AST instead of hard-coded:
//   let <name> = <int literal>
//   print(<int literal>) | print(<name>)
//   return <int literal> | return <name>
// Anything else is a LOUD refusal naming the construct and its line. It is not a
// silent skip and not a fallback to the Go engine.
//
// NOT CLAIMED: whole-program parity with the Go engine, loops, arrays, strings
// beyond print_int's own literals, calls, records or maps. Those are the rest of
// 151A.
// ============================================================

// natNativeFindMain returns the FuncDecl node named `main`, or 0 when there is
// none. It is a NAME lookup, not a shape match: any function called `main` is the
// entry point regardless of how many others exist.
func natNativeFindMain(stmts) {
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        if (nodeType(n) == NODE_FUNC_DECL()) {
            if (funcName(n) == "main") { return n }
        }
        i = i + 1
    }
    return 0
}

// natNativeBodyStmts returns main's statement list.
//
// `funcBody` IS already the statement list -- parseBlock returns its statements
// directly rather than wrapping them in a Block node. The first draft of this
// driver assumed it was a Block, fell through to its single-element fallback, and
// therefore handed the scanner a LIST where it expected a statement: every
// element read back with an empty node type and the refusal text said "statement
// kind [array]". The checker's own consumer is the authority here -- it calls
// checkStmts(tab, funcBody(node), 0) with no unwrapping -- so this does the same.
func natNativeBodyStmts(mainFn) {
    return funcBody(mainFn)
}

// natNativeIsDecl reports whether a statement introduces a binding.
//
// `let` and `var` produce DIFFERENT node kinds -- makeLetDecl vs makeVarDecl,
// i.e. NODE_LET_DECL vs NODE_VAR_DECL -- and the checker tests for both. A first
// draft matched only NODE_VAR_DECL, so `let x = 1` was not recognised as a
// binding at all and was reported as an unsupported statement kind. `const` is
// deliberately NOT a binding here: it is NODE_CONST_DECL and stays unsupported,
// because a constant is not a frame slot.
func natNativeIsDecl(n) {
    let t = nodeType(n)
    return t == NODE_LET_DECL() || t == NODE_VAR_DECL()
}

func natNativeDeclName(n) {
    if (nodeType(n) == NODE_LET_DECL()) { return letDeclName(n) }
    return varDeclName(n)
}

func natNativeDeclValue(n) {
    if (nodeType(n) == NODE_LET_DECL()) { return letDeclValue(n) }
    return varDeclValue(n)
}

func natNativeDeclLine(n) {
    if (nodeType(n) == NODE_LET_DECL()) { return letDeclLine(n) }
    return varDeclLine(n)
}

// natNativeLocalIndex returns the slot index of the local called `name`, or -1.
//
// Declaration order IS the slot order (natLocalOff), the same rule the oracle
// uses, so the two agree on layout without sharing a table. The FIRST binding
// wins: re-binding a name is shadowing, which is a later slice, and silently using
// the last one would let the frame and the value disagree.
func natNativeLocalIndex(stmts, name) {
    let idx = 0
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        if (natNativeIsDecl(n)) {
            if (natNativeDeclName(n) == name) { return idx }
            idx = idx + 1
        }
        i = i + 1
    }
    return 0 - 1
}

// ============================================================
// Phase 151A Step 9d -- native arrays through the real AST driver.
//
// Step 9c's driver handled integers only. This adds the SMALLEST array subset the
// existing native value model can honestly support, driven from the real AST:
//
//     let a = [<int>, <int>, ...]
//     print(a[<int>])
//
// THE ORACLE'S FRAME CONTRACT, reproduced exactly:
//     [off]            = address of the element area
//     [off + 8]        = element count
//     [off + 16 + i*8] = element i
// An array local therefore occupies a TWO-unit header plus 8 bytes per element, all
// in the frame, and NOTHING is allocated. rsp never moves and the element base
// never sits in rsp, so every element access is a constant-displacement SIB through
// a register.
//
// MEASURED BOUNDARY, stated rather than papered over. The oracle's out-of-range path
// calls karkain_runtime_error with the source file and line, which is increment
// 152-B0 machinery: a runtime-error helper, source-filename plumbing and a new rodata
// string. None of that exists in kcc and this slice does not build it. The bound IS
// checked, and an out-of-range index TRAPS with Int3 -- exactly the behaviour
// increment 150A measured and recorded ("arr[i] with a checked bound (negative or
// >= len traps)"). An in-range index executes correctly, which is what the gate
// proves.
//
// NOT IN THIS SLICE: len(), for-in, push, string elements, nested arrays, printing an
// array as a whole, or arrays as call arguments. Each is a separate capability.
// ============================================================

// natNativePlan builds the slot plan: one [offset, kind, elemCount] triple per local,
// in DECLARATION ORDER, sized exactly as the oracle's scanLets sizes them.
//
// The offset is SEQUENTIAL rather than 8 * index * units, because an array owns a
// variable-sized element area that the fixed-stride formula cannot express. That is
// the same reason the oracle allocates sequentially: an array is a two-unit header
// plus 8 bytes per element, so the next local starts after that area.
// ============================================================
// Step 9h-1 - records: declaration collection and layout table
// ============================================================
//
// A record VALUE is exactly one 8-byte unit whose content is the ADDRESS of a
// compile-time-sized field area (the oracle's KindStruct). Nothing is allocated, so a
// record program stays out of the heap arena entirely.
//
// Layout is the oracle's newStructInfo exactly: DECLARATION ORDER; int and float occupy
// 1 unit, string occupies 2 units (ptr+len); every field starts on an 8-byte boundary,
// so no padding rule exists and none is added.
//
// The table is a FLAT array because Karkain has no structs. Per record:
//
//   name, size, fieldCount, then fieldCount triples of (fieldName, off, kind)
//
// natStructFieldOff / natStructFieldKind resolve a field to its compile-time constants,
// so a field access is ONE load/store at a constant displacement with no runtime
// descriptor and no per-field tag.

func natFieldSpecName(spec) {
  let c = indexOf(spec, ":")
  if (c < 0) { return spec }
  return substr(spec, 0, c)
}

func natFieldSpecType(spec) {
  let c = indexOf(spec, ":")
  if (c < 0) { return "" }
  return substr(spec, c + 1, len(spec) - c - 1)
}

// natFieldSpecKind mirrors newStructInfo's switch exactly. Anything that is not
// int/string/float becomes natKindUnsupported(), which callers refuse LOUDLY rather
// than silently mis-sizing the record. Nested records, arrays and maps inside a struct
// are not in 150B3b.
func natFieldSpecKind(ty) {
  if (ty == "string") { return natKindString() }
  if (ty == "float") { return natKindFloat() }
  if (ty == "int") { return natKindInt() }
  if (ty == "") { return natKindInt() }
  return natKindUnsupported()
}

func natKindUnsupported() { return 0 - 1 }

// natStructTable collects every top-level `type X struct {...}` declaration in
// declaration order. Karkain has no reflection: this is the whole of the compile-time
// record information the lowering needs.
func natStructTable(stmts) {
  let tbl = []
  let i = 0
  while (i < len(stmts)) {
    let n = stmts[i]
    if (nodeType(n) == NODE_STRUCT_DECL()) { tbl = natStructPushDecl(tbl, n) }
    i = i + 1
  }
  return tbl
}

func natStructPushDecl(tbl, d) {
  let specs = structDeclFields(d)
  let rec = []
  let size = 0
  let j = 0
  while (j < len(specs)) {
    let sp = specs[j]
    let fk = natFieldSpecKind(natFieldSpecType(sp))
    rec = appendArray(rec, natFieldSpecName(sp))
    rec = appendArray(rec, size)
    rec = appendArray(rec, fk)
    size = size + 8 * natKindUnits(fk)
    j = j + 1
  }
  tbl = appendArray(tbl, structDeclName(d))
  tbl = appendArray(tbl, size)
  tbl = appendArray(tbl, len(specs))
  let r = 0
  while (r < len(rec)) { tbl = appendArray(tbl, rec[r]); r = r + 1 }
  return tbl
}

// natStructRecAt returns the index of a record's fieldCount entry, or -1 when the type
// is unknown. Stepping to the next record is header(3) + 3 per field.
func natStructRecAt(tbl, typeName) {
  let i = 0
  while (i < len(tbl)) {
    if (tbl[i] == typeName) { return i + 2 }
    i = i + 3 + tbl[i + 2] * 3
  }
  return -1
}

// natStructSizeOf is the record's field-area size in BYTES, or -1 for an unknown type.
func natStructSizeOf(tbl, typeName) {
  let b = natStructRecAt(tbl, typeName)
  if (b < 0) { return -1 }
  return tbl[b - 1]
}

func natStructFieldOff(tbl, typeName, fieldName) {
  let b = natStructRecAt(tbl, typeName)
  if (b < 0) { return -1 }
  let cnt = tbl[b]
  let j = 0
  while (j < cnt) {
    let p = b + 1 + j * 3
    if (tbl[p] == fieldName) { return tbl[p + 1] }
    j = j + 1
  }
  return -1
}

func natStructFieldKind(tbl, typeName, fieldName) {
  let b = natStructRecAt(tbl, typeName)
  if (b < 0) { return -1 }
  let cnt = tbl[b]
  let j = 0
  while (j < cnt) {
    let p = b + 1 + j * 3
    if (tbl[p] == fieldName) { return tbl[p + 2] }
    j = j + 1
  }
  return -1
}

// ------------------------------------------------------------
// Step 9h-1 - record lowering
// ------------------------------------------------------------
//
// The record VALUE slot holds the field-area ADDRESS; the field area follows the slot
// immediately, so fieldArea = slot + 8. Every field access recomputes that address
// from the frame -- following natArrayValue's rule that a base is never carried across
// an expression. natStoreBaseOff is the authoritative mem[base+off] = val primitive.

// natRecordArea emits LEA of the field area and stores it in the record's slot.
func natRecordArea(s, slotOff) {
  s = natLeaRegStack(s, natRegRAX(), slotOff + 8)
  return natStoreStack(s, natRegRAX(), slotOff)
}

// natRecordFieldAddr leaves the address of `base + off` in RAX. `base` is a REGISTER
// holding the field-area address, reloaded by the caller from the record's frame slot.
func natRecordFieldAddr(s, base, off) {
  if (off == 0) { return s }
  s = natAddRegImm32(s, base, off)
  return s
}

// natRecordStoreLiteral stores one literal field of a record.
//
// The base register is passed in by the caller, which reloaded it from the record's
// frame slot immediately before calling -- so no field expression is ever evaluated
// between the reload and the store. That is what makes this correct for `p.x + p.y`
// without inventing a persistent base register.
//
// A string field is TWO units: the interned rodata pointer at `off`, the length at
// `off + 8`. Storing one unit would truncate it, which is exactly what `mixed_fields`
// (string between an int and a float) is there to catch.
//
// Returns a TWO-element array [newState, newSidx] because Karkain has no multiple
// return and no reference mechanism: the caller-owned rodata cursor must travel back
// out with the emitter state.
func natRecordStoreLiteral(s, lit, off, kind, roffs, sidx) {
  let out = []
  if (kind == natKindString()) {
    s = natRodataRefOff(s, natRegRAX(), roffs[sidx])
    s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off)
    s = natMovRegImm32(s, natRegRAX(), len(stringLitVal(lit)))
    s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off + 8)
    out = appendArray(out, s)
    out = appendArray(out, sidx + 1)
    return out
  }
  s = natMovRegImm32(s, natRegRAX(), int(intLitVal(lit)))
  s = natStoreBaseOff(s, natRegRAX(), natRegRBX(), off)
  out = appendArray(out, s)
  out = appendArray(out, sidx)
  return out
}

func natNativePlan(stmts, tbl) {
    let plan = []
    let next = 0
let tbl = natStructTable(stmts)
  let i = 0
  while (i < len(stmts)) {
  let n = stmts[i]
  if (natNativeIsDecl(n)) {
  let v = natNativeDeclValue(n)
  let k = natKindInt()
  let ne = 0
  if (nodeType(v) == NODE_ARRAY_LIT()) {
  k = natKindArray()
  ne = len(arrayLitElems(v))
  }
  if (nodeType(v) == NODE_STRING_LIT()) { k = natKindString() }
  // Step 9h-1: a record literal is ONE 8-byte unit whose value is the ADDRESS of its
  // field area, and the area follows the slot immediately. `ne` carries the field area
  // in UNITS -- the same convention the array clause uses for its element count -- so the
  // byte contribution below stays `8 * ne` for both, and there is no second size formula.
  if (nodeType(v) == NODE_STRUCT_LIT()) {
  k = natKindStruct()
  ne = natStructSizeOf(tbl, structLitName(v)) / 8
  }
  plan = appendArray(plan, next)
  plan = appendArray(plan, k)
  plan = appendArray(plan, ne)
  next = next + 8
  if (natKindUnits(k) == 2) { next = next + 8 }
  if (k == natKindArray()) { next = next + 8 * ne }
  if (k == natKindStruct()) { next = next + 8 * ne }
  }
  i = i + 1
  }
  return plan
  }

func natNativePlanCount(plan) { return len(plan) / 3 }

func natNativeSlotOff(plan, idx) { return plan[idx * 3] }
func natNativeSlotKind(plan, idx) { return plan[idx * 3 + 1] }
func natNativeSlotElems(plan, idx) { return plan[idx * 3 + 2] }

// natNativePlanBytes is the total locals-region size, which is the first argument
// natFrameLayout takes.
//
// It is the offset of the LAST local plus that local's own size, recomputed from the
// plan rather than by summing a second time, so the number the frame is sized from
// and the numbers the slots were allocated from cannot drift apart.
func natNativePlanBytes(plan) {
    if (len(plan) == 0) { return 0 }
    let last = natNativePlanCount(plan) - 1
    let size = 8
    if (natKindUnits(natNativeSlotKind(plan, last)) == 2) { size = size + 8 }
if (natNativeSlotKind(plan, last) == natKindArray()) {
  size = size + 8 * natNativeSlotElems(plan, last)
  }
  // Step 9h-1: a record's footprint is 8 bytes for the value slot PLUS 8 * units of
  // field area. Same `8 * extra` convention as the array clause, so planned bytes and
  // natRecordArea's allocation cannot drift apart.
  if (natNativeSlotKind(plan, last) == natKindStruct()) {
  size = size + 8 * natNativeSlotElems(plan, last)
  }
  return natNativeSlotOff(plan, last) + size
}

// natNativeRefuse builds the refusal text. K145 is the native backend's own code
// -- the same one the increment-150 gates use for a construct the native target
// will not lower -- so a user sees one consistent family of native refusals
// whether the program came through the Go or the self-hosted engine.
func natNativeRefuse(what, line) {
    return "error[K145]: native target: " + what + " (main.kark line " + str(line) +
        "). The 151A Step 9e native driver lowers `let` of an integer literal or an " +
        "integer array literal, `print` and `return` of an integer literal, a local, " +
        "`a[i]` or `len(a)`, and `return` of an integer literal or local. This is " +
        "refused HERE, by kcc, and is not handed to the Go engine."
}

// natNativeRefuseNoLine is natNativeRefuse for a refusal where the offending
// node's line is not reachable through a typed accessor. Naming the construct is
// what makes a refusal actionable; inventing a line number would be worse than
// omitting it.
func natNativeRefuseNoLine(what) {
    return "error[K145]: native target: " + what +
        ". The 151A Step 9e native driver lowers `let` of an integer literal or an " +
        "integer array literal, `print` and `return` of an integer literal, a local, " +
        "`a[i]` or `len(a)`, and `return` of an integer literal or local. This is " +
        "refused HERE, by kcc, and is not handed to the Go engine."
}

// natNativeScan validates main's statements and counts its int locals in ONE
// pass, returning [refusal, nLocals].
//
// One pass, not two, so the count and the verdict can never describe different
// statements: a separate scan would let a construct be rejected by the validator
// while still being counted by the framer, and the frame would then be sized for a
// program that is never emitted.
//
// `refusal` is "" when every statement is supported. The refusals NAME the
// construct, because a refusal a user cannot act on is barely better than a crash.
// natNativeScanStructLit validates a record literal against the declared layout.
// It is deliberately a VALIDATOR, not an emitter: unknown type, unknown field and
// unsupported field kind are all loud refusals, so a mis-sized record can never reach
// emission.
func natNativeScanStructLit(tbl, lit, line) {
let typeName = structLitName(lit)
if (natStructSizeOf(tbl, typeName) < 0) {
return natNativeRefuse("unknown record type `" + typeName + "`", line)
}
let fields = structLitFields(lit)
let i = 0
while (i < len(fields)) {
let fname = identName(binaryLeft(fields[i]))
if (natStructFieldOff(tbl, typeName, fname) < 0) {
return natNativeRefuse("record `" + typeName + "` has no field `" + fname + "`", line)
}
let fk = natStructFieldKind(tbl, typeName, fname)
if (fk == natKindString()) {
if (nodeType(binaryRight(fields[i])) != NODE_STRING_LIT()) {
return natNativeRefuse("record field `" + fname + "` is a string; only a string " +
"literal is lowered for it in 151A Step 9h-1", line)
}
} else {
if (nodeType(binaryRight(fields[i])) != NODE_INT_LIT()) {
return natNativeRefuse("record field `" + fname + "` must be initialised with an " +
"integer literal in 151A Step 9h-1", line)
}
}
i = i + 1
}
return ""
}

func natNativeScan(stmts, tbl) {
    let plan = natNativePlan(stmts, tbl)
    let hasReturn = 0
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        let k = nodeType(n)
        if (natNativeIsDecl(n)) {
            let v = natNativeDeclValue(n)
            let vt = nodeType(v)
if (vt == NODE_ARRAY_LIT()) {
let bad = natNativeScanElems(arrayLitElems(v), natNativeDeclLine(n))
if (bad != "") { return [bad, plan, hasReturn] }
} else {
if (vt == NODE_STRUCT_LIT()) {
// Step 9h-1: a record literal is validated by checking that the
// declared type exists and that every named field exists with a
// supported kind. An unknown type or field is a LOUD refusal, never
// a silently mis-sized record.
let bad = natNativeScanStructLit(tbl, v, natNativeDeclLine(n))
if (bad != "") { return [bad, plan, hasReturn] }
} else {
if (vt == NODE_STRING_LIT()) {
// Accepted as-is: the value is the literal's own bytes, interned
// into rodata, so there is nothing to evaluate.
} else {
if (vt != NODE_INT_LIT()) {
return [natNativeRefuse("`let " + natNativeDeclName(n) +
"` initialised from a non-integer expression", natNativeDeclLine(n)),
plan, hasReturn]
}
}
}
}
} else {
if (k == NODE_PRINT()) {
                let bad = natNativeScanValue(printVal(n), stmts, plan, printLine(n), tbl, 1)
                if (bad != "") { return [bad, plan, hasReturn] }
            } else {
                if (k == NODE_RETURN()) {
                    hasReturn = 1
                    let bad = natNativeScanReturn(retVal(n), stmts, plan, retLine(n), tbl)
                    if (bad != "") { return [bad, plan, hasReturn] }
                } else {
                    return [natNativeRefuseNoLine("statement kind " + str(k) +
                        " in `func main` is not lowered by the native driver"),
                        plan, hasReturn]
                }
            }
        }
        i = i + 1
    }
    return ["", plan, hasReturn]
}

// natArrayValue materialises an array literal into its frame slot: the (base, len)
// header plus one int element per literal.
//
// The base is stored in the frame and RELOADED before each element store, exactly as
// the oracle does. The reason is worth keeping: evaluating an element is an arbitrary
// expression, and a base left in RBX across that evaluation could have been
// clobbered, so a stale base would write the element into the wrong place. With int
// literals today nothing clobbers it, but the reload is one instruction and it is
// what keeps the sequence correct for the non-literal elements a later slice allows.
func natArrayValue(s, off, elems) {
    s = natLeaRegStack(s, natRegRBX(), off + 16)
    s = natStoreStack(s, natRegRBX(), off)
    s = natMovRegImm64(s, natRegRAX(), len(elems))
    s = natStoreStack(s, natRegRAX(), off + 8)
    let i = 0
    while (i < len(elems)) {
        s = natMovRegImm32(s, natRegRAX(), int(intLitVal(elems[i])))
        s = natLoadStack(s, natRegRBX(), off)
        s = natMovRegImm32(s, natRegRCX(), i)
        s = natStoreScaled64(s, natRegRAX(), natRegRBX(), natRegRCX(), 8, 0)
        i = i + 1
    }
    return s
}

// natArrayIndex loads element `idx` of the array whose header is at `off`, leaving
// the element in RAX.
//
// The bound is `0 <= i < len`, mirroring the oracle: the index is TESTed for a
// negative value first, then COMPAREd against the count with a `jge` to the failure
// arm.
//
// `tag` makes the three labels unique per call site. kcc has no fresh() counter --
// the existing loops write their labels literally -- so the driver passes the
// statement ordinal. Two prints of the same array would otherwise Mark the same label
// twice, and natFinish refuses a duplicate label rather than silently emitting two
// fixups to the same slot.
func natArrayIndex(s, off, idx, tag) {
    let negLbl = "idx" + str(tag) + "$neg"
    let failLbl = "idx" + str(tag) + "$fail"
    let okLbl = "idx" + str(tag) + "$ok"
    s = natMovRegImm32(s, natRegRCX(), int(intLitVal(idx)))
    s = natLoadStack(s, natRegRBX(), off)
    s = natLoadStack(s, natRegRAX(), off + 8)
    s = natTestRegReg(s, natRegRCX(), natRegRCX())
    s = natJns(s, negLbl)
    s = natJmp(s, failLbl)
    s = natMark(s, negLbl)
    s = natCmpRegReg(s, natRegRCX(), natRegRAX())
    s = natJge(s, failLbl)
    s = natLoadScaled64(s, natRegRAX(), natRegRBX(), natRegRCX(), 8, 0)
    s = natJmp(s, okLbl)
    s = natMark(s, failLbl)
    // The measured boundary: trap rather than raise. See the header note.
    s = natInt3(s)
    s = natMark(s, okLbl)
    return s
}

// natNativeScanElems validates an array literal's elements and returns "" or a
// refusal. Only int literals are supported; anything else names the offending INDEX,
// which is the oracle's own discipline -- its diagnostic says "array element 2 must
// be int" rather than failing later inside the int path with a message about
// expression shape.
func natNativeScanElems(elems, line) {
    let i = 0
    while (i < len(elems)) {
        if (nodeType(elems[i]) != NODE_INT_LIT()) {
            return natNativeRefuse("array element " + str(i) +
                " is not an integer literal", line)
        }
        i = i + 1
    }
    return ""
}

// natNativeScanIndex validates an `a[i]` expression and returns "" or a refusal.
//
// The KIND CHECK IS LOAD-BEARING, not decoration. Without it, `let a = 7; print(a[0])`
// scans clean: the target is an identifier, it resolves to a local, and the index is
// an integer literal. Lowering then treats that local's 8-byte scalar slot as a
// two-unit (base, len) array header, loads a "length" out of the neighbouring slot,
// and reads an element from whatever address that base happens to be. It produced a
// VALID PE, which is the worst outcome: no diagnostic, no trap, a wrong number.
func natNativeScanIndex(idx, stmts, plan, line) {
    let target = indexLeft(idx)
    if (nodeType(target) != NODE_IDENT()) {
        return natNativeRefuse("index target must be a local variable", line)
    }
    let ord = natNativeLocalIndex(stmts, identName(target))
    if (ord < 0) {
        return natNativeRefuse("index of undeclared local `" + identName(target) + "`", line)
    }
    if (natNativeSlotKind(plan, ord) != natKindArray()) {
        return natNativeRefuse("`" + identName(target) + "` is indexed but is not an " +
            "array", line)
    }
    if (nodeType(indexExpr(idx)) != NODE_INT_LIT()) {
        return natNativeRefuse("array index is not an integer literal", line)
    }
    return ""
}

// natNativeScanLen validates a `len(x)` call and returns "" or a refusal.
//
// Only `len` of an ARRAY LOCAL is supported, and every other shape is named rather
// than coerced: len of a scalar, len of an undeclared name, len of an expression, and
// any other builtin call all get their own message.
func natNativeScanLen(call, stmts, plan, line) {
    if (callFunc(call) != "len") {
        return natNativeRefuse("call to `" + callFunc(call) + "` is not lowered by the " +
            "native driver", line)
    }
    let args = callArgs(call)
    if (len(args) != 1) {
        return natNativeRefuse("len() takes exactly 1 argument, got " + str(len(args)), line)
    }
    if (nodeType(args[0]) != NODE_IDENT()) {
        return natNativeRefuse("len() requires an array or string variable, not an " +
            "expression", line)
    }
    let ord = natNativeLocalIndex(stmts, identName(args[0]))
    if (ord < 0) {
        return natNativeRefuse("len() of undeclared local `" + identName(args[0]) + "`", line)
    }
    let k = natNativeSlotKind(plan, ord)
    // A STRING is accepted for free, and deliberately so: a string's two frame units
    // are (ptr, len), so its length is at exactly the offset an array's COUNT is, and
    // the same single load returns both. Refusing it would have been an arbitrary
    // restriction rather than a real boundary.
    if (k != natKindArray() && k != natKindString()) {
        return natNativeRefuse("len() requires an array or string, but `" +
            identName(args[0]) + "` is not one (its kind is " + natKindName(k) + ")",
            line)
    }
    return ""
}

// natArrayLen loads an array's element count into RAX.
//
// The oracle's array branch of `emitLen` is exactly one instruction
// (`e.LoadStack(RAX, off+8)`) because the count is the array header's second unit. The
// map branch needs an extra indirection -- a map's address lives in its slot -- but
// maps are not lowered by this driver yet, so that difference is not reachable here.
//
// The count offset is written literally as off+8 and NOT derived from
// `natLocalOff(ord, natKindArray())`: an array's element AREA starts at off+16 while
// its count is at off+8, so deriving the count from the slot formula would be wrong.
func natArrayLen(s, off) {
    return natLoadStack(s, natRegRAX(), off + 8)
}

// natCallPrintInt and natCallPrintStr are the two print call sites, and the `sub rsp, 8`
// in each is Win64 ABI rather than padding.
//
// `_start` aligns rsp to 16 and then CALLS, so rsp is 8 (mod 16) at main entry, and a
// call requires rsp to be 0 (mod 16) immediately before the `call`. The 8 bytes
// restore that alignment and are released immediately after.
//
// They are functions rather than inline sequences because there are now several print
// shapes (int literal, string literal, element, len, local) and a copy per shape is a
// place for the alignment to be dropped from one and kept in another.
func natCallPrintInt(s) {
    s = natSubRegImm32(s, natRegRSP(), 8)
    s = natCall32(s)
    let r = natRel32(s, "print_int")
    s = r[0]
    return natAddRegImm32(s, natRegRSP(), 8)
}

func natCallPrintStr(s) {
    s = natSubRegImm32(s, natRegRSP(), 8)
    s = natCall32(s)
    let r = natRel32(s, "print_str")
    s = r[0]
    return natAddRegImm32(s, natRegRSP(), 8)
}

// natPrintStrBody emits the `print_str` helper: write the caller's string bytes,
// then a newline.
//
// It is the byte-for-byte counterpart of the oracle's print_str, which is seven
// instructions because a string needs no formatting at all:
//
//	Mark("print_str"); MovRegReg(RDX, RSI); MovRegReg(RSI, RDI);
//	MovRegImm32(RDI, 1); emitWrite(); printNewline(); Ret()
//
// The three register moves are the (RDI=ptr, RSI=len) string convention being
// reshuffled into (RDI=fd, RSI=ptr, RDX=len), which is what natPayloadWrite -- and the
// oracle's emitWrite -- consume. The newline is the same contract print_int
// terminates with, so `"42\n"` and `"hi\n"` are both right; the C-backend goldens pin
// exactly that, and a missing terminator is a real defect rather than a style choice.
//
// It takes the newline's rodata OFFSET rather than interning it itself, because the
// driver owns the rodata list and a helper that interned independently would put the
// newline somewhere the linker never resolves.
func natPrintStrBody(s, winWrite, offNewline) {
    s = natMark(s, "print_str")
    s = natMovRegReg(s, natRegRDX(), natRegRSI())
    s = natMovRegReg(s, natRegRSI(), natRegRDI())
    s = natMovRegImm32(s, natRegRDI(), 1)
    s = natPayloadWrite(s, winWrite)
    s = natPrintNewlineOff(s, winWrite, offNewline)
    return natRet(s)
}

// natNativeRodataList builds the rodata input list: print_int's two strings followed
// by the program's own literals, in source order.
//
// It is built with an explicit append loop rather than an array-join operator on
// purpose. The obvious `["-", "\n"] ++ lits` does not exist -- Karkain has no `++` --
// and the first draft of this slice used it, which compiled into an image that printed
// a run of NUL bytes: the literal offsets it recorded were computed against a list that
// was not the list the linker interned.
//
// The ORDER is load-bearing in the same way. natRodataSection returns one offset per
// INPUT entry, with a repeated literal resolving to the slot it was first interned
// into, so the k-th literal in the program is always input entry 2+k.
func natNativeRodataList(stmts) {
    let lits = natNativeStrLiterals(stmts)
    let strs = ["-", "\n"]
    let i = 0
    while (i < len(lits)) {
        strs = appendArray(strs, lits[i])
        i = i + 1
    }
    return strs
}

// natNativeStrLiterals collects every string literal the program binds, in source
// order, WITHOUT de-duplicating.
//
// De-duplication is deliberately NOT done here: natRodataSection performs the
// first-use interning, and natRodataLookup scans this list for the FIRST occurrence,
// so a repeated literal naturally resolves to the slot it was first interned into. If
// this list de-duplicated too, the two would still agree -- but keeping one function
// responsible for interning is what stops them disagreeing.
// natNativeStrLiterals collects every string literal the program puts into an image,
// in the order the driver will RECORD a reference to it.
//
// It walks statements once and takes literals from BOTH places that can produce one: a
// `let` initialiser and a `print` argument. Collecting only from `let` was a real bug --
// `print("hi")` with no binding recorded a reference to an offset that had never been
// interned, and kcc died with "array index out of range" inside the lowering.
//
// The ORDER must match natNativeLower's walk exactly, because the lowering advances a
// single sidx through this list as it emits. Both iterate the same statements in the
// same order and handle the decl before the print within each statement, so the two
// walks agree by construction rather than by convention.
func natNativeStrLiterals(stmts) {
    let out = []
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        if (natNativeIsDecl(n)) {
            out = natNativeStrLitAppend(out, natNativeDeclValue(n))
        }
        if (nodeType(n) == NODE_PRINT()) {
            out = natNativeStrLitAppend(out, printVal(n))
        }
        i = i + 1
    }
    return out
}

// natNativeStrLitAppend appends every string literal reachable from ONE expression,
// descending through `+`.
//
// THE DESCENT IS THE STEP 9g FIX, and it is a defect fix rather than a refinement.
// The previous collector only took a literal when the WHOLE value was a string
// literal, so `print("ab" + "cd")` collected NOTHING. Two failures followed that looked
// like one unrelated linker bug:
//
//   * natNativeUsesString returned false, so print_str was never emitted, while the
//     concat arm still CALLED it. natFinish therefore returned the STRING
//     "undefined label 'print_str'", which natNativeProgram passed to natPELink as if it
//     were code. The image was nonsense and the first hpatches store ran off the end of
//     it -- a panic in natPEStore64 with nothing to do with patch coordinates.
//   * the literals were never interned, so their rodata offsets would have resolved to
//     offset 0 (print_int's own "-") even once the helper was emitted.
//
// The arena-sizing path already descended into `+`, so the two collectors DISAGREED:
// one sized an arena from literals the other could not see. They are now ONE function
// with one rule, so they cannot disagree again.
func natNativeStrLitAppend(out, e) {
    if (nodeType(e) == NODE_STRING_LIT()) {
        return appendArray(out, stringLitVal(e))
    }
if (nodeType(e) == NODE_BINARY() && binaryOp(e) == "+") {
  out = natNativeStrLitAppend(out, binaryLeft(e))
  return natNativeStrLitAppend(out, binaryRight(e))
  }
  // Step 9h-1: descend a RECORD LITERAL's fields, in `structLitFields` order.
  //
  // This is a COLLECTOR/EMITTER ORDERING fix, not a refinement. natRecordStoreLiteral
  // consumes exactly one roffs entry per STRING field, walking `structLitFields` in order.
  // Before this arm the collector visited only `let` initialisers and `print` arguments,
  // so a literal inside a struct literal was never interned: roffs came out one entry
  // short and the store read `roffs[sidx]` past the end --
  // "array index out of range" in natRecordStoreLiteral on `string_between_ints`.
  //
  // The order MUST match the emitter exactly. `let s = S{...}` reaches here through
  // natNativeStrLitAppend(out, natNativeDeclValue(n)), so the fields are walked in the
  // same order natRecordStoreLiteral walks them. Desynchronising the two is the identical
  // defect 9g fixed when the concat descent was added: one more place where the accepted
  // and recorded shapes can drift apart.
  if (nodeType(e) == NODE_STRUCT_LIT()) {
  let sf = structLitFields(e)
  let j = 0
  while (j < len(sf)) {
  out = natNativeStrLitAppend(out, binaryRight(sf[j]))
  j = j + 1
  }
  return out
  }
  return out
  }

// natNativeUsesString reports whether the program can produce a string at all, which
// is what gates the print_str helper.
func natNativeUsesString(stmts) {
    return len(natNativeStrLiterals(stmts)) > 0
}

// natNativeScanValue validates one expression in a value position -- what `print` and
// `return` accept -- and returns "" or a refusal.
//
// One function for both, because a second copy is a second place for the accepted and
// the refused shapes to drift apart, and a driver that accepts `print(a[i])` but
// refuses `return a[i]` (or the reverse) is exactly the inconsistency a user cannot act
// on.
// ------------------------------------------------------------
// Step 9h-1 - record field reads
// ------------------------------------------------------------

// natRecordTypeOfLocal recovers a local's record type by re-walking the declarations for
// a STRUCT-LITERAL binding of that name. The plan triple carries the kind but not the
// type name, and adding a fourth plan element would change a structure every existing
// consumer indexes positionally, so the type is resolved here from the SAME AST the
// construction path used. Construction and read therefore cannot disagree.
func natRecordTypeOfLocal(stmts, name) {
  let i = 0
  while (i < len(stmts)) {
  let n = stmts[i]
  if (natNativeIsDecl(n)) {
  if (natNativeDeclName(n) == name) {
  let v = natNativeDeclValue(n)
  if (nodeType(v) == NODE_STRUCT_LIT()) { return structLitName(v) }
  return ""
  }
  }
  i = i + 1
  }
  return ""
}

// natRecordBase loads the record's field-area ADDRESS from its frame slot into `reg`.
// The base is ALWAYS reloaded from the frame rather than carried in a register across a
// field expression -- the rule natArrayValue already follows for an array element base.
func natRecordBase(s, stmts, plan, name, reg) {
  let ord = natNativeLocalIndex(stmts, name)
  return natLoadStack(s, reg, natNativeSlotOff(plan, ord))
}

// natRecordFieldLoadInt loads an int/float field's single 8-byte unit into RAX.
//
// mem[base + off] is loaded with index = RCX = 0 and disp = off, which is the same
// addressing natRecordStoreLiteral writes with, so read and write cannot disagree.
func natRecordFieldLoadInt(s, stmts, plan, tbl, recName, fieldName) {
  let tname = natRecordTypeOfLocal(stmts, recName)
  let off = natStructFieldOff(tbl, tname, fieldName)
  s = natRecordBase(s, stmts, plan, recName, natRegRBX())
  s = natMovRegImm32(s, natRegRCX(), 0)
  return natLoadScaled64(s, natRegRAX(), natRegRBX(), natRegRCX(), 1, off)
}

// natRecordFieldLoadStr loads a string field's TWO units into (RDI, RSI), which is the
// established native string result convention.
func natRecordFieldLoadStr(s, stmts, plan, tbl, recName, fieldName) {
  let tname = natRecordTypeOfLocal(stmts, recName)
  let off = natStructFieldOff(tbl, tname, fieldName)
  s = natRecordBase(s, stmts, plan, recName, natRegRBX())
  s = natMovRegImm32(s, natRegRCX(), 0)
  s = natLoadScaled64(s, natRegRDI(), natRegRBX(), natRegRCX(), 1, off)
  s = natLoadScaled64(s, natRegRSI(), natRegRBX(), natRegRCX(), 1, off + 8)
  return s
}

// natNativeScanField validates `rec.field` against the record table.
//
// It resolves the base local, the record type, the field offset and the field kind, and
// accepts only an int or float field. A string field is NOT accepted here: a string
// reaches print through natEmitStrValue's own DotExpr arm, which is dispatched BEFORE
// this validator runs.
func natNativeScanField(expr, stmts, plan, line, tbl, allowStr) {
  if (nodeType(dotLeft(expr)) != NODE_IDENT()) {
  return natNativeRefuse("record field read is only lowered on a local record in " +
  "151A Step 9h-1", line)
  }
  let recName = identName(dotLeft(expr))
  if (natNativeLocalIndex(stmts, recName) < 0) {
  return natNativeRefuse("undeclared local `" + recName + "` in a field read", line)
  }
    let tname = natRecordTypeOfLocal(stmts, recName)
  if (tname == "") {
  return natNativeRefuse("`" + recName + "` is not a record bound from a record " +
  "literal, so `" + memberField(expr) + "` cannot be resolved", line)
  }
  let fname = memberField(expr)
  if (natStructFieldOff(tbl, tname, fname) < 0) {
  return natNativeRefuse("record `" + tname + "` has no field `" + fname + "`", line)
  }
  let fk = natStructFieldKind(tbl, tname, fname)
  if (fk == natKindInt() || fk == natKindFloat()) { return "" }
  // Step 9h-1: a string field is accepted ONLY in direct print position.
  //
  // `allowStr` is 1 from exactly one call site -- the NODE_PRINT scan, whose lowering
  // already routes a NODE_DOT string to natEmitStrValue's DotExpr arm. It is 0 from
  // `return`, because a return value becomes the process exit status and must be an int,
  // and 0 for every other context. So this widens ONE context, not the expression surface.
  if (fk == natKindString() && allowStr == 1) { return "" }
  return natNativeRefuse("record field `" + fname + "` is a " + natKindName(fk) +
  "; only int and float field reads are lowered in 151A Step 9h-1", line)
}

func natNativeScanValue(expr, stmts, plan, line, tbl, allowStr) {
    let t = nodeType(expr)
    if (t == NODE_INT_LIT()) { return "" }
    if (t == NODE_STRING_LIT()) { return "" }
    if (t == NODE_IDENT()) {
        let ord = natNativeLocalIndex(stmts, identName(expr))
        if (ord < 0) {
            return natNativeRefuse("undeclared local `" + identName(expr) + "`", line)
        }
        let k = natNativeSlotKind(plan, ord)
        // A STRING is printable as itself: its value is already the (ptr, len) pair
        // print_str wants. An ARRAY is not printable as itself.
        if (k == natKindInt() || k == natKindString()) { return "" }
        return natNativeRefuse("cannot print `" + identName(expr) + "` as a whole; " +
            "its kind is " + natKindName(k) + ", so print an element or len() instead",
            line)
    }
if (t == NODE_BINARY()) { return natNativeScanConcat(expr, stmts, plan, line) }
  if (t == NODE_INDEX()) { return natNativeScanIndex(expr, stmts, plan, line) }
  if (t == NODE_CALL()) { return natNativeScanLen(expr, stmts, plan, line) }
  // Step 9h-1: a record field read, `rec.field`. NARROW by construction -- only an
  // int or float field on a local bound from a record literal is accepted. Anything else
  // (unknown base, unknown field, a string field, a non-identifier base, arithmetic) is
  // refused by name.
  //
  // Accepting NODE_DOT does NOT weaken the invariant below: this arm is reached only
  // after the record type AND the field offset AND the field kind are all resolved. An
  // unresolved field returns a refusal and never reaches emission, so a struct field can
  // never fall through to natMovRegImm32(RAX, intLitVal(v)).
  if (t == NODE_DOT()) { return natNativeScanField(expr, stmts, plan, line, tbl, allowStr) }
  // Step 9h-1 SAFETY REFUSAL. A struct literal must never fall through to the generic
  // integer path: `natMovRegImm32(RAX, intLitVal(v))` on a NODE_STRUCT_LIT emits a
  // STRUCTURALLY VALID PE that computes a meaningless integer, because intLitVal of a
  // non-literal yields 0. That is the worst possible outcome for a native backend -- it
  // is exactly the class of defect this gate exists to catch -- and it is what an earlier
  // Session-A attempt produced when the planner recognised struct literals before the
  // lowering did.
  //
  // This refusal is DELIBERATE and stays until literal construction is wired into
  // natNativeLower. The planner deliberately does NOT yet recognise NODE_STRUCT_LIT
  // either, so plan and lowering cannot disagree.
  if (t == NODE_STRUCT_LIT()) {
  return natNativeRefuse("record literals are not lowered by the native driver yet " +
  "(151A Step 9h-1 is in progress); this is refused HERE, by kcc", line)
  }
  return natNativeRefuse("expression of kind " + str(t) + " is neither an integer " +
        "literal, a local, an index nor len()", line)
}

// natNativeScanReturn validates a `return` value.
//
// It is natNativeScanValue plus ONE extra rule, and the rule is load-bearing: `return`
// feeds the process exit status, which is an int. A string is printable as itself, so
// the shared validator accepts it -- and without this check `return s` silently loaded
// the string's POINTER and exited with it. That is a valid image emitting a meaningless
// exit code, which the oracle refuses outright ("string return values are not
// supported"). The gate's refusal table found it.
func natNativeScanReturn(expr, stmts, plan, line, tbl) {
    let bad = natNativeScanValue(expr, stmts, plan, line, tbl, 0)
    if (bad != "") { return bad }
if (nodeType(expr) == NODE_IDENT()) {
  let k = natNativeSlotKind(plan, natNativeLocalIndex(stmts, identName(expr)))
  if (k != natKindInt()) {
  return natNativeRefuse("`return` of a " + natKindName(k) + " is not " +
  "supported; a return value becomes the process exit status and must be " +
  "an int", line)
  }
  return ""
  }
  // A concatenated string is a STRING, and a string is not an exit status.
  // natNativeScanValue returned "" for `return a + "b"` because the concat is a
  // perfectly valid string expression, so it reached emission and died in
  // natEmitStrValue with "array index out of range".
  //
  // The test is the NODE TYPE and not "is it a literal or an identifier": a
  // first draft refused everything that was not an int literal or an identifier
  // and broke 9e's `return len(a)`, which is a CallExpr returning an int and must
  // keep working. Only a BinaryExpr reaches here as a validated non-int value.
  if (nodeType(expr) == NODE_BINARY()) {
  return natNativeRefuse("`return` of a concatenated string is not supported; a " +
  "return value becomes the process exit status and must be an int", line)
  }
  return ""
  }

// natNativeLower emits main's body into an existing emitter state.
//
// The `sub rsp, 8` around each call is Win64 ABI, not padding: `_start` aligns rsp
// to 16 and then calls, so rsp is 8 (mod 16) at main entry, and a call site
// requires rsp to be 0 (mod 16) immediately before the `call`. The 8 bytes restore
// that alignment and are released immediately after. `natWinWrite` inside
// print_int depends on it -- its own three pushes plus the 32-byte shadow only land
// on 0 (mod 16) when print_int is entered with that alignment.
//
// The statement ORDINAL doubles as the label tag for `a[i]`, so no counter can fall
// out of step with the statement list.
func natNativeLower(s, stmts, plan, roffs, strTemp, tbl) {
    let idx = 0
    // sidx walks the rodata INPUT list in lockstep with the literals the program binds,
    // starting at 2 because entries 0 and 1 are print_int's own "-" and "\n". Lockstep
    // is what makes a literal's recorded offset agree with the list the linker interns;
    // recomputing an offset from the literal's VALUE instead would break the moment two
    // bindings shared one string, which natRodataSection interns only once.
    let sidx = 2
    // Concat-site counter; used only to make the byte-copy labels unique.
    let site = 0
    let i = 0
    while (i < len(stmts)) {
        let n = stmts[i]
        let k = nodeType(n)
        if (natNativeIsDecl(n)) {
            let v = natNativeDeclValue(n)
            if (nodeType(v) == NODE_ARRAY_LIT()) {
                s = natArrayValue(s, natNativeSlotOff(plan, idx), arrayLitElems(v))
            } else {
if (nodeType(v) == NODE_STRUCT_LIT()) {
      // Step 9h-1: the field area sits at slotOff+8; natRecordArea LEA's it and stores
      // that ADDRESS into the record's value slot.
      s = natRecordArea(s, natNativeSlotOff(plan, idx))
      let rtype = structLitName(v)
      let rfields = structLitFields(v)
      let f = 0
      while (f < len(rfields)) {
        let fd = rfields[f]
        let fname = identName(binaryLeft(fd))
        let foff = natStructFieldOff(tbl, rtype, fname)
        let fk = natStructFieldKind(tbl, rtype, fname)
        let fv = binaryRight(fd)
        // Reload the base from the record's frame slot immediately before each store,
        // so no field expression is evaluated between the reload and the store.
        s = natLoadStack(s, natRegRBX(), natNativeSlotOff(plan, idx))
        let rr = natRecordStoreLiteral(s, fv, foff, fk, roffs, sidx)
        s = rr[0]
        sidx = rr[1]
        f = f + 1
      }
    } else {
    if (nodeType(v) == NODE_STRING_LIT()) {
                    // A string literal's value IS its own bytes, so the binding is two
                    // stores: the interned rodata pointer and the byte length. No arena
                    // is involved -- an arena is only needed to BUILD a string, and a
                    // literal is already built.
                    s = natRodataRefOff(s, natRegRDI(), roffs[sidx])
                    s = natMovRegImm32(s, natRegRSI(), len(stringLitVal(v)))
                    s = natStoreStack(s, natRegRDI(), natNativeSlotOff(plan, idx))
                    s = natStoreStack(s, natRegRSI(), natNativeSlotOff(plan, idx) + 8)
                    sidx = sidx + 1
                } else {
s = natMovRegImm32(s, natRegRAX(), int(intLitVal(v)))
s = natStoreStack(s, natRegRAX(), natNativeSlotOff(plan, idx))
}
}
}
idx = idx + 1
}
        if (k == NODE_PRINT()) {
            let pv = printVal(n)
            // The argument is loaded BEFORE the alignment adjustment, and that
            // ordering is load-bearing rather than cosmetic.
            //
            // natLoadStack addresses [rsp + off], i.e. the CURRENT rsp. The 8-byte
            // `sub rsp, 8` needed for Win64 call alignment therefore shifts every
            // frame-relative load that follows it 8 bytes too low -- the first
            // draft emitted `sub rsp,8; mov (%rsp),%rdi`, which read the byte
            // BELOW the first local. The symptom was not a crash: with two locals
            // the program printed `0` then `7`, because `print(b)`'s `mov 8(%rsp)`
            // happened to land back on slot 0. A literal argument was unaffected,
            // which is why the literal-only case passed while every local case
            // failed -- and why a single passing case would not have been evidence
            // that the path was right.
            //
            // Nothing between the load and the `call` touches RDI, so loading early
            // is safe and is also the shape the oracle's call sequence uses.
            //
            // An `a[i]` argument is loaded EARLIER still, before RDI is touched at
            // all: natArrayIndex leaves the element in RAX and needs RBX and RCX, so
            // it runs, and only then does the value move to RDI. Materialising the
            // index before the alignment adjust is not a choice -- the scaled load
            // addresses the element area through a register base and would read eight
            // bytes low if it came after the `sub`.
            // A `+` on two strings is the CONCAT arm. It is the OUTERMOST `if` rather
            // than a fifth else-if because that needs exactly one brace pair; an earlier
            // attempt appended an inner `} else {` without its match and produced a K001
            // parse cascade.
            //
            // natStrConcat leaves (RDI, RSI) = (dst, len), which is already print_str's
            // convention, so the call follows directly.
            if (nodeType(pv) == NODE_BINARY()) {
s = natStrConcat(s, binaryLeft(pv), binaryRight(pv), 0, site, strTemp,
stmts, plan, roffs, tbl)
                s = natCallPrintStr(s)
                site = site + 1
            } else {
            if (nodeType(pv) == NODE_INT_LIT()) {
                s = natMovRegImm32(s, natRegRDI(), int(intLitVal(pv)))
                s = natCallPrintInt(s)
            } else {
                if (nodeType(pv) == NODE_STRING_LIT()) {
                    s = natRodataRefOff(s, natRegRDI(), roffs[sidx])
                    s = natMovRegImm32(s, natRegRSI(), len(stringLitVal(pv)))
                    s = natCallPrintStr(s)
                    sidx = sidx + 1
                } else {
                    if (nodeType(pv) == NODE_INDEX()) {
                        let ord = natNativeLocalIndex(stmts, identName(indexLeft(pv)))
                        s = natArrayIndex(s, natNativeSlotOff(plan, ord), indexExpr(pv), i)
                        s = natMovRegReg(s, natRegRDI(), natRegRAX())
                        s = natCallPrintInt(s)
} else {
if (nodeType(pv) == NODE_DOT()) {
let drec = identName(dotLeft(pv))
let dkn = natStructFieldKind(tbl, natRecordTypeOfLocal(stmts, drec), memberField(pv))
if (dkn == natKindString()) {
s = natEmitStrValue(s, pv, stmts, plan, roffs, tbl)
s = natCallPrintStr(s)
} else {
s = natRecordFieldLoadInt(s, stmts, plan, tbl, drec, memberField(pv))
s = natMovRegReg(s, natRegRDI(), natRegRAX())
s = natCallPrintInt(s)
}
} else {
if (nodeType(pv) == NODE_CALL()) {
let ordl = natNativeLocalIndex(stmts,
identName(callArgs(pv)[0]))
                            s = natArrayLen(s, natNativeSlotOff(plan, ordl))
                            s = natMovRegReg(s, natRegRDI(), natRegRAX())
                            s = natCallPrintInt(s)
                        } else {
                            let ordp = natNativeLocalIndex(stmts, identName(pv))
                            if (natNativeSlotKind(plan, ordp) == natKindString()) {
                                s = natLoadStack(s, natRegRDI(),
                                    natNativeSlotOff(plan, ordp))
                                s = natLoadStack(s, natRegRSI(),
                                    natNativeSlotOff(plan, ordp) + 8)
                                s = natCallPrintStr(s)
                            } else {
s = natLoadStack(s, natRegRDI(),
natNativeSlotOff(plan, ordp))
s = natCallPrintInt(s)
}
}
}
}
}
            }
            }
        }
        if (k == NODE_RETURN()) {
            let rv = retVal(n)
            if (nodeType(rv) == NODE_INT_LIT()) {
                s = natMovRegImm32(s, natRegRAX(), int(intLitVal(rv)))
            } else {
                if (nodeType(rv) == NODE_INDEX()) {
                    let ord = natNativeLocalIndex(stmts, identName(indexLeft(rv)))
                    s = natArrayIndex(s, natNativeSlotOff(plan, ord), indexExpr(rv), i)
                } else {
                    if (nodeType(rv) == NODE_CALL()) {
                        let ordl = natNativeLocalIndex(stmts,
                            identName(callArgs(rv)[0]))
                        s = natArrayLen(s, natNativeSlotOff(plan, ordl))
                    } else {
                        s = natLoadStack(s, natRegRAX(),
                            natNativeSlotOff(plan,
                                natNativeLocalIndex(stmts, identName(rv))))
                    }
                }
            }
        }
        i = i + 1
    }
    return s
}

// natNativeProgram compiles a PARSED PROGRAM to a native PE image.
//
// It returns [refusal, image]: refusal is "" on success, and image is then the
// bytes. The pair is deliberate rather than a bare return. Karkain cannot say
// "either a string or a byte array" without the caller having to guess which it
// got, and guessing is how a refusal gets hex-encoded and printed as though it
// were an image. Two slots removes the question.
//
// This is what the fixed `natPEProgram` is being replaced by, and the two share
// only the parts 9b already proved: the same `natWinStub` entry, the same
// `print_int` body, the same rodata interning and the same per-kind patch lists.
// What differs is where main's bytes come from -- here they come from the AST.
//
// The rodata list is ["-", "\n"] because the ONLY strings this driver can emit are
// print_int's own two, in first-use order. That is a property of the supported
// subset rather than an assumption about a particular program: a construct that
// would introduce another string is refused during the scan, before any emission.
func natNativeProgram(ast) {
    let stmts = ast[1]
    let mainFn = natNativeFindMain(stmts)
    if (mainFn == 0) {
        return [natNativeRefuseNoLine("no `func main`; the native entry stub calls " +
            "karkain_main, so a `main` is required"), []]
    }
    let body = natNativeBodyStmts(mainFn)
  // Step 9h-1: record declarations live at PROGRAM top level, not in main's body, so
  // the layout table is built ONCE from the top-level statements and threaded into
  // the planner, the scanner and the lowering. Building it from the body found no
  // declarations at all and refused every record as an unknown type.
  let tbl = natStructTable(stmts)
    let scan = natNativeScan(body, tbl)
    if (scan[0] != "") { return [scan[0], []] }
    let plan = scan[1]
    let hasReturn = scan[2]

    // The frame is DERIVED from the program's own bindings through the value model's
    // own layout pass, so a program with two locals gets a different frame from one
    // with one, and a program with an array gets a frame carrying that array's
    // element area. All three agree with the oracle's scanLets for the same program.
    let usesStr = 0
    if (natNativeConcatSites(body) > 0) { usesStr = 1 }
    let lay = natFrameLayout(natNativePlanBytes(plan), 0, usesStr, 0, 0, 1)
    let frame = lay[6]
    let strTemp = lay[2]

    let ro = natRodataSection(natNativeRodataList(body))
    // `ro` is [bytes, offsets]: one offset per INPUT entry, so the k-th program literal
    // is entry 2+k. It is computed BEFORE emission because the body needs those offsets
    // to record its rodata references, and computing them after would mean recording a
    // placeholder the linker had no way to fill.
    let s = natWinStub()
    s = natSubRegImm32(s, natRegRSP(), frame)
    s = natNativeLower(s, body, plan, ro[1], strTemp, tbl)
    // The implicit `return 0` is emitted ONLY when the program has no explicit
    // return, and it must come AFTER the body. Emitting it unconditionally was the
    // first draft's bug and it is instructive: `mov rax, 0` placed after the body
    // clobbered the value an explicit `return <local>` had just loaded, so
    // `let z = 7; return z` exited 0 instead of 7. The program printed nothing, so
    // a stdout-only assertion would not have noticed -- the exit code is what
    // exposed it.
    //
    // RAX is main's return value and _start passes it straight to ExitProcess, so
    // this is the process exit status, not a discarded value.
    if (hasReturn == 0) {
        s = natMovRegImm32(s, natRegRAX(), 0)
    }
    s = natAddRegImm32(s, natRegRSP(), frame)
    s = natRet(s)
    s = natPrintIntBody(s, 1, 0, 1)
    // print_str, in the SAME state and only when the program can produce a string.
    //
    // The gating is what keeps every string-free image byte-identical: an unused helper
    // costs bytes and nothing else, but print_int is emitted unconditionally today, so
    // the honest comparison is against today's behaviour rather than an ideal.
    if (natNativeUsesString(body)) {
        s = natPrintStrBody(s, 1, 1)
    }
    // The arena and its allocator, ONLY when the program concatenates. It is emitted
    // AFTER the body because the body CALLS it; a forward call would patch to a
    // label that does not exist yet.
    if (natNativeArenaBytes(body) > 0) {
        s = natAllocHelper(s, natNativeArenaBytes(body))
    }
    let text = natFinish(s)

    // The rodata patch list is what makes the linker resolve the immediates AND
    // give each one a DIR64 entry. Passing an empty list is the Step 9b defect
    // this slice inherits: the immediates keep the preferred base on a rebasing
    // host and the print silently loses its newline.
    let rp = natFlatPairs(natStRodataPos(s), natStRodataOff(s))
    let ap = natFlatPairs(natStAbsPos(s), natStAbsIdx(s))
    let ip = natFlatPairs(natStIatPos(s), natStIatIdx(s))
    // The arena rides inside .idata via the 151C3 plumbing: it is the heap argument
    // and absolute arena pointers are flat [pos, off] hpatches pairs -- the SAME
    // mechanism, not a second one. Both stay EMPTY for a program that does not
    // allocate, which is what keeps every string-free image byte-identical.
    let arenaLen = natNativeArenaBytes(body)
    let heap = []
    if (arenaLen > 0) { heap = natNativeArenaBytes0(arenaLen) }
    let hp = natFlatPairs(natStHeapPos(s), natStHeapOff(s))
    return ["", natPELink(text, ro[0], heap, rp, ip, ap, hp, natPETextOff(), natPETextOff())]
}

// ============================================================
// Phase 151A Step 9g -- the arena allocator and string concatenation.
// Port of the oracle's emitAllocHelper / emitByteCopy / emitStrConcat.
// ============================================================

func natHeapRef(s, r, heapOff) {
    // This does NOT reuse natImm64Patch, and the reason is the crash it used to cause.
    //
    // natMovImm64Op(rd) = 184 + rd, which is correct only for rax..rdi (0..7). For R10
    // it produced 0xC2 and for R11 **0xC3 -- which is the `ret` opcode**. So the arena
    // base/limit were emitted as `48 C3 00 00 00 00 00 00 00 00`: a spurious `ret` in the
    // middle of `alloc` followed by eight zero bytes that the CPU then decoded as
    // instructions.
    //
    // That fault produced a STRUCTURALLY VALID PE -- the linker does not check opcode
    // semantics -- which ran and then died with 0xC0000005. It is exactly the class of
    // defect this slice's gates exist to catch, and it is why an invalid opcode must be
    // read off the emitted bytes rather than assumed from the call site.
    //
    // REX.W + REX.B (0x49) carries the high register, and the opcode base is
    // B8 + (rd & 7).
    let rex = natMask(13) | natMask(14)          // 0x40 | 0x08 = 0x48, REX.W
    if (natRegExt(r) == 1) { rex = rex | natMask(16) }   // REX.B for r8-r15
    s = natByte(s, rex)
    s = natByte(s, natMask(11) + (r & natMask(72)))     // 0xB8 + (rd & 7)
    let pos = natLen(s)
    let i = 0
    while (i < 8) {
        s = natByte(s, 0)
        i = i + 1
    }
    s[13] = appendArray(s[13], pos)
    s[14] = appendArray(s[14], heapOff)
    return s
}

func natStoreBaseOff(s, val, base, off) {
    let r = natMask(13) | natMask(14)
    if (natRegExt(val) == 1) { r = r | natMask(15) }
    if (natRegExt(base) == 1) { r = r | natMask(16) }
    s = natByte(s, r)
    s = natByte(s, natMask(18))
    return natMemBaseOff(s, val, base, off)
}

// R10 = arena base, R11 = arena end (link-time imm64 patches).
// [R10+0] cursor, [R10+8] limit. RDI = request, RAX = block start.
//
// The header lives INSIDE the arena, so no global and no writable image text is
// needed. The cursor SELF-INITIALISES: it is zero in the image and zero is the
// "not started" sentinel, so the first call sets it to arena+16 and stores it.
//
// Exhaustion is `ja` -- UNSIGNED above, so it also catches wraparound on an absurd
// request. A signed compare would miss that and return a block overlapping live bytes.
func natAllocHelper(s, heapLimitOff) {
    s = natMark(s, "alloc")
    s = natHeapRef(s, natRegR10(), 0)
    s = natHeapRef(s, natRegR11(), heapLimitOff)
    s = natLoadBaseOff(s, natRegRAX(), natRegR10(), 0)
    s = natTestRegReg(s, natRegRAX(), natRegRAX())
    s = natJnz(s, "alloc$have")
    s = natMovRegReg(s, natRegRAX(), natRegR10())
    s = natAddRegImm32(s, natRegRAX(), 16)
    s = natStoreBaseOff(s, natRegRAX(), natRegR10(), 0)
    s = natMark(s, "alloc$have")
    s = natMovRegReg(s, natRegRCX(), natRegRDI())
    s = natAddRegReg(s, natRegRCX(), natRegRAX())
    s = natCmpRegReg(s, natRegRCX(), natRegR11())
    s = natJa(s, "alloc$oom")
    s = natStoreBaseOff(s, natRegRCX(), natRegR10(), 0)
    s = natJmp(s, "alloc$done")
    s = natMark(s, "alloc$oom")
    s = natInt3(s)
    s = natMark(s, "alloc$done")
    return natRet(s)
}

// `n` is a RUNTIME value, so the count lives in a register and this is a real loop.
// `tag` makes the labels unique per call site: the concat emits this twice per site and
// kcc has no fresh() counter, so two copies of one label would be Marked twice and
// natFinish refuses a duplicate label.
func natByteCopy(s, dst, src, n, tag) {
    let loopLbl = "cp" + str(tag) + "$loop"
    let doneLbl = "cp" + str(tag) + "$done"
    s = natXorRegReg(s, natRegRDX())
    s = natMark(s, loopLbl)
    s = natCmpRegReg(s, natRegRDX(), n)
    s = natJae(s, doneLbl)
    s = natLoadScaled8(s, natRegRBX(), src, natRegRDX(), 1, 0)
    s = natStoreScaled8(s, natRegRBX(), dst, natRegRDX(), 1, 0)
    s = natIncReg(s, natRegRDX())
    s = natJmp(s, loopLbl)
    s = natMark(s, doneLbl)
    return s
}

func natCallAlloc(s) {
    s = natSubRegImm32(s, natRegRSP(), 8)
    s = natCall32(s)
    let r = natRel32(s, "alloc")
    s = r[0]
    return natAddRegImm32(s, natRegRSP(), 8)
}

// natRodataSection returns one offset per INPUT entry with first-use interning, so the
// k-th literal in the program is entry 2+k (0 and 1 are print_int's "-" and "\n").
// The FIRST match is used, so a repeated literal resolves to the one copy interned.
func natRodataOffsetFor(val, stmts, roffs) {
    let lits = natNativeStrLiterals(stmts)
    let i = 0
    while (i < len(lits)) {
        if (lits[i] == val) { return roffs[2 + i] }
        i = i + 1
    }
    return 0
}

func natEmitStrValue(s, expr, stmts, plan, roffs, tbl) {
  // Step 9h-1: a record string field -- the NARROW case only. A general DotExpr
  // rewrite is deliberately NOT attempted.
  if (nodeType(expr) == NODE_DOT()) {
  return natRecordFieldLoadStr(s, stmts, plan, tbl, identName(dotLeft(expr)), memberField(expr))
  }
  if (nodeType(expr) == NODE_STRING_LIT()) {
        s = natRodataRefOff(s, natRegRDI(),
            natRodataOffsetFor(stringLitVal(expr), stmts, roffs))
        return natMovRegImm32(s, natRegRSI(), len(stringLitVal(expr)))
    }
let off = natNativeSlotOff(plan, natNativeLocalIndex(stmts, identName(expr)))
  s = natLoadStack(s, natRegRDI(), off)
  return natLoadStack(s, natRegRSI(), off + 8)
  }

// The oracle's structure exactly, including the five staging units per depth in the
// DEDICATED strTemp area:
//
//   base+0 left ptr   base+8 left len
//   base+16 right ptr base+24 right len
//   base+32 allocated block
//
// strTemp rather than the int path's 8-bytes-per-depth bin scratch: five units are
// needed and the int area would be overrun.
//
// The right half's destination is `block + llen`, and llen is a RUNTIME value, so the
// oracle ADVANCES the destination register by the staged length instead of encoding the
// offset in the SIB displacement -- which cannot hold it. That is why the copy loop
// exists in this shape.
func natStrConcat(s, left, right, depth, site, strTemp, stmts, plan, roffs, tbl) {
    let base = strTemp + depth * 5 * 8
    s = natEmitStrValue(s, left, stmts, plan, roffs, tbl)
    s = natStoreStack(s, natRegRDI(), base)
    s = natStoreStack(s, natRegRSI(), base + 8)
    s = natEmitStrValue(s, right, stmts, plan, roffs, tbl)
    s = natStoreStack(s, natRegRDI(), base + 16)
    s = natStoreStack(s, natRegRSI(), base + 24)
    s = natLoadStack(s, natRegRDI(), base + 8)
    s = natLoadStack(s, natRegRSI(), base + 24)
    s = natAddRegReg(s, natRegRDI(), natRegRSI())
    s = natCallAlloc(s)
    s = natStoreStack(s, natRegRAX(), base + 32)
    s = natLoadStack(s, natRegR9(), base + 32)
    s = natLoadStack(s, natRegR8(), base)
    s = natLoadStack(s, natRegRCX(), base + 8)
    s = natByteCopy(s, natRegR9(), natRegR8(), natRegRCX(), site * 2)
    s = natLoadStack(s, natRegR9(), base + 32)
    s = natLoadStack(s, natRegR8(), base + 8)
    s = natAddRegReg(s, natRegR9(), natRegR8())
    s = natLoadStack(s, natRegR8(), base + 16)
    s = natLoadStack(s, natRegRCX(), base + 24)
    s = natByteCopy(s, natRegR9(), natRegR8(), natRegRCX(), site * 2 + 1)
    // The total is RECOMPUTED from the two staged lengths, not reused from RCX, which
    // the copy loop leaves holding its exit counter.
    s = natLoadStack(s, natRegRDI(), base + 32)
    s = natLoadStack(s, natRegRSI(), base + 8)
    s = natLoadStack(s, natRegRCX(), base + 24)
    return natAddRegReg(s, natRegRSI(), natRegRCX())
}

func natNativeStrKind(e, stmts, plan) {
    if (nodeType(e) == NODE_STRING_LIT()) { return 1 }
    if (nodeType(e) == NODE_BINARY()) {
        if (binaryOp(e) == "+") {
            if (natNativeStrKind(binaryLeft(e), stmts, plan) == 1) { return 1 }
            return 0 - 1
        }
        return 0 - 2
    }
    if (nodeType(e) == NODE_IDENT()) {
        let ord = natNativeLocalIndex(stmts, identName(e))
        if (ord < 0) { return 0 - 2 }
        if (natNativeSlotKind(plan, ord) == natKindString()) { return 1 }
        return 0 - 1
    }
    return 0 - 2
}

func natNativeScanConcat(e, stmts, plan, line) {
  if (binaryOp(e) != "+") {
  return natNativeRefuse("`" + binaryOp(e) + "` is not lowered by the native " +
  "driver", line)
  }
  // A CHAINED concatenation -- an operand that is ITSELF a `+` BinaryExpr.
  //
  // natNativeStrKind RECURSES, so `(a + b)` classified as a string and this
  // validator was satisfied. The crash came later: natEmitStrValue handles a
  // literal, then assumes everything else is an identifier, so it called
  // identName on the nested BinaryExpr and indexed the slot plan with garbage --
  // "array index out of range" in natNativeSlotOff. Both `print(a + b + "ef")`
  // and `return a + "cd"` hit it.
  //
  // Refused BY NAME here rather than fixed by recursion: depth would have to be
  // threaded through natEmitStrValue, strTemp sized for the deepest chain, and
  // the arena bound re-proved per nesting level instead of per site. That is its
  // own slice. What must not happen is a shape reaching emission unchecked.
  if (nodeType(binaryLeft(e)) == NODE_BINARY()) {
  return natNativeRefuse("chained string concatenation is not lowered (a " +
  "concatenation operand may not itself be a concatenation)", line)
  }
  if (nodeType(binaryRight(e)) == NODE_BINARY()) {
  return natNativeRefuse("chained string concatenation is not lowered (a " +
  "concatenation operand may not itself be a concatenation)", line)
  }
  if (natNativeStrKind(binaryLeft(e), stmts, plan) != 1) {
        return natNativeRefuse("`+` needs two strings on the native target; the left " +
            "operand is not one", line)
    }
    if (natNativeStrKind(binaryRight(e), stmts, plan) != 1) {
        return natNativeRefuse("`+` needs two strings on the native target; the right " +
            "operand is not one", line)
    }
    return ""
}

func natNativeConcatSites(stmts) {
    let n = 0
    let i = 0
    while (i < len(stmts)) {
        let st = stmts[i]
        if (nodeType(st) == NODE_PRINT()) { n = n + natNativeConcatIn(printVal(st)) }
        if (natNativeIsDecl(st)) { n = n + natNativeConcatIn(natNativeDeclValue(st)) }
        i = i + 1
    }
    return n
}

func natNativeConcatIn(e) {
    if (nodeType(e) != NODE_BINARY()) { return 0 }
    if (binaryOp(e) != "+") { return 0 }
    return 1 + natNativeConcatIn(binaryLeft(e)) + natNativeConcatIn(binaryRight(e))
}

// natNativeArenaBytes is the compile-time arena size: sites * totalLiteralBytes + 16.
//
// SOUNDNESS rests on two facts, not on hope:
//  1. Every concat SITE runs at most once. A concat reached from a loop body would run
//     once per iteration, which a compile-time size cannot cover. The driver does not
//     lower loops at all, so such a program is refused before emission; the rule is
//     restated here because it is the ASSUMPTION this bound rests on.
//  2. Every string value in a supported program is a literal or a concatenation of
//     literals, so no runtime string exceeds the sum of the program's literals.
// Together they bound the sum of all allocations. +16 is the allocator header, which
// lives inside the arena.
//
// Exhaustion is therefore unreachable for a supported program and is kept anyway:
// alloc traps with Int3 rather than writing outside the arena.
func natNativeArenaBytes(stmts) {
    let sites = natNativeConcatSites(stmts)
    if (sites == 0) { return 0 }
    return sites * natNativeStrTotalBytes(stmts) + 16
}

func natNativeStrTotalBytes(stmts) {
    let total = 0
    let lits = natNativeStrLiterals(stmts)
    let j = 0
    while (j < len(lits)) {
        total = total + len(lits[j])
        j = j + 1
    }
    return total
}

// The arena is all zeros because the header SELF-INITIALISES: the cursor is zero in the
// image and zero is the "not started" sentinel. The stored limit is never read either --
// natAllocHelper materialises the arena END from the link-time patch -- so no
// initialisation step is needed at all.
func natNativeArenaBytes0(n) {
    let out = []
    let i = 0
    while (i < n) {
        out = appendArray(out, 0)
        i = i + 1
    }
    return out
}

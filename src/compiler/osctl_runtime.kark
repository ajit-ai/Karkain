    emitLine(state, "#else")
    emitLine(state, "    pid_t pid = fork();")
    emitLine(state, "    if (pid < 0) { karkain_osctl_err(\"proc_spawn: fork failed\"); return make_int(-1); }")
    emitLine(state, "    if (pid == 0) {")
    emitLine(state, "        // child: exec via sh to handle paths with spaces / shell features")
    emitLine(state, "        execlp(\"sh\", \"sh\", \"-c\", c, (char *)NULL);")
    emitLine(state, "        _exit(127);")
    emitLine(state, "    }")
    emitLine(state, "    return make_int((long long)pid);")
    emitLine(state, "#endif")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "Value karkain_proc_kill(Value pid_val) {")
    emitLine(state, "    _karkain_osctl_error[0] = '\\0';")
    emitLine(state, "    long long pid = pid_val.intVal;")
    emitLine(state, "    if (pid <= 0) { karkain_osctl_err(\"proc_kill: invalid pid\"); return make_int(-1); }")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "    HANDLE h = OpenProcess(PROCESS_TERMINATE, FALSE, (DWORD)pid);")
    emitLine(state, "    if (!h) { karkain_osctl_err(\"proc_kill: OpenProcess failed\"); return make_int(-1); }")
    emitLine(state, "    BOOL ok = TerminateProcess(h, 1);")
    emitLine(state, "    CloseHandle(h);")
    emitLine(state, "    if (!ok) { karkain_osctl_err(\"proc_kill: TerminateProcess failed\"); return make_int(-1); }")
    emitLine(state, "    return make_int(0);")
    emitLine(state, "#else")
    emitLine(state, "    if (kill((pid_t)pid, SIGTERM) != 0) {")
    emitLine(state, "        karkain_osctl_err(\"proc_kill: kill failed\"); return make_int(-1);")
    emitLine(state, "    }")
    emitLine(state, "    return make_int(0);")
    emitLine(state, "#endif")
    emitLine(state, "}")
    emitLine(state, "")
    emitLine(state, "Value karkain_proc_wait(Value pid_val) {")
    emitLine(state, "    _karkain_osctl_error[0] = '\\0';")
    emitLine(state, "    long long pid = pid_val.intVal;")
    emitLine(state, "    if (pid <= 0) { karkain_osctl_err(\"proc_wait: invalid pid\"); return make_int(-1); }")
    emitLine(state, "#ifdef _WIN32")
    emitLine(state, "    HANDLE h = OpenProcess(SYNCHRONIZE | PROCESS_QUERY_INFORMATION, FALSE, (DWORD)pid);")
    emitLine(state, "    if (!h) { karkain_osctl_err(\"proc_wait: OpenProcess failed\"); return make_int(-1); }")
    emitLine(state, "    WaitForSingleObject(h, INFINITE);")
    emitLine(state, "    DWORD code = 0;")
    emitLine(state, "    GetExitCodeProcess(h, &code);")
    emitLine(state, "    CloseHandle(h);")
    emitLine(state, "    return make_int((long long)code);")
    emitLine(state, "#else")
    emitLine(state, "    int status = 0;")
    emitLine(state, "    pid_t r = waitpid((pid_t)pid, &status, 0);")
    emitLine(state, "    if (r < 0) { karkain_osctl_err(\"proc_wait: waitpid failed\"); return make_int(-1); }")
    emitLine(state, "    if (WIFEXITED(status)) return make_int((long long)WEXITSTATUS(status));")
    emitLine(state, "    if (WIFSIGNALED(status)) return make_int((long long)(128 + WTERMSIG(status)));")
    emitLine(state, "    return make_int(-1);")
    emitLine(state, "#endif")
    emitLine(state, "}")
    emitLine(state, "")
}

// ============================================================
// Phase 99: Type checker for the self-hosted Karkain compiler.
// A two-pass whole-program checker that mirrors the Go semantic
// authority (pkg/sema/resolve.go) and adds conservative type
// rules. Pass 1 collects declarations (funcs, kernels, structs,
// enums) into a global symbol table; pass 2 walks every function
// body and reports hard errors:
//
//   K101 undefined function call
//   K102 undefined identifier read (inside a function body)
//   K103 function/kernel arity mismatch
//   K104 builtin arity mismatch
//   K106 struct literal with an undefined type name
//   K107 duplicate top-level definition
//   K108 break/continue outside a loop
//   K109 calling a type name as a function
//   K112 primitive annotation/initializer type mismatch
//
// Karkain values are dynamically typed, so the checker is
// conservative by design: it only reports errors that are
// provable from the AST, and it never rejects a program it cannot
// prove is wrong (the compiled corpus and the compiler's own
// sources must keep passing unchanged). Editor/lint flows keep
// treating sema.kark warnings as non-fatal.
// ============================================================

// ============================================================
// Builtin allow-list (union of the self-hosted runtime builtins
// from sema.kark and the Go front end's builtinNames).
// ============================================================

func isCheckerBuiltin(name) {
    if (name == "print") { return 1 }
    if (name == "len") { return 1 }
    if (name == "str") { return 1 }
    if (name == "int") { return 1 }
    if (name == "float") { return 1 }
    if (name == "substr") { return 1 }
    if (name == "appendArray") { return 1 }
    if (name == "openFile") { return 1 }
    if (name == "readLine") { return 1 }
    if (name == "closeFile") { return 1 }
    if (name == "createFile") { return 1 }
    if (name == "writeToFile") { return 1 }
    if (name == "removeFile") { return 1 }
    if (name == "readFile") { return 1 }
    if (name == "writeFile") { return 1 }
    if (name == "getArgs") { return 1 }
    if (name == "system") { return 1 }
    if (name == "makeMap") { return 1 }
    if (name == "mapSet") { return 1 }
    if (name == "mapGet") { return 1 }
    if (name == "mapHas") { return 1 }
    if (name == "karkain_len") { return 1 }
    if (name == "trim") { return 1 }
    if (name == "contains") { return 1 }
    if (name == "split") { return 1 }
    if (name == "sqrt") { return 1 }
    if (name == "abs") { return 1 }
    if (name == "pow") { return 1 }
    if (name == "fileExists") { return 1 }
    if (name == "println") { return 1 }
    if (name == "printf") { return 1 }
    if (name == "fmt") { return 1 }
    if (name == "push") { return 1 }
    if (name == "hasKey") { return 1 }
    if (name == "delete") { return 1 }
    if (name == "readLineEOF") { return 1 }
    if (name == "listFiles") { return 1 }
    if (name == "mod") { return 1 }
    if (name == "add_checked") { return 1 }
    if (name == "sub_checked") { return 1 }
    if (name == "mul_checked") { return 1 }
    if (name == "hex_encode_bytes") { return 1 }
    if (name == "hex_decode_bytes") { return 1 }
    if (name == "base64_encode_bytes") { return 1 }
    if (name == "base64_decode_bytes") { return 1 }
    if (name == "utf8_valid_bytes") { return 1 }
    if (name == "sha256_hex") { return 1 }
    if (name == "sha512_hex") { return 1 }
    if (name == "map_keys_of") { return 1 }
    if (name == "http.get") { return 1 }
    if (name == "net_connect") { return 1 }
    if (name == "net_listen") { return 1 }
    if (name == "net_accept") { return 1 }
    if (name == "net_read") { return 1 }
    if (name == "net_write") { return 1 }
    if (name == "net_close") { return 1 }
    if (name == "net_last_error") { return 1 }
    if (name == "Some") { return 1 }
    if (name == "None") { return 1 }
    if (name == "Ok") { return 1 }
    if (name == "Err") { return 1 }
    if (name == "assert") { return 1 }
    if (name == "assert_eq") { return 1 }
    if (name == "assert_ne") { return 1 }
    return 0
}

// checkerBuiltinArity returns the fixed arity of a builtin, or -1
// when it is variadic / unknown-shaped (no arity check performed).
func checkerBuiltinArity(name) {
    if (name == "print") { return -1 }
    if (name == "len") { return 1 }
    if (name == "str") { return 1 }
    if (name == "int") { return 1 }
    if (name == "float") { return 1 }
    if (name == "substr") { return 3 }
    if (name == "appendArray") { return 2 }
    if (name == "openFile") { return 1 }
    if (name == "readLine") { return 1 }
    if (name == "closeFile") { return 1 }
    if (name == "createFile") { return 1 }
    if (name == "writeToFile") { return 2 }
    if (name == "removeFile") { return 1 }
    if (name == "readFile") { return 1 }
    if (name == "writeFile") { return 2 }
    if (name == "getArgs") { return 0 }
    if (name == "system") { return 1 }
    if (name == "makeMap") { return 0 }
    if (name == "mapSet") { return 3 }
    if (name == "mapGet") { return 2 }
    if (name == "mapHas") { return 2 }
    if (name == "karkain_len") { return 1 }
    if (name == "trim") { return 1 }
    if (name == "contains") { return 2 }
    if (name == "split") { return 2 }
    if (name == "sqrt") { return 1 }
    if (name == "abs") { return 1 }
    if (name == "pow") { return 2 }
    if (name == "fileExists") { return 1 }
    if (name == "hex_encode_bytes") { return 1 }
    if (name == "hex_decode_bytes") { return 1 }
    if (name == "base64_encode_bytes") { return 1 }
    if (name == "base64_decode_bytes") { return 1 }
    if (name == "utf8_valid_bytes") { return 1 }
    if (name == "sha256_hex") { return 1 }
    if (name == "sha512_hex") { return 1 }
    if (name == "map_keys_of") { return 1 }
    if (name == "net_connect") { return 2 }
    if (name == "net_listen") { return 2 }
    if (name == "net_accept") { return 1 }
    if (name == "net_read") { return 2 }
    if (name == "net_write") { return 2 }
    if (name == "net_close") { return 1 }
    if (name == "net_last_error") { return 0 }
    return -1
}

// ============================================================
// Checker state
// ============================================================

func createCheckerTab() {
    let tab = []
    tab = appendArray(tab, [])  // 0: global symbol names
    tab = appendArray(tab, [])  // 1: global symbol kinds ("func", "struct", "enum", ...)
    tab = appendArray(tab, [])  // 2: global symbol arities
    tab = appendArray(tab, [])  // 3: error messages
    tab = appendArray(tab, [])  // 4: current function locals
    tab = appendArray(tab, [])  // 5: current function const names (immutable bindings)
    tab = appendArray(tab, [])  // 6: enum variant lists (parallel to 0/1/2)
    return tab
}

func ckErrors(tab)  { return tab[3] }
func ckLocals(tab)  { return tab[4] }
func ckConsts(tab)  { return tab[5] }

// strFindChar returns the index of the first occurrence of `c` in `s`,
// or -1 when absent. (Self-hosted builtins include substr/len but no indexOf.)
func strFindChar(s, c) {
    let i = 0
    while (i < len(s)) {
        if (substr(s, i, 1) == c) { return i }
        i = i + 1
    }
    return -1
}

func ckConstAdd(tab, name) {
    if (name == "") { return }
    tab[5] = appendArray(tab[5], name)
}

func ckConstHas(tab, name) {
    let consts = tab[5]
    let i = 0
    while (i < len(consts)) {
        if (consts[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

func ckDeclare(tab, name, kind, count) {
    if (name == "") { return }
    tab[0] = appendArray(tab[0], name)
    tab[1] = appendArray(tab[1], kind)
    tab[2] = appendArray(tab[2], count)
    tab[6] = appendArray(tab[6], [])
}

// ckSetEnumVariants attaches a variant list to a declared enum (kind "enum").
// Rebuilds the parallel variants table (top-level writes only: nested element
// assignment is not relied upon by the self-hosted compiler).
func ckSetEnumVariants(tab, name, variants) {
    let names = tab[0]
    let rebuilt = []
    let i = 0
    while (i < len(names)) {
        if (names[i] == name) {
            rebuilt = appendArray(rebuilt, variants)
        } else {
            rebuilt = appendArray(rebuilt, tab[6][i])
        }
        i = i + 1
    }
    tab[6] = rebuilt
}

// ckEnumHasVariant reports whether `name` is a declared enum with variant `v`.
// Raw entries are "Name:" (unit) or "Name:payload"; match on the leading
// variant name (which is followed by ':' or is the whole entry).
func ckEnumHasVariant(tab, name, v) {
    let names = tab[0]
    let kinds = tab[1]
    let vari = tab[6]
    let i = 0
    while (i < len(names)) {
        if (names[i] == name && kinds[i] == "enum") {
            let vs = vari[i]
            let j = 0
            while (j < len(vs)) {
                let entry = vs[j]
                if (entry == v) { return 1 }
                // entry's variant name is the longest prefix before ':'
                let prefix = v + ":"
                let pl = len(prefix)
                if (len(entry) >= pl && substr(entry, 0, pl) == prefix) { return 1 }
                j = j + 1
            }
        }
        i = i + 1
    }
    return 0
}

func ckKind(tab, name) {
    let names = tab[0]
    let kinds = tab[1]
    let i = 0
    while (i < len(names)) {
        if (names[i] == name) {
            return kinds[i]
        }
        i = i + 1
    }
    return ""
}

func ckCount(tab, name) {
    let names = tab[0]
    let counts = tab[2]
    let i = 0
    while (i < len(names)) {
        if (names[i] == name) {
            return counts[i]
        }
        i = i + 1
    }
    return -1
}

func ckLocalHas(tab, name) {
    let locals = ckLocals(tab)
    let i = 0
    while (i < len(locals)) {
        if (locals[i] == name) {
            return 1
        }
        i = i + 1
    }
    return 0
}

func ckLocalAdd(tab, name) {
    if (name == "") { return }
    tab[4] = appendArray(tab[4], name)
}

func ckAddError(tab, code, line, msg) {
    tab[3] = appendArray(tab[3], "error[" + code + "] line " + str(line) + ": " + msg)
}

// ============================================================
// Pass 1: collect top-level declarations
// ============================================================

func collectDecls(tab, stmts) {
    let i = 0
    while (i < len(stmts)) {
        let s = stmts[i]
        let nt = getNodeType(s)
        if (nt == "FuncDecl") {
            let name = funcName(s)
            if (name != "" && ckKind(tab, name) != "") {
                ckAddError(tab, "K107", funcLine(s), "duplicate function definition '" + name + "'")
            } else {
                ckDeclare(tab, name, "func", len(funcParams(s)))
            }
        }
        if (nt == "KernelDecl") {
            let name = kernelName(s)
            if (name != "" && ckKind(tab, name) != "") {
                ckAddError(tab, "K107", kernelLine(s), "duplicate function definition '" + name + "'")
            } else {
                ckDeclare(tab, name, "func", len(kernelParams(s)))
            }
        }
        if (nt == "StructDecl") {
            let name = structName(s)
            if (name != "" && ckKind(tab, name) != "") {
                ckAddError(tab, "K107", structDeclLine(s), "duplicate type definition '" + name + "'")
            } else {
                ckDeclare(tab, name, "struct", 0)
            }
        }
        if (nt == "EnumDecl") {
            let name = enumDeclName(s)
            if (name != "" && ckKind(tab, name) != "") {
                ckAddError(tab, "K107", enumDeclLine(s), "duplicate type definition '" + name + "'")
            } else {
                ckDeclare(tab, name, "enum", 0)
                // Phase 123: index variants so EnumName.Variant uses resolve.
                // Raw entries are "Name:" (unit) or "Name:payload".
                ckSetEnumVariants(tab, name, enumDeclVariants(s))
            }
        }
        i = i + 1
    }
}

// Pre-scan a statement list, registering every local var/let and
// loop variable so forward references resolve (mirrors the Go
// resolver's walkLocalDefs). Nested funcs and lambdas get their
// own scopes and are deliberately skipped here.

func collectLocals(tab, list) {
    let i = 0
    while (i < len(list)) {
        let s = list[i]
        let nt = getNodeType(s)
        if (nt == "VarDecl" || nt == "LetDecl") {
            let nm = varDeclName(s)
            if (nm == "") { nm = letDeclName(s) }
            ckLocalAdd(tab, nm)
        } else if (nt == "ConstDecl") {
            let nm = constDeclName(s)
            ckLocalAdd(tab, nm)
            ckConstAdd(tab, nm)
        }
        if (nt == "ForIn") {
            ckLocalAdd(tab, forInVar(s))
            collectLocals(tab, forInBody(s))
        }
        if (nt == "Block") {
            collectLocals(tab, blockStmts(s))
        }
        if (nt == "If") {
            collectLocals(tab, ifThen(s))
            collectLocals(tab, ifElse(s))
        }
        if (nt == "While") {
            collectLocals(tab, whileBody(s))
        }
        if (nt == "For") {
            let initNode = forInit(s)
            if (initNode != []) {
                let it = getNodeType(initNode)
                if (it == "VarDecl" || it == "LetDecl") {
                    ckLocalAdd(tab, varDeclName(initNode))
                }
            }
            collectLocals(tab, forBody(s))
        }
        i = i + 1
    }
}

// ============================================================
// Pass 2: function bodies
// ============================================================

func checkFuncDecl(tab, node, inherit) {
    // Phase 133 UAF fix: `saved` aliases the caller's locals array, and
    // appendArray may REALLOCATE on append — so the caller's buffer must
    // never be appended to while `saved` is live. Always reset to a fresh
    // array first; with inherit == 1 the outer names are COPIED in (reads
    // only), which is use-after-free safe. Skipping the reset (the first
    // attempt) restored a dangling buffer and segfaulted.
    // Nested functions and let-bound lambdas inherit the enclosing scope
    // (mirrors the Go resolver) so captures resolve instead of K101/K102.
    // Only top-level declarations skip the copy (their lets must not leak).
    let saved = ckLocals(tab)
    tab[4] = []
    if (inherit == 1) {
        let si = 0
        while (si < len(saved)) {
            ckLocalAdd(tab, saved[si])
            si = si + 1
        }
    }
    let params = funcParams(node)
    let i = 0
    while (i < len(params)) {
        ckLocalAdd(tab, params[i])
        i = i + 1
    }
    collectLocals(tab, funcBody(node))
    checkStmts(tab, funcBody(node), 0)
    // Phase 133: reject returns of closures capturing locals (K114).
    ckCheckEscapeUnit(tab, funcBody(node))
    tab[4] = saved
}

func checkKernelDecl(tab, node) {
checkFuncDecl(tab, node, 0)
}

func checkStmts(tab, list, loop) {
    let i = 0
    while (i < len(list)) {
        checkStmt(tab, list[i], loop)
        i = i + 1
    }
}

func checkStmt(tab, s, loop) {
    // Empty nodes arrive from constructs the self-hosted parser cannot fully
    // realize (e.g. a bare `return` yields an empty value node). They carry no
    // semantics to check, so skip them instead of dereferencing node[kind].
    if (len(s) < 1) { return }
    let nt = getNodeType(s)

    if (nt == "FuncDecl") {
        checkFuncDecl(tab, s, 1)
        return
    }
    if (nt == "KernelDecl") {
        checkKernelDecl(tab, s)
        return
    }

    if (nt == "VarDecl" || nt == "LetDecl") {
        let nm = varDeclName(s)
        let anno = varDeclType(s)
        let val = varDeclValue(s)
        let line = varDeclLine(s)
        if (nt == "LetDecl") {
            nm = letDeclName(s)
            anno = letDeclType(s)
            val = letDeclValue(s)
            line = letDeclLine(s)
        }
        ckLocalAdd(tab, nm)
        if (annotationMismatch(anno, val) == 1) {
            ckAddError(tab, "K112", line, "variable '" + nm + "' declared as type '" + primitiveTag(anno) + "' but initialized with a " + typeDescription(inferType(val)))
        }
        checkExpr(tab, val, loop)
        return
    }

    if (nt == "ConstDecl") {
        let nm = constDeclName(s)
        let anno = constDeclType(s)
        let val = constDeclValue(s)
        let line = constDeclLine(s)
        ckLocalAdd(tab, nm)
        ckConstAdd(tab, nm)
        if (annotationMismatch(anno, val) == 1) {
            ckAddError(tab, "K112", line, "variable '" + nm + "' declared as type '" + primitiveTag(anno) + "' but initialized with a " + typeDescription(inferType(val)))
        }
        checkExpr(tab, val, loop)
        return
    }

    if (nt == "Return") {
        checkExpr(tab, retVal(s), loop)
        return
    }
    if (nt == "Print") {
        checkExpr(tab, printVal(s), loop)
        return
    }

    if (nt == "ExprStmt") {
        let e = exprStmtExpr(s)
        // Phase 51 semantics: a bare `x = v` statement implicitly declares x.
        if (getNodeType(e) == "BinaryExpr" && binaryOp(e) == "=") {
            let lhs = binaryLeft(e)
            if (getNodeType(lhs) == "Ident") {
                let nm = identName(lhs)
                if (nm != "" && ckConstHas(tab, nm) == 1) {
                    ckAddError(tab, "K113", identLine(lhs), "cannot reassign constant '" + nm + "'")
                }
                if (nm != "" && ckLocalHas(tab, nm) == 0 && ckKind(tab, nm) == "" && isCheckerBuiltin(nm) == 0) {
                    ckLocalAdd(tab, nm)
                }
            }
        }
        checkExpr(tab, e, loop)
        return
    }

    if (nt == "If") {
        checkExpr(tab, ifCondition(s), loop)
        checkStmts(tab, ifThen(s), loop)
        checkStmts(tab, ifElse(s), loop)
        return
    }

    if (nt == "While") {
        checkExpr(tab, whileCondition(s), loop)
        checkStmts(tab, whileBody(s), loop + 1)
        return
    }

    if (nt == "For") {
        let initNode = forInit(s)
        if (initNode != []) {
            let it = getNodeType(initNode)
            if (it == "VarDecl" || it == "LetDecl") {
                let iname = varDeclName(initNode)
                let ianno = varDeclType(initNode)
                let ival = varDeclValue(initNode)
                let iline = varDeclLine(initNode)
                if (it == "LetDecl") {
                    iname = letDeclName(initNode)
                    ianno = letDeclType(initNode)
                    ival = letDeclValue(initNode)
                    iline = letDeclLine(initNode)
                }
                ckLocalAdd(tab, iname)
                if (annotationMismatch(ianno, ival) == 1) {
                    ckAddError(tab, "K112", iline, "variable '" + iname + "' declared as type '" + primitiveTag(ianno) + "' but initialized with a " + typeDescription(inferType(ival)))
                }
                checkExpr(tab, ival, loop)
            } else {
                checkExpr(tab, initNode, loop)
            }
        }
        checkExpr(tab, forCondition(s), loop)
        if (forPost(s) != []) { checkExpr(tab, forPost(s), loop) }
        checkStmts(tab, forBody(s), loop + 1)
        return
    }

    if (nt == "ForIn") {
        checkExpr(tab, forInIter(s), loop)
        checkStmts(tab, forInBody(s), loop + 1)
        return
    }

    if (nt == "Break") {
        if (loop == 0) { ckAddError(tab, "K108", breakLine(s), "'break' outside of a loop") }
        return
    }
    if (nt == "Continue") {
        if (loop == 0) { ckAddError(tab, "K108", continueLine(s), "'continue' outside of a loop") }
        return
    }

    if (nt == "Block") {
        checkStmts(tab, blockStmts(s), loop)
        return
    }

    if (nt == "Match") {
        checkExpr(tab, matchValue(s), loop)
        // Phase 123: validate enum_variant arms against declared enums and
        // walk each arm's pattern value and body. Binding form is "Enum.Variant".
        let arms = matchArms(s)
        let a = 0
        while (a < len(arms)) {
            let arm = arms[a]
            if (armPatternType(arm) == "enum_variant") {
                let b = armBinding(arm)
                let sep = strFindChar(b, ".")
                if (sep >= 0) {
                    let en = substr(b, 0, sep)
                    let vr = substr(b, sep + 1, len(b) - sep - 1)
                    if (ckKind(tab, en) == "") {
                        ckAddError(tab, "K106", armLine(arm), "use of undefined enum type '" + en + "' in match arm")
                    } else if (ckEnumHasVariant(tab, en, vr) == 0) {
                        ckAddError(tab, "K113", armLine(arm), "unknown enum variant '" + en + "." + vr + "' in match arm")
                    }
                }
            }
            if (armPatternValue(arm) != []) { checkExpr(tab, armPatternValue(arm), loop) }
            let body = armBody(arm)
            if (getNodeType(body) == "Block") { checkStmts(tab, blockStmts(body), loop) }
            a = a + 1
        }
        return
    }
}

// ============================================================
// Expression walking
// ============================================================

func checkExpr(tab, e, loop) {
    // Same tolerance as checkStmt: an empty expression node (bare `return`,
    // unparseable primary) has nothing to check.
    if (len(e) < 1) { return }
    let nt = getNodeType(e)

    if (nt == "Ident") {
        checkIdent(tab, e)
        return
    }

    if (nt == "Call") {
        checkCall(tab, e, loop)
        return
    }

    // Phase 133: a computed callee has no static name to resolve — arity is
    // enforced at runtime by the dispatch wrapper. Resolve the callee
    // expression and the arguments for undefined names.
    if (nt == "IndirectCall") {
        checkExpr(tab, indirectTarget(e), loop)
        let iargs = indirectArgs(e)
        let i = 0
        while (i < len(iargs)) {
            checkExpr(tab, iargs[i], loop)
            i = i + 1
        }
        return
    }

    // Phase 133: these arms were dead ("Binary"/"Unary" never equal the
    // getNodeType spellings "BinaryExpr"/"UnaryExpr"), so binary operands
    // were never name-checked — diverging from the Go resolver. Fixed.
    if (nt == "BinaryExpr") {
        checkExpr(tab, binaryLeft(e), loop)
        checkExpr(tab, binaryRight(e), loop)
        return
    }

    if (nt == "UnaryExpr") {
        checkExpr(tab, unaryOperand(e), loop)
        return
    }

    if (nt == "Member") {
        checkExpr(tab, dotLeft(e), loop)
        return
    }

    // Phase 123: EnumName.Variant[(payload)] construction. Gate on the enum
    // type existing and the variant being a member; payloads are value reads.
    if (nt == "Match") {
        checkExpr(tab, matchValue(e), loop)
        let arms = matchArms(e)
        let a = 0
        while (a < len(arms)) {
            let arm = arms[a]
            if (armPatternType(arm) == "enum_variant") {
                let b = armBinding(arm)
                let sep = strFindChar(b, ".")
                if (sep >= 0) {
                    let en = substr(b, 0, sep)
                    let vr = substr(b, sep + 1, len(b) - sep - 1)
                    if (ckKind(tab, en) == "") {
                        ckAddError(tab, "K106", armLine(arm), "use of undefined enum type '" + en + "' in match arm")
                    } else if (ckEnumHasVariant(tab, en, vr) == 0) {
                        ckAddError(tab, "K113", armLine(arm), "unknown enum variant '" + en + "." + vr + "' in match arm")
                    }
                }
            }
            if (armPatternValue(arm) != []) { checkExpr(tab, armPatternValue(arm), loop) }
            let body = armBody(arm)
            if (getNodeType(body) == "Block") { checkStmts(tab, blockStmts(body), loop) }
            a = a + 1
        }
        return
    }

    if (nt == "EnumVariantExpr") {
        let en = enumVariantExprEnumName(e)
        if (en != "") {
            if (ckKind(tab, en) == "") {
                ckAddError(tab, "K106", enumVariantExprLine(e), "use of undefined enum type '" + en + "'")
            } else if (ckEnumHasVariant(tab, en, enumVariantExprVariant(e)) == 0) {
                ckAddError(tab, "K113", enumVariantExprLine(e), "unknown enum variant '" + en + "." + enumVariantExprVariant(e) + "'")
            }
        }
        let val = enumVariantExprValue(e)
        if (val != []) { checkExpr(tab, val, loop) }
        return
    }

    if (nt == "Index") {
        checkExpr(tab, indexLeft(e), loop)
        checkExpr(tab, indexExpr(e), loop)
        return
    }

    if (nt == "Slice") {
        checkExpr(tab, sliceLeft(e), loop)
        if (sliceStart(e) != []) { checkExpr(tab, sliceStart(e), loop) }
        if (sliceEnd(e) != []) { checkExpr(tab, sliceEnd(e), loop) }
        return
    }

    // Phase 121: a let-bound lambda arrives as a FuncDecl value; bind its
    // params and check its body with the enclosing scope inherited
    // (Phase 133: captures must resolve like the Go resolver allows).
    if (nt == "FuncDecl") {
        checkFuncDecl(tab, e, 1)
        return
    }

    // Phase 121: alloc(T, n) / free(x) operands are plain expressions.
    if (nt == "Alloc") {
        checkExpr(tab, allocCount(e), loop)
        return
    }
    if (nt == "Free") {
        checkExpr(tab, freePtr(e), loop)
        return
    }

    if (nt == "ArrayLiteral") {
        let elems = arrayElements(e)
        let i = 0
        while (i < len(elems)) {
            checkExpr(tab, elems[i], loop)
            i = i + 1
        }
        return
    }

    if (nt == "MapLiteral") {
        // Map keys are conservatively treated as labels (mirrors the Go
        // resolver); only values are value-position reads.
        let vals = mapValues(e)
        let i = 0
        while (i < len(vals)) {
            checkExpr(tab, vals[i], loop)
            i = i + 1
        }
        return
    }

    if (nt == "StructLiteral") {
        let tn = structLitName(e)
        if (tn != "") {
            let k = ckKind(tab, tn)
            if (k != "struct" && k != "enum") {
                ckAddError(tab, "K106", structLitLine(e), "use of undefined type '" + tn + "' in struct literal")
            }
        }
        let fields = structLitFields(e)
        let i = 0
        while (i < len(fields)) {
            let f = fields[i]
            // Phase 133: the tag test must read "BinaryExpr" (getNodeType
            // spelling). The old "Binary" never matched, so fields fell
            // into the else below and — once checkExpr learned BinaryExpr
            // — their key identifiers were misread as value reads (K102
            // on every struct field). Values only, like the Go resolver.
            if (getNodeType(f) == "BinaryExpr" && binaryOp(f) == "=") {
                checkExpr(tab, binaryRight(f), loop)
            } else {
                checkExpr(tab, f, loop)
            }
            i = i + 1
        }
        return
    }

    if (nt == "Lambda") {
        let outer = ckLocals(tab)
        tab[4] = []
        let j = 0
        while (j < len(outer)) {
            ckLocalAdd(tab, outer[j])
            j = j + 1
        }
        let params = lambdaParams(e)
        let k = 0
        while (k < len(params)) {
            ckLocalAdd(tab, params[k])
            k = k + 1
        }
        collectLocals(tab, lambdaBody(e))
        checkStmts(tab, lambdaBody(e), loop)
        // Phase 133: a bare lambda body is its own escape unit.
        ckCheckEscapeUnit(tab, lambdaBody(e))
        tab[4] = outer
        return
    }

    if (nt == "Borrow") {
        checkExpr(tab, borrowOp(e), loop)
        return
    }
    if (nt == "Move") {
        checkExpr(tab, borrowOp(e), loop)
        return
    }
    if (nt == "ResultOk" || nt == "ResultErr" || nt == "OptionSome" || nt == "OptionNone") {
        return
    }
    if (nt == "Propagate") {
        checkExpr(tab, borrowOp(e), loop)
        return
    }
}

// ============================================================
// Leaves
// ============================================================

func checkIdent(tab, e) {
    let name = identName(e)
    if (name == "") { return }
    if (name == "true" || name == "false" || name == "nil" || name == "THIS" || name == "self") { return }
    if (ckLocalHas(tab, name) == 1) { return }
    if (ckKind(tab, name) != "") { return }
    if (isCheckerBuiltin(name) == 1) { return }
    ckAddError(tab, "K102", identLine(e), "undefined identifier '" + name + "'")
}

func checkCall(tab, e, loop) {
    let name = callFunc(e)
    let args = callArgs(e)
    let argc = len(args)

    // Always inspect arguments (mirrors the Go resolver's recursion).
    let a = 0
    while (a < len(args)) {
        checkExpr(tab, args[a], loop)
        a = a + 1
    }

    // Method calls (obj.method / module.name) are outside the flat-name model.
    if (contains(name, ".") == 1) { return }

    if (isCheckerBuiltin(name) == 1) {
        let want = checkerBuiltinArity(name)
        if (want >= 0 && want != argc) {
            ckAddError(tab, "K104", callLine(e), "builtin '" + name + "' expects " + str(want) + " arguments but got " + str(argc))
        }
        return
    }

    if (ckLocalHas(tab, name) == 1) { return }

    let kind = ckKind(tab, name)
    if (kind != "") {
        if (kind == "func" || kind == "kernel") {
            let want = ckCount(tab, name)
            if (want >= 0 && want != argc) {
                ckAddError(tab, "K103", callLine(e), "function '" + name + "' expects " + str(want) + " arguments but got " + str(argc))
            }
        } else {
            ckAddError(tab, "K109", callLine(e), "cannot call type '" + name + "' as a function")
        }
        return
    }

    ckAddError(tab, "K101", callLine(e), "undefined function '" + name + "'")
}

// ============================================================
// Phase 133: escaping-capture rejection (mirrors the Go resolver's
// checkEscapeReturns). Captures are by-ref into the defining frame, so
// returning a closure that captures function-local state would dangle.
// Such returns are rejected with K114 (exit 3 on check/build/run);
// non-capturing closures (NULL env) still return fine. Calls have unknown
// provenance and are allowed (documented dynamic gap, same as Go).
// ============================================================

func ckTaintedHas(tainted, name) {
    let i = 0
    while (i < len(tainted)) {
        if (tainted[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

func ckTaintedAdd(tainted, name) {
    if (ckTaintedHas(tainted, name) == 0) { tainted = appendArray(tainted, name) }
    return tainted
}

// ckValueCaptures reports whether a value transitively closes over
// function-local state (1) or not (0).
func ckValueCaptures(e, tainted) {
    if (len(e) < 1) { return 0 }
    let nt = getNodeType(e)
    if (nt == "FuncDecl") {
        if (len(funcCaptures(e)) > 0) { return 1 }
        return 0
    }
    if (nt == "Lambda") {
        let caps = computeCaptures(lambdaParams(e), lambdaBody(e))
        if (len(caps) > 0) { return 1 }
        return 0
    }
    if (nt == "Ident") { return ckTaintedHas(tainted, identName(e)) }
    if (nt == "ArrayLiteral") {
        let elems = arrayElements(e)
        let i = 0
        while (i < len(elems)) {
            if (ckValueCaptures(elems[i], tainted) == 1) { return 1 }
            i = i + 1
        }
        return 0
    }
    if (nt == "MapLiteral") {
        let ks = mapKeys(e)
        let i = 0
        while (i < len(ks)) {
            if (ckValueCaptures(ks[i], tainted) == 1) { return 1 }
            i = i + 1
        }
        let vs = mapValues(e)
        let j = 0
        while (j < len(vs)) {
            if (ckValueCaptures(vs[j], tainted) == 1) { return 1 }
            j = j + 1
        }
        return 0
    }
    if (nt == "StructLiteral") {
        let fields = structLitFields(e)
        let i = 0
        while (i < len(fields)) {
            let f = fields[i]
            if (getNodeType(f) == "BinaryExpr") {
                if (ckValueCaptures(binaryRight(f), tainted) == 1) { return 1 }
            } else {
                if (ckValueCaptures(f, tainted) == 1) { return 1 }
            }
            i = i + 1
        }
        return 0
    }
    if (nt == "Index") {
        if (ckValueCaptures(indexLeft(e), tainted) == 1) { return 1 }
        return ckValueCaptures(indexExpr(e), tainted)
    }
    if (nt == "Slice") {
        return ckValueCaptures(sliceLeft(e), tainted)
    }
    if (nt == "Member") {
        return ckValueCaptures(dotLeft(e), tainted)
    }
    // NOTE: getNodeType spells these "BinaryExpr"/"UnaryExpr" (not
    // "Binary"/"Unary" — the latter would be a dead branch (this file's
    // StructLiteral arm and checkExpr's arms had exactly that defect;
    // both fixed in Phase 133).
    if (nt == "BinaryExpr") {
        if (ckValueCaptures(binaryLeft(e), tainted) == 1) { return 1 }
        return ckValueCaptures(binaryRight(e), tainted)
    }
    if (nt == "UnaryExpr") {
        return ckValueCaptures(unaryOperand(e), tainted)
    }
    if (nt == "Match") {
        if (ckValueCaptures(matchValue(e), tainted) == 1) { return 1 }
        let arms = matchArms(e)
        let i = 0
        while (i < len(arms)) {
            if (ckValueCaptures(armBody(arms[i]), tainted) == 1) { return 1 }
            i = i + 1
        }
        return 0
    }
    return 0
}

// ckCollectTainted marks let/var/const names whose values close over
// function-local state. Blocks share the unit; nested function bodies are
// separate units (checked via checkFuncDecl / the Lambda branch).
func ckCollectTainted(stmts, tainted) {
    let i = 0
    while (i < len(stmts)) {
        let s = stmts[i]
        if (len(s) < 1) { i = i + 1 }
        else {
            let nt = getNodeType(s)
            if (nt == "VarDecl") {
                if (ckValueCaptures(varDeclValue(s), tainted) == 1) {
                    tainted = ckTaintedAdd(tainted, varDeclName(s))
                }
            } else if (nt == "LetDecl") {
                if (ckValueCaptures(letDeclValue(s), tainted) == 1) {
                    tainted = ckTaintedAdd(tainted, letDeclName(s))
                }
            } else if (nt == "ConstDecl") {
                if (ckValueCaptures(constDeclValue(s), tainted) == 1) {
                    tainted = ckTaintedAdd(tainted, constDeclName(s))
                }
            } else if (nt == "Block") {
                tainted = ckCollectTainted(blockStmts(s), tainted)
            } else if (nt == "If") {
                tainted = ckCollectTainted(ifThen(s), tainted)
                tainted = ckCollectTainted(ifElse(s), tainted)
            } else if (nt == "While") {
                tainted = ckCollectTainted(whileBody(s), tainted)
            } else if (nt == "For") {
                tainted = ckCollectTainted(forBody(s), tainted)
            } else if (nt == "ForIn") {
                tainted = ckCollectTainted(forInBody(s), tainted)
            } else if (nt == "ExprStmt") {
                // A match in statement position may declare lets inside
                // arm blocks; collect those (expression arms declare nothing).
                let me = exprStmtExpr(s)
                if (getNodeType(me) == "Match") {
                    let arms = matchArms(me)
                    let a = 0
                    while (a < len(arms)) {
                        let ab = armBody(arms[a])
                        if (getNodeType(ab) == "Block") {
                            tainted = ckCollectTainted(blockStmts(ab), tainted)
                        }
                        a = a + 1
                    }
                }
            }
            i = i + 1
        }
    }
    return tainted
}

// ckCheckEscapeUnit checks one function-like body: fixpoint-taint every
// local binding, then reject returns of tainted values.
func ckCheckEscapeUnit(tab, stmts) {
    let tainted = []
    let k = 0
    while (k < 8) {
        let n0 = len(tainted)
        tainted = ckCollectTainted(stmts, tainted)
        if (len(tainted) == n0) { break }
        k = k + 1
    }
    ckCheckReturns(tab, stmts, tainted)
}

// ckCheckReturns rejects `return` of tainted values and descends into
// blocks (same frame). Nested named functions are skipped (own units via
// checkFuncDecl); bare lambdas are hooked at checkExpr's Lambda branch.
func ckCheckReturns(tab, stmts, tainted) {
    let i = 0
    while (i < len(stmts)) {
        let s = stmts[i]
        if (len(s) < 1) { i = i + 1 }
        else {
            let nt = getNodeType(s)
            if (nt == "Return") {
                if (ckValueCaptures(retVal(s), tainted) == 1) {
                    ckAddError(tab, "K114", retLine(s), "cannot return closure capturing function-local state (captures are by-ref into the dying frame)")
                }
            } else if (nt == "Block") {
                ckCheckReturns(tab, blockStmts(s), tainted)
            } else if (nt == "If") {
                ckCheckReturns(tab, ifThen(s), tainted)
                ckCheckReturns(tab, ifElse(s), tainted)
            } else if (nt == "While") {
                ckCheckReturns(tab, whileBody(s), tainted)
            } else if (nt == "For") {
                ckCheckReturns(tab, forBody(s), tainted)
            } else if (nt == "ForIn") {
                ckCheckReturns(tab, forInBody(s), tainted)
            } else if (nt == "ExprStmt") {
                // A match in statement position may return directly from
                // an arm block; check those (bare-expression arms hold no
                // returns by grammar).
                let me = exprStmtExpr(s)
                if (getNodeType(me) == "Match") {
                    let arms = matchArms(me)
                    let a = 0
                    while (a < len(arms)) {
                        let ab = armBody(arms[a])
                        if (getNodeType(ab) == "Block") {
                            ckCheckReturns(tab, blockStmts(ab), tainted)
                        }
                        a = a + 1
                    }
                }
            }
            i = i + 1
        }
    }
}

// ============================================================
// Entry point
// ============================================================

// typeCheckProgram runs both passes over the (assembled) program and returns
// the collected error messages. A clean program returns an empty list.
func typeCheckProgram(ast) {
    let tab = createCheckerTab()
    let stmts = programStatements(ast)
    collectDecls(tab, stmts)
    let i = 0
    while (i < len(stmts)) {
        let s = stmts[i]
        let nt = getNodeType(s)
        if (nt == "FuncDecl") { checkFuncDecl(tab, s, 0) }
        if (nt == "KernelDecl") { checkKernelDecl(tab, s) }
        i = i + 1
    }
    return ckErrors(tab)
}
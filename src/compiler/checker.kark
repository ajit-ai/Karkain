// ============================================================
// Phase 99: Type checker for the self-hosted Karkain compiler.
// A two-pass whole-program checker that mirrors the Go semantic
// authority (pkg/sema/resolve.go) and adds conservative type
// rules. Pass 1 collects declarations (funcs, kernels, structs,
// enums) into a global symbol table; pass 2 walks every function
// body and reports hard errors:
//
//   K101 undefined function call
//   K102 undefined identifier read (inside a function body)
//   K103 function/kernel arity mismatch
//   K104 builtin arity mismatch
//   K106 struct literal with an undefined type name
//   K107 duplicate top-level definition
//   K108 break/continue outside a loop
//   K109 calling a type name as a function
//   K112 primitive annotation/initializer type mismatch
//
// Karkain values are dynamically typed, so the checker is
// conservative by design: it only reports errors that are
// provable from the AST, and it never rejects a program it cannot
// prove is wrong (the compiled corpus and the compiler's own
// sources must keep passing unchanged). Editor/lint flows keep
// treating sema.kark warnings as non-fatal.
// ============================================================

// ============================================================
// Builtin allow-list (union of the self-hosted runtime builtins
// from sema.kark and the Go front end's builtinNames).
// ============================================================

func isCheckerBuiltin(name) {
    if (name == "print") { return 1 }
    if (name == "len") { return 1 }
    if (name == "str") { return 1 }
    if (name == "int") { return 1 }
    if (name == "float") { return 1 }
    if (name == "substr") { return 1 }
    if (name == "appendArray") { return 1 }
    if (name == "openFile") { return 1 }
    if (name == "readLine") { return 1 }
    if (name == "closeFile") { return 1 }
    if (name == "createFile") { return 1 }
    if (name == "writeToFile") { return 1 }
    if (name == "removeFile") { return 1 }
    if (name == "readFile") { return 1 }
    if (name == "writeFile") { return 1 }
    if (name == "getArgs") { return 1 }
    if (name == "system") { return 1 }
    if (name == "makeMap") { return 1 }
    if (name == "mapSet") { return 1 }
    if (name == "mapGet") { return 1 }
    if (name == "mapHas") { return 1 }
    if (name == "karkain_len") { return 1 }
    if (name == "trim") { return 1 }
    if (name == "contains") { return 1 }
    if (name == "split") { return 1 }
    if (name == "sqrt") { return 1 }
    if (name == "abs") { return 1 }
    if (name == "pow") { return 1 }
    if (name == "fileExists") { return 1 }
    if (name == "println") { return 1 }
    if (name == "printf") { return 1 }
    if (name == "fmt") { return 1 }
    if (name == "push") { return 1 }
    if (name == "hasKey") { return 1 }
    if (name == "delete") { return 1 }
    if (name == "readLineEOF") { return 1 }
    if (name == "listFiles") { return 1 }
    if (name == "mod") { return 1 }
    if (name == "add_checked") { return 1 }
    if (name == "sub_checked") { return 1 }
    if (name == "mul_checked") { return 1 }
    if (name == "hex_encode_bytes") { return 1 }
    if (name == "hex_decode_bytes") { return 1 }
    if (name == "base64_encode_bytes") { return 1 }
    if (name == "base64_decode_bytes") { return 1 }
    if (name == "utf8_valid_bytes") { return 1 }
    if (name == "sha256_hex") { return 1 }
    if (name == "sha512_hex") { return 1 }
    if (name == "map_keys_of") { return 1 }
    if (name == "http.get") { return 1 }
    if (name == "net_connect") { return 1 }
    if (name == "net_listen") { return 1 }
    if (name == "net_accept") { return 1 }
    if (name == "net_read") { return 1 }
    if (name == "net_write") { return 1 }
    if (name == "net_close") { return 1 }
    if (name == "net_last_error") { return 1 }
    if (name == "Some") { return 1 }
    if (name == "None") { return 1 }
    if (name == "Ok") { return 1 }
    if (name == "Err") { return 1 }
    if (name == "assert") { return 1 }
    if (name == "assert_eq") { return 1 }
    if (name == "assert_ne") { return 1 }
    // Phase 137: concurrency builtins (existence-only, like the Go
    // resolver — arity surfaces at C compile time on both engines).
    if (name == "channel") { return 1 }
    if (name == "chanSend") { return 1 }
    if (name == "chanClose") { return 1 }
    if (name == "join") { return 1 }
    if (name == "cancel") { return 1 }
    if (name == "join_timeout") { return 1 }
    if (name == "wait_all") { return 1 }
    if (name == "actor") { return 1 }
    if (name == "actorSend") { return 1 }
    if (name == "actorState") { return 1 }
    if (name == "setActorState") { return 1 }
    if (name == "actorStop") { return 1 }
    return 0
}

// checkerBuiltinArity returns the fixed arity of a builtin, or -1
// when it is variadic / unknown-shaped (no arity check performed).
func checkerBuiltinArity(name) {
    if (name == "print") { return -1 }
    if (name == "len") { return 1 }
    if (name == "str") { return 1 }
    if (name == "int") { return 1 }
    if (name == "float") { return 1 }
    if (name == "substr") { return 3 }
    if (name == "appendArray") { return 2 }
    if (name == "openFile") { return 1 }
    if (name == "readLine") { return 1 }
    if (name == "closeFile") { return 1 }
    if (name == "createFile") { return 1 }
    if (name == "writeToFile") { return 2 }
    if (name == "removeFile") { return 1 }
    if (name == "readFile") { return 1 }
    if (name == "writeFile") { return 2 }
    if (name == "getArgs") { return 0 }
    if (name == "system") { return 1 }
    if (name == "makeMap") { return 0 }
    if (name == "mapSet") { return 3 }
    if (name == "mapGet") { return 2 }
    if (name == "mapHas") { return 2 }
    if (name == "karkain_len") { return 1 }
    if (name == "trim") { return 1 }
    if (name == "contains") { return 2 }
    if (name == "split") { return 2 }
    if (name == "sqrt") { return 1 }
    if (name == "abs") { return 1 }
    if (name == "pow") { return 2 }
    if (name == "fileExists") { return 1 }
    if (name == "hex_encode_bytes") { return 1 }
    if (name == "hex_decode_bytes") { return 1 }
    if (name == "base64_encode_bytes") { return 1 }
    if (name == "base64_decode_bytes") { return 1 }
    if (name == "utf8_valid_bytes") { return 1 }
    if (name == "sha256_hex") { return 1 }
    if (name == "sha512_hex") { return 1 }
    if (name == "map_keys_of") { return 1 }
    if (name == "net_connect") { return 2 }
    if (name == "net_listen") { return 2 }
    if (name == "net_accept") { return 1 }
    if (name == "net_read") { return 2 }
    if (name == "net_write") { return 2 }
    if (name == "net_close") { return 1 }
    if (name == "net_last_error") { return 0 }
    // P0.2: bounded joins take (task, milliseconds); cancel takes a task.
    if (name == "cancel") { return 1 }
    if (name == "join_timeout") { return 2 }
    return -1
}

// ============================================================
// Checker state
// ============================================================

func createCheckerTab() {
    Value tab = []
    tab = appendArray(tab, [])  // 0: global symbol names
    tab = appendArray(tab, [])  // 1: global symbol kinds ("func", "struct", "enum", ...)
    tab = appendArray(tab, [])  // 2: global symbol arities
    tab = appendArray(tab, [])  // 3: error messages
    tab = appendArray(tab, [])  // 4: current function locals
    tab = appendArray(tab, [])  // 5: current function const names (immutable bindings)
    tab = appendArray(tab, [])  // 6: enum variant lists (parallel to 0/1/2)
    // Phase 146: generic template tracking
    tab = appendArray(tab, [])  // 7: generic function templates (name -> funcDecl)
    tab = appendArray(tab, [])  // 8: generic struct templates (name -> structDecl)
    tab = appendArray(tab, [])  // 9: instantiated specialization names (to avoid duplicates)
    tab = appendArray(tab, [])  // 10: function parameter types (name -> [types])
    tab = appendArray(tab, [])  // 11: function parameter names (for lifetime analysis, Phase 1.2)
    // Phase 150: global symbol name -> position in tab[0], used to accelerate
    // ckKind/ckCount lookups (avoids O(n) linear scans).
    map[string]int symIndex = {}
    tab = appendArray(tab, symIndex)  // 12: global symbol index (name -> position)
    return tab
}

func ckErrors(tab)  { return tab[3] }
func ckLocals(tab)  { return tab[4] }
func ckConsts(tab)  { return tab[5] }
func ckParams(tab)  { return tab[11] }
func ckParamAdd(tab, name) {
    if (name == "") { return }
    tab[11] = appendArray(tab[11], name)
}
func ckIsParam(tab, name) {
    int i = 0
    while (i < len(ckParams(tab))) {
        if (ckParams(tab)[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

// strFindChar returns the index of the first occurrence of `c` in `s`,
// or -1 when absent. (Self-hosted builtins include substr/len but no indexOf.)
func strFindChar(s, c) {
    int i = 0
    while (i < len(s)) {
        if (substr(s, i, 1) == c) { return i }
        i = i + 1
    }
    return -1
}

func ckConstAdd(tab, name) {
    if (name == "") { return }
    tab[5] = appendArray(tab[5], name)
}

func ckConstHas(tab, name) {
    Value consts = tab[5]
    int i = 0
    while (i < len(consts)) {
        if (consts[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

func ckSetParamTypes(tab, name, types) {
    if (name == "") { return }
    Value tbl = tab[10]
    int i = 0
    while (i < len(tbl)) {
        if (tbl[i][0] == name) { tbl[i] = [name, types]; tab[10] = tbl; return }
        i = i + 1
    }
    tab[10] = appendArray(tbl, [name, types])
}

func ckGetParamTypes(tab, name) {
    Value tbl = tab[10]
    int i = 0
    while (i < len(tbl)) {
        if (tbl[i][0] == name) { return tbl[i][1] }
        i = i + 1
    }
    return []
}

func ckDeclare(tab, name, kind, count) {
    if (name == "") { return }
    tab[0] = appendArray(tab[0], name)
    tab[1] = appendArray(tab[1], kind)
    tab[2] = appendArray(tab[2], count)
    tab[6] = appendArray(tab[6], [])
    if (len(tab) > 12) {
        int pos = len(tab[0]) - 1
        tab[12][name] = pos + 1
    }
}

// ckSetEnumVariants attaches a variant list to a declared enum (kind "enum").
// Rebuilds the parallel variants table (top-level writes only: nested element
// assignment is not relied upon by the self-hosted compiler).
func ckSetEnumVariants(tab, name, variants) {
    Value names = tab[0]
    Value rebuilt = []
    int i = 0
    while (i < len(names)) {
        if (names[i] == name) {
            rebuilt = appendArray(rebuilt, variants)
        } else {
            rebuilt = appendArray(rebuilt, tab[6][i])
        }
        i = i + 1
    }
    tab[6] = rebuilt
}

// ckEnumHasVariant reports whether `name` is a declared enum with variant `v`.
// Raw entries are "Name:" (unit) or "Name:payload"; match on the leading
// variant name (which is followed by ':' or is the whole entry).
func ckEnumHasVariant(tab, name, v) {
    Value names = tab[0]
    Value kinds = tab[1]
    Value vari = tab[6]
    int i = 0
    while (i < len(names)) {
        if (names[i] == name && kinds[i] == "enum") {
            Value vs = vari[i]
            int j = 0
            while (j < len(vs)) {
                Value entry = vs[j]
                if (entry == v) { return 1 }
                // entry's variant name is the longest prefix before ':'
                string prefix = v + ":"
                int pl = len(prefix)
                if (len(entry) >= pl && substr(entry, 0, pl) == prefix) { return 1 }
                j = j + 1
            }
        }
        i = i + 1
    }
    return 0
}

func ckKind(tab, name) {
    if (len(tab) <= 12) {
        // Fallback for tabs without the index (backward compatibility).
        Value names = tab[0]
        Value kinds = tab[1]
        int i = 0
        while (i < len(names)) {
            if (names[i] == name) { return kinds[i] }
            i = i + 1
        }
        return ""
    }
    Value idx = tab[12]
    int pos = idx[name]
    if (pos == 0) { return "" }
    pos = pos - 1
    Value kinds = tab[1]
    if (pos < 0 || pos >= len(kinds)) { return "" }
    return kinds[pos]
}

func ckCount(tab, name) {
    if (len(tab) <= 12) {
        Value names = tab[0]
        Value counts = tab[2]
        int i = 0
        while (i < len(names)) {
            if (names[i] == name) { return counts[i] }
            i = i + 1
        }
        return -1
    }
    Value idx = tab[12]
    int pos = idx[name]
    if (pos == 0) { return -1 }
    pos = pos - 1
    Value counts = tab[2]
    if (pos < 0 || pos >= len(counts)) { return -1 }
    return counts[pos]
}

func ckLocalHas(tab, name) {
    int locals = ckLocals(tab)
    int i = 0
    while (i < len(locals)) {
        if (locals[i] == name) {
            return 1
        }
        i = i + 1
    }
    return 0
}

func ckLocalAdd(tab, name) {
    if (name == "") { return }
    tab[4] = appendArray(tab[4], name)
}

func ckAddError(tab, code, line, msg) {
    tab[3] = appendArray(tab[3], "error[" + code + "] line " + str(line) + ": " + msg)
}

// ============================================================
// Pass 1: collect top-level declarations
// ============================================================

func collectDecls(tab, stmts) {
    int i = 0
    while (i < len(stmts)) {
        Value s = stmts[i]
        string nt = getNodeType(s)
        if (nt == "FuncDecl") {
            string name = funcName(s)
            int gp = funcGenericParams(s)
            if (name != "" && ckKind(tab, name) != "") {
                ckAddError(tab, "K107", funcLine(s), "duplicate function definition '" + name + "'")
            } else {
                ckDeclare(tab, name, "func", len(funcParams(s)))
                ckSetParamTypes(tab, name, funcParamTypes(s))
                // Phase 146: register generic function template
                if (len(gp) > 0) {
                    tab[7] = appendArray(tab[7], name)
                    tab[7] = appendArray(tab[7], s)
                }
            }
        }
        if (nt == "ConstDecl") {
            int nm = constDeclName(s)
            if (nm != "") { ckConstAdd(tab, nm) }
        }
        if (nt == "VarDecl" || nt == "LetDecl") {
            string nm = varDeclName(s)
            if (nm == "") { nm = letDeclName(s) }
            if (nm != "") { ckDeclare(tab, nm, "var", 0) }
        }
        if (nt == "KernelDecl") {
            int name = kernelName(s)
            if (name != "" && ckKind(tab, name) != "") {
                ckAddError(tab, "K107", kernelLine(s), "duplicate function definition '" + name + "'")
            } else {
                ckDeclare(tab, name, "func", len(kernelParams(s)))
            }
        }
        if (nt == "StructDecl") {
            string name = structDeclName(s)
            int gp = structDeclGenericParams(s)
            if (name != "" && ckKind(tab, name) != "") {
                ckAddError(tab, "K107", structDeclLine(s), "duplicate type definition '" + name + "'")
            } else {
                ckDeclare(tab, name, "struct", 0)
                // Phase 146: register generic struct template
                if (len(gp) > 0) {
                    tab[8] = appendArray(tab[8], name)
                    tab[8] = appendArray(tab[8], s)
                }
            }
        }
        if (nt == "EnumDecl") {
            int name = enumDeclName(s)
            if (name != "" && ckKind(tab, name) != "") {
                ckAddError(tab, "K107", enumDeclLine(s), "duplicate type definition '" + name + "'")
            } else {
                ckDeclare(tab, name, "enum", 0)
                // Phase 123: index variants so EnumName.Variant uses resolve.
                // Raw entries are "Name:" (unit) or "Name:payload".
                ckSetEnumVariants(tab, name, enumDeclVariants(s))
            }
        }
        i = i + 1
    }
}

// Pre-scan a statement list, registering every local var/let and
// loop variable so forward references resolve (mirrors the Go
// resolver's walkLocalDefs). Nested funcs and lambdas get their
// own scopes and are deliberately skipped here.

func collectLocals(tab, list) {
    int i = 0
    while (i < len(list)) {
        Value s = list[i]
        string nt = getNodeType(s)
        if (nt == "VarDecl" || nt == "LetDecl") {
            string nm = varDeclName(s)
            if (nm == "") { nm = letDeclName(s) }
            ckLocalAdd(tab, nm)
        } else if (nt == "ConstDecl") {
            int nm = constDeclName(s)
            ckLocalAdd(tab, nm)
            ckConstAdd(tab, nm)
        }
        if (nt == "ForIn") {
            ckLocalAdd(tab, forInVar(s))
            collectLocals(tab, forInBody(s))
        }
        if (nt == "Block") {
            collectLocals(tab, blockStmts(s))
        }
        if (nt == "If") {
            collectLocals(tab, ifThen(s))
            collectLocals(tab, ifElse(s))
        }
        if (nt == "While") {
            collectLocals(tab, whileBody(s))
        }
        if (nt == "For") {
            int initNode = forInit(s)
            if (initNode != []) {
                string it = getNodeType(initNode)
                if (it == "VarDecl" || it == "LetDecl") {
                    ckLocalAdd(tab, varDeclName(initNode))
                }
            }
            collectLocals(tab, forBody(s))
        }
        i = i + 1
    }
}

// ============================================================
// Pass 2: function bodies
// ============================================================

// checkTypeFirstAnno validates explicit array element types and numeric
// widths on type-first declarations (the scalar case is covered by the
// existing annotationMismatch/K112 path).
func checkTypeFirstAnno(tab, anno, val, line) {
    if (anno == "") { return }
    int alen = len(anno)
    if (alen < 2) { return }
    if (substr(anno, 0, 4) == "map[") {
        int close = 0
        int ci = 4
        while (ci < alen) {
            if (substr(anno, ci, 1) == "]") { close = ci }
            ci = ci + 1
        }
        if (close == 0) { return }
        string keyType = substr(anno, 4, close - 4)
        string valType = substr(anno, close + 1, alen - close - 1)
        if (getNodeType(val) != "MapLiteral") { return }
        Value keys = mapKeys(val)
        Value vals = mapValues(val)
        int mi = 0
        while (mi < len(keys) && mi < len(vals)) {
            string kt = primitiveTag(inferType(keys[mi]))
            string kw = primitiveTag(keyType)
            if (kt != "" && kw != "" && kt != kw) {
                ckAddError(tab, "K112", mapLitLine(val), "map key type '" + kt + "' is not compatible with declared key type '" + kw + "'")
                return
            }
            string vt = primitiveTag(inferType(vals[mi]))
            string vw = primitiveTag(valType)
            if (vt != "" && vw != "" && vt != vw) {
                ckAddError(tab, "K112", mapLitLine(val), "map value type '" + vt + "' is not compatible with declared value type '" + vw + "'")
                return
            }
            mi = mi + 1
        }
        return
    }
    if (substr(anno, alen - 2, 2) == "[]") {
        string elemType = substr(anno, 0, alen - 2)
        if (getNodeType(val) != "ArrayLiteral") { return }
        int elems = arrayElements(val)
        int i = 0
        while (i < len(elems)) {
            Value e = elems[i]
            string actual = primitiveTag(inferType(e))
            string want = primitiveTag(elemType)
            if (actual != "" && want != "" && actual != want) {
                ckAddError(tab, "K112", arrayLitLine(val), "array element has type '" + actual + "' but declared element type is '" + want + "'")
                return
            }
            if (getNodeType(e) == "IntLiteral") {
                int n = int(intLitVal(e))
                if (want == "byte" && (n < 0 || n > 255)) { ckAddError(tab, "K112", arrayLitLine(val), "integer literal outside the range of byte"); return }
                if (want == "short" && (n < -32768 || n > 32767)) { ckAddError(tab, "K112", arrayLitLine(val), "integer literal outside the range of short"); return }
                if (want == "char" && (n < 0 || n > 65535)) { ckAddError(tab, "K112", arrayLitLine(val), "integer literal outside the range of char"); return }
            }
            i = i + 1
        }
    }
}

func checkFuncDecl(tab, node, inherit) {
    // Phase 133 UAF fix: `saved` aliases the caller's locals array, and
    // appendArray may REALLOCATE on append — so the caller's buffer must
    // never be appended to while `saved` is live. Always reset to a fresh
    // array first; with inherit == 1 the outer names are COPIED in (reads
    // only), which is use-after-free safe. Skipping the reset (the first
    // attempt) restored a dangling buffer and segfaulted.
    // Nested functions and let-bound lambdas inherit the enclosing scope
    // (mirrors the Go resolver) so captures resolve instead of K101/K102.
    // Only top-level declarations skip the copy (their lets must not leak).
    int saved = ckLocals(tab)
    tab[4] = []
    tab[11] = []    if (inherit == 1) {
        int si = 0
        while (si < len(saved)) {
            ckLocalAdd(tab, saved[si])
            si = si + 1
        }
    }
    Value params = funcParams(node)
    int i = 0
    while (i < len(params)) {
        ckLocalAdd(tab, params[i])
        ckParamAdd(tab, params[i])
        i = i + 1
    }
    collectLocals(tab, funcBody(node))
    int rtype = tfFuncReturnType(node)
    if (rtype != "") {
        string want = primitiveTag(rtype)
        int ri = 0
        while (ri < len(funcBody(node))) {
            Value rs = funcBody(node)[ri]
            if (getNodeType(rs) == "Return" && want != "") {
                string actual = primitiveTag(inferType(retVal(rs)))
                if (actual != "" && actual != want) {
                    ckAddError(tab, "K112", retLine(rs), "return type '" + actual + "' is not compatible with declared return type '" + want + "'")
                }
            }
            ri = ri + 1
        }
    }
    checkStmts(tab, funcBody(node), 0)
    // Phase 133: reject returns of closures capturing locals (K114).
    ckCheckEscapeUnit(tab, funcBody(node))
    tab[4] = saved
}

func checkKernelDecl(tab, node) {
checkFuncDecl(tab, node, 0)
}

func checkStmts(tab, list, loop) {
    int i = 0
    while (i < len(list)) {
        checkStmt(tab, list[i], loop)
        i = i + 1
    }
}

// LH-2: check one match arm's body with its pattern binding in scope.
//
// Before this, the arm body was checked with the binding absent from the
// locals table, so every reference to it was reported as K102 undefined
// identifier -- even though the code generator already lowered the binding
// correctly (codegen.kark emits `Value <name> = <payload>;` inside the arm's
// own block, exactly as the Go engine does). The defect was purely semantic.
//
// The binding is visible inside the arm and does NOT escape it: the enclosing
// locals are copied, the binding added, the body checked, and the original
// locals restored. That gives an arm-local scope without introducing the
// push/pop machinery the checker's flat locals array does not have, and it
// keeps separate arms independent (each save/restore is its own scope).
//
// Only the pattern kinds that actually declare a name are added, mirroring
// the Go generator: Some/Ok/Err carry a payload name and `x => ...` binds the
// matched value itself. enum_variant carries "Enum.Variant" as a *pattern*,
// never as a variable; literal and wildcard bind nothing.
func ckCheckArmBody(tab, arm, loop) {
    int pt = armPatternType(arm)
    int b = armBinding(arm)
    int binds = 0
    if (b != "" && b != "_") {
        if (pt == "Some" || pt == "Ok" || pt == "Err" || pt == "binding") { binds = 1 }
    }

    int saved = ckLocals(tab)
    // Reset tab[4] to a FRESH array before copying. ckLocalAdd appends to
    // tab[4], and `saved` still references the old array -- copying without
    // this reset appends into the very array being iterated, so len(saved)
    // grows on every step and the loop never ends. Observed directly: kcc died
    // with heap corruption (0xC0000374) and an access violation (0xC0000005) on
    // ANY program containing a match. This is the same discipline the function
    // scope above uses.
    tab[4] = []
    tab[11] = []    int i = 0
    while (i < len(saved)) {
        ckLocalAdd(tab, saved[i])
        i = i + 1
    }
    if (binds == 1) { ckLocalAdd(tab, b) }

    // Dispatch on the arm body's node shape, mirroring emitMatchArmBody so the
    // checker and the lowering agree on which body shapes exist.
    //
    // Previously only Block was checked, but parseMatchExpr wraps a bare arm
    // body (`Ok(n) => n + 1`) in makeExprStmt, so identifiers inside bare arm
    // expressions bypassed checking entirely: K102 is emitted from exactly one
    // place -- checkExpr's identifier case -- so a skipped body could never
    // report it. A block body was checked and a bare body was not, so two
    // spellings of the same arm were treated differently.
    //
    // ExprStmt and Print both reach checkExpr through checkStmt: its ExprStmt
    // case ends in checkExpr(tab, e, loop), and its Print case calls
    // checkExpr(tab, printVal(s), loop). So both route through checkStmt.
    //
    // The taint and return walkers deliberately keep their own Block-only
    // gate: an expression arm can neither declare a `let` nor contain a
    // `return`, so for those two passes the restriction is correct. Only
    // identifier resolution needs the wider set of shapes.
    int body = armBody(arm)
    string bt = getNodeType(body)
    if (bt == "Block") { checkStmts(tab, blockStmts(body), loop) }
    else if (bt == "ExprStmt" || bt == "Print") { checkStmt(tab, body, loop) }

    tab[4] = saved
}

func checkStmt(tab, s, loop) {
    // Empty nodes arrive from constructs the self-hosted parser cannot fully
    // realize (e.g. a bare `return` yields an empty value node). They carry no
    // semantics to check, so skip them instead of dereferencing node[kind].
    if (len(s) < 1) { return }
    string nt = getNodeType(s)

    if (nt == "FuncDecl") {
        checkFuncDecl(tab, s, 1)
        return
    }
    if (nt == "KernelDecl") {
        checkKernelDecl(tab, s)
        return
    }

    if (nt == "VarDecl" || nt == "LetDecl") {
        string nm = varDeclName(s)
        int anno = varDeclType(s)
        Value val = varDeclValue(s)
        int line = varDeclLine(s)
        if (nt == "LetDecl") {
            nm = letDeclName(s)
            anno = letDeclType(s)
            val = letDeclValue(s)
            line = letDeclLine(s)
        }
        ckLocalAdd(tab, nm)
        checkTypeFirstAnno(tab, anno, val, line)
        if (annotationMismatch(anno, val) == 1) {
            ckAddError(tab, "K112", line, "variable '" + nm + "' declared as type '" + primitiveTag(anno) + "' but initialized with a " + typeDescription(inferType(val)))
        }
        checkExpr(tab, val, loop)
        return
    }

    if (nt == "ConstDecl") {
        int nm = constDeclName(s)
        int anno = constDeclType(s)
        int val = constDeclValue(s)
        int line = constDeclLine(s)
        ckLocalAdd(tab, nm)
        ckConstAdd(tab, nm)
        checkTypeFirstAnno(tab, anno, val, line)
        if (annotationMismatch(anno, val) == 1) {
            ckAddError(tab, "K112", line, "variable '" + nm + "' declared as type '" + primitiveTag(anno) + "' but initialized with a " + typeDescription(inferType(val)))
        }
        checkExpr(tab, val, loop)
        return
    }

    if (nt == "Return") {
        checkExpr(tab, retVal(s), loop)
        // Phase 1.2 (v1.3.0): lifetime analysis.
        //
        // The self-hosted parser does not produce a distinct Borrow node for
        // `&x` (it lexes `&` as bitwise-AND), so borrow/lifetime checks that
        // the Go borrow checker performs cannot be replicated here at the
        // same fidelity. The Go side (pkg/sema/borrow_checker.go,
        // checkReturnLifetime) is the primary authority and rejects dangling
        // references on return. This checker remains conservative.
        return
    }
    if (nt == "Print") {
        checkExpr(tab, printVal(s), loop)
        return
    }

    if (nt == "ExprStmt") {
        int e = exprStmtExpr(s)
        // Phase 51 semantics: a bare `x = v` statement implicitly declares x.
        if (getNodeType(e) == "BinaryExpr" && binaryOp(e) == "=") {
            int lhs = binaryLeft(e)
            if (getNodeType(lhs) == "Ident") {
                string nm = identName(lhs)
                if (nm != "" && ckConstHas(tab, nm) == 1) {
                    ckAddError(tab, "K113", identLine(lhs), "cannot reassign constant '" + nm + "'")
                }
                if (nm != "" && ckLocalHas(tab, nm) == 0 && ckKind(tab, nm) == "" && isCheckerBuiltin(nm) == 0) {
                    ckLocalAdd(tab, nm)
                }
            }
        }
        checkExpr(tab, e, loop)
        return
    }

    if (nt == "If") {
        checkExpr(tab, ifCondition(s), loop)
        checkStmts(tab, ifThen(s), loop)
        checkStmts(tab, ifElse(s), loop)
        return
    }

    if (nt == "While") {
        checkExpr(tab, whileCondition(s), loop)
        checkStmts(tab, whileBody(s), loop + 1)
        return
    }

    if (nt == "For") {
        int initNode = forInit(s)
        if (initNode != []) {
            string it = getNodeType(initNode)
            if (it == "VarDecl" || it == "LetDecl") {
                string iname = varDeclName(initNode)
                int ianno = varDeclType(initNode)
                Value ival = varDeclValue(initNode)
                int iline = varDeclLine(initNode)
                if (it == "LetDecl") {
                    iname = letDeclName(initNode)
                    ianno = letDeclType(initNode)
                    ival = letDeclValue(initNode)
                    iline = letDeclLine(initNode)
                }
                ckLocalAdd(tab, iname)
                if (annotationMismatch(ianno, ival) == 1) {
                    ckAddError(tab, "K112", iline, "variable '" + iname + "' declared as type '" + primitiveTag(ianno) + "' but initialized with a " + typeDescription(inferType(ival)))
                }
                checkExpr(tab, ival, loop)
            } else {
                checkExpr(tab, initNode, loop)
            }
        }
        checkExpr(tab, forCondition(s), loop)
        if (forPost(s) != []) { checkExpr(tab, forPost(s), loop) }
        checkStmts(tab, forBody(s), loop + 1)
        return
    }

    if (nt == "ForIn") {
        checkExpr(tab, forInIter(s), loop)
        checkStmts(tab, forInBody(s), loop + 1)
        return
    }

    if (nt == "Break") {
        if (loop == 0) { ckAddError(tab, "K108", breakLine(s), "'break' outside of a loop") }
        return
    }
    if (nt == "Continue") {
        if (loop == 0) { ckAddError(tab, "K108", continueLine(s), "'continue' outside of a loop") }
        return
    }

    if (nt == "Block") {
        checkStmts(tab, blockStmts(s), loop)
        return
    }

    if (nt == "Match") {
        checkExpr(tab, matchValue(s), loop)
        // Phase 123: validate enum_variant arms against declared enums and
        // walk each arm's pattern value and body. Binding form is "Enum.Variant".
        Value arms = matchArms(s)
        int a = 0
        while (a < len(arms)) {
            Value arm = arms[a]
            if (armPatternType(arm) == "enum_variant") {
                int b = armBinding(arm)
                int sep = strFindChar(b, ".")
                if (sep >= 0) {
                    string en = substr(b, 0, sep)
                    string vr = substr(b, sep + 1, len(b) - sep - 1)
                    if (ckKind(tab, en) == "") {
                        ckAddError(tab, "K106", armLine(arm), "use of undefined enum type '" + en + "' in match arm")
                    } else if (ckEnumHasVariant(tab, en, vr) == 0) {
                        ckAddError(tab, "K113", armLine(arm), "unknown enum variant '" + en + "." + vr + "' in match arm")
                    }
                }
            }
            if (armPatternValue(arm) != []) { checkExpr(tab, armPatternValue(arm), loop) }
            ckCheckArmBody(tab, arm, loop)
            a = a + 1
        }
        return
    }
}

// ============================================================
// Expression walking
// ============================================================

func checkExpr(tab, e, loop) {
    // Same tolerance as checkStmt: an empty expression node (bare `return`,
    // unparseable primary) has nothing to check.
    if (len(e) < 1) { return }
    string nt = getNodeType(e)

    if (nt == "Ident") {
        checkIdent(tab, e)
        return
    }

    if (nt == "Call") {
        checkCall(tab, e, loop)
        return
    }

    // Phase 133: a computed callee has no static name to resolve — arity is
    // enforced at runtime by the dispatch wrapper. Resolve the callee
    // expression and the arguments for undefined names.
    if (nt == "IndirectCall") {
        checkExpr(tab, indirectTarget(e), loop)
        int iargs = indirectArgs(e)
        int i = 0
        while (i < len(iargs)) {
            checkExpr(tab, iargs[i], loop)
            i = i + 1
        }
        return
    }

    // Phase 133: these arms were dead ("Binary"/"Unary" never equal the
    // getNodeType spellings "BinaryExpr"/"UnaryExpr"), so binary operands
    // were never name-checked — diverging from the Go resolver. Fixed.
    if (nt == "BinaryExpr") {
        checkExpr(tab, binaryLeft(e), loop)
        checkExpr(tab, binaryRight(e), loop)
        return
    }

    if (nt == "UnaryExpr") {
        checkExpr(tab, unaryOperand(e), loop)
        return
    }

    if (nt == "Member") {
        checkExpr(tab, dotLeft(e), loop)
        return
    }

    // Phase 123: EnumName.Variant[(payload)] construction. Gate on the enum
    // type existing and the variant being a member; payloads are value reads.
    if (nt == "Match") {
        checkExpr(tab, matchValue(e), loop)
        Value arms = matchArms(e)
        int a = 0
        while (a < len(arms)) {
            Value arm = arms[a]
            if (armPatternType(arm) == "enum_variant") {
                int b = armBinding(arm)
                int sep = strFindChar(b, ".")
                if (sep >= 0) {
                    string en = substr(b, 0, sep)
                    string vr = substr(b, sep + 1, len(b) - sep - 1)
                    if (ckKind(tab, en) == "") {
                        ckAddError(tab, "K106", armLine(arm), "use of undefined enum type '" + en + "' in match arm")
                    } else if (ckEnumHasVariant(tab, en, vr) == 0) {
                        ckAddError(tab, "K113", armLine(arm), "unknown enum variant '" + en + "." + vr + "' in match arm")
                    }
                }
            }
            if (armPatternValue(arm) != []) { checkExpr(tab, armPatternValue(arm), loop) }
            ckCheckArmBody(tab, arm, loop)
            a = a + 1
        }
        return
    }

    if (nt == "EnumVariantExpr") {
        int en = enumVariantExprEnumName(e)
        if (en != "") {
            if (ckKind(tab, en) == "") {
                ckAddError(tab, "K106", enumVariantExprLine(e), "use of undefined enum type '" + en + "'")
            } else if (ckEnumHasVariant(tab, en, enumVariantExprVariant(e)) == 0) {
                ckAddError(tab, "K113", enumVariantExprLine(e), "unknown enum variant '" + en + "." + enumVariantExprVariant(e) + "'")
            }
        }
        int val = enumVariantExprValue(e)
        if (val != []) { checkExpr(tab, val, loop) }
        return
    }

    if (nt == "Index") {
        checkExpr(tab, indexLeft(e), loop)
        checkExpr(tab, indexExpr(e), loop)
        return
    }

    if (nt == "Slice") {
        checkExpr(tab, sliceLeft(e), loop)
        if (sliceStart(e) != []) { checkExpr(tab, sliceStart(e), loop) }
        if (sliceEnd(e) != []) { checkExpr(tab, sliceEnd(e), loop) }
        return
    }

    // Phase 121: a let-bound lambda arrives as a FuncDecl value; bind its
    // params and check its body with the enclosing scope inherited
    // (Phase 133: captures must resolve like the Go resolver allows).
    if (nt == "FuncDecl") {
        checkFuncDecl(tab, e, 1)
        return
    }

    // Phase 121: alloc(T, n) / free(x) operands are plain expressions.
    if (nt == "Alloc") {
        checkExpr(tab, allocCount(e), loop)
        return
    }
    if (nt == "Free") {
        checkExpr(tab, freePtr(e), loop)
        return
    }

    if (nt == "ArrayLiteral") {
        int elems = arrayElements(e)
        int i = 0
        while (i < len(elems)) {
            checkExpr(tab, elems[i], loop)
            i = i + 1
        }
        return
    }

    if (nt == "MapLiteral") {
        // Map keys are conservatively treated as labels (mirrors the Go
        // resolver); only values are value-position reads.
        int vals = mapValues(e)
        int i = 0
        while (i < len(vals)) {
            checkExpr(tab, vals[i], loop)
            i = i + 1
        }
        return
    }

    if (nt == "StructLiteral") {
        int tn = structLitName(e)
        if (tn != "") {
            int k = ckKind(tab, tn)
            if (k != "struct" && k != "enum") {
                ckAddError(tab, "K106", structLitLine(e), "use of undefined type '" + tn + "' in struct literal")
            }
        }
        int fields = structLitFields(e)
        int i = 0
        while (i < len(fields)) {
            Value f = fields[i]
            // Phase 133: the tag test must read "BinaryExpr" (getNodeType
            // spelling). The old "Binary" never matched, so fields fell
            // into the else below and — once checkExpr learned BinaryExpr
            // — their key identifiers were misread as value reads (K102
            // on every struct field). Values only, like the Go resolver.
            if (getNodeType(f) == "BinaryExpr" && binaryOp(f) == "=") {
                checkExpr(tab, binaryRight(f), loop)
            } else {
                checkExpr(tab, f, loop)
            }
            i = i + 1
        }
        return
    }

    if (nt == "Lambda") {
        int outer = ckLocals(tab)
        tab[4] = []
    tab[11] = []        int j = 0
        while (j < len(outer)) {
            ckLocalAdd(tab, outer[j])
            j = j + 1
        }
        int params = lambdaParams(e)
        int k = 0
        while (k < len(params)) {
            ckLocalAdd(tab, params[k])
            k = k + 1
        }
        collectLocals(tab, lambdaBody(e))
        checkStmts(tab, lambdaBody(e), loop)
        // Phase 133: a bare lambda body is its own escape unit.
        ckCheckEscapeUnit(tab, lambdaBody(e))
        tab[4] = outer
        return
    }

    if (nt == "Borrow") {
        checkExpr(tab, borrowOp(e), loop)
        return
    }
    if (nt == "Move") {
        checkExpr(tab, borrowOp(e), loop)
        return
    }
    if (nt == "ResultOk" || nt == "ResultErr" || nt == "OptionSome" || nt == "OptionNone") {
        return
    }
    if (nt == "Propagate") {
        checkExpr(tab, borrowOp(e), loop)
        return
    }

    // Phase 137: spawn(fn, args...) — the target is a name reference, not
    // a value read (mirrors the Go resolver, which never K102s it);
    // argument expressions resolve normally.
    if (nt == "Spawn") {
        int sargs = spawnArgs(e)
        int i = 0
        while (i < len(sargs)) {
            checkExpr(tab, sargs[i], loop)
            i = i + 1
        }
        return
    }

    // Phase 137: receive(ch) — the channel operand resolves normally.
    if (nt == "Receive") {
        checkExpr(tab, chRecvChannel(e), loop)
        return
    }
}

// ============================================================
// Leaves
// ============================================================

func checkIdent(tab, e) {
    string name = identName(e)
    if (name == "") { return }
    if (name == "true" || name == "false" || name == "nil" || name == "THIS" || name == "self") { return }

    if (ckLocalHas(tab, name) == 1) { return }
    if (ckConstHas(tab, name) == 1) { return }
    if (ckKind(tab, name) != "") { return }
    if (isCheckerBuiltin(name) == 1) { return }
    ckAddError(tab, "K102", identLine(e), "undefined identifier '" + name + "'")
}

func checkCall(tab, e, loop) {
    string name = callFunc(e)
    Value args = callArgs(e)
    int argc = len(args)

    // Always inspect arguments (mirrors the Go resolver's recursion).
    int a = 0
    while (a < len(args)) {
        checkExpr(tab, args[a], loop)
        a = a + 1
    }

    // Method calls (obj.method / module.name) are outside the flat-name model.
    if (contains(name, ".") == 1) { return }

    if (isCheckerBuiltin(name) == 1) {
        int want = checkerBuiltinArity(name)
        if (want >= 0 && want != argc) {
            ckAddError(tab, "K104", callLine(e), "builtin '" + name + "' expects " + str(want) + " arguments but got " + str(argc))
        }
        // P0.1/P0.2 parity: actor() takes a quoted handler name. Reject the
        // unquoted form here (the Go resolver does the same) rather than only
        // at runtime through karkain_conc_invalid_actor().
        if (name == "actor") {
            if (argc == 0) {
                ckAddError(tab, "K104", callLine(e), "actor() requires a quoted handler function name")
            } else if (nodeType(args[0]) != NODE_STRING_LIT()) {
                ckAddError(tab, "K104", callLine(e), "actor() handler must be a quoted function name, e.g. actor(\"handler\", state)")
            }
        }
        return
    }

    if (ckLocalHas(tab, name) == 1) { return }

    int kind = ckKind(tab, name)
    if (kind != "") {
        if (kind == "func" || kind == "kernel") {
            int want = ckCount(tab, name)
            if (want >= 0 && want != argc) {
                ckAddError(tab, "K103", callLine(e), "function '" + name + "' expects " + str(want) + " arguments but got " + str(argc))
            }
            Value pts = ckGetParamTypes(tab, name)
            int pi = 0
            while (pi < len(pts) && pi < argc) {
                if (pts[pi] != "") {
                    string wantTag = primitiveTag(pts[pi])
                    string gotTag = primitiveTag(inferType(args[pi]))
                    if (wantTag != "" && gotTag != "" && wantTag != gotTag) {
                        ckAddError(tab, "K112", callLine(e), "argument " + str(pi + 1) + " of '" + name + "' has type '" + gotTag + "', expected '" + wantTag + "'")
                    }
                }
                pi = pi + 1
            }
        } else {
            ckAddError(tab, "K109", callLine(e), "cannot call type '" + name + "' as a function")
        }
        return
    }

    ckAddError(tab, "K101", callLine(e), "undefined function '" + name + "'")
}

// ============================================================
// Phase 133: escaping-capture rejection (mirrors the Go resolver's
// checkEscapeReturns). Captures are by-ref into the defining frame, so
// returning a closure that captures function-local state would dangle.
// Such returns are rejected with K114 (exit 3 on check/build/run);
// non-capturing closures (NULL env) still return fine. Calls have unknown
// provenance and are allowed (documented dynamic gap, same as Go).
// ============================================================

func ckTaintedHas(tainted, name) {
    int i = 0
    while (i < len(tainted)) {
        if (tainted[i] == name) { return 1 }
        i = i + 1
    }
    return 0
}

func ckTaintedAdd(tainted, name) {
    if (ckTaintedHas(tainted, name) == 0) { tainted = appendArray(tainted, name) }
    return tainted
}

// ckValueCaptures reports whether a value transitively closes over
// function-local state (1) or not (0).
func ckValueCaptures(e, tainted) {
    if (len(e) < 1) { return 0 }
    string nt = getNodeType(e)
    if (nt == "FuncDecl") {
        if (len(funcCaptures(e)) > 0) { return 1 }
        return 0
    }
    if (nt == "Lambda") {
        int caps = computeCaptures(lambdaParams(e), lambdaBody(e))
        if (len(caps) > 0) { return 1 }
        return 0
    }
    if (nt == "Ident") { return ckTaintedHas(tainted, identName(e)) }
    if (nt == "ArrayLiteral") {
        int elems = arrayElements(e)
        int i = 0
        while (i < len(elems)) {
            if (ckValueCaptures(elems[i], tainted) == 1) { return 1 }
            i = i + 1
        }
        return 0
    }
    if (nt == "MapLiteral") {
        int ks = mapKeys(e)
        int i = 0
        while (i < len(ks)) {
            if (ckValueCaptures(ks[i], tainted) == 1) { return 1 }
            i = i + 1
        }
        int vs = mapValues(e)
        int j = 0
        while (j < len(vs)) {
            if (ckValueCaptures(vs[j], tainted) == 1) { return 1 }
            j = j + 1
        }
        return 0
    }
    if (nt == "StructLiteral") {
        int fields = structLitFields(e)
        int i = 0
        while (i < len(fields)) {
            Value f = fields[i]
            if (getNodeType(f) == "BinaryExpr") {
                if (ckValueCaptures(binaryRight(f), tainted) == 1) { return 1 }
            } else {
                if (ckValueCaptures(f, tainted) == 1) { return 1 }
            }
            i = i + 1
        }
        return 0
    }
    if (nt == "Index") {
        if (ckValueCaptures(indexLeft(e), tainted) == 1) { return 1 }
        return ckValueCaptures(indexExpr(e), tainted)
    }
    if (nt == "Slice") {
        return ckValueCaptures(sliceLeft(e), tainted)
    }
    if (nt == "Member") {
        return ckValueCaptures(dotLeft(e), tainted)
    }
    // NOTE: getNodeType spells these "BinaryExpr"/"UnaryExpr" (not
    // "Binary"/"Unary" — the latter would be a dead branch (this file's
    // StructLiteral arm and checkExpr's arms had exactly that defect;
    // both fixed in Phase 133).
    if (nt == "BinaryExpr") {
        if (ckValueCaptures(binaryLeft(e), tainted) == 1) { return 1 }
        return ckValueCaptures(binaryRight(e), tainted)
    }
    if (nt == "UnaryExpr") {
        return ckValueCaptures(unaryOperand(e), tainted)
    }
    if (nt == "Match") {
        if (ckValueCaptures(matchValue(e), tainted) == 1) { return 1 }
        Value arms = matchArms(e)
        int i = 0
        while (i < len(arms)) {
            if (ckValueCaptures(armBody(arms[i]), tainted) == 1) { return 1 }
            i = i + 1
        }
        return 0
    }
    return 0
}

// ckCollectTainted marks let/var/const names whose values close over
// function-local state. Blocks share the unit; nested function bodies are
// separate units (checked via checkFuncDecl / the Lambda branch).
func ckCollectTainted(stmts, tainted) {
    int i = 0
    while (i < len(stmts)) {
        Value s = stmts[i]
        if (len(s) < 1) { i = i + 1 }
        else {
            string nt = getNodeType(s)
            if (nt == "VarDecl") {
                if (ckValueCaptures(varDeclValue(s), tainted) == 1) {
                    tainted = ckTaintedAdd(tainted, varDeclName(s))
                }
            } else if (nt == "LetDecl") {
                if (ckValueCaptures(letDeclValue(s), tainted) == 1) {
                    tainted = ckTaintedAdd(tainted, letDeclName(s))
                }
            } else if (nt == "ConstDecl") {
                if (ckValueCaptures(constDeclValue(s), tainted) == 1) {
                    tainted = ckTaintedAdd(tainted, constDeclName(s))
                }
            } else if (nt == "Block") {
                tainted = ckCollectTainted(blockStmts(s), tainted)
            } else if (nt == "If") {
                tainted = ckCollectTainted(ifThen(s), tainted)
                tainted = ckCollectTainted(ifElse(s), tainted)
            } else if (nt == "While") {
                tainted = ckCollectTainted(whileBody(s), tainted)
            } else if (nt == "For") {
                tainted = ckCollectTainted(forBody(s), tainted)
            } else if (nt == "ForIn") {
                tainted = ckCollectTainted(forInBody(s), tainted)
            } else if (nt == "ExprStmt") {
                // A match in statement position may declare lets inside
                // arm blocks; collect those (expression arms declare nothing).
                int me = exprStmtExpr(s)
                if (getNodeType(me) == "Match") {
                    Value arms = matchArms(me)
                    int a = 0
                    while (a < len(arms)) {
                        int ab = armBody(arms[a])
                        if (getNodeType(ab) == "Block") {
                            tainted = ckCollectTainted(blockStmts(ab), tainted)
                        }
                        a = a + 1
                    }
                }
            }
            i = i + 1
        }
    }
    return tainted
}

// ckCheckEscapeUnit checks one function-like body: fixpoint-taint every
// local binding, then reject returns of tainted values.
func ckCheckEscapeUnit(tab, stmts) {
    Value tainted = []
    int k = 0
    while (k < 8) {
        int n0 = len(tainted)
        tainted = ckCollectTainted(stmts, tainted)
        if (len(tainted) == n0) { break }
        k = k + 1
    }
    ckCheckReturns(tab, stmts, tainted)
}

// ckCheckReturns rejects `return` of tainted values and descends into
// blocks (same frame). Nested named functions are skipped (own units via
// checkFuncDecl); bare lambdas are hooked at checkExpr's Lambda branch.
func ckCheckReturns(tab, stmts, tainted) {
    int i = 0
    while (i < len(stmts)) {
        Value s = stmts[i]
        if (len(s) < 1) { i = i + 1 }
        else {
            string nt = getNodeType(s)
            if (nt == "Return") {
                if (ckValueCaptures(retVal(s), tainted) == 1) {
                    ckAddError(tab, "K114", retLine(s), "cannot return closure capturing function-local state (captures are by-ref into the dying frame)")
                }
            } else if (nt == "Block") {
                ckCheckReturns(tab, blockStmts(s), tainted)
            } else if (nt == "If") {
                ckCheckReturns(tab, ifThen(s), tainted)
                ckCheckReturns(tab, ifElse(s), tainted)
            } else if (nt == "While") {
                ckCheckReturns(tab, whileBody(s), tainted)
            } else if (nt == "For") {
                ckCheckReturns(tab, forBody(s), tainted)
            } else if (nt == "ForIn") {
                ckCheckReturns(tab, forInBody(s), tainted)
            } else if (nt == "ExprStmt") {
                // A match in statement position may return directly from
                // an arm block; check those (bare-expression arms hold no
                // returns by grammar).
                int me = exprStmtExpr(s)
                if (getNodeType(me) == "Match") {
                    Value arms = matchArms(me)
                    int a = 0
                    while (a < len(arms)) {
                        int ab = armBody(arms[a])
                        if (getNodeType(ab) == "Block") {
                            ckCheckReturns(tab, blockStmts(ab), tainted)
                        }
                        a = a + 1
                    }
                }
            }
            i = i + 1
        }
    }
}

// ============================================================
// Phase 146C: Monomorphization (kcc Generics v1 parity)
//
// Mirrors pkg/sema/monomorph.go exactly:
//   - Collects generic FuncDecl/StructDecl templates (nodes carrying
//     non-empty genericParams).
//   - Fixpoint worklist over the (growing) statements array; appended
//     specializations carry no genericParams, so their nested generic
//     calls instantiate on later iterations.
//   - Call: `f[T](args)` with template head instantiates and renames to
//     the mangled spec name; non-template head demotes back to the
//     Phase-133 index-then-call lowering (`ops[idx](5)`); bare template
//     calls error K115 "requires explicit type arguments".
//   - StructLiteral: `Point[T]{...}` instantiates the struct template
//     (fields are "name:type" strings, substituted), renames the type
//     name, and clears the typeArgs slot; non-template head errors K115
//     "is not defined".
//   - Arity mismatch errors K115 "expects N type argument(s), got M".
//   - 2+ type args on a non-generic call head error K115 (the Go matrix
//     demotion has no kcc AST/codegen representation).
//   - The pass is idempotent: a re-run finds no TypeArgs left and every
//     specialization name already present.
// ============================================================

func monoGpName(gp) {
    // Generic params parse as "T" or "T:Constraint"; the constraint is
    // stored but unchecked in v1, so name matching strips it.
    int ci = strFindChar(gp, ":")
    if (ci >= 0) { return substr(gp, 0, ci) }
    return gp
}

func monoCreateCtx() {
    Value ctx = []
    ctx = appendArray(ctx, [])  // 0: generic FuncDecl templates
    ctx = appendArray(ctx, [])  // 1: generic StructDecl templates
    ctx = appendArray(ctx, [])  // 2: pending specializations (drained to stmts)
    ctx = appendArray(ctx, [])  // 3: emitted specialization names (dedup)
    ctx = appendArray(ctx, [])  // 4: K115 error messages
    return ctx
}

func monoAddError(ctx, line, msg) {
    ctx[4] = appendArray(ctx[4], "error[K115] line " + str(line) + ": " + msg)
}

func monoCollect(ctx, stmts) {
    int i = 0
    while (i < len(stmts)) {
        Value s = stmts[i]
        string nt = getNodeType(s)
        if (nt == "FuncDecl" && len(funcGenericParams(s)) > 0) {
            ctx[0] = appendArray(ctx[0], s)
        }
        if (nt == "StructDecl" && len(structDeclGenericParams(s)) > 0) {
            ctx[1] = appendArray(ctx[1], s)
        }
        i = i + 1
    }
}

func monoFindFuncTmpl(ctx, name) {
    Value list = ctx[0]
    int i = 0
    while (i < len(list)) {
        if (funcName(list[i]) == name) { return list[i] }
        i = i + 1
    }
    return []
}

func monoFindStructTmpl(ctx, name) {
    Value list = ctx[1]
    int i = 0
    while (i < len(list)) {
        if (structDeclName(list[i]) == name) { return list[i] }
        i = i + 1
    }
    return []
}

func monoMangle(base, targs) {
    let result = base
    int i = 0
    while (i < len(targs)) {
        result = result + "_" + targs[i]
        i = i + 1
    }
    return result
}

func monoFuncPublic(n) {
    // funcPublic returns a bool/string mix; read the raw slot instead.
    string s = ""
    if (len(n) > 8) { s = n[8] }
    return s == "1"
}

func monoSubstTypeStr(typeStr, gps, targs) {
    int i = 0
    while (i < len(gps)) {
        if (monoGpName(gps[i]) == typeStr) { return targs[i] }
        i = i + 1
    }
    if (len(typeStr) > 1 && hasPrefix(typeStr, "*")) {
        return "*" + monoSubstTypeStr(substr(typeStr, 1, len(typeStr) - 1), gps, targs)
    }
    if (len(typeStr) > 2 && hasPrefix(typeStr, "[]")) {
        return "[]" + monoSubstTypeStr(substr(typeStr, 2, len(typeStr) - 2), gps, targs)
    }

    return typeStr
}

func monoSubstTarg(t, gps, targs) {
    int i = 0
    while (i < len(gps)) {
        if (monoGpName(gps[i]) == t) { return targs[i] }
        i = i + 1
    }
    return t
}

// monoSubstNode clones `node` with generic type parameters (gps) mapped to
// concrete type arguments (targs). Mirrors the Go substituteNode: every
// type-carrying position goes through monoSubstTypeStr; call/struct-literal
// TypeArgs are conjugated (f[T] -> f[int]) so the fixpoint instantiates
// nested generics. Unhandled node kinds share the original (read-only —
// never mutated by the rewriter afterward), exactly like Go's default.
func monoSubstNode(node, gps, targs) {
    string nt = getNodeType(node)
    if (nt == "VarDecl") {
        Value v = varDeclValue(node)
        Value nv = []
        if (v != []) { nv = monoSubstNode(v, gps, targs) }
        return makeVarDecl(varDeclName(node), nv, monoSubstTypeStr(varDeclType(node), gps, targs), varDeclLine(node))
    }
    if (nt == "LetDecl") {
        int v = letDeclValue(node)
        Value nv = []
        if (v != []) { nv = monoSubstNode(v, gps, targs) }
        return makeLetDecl(letDeclName(node), nv, monoSubstTypeStr(letDeclType(node), gps, targs), letDeclLine(node))
    }
    if (nt == "ConstDecl") {
        int v = constDeclValue(node)
        Value nv = []
        if (v != []) { nv = monoSubstNode(v, gps, targs) }
        return makeConstDecl(constDeclName(node), nv, monoSubstTypeStr(constDeclType(node), gps, targs), constDeclLine(node))
    }
    if (nt == "BinaryExpr") {
        return makeBinary(binaryOp(node), monoSubstNode(binaryLeft(node), gps, targs), monoSubstNode(binaryRight(node), gps, targs), binaryLine(node))
    }
    if (nt == "UnaryExpr") {
        return makeUnary(unaryOp(node), monoSubstNode(unaryOperand(node), gps, targs), unaryLine(node))
    }
    if (nt == "Index") {
        return makeIndex(monoSubstNode(indexLeft(node), gps, targs), monoSubstNode(indexExpr(node), gps, targs), indexLine(node))
    }
    if (nt == "ExprStmt") {
        return makeExprStmt(monoSubstNode(exprStmtExpr(node), gps, targs), exprStmtLine(node))
    }
    if (nt == "Return") {
        int v = retVal(node)
        Value nv = []
        if (v != []) { nv = monoSubstNode(v, gps, targs) }
        return makeReturn(nv, retLine(node))
    }
    if (nt == "If") {
        return makeIf(monoSubstNode(ifCond(node), gps, targs), monoSubstStmts(ifCons(node), gps, targs), monoSubstStmts(ifAlt(node), gps, targs), ifLine(node))
    }
    if (nt == "While") {
        return makeWhile(monoSubstNode(whileCond(node), gps, targs), monoSubstStmts(whileBody(node), gps, targs), whileLine(node))
    }
    if (nt == "For") {
        Value ninit = []
        Value ncond = []
        Value npost = []
        if (forInit(node) != []) { ninit = monoSubstNode(forInit(node), gps, targs) }
        if (forCond(node) != []) { ncond = monoSubstNode(forCond(node), gps, targs) }
        if (forPost(node) != []) { npost = monoSubstNode(forPost(node), gps, targs) }
        return makeFor(ninit, ncond, npost, monoSubstStmts(forBody(node), gps, targs), forLine(node))
    }
    if (nt == "ForIn") {
        return makeForIn(forInVar(node), monoSubstNode(forInIter(node), gps, targs), monoSubstStmts(forInBody(node), gps, targs), forInLine(node))
    }
    if (nt == "Print") {
        return makePrint(monoSubstNode(printVal(node), gps, targs), printLine(node))
    }
    if (nt == "Call") {
        int call = makeCall(callFunc(node), monoSubstStmts(callArgs(node), gps, targs), callLine(node), callCol(node))
        Value ta = callTypeArgs(node)
        Value nta = []
        int i = 0
        while (i < len(ta)) {
            nta = appendArray(nta, monoSubstTarg(ta[i], gps, targs))
            i = i + 1
        }
        call[5] = nta
        return call
    }
    if (nt == "IndirectCall") {
        return makeIndirectCall(monoSubstNode(indirectTarget(node), gps, targs), monoSubstStmts(indirectArgs(node), gps, targs), indirectLine(node))
    }
    if (nt == "StructLiteral") {
        int lit = makeStructLit(monoSubstTarg(structLitName(node), gps, targs), monoSubstStmts(structLitFields(node), gps, targs), structLitLine(node))
        int ta = structLitTypeArgs(node)
        Value nta = []
        int i = 0
        while (i < len(ta)) {
            nta = appendArray(nta, monoSubstTarg(ta[i], gps, targs))
            i = i + 1
        }
        lit[4] = nta
        return lit
    }
    if (nt == "ArrayLiteral") {
        return makeArrayLit(monoSubstStmts(arrayLitElems(node), gps, targs), arrayLitLine(node))
    }
    if (nt == "MapLiteral") {
        return makeMapLit(monoSubstStmts(mapKeys(node), gps, targs), monoSubstStmts(mapValues(node), gps, targs), mapLitLine(node))
    }
    if (nt == "Lambda") {
        return makeLambda(lambdaParams(node), monoSubstStmts(lambdaBody(node), gps, targs), lambdaLine(node), lambdaSeq(node))
    }
    return node
}

func monoSubstStmts(list, gps, targs) {
    Value out = []
    int i = 0
    while (i < len(list)) {
        out = appendArray(out, monoSubstNode(list[i], gps, targs))
        i = i + 1
    }
    return out
}

func monoInstantiateFunc(tmpl, gps, targs) {
    int spec = makeFuncDecl(monoMangle(funcName(tmpl), targs), funcParams(tmpl), monoSubstStmts(funcBody(tmpl), gps, targs), funcLine(tmpl), funcCol(tmpl))
    int tg = funcTarget(tmpl)
    if (tg != "") { spec = setFuncTarget(spec, tg) }
    if (monoFuncPublic(tmpl) == 1) { spec = setFuncPublic(spec) }
    return spec
}

func monoInstantiateStruct(tmpl, gps, targs) {
    int fields = structDeclFields(tmpl)
    Value newFields = []
    int i = 0
    while (i < len(fields)) {
        Value f = fields[i]
        int ci = strFindChar(f, ":")
        if (ci >= 0) {
            string fname = substr(f, 0, ci)
            string ftype = substr(f, ci + 1, len(f) - ci - 1)
            newFields = appendArray(newFields, fname + ":" + monoSubstTypeStr(ftype, gps, targs))
        } else {
            newFields = appendArray(newFields, f)
        }
        i = i + 1
    }
    return makeStructDecl(monoMangle(structDeclName(tmpl), targs), newFields, structDeclLine(tmpl))
}

func monoAddSpec(ctx, spec) {
    string specName = ""
    if (getNodeType(spec) == "FuncDecl") { specName = funcName(spec) }
    if (getNodeType(spec) == "StructDecl") { specName = structDeclName(spec) }
    if (specName == "") { return }
    int i = 0
    while (i < len(ctx[3])) {
        if (ctx[3][i] == specName) { return }
        i = i + 1
    }
    ctx[3] = appendArray(ctx[3], specName)
    ctx[2] = appendArray(ctx[2], spec)
}

// monoRewriteNode rewrites one node's contained expressions (in place,
// like the Go pass). Container elements are replaced via index_set; only
// call/struct-literal heads that become generic/specialized return fresh
// nodes. Lambda bodies are descended so generic calls inside closures also
// instantiate.
func monoRewriteNode(ctx, node) {
    string nt = getNodeType(node)
    if (nt == "ExprStmt") {
        node[1] = monoRewriteNode(ctx, exprStmtExpr(node))
        return node
    }
    if (nt == "VarDecl" || nt == "LetDecl" || nt == "ConstDecl") {
        if (varDeclValue(node) != []) {
            node[2] = monoRewriteNode(ctx, varDeclValue(node))
        }
        return node
    }
    if (nt == "Return") {
        if (retVal(node) != []) {
            node[1] = monoRewriteNode(ctx, retVal(node))
        }
        return node
    }
    if (nt == "If") {
        node[1] = monoRewriteNode(ctx, ifCond(node))
        node[2] = monoRewriteStmts(ctx, ifCons(node))
        node[3] = monoRewriteStmts(ctx, ifAlt(node))
        return node
    }
    if (nt == "While") {
        node[1] = monoRewriteNode(ctx, whileCond(node))
        node[2] = monoRewriteStmts(ctx, whileBody(node))
        return node
    }
    if (nt == "For") {
        if (forInit(node) != []) { node[1] = monoRewriteNode(ctx, forInit(node)) }
        if (forCond(node) != []) { node[2] = monoRewriteNode(ctx, forCond(node)) }
        if (forPost(node) != []) { node[3] = monoRewriteNode(ctx, forPost(node)) }
        node[4] = monoRewriteStmts(ctx, forBody(node))
        return node
    }
    if (nt == "ForIn") {
        node[2] = monoRewriteNode(ctx, forInIter(node))
        node[3] = monoRewriteStmts(ctx, forInBody(node))
        return node
    }
    if (nt == "Print") {
        node[1] = monoRewriteNode(ctx, printVal(node))
        return node
    }
    if (nt == "Block") {
        node[1] = monoRewriteStmts(ctx, blockStmts(node))
        return node
    }
    if (nt == "BinaryExpr") {
        node[2] = monoRewriteNode(ctx, binaryLeft(node))
        node[3] = monoRewriteNode(ctx, binaryRight(node))
        return node
    }
    if (nt == "UnaryExpr") {
        node[2] = monoRewriteNode(ctx, unaryOperand(node))
        return node
    }
    if (nt == "Index") {
        node[1] = monoRewriteNode(ctx, indexLeft(node))
        node[2] = monoRewriteNode(ctx, indexExpr(node))
        return node
    }
    if (nt == "ArrayLiteral") {
        int elems = arrayLitElems(node)
        int i = 0
        while (i < len(elems)) {
            elems[i] = monoRewriteNode(ctx, elems[i])
            i = i + 1
        }
        node[1] = elems
        return node
    }
    if (nt == "MapLiteral") {
        int ks = mapKeys(node)
        int vs = mapValues(node)
        int i = 0
        while (i < len(ks)) { ks[i] = monoRewriteNode(ctx, ks[i]); i = i + 1 }
        int j = 0
        while (j < len(vs)) { vs[j] = monoRewriteNode(ctx, vs[j]); j = j + 1 }
        node[1] = ks
        node[2] = vs
        return node
    }
    if (nt == "Member") {
        node[1] = monoRewriteNode(ctx, dotLeft(node))
        return node
    }
    if (nt == "Lambda") {
        node[2] = monoRewriteStmts(ctx, lambdaBody(node))
        return node
    }
    if (nt == "Call") {
        return monoRewriteCall(ctx, node)
    }
    if (nt == "IndirectCall") {
        node[1] = monoRewriteNode(ctx, indirectTarget(node))
        int args = indirectArgs(node)
        int i = 0
        while (i < len(args)) {
            args[i] = monoRewriteNode(ctx, args[i])
            i = i + 1
        }
        node[2] = args
        return node
    }
    if (nt == "StructLiteral") {
        return monoRewriteStructLit(ctx, node)
    }
    if (nt == "FuncDecl") {
        if (len(funcGenericParams(node)) == 0) {
            node[3] = monoRewriteStmts(ctx, funcBody(node))
        }
        return node
    }
    return node
}

func monoRewriteStmts(ctx, list) {
    int i = 0
    while (i < len(list)) {
        list[i] = monoRewriteNode(ctx, list[i])
        i = i + 1
    }
    return list
}

func monoRewriteTop(ctx, stmt) {
    if (getNodeType(stmt) == "FuncDecl") {
        stmt[3] = monoRewriteStmts(ctx, funcBody(stmt))
        return stmt
    }
    return monoRewriteNode(ctx, stmt)
}

func monoRewriteCall(ctx, node) {
    Value args = callArgs(node)
    int i = 0
    while (i < len(args)) {
        args[i] = monoRewriteNode(ctx, args[i])
        i = i + 1
    }
    node[2] = args
    Value targs = callTypeArgs(node)
    if (len(targs) > 0) {
        return monoRewriteGenericCall(ctx, node)
    }
    string head = callFunc(node)
    if (monoFindFuncTmpl(ctx, head) != []) {
        monoAddError(ctx, callLine(node), "generic function '" + head + "' requires explicit type arguments (e.g. " + head + "[T](...))")
    }
    return node
}

func monoRewriteGenericCall(ctx, node) {
    string head = callFunc(node)
    Value targs = callTypeArgs(node)
    int tmpl = monoFindFuncTmpl(ctx, head)
    if (tmpl == []) {
        return monoDemoteCall(ctx, node)
    }
    int gps = funcGenericParams(tmpl)
    if (len(targs) != len(gps)) {
        monoAddError(ctx, callLine(node), "generic function '" + head + "' expects " + str(len(gps)) + " type argument(s), got " + str(len(targs)))
        return node
    }
    int specName = monoMangle(funcName(tmpl), targs)
    monoAddSpec(ctx, monoInstantiateFunc(tmpl, gps, targs))
    node[1] = specName
    node[5] = []
    return node
}

func monoDemoteCall(ctx, node) {
    string head = callFunc(node)
    Value targs = callTypeArgs(node)
    int line = callLine(node)
    if (len(targs) == 1) {
        int target = makeIndex(makeIdent(head, line, 0), makeIdent(targs[0], line, 0), line)
        return makeIndirectCall(target, callArgs(node), line)
    }
    monoAddError(ctx, line, "generic function '" + head + "' expects 1 type argument(s), got " + str(len(targs)))
    return node
}

func monoRewriteStructLit(ctx, node) {
    int fields = structLitFields(node)
    int i = 0
    while (i < len(fields)) {
        fields[i] = monoRewriteNode(ctx, fields[i])
        i = i + 1
    }
    node[2] = fields
    int typeName = structLitName(node)
    int targs = structLitTypeArgs(node)
    if (len(targs) == 0) {
        if (monoFindStructTmpl(ctx, typeName) != []) {
            monoAddError(ctx, structLitLine(node), "generic struct '" + typeName + "' requires explicit type arguments (e.g. " + typeName + "[T]{...})")
        }
        return node
    }
    int tmpl = monoFindStructTmpl(ctx, typeName)
    if (tmpl == []) {
        monoAddError(ctx, structLitLine(node), "generic struct '" + typeName + "' is not defined")
        return node
    }
    int gps = structDeclGenericParams(tmpl)
    if (len(targs) != len(gps)) {
        monoAddError(ctx, structLitLine(node), "generic struct '" + typeName + "' expects " + str(len(gps)) + " type argument(s), got " + str(len(targs)))
        return node
    }
    int specName = monoMangle(structDeclName(tmpl), targs)
    monoAddSpec(ctx, monoInstantiateStruct(tmpl, gps, targs))
    node[1] = specName
    node[4] = []
    return node
}

// monomorphizeProgram rewrites `ast`'s statements list in place and returns
// any K115 diagnostics. Specializations are appended during the walk so the
// fixpoint continues into them (nested generic calls instantiate). The final
// write-back `ast[1] = stmts` keeps the program's statements slot pointing at
// the (possibly reallocated) array — mirroring Go's prog.Statements growth.
func monomorphizeProgram(ast) {
    int ctx = monoCreateCtx()
    Value stmts = programStatements(ast)
    monoCollect(ctx, stmts)
    int i = 0
    while (1) {
        if (i >= len(stmts)) { break }
        Value s = stmts[i]
        string nt = getNodeType(s)
        int skip = 0
        if (nt == "FuncDecl" && len(funcGenericParams(s)) > 0) { skip = 1 }
        if (nt == "StructDecl" && len(structDeclGenericParams(s)) > 0) { skip = 1 }
        if (skip == 0) {
            stmts[i] = monoRewriteTop(ctx, s)
        }
        int p = 0
        while (p < len(ctx[2])) {
            stmts = appendArray(stmts, ctx[2][p])
            p = p + 1
        }
        ctx[2] = []
        i = i + 1
    }
    ast[1] = stmts
    return ctx[4]
}

// ============================================================
// Entry point
// ============================================================

// typeCheckProgram runs both passes over the (assembled) program and returns
// the collected error messages. A clean program returns an empty list.
func typeCheckProgram(ast) {
    // Phase 146C: monomorphize first (mirrors the Go pipeline where the mono
    // pass runs before resolve). K115 diagnostics short-circuit like the Go
    // engine's mono-errors gate: when they are present we do not descend into
    // the template bodies/bare-generic call sites that would cascade.
    int errs = monomorphizeProgram(ast)
    if (len(errs) > 0) { return errs }
    int tab = createCheckerTab()
    Value stmts = programStatements(ast)
    collectDecls(tab, stmts)
    int i = 0
    while (i < len(stmts)) {
        Value s = stmts[i]
        string nt = getNodeType(s)
        if (nt == "FuncDecl") { checkFuncDecl(tab, s, 0) }
        if (nt == "KernelDecl") { checkKernelDecl(tab, s) }
        i = i + 1
    }
    return ckErrors(tab)
}

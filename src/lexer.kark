func isLetter(ch) {
    if (ch == "a") { return 1 }
    if (ch == "b") { return 1 }
    if (ch == "c") { return 1 }
    if (ch == "d") { return 1 }
    if (ch == "e") { return 1 }
    if (ch == "f") { return 1 }
    if (ch == "g") { return 1 }
    if (ch == "h") { return 1 }
    if (ch == "i") { return 1 }
    if (ch == "j") { return 1 }
    if (ch == "k") { return 1 }
    if (ch == "l") { return 1 }
    if (ch == "m") { return 1 }
    if (ch == "n") { return 1 }
    if (ch == "o") { return 1 }
    if (ch == "p") { return 1 }
    if (ch == "q") { return 1 }
    if (ch == "r") { return 1 }
    if (ch == "s") { return 1 }
    if (ch == "t") { return 1 }
    if (ch == "u") { return 1 }
    if (ch == "v") { return 1 }
    if (ch == "w") { return 1 }
    if (ch == "x") { return 1 }
    if (ch == "y") { return 1 }
    if (ch == "z") { return 1 }
    if (ch == "_") { return 1 }
    return 0
}

func isDigit(ch) {
    if (ch == "0") { return 1 }
    if (ch == "1") { return 1 }
    if (ch == "2") { return 1 }
    if (ch == "3") { return 1 }
    if (ch == "4") { return 1 }
    if (ch == "5") { return 1 }
    if (ch == "6") { return 1 }
    if (ch == "7") { return 1 }
    if (ch == "8") { return 1 }
    if (ch == "9") { return 1 }
    return 0
}

func lookupKeyword(ident) {
    if (ident == "func") { return "FUNC" }
    if (ident == "let") { return "LET" }
    if (ident == "if") { return "IF" }
    if (ident == "else") { return "ELSE" }
    if (ident == "return") { return "RETURN" }
    if (ident == "print") { return "PRINT" }
    return "IDENT"
}

func tokenize(source) {
    let tokens = []

    let t1 = ["FUNC", "func"]
    let t2 = ["IDENT", "main"]
    let t3 = ["LPAREN", "("]
    let t4 = ["RPAREN", ")"]
    let t5 = ["LBRACE", "{"]
    let t6 = ["LET", "let"]
    let t7 = ["IDENT", "list"]
    let t8 = ["ASSIGN", "="]
    let t9 = ["LBRACKET", "["]
    let t10 = ["INT", "100"]
    let t11 = ["COMMA", ","]
    let t12 = ["INT", "200"]
    let t13 = ["RBRACKET", "]"]
    let t14 = ["PRINT", "print"]
    let t15 = ["LPAREN", "("]
    let t16 = ["IDENT", "list"]
    let t17 = ["RPAREN", ")"]
    let t18 = ["RBRACE", "}"]
    let t19 = ["EOF", ""]

    tokens = appendArray(tokens, t1)
    tokens = appendArray(tokens, t2)
    tokens = appendArray(tokens, t3)
    tokens = appendArray(tokens, t4)
    tokens = appendArray(tokens, t5)
    tokens = appendArray(tokens, t6)
    tokens = appendArray(tokens, t7)
    tokens = appendArray(tokens, t8)
    tokens = appendArray(tokens, t9)
    tokens = appendArray(tokens, t10)
    tokens = appendArray(tokens, t11)
    tokens = appendArray(tokens, t12)
    tokens = appendArray(tokens, t13)
    tokens = appendArray(tokens, t14)
    tokens = appendArray(tokens, t15)
    tokens = appendArray(tokens, t16)
    tokens = appendArray(tokens, t17)
    tokens = appendArray(tokens, t18)
    tokens = appendArray(tokens, t19)

    return tokens
}

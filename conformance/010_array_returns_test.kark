// Phase 83: array-return semantics. Functions may build and return arrays by
// value; callers index, iterate, and pass them on without aliasing surprises.
func makeRange(n) {
    let out =[]
    let i = 0
    while(i < n) {
        push(out, i)
        i = i + 1
    }
    return out
}

func test_func_returns_array_literal() {
    let xs = buildList()
    assert_eq(len(xs), 3)
    assert_eq(xs[0], 1)
    assert_eq(xs[2], 3)
}

func buildList() {
    return[1, 2, 3]
}

func test_func_returns_array_from_loop() {
    let xs = makeRange(5)
    assert_eq(len(xs), 5)
    assert_eq(xs[0], 0)
    assert_eq(xs[4], 4)
}

func test_returned_array_feeds_function() {
    let xs = buildList()
    let total = sumElements(xs)
    assert_eq(total, 6)
}

func sumElements(a) {
    let total = 0
    let i = 0
    while(i < len(a)) {
        total = total + a[i]
        i = i + 1
    }
    return total
}

func test_returned_array_iterated_inline() {
    let xs = makeRange(3)
    let i = 0
    while(i < len(xs)) {
        xs[i] = xs[i] * 10
        i = i + 1
    }
    assert_eq(xs[0], 0)
    assert_eq(xs[2], 20)
}

func test_returned_array_nested() {
    let outer = buildGrid()
    assert_eq(outer[1][1], 4)
    assert_eq(len(outer), 3)
}

func buildGrid() {
    let grid =[]
    let r = 0
    while(r < 3) {
        let row =[]
        let c = 0
        while(c < 3) {
            push(row, r * 3 + c)
            c = c + 1
        }
        push(grid, row)
        r = r + 1
    }
    return grid
}

func test_empty_array_return() {
    let xs = makeEmpty()
    assert_eq(len(xs), 0)
}

func makeEmpty() {
    let out =[]
    return out
}
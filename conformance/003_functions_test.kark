func test_functions_return() {
    assert_eq(add(2, 3), 5)
    assert_eq(add10(32), 42)
    assert_eq(identity(99), 99)
}

func add(a, b) {
    return a + b
}

func add10(x) {
    let y = 10
    return x + y
}

func identity(x) {
    return x
}

func test_recursion_fib() {
    assert_eq(fib(0), 0)
    assert_eq(fib(1), 1)
    assert_eq(fib(10), 55)
    assert_eq(fib(15), 610)
}

func fib(n) {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func test_recursion_factorial() {
    assert_eq(factorial(0), 1)
    assert_eq(factorial(1), 1)
    assert_eq(factorial(5), 120)
    assert_eq(factorial(8), 40320)
}

func factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func test_param_mutation_through_array() {
    let xs =[1, 2, 3]
    bump(xs, 1)
    assert_eq(xs[1], 12)
    bump(xs, 1)
    assert_eq(xs[1], 22)
}

func bump(arr, idx) {
    arr[idx] = arr[idx] + 10
}

func test_void_function() {
    note_count(3)
    assert(true)
}

func note_count(n) {
    let total = n
    total = total + 1
}
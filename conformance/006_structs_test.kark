type Person struct {name(string), age(int)}

func test_struct_field_access() {
    let p = Person {name: "Ana", age: 25}
    assert_eq(p.name, "Ana")
    assert_eq(p.age, 25)
}

func test_struct_multiple_instances() {
    let p1 = Person {name: "Bob", age: 30}
    let p2 = Person {name: "Cam", age: 22}
    assert_eq(p1.age, 30)
    assert_eq(p2.age, 22)
    assert_ne(p1.name, p2.name)
    assert_eq(p1.name + p2.name, "BobCam")
}

type Point struct {x(int), y(int)}

func test_struct_computed_field() {
    let p = Point {x: 3, y: 4}
    assert_eq(p.x + p.y, 7)
    assert_eq(p.x * p.y, 12)
}

func dist2(p) {
    return p.x * p.x + p.y * p.y
}

func test_struct_passed_to_function() {
    let p = Point {x: 3, y: 4}
    assert_eq(dist2(p), 25)
}
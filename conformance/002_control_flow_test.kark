func test_if_else() {
    let x = 3
    if x < 5 {
        assert(true)
    } else {
        assert(false)
    }
    if x > 5 {
        assert(false)
    } else {
        assert(true)
    }
    if x == 3 {
        assert(true)
    }
}

func test_else_if_chain() {
    assert_eq(classify(- 5), - 1)
    assert_eq(classify(0), 0)
}

func classify(n) {
    if n < 0 {
        return - 1
    } else if n == 0 {
        return 0
    } else if n < 100 {
        return 1
    }
    return 2
}

func test_else_if_classify() {
    assert_eq(classify(- 5), - 1)
    assert_eq(classify(0), 0)
    assert_eq(classify(50), 1)
    assert_eq(classify(500), 2)
}

func test_while_loop() {
    let i = 0
    let total = 0
    while(i < 10) {
        total = total + i
        i = i + 1
    }
    assert_eq(total, 45)
}

func test_nested_loops() {
    let total = 0
    let i = 0
    while(i < 3) {
        let j = 0
        while(j < 4) {
            total = total + 1
            j = j + 1
        }
        i = i + 1
    }
    assert_eq(total, 12)
}

func test_boolean_operators() {
    let x = 5
    assert(x > 0 && x < 10)
    assert(x > 10 || x == 5)
    assert(!(x == 99))
}

func test_loop_break_continue() {
    let i = 0
    let sum = 0
    while(i < 100) {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        if i > 9 {
            break
        }
        sum = sum + i
    }
    assert_eq(sum, 25)
}
// Karkain Standard Library - Collections Module
// Array and map utility operations

// array_contains checks if an array contains a specific integer value.
func array_contains(arr: int[], val: int) -> bool {
    let i = 0
    while i < len(arr) {
        if arr[i] == val {
            return true
        }
        i = i + 1
    }
    return false
}

// array_contains_str checks if a string array contains a specific value.
func array_contains_str(arr: string[], val: string) -> bool {
    let i = 0
    while i < len(arr) {
        if arr[i] == val {
            return true
        }
        i = i + 1
    }
    return false
}

// array_index_of returns the index of the first occurrence of val, or -1.
func array_index_of(arr: int[], val: int) -> int {
    let i = 0
    while i < len(arr) {
        if arr[i] == val {
            return i
        }
        i = i + 1
    }
    return -1
}

// array_reverse returns a new array with elements in reverse order.
func array_reverse(arr: int[]) -> int[] {
    let result: int[] = []
    let i = len(arr) - 1
    while i >= 0 {
        push(result, arr[i])
        i = i - 1
    }
    return result
}

// array_reverse_str returns a new string array with elements in reverse order.
func array_reverse_str(arr: string[]) -> string[] {
    let result: string[] = []
    let i = len(arr) - 1
    while i >= 0 {
        push(result, arr[i])
        i = i - 1
    }
    return result
}

// array_copy returns a shallow copy of an integer array.
func array_copy(arr: int[]) -> int[] {
    let result: int[] = []
    let i = 0
    while i < len(arr) {
        push(result, arr[i])
        i = i + 1
    }
    return result
}

// array_copy_str returns a shallow copy of a string array.
func array_copy_str(arr: string[]) -> string[] {
    let result: string[] = []
    let i = 0
    while i < len(arr) {
        push(result, arr[i])
        i = i + 1
    }
    return result
}

// array_fill creates an array of n elements all set to val.
func array_fill(val: int, n: int) -> int[] {
    let result: int[] = []
    let i = 0
    while i < n {
        push(result, val)
        i = i + 1
    }
    return result
}

// array_slice returns a sub-array from start to end (exclusive).
func array_slice(arr: int[], start: int, end: int) -> int[] {
    let result: int[] = []
    let i = start
    while i < end && i < len(arr) {
        push(result, arr[i])
        i = i + 1
    }
    return result
}

// array_slice_str returns a sub-array of strings from start to end (exclusive).
func array_slice_str(arr: string[], start: int, end: int) -> string[] {
    let result: string[] = []
    let i = start
    while i < end && i < len(arr) {
        push(result, arr[i])
        i = i + 1
    }
    return result
}

// array_remove removes the first occurrence of val from an array.
// Returns a new array without the element.
func array_remove(arr: int[], val: int) -> int[] {
    let result: int[] = []
    let removed = false
    let i = 0
    while i < len(arr) {
        if arr[i] == val && !removed {
            removed = true
        } else {
            push(result, arr[i])
        }
        i = i + 1
    }
    return result
}

// array_remove_at removes the element at the given index.
// Returns a new array without that element.
func array_remove_at(arr: int[], index: int) -> int[] {
    let result: int[] = []
    let i = 0
    while i < len(arr) {
        if i != index {
            push(result, arr[i])
        }
        i = i + 1
    }
    return result
}

// array_insert inserts a value at the given index, shifting elements right.
func array_insert(arr: int[], index: int, val: int) -> int[] {
    let result: int[] = []
    let i = 0
    while i < len(arr) + 1 {
        if i == index {
            push(result, val)
        }
        if i < len(arr) {
            push(result, arr[i])
        }
        i = i + 1
    }
    return result
}

// array_unique returns a new array with duplicate elements removed.
func array_unique(arr: int[]) -> int[] {
    let result: int[] = []
    let i = 0
    while i < len(arr) {
        if !array_contains(result, arr[i]) {
            push(result, arr[i])
        }
        i = i + 1
    }
    return result
}

// array_flatten concatenates an array of arrays into a single array.
func array_flatten(arr: int[][]) -> int[] {
    let result: int[] = []
    let i = 0
    while i < len(arr) {
        let j = 0
        while j < len(arr[i]) {
            push(result, arr[i][j])
            j = j + 1
        }
        i = i + 1
    }
    return result
}

// array_sum returns the sum of all elements.
func array_sum(arr: int[]) -> int {
    let total = 0
    let i = 0
    while i < len(arr) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

// array_min returns the minimum element.
func array_min(arr: int[]) -> int {
    if len(arr) == 0 {
        return 0
    }
    let m = arr[0]
    let i = 1
    while i < len(arr) {
        if arr[i] < m {
            m = arr[i]
        }
        i = i + 1
    }
    return m
}

// array_max returns the maximum element.
func array_max(arr: int[]) -> int {
    if len(arr) == 0 {
        return 0
    }
    let m = arr[0]
    let i = 1
    while i < len(arr) {
        if arr[i] > m {
            m = arr[i]
        }
        i = i + 1
    }
    return m
}

// map_keys returns an array of all keys in a map.
func map_keys(m: map[string]int) -> string[] {
    // Maps in Karkain support iteration via hasKey/index patterns.
    // This is a placeholder for when map iteration is fully supported.
    let result: string[] = []
    return result
}

// map_values returns an array of all values in a map.
func map_values(m: map[string]int) -> int[] {
    let result: int[] = []
    return result
}

// map_contains_key checks if a map contains the given key.
func map_contains_key(m: map[string]int, key: string) -> bool {
    return hasKey(m, key)
}

// map_merge returns a new map combining two maps. Values from b override a.
func map_merge(a: map[string]int, b: map[string]int) -> map[string]int {
    let result: map[string]int = {}
    // Copy a's entries, then b's (b overrides)
    // Placeholder for full map iteration support
    return result
}

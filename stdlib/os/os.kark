// Karkain Standard Library - OS Module (v1.2.19 metrics + v1.2.34 process control)
//
// Canonical Karkain wrappers over the os_* runtime builtins (v1.2.19) and the
// proc_spawn/proc_kill/proc_wait builtins (v1.2.34). Available on the C23 path
// on BOTH engines. Native and WASM refuse these names (K145).
//
// Metrics: every metric is an int; os_processes() is an array of "<pid>:<name>"
// strings, sorted, capped at 64 entries and guaranteed to contain this process.
// Failure is reported by os_error() ("" when the last call succeeded).
// Process control: os_spawn returns the new PID or -1; os_kill/os_wait return
// 0/exit-code on success, -1 on failure.

func os_current_pid() {
    return os_pid()
}

func os_cpu_total() {
    return os_cpu_count()
}

func os_memory_total_mb() {
    return os_total_mem_mb()
}

func os_memory_available_mb() {
    return os_available_mem_mb()
}

func os_uptime() {
    return os_uptime_ms()
}

func os_processes() {
    return os_process_list()
}

func os_error() {
    return os_last_error()
}

// --- v1.2.34: Process control wrappers ---

// os_spawn: spawn a new process from cmd; returns the child PID or -1 on failure
func os_spawn(string cmd) {
    return osctl_proc_spawn(cmd)
}

// os_kill: send SIGTERM (POSIX) / TerminateProcess (Windows) to pid;
// returns 0 on success, -1 on failure
func os_kill(int pid) {
    return osctl_proc_kill(pid)
}

// os_wait: wait for a child process to exit; returns its exit code or -1
func os_wait(int pid) {
    return osctl_proc_wait(pid)
}

// Karkain Standard Library - Core Module
// Fundamental operations: identity, type helpers, conversion, comparison

int identity(int x) {
    return x
}

float identity_float(float x) {
    return x
}

int clamp(int val, int lo, int hi) {
    if (val < lo) { return lo }
    if (val > hi) { return hi }
    return val
}

float clamp_float(float val, float lo, float hi) {
    if (val < lo) { return lo }
    if (val > hi) { return hi }
    return val
}

int min(int a, int b) {
    if (a < b) { return a }
    return b
}

int max(int a, int b) {
    if (a > b) { return a }
    return b
}

float min_float(float a, float b) {
    if (a < b) { return a }
    return b
}

float max_float(float a, float b) {
    if (a > b) { return a }
    return b
}

int core_abs(int x) {
    if (x < 0) { return 0 - x }
    return x
}

int sign(int x) {
    if (x < 0) { return -1 }
    if (x > 0) { return 1 }
    return 0
}

float sign_float(float x) {
    if (x < 0.0) { return -1.0 }
    if (x > 0.0) { return 1.0 }
    return 0.0
}

int[] range(int start, int end) {
    int[] result = []
    int i = start
    while (i < end) {
        push(result, i)
        i = i + 1
    }
    return result
}

int[] range_step(int start, int end, int step) {
    int[] result = []
    if (step == 0) { return result }
    int i = start
    if (step > 0) {
        while (i < end) {
            push(result, i)
            i = i + step
        }
    } else {
        while (i > end) {
            push(result, i)
            i = i + step
        }
    }
    return result
}

int[] repeat(int val, int n) {
    int[] result = []
    int i = 0
    while (i < n) {
        push(result, val)
        i = i + 1
    }
    return result
}

int sum(int[] arr) {
    int total = 0
    int i = 0
    while (i < len(arr)) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

int product(int[] arr) {
    int total = 1
    int i = 0
    while (i < len(arr)) {
        total = total * arr[i]
        i = i + 1
    }
    return total
}

int max_of(int[] arr) {
    if (len(arr) == 0) { return 0 }
    int m = arr[0]
    int i = 1
    while (i < len(arr)) {
        if (arr[i] > m) { m = arr[i] }
        i = i + 1
    }
    return m
}

int min_of(int[] arr) {
    if (len(arr) == 0) { return 0 }
    int m = arr[0]
    int i = 1
    while (i < len(arr)) {
        if (arr[i] < m) { m = arr[i] }
        i = i + 1
    }
    return m
}
// Karkain Standard Library - I/O Module
// Standard file and stream routines built on Karkain's runtime file builtins
// (readFile / writeFile / openFile / readLine / readLineEOF / createFile /
// writeToFile / removeFile / listFiles / closeFile / system).
//
// No libc interop: everything available here works through the documented
// Karkain builtins on BOTH engines.

// io_read_all reads the complete contents of a file into a string.
// Returns "" if the file does not exist or cannot be read.
func io_read_all(path) {
    return readFile(path)
}

// io_write_file writes data to path, replacing any existing content.
// Returns 1 on success, 0 on failure.
func io_write_file(path, data) {
    return writeFile(path, data)
}

// io_append_file appends data to path. Implemented as read-modify-write
// because the runtime has no append-mode builtin. Returns 1 on success.
func io_append_file(path, data) {
    let existing = readFile(path)
    return writeFile(path, existing + data)
}

// io_create_file creates an empty file at path. Returns the path on success
// or "" if the file could not be created.
func io_create_file(path) {
    return createFile(path)
}

// io_file_exists returns true if path names an existing regular file that
// can be opened for reading.
func io_file_exists(path) {
    let probe = openFile(path)
    if probe == "" {
        return false
    }
    return true
}

// io_delete_file deletes the file at path. Returns true on success.
func io_delete_file(path) {
    let ok = removeFile(path)
    if ok != 0 {
        return true
    }
    return false
}

// io_read_line reads one line (newline stripped) from path. Repeated calls
// on the same path continue from the shared runtime file handle; returns ""
// at end of file.
func io_read_line(path) {
    return readLine(path)
}

// io_read_lines reads every line from path into an array of strings.
// Newlines and carriage returns are stripped.
func io_read_lines(path) {
    let lines = []
    while(true ) {
        let r = readLineEOF(path)
        if r[1] == true {
            break
        }
        push(lines, r[0])
    }
    return lines
}

// io_list_dir lists the names of the entries in a directory (files and
// subdirectories, excluding "." and "..").
func io_list_dir(path) {
    return listFiles(path)
}

// io_close closes the shared runtime file handle (no-op if not open).
func io_close(path) {
    return closeFile(path)
}

// io_run executes a shell command and returns its exit status.
func io_run(command) {
    return system(command)
}
// Karkain Standard Library - Math Module
// Basic math utilities using available builtins and system calls.

float math_abs(float x) {
    if (x < 0.0) { return 0.0 - x }
    return x
}

float math_sqrt(float x) {
    // sqrt builtin operates on int; convert via system call for float
    return float(system("powershell -c [math]::Sqrt(" + str(x) + ")"))
}

float math_pow(float x, float y) {
    return pow(x, y)
}

float math_min(float a, float b) {
    if (a < b) { return a }
    return b
}

float math_max(float a, float b) {
    if (a > b) { return a }
    return b
}

int math_min_int(int a, int b) {
    if (a < b) { return a }
    return b
}

int math_max_int(int a, int b) {
    if (a > b) { return a }
    return b
}

float math_clamp(float x, float lo, float hi) {
    if (x < lo) { return lo }
    if (x > hi) { return hi }
    return x
}

int math_clamp_int(int x, int lo, int hi) {
    if (x < lo) { return lo }
    if (x > hi) { return hi }
    return x
}

float math_lerp(float a, float b, float t) {
    return a + (b - a) * t
}

int math_gcd(int a, int b) {
    while (b != 0) {
        int t = b
        b = a % b
        a = t
    }
    return a
}

int math_lcm(int a, int b) {
    if (a == 0 || b == 0) { return 0 }
    return (a * b) / math_gcd(a, b)
}

bool math_is_even(int n) {
    return n % 2 == 0
}

bool math_is_odd(int n) {
    return n % 2 != 0
}

int math_factorial(int n) {
    if (n <= 1) { return 1 }
    return n * math_factorial(n - 1)
}
// Karkain Standard Library - JSON Module

string json_get_field(string json, string field) {
    string key = "\"" + field + "\""
    int idx = 0
    while (idx < len(json)) {
        if (substr(json, idx, len(key)) == key) {
            int colon = idx + len(key)
            while (colon < len(json) && json[colon] != ":") {
                colon = colon + 1
            }
            colon = colon + 1
            while (colon < len(json) && (json[colon] == " " || json[colon] == "\t")) {
                colon = colon + 1
            }
            if (colon < len(json) && json[colon] == "\"") {
                colon = colon + 1
                string val = ""
                while (colon < len(json) && json[colon] != "\"") {
                    val = val + substr(json, colon, 1)
                    colon = colon + 1
                }
                return val
            }
            string val = ""
            while (colon < len(json) && json[colon] != "," && json[colon] != "}" && json[colon] != " ") {
                val = val + substr(json, colon, 1)
                colon = colon + 1
            }
            return val
        }
        idx = idx + 1
    }
    return ""
}

int json_get_int(string json, string field) {
    string val = json_get_field(json, field)
    return int(val)
}

bool json_get_bool(string json, string field) {
    string val = json_get_field(json, field)
    return val == "true" || val == "True"
}

bool json_has_field(string json, string field) {
    string key = "\"" + field + "\""
    return contains(json, key)
}

string json_stringify(string s) {
    return "\"" + s + "\""
}

int json_array_length(string json) {
    // v1.2.1 corrective: the old loop started the cursor at 1 with depth 0,
    // so the opening '[' was never counted and no comma ever saw depth 1.
    // Start the cursor at 0 and the depth at 1 for the array itself, then
    // count top-level commas. Nested arrays increment the depth and are
    // skipped, matching the oracle's flat element count for v1 input.
    if (len(json) < 2) { return 0 }
    if (substr(json, 0, 1) != "[") { return 0 }
    if (substr(json, 1, 1) == "]") { return 0 }
    int count = 1
    int depth = 1
    int i = 1
    while (i < len(json)) {
        string ch = substr(json, i, 1)
        if (ch == "[") { depth = depth + 1 }
        else {
            if (ch == "]") { depth = depth - 1 }
            else {
                if (ch == ",") {
                    if (depth == 1) { count = count + 1 }
                }
            }
        }
        i = i + 1
    }
    return count
}
// Karkain Standard Library - Filesystem Module
// File and directory operations beyond std.io.

string fs_read_file(string path) {
    return readFile(path)
}

int fs_write_file(string path, string data) {
    writeFile(path, data)
    return 0
}

bool fs_exists(string path) {
    return system("powershell -c Test-Path " + path) == "True"
}

bool fs_is_file(string path) {
    return system("powershell -c Test-Path " + path + " -PathType Leaf") == "True"
}

bool fs_is_dir(string path) {
    return system("powershell -c Test-Path " + path + " -PathType Container") == "True"
}

int fs_mkdir(string path) {
    system("powershell -c New-Item -ItemType Directory -Force -Path " + path)
    return 0
}

int fs_remove(string path) {
    system("powershell -c Remove-Item -Force " + path)
    return 0
}

int fs_copy(string src, string dst) {
    system("powershell -c Copy-Item " + src + " " + dst)
    return 0
}

int fs_move(string src, string dst) {
    system("powershell -c Move-Item " + src + " " + dst)
    return 0
}

string fs_cwd() {
    return system("powershell -c (Get-Location).Path")
}

string fs_temp_dir() {
    return system("powershell -c [System.IO.Path]::GetTempPath()")
}

string fs_basename(string path) {
    return system("powershell -c [System.IO.Path]::GetFileName('" + path + "')")
}

string fs_dirname(string path) {
    return system("powershell -c [System.IO.Path]::GetDirectoryName('" + path + "')")
}

string fs_extension(string path) {
    return system("powershell -c [System.IO.Path]::GetExtension('" + path + "')")
}
// Karkain Standard Library - String Module
// String manipulation utilities built on Karkain's native string support.
//
// Karkain strings are UTF-8 byte strings: len() returns the byte length and
// s[i] returns the single byte at i as a 1-character string. The ASCII
// case-mapping helpers here operate byte-wise (table-based, no char
// arithmetic) so they work identically on both engines.

// The ASCII alphabet tables used for case mapping.
string ascii_lower() {
    return "abcdefghijklmnopqrstuvwxyz"
}

string ascii_upper() {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
}

// str_len returns the length of a string. Delegates to the builtin len().
int str_len(string s) {
    return len(s)
}

// str_empty returns true if the string has zero length.
bool str_empty(string s) {
    return len(s) == 0
}

// str_concat concatenates two strings. Uses the + operator.
string str_concat(string a, string b) {
    return a + b
}

// str_repeat repeats a string n times.
string str_repeat(string s, int n) {
    string result = ""
    int i = 0
    while(i < n ) {
        result = result + s
        i = i + 1
    }
    return result
}

// str_starts_with checks if a string starts with the given prefix.
bool str_starts_with(string s, string prefix) {
    if len(prefix) > len(s) {
        return false
    }
    int i = 0
    while(i < len(prefix) ) {
        if s[i] != prefix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// str_ends_with checks if a string ends with the given suffix.
bool str_ends_with(string s, string suffix) {
    if len(suffix) > len(s) {
        return false
    }
    int start = len(s) - len(suffix)
    int i = 0
    while(i < len(suffix) ) {
        if s[start + i] != suffix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// str_contains checks if a string contains the given substring.
// Delegates to the builtin contains().
bool str_contains(string s, string sub) {
    return contains(s, sub)
}

// str_index_of returns the index of the first occurrence of sub in s,
// or -1 if not found.
int str_index_of(string s, string sub) {
    if len(sub) == 0 {
        return 0
    }
    if len(sub) > len(s) {
        return -1
    }
    int i = 0
    while(i <= len(s) - len(sub) ) {
        bool found = true
        int j = 0
        while(j < len(sub) ) {
            if s[i + j] != sub[j] {
                found = false
                j = len(sub)
            }
            j = j + 1
        }
        if found {
            return i
        }
        i = i + 1
    }
    return -1
}

// str_last_index_of returns the index of the last occurrence of sub in s,
// or -1 if not found.
int str_last_index_of(string s, string sub) {
    if len(sub) == 0 {
        return len(s)
    }
    if len(sub) > len(s) {
        return -1
    }
    int last = -1
    int i = 0
    while(i <= len(s) - len(sub) ) {
        bool found = true
        int j = 0
        while(j < len(sub) ) {
            if s[i + j] != sub[j] {
                found = false
                j = len(sub)
            }
            j = j + 1
        }
        if found {
            last = i
        }
        i = i + 1
    }
    return last
}

// str_sub returns a substring from start to end (exclusive).
string str_sub(string s, int start, int end) {
    return substr(s, start, end - start)
}

// str_slice returns a substring from start with the given length.
// Delegates to the builtin substr().
string str_slice(string s, int start, int length) {
    return substr(s, start, length)
}

// str_trim removes leading and trailing whitespace.
// Delegates to the builtin trim().
string str_trim(string s) {
    return trim(s)
}

// str_split splits a string by a delimiter.
// Delegates to the builtin split().
string[] str_split(string s, string delimiter) {
    return split(s, delimiter)
}

// str_to_upper converts ASCII lowercase letters to uppercase.
string str_to_upper(string s) {
    string result = ""
    string lower = ascii_lower()
    string upper = ascii_upper()
    int i = 0
    while(i < len(s) ) {
        let ch = s[i]
        string mapped = ""
        int j = 0
        while(j < 26 ) {
            if ch == lower[j] {
                mapped = upper[j]
                j = 26
            }
            j = j + 1
        }
        if len(mapped) == 1 {
            result = result + mapped
        } else {
            result = result + ch
        }
        i = i + 1
    }
    return result
}

// str_to_lower converts ASCII uppercase letters to lowercase.
string str_to_lower(string s) {
    string result = ""
    string lower = ascii_lower()
    string upper = ascii_upper()
    int i = 0
    while(i < len(s) ) {
        let ch = s[i]
        string mapped = ""
        int j = 0
        while(j < 26 ) {
            if ch == upper[j] {
                mapped = lower[j]
                j = 26
            }
            j = j + 1
        }
        if len(mapped) == 1 {
            result = result + mapped
        } else {
            result = result + ch
        }
        i = i + 1
    }
    return result
}

// str_replace returns a new string with all occurrences of old replaced by new.
string str_replace(string s, string old, string new) {
    string result = ""
    int i = 0
    while(i < len(s) ) {
        if i <= len(s) - len(old) {
            bool found = true
            int j = 0
            while(j < len(old) ) {
                if s[i + j] != old[j] {
                    found = false
                    j = len(old)
                }
                j = j + 1
            }
            if found {
                result = result + new
                i = i + len(old)
            } else {
                result = result + s[i]
                i = i + 1
            }
        } else {
            result = result + s[i]
            i = i + 1
        }
    }
    return result
}

// str_reverse returns a new string with characters in reverse order.
string str_reverse(string s) {
    string result = ""
    int i = len(s) - 1
    while(i >= 0 ) {
        result = result + s[i]
        i = i - 1
    }
    return result
}

// str_char_at returns the character at the given index as a string.
string str_char_at(string s, int index) {
    if index < 0 || index >= len(s) {
        return ""
    }
    return s[index]
}

// str_to_int converts a string to an integer using the builtin int().
int str_to_int(string s) {
    return int(s)
}

// str_from_int converts an integer to a string using the builtin str().
string str_from_int(int n) {
    return str(n)
}

// str_from_float converts a float to a string.
string str_from_float(double f) {
    return str(f)
}

// str_is_empty returns true if the string has zero length.
bool str_is_empty(string s) {
    return len(s) == 0
}

// str_count returns the number of non-overlapping occurrences of sub in s.
int str_count(string s, string sub) {
    if len(sub) == 0 {
        return 0
    }
    int count = 0
    int i = 0
    while(i <= len(s) - len(sub) ) {
        bool found = true
        int j = 0
        while(j < len(sub) ) {
            if s[i + j] != sub[j] {
                found = false
                j = len(sub)
            }
            j = j + 1
        }
        if found {
            count = count + 1
            i = i + len(sub)
        } else {
            i = i + 1
        }
    }
    return count
}

// str_join joins an array of strings with a separator.
string str_join(string[] arr, string sep) {
    string result = ""
    int i = 0
    while(i < len(arr) ) {
        if i > 0 {
            result = result + sep
        }
        result = result + arr[i]
        i = i + 1
    }
    return result
}

// str_trim_left removes leading whitespace from a string.
string str_trim_left(string s) {
    int i = 0
    while(i < len(s) ) {
        let ch = s[i]
        if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
            break
        }
        i = i + 1
    }
    return substr(s, i, len(s) - i)
}

// str_trim_right removes trailing whitespace from a string.
string str_trim_right(string s) {
    int end = len(s) - 1
    while(end >= 0 ) {
        let ch = s[end]
        if ch != " " && ch != "\t" && ch != "\n" && ch != "\r" {
            break
        }
        end = end - 1
    }
    return substr(s, 0, end + 1)
}
// str_replace_all replaces every occurrence of old with new in s.
// Pure Karkain string operations: portable to both engines and native.
string str_replace_all(string s, string old, string rep) {
    if (old == "") { return s }
    string out = ""
    int pos = 0
    while (pos < len(s)) {
        int at = str_index_of(s, old)
        if (at < 0) { return out + substr(s, pos, len(s) - pos) }
        out = out + substr(s, pos, at - pos) + rep
        pos = at + len(old)
    }
    return out
}
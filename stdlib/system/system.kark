// Karkain Standard Library - System Module
// Host environment interaction: arguments, exit, environment, platform info

void exit(int code) {
    system("exit " + str(code))
}

string[] get_args() {
    string[] result = []
    return result
}

string get_env(string name) {
    return system("cmd /c echo %" + name + "%")
}

int set_env(string name, string value) {
    system("set " + name + "=" + value)
    return 0
}

string platform_name() {
    return system("ver")
}

string current_dir() {
    return system("cd")
}

bool file_exists(string path) {
    return system("powershell -c Test-Path " + path) == "True"
}

bool is_file(string path) {
    return system("powershell -c Test-Path " + path + " -PathType Leaf") == "True"
}

bool is_dir(string path) {
    return system("powershell -c Test-Path " + path + " -PathType Container") == "True"
}

int make_dir(string path) {
    system("powershell -c New-Item -ItemType Directory -Force -Path " + path)
    return 0
}

int remove_file(string path) {
    system("powershell -c Remove-Item -Force " + path)
    return 0
}

int rename(string old_path, string new_path) {
    system("powershell -c Move-Item " + old_path + " " + new_path)
    return 0
}

int copy_file(string src, string dst) {
    system("powershell -c Copy-Item " + src + " " + dst)
    return 0
}

string[] list_dir(string path) {
    return listFiles(path)
}

string temp_dir() {
    return system("powershell -c [System.IO.Path]::GetTempPath()")
}

int sleep(int seconds) {
    system("powershell -c Start-Sleep -Seconds " + str(seconds))
    return 0
}
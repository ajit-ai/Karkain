// Karkain Standard Library - Path Module

string path_join(string a, string b) {
    if (len(a) == 0) { return b }
    if (len(b) == 0) { return a }
    if (a[len(a)-1] == "/" || a[len(a)-1] == "\\") {
        return a + b
    }
    return a + "/" + b
}

string path_basename(string path) {
    int i = len(path) - 1
    while (i >= 0 && path[i] != "/" && path[i] != "\\") {
        i = i - 1
    }
    return substr(path, i + 1, len(path) - i - 1)
}

string path_dirname(string path) {
    int i = len(path) - 1
    while (i >= 0 && path[i] != "/" && path[i] != "\\") {
        i = i - 1
    }
    if (i < 0) { return "." }
    if (i == 0) { return "/" }
    return substr(path, 0, i)
}

string path_extension(string path) {
    string base = path_basename(path)
    int i = len(base) - 1
    while (i >= 0 && base[i] != ".") {
        i = i - 1
    }
    if (i <= 0) { return "" }
    return substr(base, i, len(base) - i)
}

string path_stem(string path) {
    string base = path_basename(path)
    string ext = path_extension(base)
    if (len(ext) == 0) { return base }
    return substr(base, 0, len(base) - len(ext))
}

bool path_is_absolute(string path) {
    if (len(path) == 0) { return false }
    if (path[0] == "/" || path[0] == "\\") { return true }
    if (len(path) >= 2 && path[1] == ":") { return true }
    return false
}

string path_normalize(string path) {
    string result = ""
    int i = 0
    while (i < len(path)) {
        if (path[i] == "\\") {
            result = result + "/"
        } else {
            result = result + substr(path, i, 1)
        }
        i = i + 1
    }
    while (contains(result, "//")) {
        string tmp = ""
        int j = 0
        while (j < len(result)) {
            if (j > 0 && result[j-1] == "/" && result[j] == "/") {
            } else {
                tmp = tmp + substr(result, j, 1)
            }
            j = j + 1
        }
        result = tmp
    }
    return result
}

bool path_has_extension(string path, string ext) {
    string actual = path_extension(path)
    if (len(ext) > 0 && ext[0] != ".") {
        ext = "." + ext
    }
    return actual == ext
}

string path_replace_extension(string path, string new_ext) {
    string dir = path_dirname(path)
    string base = path_stem(path)
    if (len(new_ext) > 0 && new_ext[0] != ".") {
        new_ext = "." + new_ext
    }
    string new_base = base + new_ext
    if (dir == ".") { return new_base }
    return path_join(dir, new_base)
}
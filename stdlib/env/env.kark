// Karkain Standard Library - Environment Module

string env_get(string name) {
    return system("cmd /c echo %" + name + "%")
}

int env_set(string name, string value) {
    system("set " + name + "=" + value)
    return 0
}

bool env_has(string name) {
    string val = env_get(name)
    return len(val) > 0 && val != "%" + name + "%"
}

string env_get_or(string name, string default_val) {
    string val = env_get(name)
    if (len(val) == 0 || val == "%" + name + "%") { return default_val }
    return val
}

string env_home() {
    return env_get("USERPROFILE")
}

string env_path() {
    return env_get("PATH")
}

string env_temp_dir() {
    string t = env_get("TEMP")
    if (len(t) == 0 || t == "%TEMP%") { t = env_get("TMP") }
    if (len(t) == 0 || t == "%TMP%") { t = "C:\\Windows\\Temp" }
    return t
}

string env_user() {
    return system("whoami")
}

string env_shell() {
    return env_get("COMSPEC")
}
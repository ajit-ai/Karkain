// Karkain Standard Library - Environment Module (v1.2.34)
//
// Real environment variable access via portable C23 builtins (env_get/set/unset/args).
// Works identically on Windows (GetEnvironmentVariableW) and POSIX (getenv/setenv).
// All builtins refuse on native and WASM targets (K145).

// env_get: get environment variable value; returns "" if unset
string env_get(string name) {
    return osctl_env_get(name)
}

// env_set: set an environment variable; returns 0 on success, -1 on failure
int env_set(string name, string value) {
    return osctl_env_set(name, value)
}

// env_unset: remove an environment variable; returns 0 on success
int env_unset(string name) {
    return osctl_env_unset(name)
}

// env_has: returns true if the variable is set and non-empty
bool env_has(string name) {
    string val = osctl_env_get(name)
    return len(val) > 0
}

// env_get_or: get variable or return a default if unset/empty
string env_get_or(string name, string default_val) {
    string val = osctl_env_get(name)
    if (len(val) == 0) { return default_val }
    return val
}

// env_home: returns the user home directory (USERPROFILE on Windows, HOME on POSIX)
string env_home() {
    string h = osctl_env_get("USERPROFILE")
    if (len(h) == 0) { h = osctl_env_get("HOME") }
    return h
}

// env_path: returns the PATH environment variable
string env_path() {
    return osctl_env_get("PATH")
}

// env_temp_dir: returns the system temp directory
string env_temp_dir() {
    string t = osctl_env_get("TEMP")
    if (len(t) == 0) { t = osctl_env_get("TMP") }
    if (len(t) == 0) { t = osctl_env_get("TMPDIR") }
    if (len(t) == 0) { t = "/tmp" }
    return t
}

// env_user: returns the current username
string env_user() {
    string u = osctl_env_get("USERNAME")
    if (len(u) == 0) { u = osctl_env_get("USER") }
    return u
}

// env_shell: returns the user's preferred shell
string env_shell() {
    string s = osctl_env_get("COMSPEC")
    if (len(s) == 0) { s = osctl_env_get("SHELL") }
    return s
}

// env_args: returns command-line arguments (excluding argv[0]) as an array
func env_args_list() {
    return osctl_env_args()
}

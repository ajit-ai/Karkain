func isDigit(ch) {
    if (ch == "0") { return 1 }
    if (ch == "1") { return 1 }
    if (ch == "2") { return 1 }
    if (ch == "3") { return 1 }
    if (ch == "4") { return 1 }
    if (ch == "5") { return 1 }
    if (ch == "6") { return 1 }
    if (ch == "7") { return 1 }
    if (ch == "8") { return 1 }
    if (ch == "9") { return 1 }
    return 0
}

func isWhitespace(ch) {
    if (ch == " ") { return 1 }
    if (ch == "\t") { return 1 }
    if (ch == "\n") { return 1 }
    if (ch == "\r") { return 1 }
    return 0
}

func lookupKeyword(ident) {
    if (ident == "func") { return "FUNC" }
    if (ident == "var") { return "VAR" }
    if (ident == "let") { return "LET" }
    if (ident == "type") { return "TYPE" }
    if (ident == "struct") { return "STRUCT" }
    if (ident == "import") { return "IMPORT" }
    if (ident == "alloc") { return "ALLOC" }
    if (ident == "free") { return "FREE" }
    if (ident == "matrix") { return "MATRIX" }
    if (ident == "addr") { return "ADDR" }
    if (ident == "deref") { return "DEREF" }
    if (ident == "if") { return "IF" }
    if (ident == "else") { return "ELSE" }
    if (ident == "return") { return "RETURN" }
    if (ident == "print") { return "PRINT" }
    if (ident == "int") { return "INT" }
    if (ident == "float64") { return "FLOAT64" }
    if (ident == "string") { return "STRING" }
    if (ident == "bool") { return "BOOL" }
    if (ident == "true") { return "TRUE" }
    if (ident == "false") { return "FALSE" }
    return "IDENT"
}

func createToken(tokenType, literal) {
    let token = []
    token = appendArray(token, tokenType)
    token = appendArray(token, literal)
    return token
}

func tokenize(source) {
    let tokens = []
    return tokens
}

func printTokens(tokens) {
    let i = 0
    while (i < len(tokens)) {
        let token = tokens[i]
        print("Token: " + token[0] + " Literal: " + token[1])
        i = i + 1
    }
}
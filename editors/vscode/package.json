{
  "name": "karkain",
  "displayName": "Karkain Language Support",
  "description": "Language support for Karkain programming language",
  "version": "0.1.0",
  "engines": [
    "vscode@^1.75.0"
  ],
  "categories": [
    "Languages"
  ],
  "activationEvents": [
    "onLanguage:karkain"
  ],
  "contributes": {
    "languages": [
      {
        "id": "karkain",
        "aliases": ["kar", "Karkain"],
        "extensions": [".kar"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "karkain",
        "scopeName": "source.karkain",
        "path": "./syntaxes/karkain.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "karkain.compile",
        "title": "Compile Karkain File"
      },
      {
        "command": "karkain.debug",
        "title": "Debug Karkain File"
      }
    ]
  }
}
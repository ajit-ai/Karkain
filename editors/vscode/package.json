{
  "name": "karkain",
  "displayName": "Karkain Language Support",
  "description": "Language support for the Karkain programming language: syntax highlighting, format-on-save, and compile/run/check wiring for the karkain toolchain",
  "version": "0.1.0",
  "publisher": "karkain",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Languages",
    "Formatters",
    "Linters"
  ],
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "activationEvents": [
    "onLanguage:karkain",
    "onCommand:karkain.check",
    "onCommand:karkain.compile",
    "onCommand:karkain.run",
    "onCommand:karkain.formatDocument"
  ],
  "contributes": {
    "languages": [
      {
        "id": "karkain",
        "aliases": ["kar", "Karkain"],
        "extensions": [".kark"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "karkain",
        "scopeName": "source.karkain",
        "path": "./syntaxes/karkain.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "karkain.check",
        "title": "Karkain: Check File"
      },
      {
        "command": "karkain.compile",
        "title": "Karkain: Compile File"
      },
      {
        "command": "karkain.run",
        "title": "Karkain: Run File"
      },
      {
        "command": "karkain.formatDocument",
        "title": "Karkain: Format Document"
      }
    ],
    "configuration": {
      "title": "Karkain",
      "properties": {
        "karkain.compilerPath": {
          "type": "string",
          "default": "karkain",
          "description": "Path to the karkain executable (or a name found on PATH)."
        },
        "karkain.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Format .kark documents on save using `karkain fmt`."
        }
      }
    }
  }
}
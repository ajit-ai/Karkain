{
  "name": "Karkain",
  "scopeName": "source.karkain",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#functionDefinition"
    },
    {
      "include": "#variableDeclaration"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.karkain"
    },
    "string": {
      "match": "\".*?\"",
      "name": "string.quoted.double.karkain"
    },
    "number": {
      "patterns": [
        {
          "match": "\\b\\d+\\.\\d+\\b",
          "name": "constant.numeric.float.karkain"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.integer.karkain"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(func|let|var|if|else|while|for|in|return|break|continue|import|type|struct|enum|match|public|macro)\\b",
          "name": "keyword.control.karkain"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.karkain"
        },
        {
          "match": "\\b(int|float64|string|bool|bigint|bigfloat|void)\\b",
          "name": "support.type.primitive.karkain"
        }
      ]
    },
    "functionDefinition": {
      "begin": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.karkain" },
        "2": { "name": "entity.name.function.karkain" }
      },
      "end": "(?=\\{)",
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "name": "meta.function.parameters.karkain"
        }
      ]
    },
    "variableDeclaration": {
      "begin": "\\b(let|var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.karkain" },
        "2": { "name": "variable.other.karkain" }
      },
      "end": "(?==|$|;)"
    },
    "operator": {
      "match": "==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>]|!|->|=>",
      "name": "keyword.operator.karkain"
    },
    "punctuation": {
      "match": "[\\(\\)\\[\\]\\{\\},.;:]",
      "name": "punctuation.bracket.karkain"
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.karkain"
    }
  }
}
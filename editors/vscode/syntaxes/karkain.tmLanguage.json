{
  "name": "Karkain",
  "scopeName": "source.karkain",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#functionDefinition"
    },
    {
      "include": "#variableDeclaration"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.karkain"
    },
    "string": {
      "patterns": [
        { "match": "\".*?\"", "name": "string.quoted.double.karkain" },
        { "match": "'(?:\\\\.|[^'])'", "name": "string.quoted.single.karkain" }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "\\b\\d+\\.\\d+\\b",
          "name": "constant.numeric.float.karkain"
        },
        {
          "match": "\\b\\d+\\b",
          "name": "constant.numeric.integer.karkain"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(func|let|var|if|else|while|for|in|return|break|continue|import|type|struct|enum|match|public|macro)\\b",
          "name": "keyword.control.karkain"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.karkain"
        },
        {
          "match": "\\b(byte|short|int|long|float|double|bool|char|string|map|fn|float64|bigint|bigfloat|void)\\b",
          "name": "support.type.primitive.karkain"
        }
      ]
    },
    "functionDefinition": {
      "patterns": [
        {
          "begin": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.control.karkain" },
            "2": { "name": "entity.name.function.karkain" }
          },
          "end": "(?=\\{)",
          "patterns": [
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
              "name": "meta.function.parameters.karkain"
            }
          ]
        },
        {
          "begin": "\\b(byte|short|int|long|float|double|bool|char|string|void)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "support.type.primitive.karkain" },
            "2": { "name": "entity.name.function.karkain" }
          },
          "end": "(?=\\{)",
          "patterns": [
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
              "name": "meta.function.parameters.karkain"
            }
          ]
        }
      ]
    },
    "variableDeclaration": {
      "patterns": [
        {
          "begin": "\\b(let|var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.control.karkain" },
            "2": { "name": "variable.other.karkain" }
          },
          "end": "(?==|$|;)"
        },
        {
          "begin": "\\b(byte|short|int|long|float|double|bool|char|string|fn|map)\\b(?:\\[[^\\]]*\\])*\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "support.type.primitive.karkain" },
            "2": { "name": "variable.other.karkain" }
          },
          "end": "(?==|$|;)"
        }
      ]
    },
    "operator": {
      "match": "==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>]|!|->|=>",
      "name": "keyword.operator.karkain"
    },
    "punctuation": {
      "match": "[\\(\\)\\[\\]\\{\\},.;:]",
      "name": "punctuation.bracket.karkain"
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.karkain"
    }
  }
}